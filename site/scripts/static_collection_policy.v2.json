  "definitions": {
    "child_directed": {
      "definition_id": "ontology-v2.child_directed",
      "definition": "Ребёнок является прямым целевым зрителем или участником программы.",
      "insufficient_evidence": ["возрастной рейтинг", "детская тема", "детские авторы"]
    },
    "family_suitable": {
      "definition_id": "ontology-v2.family_suitable",
      "definition": "Взрослые и дети прямо приглашены на совместное посещение.",
      "insufficient_evidence": ["слово семейный без формата", "встреча только для родителей", "семейная атмосфера"]
    },
    "joint_family_activity": {
      "definition_id": "ontology-v2.joint_family_activity",
      "definition": "Взрослый и ребёнок выполняют общую практику или задание.",
      "insufficient_evidence": ["совместное присутствие", "детская программа с сопровождающим взрослым"]
    },
    "science_pop": {
      "definition_id": "ontology-v2.science_pop",
      "definition": "Доказательное объяснение науки, научная лекция или документалистика, либо демонстрация объяснённого явления.",
      "insufficient_evidence": ["научная лексика", "обычная историческая выставка", "развлекательное шоу без объяснения"]
    },
    "research_in_action": {
      "definition_id": "ontology-v2.research_in_action",
      "definition": "Научный метод, первичные данные или источники, полевая работа, устройство эксперимента либо исследовательская практика являются содержанием события.",
      "insufficient_evidence": ["метафорическое исследование", "биография без метода", "архивные предметы без исследовательского процесса"]
    },
    "strong_impressions": {
      "definition_id": "ontology-v2.strong_impressions",
      "definition": "Редкий доступ, иммерсивная смена роли, физически или эмоционально интенсивный маршрут либо редкая site-specific практика с личным участием.",
      "insufficient_evidence": ["обычный мастер-класс", "йога", "публичный спортивный день", "концерт со свечами", "рекламная яркость"]
    },
    "medieval": {
      "definition_id": "ontology-v2.medieval",
      "definition": "Средневековье, рыцарская культура, замок как предмет программы, викинги либо living history являются содержанием события.",
      "insufficient_evidence": ["старый замок как площадка", "фэнтези", "один средневековый номер", "другой исторический период"]
    }
  },
  "public_projections": {
    "kids": {
