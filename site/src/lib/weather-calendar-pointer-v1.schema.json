{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenigevents.ru/schemas/weather-calendar-pointer-v1.schema.json",
  "title": "KenigEvents weather calendar atomic current pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "snapshot_url", "sha256", "updated_at"],
  "properties": {
    "schema": { "const": "weather-calendar-pointer-v1" },
    "snapshot_id": { "type": "string", "pattern": "^weather-[A-Za-z0-9._-]{8,120}$" },
    "snapshot_url": { "type": "string", "pattern": "^/[^?#]*data/weather/v1/snapshots/[0-9a-f]{64}\\.json$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
