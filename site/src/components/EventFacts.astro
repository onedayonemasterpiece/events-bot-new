---
import type { PreviewEvent } from '../lib/types';
interface Props { event: PreviewEvent }
const { event } = Astro.props;
const rows = [
  ['Дата', event.display_date],
  ['Время', event.display_time ? `${event.display_time} (${event.timezone})` : `уточняется (${event.timezone})`],
  ['Город', event.city],
  ['Площадка', event.venue_name],
  ['Адрес', event.address],
  ['Тип', event.event_type],
  ['Фестиваль', event.festival],
  ['Вход', event.ticket.price_label || event.status_label],
  ['Пушкинская карта', event.pushkin_card ? 'возможна' : null],
].filter(([, value]) => Boolean(value));
---
<dl class="details-list">
  {rows.map(([label, value]) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>
