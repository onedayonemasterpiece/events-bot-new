---
import type { PreviewEvent } from '../lib/types';
interface Props { event: PreviewEvent }
const { event } = Astro.props;
const sourceCount = Number(event.source_engagement_sources_count || 0);
const sourceViews = Number(event.source_views_count || 0);
const rows = [
  ['Адрес', event.address],
  ['Фестиваль', event.festival],
  ['Вход', event.ticket.price_label || event.status_label],
  ['Пушкинская карта', event.pushkin_card ? 'возможна' : null],
  ['Источники', sourceCount > 0 ? String(sourceCount) : null],
  ['Просмотры в источниках', sourceViews > 0 ? sourceViews.toLocaleString('ru-RU') : null],
].filter(([, value]) => Boolean(value));
---
<dl class="details-list">
  {rows.map(([label, value]) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>
