---
import EventCard from './EventCard.astro';
import type { PreviewEvent } from '../lib/types';
import { packRelatedCardRows } from '../lib/relatedCardLayout.mjs';

type MediaTreatment = 'cover' | 'ambient' | 'hybrid';

interface Props {
  events: PreviewEvent[];
  limit?: number;
  rowSize?: number;
  mediaTreatment?: MediaTreatment;
  className?: string;
  responsiveMobile?: boolean;
  surface?: string;
  algorithmId?: string;
  currentEventId?: number;
  discoverySrc?: string;
  personalFeed?: boolean;
}

const {
  events,
  limit = 10,
  rowSize = 3,
  mediaTreatment = 'hybrid',
  className,
  responsiveMobile = false,
  surface,
  algorithmId,
  currentEventId,
  discoverySrc,
  personalFeed = false,
} = Astro.props;

// The global row optimizer is intentionally exponential over a small ranked
// recommendation prefix. Collection pages are a different, unbounded
// consumer: keep the same canonical large-card family and row rules, but pack
// them in bounded three-row batches so a 20+ item collection cannot turn the
// static build into a bitmask explosion.
const sourceEvents = events.slice(0, Math.max(0, limit));
const optimizationBatchSize = Math.max(rowSize, rowSize * 3);
let rowOffset = 0;
const packed = packRelatedCardRows([], { limit:0, rowSize, mediaTreatment });
for (let start = 0; start < sourceEvents.length; start += optimizationBatchSize) {
  const batch = sourceEvents.slice(start, start + optimizationBatchSize);
  const batchPacked = packRelatedCardRows(batch, {
    limit: batch.length,
    rowSize,
    mediaTreatment,
    preserveAll: true,
  });
  packed.push(...batchPacked.map(({ item, layout }) => ({
    item,
    layout: { ...layout, rowIndex: layout.rowIndex + rowOffset },
  })));
  rowOffset += batchPacked.length
    ? Math.max(...batchPacked.map(({ layout }) => layout.rowIndex)) + 1
    : 0;
}
const packedRows = [...new Set(packed.map(({ layout }) => layout.rowIndex))]
  .sort((left, right) => left - right)
  .map((rowIndex) => packed.filter(({ layout }) => layout.rowIndex === rowIndex));
---

<div
  class:list={[
    'cards-grid',
    'cards-grid--immersive',
    'optimized-event-card-grid',
    responsiveMobile && 'optimized-event-card-grid--responsive',
    className,
  ]}
  data-optimized-event-card-grid
  data-lab-row-normalize
  data-discovery-feed={!responsiveMobile ? '' : undefined}
  data-personal-feed-results={personalFeed ? '' : undefined}
  data-surface={surface}
  data-algorithm-id={algorithmId}
  data-current-event-id={currentEventId}
  data-discovery-src={discoverySrc}
  data-feed-card-variant="split-actions"
>
  {packedRows.map((row, rowIndex) => (
    <div
      class="optimized-event-card-row"
      data-optimized-event-card-row
      data-row-index={rowIndex}
      data-row-card-count={row.length}
      style={`--row-card-count:${row.length}`}
    >
      {row.map(({ item, layout }, rowColumn) => (
        <EventCard
          event={item}
          variant="split-actions"
          desktopRelatedCrop
          desktopRelatedLayout={{ ...layout, rowIndex:0, rowColumn }}
        />
      ))}
    </div>
  ))}
</div>

<style>
  .optimized-event-card-grid {
    min-width: 0;
    display: grid;
    /* `cards-grid` supplies shared tokens, but its multi-column template is
       for direct cards. These children are complete rows and must be full. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(.85rem, 1.6vw, 1.25rem);
    align-items: stretch;
  }
  .optimized-event-card-row {
    min-width:0;
    width:100%;
    grid-column:1 / -1;
    display:grid;
    grid-template-columns: repeat(var(--row-card-count), minmax(0, 1fr));
    gap:clamp(.85rem, 1.6vw, 1.25rem);
    align-items:stretch;
  }

  .optimized-event-card-grid :global([data-lab-related-card]) {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr) minmax(58px, auto) minmax(56px, auto);
  }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__media-link) { display: block; }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__media-shell) {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: auto !important;
    aspect-ratio: var(--lab-row-media-ratio) !important;
    overflow: hidden;
    background: #d2c5b7;
  }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__media) {
    position: absolute !important;
    z-index: 2;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }
  .optimized-event-card-grid :global([data-lab-media-kind="visual"] .event-card__media-shell) {
    background: linear-gradient(135deg, #e4ddd2, #d4c7b9);
  }
  .optimized-event-card-grid :global([data-lab-media-kind="visual"] .event-card__media) { background: transparent !important; }
  .optimized-event-card-grid :global([data-card-authoritative-fit="contain"]) { background: #15110f; }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__body) { min-height: 0; align-content: start; }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__utility-row) { min-height: 58px; }
  .optimized-event-card-grid :global([data-lab-related-card] .event-card__feedback--under) { min-height: 56px; }

  @media (max-width: 1023px) {
    .optimized-event-card-grid--responsive .optimized-event-card-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .optimized-event-card-grid--responsive :global([data-lab-related-card]) {
      grid-row: auto !important;
      grid-column: auto !important;
    }
  }
</style>
