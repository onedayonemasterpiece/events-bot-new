---
import AdaptiveEventCardGrid from './AdaptiveEventCardGrid.astro';
import type { PreviewEvent } from '../lib/types';

type MediaTreatment = 'cover' | 'ambient' | 'hybrid';

interface Props {
  events: PreviewEvent[];
  limit?: number;
  rowSize?: number;
  mediaTreatment?: MediaTreatment;
  className?: string;
  responsiveMobile?: boolean;
  surface?: string;
  algorithmId?: string;
  currentEventId?: number;
  discoverySrc?: string;
  personalFeed?: boolean;
}

const {
  events,
  limit = 10,
  rowSize = 3,
  mediaTreatment = 'hybrid',
  className,
  responsiveMobile = false,
  surface,
  algorithmId,
  currentEventId,
  discoverySrc,
  personalFeed = false,
} = Astro.props;
---

<AdaptiveEventCardGrid
  events={events}
  mode="packed"
  limit={limit}
  rowSize={rowSize}
  mediaTreatment={mediaTreatment}
  className={className}
  responsiveMobile={responsiveMobile}
  surface={surface}
  algorithmId={algorithmId}
  currentEventId={currentEventId}
  discoverySrc={discoverySrc}
  personalFeed={personalFeed}
  discoveryFeed={!responsiveMobile}
  legacyOptimizedContract
/>
