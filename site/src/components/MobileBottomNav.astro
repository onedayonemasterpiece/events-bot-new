---
import SemanticIcon from './design-system/SemanticIcon.astro';
import { mobileDiscoveryHref } from '../lib/mobileDiscoveryRoutes';
import { BASE_PATH, withBase } from '../lib/events';

export type MobileSection = 'afisha' | 'dates' | 'search' | 'personal' | null;

interface Props { current: MobileSection; }
const { current } = Astro.props;
const discoveryBases = {
  calendarBase: import.meta.env.PUBLIC_MOBILE_CALENDAR_BASE_URL,
  searchBase: import.meta.env.PUBLIC_MOBILE_SEARCH_BASE_URL,
};
const searchIconUrl = withBase('/assets/icons/reference4-v8/search-thin.svg');
const items = [
  { key: 'afisha', label: 'Афиша', href: mobileDiscoveryHref('/', discoveryBases, BASE_PATH), icon: 'ticket' },
  { key: 'dates', label: 'Даты', href: mobileDiscoveryHref('/segodnya/', discoveryBases, BASE_PATH), icon: 'calendar' },
  { key: 'search', label: 'Поиск', href: mobileDiscoveryHref('/poisk/', discoveryBases, BASE_PATH), icon: 'search' },
  { key: 'personal', label: 'Для меня', href: mobileDiscoveryHref('/dlya-menya/', discoveryBases, BASE_PATH), icon: 'personal' },
] as const;
---

<nav class="mobile-bottom-nav" data-mobile-bottom-nav aria-label="Навигация по афише">
  {items.map((item) => (
    <a href={item.href} data-mobile-nav-section={item.key} aria-current={item.key === current ? 'page' : undefined}>
      <span class="mobile-bottom-nav__icon">
        {item.icon === 'ticket' && <SemanticIcon name="ticket" role="control" />}
        {item.icon === 'calendar' && <SemanticIcon name="calendar" role="control" />}
        {item.icon === 'search' && (
          <span
            class="mobile-bottom-nav__asset-icon ke-icon-role ke-icon-role--control ke-icon-contract--four-role-v1 ke-icon-size-owner--foundations"
            data-ke-icon-name="search"
            data-ke-icon-asset="reference4-v8/search-thin.svg"
            data-ke-icon-role="control"
            data-ke-icon-contract="four-role-v1"
            data-ke-icon-size-owner="foundations.css"
            aria-hidden="true"
            style={`--mobile-bottom-nav-icon-url:url("${searchIconUrl}")`}
          ></span>
        )}
        {item.icon === 'personal' && <SemanticIcon name="spark" role="control" />}
      </span>
      <span>{item.label}</span>
    </a>
  ))}
</nav>

<style is:global>
  .mobile-bottom-nav {
    position:fixed; z-index:40; left:50%; bottom:calc(var(--mobile-bottom-stack-h) - var(--mobile-nav-h) + var(--ke-space-3));
    width:min(480px, calc(100% - (2 * var(--ke-space-3)))); min-height:var(--mobile-nav-h);
    display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); transform:translateX(-50%);
    overflow:hidden; border:1px solid var(--ke-color-mobile-nav-border); border-radius:var(--ke-radius-pill);
    background:var(--ke-color-mobile-nav-surface); box-shadow:var(--ke-elevation-mobile-nav);
  }
  .mobile-bottom-nav a {
    min-width:0; min-height:var(--mobile-nav-h); display:grid; place-content:center;
    justify-items:center; gap:2px; color:var(--ke-color-mobile-nav-inactive); font-size:10px; line-height:1;
    font-weight:760; text-decoration:none; -webkit-tap-highlight-color:transparent;
  }
  .mobile-bottom-nav__icon { width:var(--ke-mobile-nav-icon-container-width); height:var(--ke-mobile-nav-icon-container-height); display:grid; place-items:center; border-radius:var(--ke-mobile-nav-icon-container-radius); }
  .mobile-bottom-nav .ke-icon-role { --ke-icon-size:var(--ke-mobile-nav-icon-size); }
  .mobile-bottom-nav__asset-icon {
    background:currentColor;
    -webkit-mask:var(--mobile-bottom-nav-icon-url) center / contain no-repeat;
    mask:var(--mobile-bottom-nav-icon-url) center / contain no-repeat;
  }
  .mobile-bottom-nav a[aria-current="page"] { color:var(--ke-color-mobile-nav-active); font-weight:900; }
  .mobile-bottom-nav a[aria-current="page"] .mobile-bottom-nav__icon { background:var(--ke-color-mobile-nav-active-icon-surface); }
  .mobile-bottom-nav a:focus-visible { outline:2px solid var(--ke-color-mobile-nav-active); outline-offset:-2px; }
</style>
