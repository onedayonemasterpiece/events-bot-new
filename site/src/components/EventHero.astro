---
import Icon from './Icon.astro';
import CalendarLink from './CalendarLink.astro';
import AnnouncementsLockup from './brand/AnnouncementsLockup.astro';
import type { EventImageAsset, PreviewEvent } from '../lib/types';
import { displayDate, displayDateTime, displayDateWithWeekday, eventAbsoluteUrl, eventTicketActionLabel, eventAdmissionLabel, eventActionHref, isExternalHttpUrl, isCalendarEligible, isTelephoneUrl, isTicketSoldOut, siteHomeHref } from '../lib/events';
import { eventImageUrl } from '../lib/assets';
import { isLowResolutionPortraitEventMedia, selectEventMediaByQuality } from '../lib/eventMediaQuality';

export type HeroMode = 'poster-stage' | 'photo-cover' | 'fallback-art';
export type HeroComposition = 'poster-billboard' | 'poster-attached-card' | 'photo-cinematic-sheet' | 'photo-parallax-sheet' | 'compact-ticketing';
export interface HeroGalleryCta {
  title: string;
  href: string;
  label?: string;
  image_url?: string | null;
  meta?: string | null;
}
interface Props {
  event: PreviewEvent;
  modeOverride?: HeroMode;
  composition?: HeroComposition;
  headingTag?: 'h1' | 'h2' | 'h3';
  galleryCta?: HeroGalleryCta;
  metaTreatment?: 'standard' | 'weekday-panel' | 'responsive-weekday-panel';
}

type HeroGalleryImage = {
  src: string;
  alt: string;
  image_text_mode: EventImageAsset['image_text_mode'];
  recommended_hero_fit?: EventImageAsset['recommended_hero_fit'];
  recommended_object_position?: string;
  media_role?: EventImageAsset['media_role'];
  width?: number;
  height?: number;
  low_resolution_portrait?: boolean;
};

const { event, modeOverride, composition, headingTag = 'h1', galleryCta, metaTreatment = 'standard' } = Astro.props;
const HeadingTag = headingTag;
const rawImageAssets = event.image_assets || [];
const mediaQualitySelection = selectEventMediaByQuality(rawImageAssets);
const admittedImageAssets = mediaQualitySelection.admittedSourceIndexes.map((index) => rawImageAssets[index]).filter(Boolean);
const requestedPrimaryImageUrl = eventImageUrl(event.image_url);
const primaryImageAsset = admittedImageAssets.find((asset) => eventImageUrl(asset.src) === requestedPrimaryImageUrl) || admittedImageAssets[0];
const primaryLowResolutionPortrait = admittedImageAssets.length === 1 && isLowResolutionPortraitEventMedia(primaryImageAsset);
const primaryImageUrl = eventImageUrl(primaryImageAsset?.src || event.image_url);
const primaryImageTextMode = primaryImageAsset?.image_text_mode || event.image_text_mode;
const galleryCtaImageUrl = eventImageUrl(galleryCta?.image_url);
const derivedMode: HeroMode = primaryImageUrl ? (primaryImageTextMode === 'visual_only' ? 'photo-cover' : 'poster-stage') : 'fallback-art';
const heroMode = modeOverride || derivedMode;
const derivedComposition: HeroComposition = heroMode === 'fallback-art'
  ? 'compact-ticketing'
  : heroMode === 'photo-cover'
    ? 'photo-cinematic-sheet'
    : 'poster-billboard';
const heroComposition = composition || derivedComposition;
const dateTimeLabel = displayDateTime(event);
const dateLabel = displayDate(event);
const dateWithWeekdayLabel = displayDateWithWeekday(event);
const weekdayLabel = dateWithWeekdayLabel.endsWith(dateLabel)
  ? dateWithWeekdayLabel.slice(0, -dateLabel.length).replace(/,\s*$/u, '')
  : '';
const placeLabel = [event.venue_name, event.city].filter(Boolean).join(' · ') || 'место уточняется';
const ctaHref = eventActionHref(event);
const ctaLabel = eventTicketActionLabel(event);
const soldOut = isTicketSoldOut(event);
const canonicalUrl = eventAbsoluteUrl(event);
const admissionLabel = eventAdmissionLabel(event);
const heroAdmissionLabel = (() => {
  if (event.ticket.is_free) return admissionLabel;
  return null;
})();
const shareText = [event.title, [dateTimeLabel, placeLabel].filter(Boolean).join(' · '), admissionLabel].filter(Boolean).join('\n');
const statusText = [event.event_type, heroAdmissionLabel].filter(Boolean).join(' · ');
const shareImageType = primaryImageUrl?.toLowerCase().includes('.webp') ? 'image/webp' : primaryImageUrl?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
const canAddToCalendar = isCalendarEligible(event);
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count ?? 0;
const likeCountLabel = likesCount > 0 ? String(likesCount) : '';
const shareCountLabel = sharesCount > 0 ? String(sharesCount) : '';
const likeAria = likesCount > 0 ? `Поставить лайк: ${event.title}. Сейчас ${likesCount}` : `Поставить лайк: ${event.title}`;
const tint = (() => {
  const haystack = [event.event_type, ...(event.topics || [])].join(' ').toLowerCase();
  if (/концерт|музык|симфон/u.test(haystack)) return 'warm';
  if (/выстав|музей|презента/u.test(haystack)) return 'deep';
  if (/ярмарк|семейн|водн|дет/u.test(haystack)) return 'cool';
  return 'neutral';
})();
const heroClass = ['event-hero', `event-hero--${heroMode}`, `event-hero--${heroComposition}`, primaryLowResolutionPortrait && 'event-hero--low-resolution-portrait'].filter(Boolean).join(' ');
const heroAlt = event.image_alt || `Афиша события «${event.title}»`;
function normalizeObjectPosition(value: string | null | undefined) {
  const raw = (value || '').trim();
  return /^[a-z0-9.%\s-]+$/i.test(raw) ? raw : null;
}
function isReliableHeroGalleryImageUrl(value: string | null | undefined): boolean {
  const src = String(value || '').trim();
  if (!src) return false;
  try {
    const url = new URL(src, 'https://kenigevents.ru');
    return url.hostname.toLowerCase() !== 'files.catbox.moe';
  } catch {
    return true;
  }
}
const focalObjectPosition = event.focal_point ? `${Math.round(event.focal_point.x * 100)}% ${Math.round(event.focal_point.y * 100)}%` : null;
const heroObjectPosition = heroMode === 'photo-cover' ? normalizeObjectPosition(event.image_object_position || focalObjectPosition) : null;
const ctaIsExternal = isExternalHttpUrl(ctaHref);
const ctaIsTelephone = isTelephoneUrl(ctaHref);

const galleryImages = (() => {
  const seen = new Set<string>();
  const out: HeroGalleryImage[] = [];
  const push = (image: Partial<HeroGalleryImage> | null | undefined) => {
    const src = String(image?.src || '').trim();
    if (!src || seen.has(src)) return;
    if (!isReliableHeroGalleryImageUrl(src)) return;
    seen.add(src);
    out.push({
      src,
      alt: image?.alt || heroAlt,
      image_text_mode: image?.image_text_mode || event.image_text_mode || 'unknown',
      recommended_hero_fit: image?.recommended_hero_fit,
      recommended_object_position: normalizeObjectPosition(image?.recommended_object_position) || undefined,
      media_role: image?.media_role,
      width: image?.width,
      height: image?.height,
      low_resolution_portrait: image?.low_resolution_portrait,
    });
  };
  if (primaryImageUrl) {
    push({
      src: primaryImageUrl,
      alt: heroAlt,
      image_text_mode: primaryImageTextMode,
      recommended_object_position: heroObjectPosition || undefined,
      recommended_hero_fit: heroMode === 'photo-cover' ? 'cover' : 'contain',
      media_role: primaryImageAsset?.media_role || event.image_media_role,
      width: primaryImageAsset?.width,
      height: primaryImageAsset?.height,
      low_resolution_portrait: primaryLowResolutionPortrait,
    });
  }
  for (const asset of admittedImageAssets) {
    push({
      src: eventImageUrl(asset.src) || asset.src,
      alt: asset.alt || heroAlt,
      image_text_mode: asset.image_text_mode || 'unknown',
      recommended_object_position: asset.recommended_object_position,
      recommended_hero_fit: asset.recommended_hero_fit,
      media_role: asset.media_role,
      width: asset.width,
      height: asset.height,
      low_resolution_portrait: admittedImageAssets.length === 1 && isLowResolutionPortraitEventMedia(asset),
    });
  }
  return out;
})();
const hasGallery = galleryImages.length > 0;
const heroGalleryId = `hero-gallery-${event.id}`;
const heroGalleryTitleId = `${heroGalleryId}-title`;
const gallerySlideCount = galleryImages.length + (galleryCta ? 1 : 0);
const galleryPhotoCount = galleryImages.length;
const portraitPhotoCount = galleryImages.filter((image) => image.width && image.height && image.width / image.height < 0.9).length;
const efficientPortraitViewer = galleryPhotoCount >= 5 && portraitPhotoCount >= Math.ceil(galleryPhotoCount * 0.6);
const galleryHintLabel = galleryPhotoCount > 1 ? `Фото ${galleryPhotoCount}` : 'Открыть фото';
const calendarPrimary = canAddToCalendar && (!ctaHref || event.ticket.kind === 'free');
const showTicketCta = Boolean(ctaHref);
---
<section class={heroClass} data-event-hero data-feedback-scope data-event-id={event.id} data-event-title={event.title} data-hero-mode={heroMode} data-hero-composition={heroComposition} data-hero-image-text-mode={primaryImageTextMode} data-hero-quality-hidden-count={mediaQualitySelection.hiddenSourceIndexes.length || undefined} data-hero-low-resolution-portrait={primaryLowResolutionPortrait ? 'true' : undefined} data-hero-tint={tint}>
  {hasGallery ? (
    <button type="button" class="event-hero__visual" data-hero-gallery-open={heroGalleryId} data-hero-gallery-index="0" aria-label={`Открыть изображение события «${event.title}» на весь экран`}>
      {primaryImageUrl && heroMode !== 'fallback-art' ? (
        <img
          class="event-hero__image"
          src={primaryImageUrl}
          alt={heroAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-low-resolution-portrait={primaryLowResolutionPortrait ? 'true' : undefined}
          style={[
            heroObjectPosition ? `object-position:${heroObjectPosition}` : '',
            primaryLowResolutionPortrait && primaryImageAsset?.width ? `--hero-source-width:${primaryImageAsset.width}px` : '',
            primaryLowResolutionPortrait && primaryImageAsset?.height ? `--hero-source-height:${primaryImageAsset.height}px` : '',
          ].filter(Boolean).join(';') || undefined}
        />
      ) : (
        <div class="event-hero__fallback" aria-hidden="true">
          <span>{event.event_type || 'событие'}</span>
          <strong>{event.title}</strong>
        </div>
      )}
      <span class="event-hero__gallery-hint" aria-hidden="true"><Icon name="image" /><span>{galleryHintLabel}</span></span>
    </button>
  ) : (
    <div class="event-hero__visual" aria-label={heroMode === 'fallback-art' ? `Обложка без изображения: ${event.title}` : undefined}>
      <div class="event-hero__fallback" aria-hidden="true">
        <span>{event.event_type || 'событие'}</span>
        <strong>{event.title}</strong>
      </div>
    </div>
  )}

  <div class="event-hero__decision">
    {statusText && <p class="event-hero__eyebrow">{statusText}</p>}
    <HeadingTag class="event-hero__title">{event.title}</HeadingTag>
    <div class="source-links event-hero__actions event-main-actions" aria-label="Быстрые действия события">
      {calendarPrimary && <CalendarLink event={event} className="cta-button" label="В календарь" />}
      {showTicketCta && <a class={calendarPrimary ? 'secondary-button' : 'cta-button'} href={ctaHref} target={ctaIsExternal ? '_blank' : undefined} rel={ctaIsExternal ? 'noopener noreferrer nofollow' : undefined}>{ctaIsTelephone && <Icon name="phone" />}<span>{ctaLabel}</span></a>}
      {soldOut && !showTicketCta && <span class="secondary-button cta-button--disabled" aria-disabled="true">{ctaLabel}</span>}
      {!calendarPrimary && canAddToCalendar && <CalendarLink event={event} className="secondary-button" />}
      <button type="button" class="secondary-button native-share-button" data-nosnippet data-native-share data-share-event-id={event.id} data-share-event-title={event.title} data-share-base-count={sharesCount} data-share-title={event.title} data-share-text={shareText} data-share-url={canonicalUrl} data-share-image={primaryImageUrl || ''} data-share-image-type={shareImageType} data-share-file-name={shareFileName} data-share-date-time={dateTimeLabel} data-share-place={placeLabel} data-share-admission={admissionLabel}>
        <Icon name="share" />
        <span data-share-label>Поделиться</span>
        <span class="feedback-count" data-share-count>{shareCountLabel}</span>
      </button>
      <button type="button" class="secondary-button event-hero__like feedback-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
        <Icon name="heart" />
        <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
      </button>
    </div>
    {metaTreatment !== 'standard' && (
      <p class="event-hero__meta-line event-hero__meta-line--weekday-panel">
        <span class="event-hero__when">
          {weekdayLabel && <span class="event-hero__weekday">{weekdayLabel}</span>}
          <span class="event-hero__date">{dateLabel}</span>
          {event.display_time && <span class="event-hero__time">{event.display_time}</span>}
        </span>
        <span class="event-hero__where">{placeLabel}</span>
      </p>
    )}
    {metaTreatment !== 'weekday-panel' && (
      <p class="event-hero__meta-line event-hero__meta-line--standard">
        <span class="event-hero__when">{dateTimeLabel}</span>
        <span class="event-hero__meta-separator" aria-hidden="true">·</span>
        <span class="event-hero__where">{placeLabel}</span>
      </p>
    )}
    {event.summary && <p class="event-hero__summary">{event.summary}</p>}
  </div>
</section>
{hasGallery && (
  <div class="hero-gallery" id={heroGalleryId} data-hero-gallery data-efficient-portrait-viewer={efficientPortraitViewer ? 'true' : undefined} data-active-index="0" role="dialog" aria-modal="true" aria-labelledby={heroGalleryTitleId} tabindex="-1" hidden>
    <div class="hero-gallery__chrome" aria-hidden="true"></div>
    <div class="hero-gallery__topbar">
      <a class="hero-gallery__brand" href={siteHomeHref()} aria-label="Перейти к афише Полюбить Калининград Анонсы">
        <AnnouncementsLockup variant="mobile" class="hero-gallery__lockup" />
      </a>
      <h2 id={heroGalleryTitleId} class="hero-gallery__event-title">{event.title}</h2>
      <button type="button" class="hero-gallery__close" data-hero-gallery-close aria-label="Закрыть просмотр фото">×</button>
    </div>
    <div class="hero-gallery__viewport">
      <div class="hero-gallery__track" data-hero-gallery-track>
        {galleryImages.map((image, index) => (
          <figure
            class="hero-gallery__slide"
            data-hero-gallery-slide
            data-gallery-slide-kind="image"
            data-gallery-index={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
            style={image.width && image.height ? `--gallery-ratio: ${(image.width / image.height).toFixed(5)}` : undefined}
          >
            <img
              class="hero-gallery__image"
              data-gallery-src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              data-image-text-mode={image.image_text_mode}
              data-media-role={image.media_role}
              data-event-id={event.id}
              data-event-title={event.title}
              data-low-resolution-portrait={image.low_resolution_portrait ? 'true' : undefined}
              width={image.width}
              height={image.height}
              style={[
                image.recommended_object_position ? `object-position:${image.recommended_object_position}` : '',
                image.low_resolution_portrait && image.width ? `--gallery-source-width:${image.width}px` : '',
                image.low_resolution_portrait && image.height ? `--gallery-source-height:${image.height}px` : '',
              ].filter(Boolean).join(';') || undefined}
            />
            <figcaption class="sr-only">Фото события: {event.title}</figcaption>
          </figure>
        ))}
        {galleryCta && (
          <article class="hero-gallery__slide hero-gallery__slide--cta" data-hero-gallery-slide data-gallery-slide-kind="cta" data-gallery-index={galleryImages.length} aria-hidden="true">
            {galleryCtaImageUrl && <img class="hero-gallery__cta-image" data-gallery-src={galleryCtaImageUrl} alt="" loading="lazy" decoding="async" />}
            <div class="hero-gallery__cta-card">
              <span>Дальше можно похожее</span>
              <h2>{galleryCta.title}</h2>
              {galleryCta.meta && <p>{galleryCta.meta}</p>}
              <a class="cta-button" href={galleryCta.href}>{galleryCta.label || 'Смотреть событие'}</a>
            </div>
          </article>
        )}
      </div>
    </div>
    <div class="hero-gallery__caption" aria-hidden="true"><strong>{event.title}</strong></div>
    {gallerySlideCount > 1 && (
      <>
        <button type="button" class="hero-gallery__nav hero-gallery__nav--prev" data-hero-gallery-prev aria-label="Предыдущее фото">‹</button>
        <button type="button" class="hero-gallery__nav hero-gallery__nav--next" data-hero-gallery-next aria-label="Следующее фото">›</button>
      </>
    )}
    <div class="hero-gallery__counter" data-hero-gallery-counter>{gallerySlideCount > 0 ? `1 / ${gallerySlideCount}` : ''}</div>
  </div>
)}
