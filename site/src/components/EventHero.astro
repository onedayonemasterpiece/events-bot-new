---
import type { PreviewEvent } from '../lib/types';
interface Props { event: PreviewEvent }
const { event } = Astro.props;
const preservePoster = event.image_text_mode !== 'visual_only';
const heroClass = ['hero-media', preservePoster ? 'hero-media--preserve' : 'hero-media--cover'].join(' ');
---
<div class={heroClass}>
  {event.image_url ? (
    <img src={event.image_url} alt={event.image_alt} loading="eager" decoding="async" />
  ) : (
    <div class="hero-fallback" role="img" aria-label={`Обложка без изображения: ${event.title}`}>
      <strong>{event.title}</strong>
    </div>
  )}
</div>
