---
import { withBase } from '../lib/events';
interface Props { catalog?: boolean; }
const { catalog = false } = Astro.props;
const captureOnly = import.meta.env.PUBLIC_EVENT_SEARCH_ASSISTANT_CAPTURE_ONLY === '1';
const enabled = catalog || (import.meta.env.PUBLIC_EVENT_SEARCH_ASSISTANT_ENABLED === '1' && import.meta.env.PUBLIC_SITE_MODE !== 'production');
---
{enabled && <div class="assistant" data-assistant data-assistant-capture-only={captureOnly ? 'true' : undefined} data-ds-component="ConversationalSearch" data-ds-version="1" data-assistant-catalog={catalog ? 'true' : undefined} data-assistant-worklet={withBase('/voice/pcm-capture-worklet.js')} data-nosnippet>
  <div data-assistant-composer>
    <p class="eyebrow">Разговорный поиск · прототип</p>
    {captureOnly && <p data-assistant-preview-limit role="note">Проверка записи на вашем компьютере: запись → сохранение → прослушивание → перезагрузка. Аудио остаётся в этом браузере и не отправляется на сервер. Распознавание и разговорный поиск здесь пока отключены.</p>}
    <p>{captureOnly ? 'Войдите через основной поиск и нажмите «Записать голосом». Запись работает, пока это окно открыто. После остановки откройте сохранённые записи ниже.' : 'Расскажите, куда хочется сходить. Сначала проверьте распознанный текст, затем подтвердите запрос. Запись работает, пока это окно открыто.'}</p>
    <p data-assistant-auth role="status">Используется вход основного поиска.</p>
    <div class="assistant__controls">
      <button class="secondary-button" type="button" data-assistant-record disabled>Записать голосом</button>
      <button class="cta-button" type="button" data-assistant-stop hidden>Остановить запись</button>
      <button class="secondary-button" type="button" data-assistant-save-retry hidden>Сохранить оставшееся аудио</button>
    </div>
    <p data-assistant-capture role="status" aria-live="polite">Микрофон выключен.</p>
    <p data-assistant-base>Новый поиск</p>
    <form data-assistant-form>
      <label class="ke-field">
        <span class="ke-field__label">Подтверждённый запрос</span>
        <textarea class="ke-field__control" rows="3" data-assistant-text aria-describedby="assistant-input-help" placeholder="Например: завтра вечером на побережье, не концерт" disabled></textarea>
      </label>
      <p id="assistant-input-help" class="muted-note">Текст можно исправить или дополнить. Условия этого поиска не становятся постоянными интересами.</p>
      <div class="assistant__controls">
        <button class="cta-button" type="submit" data-assistant-submit disabled>Подтвердить и искать</button>
        <button class="secondary-button" type="button" data-assistant-new disabled>Новый поиск</button>
        <button class="secondary-button" type="button" data-assistant-resume hidden>Проверить и продолжить обработку</button>
      </div>
    </form>
    <p data-assistant-processing role="status" aria-live="polite">Обработка не запущена.</p>
  </div>
  <details data-assistant-recordings><summary>Сохранённые записи на этом устройстве</summary><div data-assistant-recording-list></div></details>
  <details data-assistant-history><summary>История ответов</summary><button type="button" class="secondary-button" data-assistant-history-load disabled>Загрузить историю</button><div data-assistant-history-list></div></details>
  <button type="button" class="secondary-button" data-assistant-latest hidden>Новый ответ ↓</button>
  <div data-assistant-answers aria-label="Ответы поиска"></div>
  {catalog && <p class="muted-note">Каталожный образец, без входа и обращений к модели. Состояния: запись, сохранение, частичная запись, ожидание, ответ, уточнение, восстановление.</p>}
</div>}
<script>
  import { mountConversationalSearch } from '../lib/assistant/conversationalSearch';
  document.querySelectorAll<HTMLElement>('[data-assistant]').forEach(root => { void mountConversationalSearch(root); });
</script>
<style is:global>
  [data-assistant] { display: grid; gap: var(--ke-space-4); margin-block: var(--ke-space-6); }
  [data-assistant] [hidden] { display: none !important; }
  .assistant__controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ke-space-2); }
  [data-assistant] textarea { resize: vertical; min-block-size: 7rem; width: 100%; box-sizing: border-box; }
  [data-assistant] details { overflow-wrap: anywhere; }
  [data-assistant-recording-list], [data-assistant-history-list] { display: grid; gap: var(--ke-space-3); margin-block: var(--ke-space-3); }
  [data-assistant-answers] { display: grid; gap: var(--ke-space-8); }
  [data-assistant-section] { display: grid; gap: var(--ke-space-4); padding-block: var(--ke-space-4); border-block-start: 1px solid var(--ke-color-line); }
  [data-assistant-section] h2 { margin: 0; font-size: var(--ke-font-size-500); overflow-wrap: anywhere; }
  [data-assistant-question] { white-space: pre-wrap; overflow-wrap: anywhere; }
  [data-assistant-recording-list] audio { max-width: 100%; }
</style>
