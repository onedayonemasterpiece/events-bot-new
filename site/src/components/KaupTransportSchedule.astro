---
import Icon from './Icon.astro';
import TransportTimetableExperiment from './transport/TransportTimetableExperiment.astro';
import { getKaupTransportSuggestion } from '../lib/eventKaupTransport';
import { normalizeTransportExperimentMode } from '../lib/transportExperiment';
import type { PreviewEvent } from '../lib/types';

interface Props { event: PreviewEvent; compact?: boolean; }
const { event, compact = false } = Astro.props;
const suggestion = getKaupTransportSuggestion(event);
const headingId = suggestion ? `kaup-transport-${event.id}` : undefined;
const experimentMode = normalizeTransportExperimentMode(import.meta.env.PUBLIC_TRANSPORT_TIMETABLE_EXPERIMENT_MODE);
const experimentReleaseId = import.meta.env.PUBLIC_STATIC_RELEASE_ID || import.meta.env.PUBLIC_PREVIEW_BUILD_ID || 'unversioned';
const personalizationSupabaseUrl = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '';
const personalizationSupabaseRelayUrl = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL || '';
const personalizationSupabaseKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
---
{suggestion && (
  <aside class:list={['kaup-transport', compact && 'kaup-transport--compact']} data-kaup-transport data-kaup-compact={compact ? '' : undefined} aria-labelledby={headingId}>
    <header class="kaup-transport__header">
      <div><p>Маршрут из Калининграда</p><h2 id={headingId}>Как добраться на Кауп</h2></div>
      <Icon name="pin" />
    </header>

    <section class="kaup-transport__transfer" data-kaup-official-transfer>
      <div class="kaup-transport__transfer-copy">
        <h3>Официальный трансфер · {suggestion.transferPriceLabel}</h3>
        <details class="kaup-transport__transfer-details">
          <summary>Точки посадки и условия</summary>
          <p>Место посадки и номер автобуса или микроавтобуса приходят на email после 19:00 накануне события. Посадка только по заранее купленному и распечатанному билету.</p>
          <ul>{suggestion.transferBoardingPoints.map((point) => <li>{point}</li>)}</ul>
        </details>
      </div>
      <a href={suggestion.transferBookingUrl} target="_blank" rel="noopener noreferrer nofollow" data-transport-action="official_transfer_booking_click"><Icon name="ticket" /> {compact ? 'Купить' : 'Купить трансфер'}</a>
    </section>

    <section class="kaup-transport__bus" data-kaup-public-bus data-kaup-bus-origin>
      <span class="sr-only">{suggestion.busOriginName} · {suggestion.busOriginAddress}</span>
      {suggestion.outbound.length > 0 ? <TransportTimetableExperiment
        eventId={event.id}
        suggestion={suggestion}
        mode={experimentMode}
        releaseId={experimentReleaseId}
        supabaseUrl={personalizationSupabaseUrl}
        supabaseRelayUrl={personalizationSupabaseRelayUrl}
        supabaseKey={personalizationSupabaseKey}
      /> : <p>Подходящих рейсов к началу события не найдено.</p>}

    </section>

    <section class="kaup-transport__car" data-kaup-car-route>
      <Icon name="car" />
      <p><strong>На автомобиле</strong><span>Калининград → Кауп</span></p>
      <a href={suggestion.directionsMapUrl} target="_blank" rel="noopener noreferrer nofollow" title="Открыть маршрут" aria-label="Открыть автомобильный маршрут из Калининграда на Кауп" data-transport-action="car_route_click"><Icon name="pin" /></a>
    </section>

    <footer><span class="kaup-transport__source-label">Источники:</span> <a href={suggestion.officialSourceUrl} target="_blank" rel="noopener noreferrer nofollow">официальный сайт Кауп</a> <span class="kaup-transport__source-separator" aria-hidden="true">·</span> <a href={suggestion.scheduleSourceUrl} target="_blank" rel="noopener noreferrer nofollow">расписание автобусов</a> <span class="kaup-transport__schedule-effective">(с {suggestion.scheduleEffectiveFrom}).</span></footer>
  </aside>
)}

<style>
  .kaup-transport { container:kaup-transport / inline-size; margin:1.25rem 0 0; overflow:hidden; border:1px solid var(--ke-color-kaup-border); border-radius:18px; background:var(--ke-color-kaup-surface); color:var(--ke-color-transport-route-text); box-shadow:var(--ke-elevation-kaup); }
  .kaup-transport__header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.9rem 1rem .75rem; }
  .kaup-transport__header p { margin:0; color:var(--ke-color-transport-departure); font-size:.68rem; font-weight:900; letter-spacing:.075em; text-transform:uppercase; }
  .kaup-transport__header h2 { margin:.1rem 0 0; font-size:clamp(1.35rem,2.4vw,1.8rem); line-height:1.12; }
  .kaup-transport__header :global(.icon) { width:1.65rem; height:1.65rem; color:#a54821; }
  .kaup-transport__transfer { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.75rem; padding:.85rem 1rem; border-top:1px solid var(--ke-color-kaup-section-line); background:var(--ke-color-kaup-transfer-surface); color:var(--ke-color-kaup-transfer-text); }
  .kaup-transport__transfer h3,.kaup-transport__bus h3 { margin:0; font-size:1.05rem; line-height:1.25; }
  .kaup-transport__transfer-details { margin:.25rem 0 0; }
  .kaup-transport__transfer-details summary { display:flex; align-items:center; gap:.55rem; width:max-content; min-height:44px; cursor:pointer; color:var(--ke-color-kaup-transfer-muted); font-size:.78rem; font-weight:750; list-style:none; text-decoration:underline; text-decoration-color:rgba(255,255,255,.38); text-underline-offset:.16em; }
  .kaup-transport__transfer-details summary::-webkit-details-marker { display:none; }
  .kaup-transport__transfer-details summary::after { width:.42rem; height:.42rem; border-right:1.5px solid; border-bottom:1.5px solid; content:""; transform:rotate(45deg) translateY(-.1rem); }
  .kaup-transport__transfer-details[open] summary::after { transform:rotate(225deg); }
  .kaup-transport__transfer-details p { max-width:58rem; margin:.35rem 0; color:var(--ke-color-kaup-transfer-copy); font-size:.8rem; line-height:1.4; }
  .kaup-transport__transfer-details ul { display:flex; flex-wrap:wrap; gap:.3rem .85rem; margin:.35rem 0 0; padding:0; list-style:none; color:var(--ke-color-kaup-transfer-action-text); font-size:.78rem; }
  .kaup-transport__transfer-details li::before { color:var(--ke-color-kaup-transfer-bullet); content:"• "; }
  .kaup-transport__transfer>a { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; min-height:44px; padding:.58rem .8rem; border-radius:11px; background:var(--ke-color-kaup-transfer-action); color:var(--ke-color-kaup-transfer-action-text); font-size:.86rem; font-weight:900; text-decoration:none; white-space:nowrap; }
  .kaup-transport__transfer>a :global(.icon) { width:1.1rem; height:1.1rem; }
  .kaup-transport__bus { margin:.8rem 1rem; padding:.78rem; border-radius:16px; background:var(--ke-color-transport-timeline-surface); }
  .kaup-transport__car a { display:inline-flex; flex:0 0 auto; align-items:center; justify-content:center; width:44px; min-height:44px; margin-left:auto; border-radius:50%; color:var(--ke-color-transport-route); text-decoration:none; }
  .kaup-transport__car a:hover { background:var(--ke-color-transport-route-hover); }
  .kaup-transport__car a :global(.icon) { width:1.2rem; height:1.2rem; }
  .kaup-transport__car { display:flex; align-items:center; gap:.55rem; padding:.55rem 1rem; border-top:1px solid var(--ke-color-kaup-section-line); }
  .kaup-transport__car>:global(.icon) { width:1.25rem; height:1.25rem; flex:0 0 auto; color:var(--ke-color-transport-route); }
  .kaup-transport__car p { display:flex; flex-wrap:wrap; gap:.2rem .55rem; margin:0; font-size:.82rem; }
  .kaup-transport__car p span { color:var(--ke-color-transport-route-muted-warm); }
  .kaup-transport footer { padding:.48rem 1rem; border-top:1px solid var(--ke-color-kaup-footer-line); color:var(--ke-color-transport-route-muted-warm); font-size:.7rem; line-height:1.35; }
  .kaup-transport footer a { color:var(--ke-color-transport-tight); font-weight:800; }
  .kaup-transport footer a,.kaup-transport footer .kaup-transport__schedule-effective { margin-left:.18rem; }
  @container kaup-transport (max-width:560px) {
    .kaup-transport__header { padding:.75rem .8rem .6rem; }
    .kaup-transport__header h2 { font-size:1.18rem; }
    .kaup-transport__header :global(.icon) { width:1.35rem; height:1.35rem; }
    .kaup-transport__transfer { padding:.72rem .8rem; }
    .kaup-transport__transfer h3 { font-size:.93rem; }
    .kaup-transport__transfer>a { padding:.52rem .65rem; }
    .kaup-transport__bus { margin:.65rem .7rem; padding:.65rem; }
    .kaup-transport__car { padding:.48rem .8rem; }
    .kaup-transport footer { padding:.42rem .8rem; font-size:.65rem; }
  }
  .kaup-transport--compact { margin-top:1rem; border-radius:15px; background:var(--ke-color-kaup-surface); }
  .kaup-transport--compact .kaup-transport__transfer { background:var(--ke-color-kaup-transfer-surface-compact); }
  @container kaup-transport (max-width:360px) {
    .kaup-transport__transfer { grid-template-columns:minmax(0,1fr) auto; gap:.45rem; }
  }
</style>
