---
import './design-system/product-contour-foundations.css';
import './design-system/component-foundations.css';
import { withBase } from '../lib/events';

interface Props {
  label?: string;
  detail?: string;
  size?: 'compact' | 'hero';
}

const {
  label = 'Лаборатория сайта',
  detail = 'Прототип',
  size = 'compact',
} = Astro.props;
const iconHref = withBase('/assets/icons/lab-flask-287837.svg');
---

<span
  class:list={['focus-lab-badge', `focus-lab-badge--${size}`]}
  data-ds-family="FocusLabBadge"
  data-ds-version="1"
  data-ds-variant={size}
  data-ds-state="static"
>
  <span class="focus-lab-badge__icon" aria-hidden="true">
    <img src={iconHref} width="32" height="32" alt="" />
  </span>
  <span class="focus-lab-badge__copy">
    <strong>{label}</strong>
    <small>{detail}</small>
  </span>
</span>

<style>
  .focus-lab-badge {
    width: fit-content;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-focus-brand-marker-border);
    border-radius: var(--ke-shape-radius-pill);
    padding: .35rem .7rem .35rem .4rem;
    background: var(--ke-color-focus-brand-marker-surface);
    color: var(--ke-color-text-primary);
    font-family: var(--ke-font-family-sans);
    box-shadow: var(--ke-elevation-card);
  }

  .focus-lab-badge__icon {
    width: var(--ke-focus-lab-icon-container-size);
    height: var(--ke-focus-lab-icon-container-size);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ke-color-focus-control-surface);
  }

  .focus-lab-badge__icon img {
    width: var(--ke-focus-lab-icon-size);
    height: var(--ke-focus-lab-icon-size);
    display: block;
    object-fit: contain;
  }

  .focus-lab-badge__copy {
    min-width: 0;
    display: grid;
    gap: .08rem;
    line-height: 1.05;
  }

  .focus-lab-badge strong {
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .025em;
  }

  .focus-lab-badge small {
    color: var(--ke-color-text-muted);
    font-size: .67rem;
    font-weight: 750;
  }

  .focus-lab-badge--hero {
    gap: .75rem;
    padding: .48rem .9rem .48rem .5rem;
  }

  .focus-lab-badge--hero .focus-lab-badge__icon {
    width: var(--ke-focus-lab-icon-container-size-hero);
    height: var(--ke-focus-lab-icon-container-size-hero);
  }

  .focus-lab-badge--hero .focus-lab-badge__icon img {
    width: var(--ke-focus-lab-icon-size-hero);
    height: var(--ke-focus-lab-icon-size-hero);
  }

  .focus-lab-badge--hero strong { font-size: .9rem; }
  .focus-lab-badge--hero small { font-size: .76rem; }
</style>
