---
import { withBase } from '../lib/events';

interface Props {
  surface?: 'footer' | 'menu' | 'lab';
  desktopMode?: 'd0' | 'd1' | 'd2';
  manifestUrl?: string;
  class?: string;
}

const requestedMode = String(Astro.props.desktopMode || import.meta.env.PUBLIC_SERVICE_SHARE_DESKTOP_MODE || 'd0').toLowerCase();
const desktopMode = ['d0', 'd1', 'd2'].includes(requestedMode) ? requestedMode as 'd0' | 'd1' | 'd2' : 'd0';
const surface = Astro.props.surface || 'footer';
const manifestUrl = Astro.props.manifestUrl || withBase('/service-share/current/manifest.json');
const className = Astro.props.class;
const isFooter = surface === 'footer';
const desktopLabel = desktopMode === 'd0' ? 'Скопировать ссылку' : 'Скопировать карточку';
---

<section
  class:list={['service-share-action', `service-share-action--${surface}`, className]}
  data-service-share-root
  data-service-share-surface={surface}
  data-service-share-desktop-mode={desktopMode}
  data-service-share-manifest-url={manifestUrl}
  data-service-share-canonical-url="https://kenigevents.ru/"
  data-nosnippet
>
  {isFooter && (
    <div class="service-share-action__copy">
      <strong>Понравилась афиша?</strong>
      <span>Поделитесь KenigEvents — афишей событий Калининграда и области.</span>
    </div>
  )}
  <div class="service-share-action__controls">
    <button
      type="button"
      class="service-share-action__button"
      data-service-share-button
      aria-label="Поделиться KenigEvents"
      aria-describedby={`service-share-status-${surface}-${desktopMode}`}
      aria-busy="false"
    >
      <svg class="service-share-action__icon service-share-action__icon--mobile" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M11.996 3.725A2.15 2.15 0 0 0 10 5.87l-.001 2.117-.02.005a9.904 9.904 0 0 0-7.827 10.721c.083.811 1.116 1.103 1.611.455l.187-.237a9.08 9.08 0 0 1 5.836-3.265l.213-.026.001 2.494a2.15 2.15 0 0 0 3.476 1.692l7.824-6.132a2.15 2.15 0 0 0 0-3.384l-7.824-6.132a2.15 2.15 0 0 0-1.326-.458zm.154 1.795a.35.35 0 0 1 .216.075l7.824 6.132a.35.35 0 0 1 0 .55l-7.824 6.133a.35.35 0 0 1-.566-.276l-.001-3.447a.9.9 0 0 0-.915-.9l-.233.004-.342.017a10.9 10.9 0 0 0-6.119 2.365l-.174.144.024-.135a8.1 8.1 0 0 1 6.968-6.537.9.9 0 0 0 .791-.893L11.8 5.87a.35.35 0 0 1 .35-.35"></path>
      </svg>
      <svg class="service-share-action__icon service-share-action__icon--desktop" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="currentColor" d="M8 3.25A2.75 2.75 0 0 0 5.25 6v9A2.75 2.75 0 0 0 8 17.75h1.25V18A2.75 2.75 0 0 0 12 20.75h6A2.75 2.75 0 0 0 20.75 18V9A2.75 2.75 0 0 0 18 6.25h-1.25V6A2.75 2.75 0 0 0 14 3.25H8Zm7.25 3H12A2.75 2.75 0 0 0 9.25 9v7.25H8A1.25 1.25 0 0 1 6.75 15V6A1.25 1.25 0 0 1 8 4.75h6A1.25 1.25 0 0 1 15.25 6v.25ZM12 7.75h6A1.25 1.25 0 0 1 19.25 9v9A1.25 1.25 0 0 1 18 19.25h-6A1.25 1.25 0 0 1 10.75 18V9A1.25 1.25 0 0 1 12 7.75Z"></path>
      </svg>
      <span class="service-share-action__label service-share-action__label--mobile">Поделиться</span>
      <span class="service-share-action__label service-share-action__label--desktop">{desktopLabel}</span>
    </button>
    <span
      id={`service-share-status-${surface}-${desktopMode}`}
      class="service-share-action__status"
      data-service-share-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></span>
    <a
      class="service-share-action__fallback"
      data-service-share-fallback
      href="https://kenigevents.ru/"
      hidden
    >https://kenigevents.ru/</a>
    <noscript>
      <a class="service-share-action__fallback" href="https://kenigevents.ru/">https://kenigevents.ru/</a>
    </noscript>
  </div>
</section>

<style>
  .service-share-action {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .7rem 1rem;
  }
  .service-share-action--footer {
    justify-content: space-between;
    padding: .9rem 1rem;
    border: 1px solid rgba(121,48,20,.14);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255,253,248,.96), rgba(255,244,228,.9));
    box-shadow: 0 10px 24px rgba(72,45,25,.07);
  }
  .service-share-action__copy { min-width: min(100%, 16rem); display: grid; gap: .12rem; line-height: 1.3; }
  .service-share-action__copy strong { color: var(--text); font-size: 1rem; }
  .service-share-action__copy span { color: var(--muted); font-size: .88rem; }
  .service-share-action__controls { min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; }
  .service-share-action__button {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .48rem;
    padding: .58rem .88rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-text);
    box-shadow: 0 8px 18px rgba(121,48,20,.17);
    font: inherit;
    font-size: .92rem;
    font-weight: 850;
    line-height: 1.1;
    cursor: pointer;
    touch-action: manipulation;
  }
  .service-share-action__button:hover { background: var(--primary-strong); }
  .service-share-action__button:disabled { opacity: .66; cursor: wait; }
  .service-share-action__icon { width: 1.2rem; height: 1.2rem; flex: 0 0 auto; }
  .service-share-action__icon--desktop { display: none; }
  .service-share-action__label--desktop { display: none; }
  .service-share-action__status { min-height: 1.25rem; color: var(--muted); font-size: .8rem; line-height: 1.25; }
  .service-share-action__status:empty { display: none; }
  .service-share-action__fallback { color: var(--primary-strong); font-size: .86rem; font-weight: 760; overflow-wrap: anywhere; }
  .service-share-action__fallback:focus-visible { border-radius: 4px; }
  .service-share-action--lab { display: grid; align-content: start; }
  .service-share-action--lab .service-share-action__controls { display: grid; justify-items: start; }
  @media (min-width: 768px) {
    .service-share-action__icon--mobile { display: none; }
    .service-share-action__icon--desktop { display: block; }
    .service-share-action__label--mobile { display: none; }
    .service-share-action__label--desktop { display: inline; }
  }
  @media (max-width: 560px) {
    .service-share-action--footer { align-items: stretch; }
    .service-share-action--footer .service-share-action__controls { width: 100%; display: grid; }
    .service-share-action--footer .service-share-action__button { width: 100%; }
  }
</style>

<script>
  import { hydrateServiceShareActions } from '../lib/service-share/controller.js';
  hydrateServiceShareActions();
</script>
