---
import { withBase } from '../lib/events';

interface Props {
  surface?: 'footer' | 'menu' | 'lab';
  desktopMode?: 'd0' | 'd1' | 'd2';
  manifestUrl?: string;
  class?: string;
}

// Keep the legacy mode marker while old preview configurations are retired.
// Desktop behavior no longer varies by mode: both explicit intents are always shown.
const requestedMode = String(Astro.props.desktopMode || import.meta.env.PUBLIC_SERVICE_SHARE_DESKTOP_MODE || 'd0').toLowerCase();
const desktopMode = ['d0', 'd1', 'd2'].includes(requestedMode) ? requestedMode as 'd0' | 'd1' | 'd2' : 'd0';
const surface = Astro.props.surface || 'footer';
const manifestUrl = Astro.props.manifestUrl || withBase('/service-share/current/manifest.json');
const linkIconUrl = withBase('/assets/icons/link-minimalistic-svgrepo.svg');
const className = Astro.props.class;
const statusId = `service-share-status-${surface}-${desktopMode}`;
---

<section
  class:list={['service-share-action', `service-share-action--${surface}`, className]}
  data-service-share-root
  data-service-share-surface={surface}
  data-service-share-desktop-mode={desktopMode}
  data-service-share-manifest-url={manifestUrl}
  data-service-share-canonical-url="https://kenigevents.ru/"
  data-nosnippet
>
  <span class="service-share-action__prompt">Поделиться афишей</span>
  <div class="service-share-action__controls">
    <button
      type="button"
      class="service-share-action__button service-share-action__button--mobile"
      data-service-share-button
      data-service-share-intent="mobile"
      aria-label="Поделиться афишей KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <svg class="service-share-action__icon service-share-action__icon--default" data-service-share-icon-default aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M11.996 3.725A2.15 2.15 0 0 0 10 5.87l-.001 2.117-.02.005a9.904 9.904 0 0 0-7.827 10.721c.083.811 1.116 1.103 1.611.455l.187-.237a9.08 9.08 0 0 1 5.836-3.265l.213-.026.001 2.494a2.15 2.15 0 0 0 3.476 1.692l7.824-6.132a2.15 2.15 0 0 0 0-3.384l-7.824-6.132a2.15 2.15 0 0 0-1.326-.458zm.154 1.795a.35.35 0 0 1 .216.075l7.824 6.132a.35.35 0 0 1 0 .55l-7.824 6.133a.35.35 0 0 1-.566-.276l-.001-3.447a.9.9 0 0 0-.915-.9l-.233.004-.342.017a10.9 10.9 0 0 0-6.119 2.365l-.174.144.024-.135a8.1 8.1 0 0 1 6.968-6.537.9.9 0 0 0 .791-.893L11.8 5.87a.35.35 0 0 1 .35-.35"></path>
      </svg>
      <svg class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.2 4.2L19 7"></path>
      </svg>
      <span>Поделиться</span>
    </button>

    <button
      type="button"
      class="service-share-action__button service-share-action__button--desktop"
      data-service-share-button
      data-service-share-intent="image"
      aria-label="Скопировать карточку KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <svg class="service-share-action__icon service-share-action__icon--default" data-service-share-icon-default aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="currentColor" d="M7 3.25A3.75 3.75 0 0 0 3.25 7v10A3.75 3.75 0 0 0 7 20.75h10A3.75 3.75 0 0 0 20.75 17V7A3.75 3.75 0 0 0 17 3.25H7ZM4.75 7A2.25 2.25 0 0 1 7 4.75h10A2.25 2.25 0 0 1 19.25 7v7.19l-2.72-2.72a.75.75 0 0 0-1.06 0l-2.22 2.22-3.72-3.72a.75.75 0 0 0-1.06 0l-3.72 3.72V7Zm0 8.81 4.25-4.25 3.72 3.72a.75.75 0 0 0 1.06 0L16 13.06l3.25 3.25V17A2.25 2.25 0 0 1 17 19.25H7A2.25 2.25 0 0 1 4.75 17v-1.19ZM15.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"></path>
      </svg>
      <svg class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.2 4.2L19 7"></path>
      </svg>
      <span>Скопировать карточку</span>
    </button>

    <button
      type="button"
      class="service-share-action__button service-share-action__button--desktop"
      data-service-share-button
      data-service-share-intent="text"
      aria-label="Скопировать текст и ссылку KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <span
        class="service-share-action__icon service-share-action__icon--default service-share-action__icon--mask"
        data-service-share-icon-default
        aria-hidden="true"
        style={`--service-share-icon-url: url("${linkIconUrl}")`}
      ></span>
      <svg class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m5 12.5 4.2 4.2L19 7"></path>
      </svg>
      <span>Скопировать текст и ссылку</span>
    </button>

    <span
      id={statusId}
      class="service-share-action__status"
      data-service-share-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></span>
    <a
      class="service-share-action__fallback"
      data-service-share-fallback
      href="https://kenigevents.ru/"
      hidden
    >https://kenigevents.ru/</a>
    <noscript>
      <a class="service-share-action__fallback" href="https://kenigevents.ru/">https://kenigevents.ru/</a>
    </noscript>
  </div>
</section>

<style>
  .service-share-action {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem .75rem;
  }
  .service-share-action--footer {
    padding: 0;
  }
  .service-share-action__prompt {
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.4;
  }
  .service-share-action__controls {
    min-width: 0;
    display: flex;
    flex: 1 1 32rem;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
  }
  .service-share-action__button {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    max-width: 100%;
    padding: .55rem .8rem;
    border: 1px solid rgba(121, 48, 20, .48);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    box-shadow: none;
    font: inherit;
    font-size: .88rem;
    font-weight: 760;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 160ms ease-out, border-color 160ms ease-out;
  }
  .service-share-action__button:hover {
    border-color: var(--primary-strong);
    background: rgba(121, 48, 20, .06);
  }
  .service-share-action__button:focus-visible,
  .service-share-action__fallback:focus-visible {
    outline: 3px solid var(--primary-strong);
    outline-offset: 3px;
  }
  .service-share-action__button:disabled {
    opacity: .56;
    cursor: wait;
  }
  .service-share-action__icon {
    width: 1.15rem;
    height: 1.15rem;
    flex: 0 0 auto;
  }
  .service-share-action__icon--mask {
    display: block;
    background: currentColor;
    -webkit-mask: var(--service-share-icon-url) center / contain no-repeat;
    mask: var(--service-share-icon-url) center / contain no-repeat;
  }
  .service-share-action__icon--success { display: none; }
  .service-share-action__button[data-service-share-state="success"] {
    border-color: #3f8a5b;
    background: rgba(63, 138, 91, .09);
    color: #2f7449;
  }
  .service-share-action__button[data-service-share-state="success"] .service-share-action__icon--default { display: none; }
  .service-share-action__button[data-service-share-state="success"] .service-share-action__icon--success { display: block; }
  .service-share-action__button[data-service-share-state="error"] {
    border-color: #a85645;
    background: rgba(168, 86, 69, .07);
    color: #8b4537;
  }
  .service-share-action__button--desktop { display: none; }
  .service-share-action__status {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
  .service-share-action__fallback {
    color: var(--primary-strong);
    font-size: .86rem;
    font-weight: 760;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .service-share-action__button--mobile { display: none; }
    .service-share-action__button--desktop { display: inline-flex; }
  }
  @media (max-width: 767px) {
    .service-share-action { align-items: stretch; }
    .service-share-action__prompt { flex: 1 1 100%; }
    .service-share-action__controls { width: 100%; flex-basis: 100%; }
    .service-share-action__button--mobile { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-share-action__button { transition: none; }
  }
</style>

<script>
  import { hydrateServiceShareActions } from '../lib/service-share/controller.js';
  hydrateServiceShareActions();
</script>
