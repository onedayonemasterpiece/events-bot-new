---
import { withBase } from '../lib/events';
import AnnouncementsWordmark from './brand/AnnouncementsWordmark.astro';
import SemanticIcon from './design-system/SemanticIcon.astro';

interface Props {
  surface?: 'footer' | 'menu' | 'lab';
  desktopMode?: 'd0' | 'd1' | 'd2';
  manifestUrl?: string;
  showPrompt?: boolean;
  class?: string;
}

// Keep the legacy mode marker while old preview configurations are retired.
// Desktop behavior no longer varies by mode: both explicit intents are always shown.
const requestedMode = String(Astro.props.desktopMode || import.meta.env.PUBLIC_SERVICE_SHARE_DESKTOP_MODE || 'd0').toLowerCase();
const desktopMode = ['d0', 'd1', 'd2'].includes(requestedMode) ? requestedMode as 'd0' | 'd1' | 'd2' : 'd0';
const surface = Astro.props.surface || 'footer';
const manifestUrl = Astro.props.manifestUrl || withBase('/service-share/current/manifest.json');
const showPrompt = Astro.props.showPrompt !== false;
const className = Astro.props.class;
const statusId = `service-share-status-${surface}-${desktopMode}`;
---

<section
  class:list={['service-share-action', `service-share-action--${surface}`, className]}
  data-service-share-root
  data-service-share-surface={surface}
  data-service-share-desktop-mode={desktopMode}
  data-service-share-manifest-url={manifestUrl}
  data-service-share-canonical-url="https://kenigevents.ru/"
  data-nosnippet
>
  {showPrompt && (
    <span class="service-share-action__prompt" aria-label="Понравились Анонсы? Поделитесь">
      <span class="sr-only">Понравились Анонсы? Поделитесь</span>
      <span aria-hidden="true">Понравились</span>
      <AnnouncementsWordmark class="service-share-action__wordmark" />
      <span aria-hidden="true">?</span>
      <strong aria-hidden="true">Поделитесь</strong>
    </span>
  )}
  <div class="service-share-action__controls">
    <button
      type="button"
      class="service-share-action__button service-share-action__button--mobile"
      data-service-share-button
      data-service-share-intent="mobile"
      aria-label="Поделиться анонсами KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <span class="service-share-action__icon service-share-action__icon--default" data-service-share-icon-default aria-hidden="true">
        <SemanticIcon name="share" role="control" />
      </span>
      <span class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true">
        <SemanticIcon name="check" role="control" />
      </span>
      <span>Поделиться</span>
    </button>

    <button
      type="button"
      class="service-share-action__button service-share-action__button--desktop"
      data-service-share-button
      data-service-share-intent="image"
      aria-label="Скопировать карточку KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <span class="service-share-action__icon service-share-action__icon--default" data-service-share-icon-default aria-hidden="true">
        <SemanticIcon name="image" role="control" />
      </span>
      <span class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true">
        <SemanticIcon name="check" role="control" />
      </span>
      <span>Скопировать карточку</span>
      {surface === 'footer' && <kbd class="service-share-action__shortcut" data-service-shortcut-badge aria-hidden="true">P</kbd>}
    </button>

    <button
      type="button"
      class="service-share-action__button service-share-action__button--desktop"
      data-service-share-button
      data-service-share-intent="text"
      aria-label="Скопировать текст и ссылку KenigEvents"
      aria-describedby={statusId}
      aria-busy="false"
    >
      <span class="service-share-action__icon service-share-action__icon--default" data-service-share-icon-default aria-hidden="true">
        <SemanticIcon name="link" role="control" />
      </span>
      <span class="service-share-action__icon service-share-action__icon--success" data-service-share-icon-success aria-hidden="true">
        <SemanticIcon name="check" role="control" />
      </span>
      <span>Скопировать текст и ссылку</span>
      {surface === 'footer' && <kbd class="service-share-action__shortcut" data-service-shortcut-badge aria-hidden="true">S</kbd>}
    </button>

    <span
      id={statusId}
      class="service-share-action__status"
      data-service-share-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></span>
    <a
      class="service-share-action__fallback"
      data-service-share-fallback
      href="https://kenigevents.ru/"
      hidden
    >https://kenigevents.ru/</a>
    <noscript>
      <a class="service-share-action__fallback" href="https://kenigevents.ru/">https://kenigevents.ru/</a>
    </noscript>
  </div>
</section>

<style>
  .service-share-action {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem .75rem;
  }
  .service-share-action--footer {
    padding: 0;
  }
  .service-share-action__prompt {
    display:inline-flex;
    flex-wrap:wrap;
    align-items:center;
    gap:.18rem .28rem;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.4;
  }
  .service-share-action__prompt strong { color:var(--text); font-weight:780; }
  .service-share-action__prompt :global(.service-share-action__wordmark) {
    width:auto;
    height:1em;
    flex:0 0 auto;
    color:var(--primary-strong);
  }
  .service-share-action__controls {
    min-width: 0;
    display: flex;
    flex: 1 1 32rem;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
  }
  .service-share-action__button {
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    max-width: 100%;
    padding: .55rem .8rem;
    border: 1px solid rgba(121, 48, 20, .48);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    box-shadow: none;
    font: inherit;
    font-size: .88rem;
    font-weight: 760;
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 160ms ease-out, border-color 160ms ease-out;
  }
  .service-share-action__button:hover {
    border-color: var(--primary-strong);
    background: rgba(121, 48, 20, .06);
  }
  .service-share-action__button:focus-visible,
  .service-share-action__fallback:focus-visible {
    outline: 3px solid var(--primary-strong);
    outline-offset: 3px;
  }
  .service-share-action__button:disabled {
    opacity: .56;
    cursor: wait;
  }
  .service-share-action__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .service-share-action__icon--success { display: none; }
  .service-share-action__button[data-service-share-state="success"] {
    border-color: #3f8a5b;
    background: rgba(63, 138, 91, .09);
    color: #2f7449;
  }
  .service-share-action__button[data-service-share-state="success"] .service-share-action__icon--default { display: none; }
  .service-share-action__button[data-service-share-state="success"] .service-share-action__icon--success { display: inline-flex; }
  .service-share-action__button[data-service-share-state="error"] {
    border-color: #a85645;
    background: rgba(168, 86, 69, .07);
    color: #8b4537;
  }
  .service-share-action__button--desktop { display: none; }
  .service-share-action__shortcut { display:none; min-width:1.45rem; min-height:1.35rem; align-items:center; justify-content:center; padding:.08rem .28rem; border:1px solid rgba(121,48,20,.5); border-bottom-color:rgba(121,48,20,.76); border-radius:4px; background:rgba(121,48,20,.06); color:var(--primary-strong); box-shadow:0 1px 0 rgba(0,0,0,.16); font:800 .68rem/1 ui-monospace,SFMono-Regular,Consolas,monospace; text-transform:uppercase; }
  .service-share-action__status {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
  .service-share-action__fallback {
    color: var(--primary-strong);
    font-size: .86rem;
    font-weight: 760;
    overflow-wrap: anywhere;
  }
  @media (min-width: 768px) {
    .service-share-action__button--mobile { display: none; }
    .service-share-action__button--desktop { display: inline-flex; }
  }
  @media (min-width: 1024px) {
    .service-share-action--footer .service-share-action__shortcut { display:inline-flex; }
  }
  @media (max-width: 767px) {
    .service-share-action { align-items: stretch; }
    .service-share-action__prompt { flex: 1 1 100%; }
    .service-share-action__controls { width: 100%; flex-basis: 100%; }
    .service-share-action__button--mobile { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-share-action__button { transition: none; }
  }
</style>

<script>
  import { hydrateServiceShareActions } from '../lib/service-share/controller.js';
  hydrateServiceShareActions();
</script>
