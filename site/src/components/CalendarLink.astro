---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { eventCalendarHref, eventCalendarStateExpiryDay, isCalendarEligible, isEventDetailCalendarEligible } from '../lib/events';
interface Props { event: PreviewEvent; className?: string; label?: string; compact?: boolean; surface?: 'listing' | 'detail' }
const { event, className = 'secondary-button', label = 'В календарь', compact = false, surface = 'detail' } = Astro.props;
const canAddToCalendar = surface === 'detail' ? isEventDetailCalendarEligible(event) : isCalendarEligible(event);
const calendarExpiryDay = eventCalendarStateExpiryDay(event);
---
{canAddToCalendar && (
  <a
    class={className}
    href={eventCalendarHref(event)}
    type="text/calendar"
    data-calendar-action
    data-calendar-adaptive-label={compact ? '' : undefined}
    data-calendar-event-id={event.id}
    data-calendar-expiry-day={calendarExpiryDay}
    data-calendar-event-title={event.title}
    aria-label={`Добавить в календарь: ${event.title}`}
    title={compact ? label : undefined}
  ><Icon name="calendar" /> <span data-calendar-label>{label}</span></a>
)}
