---
import Button from './design-system/Button.astro';
import SemanticIcon from './design-system/SemanticIcon.astro';
import './design-system/product-contour-foundations.css';

interface Props {
  pageFamily?: string;
  pageLabel?: string;
  overallNpsDue?: boolean;
  showEventIssue?: boolean;
  eventId?: string;
  eventLabel?: string;
}

const {
  pageFamily = 'home',
  pageLabel = 'эта страница',
  overallNpsDue = false,
  showEventIssue = false,
  eventId,
  eventLabel = 'событие из демонстрационного сценария',
} = Astro.props;
const idPrefix = `focus-feedback-${pageFamily.replace(/[^a-z0-9_-]/giu, '-')}`;
---

<section
  class="focus-feedback"
  data-ds-family="FocusGroupFeedback"
  data-ds-version="1"
  data-ds-variant={showEventIssue ? 'surface-and-event-issue' : 'surface'}
  data-ds-state="idle"
  data-focus-feedback
  data-default-kind={overallNpsDue ? 'overall' : 'surface'}
  aria-labelledby={`${idPrefix}-title`}
>
  <div>
    <p class="focus-feedback__eyebrow">Обратная связь · прототип</p>
    <h2 id={`${idPrefix}-title`}>Разные вопросы — разные сигналы</h2>
    <p>
      Общий NPS задаётся раз в неделю или при выходе. Полезность относится только
      к текущей странице. Улучшение доступно всегда, а ошибка в событии идёт
      отдельным путём проверки фактов.
    </p>
  </div>
  <div class="focus-feedback__launchers" aria-label="Виды обратной связи">
    {overallNpsDue && (
      <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-feedback-open="overall">
        Общий NPS
      </button>
    )}
    <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-feedback-open="surface">
      Полезность страницы
    </button>
    <button class="ke-button ke-button--primary" type="button" data-ke-button-compat="runtime-hook" data-feedback-open="improvement">
      Предложить улучшение
    </button>
    {showEventIssue && (
      <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-feedback-open="event_issue">
        Ошибка в событии
      </button>
    )}
  </div>

  <p class="focus-feedback__boundary">
    Здесь ответы только демонстрируют интерфейс и остаются в текущей вкладке:
    отправки и записи в базу нет. В production элементы доступны лишь после
    серверной проверки активного участника.
  </p>

  <dialog data-app-lower-surface="form" data-app-lower-lifecycle="persistent" class="focus-feedback__dialog" data-feedback-dialog aria-labelledby={`${idPrefix}-dialog-title`}>
    <div class="focus-feedback__sheet">
      <header class="focus-feedback__header">
        <div>
          <p class="focus-feedback__eyebrow">Исследовательский вопрос</p>
          <h2 id={`${idPrefix}-dialog-title`}>Что вы хотите оценить?</h2>
        </div>
        <button class="focus-feedback__close" type="button" data-feedback-close aria-label="Закрыть обратную связь">
          <SemanticIcon name="close" role="control" />
        </button>
      </header>

      <div class="focus-feedback__switcher" aria-label="Выберите вид ответа">
        <button type="button" aria-pressed="false" data-feedback-kind="overall">Общий NPS</button>
        <button type="button" aria-pressed="false" data-feedback-kind="surface">Полезность</button>
        <button type="button" aria-pressed="false" data-feedback-kind="improvement">Улучшение</button>
        {showEventIssue && (
          <button type="button" aria-pressed="false" data-feedback-kind="event_issue">Ошибка события</button>
        )}
      </div>

      <form class="focus-feedback__panel" data-feedback-panel="overall" data-feedback-form hidden>
        <fieldset>
          <legend>
            Насколько вероятно, что вы порекомендуете «Полюбить Калининград · Анонсы» знакомым?
          </legend>
          <p class="focus-feedback__hint">Общий relationship NPS · раз в неделю или при выходе</p>
          <div class="focus-feedback__scale">
            {Array.from({ length: 11 }, (_, score) => (
              <label>
                <input type="radio" name={`${idPrefix}-overall-score`} value={score} required />
                <span>{score}</span>
              </label>
            ))}
          </div>
          <div class="focus-feedback__ends" aria-hidden="true"><span>Совсем не вероятно</span><span>Очень вероятно</span></div>
        </fieldset>
        <Button variant="primary" type="submit">Отметить в макете</Button>
      </form>

      <form class="focus-feedback__panel" data-feedback-panel="surface" data-feedback-form hidden>
        <fieldset>
          <legend>Насколько {pageLabel} помогла выбрать или понять событие?</legend>
          <p class="focus-feedback__hint">
            Полезность page family <code>{pageFamily}</code> · это не общий NPS
          </p>
          <div class="focus-feedback__scale">
            {Array.from({ length: 11 }, (_, score) => (
              <label>
                <input type="radio" name={`${idPrefix}-surface-score`} value={score} required />
                <span>{score}</span>
              </label>
            ))}
          </div>
          <div class="focus-feedback__ends" aria-hidden="true"><span>Не помогла</span><span>Очень помогла</span></div>
        </fieldset>
        <Button variant="primary" type="submit">Отметить в макете</Button>
      </form>

      <form class="focus-feedback__panel" data-feedback-panel="improvement" data-feedback-form hidden>
        <label class="focus-feedback__textarea">
          <strong>Что стоит сделать понятнее или удобнее?</strong>
          <span>До 2 000 символов. Оценка не обязательна.</span>
          <textarea
            name={`${idPrefix}-improvement`}
            rows="7"
            maxlength="2000"
            required
            data-feedback-text
          ></textarea>
        </label>
        <div class="focus-feedback__form-footer">
          <span data-feedback-count aria-live="polite">0 / 2 000</span>
          <Button variant="primary" type="submit">Отметить в макете</Button>
        </div>
      </form>

      {showEventIssue && (
        <form class="focus-feedback__panel" data-feedback-panel="event_issue" data-feedback-form hidden>
          <fieldset>
            <legend>Что неверно в событии?</legend>
            <p class="focus-feedback__hint">
              {eventLabel}{eventId ? ` · event_id ${eventId}` : ' · без реального event_id в этом specimen'}
            </p>
            <div class="focus-feedback__issue-types">
              {[
                ['date', 'Дата'],
                ['time', 'Время'],
                ['place', 'Место'],
                ['price', 'Цена'],
                ['ticket', 'Билеты'],
                ['status', 'Статус'],
                ['media', 'Фото / видео'],
                ['duplicate', 'Дубликат'],
                ['other', 'Другое'],
              ].map(([value, label]) => (
                <label>
                  <input type="radio" name={`${idPrefix}-event-issue-type`} value={value} required />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class="focus-feedback__textarea">
            <strong>Что именно нужно проверить? <small>(необязательно)</small></strong>
            <span>До 2 000 символов. Не добавляйте личные данные.</span>
            <textarea
              name={`${idPrefix}-event-issue-body`}
              rows="5"
              maxlength="2000"
              data-feedback-text
            ></textarea>
          </label>
          <div class="focus-feedback__fact-boundary">
            <strong>Сообщение не меняет событие автоматически.</strong>
            Оператор сверяет категорию с каноническим event ID и серверным
            снимком, затем отдельно принимает решение об исправлении.
          </div>
          <div class="focus-feedback__form-footer">
            <span data-feedback-count aria-live="polite">0 / 2 000</span>
            <Button variant="primary" type="submit">Отметить в макете</Button>
          </div>
        </form>
      )}

      <p class="focus-feedback__status" data-feedback-status aria-live="polite"></p>
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-focus-feedback]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-feedback-dialog]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-feedback-close]');
    const kindButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feedback-kind]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-feedback-panel]'));
    const launchers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-feedback-open]'));
    const status = root.querySelector<HTMLElement>('[data-feedback-status]');
    if (!dialog || !closeButton || !status) return;

    let lastLauncher: HTMLButtonElement | null = null;

    const selectKind = (kind: string) => {
      kindButtons.forEach((button) => {
        button.setAttribute('aria-pressed', button.dataset.feedbackKind === kind ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.feedbackPanel !== kind;
      });
      status.textContent = '';
      root.dataset.dsState = `dialog-${kind.replaceAll('_', '-')}`;
    };

    launchers.forEach((button) => {
      button.addEventListener('click', () => {
        lastLauncher = button;
        selectKind(button.dataset.feedbackOpen || root.dataset.defaultKind || 'surface');
        dialog.showModal();
        kindButtons.find((candidate) => candidate.getAttribute('aria-pressed') === 'true')?.focus();
      });
    });

    kindButtons.forEach((button) => {
      button.addEventListener('click', () => selectKind(button.dataset.feedbackKind || 'surface'));
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      root.dataset.dsState = 'idle';
      lastLauncher?.focus();
    });

    root.querySelectorAll<HTMLFormElement>('[data-feedback-form]').forEach((form) => {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        root.dataset.dsState = 'recorded-local';
        status.textContent = 'Ответ отмечен только в макете этой вкладки и никуда не отправлен.';
      });
    });

    root.querySelectorAll<HTMLTextAreaElement>('[data-feedback-text]').forEach((textarea) => {
      const form = textarea.closest('form');
      const counter = form?.querySelector<HTMLElement>('[data-feedback-count]');
      if (!counter) return;
      textarea.addEventListener('input', () => {
        counter.textContent = `${textarea.value.length.toLocaleString('ru-RU')} / 2 000`;
      });
    });
  });
</script>

<style>
  .focus-feedback {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    align-items: center;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-default);
    border-radius: var(--ke-focus-panel-radius);
    padding: var(--ke-space-focus-panel-padding);
    background: var(--ke-color-focus-panel-surface);
    box-shadow: var(--ke-elevation-focus-panel);
  }

  .focus-feedback__eyebrow {
    margin: 0 0 .35rem;
    color: var(--ke-color-action-accent-strong);
    font: var(--ke-type-eyebrow);
    letter-spacing: var(--ke-type-eyebrow-letter);
    text-transform: uppercase;
  }

  .focus-feedback h2 { margin: 0; font: var(--ke-type-focus-heading); }
  .focus-feedback h2 + p { max-width: 65ch; margin: .7rem 0 0; color: var(--ke-color-text-muted); line-height: 1.55; }
  .focus-feedback__launchers { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--ke-space-focus-control-gap); }
  .focus-feedback__boundary {
    grid-column: 1 / -1;
    margin: .1rem 0 0;
    border-radius: var(--ke-focus-boundary-radius);
    padding: var(--ke-space-focus-boundary-block) var(--ke-space-focus-boundary-inline);
    background: var(--ke-color-status-info-background);
    color: var(--ke-color-status-info-foreground);
    font-size: .8rem;
    line-height: 1.45;
  }

  .focus-feedback__dialog {
    width: min(var(--ke-focus-dialog-max), calc(100% - 1rem));
    max-height: var(--ke-focus-dialog-max-height);
    border: 0;
    border-radius: var(--ke-focus-dialog-radius);
    padding: 0;
    background: transparent;
    color: var(--ke-color-text-secondary);
    box-shadow: var(--ke-elevation-overlay);
  }

  .focus-feedback__dialog::backdrop { background: var(--ke-color-focus-dialog-backdrop); backdrop-filter: blur(var(--ke-focus-dialog-backdrop-blur)); }
  .focus-feedback__sheet { overflow: auto; max-height: inherit; padding: var(--ke-space-focus-dialog-padding); background: var(--ke-color-focus-sheet-surface); }
  .focus-feedback__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .focus-feedback__header h2 { font: var(--ke-type-focus-dialog-heading); }
  .focus-feedback__close {
    width: var(--ke-focus-control-min);
    height: var(--ke-focus-control-min);
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-default);
    border-radius: 50%;
    background: var(--ke-color-focus-control-surface);
    color: var(--ke-color-text-primary);
    cursor: pointer;
  }

  .focus-feedback__close:focus-visible,
  .focus-feedback__switcher button:focus-visible,
  .focus-feedback__scale label:has(input:focus-visible) {
    outline: 3px solid var(--ke-color-focus-ring-accent);
    outline-offset: 2px;
  }

  .focus-feedback__switcher {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(125px, 1fr));
    gap: .35rem;
    margin: 1.2rem 0;
    border-radius: 1rem;
    padding: .35rem;
    background: var(--ke-color-background-subtle);
  }

  .focus-feedback__switcher button {
    min-height: var(--ke-focus-control-min);
    border: 0;
    border-radius: var(--ke-focus-control-radius);
    padding: .6rem .7rem;
    background: transparent;
    color: var(--ke-color-text-secondary);
    font: 800 .82rem/1.2 var(--ke-font-family-sans);
    cursor: pointer;
  }

  .focus-feedback__switcher button[aria-pressed="true"] {
    background: var(--ke-color-focus-control-surface);
    color: var(--ke-color-action-primary-strong);
    box-shadow: var(--ke-elevation-focus-selected);
  }

  .focus-feedback__panel { display: grid; gap: 1rem; }
  .focus-feedback__panel[hidden] { display: none; }
  .focus-feedback__panel fieldset { min-width: 0; margin: 0; border: 0; padding: 0; }
  .focus-feedback__panel legend { max-width: 46ch; padding: 0; color: var(--ke-color-text-primary); font-size: clamp(1.05rem, 3vw, 1.35rem); font-weight: 850; line-height: 1.35; }
  .focus-feedback__hint { margin: .5rem 0 0; color: var(--ke-color-text-muted); font-size: .8rem; line-height: 1.4; }
  .focus-feedback__hint code { overflow-wrap: anywhere; }
  .focus-feedback__scale { display: grid; grid-template-columns: repeat(11, minmax(42px, 1fr)); gap: .35rem; margin-top: 1rem; }
  .focus-feedback__scale label { position: relative; min-width: 0; cursor: pointer; }
  .focus-feedback__scale input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .focus-feedback__scale span {
    min-height: var(--ke-focus-control-min);
    display: grid;
    place-items: center;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-default);
    border-radius: var(--ke-focus-control-radius);
    background: var(--ke-color-focus-control-surface);
    color: var(--ke-color-text-secondary);
    font-size: .88rem;
    font-weight: 850;
  }
  .focus-feedback__scale input:checked + span { border-color: var(--ke-color-action-accent); background: var(--ke-color-focus-control-selected-accent); color: var(--ke-color-action-accent-strong); box-shadow: inset 0 0 0 1px var(--ke-color-action-accent); }
  .focus-feedback__issue-types { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; margin-top: 1rem; }
  .focus-feedback__issue-types label { position: relative; min-width: 0; cursor: pointer; }
  .focus-feedback__issue-types input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .focus-feedback__issue-types span {
    min-height: var(--ke-focus-control-min);
    display: grid;
    place-items: center;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-default);
    border-radius: var(--ke-focus-control-radius);
    padding: .5rem;
    background: var(--ke-color-focus-control-surface);
    color: var(--ke-color-text-secondary);
    font-size: .82rem;
    font-weight: 800;
    text-align: center;
  }
  .focus-feedback__issue-types label:has(input:focus-visible) { outline: 3px solid var(--ke-color-focus-ring-accent); outline-offset: 2px; border-radius: var(--ke-focus-control-radius); }
  .focus-feedback__issue-types input:checked + span { border-color: var(--ke-color-action-primary); background: var(--ke-color-focus-control-selected-brand); color: var(--ke-color-action-primary-ink); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ke-color-action-primary) 20%, transparent); }
  .focus-feedback__ends { display: flex; justify-content: space-between; gap: 1rem; margin-top: .4rem; color: var(--ke-color-text-muted); font-size: .7rem; }
  .focus-feedback__panel > .ke-button { justify-self: end; }
  .focus-feedback__textarea { display: grid; gap: .45rem; }
  .focus-feedback__textarea strong { color: var(--ke-color-text-primary); font-size: 1.05rem; }
  .focus-feedback__textarea strong small { color: var(--ke-color-text-muted); font-size: .78rem; font-weight: 650; }
  .focus-feedback__textarea > span { color: var(--ke-color-text-muted); font-size: .8rem; }
  .focus-feedback__textarea textarea {
    width: 100%;
    min-height: 150px;
    resize: vertical;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-input);
    border-radius: var(--ke-focus-input-radius);
    padding: .85rem;
    background: var(--ke-color-focus-control-surface);
    color: var(--ke-color-text-primary);
    font: 1rem/1.5 var(--ke-font-family-sans);
  }
  .focus-feedback__textarea textarea:focus-visible { outline: 3px solid var(--ke-color-focus-ring-accent-subtle); border-color: var(--ke-color-focus-ring); }
  .focus-feedback__form-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .focus-feedback__form-footer > span { color: var(--ke-color-text-muted); font-size: .8rem; font-variant-numeric: tabular-nums; }
  .focus-feedback__fact-boundary {
    border-radius: var(--ke-focus-boundary-radius);
    padding: .8rem var(--ke-space-focus-boundary-inline);
    background: var(--ke-color-status-warning-background);
    color: var(--ke-color-status-warning-foreground);
    font-size: .82rem;
    line-height: 1.45;
  }
  .focus-feedback__status { min-height: 1.5em; margin: .9rem 0 0; color: var(--ke-color-status-success-foreground); font-size: .85rem; font-weight: 750; line-height: 1.4; }

  @media (max-width: 800px) {
    .focus-feedback { grid-template-columns: 1fr; }
    .focus-feedback__launchers { justify-content: flex-start; }
  }

  @media (max-width: 640px) {
    .focus-feedback__launchers .ke-button { width: 100%; }
    .focus-feedback__dialog { width: 100%; max-height: 92dvh; margin: auto 0 0; border-radius: var(--ke-focus-panel-radius-compact) var(--ke-focus-panel-radius-compact) 0 0; }
    .focus-feedback__switcher { grid-template-columns: 1fr; }
    .focus-feedback__scale { grid-template-columns: repeat(6, minmax(42px, 1fr)); }
    .focus-feedback__issue-types { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .focus-feedback__form-footer { align-items: stretch; flex-direction: column; }
    .focus-feedback__form-footer .ke-button,
    .focus-feedback__panel > .ke-button { width: 100%; justify-self: stretch; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .focus-feedback__dialog[open] { animation: focus-feedback-in var(--ke-focus-entry-duration) var(--ke-focus-entry-ease); }
    @keyframes focus-feedback-in {
      from { opacity: 0; transform: translateY(var(--ke-focus-entry-offset)) scale(var(--ke-focus-entry-scale)); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
