---
import type { EventImageAsset } from '../lib/types';
import { eventImageUrl } from '../lib/assets';

interface Props {
  assets: EventImageAsset[];
  galleryId: string;
  eventTitle: string;
  maxVisible?: number;
}

const { assets, galleryId, eventTitle, maxVisible = 6 } = Astro.props;
const visibleLimit = Math.max(2, maxVisible);
const visibleAssets = assets.slice(0, visibleLimit);
const hiddenCount = Math.max(0, assets.length - visibleAssets.length);

const thumbnail = (asset: EventImageAsset) => {
  const derivatives = [...(asset.thumbnail_sources || [])].sort((left, right) => left.width - right.width);
  return derivatives[0]?.src || eventImageUrl(asset.src) || asset.src;
};
const srcset = (asset: EventImageAsset) => (asset.thumbnail_sources || [])
  .slice()
  .sort((left, right) => left.width - right.width)
  .map((item) => `${item.src} ${item.width}w`)
  .join(', ');
const mediaFrameKind = (asset: EventImageAsset) => {
  if (['error', 'stale', 'pending'].includes(asset.media_semantic_status || '')) return 'unknown';
  if (asset.image_text_mode === 'visual_only') return 'visual';
  if (asset.image_text_mode === 'ocr_text') return 'document';
  return 'unknown';
};
const mediaFrameFit = (asset: EventImageAsset) => mediaFrameKind(asset) === 'visual' ? 'cover' : 'contain';
const mediaFrameCropReason = (asset: EventImageAsset) => {
  if (mediaFrameKind(asset) === 'visual') return 'gallery_visual_only_cover';
  if (asset.media_semantic_status && asset.media_semantic_status !== 'classified') return 'semantic_status_fail_closed';
  if (asset.image_text_mode === 'ocr_text') return 'gallery_document_contain';
  return 'gallery_unknown_contain';
};
const mediaFrameRatio = (asset: EventImageAsset) => asset.width > 0 && asset.height > 0
  ? asset.width / asset.height
  : undefined;
---

{assets.length > 1 && (
  <nav class="event-media-rail" data-event-media-rail aria-label={`Фотографии события «${eventTitle}»`} style={`--rail-count:${visibleAssets.length + (hiddenCount > 0 ? 1 : 0)}`}>
    {visibleAssets.map((asset, index) => (
      <button
        type="button"
        class="event-media-rail__item"
        data-media-frame
        data-media-frame-contract="v1"
        data-media-frame-surface="media-rail"
        data-media-frame-kind={mediaFrameKind(asset)}
        data-media-frame-fit={mediaFrameFit(asset)}
        data-media-frame-crop-reason={mediaFrameCropReason(asset)}
        data-media-frame-source-width={asset.width || undefined}
        data-media-frame-source-height={asset.height || undefined}
        data-media-frame-loading="eager"
        data-hero-gallery-open={galleryId}
        data-hero-gallery-index={index}
        style={mediaFrameRatio(asset) ? `--media-frame-source-ratio:${mediaFrameRatio(asset)}` : undefined}
        aria-label={`Открыть изображение ${index + 1} события «${eventTitle}»`}
      >
        <img
          src={thumbnail(asset)}
          srcset={srcset(asset) || undefined}
          sizes="(min-width: 1024px) 92px, 1px"
          width={asset.thumbnail_sources?.[0]?.width || asset.width}
          height={asset.thumbnail_sources?.[0]?.height || asset.height}
          alt=""
          loading="eager"
          decoding="async"
          style={`object-fit:${mediaFrameFit(asset)}`}
          data-media-frame-image
        />
      </button>
    ))}
    {hiddenCount > 0 && (
      <button
        type="button"
        class="event-media-rail__more"
        data-hero-gallery-open={galleryId}
        data-hero-gallery-index={visibleAssets.length}
        aria-label={`Открыть ещё ${hiddenCount} фото события «${eventTitle}»`}
      >
        <strong>+{hiddenCount}</strong><span>фото</span>
      </button>
    )}
  </nav>
)}
