---
import type { EventImageAsset, EventImageMediaRole } from '../lib/types';
import { eventImageUrl } from '../lib/assets';
import './media-frame.css';

export type EventMediaRailVariant = 'gallery-thumbnails' | 'hero-selector' | 'poster-strip';
export type EventMediaRailFrameKind = 'visual' | 'document' | 'unknown' | 'fallback';
export type EventMediaRailFrameFit = 'cover' | 'contain';
export type EventMediaRailAspect = 'portrait' | 'square' | 'landscape';

export interface EventMediaRailItem {
  src: string;
  thumbnailSrc: string;
  thumbnailSrcset?: string;
  thumbnailWidth?: number;
  thumbnailHeight?: number;
  width?: number;
  height?: number;
  alt?: string;
  galleryIndex: number;
  sourceIndex?: number;
  imageTextMode: EventImageAsset['image_text_mode'];
  mediaRole: EventImageMediaRole;
  kind: EventMediaRailFrameKind;
  fit: EventMediaRailFrameFit;
  objectPosition?: string;
  cropReason: string;
  roleLabel?: string;
  actionLabel: string;
  rotationEligible?: boolean;
  railAspect?: EventMediaRailAspect;
  railRatio?: number;
  slotWidth?: number;
}

interface Props {
  variant?: EventMediaRailVariant;
  assets?: EventImageAsset[];
  items?: EventMediaRailItem[];
  galleryId: string;
  eventTitle: string;
  maxVisible?: number;
  className?: string;
  ariaLabel?: string;
  splitPortraitViewer?: boolean;
}

interface NormalizedRailItem extends EventMediaRailItem {
  asset?: EventImageAsset;
  thumbnailWidth?: number;
  thumbnailHeight?: number;
  width?: number;
  height?: number;
  galleryIndex: number;
  sourceIndex?: number;
  objectPosition: string;
  railRatio?: number;
  slotWidth?: number;
}

const {
  variant = 'gallery-thumbnails',
  assets = [],
  items = [],
  galleryId,
  eventTitle,
  maxVisible = 6,
  className = '',
  ariaLabel,
  splitPortraitViewer = false,
} = Astro.props;

const finitePositive = (value: number | null | undefined) => (
  Number.isFinite(Number(value)) && Number(value) > 0 ? Number(value) : undefined
);
const finiteIndex = (value: number | null | undefined, fallback: number) => (
  Number.isFinite(Number(value)) && Number(value) >= 0 ? Math.floor(Number(value)) : fallback
);
const normalizedMediaUrl = (value: string | null | undefined) => {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (/^(?:data|blob):/iu.test(raw)) return raw;
  return eventImageUrl(raw) || raw;
};
const normalizedSrcset = (value: string | null | undefined) => {
  const raw = String(value || '').trim();
  if (!raw) return undefined;
  // A data URL contains its own comma and is already self-contained. Ordinary
  // rail derivatives are width/DPR candidates and are normalized one by one.
  if (/^(?:data|blob):/iu.test(raw)) return raw;
  const candidates = raw.split(',').map((candidate) => {
    const match = /^(\S+)(?:\s+(\d+(?:\.\d+)?[wx]))?$/iu.exec(candidate.trim());
    if (!match) return '';
    const src = normalizedMediaUrl(match[1]);
    return src ? [src, match[2]].filter(Boolean).join(' ') : '';
  }).filter(Boolean);
  return candidates.length ? candidates.join(', ') : undefined;
};
const normalizedThumbnailSources = (asset: EventImageAsset) => (asset.thumbnail_sources || [])
  .map((item) => ({
    src: normalizedMediaUrl(item.src),
    width: finitePositive(item.width),
    height: finitePositive(item.height),
  }))
  .filter((item): item is { src: string; width: number; height: number } => Boolean(item.src && item.width && item.height))
  .sort((left, right) => left.width - right.width);
const normalizedObjectPosition = (value: string | null | undefined) => {
  const raw = String(value || '').trim();
  return /^[a-z0-9.%\s-]+$/iu.test(raw) ? raw : '50% 50%';
};
const normalizedImageTextMode = (value: EventImageAsset['image_text_mode'] | null | undefined): EventImageAsset['image_text_mode'] => (
  value === 'visual_only' || value === 'ocr_text' ? value : 'unknown'
);
const thumbnail = (asset: EventImageAsset) => (
  normalizedThumbnailSources(asset)[0]?.src || normalizedMediaUrl(asset.src)
);
const srcset = (asset: EventImageAsset) => normalizedThumbnailSources(asset)
  .map((item) => `${item.src} ${item.width}w`)
  .join(', ');
const mediaFrameKind = (asset: EventImageAsset): EventMediaRailFrameKind => {
  if (asset.media_semantic_status === 'error') return 'unknown';
  if (asset.image_text_mode === 'visual_only') return 'visual';
  if (asset.image_text_mode === 'ocr_text') return 'document';
  return 'unknown';
};
const mediaFrameFit = (asset: EventImageAsset): EventMediaRailFrameFit => (
  mediaFrameKind(asset) === 'visual' ? 'cover' : 'contain'
);
const mediaFrameCropPermission = (fit: EventMediaRailFrameFit) => fit === 'cover' ? 'allowed' : 'forbidden';
const mediaFrameCropReason = (asset: EventImageAsset) => {
  if (mediaFrameKind(asset) === 'visual') return 'gallery_visual_only_cover';
  if (asset.media_semantic_status && asset.media_semantic_status !== 'classified') return 'semantic_status_fail_closed';
  if (asset.image_text_mode === 'ocr_text') return 'gallery_document_contain';
  return 'gallery_unknown_contain';
};
const mediaFrameSourceRatio = (width: number | null | undefined, height: number | null | undefined) => (
  finitePositive(width) && finitePositive(height) ? Number(width) / Number(height) : undefined
);
const normalizedResolvedItem = (item: EventMediaRailItem, index: number): NormalizedRailItem => {
  const requestedKind: EventMediaRailFrameKind = item.kind === 'visual'
    || item.kind === 'document'
    || item.kind === 'fallback'
    || item.kind === 'unknown'
    ? item.kind
    : 'unknown';
  const imageTextMode = normalizedImageTextMode(item.imageTextMode);
  const contradictoryVisualKind = requestedKind === 'visual' && imageTextMode !== 'visual_only';
  const kind: EventMediaRailFrameKind = contradictoryVisualKind
    ? imageTextMode === 'ocr_text' ? 'document' : 'unknown'
    : requestedKind;
  const requestedCover = item.fit === 'cover';
  const fit: EventMediaRailFrameFit = requestedCover && kind === 'visual' && imageTextMode === 'visual_only'
    ? 'cover'
    : 'contain';
  const width = finitePositive(item.width);
  const height = finitePositive(item.height);
  const sourceRatio = mediaFrameSourceRatio(width, height);
  const railRatio = finitePositive(item.railRatio) || sourceRatio;
  const src = normalizedMediaUrl(item.src);
  const thumbnailSrc = normalizedMediaUrl(item.thumbnailSrc) || src;
  const failClosedCropReason = contradictoryVisualKind
    ? 'resolved_visual_kind_mismatch_fail_closed'
    : requestedCover && fit !== 'cover'
      ? 'resolved_cover_request_fail_closed'
      : null;
  return {
    ...item,
    src,
    thumbnailSrc,
    thumbnailSrcset: normalizedSrcset(item.thumbnailSrcset),
    imageTextMode,
    mediaRole: item.mediaRole || 'unknown_document',
    kind,
    fit,
    width,
    height,
    thumbnailWidth: finitePositive(item.thumbnailWidth),
    thumbnailHeight: finitePositive(item.thumbnailHeight),
    galleryIndex: finiteIndex(item.galleryIndex, index),
    sourceIndex: item.sourceIndex === undefined ? undefined : finiteIndex(item.sourceIndex, index),
    objectPosition: normalizedObjectPosition(item.objectPosition),
    cropReason: failClosedCropReason || String(item.cropReason || 'resolved_media_fail_closed'),
    actionLabel: String(item.actionLabel || `Открыть изображение ${index + 1} события «${eventTitle}»`),
    railRatio,
    slotWidth: finitePositive(item.slotWidth),
  };
};
const normalizedGalleryItem = (asset: EventImageAsset, index: number): NormalizedRailItem => {
  const derivatives = normalizedThumbnailSources(asset);
  const width = finitePositive(asset.width);
  const height = finitePositive(asset.height);
  return {
    asset,
    src: normalizedMediaUrl(asset.src),
    thumbnailSrc: thumbnail(asset),
    thumbnailSrcset: srcset(asset) || undefined,
    thumbnailWidth: finitePositive(derivatives[0]?.width) || width,
    thumbnailHeight: finitePositive(derivatives[0]?.height) || height,
    width,
    height,
    alt: asset.alt || '',
    galleryIndex: index,
    imageTextMode: normalizedImageTextMode(asset.image_text_mode),
    mediaRole: asset.media_role || 'unknown_document',
    kind: mediaFrameKind(asset),
    fit: mediaFrameFit(asset),
    objectPosition: '50% 50%',
    cropReason: mediaFrameCropReason(asset),
    actionLabel: `Открыть изображение ${index + 1} события «${eventTitle}»`,
    rotationEligible: false,
    railRatio: mediaFrameSourceRatio(width, height),
  };
};

const normalizedCandidates = variant === 'gallery-thumbnails'
  ? assets.map(normalizedGalleryItem)
  : items.map(normalizedResolvedItem);
const normalizedItems = normalizedCandidates.filter((item) => Boolean(item.src && item.thumbnailSrc));
const rejectedCount = normalizedCandidates.length - normalizedItems.length;
const numericMaxVisible = Number(maxVisible);
const visibleLimit = Math.max(2, Math.floor(Number.isFinite(numericMaxVisible) ? numericMaxVisible : 6));
const visibleItems = variant === 'gallery-thumbnails'
  ? normalizedItems.slice(0, visibleLimit)
  : normalizedItems;
const hiddenCount = variant === 'gallery-thumbnails'
  ? Math.max(0, normalizedItems.length - visibleItems.length)
  : 0;
const shouldRender = variant === 'gallery-thumbnails'
  ? normalizedItems.length > 1
  : normalizedItems.length > 0;
const usesResolvedItems = variant !== 'gallery-thumbnails';
const rootState = usesResolvedItems
  ? 'responsive-pending'
  : hiddenCount > 0 ? 'overflow' : 'complete';
const resolvedAriaLabel = ariaLabel || (
  variant === 'hero-selector'
    ? 'Выбрать изображение'
    : variant === 'poster-strip'
      ? 'Другие изображения события'
      : `Фотографии события «${eventTitle}»`
);
const rootClass = [
  'event-media-rail',
  `event-media-rail--${variant}`,
  usesResolvedItems && 'desktop-prototype__media-rail',
  variant === 'hero-selector' && 'desktop-prototype__media-rail--hero',
  variant === 'poster-strip' && 'desktop-prototype__media-rail--poster',
  className,
].filter(Boolean).join(' ');
const transparentRailPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
const mediaFrameImageLoadHandler = `const frame=this.closest('[data-media-frame][data-media-frame-contract="v1"]');if(!frame||this.dataset.mediaFrameFailed==='true'||frame.dataset.mediaFrameKind==='fallback')return;if(this.hasAttribute('data-rail-thumbnail')&&this.dataset.railThumbnailActivated!=='true')return;frame.dataset.mediaFrameResourceState='loaded';`;
const mediaFrameImageErrorHandler = `const frame=this.closest('[data-media-frame][data-media-frame-contract="v1"]');if(!frame)return;this.dataset.mediaFrameFailed='true';for(const attribute of ['srcset','sizes','src'])this.removeAttribute(attribute);this.removeAttribute('data-thumbnail-src');this.removeAttribute('data-thumbnail-srcset');frame.dataset.mediaFrameResourceState='broken';frame.dataset.mediaFrameKind='fallback';frame.dataset.mediaFrameFit='contain';frame.dataset.mediaFrameCropPermission='forbidden';frame.dataset.mediaFrameCropReason='resource_load_error';frame.dataset.mediaFrameObjectPosition='50% 50%';frame.dataset.mediaFrameFocalPosition='50% 50%';frame.style.setProperty('--media-frame-object-position','50% 50%');frame.setAttribute('data-media-frame-fallback','');`;
const rootStyle = variant === 'gallery-thumbnails'
  ? `--rail-count:${visibleItems.length + (hiddenCount > 0 ? 1 : 0)}`
  : undefined;
---

{shouldRender && (
  <nav
    class={rootClass}
    data-event-media-rail
    data-event-media-rail-contract={usesResolvedItems ? 'resolved-items-v1' : 'asset-input-v1'}
    data-event-media-rail-variant={variant}
    data-ds-component="EventMediaRail"
    data-ds-family="EventMediaRail"
    data-ds-version="1"
    data-ds-variant={variant}
    data-ds-state={rootState}
    data-event-media-rail-input-total={normalizedCandidates.length}
    data-event-media-rail-total={normalizedItems.length}
    data-event-media-rail-rejected={rejectedCount || undefined}
    data-event-media-rail-visible={usesResolvedItems ? 'pending' : visibleItems.length}
    data-event-media-rail-hidden={usesResolvedItems ? 'pending' : hiddenCount}
    data-event-media-rail-source-owner={usesResolvedItems ? 'caller' : 'EventMediaRail'}
    data-event-media-rail-thumbnail-contract={variant === 'gallery-thumbnails' ? '92px' : undefined}
    data-hero-rail={variant === 'hero-selector' ? '' : undefined}
    data-responsive-rail={variant === 'hero-selector' ? '' : undefined}
    data-split-media-rail={variant === 'poster-strip' ? '' : undefined}
    data-responsive-split-rail={variant === 'poster-strip' ? '' : undefined}
    aria-label={resolvedAriaLabel}
    style={rootStyle}
  >
    {visibleItems.map((item, index) => {
      const sourceRatio = mediaFrameSourceRatio(item.width, item.height);
      const asset = item.asset;
      const imageSizes = variant === 'hero-selector'
        ? '(min-width:1024px) 96px, 1px'
        : variant === 'poster-strip'
          ? `(min-width:1024px) ${Math.round(item.slotWidth || 116)}px, 1px`
          : '(min-width: 1024px) 92px, 1px';
      const frameStyle = sourceRatio
        ? `--media-frame-ratio:${sourceRatio};--media-frame-source-ratio:${sourceRatio};--media-frame-object-position:${item.objectPosition}`
        : `--media-frame-object-position:${item.objectPosition}`;
      const itemStyle = variant === 'poster-strip' && item.railRatio
        ? `--rail-ratio:${item.railRatio.toFixed(4)};`
        : undefined;
      const viewerStart = String(item.sourceIndex ?? `gallery-${item.galleryIndex}`);
      const cropPermission = mediaFrameCropPermission(item.fit);
      return (
        <button
          type="button"
          class:list={[
            'event-media-rail__item',
            variant === 'hero-selector' && index === 0 && 'is-current',
          ]}
          aria-pressed={variant === 'hero-selector' ? (index === 0 ? 'true' : 'false') : undefined}
          data-clean-hero-thumb={variant === 'hero-selector' ? '' : undefined}
          data-responsive-rail-item={variant === 'hero-selector' ? '' : undefined}
          data-responsive-split-item={variant === 'poster-strip' ? '' : undefined}
          data-src={variant === 'hero-selector' ? item.src : undefined}
          data-alt={variant === 'hero-selector' ? item.alt || '' : undefined}
          data-width={variant === 'hero-selector' ? item.width : undefined}
          data-height={variant === 'hero-selector' ? item.height : undefined}
          data-position={variant === 'hero-selector' ? item.objectPosition : undefined}
          data-crop-fit={variant === 'hero-selector' ? item.fit : undefined}
          data-crop-reason={variant === 'hero-selector' ? item.cropReason : undefined}
          data-mode={variant === 'hero-selector' ? item.imageTextMode : undefined}
          data-rotation-eligible={variant === 'hero-selector' ? String(item.rotationEligible === true) : undefined}
          data-rail-aspect={variant === 'poster-strip' ? item.railAspect : undefined}
          data-image-text-mode={usesResolvedItems ? item.imageTextMode : undefined}
          data-media-role={usesResolvedItems ? item.mediaRole : undefined}
          data-source-index={usesResolvedItems ? item.sourceIndex : undefined}
          data-efficient-viewer-open={variant === 'poster-strip' && splitPortraitViewer ? '' : undefined}
          data-efficient-viewer-start={variant === 'poster-strip' && splitPortraitViewer ? viewerStart : undefined}
          data-hero-gallery-open={variant === 'poster-strip' && splitPortraitViewer ? undefined : galleryId}
          data-hero-gallery-index={item.galleryIndex}
          style={itemStyle}
          aria-label={item.actionLabel}
        >
          {variant === 'gallery-thumbnails' && asset ? (
            <span
              class="event-media-rail__frame"
              data-media-frame
              data-media-frame-contract="v1"
              data-media-frame-style-owner="media-frame.css"
              data-media-frame-surface="media-rail"
              data-media-frame-role={item.mediaRole}
              data-media-frame-kind={item.kind}
              data-media-frame-fit={item.fit}
              data-media-frame-crop-permission={cropPermission}
              data-media-frame-ratio={sourceRatio?.toFixed(5)}
              data-media-frame-object-position={item.objectPosition}
              data-media-frame-focal-position={item.objectPosition}
              data-media-frame-crop-reason={item.cropReason}
              data-media-frame-clip="frame"
              data-media-frame-radius="surface"
              data-media-frame-fill="true"
              data-media-frame-source-width={item.width}
              data-media-frame-source-height={item.height}
              data-media-frame-source-ratio={sourceRatio?.toFixed(5)}
              data-media-frame-loading="eager"
              data-media-frame-priority="true"
              data-media-frame-interaction-owner="caller"
              data-media-frame-resource-state={item.kind === 'fallback' ? 'fallback' : 'pending'}
              data-media-frame-fallback={item.kind === 'fallback' ? '' : undefined}
              style={frameStyle}
            >
              <span class="event-media-rail__fallback" data-media-frame-fallback aria-hidden="true"></span>
              <img
                src={item.thumbnailSrc}
                srcset={item.thumbnailSrcset}
                sizes={imageSizes}
                width={item.thumbnailWidth || item.width}
                height={item.thumbnailHeight || item.height}
                alt=""
                loading="eager"
                decoding="async"
                data-media-frame-image
                onload={mediaFrameImageLoadHandler}
                onerror={mediaFrameImageErrorHandler}
              />
            </span>
          ) : (
            <picture
              class="event-media-rail__frame"
              data-media-frame
              data-media-frame-contract="v1"
              data-media-frame-style-owner="media-frame.css"
              data-media-frame-surface="media-rail"
              data-media-frame-role={item.mediaRole}
              data-media-frame-kind={item.kind}
              data-media-frame-fit={item.fit}
              data-media-frame-crop-permission={cropPermission}
              data-media-frame-ratio={sourceRatio?.toFixed(5)}
              data-media-frame-object-position={item.objectPosition}
              data-media-frame-focal-position={item.objectPosition}
              data-media-frame-crop-reason={item.cropReason}
              data-media-frame-clip="frame"
              data-media-frame-radius="surface"
              data-media-frame-fill="true"
              data-media-frame-source-width={item.width}
              data-media-frame-source-height={item.height}
              data-media-frame-source-ratio={sourceRatio?.toFixed(5)}
              data-media-frame-loading="lazy"
              data-media-frame-interaction-owner="caller"
              data-media-frame-resource-state={item.kind === 'fallback' ? 'fallback' : 'pending'}
              data-media-frame-fallback={item.kind === 'fallback' ? '' : undefined}
              style={frameStyle}
            >
              <span class="event-media-rail__fallback" data-media-frame-fallback aria-hidden="true"></span>
              <img
                src={transparentRailPixel}
                data-rail-thumbnail
                data-thumbnail-src={item.thumbnailSrc}
                data-thumbnail-srcset={item.thumbnailSrcset}
                sizes={imageSizes}
                width={item.thumbnailWidth || item.width}
                height={item.thumbnailHeight || item.height}
                alt=""
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                data-media-frame-image
                onload={mediaFrameImageLoadHandler}
                onerror={mediaFrameImageErrorHandler}
              />
            </picture>
          )}
          {usesResolvedItems && item.roleLabel && <span class="event-media-rail__role">{item.roleLabel}</span>}
        </button>
      );
    })}

    {variant === 'gallery-thumbnails' && hiddenCount > 0 && (
      <button
        type="button"
        class="event-media-rail__more"
        data-hero-gallery-open={galleryId}
        data-hero-gallery-index={visibleItems.length}
        aria-label={`Открыть ещё ${hiddenCount} фото события «${eventTitle}»`}
      >
        <strong>+{hiddenCount}</strong><span>фото</span>
      </button>
    )}

    {variant === 'hero-selector' && (
      <button
        type="button"
        class="event-media-rail__more desktop-prototype__media-rail-more"
        data-responsive-rail-more
        data-hero-gallery-open={galleryId}
        data-hero-gallery-index="0"
        aria-label="Открыть остальные фотографии"
        hidden
      >
        <strong data-responsive-rail-count></strong><span>фото</span>
      </button>
    )}

    {variant === 'poster-strip' && (
      <button
        type="button"
        class="event-media-rail__more desktop-prototype__media-rail-more"
        data-responsive-split-more
        data-efficient-viewer-open={splitPortraitViewer ? '' : undefined}
        data-hero-gallery-open={splitPortraitViewer ? undefined : galleryId}
        aria-label="Открыть остальные изображения"
        hidden
      >
        <strong data-responsive-split-count></strong><span>фото</span>
      </button>
    )}
  </nav>
)}

<script>
  function bindEventMediaRailDiagnostics(root = document) {
    root.querySelectorAll('[data-event-media-rail-contract="resolved-items-v1"]').forEach((rail) => {
      if (!(rail instanceof HTMLElement) || rail.dataset.eventMediaRailDiagnosticsBound === 'true') return;
      rail.dataset.eventMediaRailDiagnosticsBound = 'true';
      const sync = () => {
        const visible = rail.dataset.railVisibleCount;
        const hidden = rail.dataset.railHiddenCount;
        if (visible !== undefined) rail.dataset.eventMediaRailVisible = visible;
        if (hidden !== undefined) rail.dataset.eventMediaRailHidden = hidden;
        if (hidden !== undefined) rail.dataset.dsState = Number(hidden) > 0 ? 'overflow' : 'complete';
      };
      sync();
      new MutationObserver(sync).observe(rail, {
        attributes:true,
        attributeFilter:['data-rail-visible-count', 'data-rail-hidden-count', 'data-rail-complete'],
      });
    });
  }
  bindEventMediaRailDiagnostics();
</script>

<style>
  .event-media-rail {
    min-width: 0;
  }

  .event-media-rail.event-media-rail--gallery-thumbnails {
    display: grid;
    grid-template-columns: repeat(var(--rail-count, 1), minmax(0, 1fr));
    gap: var(--ke-media-rail-gallery-gap);
    padding: var(--ke-media-rail-gallery-padding);
    border: 1px solid var(--ke-color-media-rail-shell-border);
    border-radius: var(--ke-media-rail-gallery-radius);
    background: var(--ke-color-media-rail-gallery-surface);
    box-shadow: var(--ke-elevation-media-rail-gallery);
  }

  .event-media-rail--gallery-thumbnails > .event-media-rail__item,
  .event-media-rail--gallery-thumbnails > .event-media-rail__more {
    min-width: 0;
    height: var(--ke-media-rail-gallery-item-height);
    padding: 0;
    border: 1px solid var(--ke-color-media-rail-item-border);
    border-radius: var(--ke-media-rail-gallery-item-radius);
    background: var(--ke-color-media-rail-gallery-item-surface);
    color: var(--ke-color-media-rail-inverse-text);
    cursor: zoom-in;
  }

  .event-media-rail--gallery-thumbnails > .event-media-rail__more {
    display: grid;
    place-content: center;
    gap: 0.05rem;
    overflow: hidden;
    background: var(--ke-color-media-rail-more-surface, #fffaf2);
    color: var(--ke-color-media-rail-more-text, #241c17);
  }

  .event-media-rail--gallery-thumbnails > .event-media-rail__more strong {
    font-size: var(--ke-media-rail-more-count-size, 1rem);
    line-height: 1;
  }

  .event-media-rail--gallery-thumbnails > .event-media-rail__more span {
    font-size: var(--ke-media-rail-more-label-size, 0.66rem);
    font-weight: 850;
  }

  .event-media-rail.event-media-rail--hero-selector,
  .event-media-rail.event-media-rail--poster-strip {
    display: flex;
    grid-template-columns: none;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--ke-media-rail-resolved-gap);
    padding: var(--ke-media-rail-resolved-padding);
    overflow: hidden;
    border: 0;
    border-radius: var(--ke-media-rail-resolved-radius);
    background: var(--ke-color-media-rail-resolved-surface);
    box-shadow: none;
  }

  .event-media-rail.event-media-rail--hero-selector {
    justify-content: flex-end;
  }

  .event-media-rail--hero-selector > .event-media-rail__item {
    position: relative;
    flex: 1 1 0;
    width: auto;
    min-width: var(--ke-media-rail-hero-item-min-width);
    max-width: var(--ke-media-rail-hero-item-max-width);
    height: var(--ke-media-rail-hero-item-height);
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--ke-media-rail-resolved-item-radius);
    background: var(--ke-color-media-rail-resolved-item-surface);
    cursor: pointer;
  }

  .event-media-rail--hero-selector > .event-media-rail__item.is-current {
