---
interface Props {
  name: 'heart' | 'calendar' | 'dislike' | 'share';
  className?: string;
  title?: string;
}
const { name, className = '', title } = Astro.props;
const labelled = Boolean(title);
const common = `icon icon--${name}${className ? ` ${className}` : ''}`;
