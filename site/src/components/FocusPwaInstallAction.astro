---
import './design-system/product-contour-foundations.css';
import { withBase } from '../lib/events';

const pwaInstallId = withBase('/fokus-gruppa/pwa');
const pwaOpenHref = withBase('/fokus-gruppa/priglashenie/?launch=pwa');
---

<section
  class="focus-pwa"
  data-ds-family="FocusPwaInstallAction"
  data-ds-version="1"
  data-ds-variant="browser-install"
  data-ds-state="checking"
  data-focus-pwa-install
  data-pwa-install-root
  data-pwa-install-id={pwaInstallId}
  data-pwa-open-href={pwaOpenHref}
  data-pwa-install-ready="false"
  aria-labelledby="focus-pwa-title"
>
  <div class="focus-pwa__copy">
    <p>Приложение «Анонсы»</p>
    <h2 id="focus-pwa-title">Установите приложение «Анонсы»</h2>
    <span>
      Так афиша не потеряется среди вкладок. Приложение почти не занимает места:
      события открываются с сайта.
    </span>
  </div>

  <button
    type="button"
    class="ke-button ke-button--primary ke-button--large focus-pwa__button"
    data-ke-button-compat="runtime-hook-hidden"
    data-pwa-install-button
    hidden
  >
    Установить приложение
  </button>

  <p class="focus-pwa__status" data-pwa-install-status role="status" aria-live="polite">
    Проверяем, предложит ли браузер установку.
  </p>
  <div class="focus-pwa__guidance" data-pwa-install-guidance>
    <strong>Если системная кнопка не появилась</strong>
    <span>
      Android: откройте страницу в обычном Chrome. Кнопка «Установить
      приложение» появится, когда браузер подготовит установку.
    </span>
    <span>
      iPhone/iPad: откройте страницу в Safari, нажмите «Поделиться» и выберите
      «На экран Домой».
    </span>
  </div>
  <p class="focus-pwa__after">
    После установки откройте «Анонсы» с главного экрана и продолжите подключение.
  </p>
</section>

<style>
  .focus-pwa {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .8rem;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-default);
    border-radius: var(--ke-focus-panel-radius);
    padding: var(--ke-space-focus-card-padding);
    background:
      radial-gradient(circle at 100% 0, color-mix(in srgb, var(--ke-color-action-accent) 13%, transparent), transparent 16rem),
      var(--ke-color-focus-panel-surface);
    box-shadow: var(--ke-elevation-focus-pwa);
  }
  .focus-pwa__copy { display: grid; gap: .35rem; }
  .focus-pwa__copy p {
    margin: 0;
    color: var(--ke-color-status-success-foreground);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .focus-pwa__copy h2 {
    margin: 0;
    color: var(--ke-color-text-primary);
    font-size: clamp(1.45rem, 5vw, 2.4rem);
    line-height: 1;
    letter-spacing: -.035em;
  }
  .focus-pwa__copy span,
  .focus-pwa__after {
    color: var(--ke-color-text-muted);
    line-height: 1.5;
  }
  .focus-pwa__button,
  .focus-pwa__status,
  .focus-pwa__guidance,
  .focus-pwa__after {
    grid-column: 1;
  }
  .focus-pwa__button[hidden] { display: none; }
  .focus-pwa__status,
  .focus-pwa__after {
    margin: 0;
    font-size: .84rem;
  }
  .focus-pwa__status { color: var(--ke-color-action-primary-hover); font-weight: 750; }
  .focus-pwa__guidance {
    display: grid;
    gap: .3rem;
    border-radius: 1rem;
    padding: .85rem 1rem;
    background: var(--ke-color-status-info-background);
    color: var(--ke-color-status-info-foreground);
    font-size: .8rem;
    line-height: 1.45;
  }
  .focus-pwa__guidance[hidden] { display: none; }
  @media (max-width: 620px) {
    .focus-pwa {
      grid-template-columns: 1fr;
      border-radius: var(--ke-focus-panel-radius-compact);
    }
    .focus-pwa__button,
    .focus-pwa__status,
    .focus-pwa__guidance,
    .focus-pwa__after { grid-column: 1; }
    .focus-pwa__button { width: 100%; }
  }
</style>

<script>
  import { hydrateFocusPwaInstallActions } from '../lib/focus-pwa-install-controller';
  hydrateFocusPwaInstallActions();
  document.querySelectorAll('[data-focus-pwa-install]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const button = root.querySelector('[data-pwa-install-button]');
    const sync = () => {
      root.dataset.dsState = button instanceof HTMLElement && !button.hidden
        ? 'install-ready'
        : root.dataset.pwaInstallReady === 'true' ? 'resolved' : 'checking';
    };
    new MutationObserver(sync).observe(root, {
      subtree:true,
      attributes:true,
      attributeFilter:['hidden', 'data-pwa-install-ready'],
    });
    sync();
  });
</script>
