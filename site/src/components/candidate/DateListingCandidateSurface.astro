---
import type { PreviewEvent } from '../../lib/types';
import { deduplicateListingEvents, eventCountLabel, groupListingEvents } from '../../lib/listingPresentation';
import { chronologicalListingEvents } from '../../lib/listingChronology';
import { getCurrentDate } from '../../lib/events';
import ListingDiscoveryRail from '../listings/ListingDiscoveryRail.astro';
import ListingPageHeader from '../listings/ListingPageHeader.astro';
import ListingTimeNav from '../listings/ListingTimeNav.astro';
import ExactTimeTimeline from '../listings/ExactTimeTimeline.astro';
import MobileListingRailSurface from '../listings/MobileListingRailSurface.astro';
import ListingPersonalFilter from '../ListingPersonalFilter.astro';
import WeatherDateContext from '../WeatherDateContext.astro';

interface Props {
  kind: 'today' | 'tomorrow' | 'date';
  title: string;
  date: string;
  dateLabel: string;
  events: PreviewEvent[];
  state?: 'ready' | 'loading' | 'empty' | 'error';
  generatedAt?: string | null;
}

const {
  kind,
  title,
  date,
  dateLabel,
  events,
  state = 'ready',
  generatedAt = null,
} = Astro.props;

const readyEvents = chronologicalListingEvents(deduplicateListingEvents(events));
const readyGroups = groupListingEvents(readyEvents);
const cities = [...new Set(readyEvents.map((event) => event.city || 'Калининградская область'))]
  .map((name) => ({ name, count: readyEvents.filter((event) => (event.city || 'Калининградская область') === name).length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name, 'ru'));
const idPrefix = kind === 'tomorrow' ? 'candidate-tomorrow-time' : `candidate-date-${date}-time`;
const mobileDate = new Intl.DateTimeFormat('ru-RU', { day:'numeric', month:'long', timeZone:'Europe/Kaliningrad' })
  .format(new Date(`${date}T12:00:00+02:00`));
const mobileWeekday = new Intl.DateTimeFormat('ru-RU', { weekday:'long', timeZone:'Europe/Kaliningrad' })
  .format(new Date(`${date}T12:00:00+02:00`));
const mobileMeta = `${mobileDate} · ${mobileWeekday} · ${readyEvents.length} ${eventCountLabel(readyEvents.length)}`;
---

<section
  class="date-listing-candidate"
  data-date-listing-candidate-root
  data-date-listing-candidate-state={state}
  aria-busy={state === 'loading' ? 'true' : undefined}
>
  {state === 'ready' ? (
    <div
      class="ke-listing-shell"
      data-date-listing={kind}
      data-listing-date={date}
      data-listing-variant="DATE-LISTING-SOT-CANDIDATE-V1"
      data-listing-density={readyEvents.length > 0 && readyEvents.length <= 4 ? 'sparse' : 'regular'}
      data-listing-has-time-nav="true"
      data-candidate-composition="sot-linked-primitives"
      data-generated-at={generatedAt || undefined}
    >
      <ListingPageHeader title={title} dateLabel={dateLabel} count={readyEvents.length} current={kind} />
      <WeatherDateContext date={date} dateLabel={dateLabel} routeKind={kind} surface="desktop" />
      <ListingDiscoveryRail
        cities={cities}
        total={readyEvents.length}
        label={kind === 'tomorrow' ? 'завтра' : dateLabel}
        dateContext={{ date: mobileDate, weekday: mobileWeekday }}
      >
        <ListingTimeNav groups={readyGroups} idPrefix={idPrefix} earlierCount={0} />
      </ListingDiscoveryRail>

      <MobileListingRailSurface
        sections={[{ id:`candidate-${kind}-chronological`, events:readyEvents }]}
        occurrenceMode="per-date"
        title={title}
        meta={mobileMeta}
        feedTitle="По времени"
        feedMeta="Фото → о событии → лайк"
        current={kind}
        cities={cities}
        calendarToday={getCurrentDate()}
        calendarDate={date}
        weather={{ date, dateLabel, routeKind: kind }}
      />

      <div class="ke-listing-desktop-body" data-listing-representation="desktop">
        <div data-listing-upcoming-groups>
          <ExactTimeTimeline groups={readyGroups} idPrefix={idPrefix} date={date} />
        </div>
        <div class="ke-listing-empty" data-listing-no-events hidden={readyEvents.length > 0}>
          <strong>Событий на эту дату пока нет</strong>
        </div>
      </div>
      <ListingPersonalFilter total={readyEvents.length} label={kind === 'tomorrow' ? 'завтра' : dateLabel} version={2} placement="floating" />
    </div>
  ) : (
    <div class="date-listing-candidate__state" role={state === 'error' ? 'alert' : 'status'}>
      <header>
        <small>{dateLabel}</small>
        <h1>{title}</h1>
      </header>
      {state === 'loading' ? (
        <div class="date-listing-candidate__skeleton" aria-label="Загрузка событий">
          <span></span><span></span><span></span>
        </div>
      ) : state === 'empty' ? (
        <div class="date-listing-candidate__message">
          <strong>Событий на эту дату пока нет</strong>
          <p>Можно выбрать соседний день или открыть календарь.</p>
          <a href="/zavtra/">Выбрать дату</a>
        </div>
      ) : (
        <div class="date-listing-candidate__message date-listing-candidate__message--error">
          <strong>Не удалось загрузить события</strong>
          <p>Сохранённая дата остаётся видимой. Повторите попытку.</p>
          <button type="button" data-date-listing-retry>Повторить</button>
        </div>
      )}
    </div>
  )}
</section>

<style>
  .date-listing-candidate { min-width:0; }
  .date-listing-candidate__state {
    width:min(1180px,calc(100% - 32px)); min-height:420px; margin:28px auto;
    padding:28px; border:1px solid #e1d3c2; border-radius:28px; background:#fffdf8;
    color:#221a14; box-shadow:0 18px 45px rgba(72,45,25,.12);
  }
  .date-listing-candidate__state header small { color:#6d6259; font-weight:720; }
  .date-listing-candidate__state h1 { margin:4px 0 26px; font-size:clamp(2rem,5vw,4rem); line-height:.98; letter-spacing:-.05em; }
  .date-listing-candidate__skeleton { display:grid; gap:16px; }
  .date-listing-candidate__skeleton span {
    display:block; min-height:92px; border-radius:14px;
    background:linear-gradient(105deg,#efe3d3 8%,#fff8ed 20%,#efe3d3 34%); background-size:220% 100%;
    animation:date-listing-candidate-pulse 1.25s ease-in-out infinite;
  }
  .date-listing-candidate__message { max-width:620px; padding:28px; border-radius:20px; background:#f2e7d7; }
  .date-listing-candidate__message--error { background:#fff0ec; }
  .date-listing-candidate__message strong { display:block; font-size:1.25rem; line-height:1.2; }
  .date-listing-candidate__message p { margin:8px 0 18px; color:#6d6259; }
  .date-listing-candidate__message a,
  .date-listing-candidate__message button {
    min-height:48px; display:inline-flex; align-items:center; padding:0 18px; border:0; border-radius:14px;
    background:#793014; color:#fff; font:850 14px/1 Inter,system-ui,sans-serif; text-decoration:none; cursor:pointer;
  }
  .date-listing-candidate__message a:focus-visible,
  .date-listing-candidate__message button:focus-visible { outline:3px solid #98401f; outline-offset:3px; }
  @keyframes date-listing-candidate-pulse { to { background-position-x:-220%; } }
  @media (max-width:720px) {
    .date-listing-candidate__state { width:auto; min-height:350px; margin:12px; padding:20px 14px; border-radius:20px; }
    .date-listing-candidate__state h1 { margin-bottom:20px; font-size:36px; }
    .date-listing-candidate__skeleton span { min-height:112px; }
    .date-listing-candidate__message { padding:20px 16px; border-radius:16px; }
  }
  @media (prefers-reduced-motion:reduce) { .date-listing-candidate__skeleton span { animation:none; } }
</style>
