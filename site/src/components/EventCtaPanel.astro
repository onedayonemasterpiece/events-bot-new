---
import CalendarLink from './CalendarLink.astro';
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { displayDate, eventAbsoluteUrl, eventTicketActionLabel, isCalendarEligible, isExternalHttpUrl, isTelephoneUrl } from '../lib/events';
interface Props { event: PreviewEvent }
const { event } = Astro.props;
const href = event.ticket.href;
const external = isExternalHttpUrl(href);
const telephone = isTelephoneUrl(href);
const absolute = eventAbsoluteUrl(event);
const dateLabel = displayDate(event);
const shareText = [dateLabel, event.display_time, event.venue_name || event.city].filter(Boolean).join(' · ');
const ctaRel = external ? 'noopener noreferrer nofollow' : undefined;
const hasReliableMap = Boolean(event.address && event.map_query);
const ctaLabel = eventTicketActionLabel(event);
const canAddToCalendar = isCalendarEligible(event);
const calendarPrimary = canAddToCalendar && (!href || event.ticket.kind === 'free');
---
<aside class="section-card cta-panel" aria-label="Билеты и действия">
  <div class="cta-panel__top">
    <div>
      <p class="eyebrow">Когда</p>
      <div class="cta-panel__date">{dateLabel}</div>
      {event.display_time && <div class="muted-note">{event.display_time} · {event.timezone}</div>}
    </div>
    <div>
      <p class="eyebrow">Где</p>
      <strong>{event.venue_name || event.city || 'Место уточняется'}</strong>
      {(event.address || event.city) && <div class="muted-note">{[event.address, event.city].filter(Boolean).join(', ')}</div>}
      {hasReliableMap ? (
        <a class="muted-note" href={`https://yandex.ru/maps/?text=${encodeURIComponent(event.map_query || '')}`} rel="noopener noreferrer nofollow" target="_blank">Открыть на карте</a>
      ) : (
        <p class="muted-note">Точный адрес уточняйте у организатора.</p>
      )}
    </div>
    <div>
      <p class="eyebrow">Статус</p>
      <strong>{event.status_label}</strong>
      {event.ticket.note && <p class="muted-note">{event.ticket.note}</p>}
    </div>
    <div class="action-grid">
      {calendarPrimary && <CalendarLink event={event} className="cta-button" label="В календарь" />}
      {href ? (
        <a class={calendarPrimary ? 'secondary-button' : 'cta-button'} href={href} target={external ? '_blank' : undefined} rel={ctaRel}>{ctaLabel}</a>
      ) : (!calendarPrimary ? (
        <span class="cta-button" aria-disabled="true">{ctaLabel}</span>
      ) : null)}
      {!calendarPrimary && canAddToCalendar && <CalendarLink event={event} />}
      <button type="button" class="secondary-button native-share-button" data-native-share data-share-event-id={event.id} data-share-event-title={event.title} data-share-title={event.title} data-share-text={shareText} data-share-url={absolute}><Icon name="share" /> <span data-share-label>Поделиться</span></button>
    </div>
    {telephone && <p class="muted-note">Телефон откроется стандартным звонком на мобильном устройстве.</p>}
    <p class="muted-note">Если системное окно “Поделиться” недоступно в браузере или webview, ссылка копируется в буфер.</p>
  </div>
</aside>
