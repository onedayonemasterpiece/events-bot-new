---
import CalendarLink from './CalendarLink.astro';
import EventOccurrenceLabel from './EventOccurrenceLabel.astro';
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { eventAbsoluteUrl, eventTicketActionLabel, eventAdmissionLabel, eventActionHref, getOccurrencePresentation, isEventDetailCalendarEligible, isExternalHttpUrl, isTelephoneUrl, isTicketSoldOut, withBase } from '../lib/events';
import { eventImageUrl } from '../lib/assets';
interface Props { event: PreviewEvent }
const { event } = Astro.props;
const href = eventActionHref(event);
const external = isExternalHttpUrl(href);
const telephone = isTelephoneUrl(href);
const absolute = eventAbsoluteUrl(event);
const occurrencePresentation = getOccurrencePresentation(event);
const dateLabel = occurrencePresentation.compactLabel;
const admissionLabel = eventAdmissionLabel(event);
const imageUrl = eventImageUrl(event.image_url);
const shareText = [event.title, [dateLabel, event.venue_name || event.city].filter(Boolean).join(' · '), admissionLabel].filter(Boolean).join('\n');
const shareImageType = imageUrl?.toLowerCase().includes('.webp') ? 'image/webp' : imageUrl?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
const ctaRel = external ? 'noopener noreferrer nofollow' : undefined;
const soldOut = isTicketSoldOut(event);
const admissionPriceHref = !soldOut && !event.ticket.is_free && event.ticket.price_label && href && !telephone ? href : null;
const hasReliableMap = Boolean(event.address && event.map_query);
const ctaLabel = eventTicketActionLabel(event);
const canAddToCalendar = isEventDetailCalendarEligible(event);
const calendarPrimary = canAddToCalendar && (!href || event.ticket.kind === 'free');
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count || 0;
---
<aside class="section-card cta-panel" aria-label="Билеты и действия">
  <div class="cta-panel__top">
    <div>
      <p class="eyebrow">Когда</p>
      <div class="cta-panel__date"><EventOccurrenceLabel presentation={occurrencePresentation} /></div>
      {event.timezone && <div class="muted-note">{event.timezone}</div>}
    </div>
    <div>
      <p class="eyebrow">Где</p>
      <strong>{event.venue_name || event.city || 'Место уточняется'}</strong>
      {(event.address || event.city) && <div class="muted-note">{[event.address, event.city].filter(Boolean).join(', ')}</div>}
      {hasReliableMap ? (
        <a class="muted-note" href={`https://yandex.ru/maps/?text=${encodeURIComponent(event.map_query || '')}`} rel="noopener noreferrer nofollow" target="_blank">Открыть на карте</a>
      ) : (
        <p class="muted-note">Точный адрес уточняйте у организатора.</p>
      )}
    </div>
    <div>
      <p class="eyebrow">Вход</p>
      {admissionPriceHref ? (
        <a class="cta-panel__admission-link" href={admissionPriceHref} target={external ? '_blank' : undefined} rel={ctaRel} data-nosnippet>{admissionLabel}</a>
      ) : (
        <strong>{admissionLabel}</strong>
      )}
      {event.ticket.note && <p class="muted-note">{event.ticket.note}</p>}
    </div>
    <div class="action-grid event-cta-panel__primary">
      {calendarPrimary ? (
        <CalendarLink event={event} className="cta-button" label="Добавить в календарь" />
      ) : href ? (
        <a class="cta-button" href={href} target={external ? '_blank' : undefined} rel={ctaRel}>{telephone && <Icon name="phone" />}<span>{ctaLabel}</span></a>
      ) : (
        <span class={soldOut ? 'secondary-button cta-button--disabled' : 'cta-button cta-button--disabled'} aria-disabled="true">{ctaLabel}</span>
      )}
    </div>
    <div class="action-grid event-cta-panel__action-row" data-feedback-scope data-event-cta-action-row="calendar-share-like">
      {!calendarPrimary && <CalendarLink event={event} />}
      <button type="button" class="secondary-button native-share-button" data-nosnippet data-native-share data-share-event-id={event.id} data-share-event-title={event.title} data-share-base-count={sharesCount} data-share-title={event.title} data-share-text={shareText} data-share-url={absolute} data-share-image={imageUrl || ''} data-share-image-type={shareImageType} data-share-image-text-mode={event.image_text_mode || 'unknown'} data-share-brand-image={withBase('/brand/announcements-wordmark-ui.svg')} data-share-file-name={shareFileName} data-share-date-time={dateLabel} data-share-place={event.venue_name || event.city || ''} data-share-admission={admissionLabel} aria-label={`Поделиться: ${event.title}. Сейчас ${sharesCount}`}><Icon name="share" /> <strong data-share-count>{sharesCount}</strong></button>
      <button type="button" class="secondary-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={`Нравится: ${event.title}. Сейчас ${likesCount}`}><Icon name="heart" /> <strong data-feedback-count>{likesCount}</strong></button>
    </div>
    {telephone && <p class="muted-note">Телефон откроется стандартным звонком на мобильном устройстве.</p>}
    <p class="muted-note">Если системное окно “Поделиться” недоступно в браузере или webview, ссылка копируется в буфер.</p>
  </div>
</aside>

<style>
  .event-cta-panel__primary { grid-template-columns:1fr; }
  .event-cta-panel__action-row { grid-template-columns:repeat(3,minmax(0,auto)); justify-content:start; }
  .event-cta-panel__action-row :global(.secondary-button) { min-width:52px; min-height:52px; display:inline-flex; align-items:center; justify-content:center; gap:.3rem; }
  .event-cta-panel__action-row strong { font-variant-numeric:tabular-nums; }
</style>
