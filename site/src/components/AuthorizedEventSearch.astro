---
interface Props {
  compact?: boolean;
  standalone?: boolean;
  headingLevel?: 'h1' | 'h2';
}
const { compact = false, standalone = false, headingLevel = 'h2' } = Astro.props;
const supabaseUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
const supabaseKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
const yandexProvider = import.meta.env.PUBLIC_YANDEX_AUTH_PROVIDER || 'custom:yandex';
const enabled = Boolean(supabaseUrl && supabaseKey);
const HeadingTag = headingLevel;
---
{enabled && (
<section id="poisk" class:list={["authorized-search", compact && "authorized-search--compact", standalone && "authorized-search--standalone"]} data-authorized-search data-search-enabled={enabled ? 'true' : 'false'} data-supabase-url={supabaseUrl || undefined} data-supabase-key={supabaseKey || undefined} data-yandex-provider={yandexProvider} data-nosnippet>
  <div class="authorized-search__head">
    <div class="authorized-search__copy">
      <p class="eyebrow">Умный поиск</p>
      <HeadingTag>Найти событие по описанию</HeadingTag>
      <p class="muted-note">Войдите через Яндекс и напишите обычной фразой, что хочется найти. Результаты появятся лентой: карточки можно лайкать, скрывать как «не интересно», добавлять в календарь и делиться.</p>
    </div>
    <div class="authorized-search__auth">
      <button type="button" class="secondary-button authorized-search__login" data-search-login>
        <span class="authorized-search__yandex-icon" aria-hidden="true">Я</span>
        <span>Войти через Яндекс</span>
      </button>
      <details class="authorized-search__account-menu" data-search-user data-search-account hidden>
        <summary class="authorized-search__account-toggle" data-search-account-toggle aria-label="Профиль пользователя">
          <span class="authorized-search__avatar" data-search-avatar aria-hidden="true">
            <img data-search-avatar-img alt="" hidden />
            <span class="authorized-search__avatar-initial" data-search-avatar-initial hidden></span>
            <svg class="authorized-search__avatar-icon" data-search-avatar-icon viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 12.2c2.5 0 4.5-2 4.5-4.5S14.5 3.2 12 3.2s-4.5 2-4.5 4.5 2 4.5 4.5 4.5Zm0 2.1c-3.7 0-7.2 1.9-8.8 4.8-.4.7.1 1.7 1 1.7h15.6c.9 0 1.4-1 1-1.7-1.6-2.9-5.1-4.8-8.8-4.8Z" fill="currentColor"></path>
            </svg>
          </span>
        </summary>
        <div class="authorized-search__account-popover" data-search-account-popover>
          <div class="authorized-search__account-info">
            <span>Вошли как</span>
            <strong data-search-user-name></strong>
          </div>
          <button type="button" class="authorized-search__logout" data-search-logout>Выйти из аккаунта</button>
        </div>
      </details>
    </div>
  </div>
  {!enabled && <p class="authorized-search__status">Поиск не активирован в этой сборке: нет публичных Supabase env.</p>}
  <form class="authorized-search__form" data-search-form hidden>
    <label class="sr-only" for="authorized-event-search-input">Что хочется найти</label>
    <input id="authorized-event-search-input" type="search" data-search-input placeholder="Например: джаз на выходных" autocomplete="off" />
    <button type="submit" class="cta-button authorized-search__submit" data-search-submit style="--search-progress: 0%;">
      <span class="authorized-search__submit-label" data-search-submit-label>Искать</span>
    </button>
  </form>
  <p class="authorized-search__status" data-search-status aria-live="polite">{enabled ? 'Войдите, чтобы включить поиск.' : ''}</p>
  <div class="authorized-search__results" data-search-results hidden></div>
  <button type="button" class="secondary-button authorized-search__more" data-search-more hidden>Показать ещё</button>
</section>
)}

<script>
  import { createClient } from '@supabase/supabase-js';

  const roots = Array.from(document.querySelectorAll('[data-authorized-search]'));
  for (const root of roots) {
    if (root.dataset.searchBound === 'true') continue;
    root.dataset.searchBound = 'true';
    const enabled = root.dataset.searchEnabled === 'true';
    const status = root.querySelector('[data-search-status]');
    const login = root.querySelector('[data-search-login]');
    const logout = root.querySelector('[data-search-logout]');
    const form = root.querySelector('[data-search-form]');
    const input = root.querySelector('[data-search-input]');
    const submit = root.querySelector('[data-search-submit]');
    const submitLabel = root.querySelector('[data-search-submit-label]');
    const userBadge = root.querySelector('[data-search-user]');
    const userName = root.querySelector('[data-search-user-name]');
    const accountMenu = root.querySelector('[data-search-account]');
    const avatarImg = root.querySelector('[data-search-avatar-img]');
    const avatarInitial = root.querySelector('[data-search-avatar-initial]');
    const avatarIcon = root.querySelector('[data-search-avatar-icon]');
    const results = root.querySelector('[data-search-results]');
    const more = root.querySelector('[data-search-more]');
    let supabase = null;
    let currentQuery = '';
    let offset = 0;
    let loading = false;
    let fallbackStarted = false;
    let feedbackShown = false;
    let lastResultEventIds = [];
    let authCallbackHadError = false;
    let progressValue = 0;
    const searchTimeoutMs = 60000;
    const authSessionTimeoutMs = 8000;
    const authCallbackTimeoutMs = 20000;
    const maxQueryLength = 180;

    const pkceCookiePrefix = 'ke_pkce_';
    const authIntentKey = 'ke_yandex_auth_intent_v1';

    function isPkceCodeVerifierKey(key) {
      return typeof key === 'string' && key.endsWith('-code-verifier');
    }

    function pkceCookieName(key) {
      // Cookie names are deliberately short and path-wide: the OAuth return URL can
      // be any static preview/listing path on kenigevents.ru.
      return `${pkceCookiePrefix}${encodeURIComponent(key).replace(/%/g, '_')}`;
    }

    function setPkceCookie(key, value) {
      if (!isPkceCodeVerifierKey(key)) return;
      try {
        document.cookie = `${pkceCookieName(key)}=${encodeURIComponent(value)}; Max-Age=900; Path=/; SameSite=Lax; Secure`;
      } catch (_error) {
        // Best-effort fallback only. localStorage remains the primary Supabase storage.
      }
    }

    function getPkceCookie(key) {
      if (!isPkceCodeVerifierKey(key)) return null;
      const name = `${pkceCookieName(key)}=`;
      const item = document.cookie.split('; ').find((part) => part.startsWith(name));
      if (!item) return null;
      try {
        return decodeURIComponent(item.slice(name.length));
      } catch (_error) {
        return null;
      }
    }

    function removePkceCookie(key) {
      if (!isPkceCodeVerifierKey(key)) return;
      try {
        document.cookie = `${pkceCookieName(key)}=; Max-Age=0; Path=/; SameSite=Lax; Secure`;
      } catch (_error) {
        // Best-effort cleanup only.
      }
    }

    const authStorage = {
      getItem(key) {
        try {
          const value = window.localStorage.getItem(key);
          if (value != null) return value;
        } catch (_error) {
          // Continue to cookie fallback for the short-lived PKCE verifier.
        }
        return getPkceCookie(key);
      },
      setItem(key, value) {
        try {
          window.localStorage.setItem(key, value);
        } catch (_error) {
          // Supabase will still keep the in-memory session for this page load.
        }
        setPkceCookie(key, value);
      },
      removeItem(key) {
        try {
          window.localStorage.removeItem(key);
        } catch (_error) {
          // Ignore storage cleanup failures.
        }
        removePkceCookie(key);
      },
    };

    function setStatus(message, kind = 'info') {
      if (!status) return;
      status.textContent = message || '';
      if (kind === 'error') status.setAttribute('role', 'alert');
      else status.removeAttribute('role');
    }

    function displayUserName(user) {
      const metadata = user?.user_metadata || {};
      return metadata.preferred_username || metadata.name || metadata.full_name || user?.email || (user?.id ? `ID ${String(user.id).slice(0, 8)}` : 'пользователь');
    }

    function userAvatarUrl(user) {
      const metadata = user?.user_metadata || {};
      const value = metadata.avatar_url || metadata.picture || metadata.avatar || metadata.photo_url || '';
      if (typeof value !== 'string') return '';
      try {
        const url = new URL(value);
        return url.protocol === 'https:' ? url.toString() : '';
      } catch (_error) {
        return '';
      }
    }

    function userInitial(name) {
      const normalized = String(name || '').trim();
      const match = normalized.match(/[\p{L}\p{N}]/u);
      return match ? match[0].toLocaleUpperCase('ru-RU') : '';
    }

    function renderAvatar(user) {
      const name = displayUserName(user);
      const picture = userAvatarUrl(user);
      if (avatarImg) {
        avatarImg.hidden = !picture;
        if (picture) avatarImg.setAttribute('src', picture);
        else avatarImg.removeAttribute('src');
      }
      const initial = picture ? '' : userInitial(name);
      if (avatarInitial) {
        avatarInitial.textContent = initial;
        avatarInitial.hidden = !initial;
      }
      if (avatarIcon) avatarIcon.hidden = Boolean(picture || initial);
    }

    function readJsonStorage(key) {
      try {
        const value = window.localStorage.getItem(key);
        return value ? JSON.parse(value) : null;
      } catch (_error) {
        return null;
      }
    }

    function writeJsonStorage(key, value) {
      try {
        window.localStorage.setItem(key, JSON.stringify(value));
      } catch (_error) {
        // localStorage can be unavailable in hardened browser modes. Auth still
        // relies on Supabase in-memory state for the current page load.
      }
    }

    function removeJsonStorage(key) {
      try {
        window.localStorage.removeItem(key);
      } catch (_error) {
        // Ignore cleanup failures.
      }
    }

    function markAuthIntent(state, extra = {}) {
      writeJsonStorage(authIntentKey, {
        state,
        provider: root.dataset.yandexProvider || 'custom:yandex',
        updated_at: new Date().toISOString(),
        ...extra,
      });
    }

    function clearAuthIntent() {
      removeJsonStorage(authIntentKey);
    }

    function supabaseProjectRef() {
      try {
        return new URL(root.dataset.supabaseUrl).host.split('.', 1)[0];
      } catch (_error) {
        return '';
      }
    }

    function hasStoredSupabaseSession() {
      const ref = supabaseProjectRef();
      if (!ref) return false;
      try {
        return Boolean(window.localStorage.getItem(`sb-${ref}-auth-token`));
      } catch (_error) {
        return false;
      }
    }

    function hasLocalAuthSignal() {
      return Boolean(readJsonStorage(authIntentKey)) || hasStoredSupabaseSession();
    }

    function renderAuthState(session, options = {}) {
      const { preserveError = false, checking = false } = options;
      const signedIn = Boolean(session?.user);
      if (login) {
        login.hidden = signedIn || checking;
        login.disabled = checking;
      }
      if (logout) logout.hidden = !signedIn;
      if (form) form.hidden = !signedIn;
      if (userBadge) userBadge.hidden = !signedIn;
      if (userName && signedIn) userName.textContent = displayUserName(session.user);
      if (signedIn) renderAvatar(session.user);
      else if (accountMenu) accountMenu.open = false;
      root.classList.toggle('is-authorized', signedIn);
      root.classList.toggle('is-auth-checking', checking);
      if (signedIn) {
        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get('q');
        if (initialQuery && input && !input.value) input.value = initialQuery.slice(0, 160);
        markAuthIntent('signed_in', { user_hint: displayUserName(session.user) });
      } else if (checking) {
        markAuthIntent('checking');
      } else if (!preserveError) {
        setStatus('Войдите через Яндекс, чтобы включить поиск.');
      }
      return signedIn;
    }

    function normalizeSearchInput(value) {
      return String(value || '').replace(/[\u0000-\u001F\u007F]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function validateSearchInput(value) {
      const query = normalizeSearchInput(value);
      if (query.length < 3) return { ok: false, message: 'Введите хотя бы 3 символа.' };
      if (query.length > maxQueryLength) return { ok: false, message: `Слишком длинный запрос: максимум ${maxQueryLength} символов.` };
      const unsafePatterns = [
        /<\s*\/?\s*(script|iframe|object|embed|svg|img|style|meta|link)/iu,
        /javascript\s*:/iu,
        /(?:--|\/\*|\*\/|;)/u,
        /(?:\{\{|\}\}|\$\{)/u,
        /\b(?:select|insert|update|delete|drop|alter|truncate|union)\b[\s\S]{0,48}\b(?:from|where|table|into|values|set)\b/iu,
        /\b(?:ignore|forget)\s+(?:all\s+)?(?:previous|prior)\s+(?:instructions?|rules?)\b/iu,
      ];
      if (unsafePatterns.some((pattern) => pattern.test(query))) {
        return { ok: false, message: 'Запрос похож на техническую команду. Опишите событие обычными словами.' };
      }
      if (/[^\p{L}\p{N}\p{M}\s.,!?«»"'()№:+\/\\\-–—]/u.test(query)) {
        return { ok: false, message: 'В запросе есть неподдерживаемые символы. Оставьте обычный текст, дату, место или жанр.' };
      }
      return { ok: true, query };
    }

    function setSearchProgress(value, label) {
      progressValue = Math.max(0, Math.min(100, Math.round(Number(value) || 0)));
      if (submit) submit.style.setProperty('--search-progress', `${progressValue}%`);
      if (submitLabel) submitLabel.textContent = progressValue >= 100 ? 'Готово' : `Ищу… ${progressValue}%`;
      if (label) setStatus(label);
    }

    function resetSearchProgress() {
      if (submit) submit.style.setProperty('--search-progress', '0%');
      if (submitLabel) submitLabel.textContent = 'Искать';
    }

    function setSearchLoading(isLoading) {
      loading = isLoading;
      if (submit) {
        submit.disabled = isLoading;
        submit.classList.toggle('is-loading', isLoading);
        submit.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      }
      if (input) input.readOnly = isLoading;
    }

    function withTimeout(promise, ms, message) {
      let timeoutId;
      const timeoutPromise = new Promise((_, reject) => {
        timeoutId = window.setTimeout(() => reject(new Error(message)), ms);
      });
      return Promise.race([promise, timeoutPromise]).finally(() => window.clearTimeout(timeoutId));
    }

    function errorMessageFromSearchPayload(payload) {
      const code = payload?.error || payload?.error_code || '';
      if (payload?.detail && /^query_/u.test(String(code))) return String(payload.detail);
      if (code === 'quota_exceeded') return 'Лимит поисков на сегодня закончился. Попробуйте позже.';
      if (code === 'auth_required') return 'Сессия закончилась. Войдите через Яндекс ещё раз.';
      if (code === 'query_too_short') return 'Введите хотя бы 3 символа.';
      if (code === 'query_too_long') return `Слишком длинный запрос: максимум ${maxQueryLength} символов.`;
      if (code === 'query_unsafe') return 'Запрос похож на техническую команду. Опишите событие обычными словами.';
      if (code === 'query_bad_characters') return 'В запросе есть неподдерживаемые символы. Оставьте обычный текст, дату, место или жанр.';
      return 'Поиск сейчас не сработал. Попробуйте ещё раз чуть позже.';
    }

    function renderCards(items, rankBase = offset) {
      const renderer = window.KenigEventsRenderEventCard;
      if (typeof renderer === 'function') {
        return items.map((candidate, index) => renderer({ candidate: { ...candidate, base_similarity: candidate.semantic_score || candidate.base_similarity || 0 }, rank: rankBase + index, personal_score: candidate.semantic_score || candidate.base_similarity || 0 }, 'split-actions')).join('');
      }
      return items.map((candidate) => {
        const display = candidate.display || candidate;
        const href = display.href || candidate.href || '#';
        const title = display.title || candidate.title || 'Событие';
        return `<article class="event-card event-card--split-actions" data-event-card data-event-id="${String(candidate.event_id || candidate.id || '')}" data-event-title="${escapeHtml(title)}" data-card-href="${escapeHtml(href)}" tabindex="0"><div class="event-card__body"><a class="event-card__title" href="${escapeHtml(href)}">${escapeHtml(title)}</a><div class="event-card__meta-row"><span class="event-card__meta">${escapeHtml(display.display_date_time || '')}</span></div></div></article>`;
      }).join('');
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }

    function appendSectionHeading(text) {
      if (!results) return;
      const heading = document.createElement('h3');
      heading.className = 'authorized-search__fallback-title';
      heading.textContent = text;
      results.appendChild(heading);
    }

    function candidateEventId(item) {
      const value = item?.event_id || item?.id || item?.display?.event_id || item?.display?.id;
      const id = Number(value);
      return Number.isFinite(id) && id > 0 ? id : null;
    }

    function enqueueLocalFeedback(query, verdict, eventIds) {
      try {
        const key = 'ke_search_feedback_queue_v1';
        const queue = JSON.parse(window.localStorage.getItem(key) || '[]');
        queue.push({ query, verdict, event_ids: eventIds || [], ts: new Date().toISOString() });
        window.localStorage.setItem(key, JSON.stringify(queue.slice(-80)));
      } catch (_error) {
        // Local fallback is best-effort only.
      }
    }

    async function sendSearchFeedback(query, verdict) {
      const eventIds = lastResultEventIds.slice(0, 40);
      enqueueLocalFeedback(query, verdict, eventIds);
      if (!supabase) return { ok: false, localOnly: true };
      try {
        const { error } = await supabase.rpc('record_event_search_feedback_v1', {
          p_query: query,
          p_verdict: verdict,
          p_result_event_ids: eventIds,
          p_result_count: eventIds.length,
          p_metadata: { surface: 'authorized_event_search', client_ts: new Date().toISOString() },
        });
        if (error) return { ok: false, error };
        return { ok: true };
      } catch (error) {
        return { ok: false, error };
      }
    }

    function appendFeedbackPrompt(query) {
      if (!results || feedbackShown || lastResultEventIds.length < 3) return;
      feedbackShown = true;
      const wrap = document.createElement('div');
      wrap.className = 'authorized-search__feedback';
      wrap.innerHTML = `<strong>Похоже на то, что вы искали?</strong><div class="authorized-search__feedback-actions"><button type="button" data-search-feedback="matched">Совпало с ожиданиями</button><button type="button" data-search-feedback="missed">Не совпало</button></div><p class="muted-note">Хорошие запросы попадут в очередь поисковых тегов: после LLM-унификации для них будет создана статическая страница.</p>`;
      wrap.querySelectorAll('[data-search-feedback]').forEach((button) => {
        button.addEventListener('click', async () => {
          const verdict = button.dataset.searchFeedback || 'missed';
          wrap.classList.add('is-saving');
          wrap.querySelectorAll('button').forEach((item) => { item.disabled = true; });
          const saved = await sendSearchFeedback(query, verdict);
          wrap.innerHTML = saved.ok
            ? '<strong>Спасибо. Запрос сохранён для анализа поисковых тегов.</strong><p class="muted-note">Если похожих оценок станет достаточно, появится общая статическая страница и тег поиска.</p>'
            : '<strong>Спасибо. Запрос сохранён в браузере.</strong><p class="muted-note">Не удалось отправить на сервер сейчас; локальная очередь не блокирует поиск.</p>';
        });
      });
      const cards = results.querySelectorAll('[data-event-card]');
      const anchor = cards[Math.min(3, cards.length - 1)];
      if (anchor?.parentElement === results) anchor.insertAdjacentElement('afterend', wrap);
      else results.appendChild(wrap);
    }

    function setResultContext(data) {
      if (!results) return;
      results.dataset.surface = 'authorized_event_search';
      results.dataset.requestId = data?.request_id || '';
      results.dataset.servedListId = data?.served_list_id || '';
      results.dataset.servedListHash = data?.served_list_hash || '';
      results.dataset.effectiveAlgorithmId = data?.algorithm_id || 'pgvector_gemini_embedding_2_v1';
      results.dataset.layoutMode = 'authorized_search_feed';
      results.dataset.presentationMode = 'feed';
    }

    async function refreshQuota() {
      if (!supabase) return;
      const { data, error } = await supabase.rpc('get_event_search_quota_v1', { p_plan_id: 'registered' });
      if (error) return;
      const row = Array.isArray(data) ? data[0] : data;
      if (row) setStatus(`Осталось поисков: ${row.day_remaining} сегодня, ${row.month_remaining} в этом месяце.`);
    }

    async function updateAuth(options = {}) {
      if (!supabase) return false;
      const { preserveError = false, session = null, checking = false } = options;
      let activeSession = session;
      if (!activeSession) {
        try {
          const result = await withTimeout(supabase.auth.getSession(), authSessionTimeoutMs, 'auth_session_timeout');
          activeSession = result?.data?.session || null;
        } catch (_error) {
          renderAuthState(null, { preserveError: true, checking: false });
          setStatus('Не удалось проверить сохранённый вход. Перезагрузите страницу или войдите ещё раз.', 'error');
          return false;
        }
      }
      const signedIn = renderAuthState(activeSession, { preserveError, checking });
      if (signedIn) {
        try {
          await refreshQuota();
        } catch (_error) {
          // Quota text is informational; the actual search endpoint enforces quota.
        }
      }
      return signedIn;
    }

    function clearResults() {
      if (results) { results.innerHTML = ''; results.hidden = true; setResultContext({}); }
      if (more) more.hidden = true;
      offset = 0;
      fallbackStarted = false;
      feedbackShown = false;
      lastResultEventIds = [];
    }

    async function invokeEventSearch(body, session) {
      const endpoint = `${root.dataset.supabaseUrl}/functions/v1/event-search`;
      // Mobile Chrome/WebView proved unreliable with the streamed final payload:
      // progress events reached 96%, the backend wrote a successful audit row,
      // but the browser sometimes never delivered the terminal `result` event.
      // For the MVP, reliability is more important than backend-stage streaming,
      // so the browser requests one JSON response and renders cards from it.
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          apikey: root.dataset.supabaseKey,
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(body),
      });
      const contentType = response.headers.get('content-type') || '';
      if (!contentType.includes('application/x-ndjson')) {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload?.error) return { data: null, error: payload || { error: 'search_failed' } };
        setSearchProgress(100, 'Готово');
        return { data: payload, error: null };
      }
      const reader = response.body?.getReader();
      if (!reader) return { data: null, error: { error: 'stream_unavailable' } };
      const decoder = new TextDecoder();
      let buffer = '';
      let finalData = null;
      let finalError = null;
      async function finishWithResult(event) {
        finalData = event.data;
        setSearchProgress(100, event.label || 'Готово');
        try {
          await reader.cancel();
        } catch (_error) {
          // Some browsers throw when cancelling an already closed stream. The
          // result event is authoritative, so the UI should not wait for EOF.
        }
        return { data: finalData, error: null };
      }
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;
          let event;
          try { event = JSON.parse(trimmed); }
          catch (_error) { continue; }
          if (event.type === 'progress') {
            setSearchProgress(event.progress, event.label || 'Поиск продолжается…');
          } else if (event.type === 'result') {
            return await finishWithResult(event);
          } else if (event.type === 'error') {
            finalError = event;
          }
        }
      }
      const tail = buffer.trim();
      if (tail) {
        try {
          const event = JSON.parse(tail);
          if (event.type === 'result') {
            finalData = event.data;
            setSearchProgress(100, event.label || 'Готово');
          }
          else if (event.type === 'error') finalError = event;
          else if (event.type === 'progress') setSearchProgress(event.progress, event.label || 'Поиск продолжается…');
        } catch (_error) {
          // Ignore malformed trailing stream fragments.
        }
      }
      return finalError ? { data: null, error: finalError } : { data: finalData, error: null };
    }

    async function runSearch({ append = false } = {}) {
      if (!supabase || loading) return;
      const { data: sessionData } = await supabase.auth.getSession();
      const session = sessionData?.session || null;
      if (!session?.user || !session?.access_token) {
        clearResults();
        await updateAuth();
        setStatus('Сначала войдите через Яндекс.', 'error');
        return;
      }
      const validation = validateSearchInput(input?.value || '');
      if (!validation.ok) {
        setStatus(validation.message, 'error');
        return;
      }
      const query = validation.query;
      if (input) input.value = query;
      setSearchLoading(true);
      setSearchProgress(1, 'Запускаю поиск…');
      const progressTimers = [
        window.setTimeout(() => { if (loading) setSearchProgress(28, 'Понимаю смысл запроса'); }, 500),
        window.setTimeout(() => { if (loading) setSearchProgress(55, 'Ищу события'); }, 1200),
        window.setTimeout(() => { if (loading) setSearchProgress(74, 'Проверяю, что подходит лучше'); }, 1800),
        window.setTimeout(() => { if (loading) setSearchProgress(92, 'Собираю карточки'); }, 3200),
      ];
      if (more) more.hidden = true;
      try {
        if (!append || query !== currentQuery) {
          currentQuery = query;
          offset = 0;
          fallbackStarted = false;
          feedbackShown = false;
          lastResultEventIds = [];
          if (results) {
            results.innerHTML = '';
            setResultContext({});
          }
        }
        const { data, error } = await withTimeout(
          invokeEventSearch(
            // JSON response path stays reliable; LLM verifier is bounded on the Edge side
            // and falls back to vector order on timeout/provider failure.
            { query, limit: 12, offset, include_fallback: true, use_llm_verifier: true },
            session,
          ),
          searchTimeoutMs,
          'search_timeout',
        );
        if (error) {
          const statusCode = Number(error?.status || error?.context?.status || 0);
          if (statusCode === 401 || statusCode === 403 || error?.error === 'auth_required') {
            await supabase.auth.signOut();
            clearResults();
            await updateAuth();
          }
          setStatus(errorMessageFromSearchPayload(error), 'error');
          return;
        }
        if (!data) {
          setStatus('Поиск не вернул ответ. Попробуйте ещё раз.', 'error');
          return;
        }
        const items = Array.isArray(data?.items) ? data.items : [];
        const fallbackItems = Array.isArray(data?.fallback_items) ? data.fallback_items : [];
        if (results) {
          setResultContext(data);
          if (!append && items.length > 0 && results.children.length === 0) {
            appendSectionHeading('Результаты поиска');
          }
          const html = renderCards(items, offset);
          if (html) results.insertAdjacentHTML('beforeend', html);
          lastResultEventIds.push(...items.map(candidateEventId).filter((id) => id != null));
          if (items.length === 0 && !fallbackStarted) {
            appendSectionHeading('Возможно, вам будет интересно');
            fallbackStarted = true;
          }
          if (!data?.has_more && fallbackItems.length) {
            if (!fallbackStarted) {
              appendSectionHeading('Возможно, вам будет интересно');
              fallbackStarted = true;
            }
            results.insertAdjacentHTML('beforeend', renderCards(fallbackItems, offset + items.length));
            lastResultEventIds.push(...fallbackItems.map(candidateEventId).filter((id) => id != null));
          }
          appendFeedbackPrompt(query);
          results.hidden = !results.children.length;
        }
        const nextOffset = Number(data?.next_offset);
        offset = Number.isFinite(nextOffset) && nextOffset >= offset ? nextOffset : offset + items.length;
        if (more) more.hidden = !data?.has_more;
        const quota = data?.quota;
        if (quota && quota.day_remaining != null) setStatus(`Осталось поисков: ${quota.day_remaining} сегодня, ${quota.month_remaining} в этом месяце.`);
        else await refreshQuota();
        if (items.length === 0 && fallbackItems.length === 0) setStatus('Ничего не нашлось. Попробуйте описать запрос иначе.');
        if (window.applyFeedbackState) window.applyFeedbackState({ skipDiscoveryHydration: true });
      } catch (error) {
        const message = String(error?.message || error);
        if (message === 'search_timeout') setStatus('Поиск занял слишком много времени. Попробуйте ещё раз — кнопка снова активна.', 'error');
        else setStatus('Поиск не сработал в браузере. Попробуйте ещё раз.', 'error');
      } finally {
        for (const timer of progressTimers) window.clearTimeout(timer);
        setSearchLoading(false);
        window.setTimeout(() => {
          if (!loading) resetSearchProgress();
        }, 650);
      }
    }

    function cleanAuthRedirectUrl() {
      const url = new URL(window.location.href);
      for (const key of ['code', 'error', 'error_code', 'error_description', 'state', 'sb']) url.searchParams.delete(key);
      url.hash = '';
      return url.toString();
    }

    function authCallbackParams() {
      const merged = new URLSearchParams(window.location.search);
      if (window.location.hash && window.location.hash.length > 1) {
        const hashParams = new URLSearchParams(window.location.hash.slice(1));
        for (const [key, value] of hashParams.entries()) {
          if (!merged.has(key)) merged.set(key, value);
        }
      }
      return merged;
    }

    function showAuthCallbackError() {
      const params = authCallbackParams();
      if (!params.has('error') && !params.has('error_code') && !params.has('error_description')) return false;
      const errorCode = params.get('error_code') || params.get('error') || '';
      cleanAuthCallbackHistory();
      setStatus(errorCode ? `Вход через Яндекс не завершён: ${errorCode}. Попробуйте ещё раз.` : 'Вход через Яндекс не завершён. Попробуйте ещё раз.', 'error');
      return true;
    }

    function cleanAuthCallbackHistory() {
      const cleanUrl = cleanAuthRedirectUrl();
      if (cleanUrl !== window.location.href) window.history.replaceState(window.history.state, '', cleanUrl);
    }

    async function handleAuthCallback() {
      if (!supabase) return { attempted: false, signedIn: false };
      const params = authCallbackParams();
      const code = params.get('code');
      if (!code) return { attempted: false, signedIn: false };
      // A PKCE callback is a transient state on a fully static page. Protect the
      // callback status from the initial onAuthStateChange(null) emission while
      // the browser exchanges the one-time code with Supabase.
      authCallbackHadError = true;
      markAuthIntent('callback_started', { redirect_to: cleanAuthRedirectUrl() });
      renderAuthState(null, { preserveError: true, checking: true });
      setStatus('Завершаю вход через Яндекс…');
      let exchangeResult;
      try {
        exchangeResult = await withTimeout(
          supabase.auth.exchangeCodeForSession(code),
          authCallbackTimeoutMs,
          'auth_callback_timeout',
        );
      } catch (caughtError) {
        exchangeResult = { data: null, error: caughtError };
      }
      const { data, error } = exchangeResult;
      if (error) {
        cleanAuthCallbackHistory();
        const rawMessage = String(error.message || error.name || error);
        const message = rawMessage === 'auth_callback_timeout'
          ? 'Вход через Яндекс не завершён: браузер не получил ответ от Supabase. Перезагрузите страницу или нажмите «Войти через Яндекс» ещё раз.'
          : /code verifier|flow state|auth code|invalid|pkce/i.test(rawMessage)
            ? 'Вход через Яндекс не завершён: сессия входа устарела или открыта не в той вкладке. Нажмите «Войти через Яндекс» ещё раз с этой страницы.'
            : 'Вход через Яндекс не завершён. Попробуйте ещё раз.';
        const existingSignedIn = hasLocalAuthSignal() ? await updateAuth({ preserveError: true }) : false;
        if (existingSignedIn) {
          authCallbackHadError = false;
          return { attempted: true, signedIn: true };
        }
        renderAuthState(null, { preserveError: true });
        markAuthIntent('callback_failed', { reason: rawMessage.slice(0, 120) });
        setStatus(message, 'error');
        return { attempted: true, signedIn: false };
      }
      const session = data?.session || null;
      if (session?.access_token && session?.refresh_token) {
        // exchangeCodeForSession normally persists the session. setSession is an
        // explicit belt-and-suspenders write for mobile static-page returns where
        // the server-side OAuth session is created but UI state can remain anonymous.
        await supabase.auth.setSession({ access_token: session.access_token, refresh_token: session.refresh_token });
      }
      cleanAuthCallbackHistory();
      const signedIn = await updateAuth({ session, preserveError: true });
      if (!signedIn) {
        markAuthIntent('callback_no_browser_session');
        setStatus('Вход через Яндекс завершился на сервере, но браузер не сохранил сессию. Нажмите «Войти через Яндекс» ещё раз.', 'error');
      } else {
        authCallbackHadError = false;
      }
      return { attempted: true, signedIn };
    }

    if (enabled) {
      supabase = createClient(root.dataset.supabaseUrl, root.dataset.supabaseKey, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false, flowType: 'pkce', storage: authStorage },
      });
      login?.addEventListener('click', async () => {
        const redirectTo = cleanAuthRedirectUrl();
        markAuthIntent('login_started', { redirect_to: redirectTo });
        renderAuthState(null, { preserveError: true, checking: true });
        setStatus('Открываю вход через Яндекс…');
        const { error } = await supabase.auth.signInWithOAuth({
          provider: root.dataset.yandexProvider || 'custom:yandex',
          options: { redirectTo },
        });
        if (error) {
          markAuthIntent('login_start_failed', { reason: String(error.message || error).slice(0, 120) });
          renderAuthState(null, { preserveError: true });
          setStatus('Не удалось открыть вход через Яндекс. Попробуйте ещё раз.', 'error');
        }
      });
      logout?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        clearResults();
        lastResultEventIds = [];
        clearAuthIntent();
        authCallbackHadError = false;
        renderAuthState(null);
      });
      document.addEventListener('click', (event) => {
        if (!accountMenu || !accountMenu.open) return;
        if (accountMenu.contains(event.target)) return;
        accountMenu.open = false;
      });
      accountMenu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') accountMenu.open = false;
      });
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        await runSearch({ append: false });
      });
      more?.addEventListener('click', async () => runSearch({ append: true }));
      supabase.auth.onAuthStateChange((_event, session) => {
        // Supabase warns against awaiting Supabase calls inside this callback.
        // Render from the callback payload and defer any follow-up RPCs.
        window.setTimeout(() => {
          const signedIn = renderAuthState(session, { preserveError: authCallbackHadError });
          if (signedIn) {
            authCallbackHadError = false;
            refreshQuota().catch(() => {});
          }
        }, 0);
      });
      if (hasLocalAuthSignal()) {
        renderAuthState(null, { preserveError: true, checking: true });
        setStatus('Проверяю сохранённый вход через Яндекс…');
      }
      handleAuthCallback()
        .then((callback) => {
          if (callback.signedIn) return true;
          if (callback.attempted || hasLocalAuthSignal()) return updateAuth({ preserveError: authCallbackHadError });
          renderAuthState(null);
          return false;
        })
        .then((signedIn) => { if (!signedIn && !authCallbackHadError) showAuthCallbackError(); });
    }
  }
</script>
