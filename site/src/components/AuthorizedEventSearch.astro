---
interface Props {
  compact?: boolean;
  standalone?: boolean;
  headingLevel?: 'h1' | 'h2';
}
const { compact = false, standalone = false, headingLevel = 'h2' } = Astro.props;
const supabaseUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
const supabaseKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
const yandexProvider = import.meta.env.PUBLIC_YANDEX_AUTH_PROVIDER || 'custom:yandex';
const enabled = Boolean(supabaseUrl && supabaseKey);
const HeadingTag = headingLevel;
---
<section id="poisk" class:list={["authorized-search", compact && "authorized-search--compact", standalone && "authorized-search--standalone"]} data-authorized-search data-search-enabled={enabled ? 'true' : 'false'} data-supabase-url={supabaseUrl || undefined} data-supabase-key={supabaseKey || undefined} data-yandex-provider={yandexProvider} data-nosnippet>
  <div class="authorized-search__head">
    <div class="authorized-search__copy">
      <p class="eyebrow">Умный поиск</p>
      <HeadingTag>{standalone ? 'Найти событие' : 'Найти событие по описанию'}</HeadingTag>
      <p class="muted-note">{standalone ? 'Опишите желание обычной фразой — жанр, настроение, время или с кем хотите пойти.' : 'Войдите через Яндекс и напишите обычной фразой, что хочется найти. Результаты появятся лентой: карточки можно лайкать, скрывать как «не интересно», добавлять в календарь и делиться.'}</p>
    </div>
    {enabled && <div class="authorized-search__auth">
      <button type="button" class="secondary-button authorized-search__login" data-search-login>
        <span class="authorized-search__yandex-icon" aria-hidden="true">Я</span>
        <span>Войти через Яндекс</span>
      </button>
      <details class="authorized-search__account-menu" data-search-user data-search-account hidden>
        <summary class="authorized-search__account-toggle" data-search-account-toggle aria-label="Профиль пользователя">
          <span class="authorized-search__avatar" data-search-avatar aria-hidden="true">
            <img data-search-avatar-img alt="" hidden />
            <span class="authorized-search__avatar-initial" data-search-avatar-initial hidden></span>
            <svg class="authorized-search__avatar-icon" data-search-avatar-icon viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 12.2c2.5 0 4.5-2 4.5-4.5S14.5 3.2 12 3.2s-4.5 2-4.5 4.5 2 4.5 4.5 4.5Zm0 2.1c-3.7 0-7.2 1.9-8.8 4.8-.4.7.1 1.7 1 1.7h15.6c.9 0 1.4-1 1-1.7-1.6-2.9-5.1-4.8-8.8-4.8Z" fill="currentColor"></path>
            </svg>
          </span>
        </summary>
        <div class="authorized-search__account-popover" data-search-account-popover>
          <div class="authorized-search__account-info">
            <span>Вошли как</span>
            <strong data-search-user-name></strong>
          </div>
          <button type="button" class="authorized-search__logout" data-search-logout>Выйти из аккаунта</button>
        </div>
      </details>
    </div>}
  </div>
  <form class="authorized-search__form" data-search-form aria-disabled={!enabled ? 'true' : undefined}>
    <label class:list={[!standalone && 'sr-only', standalone && 'authorized-search__query-label']} for="authorized-event-search-input">Что хочется сделать?</label>
    {standalone ? (
      <textarea id="authorized-event-search-input" rows="3" maxlength="180" data-search-input placeholder="Например: послушать хор или сходить с детьми бесплатно" autocomplete="off" readonly={!enabled}></textarea>
    ) : (
      <input id="authorized-event-search-input" type="search" maxlength="180" data-search-input placeholder="Например: джаз на выходных" autocomplete="off" />
    )}
    <button type="submit" class="cta-button authorized-search__submit" data-search-submit disabled={!enabled}>
      <span class="authorized-search__submit-label" data-search-submit-label>{enabled ? 'Искать' : 'Поиск пока не запускается'}</span>
    </button>
  </form>
  <div class="authorized-search__progress" data-search-progress role="progressbar" aria-label="Ход поиска" aria-valuemin="0" aria-valuemax="100" hidden>
    <span class="authorized-search__progress-bar" data-search-progress-bar aria-hidden="true"></span>
  </div>
  <p class="authorized-search__progress-label" data-search-progress-label role="status" aria-live="polite" aria-atomic="true" hidden></p>
  <p class="authorized-search__status" data-search-status aria-live="polite">{enabled ? 'Войдите, чтобы включить поиск.' : 'Это визуальный прототип: поле, запуск поиска и вход в этой noindex-сборке не подключены.'}</p>
  <div class="authorized-search__skeletons" data-search-skeletons hidden aria-hidden="true">
    {[0, 1].map(() => (
      <div class="authorized-search__skeleton-card">
        <div class="authorized-search__skeleton-media"></div>
        <div class="authorized-search__skeleton-body"><span></span><span></span></div>
        <div class="authorized-search__skeleton-actions"><span></span><span></span></div>
      </div>
    ))}
    <div class="authorized-search__skeleton-card authorized-search__skeleton-card--peek">
      <div class="authorized-search__skeleton-media"></div>
    </div>
  </div>
  <div class="authorized-search__results" data-search-results hidden></div>
  <button type="button" class="secondary-button authorized-search__more" data-search-more hidden>Показать ещё</button>
</section>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { resolveMobileEventCardMedia } from '../lib/relatedCardLayout.mjs';

  const roots = Array.from(document.querySelectorAll('[data-authorized-search]'));
  for (const root of roots) {
    if (root.dataset.searchBound === 'true') continue;
    root.dataset.searchBound = 'true';
    const enabled = root.dataset.searchEnabled === 'true';
    const status = root.querySelector('[data-search-status]');
    const login = root.querySelector('[data-search-login]');
    const logout = root.querySelector('[data-search-logout]');
    const form = root.querySelector('[data-search-form]');
    const input = root.querySelector('[data-search-input]');
    const submit = root.querySelector('[data-search-submit]');
    const submitLabel = root.querySelector('[data-search-submit-label]');
    const progress = root.querySelector('[data-search-progress]');
    const progressBar = root.querySelector('[data-search-progress-bar]');
    const progressLabel = root.querySelector('[data-search-progress-label]');
    const userBadge = root.querySelector('[data-search-user]');
    const userName = root.querySelector('[data-search-user-name]');
    const accountMenu = root.querySelector('[data-search-account]');
    const avatarImg = root.querySelector('[data-search-avatar-img]');
    const avatarInitial = root.querySelector('[data-search-avatar-initial]');
    const avatarIcon = root.querySelector('[data-search-avatar-icon]');
    const results = root.querySelector('[data-search-results]');
    const skeletons = root.querySelector('[data-search-skeletons]');
    const more = root.querySelector('[data-search-more]');
    const moreDefaultLabel = more?.textContent || 'Показать ещё';
    let supabase = null;
    let currentQuery = '';
    let offset = 0;
    let loading = false;
    let fallbackStarted = false;
    let feedbackShown = false;
    let lastResultEventIds = [];
    let pendingFallbackItems = [];
    let authCallbackHadError = false;
    let searchStartPending = false;
    let progressValue = 0;
    let progressStageRank = 0;
    let progressMilestoneRank = 0;
    let searchEpoch = 0;
    let activeSearchController = null;
    let completionResetTimer = null;
    const searchSlowNoticeMs = 6500;
    const authSessionTimeoutMs = 8000;
    const authCallbackTimeoutMs = 20000;
    const maxQueryLength = 180;

    const pkceCookiePrefix = 'ke_pkce_';
    const authIntentKey = 'ke_yandex_auth_intent_v1';
    const searchDraftKey = 'ke_authorized_search_draft_v1';
    const searchDraftMaxAgeMs = 30 * 60 * 1000;

    function isPkceCodeVerifierKey(key) {
      return typeof key === 'string' && key.endsWith('-code-verifier');
    }

    function pkceCookieName(key) {
      // Cookie names are deliberately short and path-wide: the OAuth return URL can
      // be any static preview/listing path on kenigevents.ru.
      return `${pkceCookiePrefix}${encodeURIComponent(key).replace(/%/g, '_')}`;
    }

    function setPkceCookie(key, value) {
      if (!isPkceCodeVerifierKey(key)) return;
      try {
        document.cookie = `${pkceCookieName(key)}=${encodeURIComponent(value)}; Max-Age=900; Path=/; SameSite=Lax; Secure`;
      } catch (_error) {
        // Best-effort fallback only. localStorage remains the primary Supabase storage.
      }
    }

    function getPkceCookie(key) {
      if (!isPkceCodeVerifierKey(key)) return null;
      const name = `${pkceCookieName(key)}=`;
      const item = document.cookie.split('; ').find((part) => part.startsWith(name));
      if (!item) return null;
      try {
        return decodeURIComponent(item.slice(name.length));
      } catch (_error) {
        return null;
      }
    }

    function removePkceCookie(key) {
      if (!isPkceCodeVerifierKey(key)) return;
      try {
        document.cookie = `${pkceCookieName(key)}=; Max-Age=0; Path=/; SameSite=Lax; Secure`;
      } catch (_error) {
        // Best-effort cleanup only.
      }
    }

    const authStorage = {
      getItem(key) {
        try {
          const value = window.localStorage.getItem(key);
          if (value != null) return value;
        } catch (_error) {
          // Continue to cookie fallback for the short-lived PKCE verifier.
        }
        return getPkceCookie(key);
      },
      setItem(key, value) {
        try {
          window.localStorage.setItem(key, value);
        } catch (_error) {
          // Supabase will still keep the in-memory session for this page load.
        }
        setPkceCookie(key, value);
      },
      removeItem(key) {
        try {
          window.localStorage.removeItem(key);
        } catch (_error) {
          // Ignore storage cleanup failures.
        }
        removePkceCookie(key);
      },
    };

    function setStatus(message, kind = 'info') {
      if (!status) return;
      status.textContent = message || '';
      if (kind === 'error') status.setAttribute('role', 'alert');
      else status.removeAttribute('role');
    }

    function displayUserName(user) {
      const metadata = user?.user_metadata || {};
      return metadata.preferred_username || metadata.name || metadata.full_name || user?.email || (user?.id ? `ID ${String(user.id).slice(0, 8)}` : 'пользователь');
    }

    function userAvatarUrl(user) {
      const metadata = user?.user_metadata || {};
      const value = metadata.avatar_url || metadata.picture || metadata.avatar || metadata.photo_url || '';
      if (typeof value !== 'string') return '';
      try {
        const url = new URL(value);
        return url.protocol === 'https:' ? url.toString() : '';
      } catch (_error) {
        return '';
      }
    }

    function userInitial(name) {
      const normalized = String(name || '').trim();
      const match = normalized.match(/[\p{L}\p{N}]/u);
      return match ? match[0].toLocaleUpperCase('ru-RU') : '';
    }

    function renderAvatar(user) {
      const name = displayUserName(user);
      const picture = userAvatarUrl(user);
      if (avatarImg) {
        avatarImg.hidden = !picture;
        if (picture) avatarImg.setAttribute('src', picture);
        else avatarImg.removeAttribute('src');
      }
      const initial = picture ? '' : userInitial(name);
      if (avatarInitial) {
        avatarInitial.textContent = initial;
        avatarInitial.hidden = !initial;
      }
      if (avatarIcon) avatarIcon.hidden = Boolean(picture || initial);
    }

    function readJsonStorage(key) {
      try {
        const value = window.localStorage.getItem(key);
        return value ? JSON.parse(value) : null;
      } catch (_error) {
        return null;
      }
    }

    function writeJsonStorage(key, value) {
      try {
        window.localStorage.setItem(key, JSON.stringify(value));
      } catch (_error) {
        // localStorage can be unavailable in hardened browser modes. Auth still
        // relies on Supabase in-memory state for the current page load.
      }
    }

    function removeJsonStorage(key) {
      try {
        window.localStorage.removeItem(key);
      } catch (_error) {
        // Ignore cleanup failures.
      }
    }

    function markAuthIntent(state, extra = {}) {
      writeJsonStorage(authIntentKey, {
        state,
        provider: root.dataset.yandexProvider || 'custom:yandex',
        updated_at: new Date().toISOString(),
        ...extra,
      });
    }

    function clearAuthIntent() {
      removeJsonStorage(authIntentKey);
    }

    function saveSearchDraft(query, pending = false) {
      writeJsonStorage(searchDraftKey, {
        query: String(query || '').slice(0, maxQueryLength),
        pending: Boolean(pending),
        updated_at: new Date().toISOString(),
      });
    }

    function readSearchDraft() {
      const draft = readJsonStorage(searchDraftKey);
      const updatedAt = Date.parse(String(draft?.updated_at || ''));
      if (
        !draft
        || typeof draft.query !== 'string'
        || !Number.isFinite(updatedAt)
        || Date.now() - updatedAt > searchDraftMaxAgeMs
      ) {
        removeJsonStorage(searchDraftKey);
        return null;
      }
      const validation = validateSearchInput(draft.query);
      if (!validation.ok) {
        removeJsonStorage(searchDraftKey);
        return null;
      }
      return { ...draft, query: validation.query };
    }

    function restoreSearchDraft() {
      const draft = readSearchDraft();
      if (draft && input && !input.value) input.value = draft.query;
      return draft;
    }

    async function runPendingSearchDraft() {
      const draft = readSearchDraft();
      if (!draft?.pending || loading) return false;
      removeJsonStorage(searchDraftKey);
      if (input) input.value = draft.query;
      await runSearch({ append: false });
      return true;
    }

    function supabaseProjectRef() {
      try {
        return new URL(root.dataset.supabaseUrl).host.split('.', 1)[0];
      } catch (_error) {
        return '';
      }
    }

    function hasStoredSupabaseSession() {
      const ref = supabaseProjectRef();
      if (!ref) return false;
      try {
        return Boolean(window.localStorage.getItem(`sb-${ref}-auth-token`));
      } catch (_error) {
        return false;
      }
    }

    function hasLocalAuthSignal() {
      return Boolean(readJsonStorage(authIntentKey)) || hasStoredSupabaseSession();
    }

    function renderAuthState(session, options = {}) {
      const { preserveError = false, checking = false } = options;
      const signedIn = Boolean(session?.user);
      if (login) {
        login.hidden = signedIn || checking;
        login.disabled = checking;
      }
      if (logout) logout.hidden = !signedIn;
      // A configured search accepts a draft before authentication. Submission
      // preserves that draft through Yandex PKCE and runs it after the callback.
      if (form) form.hidden = false;
      if (userBadge) userBadge.hidden = !signedIn;
      if (userName && signedIn) userName.textContent = displayUserName(session.user);
      if (signedIn) renderAvatar(session.user);
      else if (accountMenu) accountMenu.open = false;
      root.classList.toggle('is-authorized', signedIn);
      root.classList.toggle('is-auth-checking', checking);
      if (signedIn) {
        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get('q');
        if (initialQuery && input && !input.value) input.value = initialQuery.slice(0, 160);
        markAuthIntent('signed_in', { user_hint: displayUserName(session.user) });
      } else if (checking) {
        markAuthIntent('checking');
      } else if (!preserveError) {
        setStatus('Войдите через Яндекс, чтобы включить поиск.');
      }
      return signedIn;
    }

    function normalizeSearchInput(value) {
      return String(value || '').replace(/[\u0000-\u001F\u007F]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function validateSearchInput(value) {
      const query = normalizeSearchInput(value);
      if (query.length < 3) return { ok: false, message: 'Введите хотя бы 3 символа.' };
      if (query.length > maxQueryLength) return { ok: false, message: `Слишком длинный запрос: максимум ${maxQueryLength} символов.` };
      const unsafePatterns = [
        /<\s*\/?\s*(script|iframe|object|embed|svg|img|style|meta|link)/iu,
        /javascript\s*:/iu,
        /(?:--|\/\*|\*\/|;)/u,
        /(?:\{\{|\}\}|\$\{)/u,
        /\b(?:select|insert|update|delete|drop|alter|truncate|union)\b[\s\S]{0,48}\b(?:from|where|table|into|values|set)\b/iu,
        /\b(?:ignore|forget)\s+(?:all\s+)?(?:previous|prior)\s+(?:instructions?|rules?)\b/iu,
      ];
      if (unsafePatterns.some((pattern) => pattern.test(query))) {
        return { ok: false, message: 'Запрос похож на техническую команду. Опишите событие обычными словами.' };
      }
      if (/[^\p{L}\p{N}\p{M}\s.,!?«»"'()№:+\/\\\-–—]/u.test(query)) {
        return { ok: false, message: 'В запросе есть неподдерживаемые символы. Оставьте обычный текст, дату, место или жанр.' };
      }
      return { ok: true, query };
    }

    const searchStageOrder = {
      opening: 0,
      accepted: 1,
      auth: 2,
      validate: 3,
      result_cache: 4,
      quota: 5,
      embedding: 6,
      vector_search: 7,
      vector_results: 8,
      preview_visible: 9,
      llm_verify: 10,
      fallback: 11,
      finalize: 12,
      result: 13,
    };

    function isCurrentSearchEpoch(epoch) {
      return epoch === searchEpoch;
    }

    function milestoneForSearchStage(stage, fallbackLabel) {
      if (stage === 'result') return { rank: 6, label: fallbackLabel || 'Готово' };
      if (stage === 'finalize') return { rank: 5, label: fallbackLabel || 'Собираю результат…' };
      if (stage === 'llm_verify' || stage === 'fallback') return { rank: 4, label: fallbackLabel || 'Проверяю найденные варианты…' };
      if (stage === 'preview_visible') return { rank: 3, label: fallbackLabel || 'Варианты уже видны. Проверяю точность…' };
      if (stage === 'vector_results') return { rank: 2, label: fallbackLabel || 'Варианты найдены…' };
      if (stage === 'embedding' || stage === 'vector_search') return { rank: 1, label: fallbackLabel || 'Ищу события…' };
      return { rank: 0, label: fallbackLabel || 'Открываю поиск…' };
    }

    function announceSearchMilestone(stage, label) {
      if (!progressLabel) return;
      const milestone = milestoneForSearchStage(stage, label);
      if (milestone.rank < progressMilestoneRank) return;
      // Repeated backend events within one broad phase update the bar without
      // making a screen reader announce every internal implementation stage.
      if (milestone.rank === progressMilestoneRank && progressLabel.textContent) return;
      progressMilestoneRank = milestone.rank;
      progressLabel.textContent = milestone.label;
      progressLabel.hidden = false;
      if (progress) progress.setAttribute('aria-valuetext', milestone.label);
    }

    function beginSearchProgress(epoch, label) {
      if (!isCurrentSearchEpoch(epoch)) return;
      progressValue = 0;
      progressStageRank = searchStageOrder.opening;
      progressMilestoneRank = 0;
      if (completionResetTimer != null) {
        window.clearTimeout(completionResetTimer);
        completionResetTimer = null;
      }
      if (progress) {
        progress.hidden = false;
        progress.classList.add('is-indeterminate');
        progress.removeAttribute('aria-valuenow');
        progress.style.setProperty('--progress', '36%');
      }
      if (progressBar) progressBar.style.width = '36%';
      if (submit) {
        submit.classList.add('is-progress-indeterminate');
        submit.style.setProperty('--search-progress', '36%');
      }
      if (submitLabel) submitLabel.textContent = 'Ищу…';
      announceSearchMilestone('opening', label || 'Открываю поиск…');
    }

    function setSearchProgress(value, label, options = {}) {
      const { epoch = searchEpoch, stage = '' } = options;
      if (!isCurrentSearchEpoch(epoch)) return;
      const numeric = Number(value);
      if (!Number.isFinite(numeric)) return;
      const nextStageRank = searchStageOrder[stage] ?? progressStageRank;
      if (nextStageRank < progressStageRank) return;
      progressStageRank = nextStageRank;
      progressValue = Math.max(progressValue, Math.max(0, Math.min(100, Math.round(numeric))));
      if (progress) {
        progress.hidden = false;
        progress.classList.remove('is-indeterminate');
        progress.setAttribute('aria-valuenow', String(progressValue));
        progress.style.setProperty('--progress', `${progressValue}%`);
      }
      if (progressBar) progressBar.style.width = `${progressValue}%`;
      if (submit) {
        submit.classList.remove('is-progress-indeterminate');
        submit.style.setProperty('--search-progress', `${progressValue}%`);
      }
      if (submitLabel) submitLabel.textContent = progressValue >= 100 ? 'Готово' : 'Ищу…';
      announceSearchMilestone(stage, label);
    }

    function resetSearchProgress(epoch = searchEpoch) {
      if (!isCurrentSearchEpoch(epoch)) return;
      if (completionResetTimer != null) {
        window.clearTimeout(completionResetTimer);
        completionResetTimer = null;
      }
      progressValue = 0;
      progressStageRank = 0;
      progressMilestoneRank = 0;
      if (progress) {
        progress.hidden = true;
        progress.classList.remove('is-indeterminate');
        progress.removeAttribute('aria-valuenow');
        progress.removeAttribute('aria-valuetext');
        progress.style.setProperty('--progress', '0%');
      }
      if (progressBar) progressBar.style.width = '0%';
      if (submit) {
        submit.classList.remove('is-progress-indeterminate');
        submit.style.setProperty('--search-progress', '0%');
      }
      if (progressLabel) {
        progressLabel.hidden = true;
        progressLabel.textContent = '';
      }
      if (submitLabel) submitLabel.textContent = 'Искать';
    }

    function scheduleSearchProgressReset(epoch) {
      if (!isCurrentSearchEpoch(epoch)) return;
      if (completionResetTimer != null) window.clearTimeout(completionResetTimer);
      completionResetTimer = window.setTimeout(() => {
        completionResetTimer = null;
        resetSearchProgress(epoch);
      }, 650);
    }

    function setSkeletonLoading(isLoading) {
      if (skeletons) skeletons.hidden = !isLoading;
      root.classList.toggle('is-search-skeleton-loading', isLoading);
    }

    function setSearchLoading(isLoading, options = {}) {
      const { showSkeleton = true } = options;
      loading = isLoading;
      setSkeletonLoading(Boolean(isLoading && showSkeleton));
      if (submit) {
        submit.disabled = isLoading;
        submit.classList.toggle('is-loading', isLoading);
        submit.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      }
      if (input) input.readOnly = isLoading;
    }

    function setMoreLoading(isLoading) {
      if (!more) return;
      more.disabled = isLoading;
      more.classList.toggle('is-loading', isLoading);
      more.setAttribute('aria-busy', isLoading ? 'true' : 'false');
      more.textContent = isLoading ? 'Загружаю ещё…' : moreDefaultLabel;
    }

    function abortActiveSearch() {
      const controller = activeSearchController;
      if (!controller) return false;
      // Invalidate the request before aborting it so its catch/finally path and
      // any already queued stream frame cannot repaint the accepted CTA.
      searchEpoch += 1;
      activeSearchController = null;
      controller.abort();
      setSkeletonLoading(false);
      setMoreLoading(false);
      setSearchLoading(false);
      resetSearchProgress(searchEpoch);
      return true;
    }

    function withTimeout(promise, ms, message) {
      let timeoutId;
      const timeoutPromise = new Promise((_, reject) => {
        timeoutId = window.setTimeout(() => reject(new Error(message)), ms);
      });
      return Promise.race([promise, timeoutPromise]).finally(() => window.clearTimeout(timeoutId));
    }

    function errorMessageFromSearchPayload(payload) {
      const code = payload?.error || payload?.error_code || '';
      if (payload?.detail && /^query_/u.test(String(code))) return String(payload.detail);
      if (code === 'quota_exceeded') return payload?.detail || 'Лимит поисков в текущем окне закончился. Попробуйте позже.';
      if (code === 'auth_required') return 'Сессия закончилась. Войдите через Яндекс ещё раз.';
      if (code === 'query_too_short') return 'Введите хотя бы 3 символа.';
      if (code === 'query_too_long') return `Слишком длинный запрос: максимум ${maxQueryLength} символов.`;
      if (code === 'query_unsafe') return 'Запрос похож на техническую команду. Опишите событие обычными словами.';
      if (code === 'query_bad_characters') return 'В запросе есть неподдерживаемые символы. Оставьте обычный текст, дату, место или жанр.';
      return 'Поиск сейчас не сработал. Попробуйте ещё раз чуть позже.';
    }

    function currentPreviewEventUrl(value, absolute = false) {
      const normalize = window.KenigEventsNormalizeInternalEventUrl;
      return typeof normalize === 'function' ? normalize(value, { absolute }) : value;
    }

    function renderCards(items, rankBase = offset) {
      const renderer = window.KenigEventsRenderEventCard;
      // Search is a ranked mobile feed, not a one-column desktop recommendation
      // row. Preserve rank while applying the shared mobile media contract.
      const packed = items.map((item) => ({ item, layout: resolveMobileEventCardMedia(item) }));
      const rendered = typeof renderer === 'function'
        ? packed.map(({ item: candidate, layout }, index) => renderer({ candidate: { ...candidate, base_similarity: candidate.semantic_score || candidate.base_similarity || 0 }, rank: rankBase + index, personal_score: candidate.semantic_score || candidate.base_similarity || 0 }, 'split-actions', layout)).filter(Boolean).join('')
        : '';
      if (rendered) return rendered;
      setStatus('Результаты найдены, но карточки временно недоступны. Обновите страницу и попробуйте снова.', 'error');
      return '<p class="authorized-search__card-render-unavailable" data-search-card-render-unavailable role="status">Карточки результатов временно недоступны.</p>';
    }

    function vectorPreviewDisplay(candidate) {
      const display = candidate?.display || candidate || {};
      return {
        id: candidate?.event_id || candidate?.id || display.event_id || display.id || '',
        title: display.title || candidate?.title || 'Событие',
        href: currentPreviewEventUrl(display.href || candidate?.href || '#'),
        date: display.display_date_time || display.display_date || candidate?.display_date_time || '',
        place: display.place || display.venue_name || candidate?.venue_name || candidate?.city || '',
        type: display.event_type || candidate?.event_type || candidate?.category || 'вариант',
        score: candidate?.semantic_score || candidate?.base_similarity || candidate?.similarity || 0,
        occurrenceMemberIds: Array.isArray(display.occurrence_member_ids) ? display.occurrence_member_ids.map(Number).filter(Number.isFinite) : [],
      };
    }

    function searchOccurrenceFamilyKey(candidate) {
      const display = candidate?.display || candidate || {};
      const ids = Array.from(new Set((Array.isArray(display.occurrence_member_ids) ? display.occurrence_member_ids : [])
        .map(Number).filter((value) => Number.isFinite(value) && value > 0))).sort((left, right) => left - right);
      const eventId = candidateEventId(candidate);
      return ids.length > 1 ? `family:${ids.join(',')}` : `event:${eventId || ''}`;
    }

    function collapseSearchOccurrenceFamilies(items, seen = new Set()) {
      return items.filter((candidate) => {
        const key = searchOccurrenceFamilyKey(candidate);
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function renderVectorPreviewCards(items, rankBase = offset, pageOffset = offset) {
      return items.map((candidate, index) => {
        const item = vectorPreviewDisplay(candidate);
        const rank = rankBase + index + 1;
        const score = Math.max(0, Math.min(99, Math.round(Number(item.score || 0) * 100)));
        return `<article class="authorized-search__vector-card" data-search-vector-card data-search-phase="vector" data-search-page-offset="${escapeHtml(pageOffset)}" data-event-id="${escapeHtml(item.id)}" data-event-title="${escapeHtml(item.title)}" data-occurrence-member-ids="${escapeHtml(item.occurrenceMemberIds.join(','))}" data-card-href="${escapeHtml(item.href)}" data-rank="${escapeHtml(rank)}" data-score="${escapeHtml(score)}" aria-busy="true" aria-label="${escapeHtml(`Кандидат ${rank}: ${item.title}. ИИ проверяет релевантность.`)}">
          <div class="authorized-search__vector-card-glow" aria-hidden="true"></div>
          <div class="authorized-search__vector-card-top">
            <span class="authorized-search__vector-pill">${escapeHtml(item.type)}</span>
            <span class="authorized-search__vector-rank">#${escapeHtml(rank)}</span>
          </div>
          <strong>${escapeHtml(item.title)}</strong>
          <div class="authorized-search__vector-meta">${escapeHtml(item.date || 'Дата уточняется')}</div>
          ${item.place ? `<div class="authorized-search__vector-place">${escapeHtml(item.place)}</div>` : ''}
          <div class="authorized-search__vector-bars" aria-hidden="true"><span></span><span></span><span></span></div>
        </article>`;
      }).join('');
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }

    function appendSectionHeading(text, kind = '') {
      if (!results) return;
      const heading = document.createElement('h3');
      heading.className = 'authorized-search__fallback-title';
      if (kind) heading.dataset.searchSection = kind;
      heading.textContent = text;
      results.appendChild(heading);
    }

    function appendEmptyExactState() {
      if (!results || results.querySelector('[data-search-empty-exact]')) return;
      const note = document.createElement('p');
      note.className = 'authorized-search__empty';
      note.dataset.searchEmptyExact = 'true';
      note.textContent = 'По вашему запросу ничего не найдено';
      results.appendChild(note);
    }

    function candidateEventId(item) {
      const value = item?.event_id || item?.id || item?.display?.event_id || item?.display?.id;
      const id = Number(value);
      return Number.isFinite(id) && id > 0 ? id : null;
    }

    function enqueueLocalFeedback(query, verdict, eventIds) {
      try {
        const key = 'ke_search_feedback_queue_v1';
        const queue = JSON.parse(window.localStorage.getItem(key) || '[]');
        queue.push({ query, verdict, event_ids: eventIds || [], ts: new Date().toISOString() });
        window.localStorage.setItem(key, JSON.stringify(queue.slice(-80)));
      } catch (_error) {
        // Local fallback is best-effort only.
      }
    }

    async function sendSearchFeedback(query, verdict, options = {}) {
      const eventIds = Array.isArray(options.eventIds) ? options.eventIds : lastResultEventIds.slice(0, 40);
      if (options.enqueue !== false) enqueueLocalFeedback(query, verdict, eventIds);
      if (!supabase) return { ok: false, localOnly: true };
      try {
        const { error } = await withTimeout(
          supabase.rpc('record_event_search_feedback_v1', {
            p_query: query,
            p_verdict: verdict,
            p_result_event_ids: eventIds,
            p_result_count: eventIds.length,
            p_metadata: { surface: 'authorized_event_search', client_ts: new Date().toISOString() },
          }),
          5000,
          'feedback_timeout',
        );
        if (error) return { ok: false, error };
        return { ok: true };
      } catch (error) {
        return { ok: false, error };
      }
    }

    function appendFeedbackPrompt(query) {
      if (!results || feedbackShown) return;
      feedbackShown = true;
      const wrap = document.createElement('div');
      wrap.className = 'authorized-search__feedback';
      wrap.dataset.searchFeedbackEndcap = 'true';
      wrap.innerHTML = `<strong>Нашли то, что искали?</strong><div class="authorized-search__feedback-actions"><button type="button" data-search-feedback="matched">Да, нашёл</button><button type="button" data-search-feedback="missed">Нет, не нашёл</button></div><p class="muted-note">Ответ поможет улучшить поиск и будущие готовые подборки.</p>`;
      wrap.querySelectorAll('[data-search-feedback]').forEach((button) => {
        button.addEventListener('click', () => {
          if (wrap.dataset.feedbackState === 'saving' || wrap.dataset.feedbackState === 'saved') return;
          const verdict = button.dataset.searchFeedback || 'missed';
          const verdictLabel = verdict === 'matched' ? 'результат совпал' : 'не совпало';
          const eventIds = lastResultEventIds.slice(0, 40);
          enqueueLocalFeedback(query, verdict, eventIds);
          wrap.classList.add('is-saving');
          wrap.dataset.feedbackState = 'saving';
          wrap.querySelectorAll('button').forEach((item) => { item.disabled = true; });
          button.classList.add('is-selected');
          wrap.innerHTML = `<strong>Выбрано: ${escapeHtml(verdictLabel)}.</strong><p class="authorized-search__feedback-state">Сохраняю на сервере… Если связь подвиснет, выбор уже записан в браузере и будет виден здесь.</p>`;
          window.setTimeout(async () => {
            const saved = await sendSearchFeedback(query, verdict, { eventIds, enqueue: false });
            wrap.classList.remove('is-saving');
            wrap.classList.add(saved.ok ? 'is-saved' : 'is-local');
            wrap.dataset.feedbackState = saved.ok ? 'saved' : 'local';
            wrap.innerHTML = saved.ok
              ? '<strong>Готово: оценка сохранена.</strong><p class="muted-note">Спасибо. Это поможет собрать хорошие поисковые теги и улучшить выдачу.</p>'
              : '<strong>Выбор сохранён в браузере.</strong><p class="muted-note">Сервер не подтвердил запись достаточно быстро; локальная очередь не блокирует поиск, а оценку можно догрузить позже.</p>';
          }, 0);
        });
      });
      results.appendChild(wrap);
    }

    function setResultContext(data) {
      if (!results) return;
      results.dataset.surface = 'authorized_event_search';
      results.dataset.requestId = data?.request_id || '';
      results.dataset.servedListId = data?.served_list_id || '';
      results.dataset.servedListHash = data?.served_list_hash || '';
      results.dataset.effectiveAlgorithmId = data?.algorithm_id || 'pgvector_gemini_embedding_2_v1';
      results.dataset.layoutMode = 'authorized_search_feed';
      results.dataset.presentationMode = 'feed';
    }

    async function refreshQuota() {
      if (!supabase) return;
      const { data, error } = await supabase.rpc('get_event_search_quota_v2', { p_plan_id: 'registered' });
      if (error) return;
      const row = Array.isArray(data) ? data[0] : data;
      if (row?.hour_remaining != null) {
        const reset = row.hour_reset_at ? new Date(row.hour_reset_at).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) : 'через час';
        setStatus(`Осталось поисков: ${row.hour_remaining} в этом часу. Окно обновится ${reset}.`);
      } else if (row?.day_remaining != null) {
        setStatus(`Осталось поисков: ${row.day_remaining} сегодня.`);
      }
    }

    async function updateAuth(options = {}) {
      if (!supabase) return false;
      const { preserveError = false, session = null, checking = false } = options;
      let activeSession = session;
      if (!activeSession) {
        try {
          const result = await withTimeout(supabase.auth.getSession(), authSessionTimeoutMs, 'auth_session_timeout');
          activeSession = result?.data?.session || null;
        } catch (_error) {
          renderAuthState(null, { preserveError: true, checking: false });
          setStatus('Не удалось проверить сохранённый вход. Перезагрузите страницу или войдите ещё раз.', 'error');
          return false;
        }
      }
      const signedIn = renderAuthState(activeSession, { preserveError, checking });
      if (signedIn) {
        try {
          await refreshQuota();
        } catch (_error) {
          // Quota text is informational; the actual search endpoint enforces quota.
        }
      }
      return signedIn;
    }

    function clearResults() {
      if (activeSearchController) {
        searchEpoch += 1;
        activeSearchController.abort();
        activeSearchController = null;
        setMoreLoading(false);
        setSearchLoading(false);
        resetSearchProgress(searchEpoch);
      }
      if (results) { results.innerHTML = ''; results.hidden = true; setResultContext({}); }
      setSkeletonLoading(false);
      if (more) more.hidden = true;
      offset = 0;
      fallbackStarted = false;
      feedbackShown = false;
      lastResultEventIds = [];
      pendingFallbackItems = [];
    }

    function markInsertedCards(startIndex, phase, pageOffset) {
      if (!results) return;
      Array.from(results.children).slice(startIndex).forEach((node) => {
        if (node.matches?.('[data-event-card]')) {
          node.dataset.searchPhase = phase;
          node.dataset.searchPageOffset = String(pageOffset);
        }
      });
    }

    function removeVectorPreview(pageOffset) {
      if (!results) return;
      results.querySelectorAll(`[data-search-phase="vector"][data-search-page-offset="${String(pageOffset)}"]`).forEach((node) => node.remove());
      results.querySelectorAll(`[data-search-vector-note][data-search-page-offset="${String(pageOffset)}"]`).forEach((node) => node.remove());
    }

    function appendPhaseNote(text, pageOffset) {
      if (!results) return;
      const note = document.createElement('p');
      note.className = 'authorized-search__phase-note';
      note.dataset.searchVectorNote = 'true';
      note.dataset.searchPageOffset = String(pageOffset);
      note.textContent = text;
      results.appendChild(note);
    }

    function insertCardHtml(items, rankBase, phase, pageOffset) {
      if (!results || !items.length) return;
      const startIndex = results.children.length;
      results.insertAdjacentHTML('beforeend', renderCards(items, rankBase));
      markInsertedCards(startIndex, phase, pageOffset);
    }

    function insertVectorPreviewHtml(items, rankBase, pageOffset) {
      if (!results || !items.length) return;
      results.insertAdjacentHTML('beforeend', renderVectorPreviewCards(items, rankBase, pageOffset));
    }

    function renderSearchPayload(data, options = {}) {
      const { append = false, phase = 'final', pageOffset = offset } = options;
      const isVector = phase === 'vector';
      const rawItems = Array.isArray(data?.items) ? data.items : [];
      const rawFallbackItems = isVector ? [] : (Array.isArray(data?.fallback_items) ? data.fallback_items : []);
      const seenFamilies = new Set((append ? Array.from(results?.querySelectorAll('[data-occurrence-member-ids]') || []) : [])
        .map((node) => {
          const ids = String(node.getAttribute('data-occurrence-member-ids') || '').split(',').map(Number).filter(Number.isFinite).sort((left, right) => left - right);
          return ids.length > 1 ? `family:${ids.join(',')}` : `event:${node.getAttribute('data-event-id') || ''}`;
        }));
      const items = collapseSearchOccurrenceFamilies(rawItems, seenFamilies);
      const fallbackItems = collapseSearchOccurrenceFamilies(rawFallbackItems, seenFamilies);
      if (!results) return { itemCount: items.length, fallbackCount: fallbackItems.length };

      if (isVector) {
        const verifierPending = data?.llm_verifier?.status === 'pending';
        // Vector candidates are provisional. Keep the canonical-card skeleton
        // stable until the verified payload arrives instead of reshuffling UI.
        results.hidden = true;
        setStatus(items.length > 0
          ? (verifierPending ? 'Нашёл варианты. Проверяю точность…' : 'Нашёл варианты. Собираю карточки…')
          : 'Поиск пока не нашёл карточки. Проверяю дальше…');
        return { itemCount: items.length, fallbackCount: 0 };
      }

      removeVectorPreview(pageOffset);
      if (!append) {
        results.innerHTML = '';
        fallbackStarted = false;
        lastResultEventIds = [];
        pendingFallbackItems = [];
      }
      setResultContext(data);

      if (!append && results.children.length === 0) appendSectionHeading('Результаты поиска', 'exact');
      insertCardHtml(items, pageOffset, 'final', pageOffset);
      lastResultEventIds.push(...items.map(candidateEventId).filter((id) => id != null));

      const fallbackKeys = new Set(pendingFallbackItems.map(searchOccurrenceFamilyKey));
      for (const item of fallbackItems) {
        const key = searchOccurrenceFamilyKey(item);
        if (!fallbackKeys.has(key)) {
          pendingFallbackItems.push(item);
          fallbackKeys.add(key);
        }
      }

      // Exact results own pagination. Discovery and feedback are an endcap and
      // cannot appear while another exact page is still available.
      if (!data?.has_more) {
        if (lastResultEventIds.length === 0) appendEmptyExactState();
        appendFeedbackPrompt(currentQuery || input?.value || '');
        const exactIds = new Set(lastResultEventIds);
        const discoveryItems = pendingFallbackItems.filter((item) => !exactIds.has(candidateEventId(item)));
        if (discoveryItems.length) {
          appendSectionHeading('Ещё можно посмотреть', 'discovery');
          fallbackStarted = true;
          insertCardHtml(discoveryItems, pageOffset + items.length, 'final', pageOffset);
        }
      }
      results.hidden = !results.children.length;
      return { itemCount: items.length, fallbackCount: fallbackItems.length };
    }

    async function invokeEventSearchJson(endpoint, body, session, reason = 'json_fallback', options = {}) {
      const { epoch = searchEpoch, signal } = options;
      const fallbackBody = reason === 'stream_stalled'
        ? { ...body, use_llm_verifier: false, stream_rescue: true }
        : body;
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          apikey: root.dataset.supabaseKey,
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(fallbackBody),
        signal,
      });
      if (!isCurrentSearchEpoch(epoch)) return { data: null, error: null, stale: true };
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload?.error) return { data: null, error: payload || { error: 'search_failed' } };
      setSearchProgress(100, reason === 'stream_stalled' ? 'Показал быстрые карточки' : 'Готово', { epoch, stage: 'result' });
      return { data: payload, error: null, rescued: reason === 'stream_stalled' };
    }

    async function invokeEventSearch(body, session, options = {}) {
      const { epoch = searchEpoch, signal } = options;
      const endpoint = `${root.dataset.supabaseUrl}/functions/v1/event-search`;
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          apikey: root.dataset.supabaseKey,
          Authorization: `Bearer ${session.access_token}`,
          'Content-Type': 'application/json',
          Accept: 'application/x-ndjson',
        },
        body: JSON.stringify(body),
        signal,
      });
      if (!isCurrentSearchEpoch(epoch)) return { data: null, error: null, stale: true };
      const contentType = response.headers.get('content-type') || '';
      if (!contentType.includes('application/x-ndjson')) {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload?.error) return { data: null, error: payload || { error: 'search_failed' } };
        setSearchProgress(100, 'Готово', { epoch, stage: 'result' });
        return { data: payload, error: null };
      }
      const reader = response.body?.getReader();
      if (!reader) return invokeEventSearchJson(endpoint, body, session, 'stream_unavailable', { epoch, signal });
      const decoder = new TextDecoder();
      let buffer = '';
      let finalData = null;
      let finalError = null;
      let receivedStreamEvent = false;
      const firstChunkTimeoutMs = 7200;
      const readWithFirstChunkTimeout = () => {
        if (receivedStreamEvent) return reader.read();
        let timeoutId;
        const timeout = new Promise((resolve) => {
          timeoutId = window.setTimeout(() => resolve({ streamTimedOut: true }), firstChunkTimeoutMs);
        });
        return Promise.race([reader.read(), timeout]).finally(() => window.clearTimeout(timeoutId));
      };
      async function finishWithResult(event) {
        if (!isCurrentSearchEpoch(epoch)) return { data: null, error: null, stale: true };
        finalData = event.data;
        setSearchProgress(100, event.label || 'Готово', { epoch, stage: 'result' });
        try {
          await reader.cancel();
        } catch (_error) {
          // Some browsers throw when cancelling an already closed stream. The
          // result event is authoritative, so the UI should not wait for EOF.
        }
        return { data: finalData, error: null };
      }
      function handleStreamEvent(event) {
        if (!isCurrentSearchEpoch(epoch)) return;
        receivedStreamEvent = true;
        if (event.type === 'progress') {
          setSearchProgress(event.progress, event.label || 'Поиск продолжается…', { epoch, stage: event.stage || '' });
          if (event.stage === 'vector_results' && event.data) {
            options.onVectorResult?.(event.data, event);
          }
        } else if (event.type === 'error') {
          finalError = event;
        }
      }
      while (true) {
        const readResult = await readWithFirstChunkTimeout();
        if (readResult?.streamTimedOut) {
          try { await reader.cancel(); } catch (_error) {}
          if (!isCurrentSearchEpoch(epoch)) return { data: null, error: null, stale: true };
          setStatus('Поток прогресса не дошёл до браузера. Переключаюсь на быстрые карточки…');
          return invokeEventSearchJson(endpoint, body, session, 'stream_stalled', { epoch, signal });
        }
        const { value, done } = readResult;
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed) continue;
          let event;
          try { event = JSON.parse(trimmed); }
          catch (_error) { continue; }
          if (event.type === 'result') return await finishWithResult(event);
          handleStreamEvent(event);
        }
      }
      const tail = buffer.trim();
      if (tail) {
        try {
          const event = JSON.parse(tail);
          if (event.type === 'result') {
            finalData = event.data;
            setSearchProgress(100, event.label || 'Готово', { epoch, stage: 'result' });
          } else {
            handleStreamEvent(event);
          }
        } catch (_error) {
          // Ignore malformed trailing stream fragments.
        }
      }
      if (!finalData && !finalError && !receivedStreamEvent) {
        return invokeEventSearchJson(endpoint, body, session, 'stream_stalled', { epoch, signal });
      }
      return finalError ? { data: null, error: finalError } : { data: finalData, error: null };
    }

    async function runSearch({ append = false } = {}) {
      if (!supabase || loading || searchStartPending) return;
      searchStartPending = true;
      let sessionData;
      try {
        ({ data: sessionData } = await supabase.auth.getSession());
      } catch (_error) {
        searchStartPending = false;
        setStatus('Не удалось проверить вход. Попробуйте ещё раз.', 'error');
        return;
      }
      const session = sessionData?.session || null;
      if (!session?.user || !session?.access_token) {
        clearResults();
        const validation = validateSearchInput(input?.value || '');
        if (!validation.ok) {
          searchStartPending = false;
          setStatus(validation.message, 'error');
          return;
        }
        if (input) input.value = validation.query;
        saveSearchDraft(validation.query, true);
        searchStartPending = false;
        await beginYandexLogin();
        return;
      }
      const validation = validateSearchInput(input?.value || '');
      if (!validation.ok) {
        searchStartPending = false;
        setStatus(validation.message, 'error');
        return;
      }
      const query = validation.query;
      if (input) input.value = query;
      const epoch = searchEpoch + 1;
      searchEpoch = epoch;
      activeSearchController?.abort();
      const controller = new AbortController();
      activeSearchController = controller;
      searchStartPending = false;
      setSearchLoading(true, { showSkeleton: !append });
      if (append) setMoreLoading(true);
      let vectorRendered = false;
      let completed = false;
      beginSearchProgress(epoch, append ? 'Открываю следующую страницу…' : 'Открываю поиск…');
      const slowNoticeTimer = window.setTimeout(() => {
        if (!isCurrentSearchEpoch(epoch) || !loading) return;
        if (vectorRendered) {
          setStatus('Варианты уже найдены. Финальная проверка идёт дольше обычного; скелетон сменится готовыми карточками.', 'info');
        } else {
          setStatus('Ищу дольше обычного. Не останавливаю поиск: как только появятся первые карточки, покажу их здесь.', 'info');
        }
      }, searchSlowNoticeMs);
      if (more && !append) more.hidden = true;
      try {
        if (!append || query !== currentQuery) {
          currentQuery = query;
          offset = 0;
          fallbackStarted = false;
          feedbackShown = false;
          lastResultEventIds = [];
          pendingFallbackItems = [];
          if (results) {
            results.innerHTML = '';
            setResultContext({});
          }
        }
        const pageOffset = offset;
        const searchResponse = await invokeEventSearch(
          { query, limit: 8, offset: pageOffset, candidate_window: 10, include_fallback: true, use_llm_verifier: true, allow_llm_fallback: false },
          session,
          {
            epoch,
            signal: controller.signal,
            onVectorResult: (vectorData, streamEvent) => {
              if (!isCurrentSearchEpoch(epoch)) return;
              vectorRendered = true;
              renderSearchPayload(vectorData, { append, phase: 'vector', pageOffset });
              setSearchProgress(streamEvent?.progress, 'Варианты найдены. Проверяю точность…', { epoch, stage: 'preview_visible' });
            },
          },
        );
        const { data, error, stale = false } = searchResponse;
        if (!isCurrentSearchEpoch(epoch) || controller.signal.aborted) return;
        if (stale) return;
        if (error) {
          const statusCode = Number(error?.status || error?.context?.status || 0);
          if (statusCode === 401 || statusCode === 403 || error?.error === 'auth_required') {
            await supabase.auth.signOut();
            clearResults();
            await updateAuth();
          }
          setStatus(errorMessageFromSearchPayload(error), 'error');
          return;
        }
        if (!data) {
          if (vectorRendered && results?.children.length) {
            setStatus('Показал быстрые результаты по смыслу. Финальный ответ не пришёл, но найденные карточки остаются на экране.', 'info');
          } else {
            setStatus('Поиск не вернул ответ. Попробуйте ещё раз.', 'error');
          }
          return;
        }
        const items = Array.isArray(data?.items) ? data.items : [];
        const fallbackItems = Array.isArray(data?.fallback_items) ? data.fallback_items : [];
        renderSearchPayload(data, { append, phase: 'final', pageOffset });
        completed = true;
        const nextOffset = Number(data?.next_offset);
        offset = Number.isFinite(nextOffset) && nextOffset >= pageOffset ? nextOffset : pageOffset + items.length;
        if (more) more.hidden = !data?.has_more;
        const quota = data?.quota;
        if (quota && quota.hour_remaining != null) setStatus(`Осталось поисков: ${quota.hour_remaining} в этом часу. Окно обновится ${quota.hour_reset_at ? new Date(quota.hour_reset_at).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) : 'через час'}.`);
        else if (quota && quota.day_remaining != null) setStatus(`Осталось поисков: ${quota.day_remaining} сегодня.`);
        else await refreshQuota();
        if (items.length === 0 && fallbackItems.length === 0) setStatus('Ничего не нашлось. Попробуйте описать запрос иначе.');
        if (results && results.children.length) setSkeletonLoading(false);
        if (window.applyFeedbackState) window.applyFeedbackState({ skipDiscoveryHydration: true });
      } catch (error) {
        if (!isCurrentSearchEpoch(epoch) || controller.signal.aborted || error?.name === 'AbortError') return;
        if (vectorRendered && results?.children.length) setStatus('Показал быстрые результаты по смыслу. Финальный ответ не пришёл, но найденные карточки остаются на экране.', 'info');
        else setStatus('Поиск не сработал в браузере. Попробуйте ещё раз.', 'error');
      } finally {
        window.clearTimeout(slowNoticeTimer);
        if (!isCurrentSearchEpoch(epoch)) return;
        if (activeSearchController === controller) activeSearchController = null;
        setSkeletonLoading(false);
        setMoreLoading(false);
        setSearchLoading(false);
        if (completed) scheduleSearchProgressReset(epoch);
        else resetSearchProgress(epoch);
      }
    }

    function cleanAuthRedirectUrl() {
      const url = new URL(window.location.href);
      for (const key of ['code', 'error', 'error_code', 'error_description', 'state', 'sb']) url.searchParams.delete(key);
      url.hash = '';
      return url.toString();
    }

    function authCallbackParams() {
      const merged = new URLSearchParams(window.location.search);
      if (window.location.hash && window.location.hash.length > 1) {
        const hashParams = new URLSearchParams(window.location.hash.slice(1));
        for (const [key, value] of hashParams.entries()) {
          if (!merged.has(key)) merged.set(key, value);
        }
      }
      return merged;
    }

    function showAuthCallbackError() {
      const params = authCallbackParams();
      if (!params.has('error') && !params.has('error_code') && !params.has('error_description')) return false;
      const errorCode = params.get('error_code') || params.get('error') || '';
      cleanAuthCallbackHistory();
      setStatus(errorCode ? `Вход через Яндекс не завершён: ${errorCode}. Попробуйте ещё раз.` : 'Вход через Яндекс не завершён. Попробуйте ещё раз.', 'error');
      return true;
    }

    function cleanAuthCallbackHistory() {
      const cleanUrl = cleanAuthRedirectUrl();
      if (cleanUrl !== window.location.href) window.history.replaceState(window.history.state, '', cleanUrl);
    }

    async function handleAuthCallback() {
      if (!supabase) return { attempted: false, signedIn: false };
      const params = authCallbackParams();
      const code = params.get('code');
      if (!code) return { attempted: false, signedIn: false };
      // A PKCE callback is a transient state on a fully static page. Protect the
      // callback status from the initial onAuthStateChange(null) emission while
      // the browser exchanges the one-time code with Supabase.
      authCallbackHadError = true;
      markAuthIntent('callback_started', { redirect_to: cleanAuthRedirectUrl() });
      renderAuthState(null, { preserveError: true, checking: true });
      setStatus('Завершаю вход через Яндекс…');
      let exchangeResult;
      try {
        exchangeResult = await withTimeout(
          supabase.auth.exchangeCodeForSession(code),
          authCallbackTimeoutMs,
          'auth_callback_timeout',
        );
      } catch (caughtError) {
        exchangeResult = { data: null, error: caughtError };
      }
      const { data, error } = exchangeResult;
      if (error) {
        cleanAuthCallbackHistory();
        const rawMessage = String(error.message || error.name || error);
        const message = rawMessage === 'auth_callback_timeout'
          ? 'Вход через Яндекс не завершён: браузер не получил ответ от Supabase. Перезагрузите страницу или нажмите «Войти через Яндекс» ещё раз.'
          : /code verifier|flow state|auth code|invalid|pkce/i.test(rawMessage)
            ? 'Вход через Яндекс не завершён: сессия входа устарела или открыта не в той вкладке. Нажмите «Войти через Яндекс» ещё раз с этой страницы.'
            : 'Вход через Яндекс не завершён. Попробуйте ещё раз.';
        const existingSignedIn = hasLocalAuthSignal() ? await updateAuth({ preserveError: true }) : false;
        if (existingSignedIn) {
          authCallbackHadError = false;
          return { attempted: true, signedIn: true };
        }
        renderAuthState(null, { preserveError: true });
        markAuthIntent('callback_failed', { reason: rawMessage.slice(0, 120) });
        setStatus(message, 'error');
        return { attempted: true, signedIn: false };
      }
      const session = data?.session || null;
      if (session?.access_token && session?.refresh_token) {
        // exchangeCodeForSession normally persists the session. setSession is an
        // explicit belt-and-suspenders write for mobile static-page returns where
        // the server-side OAuth session is created but UI state can remain anonymous.
        await supabase.auth.setSession({ access_token: session.access_token, refresh_token: session.refresh_token });
      }
      cleanAuthCallbackHistory();
      const signedIn = await updateAuth({ session, preserveError: true });
      if (!signedIn) {
        markAuthIntent('callback_no_browser_session');
        setStatus('Вход через Яндекс завершился на сервере, но браузер не сохранил сессию. Нажмите «Войти через Яндекс» ещё раз.', 'error');
      } else {
        authCallbackHadError = false;
      }
      return { attempted: true, signedIn };
    }

    async function beginYandexLogin() {
      const redirectTo = cleanAuthRedirectUrl();
      markAuthIntent('login_started', { redirect_to: redirectTo });
      renderAuthState(null, { preserveError: true, checking: true });
      setStatus('Открываю вход через Яндекс…');
      const { error } = await supabase.auth.signInWithOAuth({
        provider: root.dataset.yandexProvider || 'custom:yandex',
        options: { redirectTo },
      });
      if (error) {
        markAuthIntent('login_start_failed', { reason: String(error.message || error).slice(0, 120) });
        renderAuthState(null, { preserveError: true });
        setStatus('Не удалось открыть вход через Яндекс. Запрос сохранён — попробуйте войти ещё раз.', 'error');
        return false;
      }
      return true;
    }

    if (enabled) {
      supabase = createClient(root.dataset.supabaseUrl, root.dataset.supabaseKey, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false, flowType: 'pkce', storage: authStorage },
      });
      login?.addEventListener('click', async () => {
        const validation = validateSearchInput(input?.value || '');
        if (validation.ok) saveSearchDraft(validation.query, true);
        else removeJsonStorage(searchDraftKey);
        await beginYandexLogin();
      });
      logout?.addEventListener('click', async () => {
        abortActiveSearch();
        await supabase.auth.signOut();
        clearResults();
        lastResultEventIds = [];
        clearAuthIntent();
        authCallbackHadError = false;
        renderAuthState(null);
      });
      document.addEventListener('click', (event) => {
        if (!accountMenu || !accountMenu.open) return;
        if (accountMenu.contains(event.target)) return;
        accountMenu.open = false;
      });
      accountMenu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') accountMenu.open = false;
      });
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        await runSearch({ append: false });
      });
      more?.addEventListener('click', async () => runSearch({ append: true }));
      window.addEventListener('pagehide', abortActiveSearch, { once: true });
      supabase.auth.onAuthStateChange((_event, session) => {
        // Supabase warns against awaiting Supabase calls inside this callback.
        // Render from the callback payload and defer any follow-up RPCs.
        window.setTimeout(() => {
          const signedIn = renderAuthState(session, { preserveError: authCallbackHadError });
          if (signedIn) {
            authCallbackHadError = false;
            refreshQuota().catch(() => {});
          }
        }, 0);
      });
      if (hasLocalAuthSignal()) {
        renderAuthState(null, { preserveError: true, checking: true });
        setStatus('Проверяю сохранённый вход через Яндекс…');
      }
      restoreSearchDraft();
      handleAuthCallback()
        .then((callback) => {
          if (callback.signedIn) return true;
          if (callback.attempted || hasLocalAuthSignal()) return updateAuth({ preserveError: authCallbackHadError });
          renderAuthState(null);
          return false;
        })
        .then(async (signedIn) => {
          if (!signedIn && !authCallbackHadError) {
            showAuthCallbackError();
            return;
          }
          if (signedIn) await runPendingSearchDraft();
        });
    }
  }
</script>
