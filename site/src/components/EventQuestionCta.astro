---
import type { PreviewEvent } from '../lib/types';
import { withBase } from '../lib/events';

interface Props {
  event: PreviewEvent;
  surface: 'desktop' | 'mobile';
}

const { event, surface } = Astro.props;
const cta = event.question_cta;
const sourceCopy = cta?.source === 'partner_post'
  ? 'Откроется пост в сообществе партнёра.'
  : 'Откроется пост «Полюбить Калининград Афиша».';
---
{cta && (
  <aside
    class:list={['event-question-cta', `event-question-cta--${surface}`]}
    data-event-question-cta
    data-question-cta-source={cta.source}
    aria-labelledby={`event-question-cta-${surface}-${event.id}`}
  >
    <img class="event-question-cta__question-icon" src={withBase('/assets/icons/question-cta/question-bubble-390478.svg')} alt="" width="28" height="28" />
    <div class="event-question-cta__copy">
      <h2 id={`event-question-cta-${surface}-${event.id}`}>Остались вопросы?</h2>
      <p>Задайте их в комментариях ВКонтакте. {sourceCopy}</p>
    </div>
    <a href={cta.url} target="_blank" rel="noopener noreferrer nofollow" data-question-cta-link data-question-cta-provider={cta.provider}>
      <img src={withBase('/assets/icons/question-cta/vk-repost-348786.svg')} alt="" width="20" height="20" />
      <span>Задать вопрос</span>
      <span class="sr-only"> во ВКонтакте</span>
    </a>
  </aside>
)}

<style>
  .event-question-cta { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:clamp(.85rem,2vw,1.35rem); color:#241c17; background:#fffaf2; border:1px solid rgba(98,72,55,.22); box-shadow:0 14px 34px rgba(35,25,18,.1); }
  .event-question-cta__question-icon { inline-size:28px; block-size:28px; padding:4px; box-sizing:content-box; border-radius:10px; background:#f2dfc6; }
  .event-question-cta__copy h2 { margin:0; font-size:clamp(1.1rem,2vw,1.45rem); line-height:1.15; }
  .event-question-cta__copy p { margin:.35rem 0 0; color:#6f6157; line-height:1.45; }
  .event-question-cta a { min-height:48px; display:inline-flex; align-items:center; justify-content:center; gap:.55rem; padding:.7rem 1rem; border-radius:999px; background:#447bba; color:#fff; font-weight:850; text-decoration:none; white-space:nowrap; }
  .event-question-cta a img { inline-size:20px; block-size:20px; padding:3px; box-sizing:content-box; border-radius:6px; background:#fff; }
  .event-question-cta a:hover { background:#356aa8; }
  .event-question-cta a:focus-visible { outline:3px solid #bd4e20; outline-offset:4px; }
  .event-question-cta--desktop { width:min(1180px,calc(100% - 2rem)); margin:clamp(2.5rem,5vw,5rem) auto; padding:clamp(1rem,2.4vw,1.6rem); border-radius:20px; }
  .event-question-cta--mobile { margin:1rem 0 0; padding:1rem; border-radius:18px; }
  @media (max-width: 639px) {
    .event-question-cta { grid-template-columns:auto minmax(0,1fr); }
    .event-question-cta a { grid-column:1/-1; width:100%; }
  }
</style>
