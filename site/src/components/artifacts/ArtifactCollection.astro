---
import { siteHomeHref, withBase } from '../../lib/events';
import { ARTIFACT_COLLECTION_SLOTS } from '../../lib/artifacts.mjs';

const artifacts = ARTIFACT_COLLECTION_SLOTS.map((artifact) => ({
  ...artifact,
  imageSrc: withBase(artifact.image.src),
}));
const requiredCount = Math.ceil(artifacts.length * 0.6);
---
<section
  class="artifact-collection"
  id="artefakty"
  aria-labelledby="artifact-collection-title"
  data-artifact-collection
  data-artifact-count={artifacts.length}
  data-artifact-required={requiredCount}
  data-artifact-visual-donor="008839b14598105d1fed5b4e386d6d6f29d93d1f"
  data-nosnippet
>
  <nav class="artifact-collection__crumbs" aria-label="Хлебные крошки">
    <a href={siteHomeHref()}>Афиша</a><span aria-hidden="true">/</span><span>Артефакты</span>
  </nav>

  <header class="artifact-collection__hero" data-artifact-collection-hero>
    <div>
      <p class="eyebrow">Коллекция № 1 · локальная находка</p>
      <h1 id="artifact-collection-title">Знаки Янтарного края</h1>
      <p class="artifact-collection__lead">
        Вводная коллекция о разных гранях Калининградской области: море, природа,
        архитектура, вкус и космическая история.
      </p>
    </div>
    <aside aria-label={`Для открытия заявки нужно найти ${requiredCount} из ${artifacts.length} артефактов`}>
      <strong>{requiredCount}/{artifacts.length}</strong>
      <span>нужно найти, чтобы открыть заявку</span>
    </aside>
  </header>

  <p class="artifact-collection__device-note">
    <strong>Только на этом устройстве.</strong>
    Коллекция хранится в браузере, не отправляется на сервер и исчезнет после очистки данных сайта.
  </p>

  <div class="artifact-collection__progress-head">
    <div>
      <p class="eyebrow">Ваш прогресс</p>
      <h2>Найдено <strong data-artifact-found-count>0</strong> из {artifacts.length}</h2>
      <p data-artifact-progress-copy>
        Ещё <strong data-artifact-remaining-count>{artifacts.length}</strong> скрыто.
        Пока артефакт не найден, коллекция не раскрывает ни его название, ни изображение.
      </p>
    </div>
    <div class="artifact-collection__meter-copy">
      <strong data-artifact-progress-percent>0%</strong><span>коллекции</span>
    </div>
  </div>

  <div
    class="artifact-collection__meter"
    role="progressbar"
    aria-label="Прогресс коллекции"
    aria-valuemin="0"
    aria-valuemax={artifacts.length}
    aria-valuenow="0"
    data-artifact-progressbar
  ><span data-artifact-progress-fill></span></div>

  <ol class="artifact-collection__slots" aria-label="Семь артефактов первой коллекции">
    {artifacts.map((artifact, index) => (
      <li class="artifact-slot" data-artifact-slot={artifact.id} data-artifact-state="empty">
        <div class="artifact-slot__empty" data-artifact-empty>
          <span class="artifact-slot__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="artifact-slot__mystery" aria-hidden="true">?</span>
          <strong>Не найден</strong>
          <span>{artifact.hint}</span>
        </div>
        <button
          class="artifact-slot__found"
          type="button"
          data-artifact-open
          data-artifact-id={artifact.id}
          aria-haspopup="dialog"
          aria-controls={`artifact-detail-${artifact.id}`}
          hidden
        >
          <img src={artifact.imageSrc} width={artifact.image.width} height={artifact.image.height} alt="" decoding="async" />
          <span>
            <small>Найден · {String(index + 1).padStart(2, '0')}</small>
            <strong>{artifact.title}</strong>
            <em>Открыть историю</em>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <p class="artifact-collection__threshold" data-artifact-threshold-copy>
    До возможности подать заявку на розыгрыш — ещё <strong>{requiredCount}</strong>.
    Достижение порога открывает форму, но не означает автоматическое участие или выигрыш.
  </p>

  <section class="artifact-collection__rules" aria-labelledby="artifact-rules-title">
    <div><p class="eyebrow">Автоматические правила</p><h2 id="artifact-rules-title">Артефакт<br />не убегает</h2></div>
    <ul>
      <li><strong>Закрепление.</strong> После назначения артефакт ждёт в том же интерфейсном месте до находки или конца окна коллекции.</li>
      <li><strong>После находки.</strong> Он остаётся на исходном месте с отметкой «Найден»; повторное нажатие открывает историю.</li>
      <li><strong>После срока.</strong> Место освобождается, а уже найденный артефакт остаётся в архиве коллекции.</li>
      <li><strong>Без лайк-гейта.</strong> Лайк, публикация, покупка и скорость сбора не влияют на доступность и шанс.</li>
      <li><strong>Порог.</strong> {requiredCount} находок открывают одну форму заявки; остальные находки не увеличивают вероятность выигрыша.</li>
    </ul>
  </section>

  {artifacts.map((artifact, index) => (
    <dialog
      class="artifact-detail"
      id={`artifact-detail-${artifact.id}`}
      aria-labelledby={`artifact-detail-title-${artifact.id}`}
      aria-describedby={`artifact-detail-copy-${artifact.id}`}
      data-artifact-dialog={artifact.id}
    >
      <div class="artifact-detail__panel">
        <button class="artifact-detail__close" type="button" aria-label="Закрыть историю артефакта" data-artifact-close>×</button>
        <div class="artifact-detail__visual">
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')} / {artifacts.length}</span>
          <img src={artifact.imageSrc} width={artifact.image.width} height={artifact.image.height} alt={artifact.image.alt} decoding="async" />
        </div>
        <div>
          <p class="artifact-detail__eyebrow">Артефакт найден</p>
          <h2 id={`artifact-detail-title-${artifact.id}`}>{artifact.title}</h2>
          <p class="artifact-detail__lead">{artifact.short_description}</p>
          <p id={`artifact-detail-copy-${artifact.id}`}>{artifact.detail_copy}</p>
          <dl class="artifact-detail__meta">
            <div><dt>Коллекция</dt><dd>Первая · {artifacts.length} артефактов</dd></div>
            <div><dt>Reference</dt><dd>{artifact.image.source_file}</dd></div>
            <div><dt>Статус истории</dt><dd>Факты не дополняются без редакционной проверки</dd></div>
          </dl>
          <p class="artifact-detail__local">Находка сохранена только в этом браузере.</p>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .artifact-collection{width:min(1120px,calc(100% - 28px));margin:0 auto;padding:0 0 clamp(56px,8vw,96px);color:#281d17}
  .artifact-collection [hidden]{display:none!important}
  .artifact-collection__crumbs{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin:16px 0;color:#76645a;font-size:13px}.artifact-collection__crumbs a{color:#8d3f1d}
  .eyebrow,.artifact-detail__eyebrow{margin:0 0 8px;color:#98401f;font-size:12px;font-weight:900;letter-spacing:.11em;text-transform:uppercase}
  .artifact-collection__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(210px,.3fr);gap:24px;align-items:end;padding:clamp(28px,5vw,56px);border:1px solid rgba(125,55,28,.16);border-radius:26px;background:radial-gradient(circle at 90% 16%,rgba(226,157,54,.22),transparent 35%),linear-gradient(145deg,#fffaf0,#f4e3cb)}
  .artifact-collection__hero h1{max-width:13ch;margin:2px 0 10px;font-size:clamp(48px,8vw,104px);line-height:.88;letter-spacing:-.06em}
  .artifact-collection__lead{max-width:66ch;margin:0;font-size:clamp(16px,2vw,20px);line-height:1.55}
  .artifact-collection__hero aside{display:grid;justify-items:end;text-align:right}.artifact-collection__hero aside strong{color:#943f1c;font-size:clamp(45px,7vw,88px);line-height:.9}.artifact-collection__hero aside span{max-width:20ch;color:#6e5b50;font-size:13px}
  .artifact-collection__device-note{margin:16px 0 0;padding:16px 18px;border:1px solid rgba(15,118,110,.2);border-radius:16px;background:#eef8f5;color:#315d57;font-size:15px;line-height:1.5}
  .artifact-collection__progress-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-top:40px}.artifact-collection__progress-head>div:first-child{max-width:66ch}.artifact-collection__progress-head h2{margin:2px 0 7px;font-size:clamp(32px,5vw,64px);letter-spacing:-.045em}.artifact-collection__progress-head h2 strong{color:#943f1c}.artifact-collection__progress-head p{margin:0;color:#6f5e54;line-height:1.55}
  .artifact-collection__meter-copy{flex:0 0 auto;display:grid;text-align:right}.artifact-collection__meter-copy strong{color:#943f1c;font-size:32px;line-height:1}.artifact-collection__meter-copy span{color:#76645a;font-size:12px}
  .artifact-collection__meter{height:10px;margin-top:18px;overflow:hidden;border-radius:999px;background:rgba(121,48,20,.1)}.artifact-collection__meter>span{display:block;width:0;height:100%;border-radius:inherit;background:linear-gradient(90deg,#9e431c,#e3a33d)}
  .artifact-collection__slots{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:16px 0 0;padding:0;list-style:none}
  .artifact-slot{min-width:0;min-height:224px;border:1px dashed rgba(74,48,35,.2);border-radius:20px;background:rgba(255,255,255,.52)}.artifact-slot[data-artifact-state="found"]{border-style:solid;border-color:rgba(191,112,29,.35);background:radial-gradient(circle at 50% 35%,#fff1b4,#fffaf0 62%);box-shadow:0 12px 34px rgba(100,54,22,.09)}
  .artifact-slot__empty{box-sizing:border-box;height:100%;min-height:224px;display:grid;place-items:center;align-content:center;gap:12px;padding:16px;color:#75665c;text-align:center}.artifact-slot__number{justify-self:start;align-self:start;width:100%;color:#a28f83;font-size:11px;font-weight:900;letter-spacing:.08em}.artifact-slot__mystery{width:68px;height:68px;display:grid;place-items:center;border:1px dashed rgba(74,48,35,.24);border-radius:50%;background:rgba(74,48,35,.04);font:800 32px/1 Georgia,serif}.artifact-slot__empty>span:last-child{max-width:22ch;color:#8b776a;font-size:11px;line-height:1.35}
  .artifact-slot__found{box-sizing:border-box;width:100%;min-height:224px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:16px;border:0;border-radius:19px;background:transparent;color:#281d17;font:inherit;text-align:center;cursor:pointer}.artifact-slot__found img{width:auto;height:96px;max-width:130px;object-fit:contain;filter:drop-shadow(0 7px 9px rgba(157,78,0,.24))}.artifact-slot__found span{display:grid;gap:3px}.artifact-slot__found small{color:#6f6b2e;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.artifact-slot__found strong{font-size:15px}.artifact-slot__found em{color:#98401f;font-size:12px;font-style:normal;font-weight:850}.artifact-slot__found:hover{box-shadow:inset 0 0 0 2px #d08a31;transform:translateY(-2px)}
  .artifact-collection__threshold{margin:16px 0 0;padding:15px 16px;border-left:4px solid #cf872e;background:#fff5dc;color:#5f4c40;line-height:1.5}
  .artifact-collection__rules{display:grid;grid-template-columns:minmax(260px,.42fr) minmax(0,1fr);gap:clamp(20px,5vw,64px);margin-top:18px;padding:clamp(24px,4vw,42px);border:1px solid rgba(74,48,35,.12);border-radius:26px;background:rgba(255,253,248,.88)}.artifact-collection__rules h2{margin:0;font-size:clamp(42px,5vw,62px);line-height:.9;letter-spacing:-.055em}.artifact-collection__rules ul{margin:0;padding-left:20px}.artifact-collection__rules li{margin-bottom:12px;line-height:1.5}
  .artifact-slot__found:focus-visible,.artifact-detail button:focus-visible{outline:3px solid #0f766e;outline-offset:3px}
  .artifact-detail{width:min(820px,calc(100% - 24px));max-width:none;padding:0;border:0;border-radius:26px;background:#fffaf2;color:#281d17;box-shadow:0 24px 80px rgba(31,18,12,.28)}.artifact-detail::backdrop{background:rgba(34,26,20,.58)}.artifact-detail__panel{position:relative;display:grid;grid-template-columns:240px 1fr;gap:30px;align-items:center;padding:clamp(24px,5vw,46px)}.artifact-detail__visual{min-height:270px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;border-radius:20px;background:#f5ecdf}.artifact-detail__visual>span{align-self:flex-start;margin-left:16px;color:#8a7466;font:800 11px/1 system-ui}.artifact-detail__visual img{width:auto;height:210px;max-width:210px;object-fit:contain;filter:drop-shadow(0 10px 12px rgba(82,44,16,.2))}.artifact-detail__close{position:absolute;top:14px;right:14px;width:44px;height:44px;border:0;border-radius:50%;background:#eee2d5;color:#4a3024;font:400 29px/1 system-ui;cursor:pointer}.artifact-detail h2{margin:0 0 12px;font-size:clamp(30px,5vw,50px);line-height:.95;letter-spacing:-.04em}.artifact-detail p{font-size:15px;line-height:1.55}.artifact-detail__lead{font-weight:800}.artifact-detail__meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:18px 0}.artifact-detail__meta div{padding:10px;border-radius:12px;background:#f2e8db}.artifact-detail__meta dt{color:#8b7161;font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.artifact-detail__meta dd{margin:4px 0 0;overflow-wrap:anywhere;font-size:11px;line-height:1.35}.artifact-detail__local{color:#76645a;font-size:12px!important}
  @media(max-width:760px){.artifact-collection__hero{grid-template-columns:1fr}.artifact-collection__hero aside{justify-items:start;text-align:left}.artifact-collection__progress-head{align-items:start}.artifact-collection__slots{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.artifact-slot,.artifact-slot__empty,.artifact-slot__found{min-height:188px}.artifact-collection__rules{grid-template-columns:1fr}.artifact-detail__panel{grid-template-columns:1fr;justify-items:stretch}.artifact-detail__visual{min-height:210px}.artifact-detail__visual img{height:150px}.artifact-detail__meta{grid-template-columns:1fr}}
  @media(max-width:420px){.artifact-collection{width:min(362px,calc(100% - 28px))}.artifact-collection__hero{padding:22px}.artifact-collection__hero h1{font-size:50px}.artifact-collection__progress-head{display:block}.artifact-collection__meter-copy{margin-top:12px;text-align:left}.artifact-slot__empty>span:last-child{display:none}.artifact-slot__found img{height:86px;max-width:100px}.artifact-detail{max-height:calc(100dvh - 24px);overflow:auto}.artifact-detail__panel{gap:14px;padding:58px 20px 24px}.artifact-detail__visual{min-height:180px}.artifact-detail__visual img{height:126px}}
  @media(prefers-reduced-motion:reduce){.artifact-collection *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
</style>

<script>
  import { ARTIFACT_COLLECTION_IDS, ARTIFACT_COLLECTION_STORAGE_KEY, foundArtifactIds, hasArtifact, readArtifactCollection } from '../../lib/artifacts.mjs';

  document.querySelectorAll('[data-artifact-collection]').forEach((root) => {
    if (root.dataset.artifactCollectionReady === 'true') return;
    root.dataset.artifactCollectionReady = 'true';
    const count = root.querySelector('[data-artifact-found-count]');
    const progressCopy = root.querySelector('[data-artifact-progress-copy]');
    const percent = root.querySelector('[data-artifact-progress-percent]');
    const progressbar = root.querySelector('[data-artifact-progressbar]');
    const fill = root.querySelector('[data-artifact-progress-fill]');
    const threshold = root.querySelector('[data-artifact-threshold-copy]');
    const total = ARTIFACT_COLLECTION_IDS.length;
    const required = Number(root.dataset.artifactRequired || Math.ceil(total * 0.6));
    let lastTrigger = null;

    const render = () => {
      const state = readArtifactCollection();
      for (const artifactId of ARTIFACT_COLLECTION_IDS) {
        const slot = root.querySelector(`[data-artifact-slot="${artifactId}"]`);
        const found = hasArtifact(state, artifactId);
        if (slot) slot.dataset.artifactState = found ? 'found' : 'empty';
        const empty = slot?.querySelector('[data-artifact-empty]');
        const open = slot?.querySelector('[data-artifact-open]');
        if (empty) empty.hidden = found;
        if (open) open.hidden = !found;
      }
      const foundIds = foundArtifactIds(state);
      const foundCount = foundIds.length;
      const progress = total ? Math.round(foundCount / total * 100) : 0;
      if (count) count.textContent = String(foundCount);
      if (progressCopy && foundCount === total) {
        progressCopy.textContent = 'Все семь артефактов открыты. Историю каждой находки можно перечитать.';
      } else if (progressCopy) {
        progressCopy.innerHTML = `Ещё <strong data-artifact-remaining-count>${total - foundCount}</strong> скрыто. Пока артефакт не найден, коллекция не раскрывает ни его название, ни изображение.`;
      }
      if (percent) percent.textContent = `${progress}%`;
      progressbar?.setAttribute('aria-valuenow', String(foundCount));
      if (fill) fill.style.width = `${progress}%`;
      if (threshold) threshold.innerHTML = foundCount >= required
        ? '<strong>Порог достигнут.</strong> Форма заявки откроется после запуска согласованного розыгрыша.'
        : `До возможности подать заявку на розыгрыш — ещё <strong>${required - foundCount}</strong>. Достижение порога открывает форму, но не означает автоматическое участие или выигрыш.`;
      return foundIds;
    };

    const openDialog = (artifactId, trigger) => {
      if (!render().includes(artifactId)) return;
      const dialog = root.querySelector(`[data-artifact-dialog="${artifactId}"]`);
      if (!dialog || typeof dialog.showModal !== 'function') return;
      lastTrigger = trigger || document.activeElement;
      if (!dialog.open) dialog.showModal();
    };

    root.querySelectorAll('[data-artifact-open]').forEach((trigger) => {
      trigger.addEventListener('click', () => openDialog(trigger.dataset.artifactId, trigger));
    });
    root.querySelectorAll('[data-artifact-dialog]').forEach((dialog) => {
      dialog.querySelector('[data-artifact-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => {
        if (location.hash === `#${dialog.dataset.artifactDialog}`) history.replaceState(null, '', `${location.pathname}${location.search}`);
        lastTrigger?.focus?.();
      });
    });
    addEventListener('kenigevents:artifact-collected', render);
    addEventListener('storage', (event) => { if (event.key === ARTIFACT_COLLECTION_STORAGE_KEY) render(); });
    const foundIds = render();
    const hashId = decodeURIComponent(location.hash.slice(1));
    if (foundIds.includes(hashId)) {
      const trigger = root.querySelector(`[data-artifact-open][data-artifact-id="${hashId}"]`);
      requestAnimationFrame(() => openDialog(hashId, trigger));
    }
  });
</script>
