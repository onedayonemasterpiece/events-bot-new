        heroImage.style.objectPosition = image.dataset.objectPosition || '50% 50%';
        const nextFit = image.dataset.protectedCropFit === 'cover' ? 'cover' : 'contain';
        heroImage.style.objectFit = nextFit;
        cleanRoot.dataset.heroRenderFit = nextFit;
        cleanRoot.dataset.selectedMediaPolicy = image.dataset.imageTextMode || 'unknown';
        const matchingThumbIndex = thumbButtons.findIndex((button) => button.dataset.src === src);
        thumbButtons.forEach((button, buttonIndex) => {
          const current = buttonIndex === matchingThumbIndex;
          button.setAttribute('aria-pressed', current ? 'true' : 'false');
          button.classList.toggle('is-current', current);
        });
        if (matchingThumbIndex >= 0) cleanRoot.dataset.activeHeroIndex = String(matchingThumbIndex);
        if (closedHeroOpener?.hasAttribute('data-hero-gallery-open')) {
          closedHeroOpener.dataset.heroGalleryIndex = String(next);
        }
        if (closedHeroOpener?.hasAttribute('data-efficient-viewer-open')) {
          closedHeroOpener.dataset.efficientViewerStart = slide.dataset.sourceIndex || '';
        }
        if (closedHeroStatus) closedHeroStatus.textContent = `Фото ${next + 1} из ${closedHeroSlides.length}`;
        updateOcrFrame();
        measureEditorialCrop();
        markRotation('waiting-idle');
      };

      let closedHeroHovered = false;
      mediaFrame?.addEventListener('pointerenter', () => { closedHeroHovered = true; });
      mediaFrame?.addEventListener('pointerleave', () => { closedHeroHovered = false; });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (document.body.classList.contains('has-hero-gallery-open')) return;
        if (efficientViewer && !efficientViewer.hidden) return;
        if (closedHeroSlides.length < 2 || !mediaFrame) return;
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('input,textarea,select,[contenteditable="true"],[role="textbox"]')) return;
        const heroFocused = document.activeElement instanceof Element && mediaFrame.contains(document.activeElement);
        if (!closedHeroHovered && !heroFocused) return;
        event.preventDefault();
        const current = Number(cleanRoot.dataset.activeHeroGalleryIndex || '0');
        void selectClosedHero(current + (event.key === 'ArrowRight' ? 1 : -1));
      });

      rotationToggle?.addEventListener('click', () => {
        if (rotationEnabled) {
          disableRotation('manual-toggle');
          return;
        }
        rotationEnabled = cleanRoot.dataset.autoRotate === 'true' && rotationButtons.length > 1 && !reducedMotion.matches;
        delete cleanRoot.dataset.autoRotateOptOut;
        noteRotationActivity('manual-toggle-resume');
        startRotationScheduler();
        void preloadRotationCandidates();
      });
      thumbButtons.forEach((button) => {
        button.addEventListener('pointerdown', () => noteRotationActivity('manual-rail-interaction'));
        button.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') noteRotationActivity('manual-rail-interaction');
        });
      });
      markRotation(rotationEnabled ? 'waiting-media' : 'disabled');

      const rotateNext = async () => {
        if (!rotationEnabled || rotationTransitioning || reducedMotion.matches || document.visibilityState !== 'visible' || !mediaFrame || !rotationButtons.length) return;
        const rect = mediaFrame.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;
        const nextButton = nextReadyRotationButton();
        if (!nextButton) {
          markRotation('waiting-media');
          return;
        }
        const nextIndex = thumbButtons.indexOf(nextButton);
        if (nextIndex < 0) return;
        rotationTransitioning = true;
        const transitionStartedAt = window.performance.now();
        markRotation('transitioning');
        try {
          await selectHero(nextIndex, 'auto');
        } finally {
          rotationTransitioning = false;
          const now = window.performance.now();
          nextRotationAt = lastRotationActivityAt > transitionStartedAt
            ? lastRotationActivityAt + 10_000
            : now + 8_000;
          markRotation('waiting-idle');
        }
      };

      const registerDecodedRotationSource = (src:string) => {
        if (!src) return;
        readyRotationSources.add(src);
        rotationPreloadRefs.delete(src);
        markRotation(window.performance.now() >= nextRotationAt ? 'ready' : 'waiting-idle');
      };

      const preloadRotationButton = (button:HTMLButtonElement) => {
        const src = button.dataset.src;
        if (!src || readyRotationSources.has(src)) return Promise.resolve(Boolean(src));
        const existing = rotationPreloadRefs.get(src);
        if (existing) {
          return existing.decode().then(() => true).catch(() => existing.complete && existing.naturalWidth > 0);
        }
        const probe = new Image();
        probe.decoding = 'async';
        probe.fetchPriority = 'low';
        rotationPreloadRefs.set(src, probe);
        const decoded = new Promise<boolean>((resolve) => {
          let settled = false;
          const finish = (ready:boolean) => {
            if (settled) return;
            settled = true;
            if (ready) registerDecodedRotationSource(src);
            else rotationPreloadRefs.delete(src);
            resolve(ready);
          };
          probe.addEventListener('load', () => finish(probe.naturalWidth > 0), { once:true });
          probe.addEventListener('error', () => finish(false), { once:true });
          probe.src = src;
          probe.decode().then(() => finish(probe.complete && probe.naturalWidth > 0)).catch(() => {
            if (probe.complete) finish(probe.naturalWidth > 0);
          });
        });
        return decoded;
      };

      const preloadRotationCandidates = async () => {
        if (rotationPreloadStarted || !rotationEnabled || reducedMotion.matches) return;
        rotationPreloadStarted = true;
        const activeThumb = thumbButtons[Number(cleanRoot.dataset.activeHeroIndex || '0')];
        const activeRotationIndex = rotationButtons.indexOf(activeThumb);
        const ordered = rotationButtons.map((_, offset) => rotationButtons[(activeRotationIndex + offset + 1) % rotationButtons.length]);
        if (activeThumb?.dataset.src && heroImage) {
          heroImage.decode().then(() => registerDecodedRotationSource(activeThumb.dataset.src || '')).catch(() => {});
        }
        for (const button of ordered) {
          if (!rotationEnabled || reducedMotion.matches) {
            rotationPreloadStarted = false;
            return;
          }
          const decode = preloadRotationButton(button);
          await Promise.race([decode, new Promise<boolean>((resolve) => window.setTimeout(() => resolve(false), 12_000))]);
        }
        rotationPreloadStarted = false;
      };

      const rotationTick = () => {
        if (!rotationEnabled || reducedMotion.matches) return;
        const now = window.performance.now();
        if (document.visibilityState !== 'visible') {
          nextRotationAt = now + 10_000;
          markRotation('page-hidden');
          return;
        }
        if (document.body.classList.contains('has-hero-gallery-open')) {
          lastRotationActivityAt = now;
          nextRotationAt = now + 10_000;
          markRotation('gallery-open');
          return;
        }
        if (!rotationReady) {
          markRotation('waiting-media');
          return;
        }
        if (now < nextRotationAt) {
          markRotation('waiting-idle');
          return;
        }
        void rotateNext();
      };

      function startRotationScheduler() {
        if (!rotationEnabled || rotationInterval) return;
        rotationInterval = window.setInterval(rotationTick, 500);
        rotationTick();
      }

      let activityThrottleUntil = 0;
      const recordFrequentActivity = (reason:string) => {
        const now = window.performance.now();
        if (now < activityThrottleUntil) return;
        activityThrottleUntil = now + 250;
        noteRotationActivity(reason);
      };
      document.addEventListener('pointermove', () => recordFrequentActivity('pointer-move'), { passive:true });
      document.addEventListener('pointerdown', () => noteRotationActivity('pointer-down'), { passive:true });
      document.addEventListener('wheel', () => recordFrequentActivity('wheel'), { passive:true });
      document.addEventListener('scroll', () => recordFrequentActivity('scroll'), { passive:true });
      document.addEventListener('keydown', () => noteRotationActivity('keyboard'));
      document.addEventListener('focusin', () => noteRotationActivity('focus'));
      document.addEventListener('visibilitychange', () => noteRotationActivity(document.visibilityState === 'visible' ? 'page-visible' : 'page-hidden'));
      window.setTimeout(() => { void preloadRotationCandidates(); }, 500);
      startRotationScheduler();

      let layoutFrame = 0;
      const layoutScrollMedia = () => {
        layoutFrame = 0;
        cleanRoot.querySelectorAll<HTMLElement>('[data-bento-tile]').forEach((tile) => {
          const image = tile.querySelector<HTMLImageElement>('img');
          if (!image?.naturalWidth || !image.naturalHeight) return;
          const ratio = image.naturalWidth / image.naturalHeight;
          const mode = tile.dataset.imageTextMode || 'unknown';
          let span = 'square';
          if (mode === 'visual_only' && ratio >= 1.3) span = 'wide';
          tile.dataset.bentoSpan = span;
          tile.dataset.naturalRatio = ratio.toFixed(4);
        });
        cleanRoot.querySelectorAll<HTMLElement>('[data-bento-grid]').forEach((grid) => {
          const style = getComputedStyle(grid);
          const columns = style.gridTemplateColumns.split(/\s+/u).filter(Boolean).length;
          const gap = Number.parseFloat(style.columnGap) || 0;
          const inlinePadding = (Number.parseFloat(style.paddingLeft) || 0) + (Number.parseFloat(style.paddingRight) || 0);
          const cell = columns > 0 ? (grid.clientWidth - inlinePadding - gap * (columns - 1)) / columns : 0;
          if (cell <= 0) return;
          grid.style.setProperty('--bento-cell', `${cell.toFixed(2)}px`);
          grid.dataset.bentoColumns = String(columns);
        });
        cleanRoot.querySelectorAll<HTMLElement>('[data-scroll-stage]').forEach((stage) => {
          const viewport = stage.querySelector<HTMLElement>('[data-slow-media-viewport]');
          const track = viewport?.querySelector<HTMLElement>('[data-slow-media-track]');
          const content = stage.querySelector<HTMLElement>('[data-scroll-content]');
          if (!viewport || !track || !content) return;
          content.style.removeProperty('min-height');
          stage.style.removeProperty('--scroll-stage-min-height');
          const speed = clamp(Number(track.dataset.slowMediaSpeed || '.5'), .2, .7);
          const overflow = Math.max(0, track.scrollHeight - viewport.clientHeight);
          const requiredHeight = Math.ceil(viewport.clientHeight + overflow / speed);
          const targetHeight = Math.max(content.scrollHeight, requiredHeight);
          stage.style.setProperty('--scroll-stage-min-height', `${targetHeight}px`);
          stage.dataset.mediaOverflow = overflow.toFixed(2);
          stage.dataset.mediaSpeed = speed.toFixed(2);
        });
        scheduleMotion();
      };
      const scheduleLayout = () => {
        if (layoutFrame) return;
        layoutFrame = window.requestAnimationFrame(layoutScrollMedia);
      };
      cleanRoot.querySelectorAll<HTMLImageElement>('[data-slow-media-track] img').forEach((image) => {
        if (!image.complete) image.addEventListener('load', scheduleLayout, { once:true });
      });

      const updateParallax = () => {
        frame = 0;
        cleanRoot.querySelectorAll<HTMLElement>('[data-desktop-parallax]').forEach((media) => {
          if (reducedMotion.matches) {
            media.style.setProperty('--desktop-parallax-y', '0px');
            media.style.removeProperty('transform');
            media.dataset.editorialMediaShift = '0.00';
            return;
          }
          const viewport = window.innerHeight || 800;
          const stage = media.closest<HTMLElement>('.desktop-prototype__stage');
          if (stage && cleanRoot.dataset.desktopFamily === 'editorial') {
            const rect = stage.getBoundingClientRect();
            const headerHeight = desktopHeaderHeight();
            const stageTravel = Math.max(0, headerHeight - rect.top);
            const motion = cleanRoot.dataset.editorialMotion || 'pinned';
            const scrollRange = Math.max(1, stage.offsetHeight - viewport + headerHeight);
            if (motion === 'continuous') {
              const maxShift = Math.max(0, stage.offsetHeight - media.offsetHeight);
              const shift = Math.min(maxShift, stageTravel * .35);
              media.style.transform = `translate3d(0,${shift.toFixed(2)}px,0)`;
              media.style.setProperty('--desktop-parallax-y', '0px');
              media.dataset.editorialMediaShift = shift.toFixed(2);
              stage.dataset.editorialMediaNetRatio = '.65';
            } else {
              media.style.removeProperty('transform');
              const image = media.querySelector<HTMLImageElement>('[data-clean-hero-image]');
              const availableBleed = Math.max(0, (image?.offsetHeight || media.offsetHeight) - media.clientHeight);
              // Start at the uncropped top edge and reveal virtually the whole lower overflow.
              const internalTravel = Math.min(240, availableBleed);
              const progress = clamp(stageTravel / scrollRange);
              const offset = -internalTravel * progress;
              media.style.setProperty('--desktop-parallax-y', `${offset.toFixed(1)}px`);
