  {photoCount > 0 && (
    <div class="hero-gallery" id={galleryId} data-hero-gallery data-desktop-gallery-dismiss="true" data-active-index="0" role="dialog" aria-modal="true" aria-labelledby={galleryTitleId} tabindex="-1" hidden>
      <div class="hero-gallery__chrome" aria-hidden="true"></div>
      <div class="hero-gallery__topbar">
        <a class="hero-gallery__brand" href={siteHomeHref()} aria-label="Перейти к афише Полюбить Калининград Анонсы"><AnnouncementsLockup variant="desktop" class="hero-gallery__lockup" /></a>
        <h2 id={galleryTitleId} class="sr-only">Фото события: {event.title}</h2>
        <button type="button" class="hero-gallery__close" data-hero-gallery-close aria-label="Закрыть просмотр фото">×</button>
      </div>
      <div class="hero-gallery__viewport">
        <div class="hero-gallery__track" data-hero-gallery-track>
          {galleryImages.map((image, index) => (
            <figure class="hero-gallery__slide" data-hero-gallery-slide data-gallery-slide-kind="image" data-gallery-index={index} data-source-index={image.sourceIndex} aria-hidden={index === 0 ? 'false' : 'true'}>
              <img class="hero-gallery__image" data-gallery-src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" data-image-text-mode={image.image_text_mode} data-media-role={image.media_role} data-media-semantic-status={image.media_semantic_status} data-desktop-gallery-fit={desktopGalleryFit(image)} data-protected-crop-fit={desktopGalleryFit(image)} data-protected-crop-reason={image.protected_crop_reason} data-source-index={image.sourceIndex} data-event-id={event.id} data-event-title={event.title} data-object-position={image.position} style={`object-fit:${desktopGalleryFit(image)};object-position:${image.position || '50% 50%'}`} />
              <figcaption class="sr-only">Фото события: {event.title}</figcaption>
            </figure>
