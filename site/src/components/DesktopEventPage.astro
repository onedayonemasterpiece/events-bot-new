          {viewerRecommendation && (
            <article class="hero-gallery__slide hero-gallery__slide--cta" data-hero-gallery-slide data-gallery-slide-kind="cta" data-gallery-index={galleryImages.length} aria-hidden="true">
              {viewerRecommendationImage && <img class="hero-gallery__cta-image" data-gallery-src={viewerRecommendationImage} alt="" loading="lazy" decoding="async" />}
              <div class="hero-gallery__cta-card">
                <span>Дальше можно похожее</span>
                <h2>{viewerRecommendation.title}</h2>
                {viewerRecommendationMeta && <p>{viewerRecommendationMeta}</p>}
                <a class="cta-button" href={eventHref(viewerRecommendation)}>Смотреть похожее</a>
              </div>
            </article>
          )}
        </div>
      </div>
      <div class="hero-gallery__caption" aria-hidden="true"><span>Фото события</span><strong>{event.title}</strong></div>
      {gallerySlideCount > 1 && <><button type="button" class="hero-gallery__nav hero-gallery__nav--prev" data-hero-gallery-prev aria-label="Предыдущее фото">‹</button><button type="button" class="hero-gallery__nav hero-gallery__nav--next" data-hero-gallery-next aria-label="Следующее фото или похожее событие">›</button></>}
      <div class="hero-gallery__counter" data-hero-gallery-counter role="status" aria-live="polite" aria-atomic="true">{`1 / ${gallerySlideCount}`}</div>
    </div>
  )}

  <script>
    import { resolveEditorialSideMotionGeometry } from '../lib/desktopEventPresentation';

    const cleanRoot = document.querySelector<HTMLElement>('[data-desktop-clean-event]');
    const desktopViewport = window.matchMedia('(min-width: 1024px)');
    if (cleanRoot && desktopViewport.matches) {
      document.body.classList.add('desktop-clean-event-page');
      const actionPanels = Array.from(cleanRoot.querySelectorAll<HTMLElement>('[data-desktop-action-panel]'));
      const actionPanelWidths = new WeakMap<HTMLElement, number>();
      const measureInlineActionPanel = (panel:HTMLElement) => {
        const panelRect = panel.getBoundingClientRect();
        const styles = getComputedStyle(panel);
        const leftLimit = panelRect.left + (Number.parseFloat(styles.paddingLeft) || 0) - 2;
        const rightLimit = panelRect.right - (Number.parseFloat(styles.paddingRight) || 0) + 2;
        const primary = panel.querySelector<HTMLElement>(':scope > .desktop-prototype__primary-action');
        const primaryLabel = primary?.querySelector<HTMLElement>('[data-desktop-primary-label], [data-calendar-label], [data-desktop-phone-label]');
        const actionRow = panel.querySelector<HTMLElement>(':scope > .desktop-prototype__action-row');
        const children = [
          panel.querySelector<HTMLElement>(':scope > p:first-child'),
          primary,
          actionRow,
        ].filter((item): item is HTMLElement => Boolean(item));
        const outside = children.some((item) => {
          const rect = item.getBoundingClientRect();
          return rect.left < leftLimit || rect.right > rightLimit;
        });
        const overlaps = children.some((item, index) => children.slice(index + 1).some((other) => {
          const first = item.getBoundingClientRect();
          const second = other.getBoundingClientRect();
          return Math.min(first.right, second.right) - Math.max(first.left, second.left) > 2;
        }));
        const primaryLabelDoesNotFit = (() => {
          if (!primary || !primaryLabel) return false;
          const primaryRect = primary.getBoundingClientRect();
          const labelRect = primaryLabel.getBoundingClientRect();
          const labelStyle = getComputedStyle(primaryLabel);
          const lineHeight = Number.parseFloat(labelStyle.lineHeight)
            || Number.parseFloat(labelStyle.fontSize)
            || 16;
          const wrapped = labelRect.height > lineHeight * 1.35;
          const clipped = labelRect.left < primaryRect.left - 1
            || labelRect.right > primaryRect.right + 1
            || primaryLabel.scrollWidth > primaryLabel.clientWidth + 1;
          return wrapped || clipped;
        })();
        const overflows = panel.scrollWidth > panel.clientWidth + 1
          || Boolean(primary && primary.scrollWidth > primary.clientWidth + 2)
          || Boolean(actionRow && actionRow.scrollWidth > actionRow.clientWidth + 2);
        return !(outside || overlaps || primaryLabelDoesNotFit || overflows);
      };
      const fitActionPanel = (panel:HTMLElement, force = false) => {
        const width = panel.getBoundingClientRect().width;
        const previousWidth = actionPanelWidths.get(panel);
        if (!force && previousWidth !== undefined && Math.abs(previousWidth - width) < .5) return;
        actionPanelWidths.set(panel, width);
        const splitFamily = panel.dataset.actionFamily === 'split';
        // The component family chooses the intended composition. Only Split
        // attempts the accepted one-row geometry; Editorial keeps the tall
        // three-row card. Measure actual rendered children before allowing the
        // Split row so dynamic labels/counters can still fail closed.
        panel.dataset.actionFit = splitFamily ? 'measuring' : 'stacked';
        panel.dataset.actionLayout = splitFamily ? 'inline' : 'stacked';
        panel.dataset.actionDensity = 'comfortable';
        if (!splitFamily) return;
        if (measureInlineActionPanel(panel)) {
          panel.dataset.actionFit = 'comfortable';
          return;
        }

        // Preserve the compact Split hierarchy before giving up its one-row
        // composition: both secondary utilities become icon controls first
        // (share already is one; the calendar label is hidden synchronously),
        // then the real children are measured again.
        panel.dataset.actionDensity = 'compact';
        if (measureInlineActionPanel(panel)) {
          panel.dataset.actionFit = 'icons';
          return;
        }

        panel.dataset.actionLayout = 'stacked';
        panel.dataset.actionFit = 'stacked';
      };
      actionPanels.forEach((panel) => {
        fitActionPanel(panel, true);
        new ResizeObserver(() => fitActionPanel(panel)).observe(panel);
        new MutationObserver(() => fitActionPanel(panel, true)).observe(panel, {
          childList:true,
          characterData:true,
          subtree:true,
        });
      });
      const refitActionPanels = () => actionPanels.forEach((panel) => fitActionPanel(panel, true));
      window.requestAnimationFrame(refitActionPanels);
      window.addEventListener('load', refitActionPanels, { once:true });
      document.fonts?.ready.then(refitActionPanels);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mediaFrame = cleanRoot.querySelector<HTMLElement>('[data-media-frame]');
      const heroImage = cleanRoot.querySelector<HTMLImageElement>('[data-clean-hero-image]');
      const thumbButtons = Array.from(cleanRoot.querySelectorAll<HTMLButtonElement>('[data-clean-hero-thumb]'));
      const closedHeroGallery = cleanRoot.dataset.closedHeroGallery
        ? document.getElementById(cleanRoot.dataset.closedHeroGallery)
        : null;
      const closedHeroSlides = Array.from(closedHeroGallery?.querySelectorAll<HTMLElement>('[data-hero-gallery-slide][data-gallery-slide-kind="image"]') || []);
      const closedHeroStatus = cleanRoot.querySelector<HTMLElement>('[data-closed-hero-status]');
      const closedHeroOpener = heroImage?.closest<HTMLElement>('.desktop-prototype__media-opener');
      const rotationButtons = thumbButtons.filter((button) => button.dataset.rotationEligible === 'true' && Boolean(button.dataset.src));
      const rotationToggle = cleanRoot.querySelector<HTMLButtonElement>('[data-hero-rotation-toggle]');
      const siteHeader = document.querySelector<HTMLElement>('.site-header');
      let frame = 0;
      let imageRequest = 0;
      let rotationEnabled = cleanRoot.dataset.autoRotate === 'true' && rotationButtons.length > 1 && !reducedMotion.matches;
      let rotationReady = false;
      let rotationInterval = 0;
      let rotationTransitioning = false;
      let rotationPreloadStarted = false;
      let lastRotationActivityAt = window.performance.now();
      let nextRotationAt = lastRotationActivityAt + 10_000;
      const readyRotationSources = new Set<string>();
      const rotationPreloadRefs = new Map<string, HTMLImageElement>();

      const clamp = (value:number, min=0, max=1) => Math.max(min, Math.min(max, value));
      const desktopHeaderHeight = () => {
        const measured = siteHeader?.getBoundingClientRect().height || 0;
        const token = Number.parseFloat(getComputedStyle(cleanRoot).getPropertyValue('--desktop-header-height')) || 57;
        return Math.max(1, measured || token);
      };
      const syncDesktopHeaderToken = () => cleanRoot.style.setProperty('--desktop-header-height', `${desktopHeaderHeight().toFixed(2)}px`);
      syncDesktopHeaderToken();
      const activateRailThumbnail = (item:HTMLElement) => {
        const image = item.querySelector<HTMLImageElement>('img[data-rail-thumbnail]');
        if (!image || image.dataset.railThumbnailActivated === 'true') return;
        const src = image.dataset.thumbnailSrc || '';
        const srcset = image.dataset.thumbnailSrcset || '';
        image.dataset.railThumbnailActivated = 'true';
        if (srcset) image.setAttribute('srcset', srcset);
        if (src) image.src = src;
      };
      const responsiveRails = Array.from(cleanRoot.querySelectorAll<HTMLElement>('[data-responsive-rail]'));
      const layoutResponsiveRail = (rail:HTMLElement) => {
        const allItems = Array.from(rail.querySelectorAll<HTMLButtonElement>('[data-responsive-rail-item]'));
        const more = rail.querySelector<HTMLButtonElement>('[data-responsive-rail-more]');
        if (!more || !allItems.length || !rail.clientWidth) return;
        const validItems = allItems.filter((item) => {
          const image = item.querySelector<HTMLImageElement>('img');
          const failed = Boolean(image?.dataset.railThumbnailActivated === 'true' && image.complete && !image.naturalWidth);
          item.toggleAttribute('data-media-failed', failed);
          return !failed;
        });
        allItems.forEach((item) => { item.hidden = !validItems.includes(item); });
        more.hidden = true;
        const gap = 8;
        const minCell = 72;
        const capacity = Math.max(2, Math.floor((rail.clientWidth + gap) / (minCell + gap)));
        const visibleCount = validItems.length > capacity ? capacity - 1 : validItems.length;
        validItems.forEach((item, index) => { item.hidden = index >= visibleCount; });
        validItems.slice(0, visibleCount).forEach(activateRailThumbnail);
        if (validItems.length > visibleCount) {
          const firstHidden = validItems[visibleCount];
          const remaining = validItems.length - visibleCount;
          more.hidden = false;
          more.dataset.heroGalleryOpen = firstHidden.dataset.heroGalleryOpen || '';
          more.dataset.heroGalleryIndex = firstHidden.dataset.heroGalleryIndex || '0';
          more.dataset.remainingCount = String(remaining);
          more.setAttribute('aria-label', `Открыть ещё ${remaining} фото`);
          const count = more.querySelector<HTMLElement>('[data-responsive-rail-count]');
          if (count) count.textContent = `+${remaining}`;
        }
        const columns = visibleCount + (more.hidden ? 0 : 1);
        rail.style.setProperty('--rail-columns', String(Math.max(1, columns)));
        rail.dataset.railVisibleCount = String(visibleCount);
        rail.dataset.railHiddenCount = String(Math.max(0, validItems.length - visibleCount));
      };
      responsiveRails.forEach((rail) => {
        const images = Array.from(rail.querySelectorAll<HTMLImageElement>('img'));
        images.forEach((image) => {
          image.addEventListener('load', () => layoutResponsiveRail(rail), { once:true });
          image.addEventListener('error', () => layoutResponsiveRail(rail), { once:true });
        });
        layoutResponsiveRail(rail);
        new ResizeObserver(() => layoutResponsiveRail(rail)).observe(rail);
      });

