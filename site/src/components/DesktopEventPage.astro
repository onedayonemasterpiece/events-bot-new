---
import Icon from './Icon.astro';
import OptimizedEventCardGrid from './OptimizedEventCardGrid.astro';
import EventMediaRail, { type EventMediaRailItem } from './EventMediaRail.astro';
import EventTokenMedallions from './EventTokenMedallions.astro';
import EventParticipants from './EventParticipants.astro';
import EventOccurrenceNav from './EventOccurrenceNav.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import EventFallbackArt from './EventFallbackArt.astro';
import DesktopEventActionPanel from './DesktopEventActionPanel.astro';
import EventQuestionCta from './EventQuestionCta.astro';
import EventTransportSchedule from './EventTransportSchedule.astro';
import EventBusTransportSchedule from './EventBusTransportSchedule.astro';
import KaupTransportSchedule from './KaupTransportSchedule.astro';
import AnnouncementsLockup from './brand/AnnouncementsLockup.astro';
import type { EventImageAsset, EventImageDerivative, EventImageMediaRole, PreviewEvent } from '../lib/types';
import type { OccurrencePresentation } from '../lib/eventOccurrences';
import templateContract from '../data/eventTemplateContract.json';
import {
  displayDateTime,
  eventDetailRelatedAlgorithmId,
  eventHref,
  getOccurrencePresentation,
  siteHomeHref,
  withBase,
} from '../lib/events';
import { eventImageUrl } from '../lib/assets';
import { desktopEventWithExplicitEnd } from '../lib/desktopEventTransport';
import { selectEventMediaByQuality } from '../lib/eventMediaQuality';
import { resolveEventFallbackArt } from '../lib/eventFallbackArt';
import { eventBreadcrumbParents } from '../lib/breadcrumbs';

type Candidate = 'editorial' | 'split';
type MediaPolicy = 'non-ocr' | 'ocr';
type EditorialMotion = 'pinned' | 'continuous';
type EditorialCropPolicy = 'bounded-cover' | 'bottom-safe';
type OcrCompanionLayout = 'separate' | 'arrival';
type SplitMediaFit = 'natural' | 'viewport-cover' | 'viewport-contain';
type RelatedMediaTreatment = 'cover' | 'ambient' | 'hybrid';

interface Props {
  event: PreviewEvent;
  related: PreviewEvent[];
  candidate: Candidate;
  mediaPolicy: MediaPolicy;
  transport?: boolean;
  heroImageIndex?: number;
  heroWidth?: number;
  heroHeight?: number;
  heroObjectPosition?: string;
  editorialRail?: boolean;
  editorialMotion?: EditorialMotion;
  editorialCropPolicy?: EditorialCropPolicy;
  ocrCompanionImageIndex?: number;
  ocrCompanionLayout?: OcrCompanionLayout;
  autoRotate?: boolean;
  ocrSafeCover?: boolean;
  ocrSourceIndexes?: number[];
  duplicateSourceIndexes?: number[];
  splitMediaFit?: SplitMediaFit;
  splitPortraitViewer?: boolean;
  splitPortraitSourceIndexes?: number[];
  splitViewerHiddenSourceIndexes?: number[];
  relatedMediaTreatment?: RelatedMediaTreatment;
  mediaRoleOverrides?: Record<number, EventImageMediaRole>;
  mediaDimensionOverrides?: Record<number, { width: number; height: number }>;
  surface?: 'lab' | 'production';
  presentationReason?: string;
  showTransport?: boolean;
  occurrencePresentation?: OccurrencePresentation;
}

type GalleryImage = {
  src: string;
  alt: string;
  image_text_mode: EventImageAsset['image_text_mode'];
  width?: number;
  height?: number;
  position?: string;
  sourceIndex?: number;
  media_role: EventImageMediaRole;
  media_semantic_status?: EventImageAsset['media_semantic_status'];
  recommended_hero_fit?: EventImageAsset['recommended_hero_fit'];
  safe_crop?: boolean;
  thumbnail_sources?: EventImageDerivative[];
  protected_crop_fit?: 'contain' | 'cover';
  protected_crop_reason?: string;
};

const {
  event,
  related,
  candidate,
  mediaPolicy,
  transport = false,
  heroImageIndex = 0,
  heroWidth,
  heroHeight,
  heroObjectPosition,
  editorialRail = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  editorialMotion = 'pinned',
  editorialCropPolicy = 'bounded-cover',
  ocrCompanionImageIndex,
  ocrCompanionLayout = 'separate',
  autoRotate = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  ocrSafeCover = false,
  ocrSourceIndexes = [],
  duplicateSourceIndexes = [],
  splitMediaFit = 'natural',
  splitPortraitViewer = false,
  splitPortraitSourceIndexes = [],
  splitViewerHiddenSourceIndexes = [],
  relatedMediaTreatment = 'hybrid',
  mediaRoleOverrides = {},
  mediaDimensionOverrides = {},
  surface = 'lab',
  presentationReason = 'lab-fixture',
  showTransport = false,
  occurrencePresentation,
} = Astro.props;
const resolvedOccurrencePresentation = occurrencePresentation || getOccurrencePresentation(event);
const forcedOcrSourceIndexes = new Set(ocrSourceIndexes);
const hiddenDuplicateSourceIndexes = new Set(duplicateSourceIndexes);
// Historical review fixtures predate the LLM media-role export. Keep this fallback
// inside the noindex desktop lab only; production routing remains role-first/fail-closed.
const relatedWithRoles = surface === 'lab' ? related.map((item) => item.image_media_role
  ? item
  : ({ ...item, image_media_role:item.image_text_mode === 'visual_only' ? 'event_photo' : 'unknown_document' } as PreviewEvent)) : related;
const heroAlt = event.image_alt || `Афиша события «${event.title}»`;
const rawAssets = event.image_assets || [];
const qualitySelection = surface === 'production'
  ? selectEventMediaByQuality(rawAssets)
  : { admittedSourceIndexes:rawAssets.map((_asset, index) => index), hiddenSourceIndexes:[] };
const qualityAdmittedSourceIndexSet = new Set(qualitySelection.admittedSourceIndexes);
const preferredAsset = rawAssets[heroImageIndex] || rawAssets[0];
const preferredUrl = eventImageUrl(preferredAsset?.src || event.image_url) || preferredAsset?.src || event.image_url || '';
const typedFallbackArt = preferredUrl ? null : resolveEventFallbackArt(event);
const preferredWidth = heroWidth || preferredAsset?.width || 1600;
const preferredHeight = heroHeight || preferredAsset?.height || 1000;
const ratio = preferredWidth / preferredHeight;
const failClosedImageTextMode = (
  mode: EventImageAsset['image_text_mode'] | PreviewEvent['image_text_mode'] | null | undefined,
  semanticStatus: EventImageAsset['media_semantic_status'] | null | undefined,
): EventImageAsset['image_text_mode'] => {
  if (semanticStatus === 'error') return 'unknown';
  return mode === 'ocr_text' || mode === 'visual_only' ? mode : 'unknown';
};
const preferredImageTextMode = forcedOcrSourceIndexes.has(heroImageIndex)
  ? 'ocr_text'
  : failClosedImageTextMode(
      preferredAsset?.image_text_mode || event.image_text_mode,
      preferredAsset?.media_semantic_status,
    );
// The desktop stage/gallery is a carousel surface: every non-OCR image fills
// it. OCR/document media stays whole; missing bbox metadata may never demote a
// classified non-OCR photo to letterboxed contain.
const preferredCrop = preferredImageTextMode === 'visual_only'
  ? { fit:'cover' as const, objectPosition:heroObjectPosition || preferredAsset?.recommended_object_position || '50% 50%', reason:'visual_only_gallery_fill' }
  : { fit:'contain' as const, objectPosition:'50% 50%', reason:'document_media' };
const preferredPosition = preferredCrop.fit === 'cover' ? preferredCrop.objectPosition : '50% 50%';
const heroContainStyle = preferredCrop.fit === 'contain'
  ? 'object-fit:contain !important;object-position:center !important;transform:none !important;margin:0 !important;'
  : undefined;
const selectedMediaMode = preferredImageTextMode;
const selectedHeroIsOcr = selectedMediaMode !== 'visual_only';
const selectedHeroMustContain = selectedHeroIsOcr || preferredCrop.fit !== 'cover';
const effectiveSplitMediaFit: SplitMediaFit = selectedMediaMode === 'visual_only'
  ? 'viewport-cover'
  : (splitMediaFit === 'viewport-cover' ? 'viewport-contain' : splitMediaFit);
const fallbackMediaRole = (
  semanticStatus?: EventImageAsset['media_semantic_status'],
  classifiedRole?: EventImageAsset['media_role'],
): EventImageMediaRole => semanticStatus === 'classified' && classifiedRole
  ? classifiedRole
  : 'unknown_document';
const mediaRoleLabel = (role: EventImageMediaRole) => ({
  event_identity_poster: 'Афиша',
  attendee_information: 'Полезная информация',
  program_or_schedule: 'Расписание',
  wayfinding: 'Карта',
  sponsor_or_brand: 'Партнёры',
  event_photo: '',
  unknown_document: '',
}[role]);
const mediaRoleAction = (role: EventImageMediaRole) => ({
  event_identity_poster: 'Открыть афишу',
  attendee_information: 'Открыть полезную информацию',
  program_or_schedule: 'Открыть расписание',
  wayfinding: 'Открыть карту',
  sponsor_or_brand: 'Открыть информацию о партнёрах',
  event_photo: 'Открыть фото',
  unknown_document: 'Открыть изображение',
}[role]);

const galleryImages = (() => {
  const out: GalleryImage[] = [];
  const seen = new Set<string>();
  const add = (asset: EventImageAsset | null | undefined, fallbackMode: PreviewEvent['image_text_mode'], sourceIndex?: number) => {
    const src = eventImageUrl(asset?.src) || asset?.src || '';
    if (!src || seen.has(src) || src.includes('files.catbox.moe')) return;
    seen.add(src);
    const imageTextMode = sourceIndex !== undefined && forcedOcrSourceIndexes.has(sourceIndex)
      ? 'ocr_text'
      : failClosedImageTextMode(asset?.image_text_mode || fallbackMode, asset?.media_semantic_status);
    const dimensions = sourceIndex === undefined ? undefined : mediaDimensionOverrides[sourceIndex];
    const crop = imageTextMode === 'visual_only'
      ? { fit:'cover' as const, objectPosition:asset?.recommended_object_position || '50% 50%', reason:'visual_only_gallery_fill' }
      : { fit:'contain' as const, objectPosition:'50% 50%', reason:'document_media' };
    out.push({
      src,
      alt: asset?.alt || heroAlt,
      image_text_mode: imageTextMode,
      // Production exports can temporarily carry `unknown_document/pending`
      // after Smart Update while the LLM media-role pass is still catching up.
      // `visual_only` is sufficient for photo-style rail/rotation treatment,
      // but never for promoting an asset to the semantic poster companion.
      // A classified role always wins and poster semantics remain fail-closed.
      media_role: (sourceIndex === undefined ? undefined : mediaRoleOverrides[sourceIndex])
        || (asset?.media_semantic_status === 'classified' ? asset.media_role : undefined)
        || fallbackMediaRole(asset?.media_semantic_status, asset?.media_role),
      media_semantic_status:asset?.media_semantic_status,
      recommended_hero_fit:asset?.recommended_hero_fit,
      safe_crop:asset?.safe_crop,
      width: dimensions?.width || asset?.width,
      height: dimensions?.height || asset?.height,
      position: crop.fit === 'cover' ? crop.objectPosition : '50% 50%',
      sourceIndex,
      thumbnail_sources: asset?.thumbnail_sources,
      protected_crop_fit: crop.fit,
      protected_crop_reason: crop.reason,
    });
  };
  if (preferredAsset) add(preferredAsset, event.image_text_mode, heroImageIndex);
  else if (event.image_url) {
    const src = eventImageUrl(event.image_url) || event.image_url;
    seen.add(src);
    out.push({ src, alt: heroAlt, image_text_mode: event.image_text_mode, media_role: event.image_media_role || 'unknown_document', width: preferredWidth, height: preferredHeight });
  }
  rawAssets.forEach((asset, index) => {
    if (qualityAdmittedSourceIndexSet.has(index)) add(asset, event.image_text_mode, index);
  });
  return out.slice(0, 12);
})();
const galleryId = `clean-hero-gallery-${event.id}`;
const galleryTitleId = `${galleryId}-title`;
const closedHeroStatusId = `closed-hero-status-${event.id}`;
const photoCount = galleryImages.length;
const indexedGalleryImages = galleryImages.map((image, galleryIndex) => ({ image, galleryIndex }));
const ocrCompanion = ocrCompanionImageIndex === undefined
  ? undefined
  : indexedGalleryImages.find(({ image }) => image.sourceIndex === ocrCompanionImageIndex);
const editorialRailCandidates = indexedGalleryImages.filter(({ image, galleryIndex }) => galleryIndex !== ocrCompanion?.galleryIndex && !hiddenDuplicateSourceIndexes.has(image.sourceIndex ?? -1));
const editorialRailImages = editorialRailCandidates;
// Gallery keeps every source rendition so its source indexes remain stable. The compact rail,
// however, only advertises distinct media identities supplied by the upstream/lab contract.
const portraitSourceIndexSet = new Set(splitPortraitSourceIndexes);
const splitHiddenSourceIndexSet = new Set(splitViewerHiddenSourceIndexes);
const splitRailCandidates = indexedGalleryImages.filter(({ image, galleryIndex }) => galleryIndex !== 0
  && !hiddenDuplicateSourceIndexes.has(image.sourceIndex ?? -1)
  && (!splitPortraitViewer || !splitHiddenSourceIndexSet.has(image.sourceIndex ?? -1)));
const splitViewerImages = splitPortraitSourceIndexes.length > 0
  ? indexedGalleryImages.filter(({ image }) => portraitSourceIndexSet.has(image.sourceIndex ?? -1))
  : indexedGalleryImages.filter(({ image }) => !hiddenDuplicateSourceIndexes.has(image.sourceIndex ?? -1));
const companionPreviewCandidates = editorialRailCandidates.filter(({ galleryIndex }) => galleryIndex !== 0);
const viewerRecommendation = related[0];
const gallerySlideCount = photoCount + (viewerRecommendation ? 1 : 0);
const viewerRecommendationImage = viewerRecommendation ? eventImageUrl(viewerRecommendation.image_url) || viewerRecommendation.image_url : null;
const viewerRecommendationMeta = viewerRecommendation
  ? [displayDateTime(viewerRecommendation), viewerRecommendation.venue_name || viewerRecommendation.city].filter(Boolean).join(' · ')
  : '';
const desktopTransportEvent = desktopEventWithExplicitEnd(event);
const desktopGalleryFit = (image: GalleryImage) => image.image_text_mode === 'visual_only' ? 'cover' : 'contain';
// Rotation advances only through `data-rotation-eligible` non-OCR slides. An
// OCR companion in the same gallery must not disable the photo carousel or be
// cropped merely to make rotation possible.
const effectiveAutoRotate = autoRotate && galleryImages.filter((image) => image.image_text_mode === 'visual_only').length > 1;
const railAspectBucket = (image: GalleryImage) => {
  const imageRatio = image.width && image.height ? image.width / image.height : 1;
  if (imageRatio < .9) return 'portrait';
  if (imageRatio > 1.18) return 'landscape';
  return 'square';
};
const railAspectValue = (image: GalleryImage) => Math.min(2.2, Math.max(.38, image.width && image.height ? image.width / image.height : 1));
const railThumbnailSources = (image: GalleryImage) => [...(image.thumbnail_sources || [])].sort((left, right) => left.width - right.width);
const railThumbnail = (image: GalleryImage) => railThumbnailSources(image)[0]?.src || image.src;
const railThumbnailSrcset = (image: GalleryImage) => railThumbnailSources(image).map((item) => `${item.src} ${item.width}w`).join(', ');
const railThumbnailWidth = (image: GalleryImage) => railThumbnailSources(image)[0]?.width || image.width || 160;
const railThumbnailHeight = (image: GalleryImage) => railThumbnailSources(image)[0]?.height || image.height || 100;
const splitRailSlotWidth = (image: GalleryImage) => Math.round(Math.max(88, Math.min(196, 112 * railAspectValue(image))));
const railFrameKind = (image: GalleryImage): EventMediaRailItem['kind'] => {
  if (image.media_semantic_status === 'error') return 'unknown';
  if (image.image_text_mode === 'visual_only') return 'visual';
  if (image.image_text_mode === 'ocr_text') return 'document';
  return 'unknown';
};
const toRailItem = (
  { image, galleryIndex }: { image: GalleryImage; galleryIndex: number },
  variant: 'hero-selector' | 'poster-strip',
): EventMediaRailItem => {
  const fit = desktopGalleryFit(image);
  return {
    src:image.src,
    thumbnailSrc:railThumbnail(image),
    thumbnailSrcset:railThumbnailSrcset(image) || undefined,
    thumbnailWidth:railThumbnailWidth(image),
    thumbnailHeight:railThumbnailHeight(image),
    width:image.width,
    height:image.height,
    alt:image.alt,
    galleryIndex,
    sourceIndex:image.sourceIndex,
    imageTextMode:image.image_text_mode,
    mediaRole:image.media_role,
    kind:railFrameKind(image),
    fit,
    objectPosition:image.position || '50% 50%',
    cropReason:image.protected_crop_reason || (fit === 'cover' ? 'desktop_visual_cover' : 'desktop_document_contain'),
    roleLabel:mediaRoleLabel(image.media_role),
    actionLabel:variant === 'poster-strip'
      ? (splitPortraitViewer
          ? `Открыть быстрый просмотр с изображения ${galleryIndex + 1}`
          : `${mediaRoleAction(image.media_role)}, изображение ${galleryIndex + 1}`)
      : `${mediaRoleAction(image.media_role)} ${galleryIndex + 1} в полноэкранной галерее`,
    rotationEligible:fit === 'cover' && image.image_text_mode === 'visual_only',
    railAspect:railAspectBucket(image),
    railRatio:railAspectValue(image),
    slotWidth:splitRailSlotWidth(image),
  };
};
const heroRailItems = editorialRailImages.map((item) => toRailItem(item, 'hero-selector'));
const splitRailItems = splitRailCandidates.map((item) => toRailItem(item, 'poster-strip'));
// Companion-board previews still lazy-swap their source outside EventMediaRail.
const transparentRailPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';
const usesLongFlow = true;

const dateTimeLabel = displayDateTime(event);
const addressLabel = event.address || event.city || 'Адрес уточняется';
const admissionLabel = event.ticket.is_free ? 'Бесплатно' : (event.ticket.price_label || 'Билеты');
// The page owns the section heading; source descriptions occasionally repeat it.
// Remaining source headings are lowered one semantic level so they cannot compete with the event H1.
const descriptionHtml = (event.description_html || '')
  .replace(/<h([2-6])[^>]*>\s*О событии[^<]*<\/h\1>/giu, '')
  .replace(/<(\/?)h([2-5])([^>]*)>/giu, (_match, closing, level, attrs) => closing
    ? `</h${Number(level) + 1}>`
    : `<h${Number(level) + 1}${attrs}>`);
---

<main
  class:list={['desktop-clean-event', `desktop-clean-event--${candidate}`, `desktop-clean-event--${mediaPolicy}`, selectedHeroIsOcr ? 'desktop-clean-event--hero-ocr' : 'desktop-clean-event--hero-photo']}
  data-desktop-clean-event
  data-ds-family="DesktopEventDetailSurface"
  data-ds-version="1"
  data-ds-variant={candidate}
  data-ds-state={`${mediaPolicy} ${photoCount > 0 ? 'media' : 'fallback'}`}
  data-event-template-contract={templateContract.contract_id}
  data-event-template-source={templateContract.accepted_source_sha}
  data-desktop-family={candidate}
  data-media-policy={mediaPolicy}
  data-selected-media-policy={selectedMediaMode}
  data-selected-media-role={preferredAsset?.media_role}
  data-selected-media-semantic-status={preferredAsset?.media_semantic_status}
  data-hero-render-fit={selectedHeroMustContain ? 'contain' : 'cover'}
  data-editorial-motion={candidate === 'editorial' ? editorialMotion : undefined}
  data-editorial-crop={candidate === 'editorial' ? editorialCropPolicy : undefined}
  data-ocr-companion-layout={ocrCompanion ? ocrCompanionLayout : undefined}
  data-split-media-fit={candidate === 'split' ? effectiveSplitMediaFit : undefined}
  data-split-efficient-viewer={splitPortraitViewer ? 'true' : undefined}
  data-related-media-treatment={relatedMediaTreatment}
  data-auto-rotate={effectiveAutoRotate ? 'true' : 'false'}
  data-closed-hero-gallery={photoCount > 1 ? galleryId : undefined}
  data-active-hero-gallery-index={photoCount > 1 ? '0' : undefined}
  data-event-id={event.id}
  data-event-surface={surface}
  data-presentation-reason={presentationReason}
  data-presentation-fallback={typedFallbackArt?.kind}
  style={`--image-ratio:${ratio};--image-position:${preferredPosition};--media-count:${Math.max(1, photoCount)};`}
>
  <div class="desktop-clean-reading-shell">
  <article class:list={['desktop-prototype', 'desktop-prototype--clean', `desktop-prototype--${candidate}`, `desktop-prototype--${mediaPolicy}`]} data-clean-hero>
    <div class="desktop-prototype__canvas">
      <section
        class="desktop-prototype__stage"
        data-scroll-stage={usesLongFlow ? '' : undefined}
        data-scroll-kind={candidate}
        aria-labelledby={`clean-event-title-${event.id}`}
      >
        {candidate === 'split' ? (
          <figure class="desktop-prototype__media desktop-prototype__media--poster-scroll" data-media-frame data-slow-media-viewport data-split-media-fit={effectiveSplitMediaFit}>
            <div class="desktop-poster-track" data-slow-media-track data-slow-media-speed="0.36">
              {preferredUrl ? (
                <button
                  type="button"
                  class="desktop-prototype__media-opener"
                  data-efficient-viewer-open={splitPortraitViewer ? '' : undefined}
                  data-efficient-viewer-start={splitPortraitViewer ? String(galleryImages[0]?.sourceIndex ?? 'gallery-0') : undefined}
                  data-hero-gallery-open={splitPortraitViewer ? undefined : galleryId}
                  data-hero-gallery-index="0"
                  aria-describedby={photoCount > 1 ? closedHeroStatusId : undefined}
                  aria-keyshortcuts={photoCount > 1 ? 'ArrowLeft ArrowRight' : undefined}
                  aria-label={splitPortraitViewer ? `Открыть быстрый просмотр всех изображений события «${event.title}»` : `${mediaRoleAction(galleryImages[0]?.media_role || 'unknown_document')} события «${event.title}» на весь экран`}
                >
                  <img class="desktop-prototype__media-image" data-clean-hero-image src={preferredUrl} alt={heroAlt} width={preferredWidth} height={preferredHeight} fetchpriority="high" decoding="async" data-protected-crop-fit={preferredCrop.fit} data-protected-crop-reason={preferredCrop.reason} style={heroContainStyle} />
                </button>
              ) : typedFallbackArt ? (
                <EventFallbackArt event={event} surface="desktop" />
              ) : (
                <div class="desktop-prototype__generic-fallback" aria-hidden="true"><span>{event.event_type || 'событие'}</span><strong>{event.title}</strong></div>
              )}
              <EventMediaRail
                variant="poster-strip"
                items={splitRailItems}
                galleryId={galleryId}
                eventTitle={event.title}
                splitPortraitViewer={splitPortraitViewer}
              />
            </div>
          </figure>
        ) : (
          <figure class="desktop-prototype__media" data-media-frame data-ocr-safe-cover={ocrSafeCover ? 'true' : 'false'} data-desktop-parallax={selectedHeroMustContain ? undefined : ''} data-editorial-media>
            {preferredUrl && (
              <button type="button" class="desktop-prototype__media-opener" data-hero-gallery-open={galleryId} data-hero-gallery-index="0" aria-describedby={photoCount > 1 ? closedHeroStatusId : undefined} aria-keyshortcuts={photoCount > 1 ? 'ArrowLeft ArrowRight' : undefined} aria-label={`Открыть фотографии события «${event.title}» на весь экран`}>
                <img class="desktop-prototype__media-image" data-clean-hero-image src={preferredUrl} alt={heroAlt} width={preferredWidth} height={preferredHeight} fetchpriority="high" decoding="async" data-protected-crop-fit={preferredCrop.fit} data-protected-crop-reason={preferredCrop.reason} style={heroContainStyle} />
              </button>
            )}
            {!preferredUrl && (typedFallbackArt
              ? <EventFallbackArt event={event} surface="desktop" />
              : <div class="desktop-prototype__generic-fallback" aria-hidden="true"><span>{event.event_type || 'событие'}</span><strong>{event.title}</strong></div>)}
            {photoCount > 0 && !(editorialRail && editorialRailImages.length > 1) && ocrCompanionLayout !== 'arrival' && <button type="button" class="desktop-prototype__photo-count" data-hero-gallery-open={galleryId} data-hero-gallery-index="0" aria-label={`Открыть ${photoCount} фото события на весь экран`}><Icon name="image" /><span>{photoCount > 1 ? `${photoCount} фото` : 'Открыть фото'}</span></button>}
          </figure>
        )}

        <p id={closedHeroStatusId} class="sr-only" data-closed-hero-status role="status" aria-live="polite" aria-atomic="true">{photoCount > 1 ? `Фото 1 из ${photoCount}` : ''}</p>

        {candidate === 'editorial' && (
          <aside class="desktop-editorial-side" data-editorial-side data-companion-arrival={ocrCompanionLayout === 'arrival' ? 'true' : undefined}>
            {editorialRail && editorialRailImages.length > 1 && ocrCompanionLayout !== 'arrival' && (
              <EventMediaRail
                variant="hero-selector"
                items={heroRailItems}
                galleryId={galleryId}
                eventTitle={event.title}
              />
            )}
            <DesktopEventActionPanel event={event} shareImage={preferredUrl} shareImageTextMode={selectedMediaMode} className="desktop-prototype__action--side" family="editorial" />
            {ocrCompanion && ocrCompanionLayout === 'separate' && (
              <button
                type="button"
                class="desktop-editorial-companion"
                style={`--ocr-ratio:${(ocrCompanion.image.width || 800) / (ocrCompanion.image.height || 1200)};`}
                data-editorial-ocr-companion
                data-media-role={ocrCompanion.image.media_role}
                data-source-index={ocrCompanion.image.sourceIndex}
                data-hero-gallery-open={galleryId}
                data-hero-gallery-index={ocrCompanion.galleryIndex}
                aria-label={`${mediaRoleAction(ocrCompanion.image.media_role)} события на весь экран`}
              >
                <span class="desktop-editorial-companion__image">
                  <img src={ocrCompanion.image.src} alt="" width={ocrCompanion.image.width || 800} height={ocrCompanion.image.height || 1200} loading="lazy" decoding="async" />
                </span>
              </button>
            )}
            {ocrCompanion && ocrCompanionLayout === 'arrival' && (
              <section
                class="desktop-editorial-companion-board"
                style={`--ocr-ratio:${(ocrCompanion.image.width || 800) / (ocrCompanion.image.height || 1200)};`}
