---
import './design-system/product-contour-foundations.css';
import { withBase } from '../lib/events';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside
  class:list={['focus-thanks', compact && 'focus-thanks--compact']}
  data-ds-family="FocusGroupThankYou"
  data-ds-version="1"
  data-ds-variant={compact ? 'compact' : 'default'}
  data-ds-state="informational"
  data-ke-foundation-consumer="focus-thank-you"
  aria-labelledby="focus-thanks-title"
>
  <div class="focus-thanks__partner">
    <p class="focus-thanks__eyebrow">Партнёр благодарности</p>
    <picture>
      <source srcset={withBase('/assets/partners/act-opus.webp')} type="image/webp" />
      <img
        src={withBase('/assets/partners/act-opus.png')}
        width="900"
        height="230"
        loading="lazy"
        decoding="async"
        alt="Акт Опус — партнёр благодарности"
      />
    </picture>
  </div>
  <div class="focus-thanks__copy">
    <p class="focus-thanks__eyebrow">Спасибо за участие</p>
    <h2 id="focus-thanks-title">Один приз — два билета в театр</h2>
    <p>
      В проектируемой механике основной результат — доля собранной коллекции
      пасхалок. Затем учитывается ограниченная широта исследования: ответ NPS,
      лайки и дизлайки, текстовая обратная связь, поиск и сохранения.
    </p>
    <p class="focus-thanks__notice">
      <strong>Правила готовятся.</strong> Сейчас действия не начисляют
      конкурсные баллы и не создают право на билеты. Значение NPS, позитивность,
      длина текста и повторные действия не дают преимущества; критический ответ
      и дизлайк учитываются наравне с положительными сигналами.
    </p>
  </div>
</aside>

<style>
  .focus-thanks {
    display: grid;
    grid-template-columns: var(--ke-focus-thanks-partner-column) minmax(0, 1fr);
    gap: var(--ke-focus-thanks-gap);
    align-items: center;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-focus-thanks-border);
    border-radius: var(--ke-focus-thanks-radius);
    padding: var(--ke-focus-thanks-padding);
    background:
      radial-gradient(circle at 0 0, var(--ke-color-focus-thanks-marker-glow), transparent var(--ke-focus-thanks-marker-fade)),
      var(--ke-color-focus-thanks-surface);
    color: var(--ke-color-focus-thanks-text);
    box-shadow: var(--ke-elevation-focus-thanks);
    font-family: var(--ke-font-family-sans);
  }

  .focus-thanks__partner {
    min-width: 0;
    display: grid;
    gap: var(--ke-focus-thanks-partner-gap);
    justify-items: start;
  }

  .focus-thanks picture {
    width: min(100%, var(--ke-focus-thanks-logo-max));
    display: block;
  }

  .focus-thanks img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .focus-thanks__eyebrow {
    margin: 0;
    color: var(--ke-color-action-primary-hover);
    font-size: var(--ke-focus-thanks-eyebrow-size);
    font-weight: var(--ke-focus-thanks-eyebrow-weight);
    letter-spacing: var(--ke-focus-thanks-eyebrow-letter);
    text-transform: uppercase;
  }

  .focus-thanks h2 {
    margin: var(--ke-focus-thanks-heading-margin);
    color: var(--ke-color-text-primary);
    font-size: var(--ke-focus-thanks-heading-size);
    line-height: var(--ke-focus-thanks-heading-line);
    letter-spacing: var(--ke-focus-thanks-heading-letter);
  }

  .focus-thanks p:not(.focus-thanks__eyebrow) {
    max-width: var(--ke-focus-thanks-copy-max);
    margin: 0;
    line-height: var(--ke-focus-thanks-copy-line);
  }

  .focus-thanks__notice {
    margin-top: var(--ke-focus-thanks-notice-margin-top) !important;
    border-left: var(--ke-focus-thanks-notice-border) solid var(--ke-color-focus-thanks-marker);
    padding-left: var(--ke-focus-thanks-notice-padding-left);
    color: var(--ke-color-text-muted);
    font-size: var(--ke-focus-thanks-notice-size);
  }

  .focus-thanks--compact {
    grid-template-columns: var(--ke-focus-thanks-compact-partner-column) minmax(0, 1fr);
  }

  @media (max-width: 680px) {
    .focus-thanks,
    .focus-thanks--compact {
      grid-template-columns: 1fr;
    }

    .focus-thanks picture {
      width: min(var(--ke-focus-thanks-mobile-logo-viewport), var(--ke-focus-thanks-mobile-logo-max));
    }
  }
</style>