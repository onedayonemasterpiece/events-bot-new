---
import { Image } from 'astro:assets';
import SemanticIcon from './design-system/SemanticIcon.astro';
import './design-system/product-contour-foundations.css';
import { displayDateValue } from '../lib/events';
import { interestClubHref } from '../lib/clubs';
import { getInterestClubCover } from '../data/interest-club-covers';
import type { InterestClub } from '../lib/types';

interface Props {
  club: InterestClub;
}

const { club } = Astro.props;
const place = [club.city, club.typical_venue].filter(Boolean).join(' · ');
const activityLabel = `${club.activity.distinct_date_count} ${club.activity.distinct_date_count === 1 ? 'дата' : club.activity.distinct_date_count < 5 ? 'даты' : 'дат'} в каталоге`;
const clubHref = interestClubHref(club);
const cover = getInterestClubCover(club.slug);
const titleId = `club-card-title-${club.id}`;
---
<article
  class="club-card"
  data-ds-family="InterestClubCard"
  data-ds-version="1"
  data-ds-variant="photographic-catalog-card"
  data-ds-state={cover ? 'cover-ready' : 'fallback-art'}
  data-ke-foundation-consumer="interest-club-card"
  data-club-card
  data-club-name={club.name}
  data-cover-state={cover ? 'ready' : 'fallback'}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby="club-catalog-keyboard-instructions"
  aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End Enter"
>
  <div class="club-card__media">
    <div class="club-card__fallback" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    {cover && (
      <Image
        class="club-card__cover"
        data-club-cover
        src={cover.image}
        alt={cover.alt}
        widths={[480, 720, 960]}
        sizes="(max-width: 760px) calc(100vw - 24px), (max-width: 1180px) 50vw, 580px"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="club-card__veil" aria-hidden="true"></div>
  </div>
  {club.activity.future_meeting_count > 0 && (
    <span
      class="club-card__future club-card__future--desktop"
      data-club-future-badge="desktop"
    >
      Ближайших встреч: {club.activity.future_meeting_count}
    </span>
  )}

  <div class="club-card__content">
    <div class="club-card__head">
      <p class="club-card__topic">{club.topic}</p>
      {club.activity.future_meeting_count > 0 && (
        <span
          class="club-card__future club-card__future--mobile"
          data-club-future-badge="mobile"
        >
          Ближайших встреч: {club.activity.future_meeting_count}
        </span>
      )}
    </div>
    <h2 id={titleId}><a href={clubHref} data-club-primary-action>{club.name}</a></h2>
    {club.description && <p class="club-card__description">{club.description}</p>}
    <dl class="club-card__facts">
      {place && <div><dt>Где</dt><dd>{place}</dd></div>}
      <div><dt>Активность</dt><dd>{activityLabel}</dd></div>
      <div><dt>Наблюдаем</dt><dd>{displayDateValue(club.activity.first_observed_date)} — {displayDateValue(club.activity.last_observed_date)}</dd></div>
    </dl>
    <div class="club-card__footer">
      <span class="club-card__keyboard-hint" aria-hidden="true"><kbd>← ↑ ↓ →</kbd><kbd>Enter</kbd></span>
      <a class="club-card__link" href={clubHref} aria-label={`Подробнее о клубе «${club.name}»`}>
        Подробнее <SemanticIcon name="arrow-right" role="inline" /><kbd aria-hidden="true">Enter</kbd>
      </a>
    </div>
  </div>
</article>

<style>
  .club-card {
    position: relative;
    display: grid;
    align-items: end;
    min-width: 0;
    min-height: clamp(28rem, 43vw, 34rem);
    overflow: hidden;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-club-card-border);
    border-radius: var(--ke-club-card-radius);
    background: var(--ke-color-club-card-surface);
    color: var(--ke-color-club-card-text);
    box-shadow: var(--ke-elevation-club-card);
    isolation: isolate;
    outline: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  .club-card:hover { transform: translateY(-3px); box-shadow: var(--ke-elevation-club-card-hover); }
  .club-card__media,
  .club-card__fallback,
  .club-card__cover,
  .club-card__veil { position:absolute; inset:0; width:100%; height:100%; }
  .club-card__media { z-index:-1; overflow:hidden; }
  .club-card__cover { object-fit:cover; object-position:center 48%; }
  .club-card__fallback {
    overflow:hidden;
    background:
      radial-gradient(circle at 25% 18%, var(--ke-color-club-card-fallback-gold-glow), transparent 27%),
      radial-gradient(circle at 80% 24%, var(--ke-color-club-card-fallback-teal-glow), transparent 25%),
      linear-gradient(145deg, var(--ke-color-club-card-fallback-start) 0%, var(--ke-color-club-card-fallback-middle) 45%, var(--ke-color-club-card-fallback-end) 100%);
  }
  .club-card__fallback::before {
    content:"";
    position:absolute;
    width:18rem;
    height:18rem;
    right:-4rem;
    top:1rem;
    border:1px solid var(--ke-color-club-card-fact-line-compact);
    border-radius:50%;
    box-shadow:0 0 0 2.5rem rgba(255,255,255,.035), 0 0 0 5rem rgba(255,255,255,.025);
  }
  .club-card__fallback span {
    position:absolute;
    width:5rem;
    height:5rem;
    border:1px solid rgba(255,255,255,.3);
    border-radius:20px;
    transform:rotate(45deg);
  }
  .club-card__fallback span:nth-child(1) { top:18%; left:15%; }
  .club-card__fallback span:nth-child(2) { top:31%; left:34%; width:2.6rem; height:2.6rem; }
  .club-card__fallback span:nth-child(3) { top:13%; right:16%; width:3.3rem; height:3.3rem; }
  .club-card__veil {
    background:
      linear-gradient(180deg, var(--ke-color-club-card-veil-top) 8%, var(--ke-color-club-card-veil-middle) 42%, var(--ke-color-club-card-veil-bottom) 100%),
      linear-gradient(90deg, var(--ke-color-club-card-veil-side), transparent 65%);
  }
  .club-card[data-cover-state="fallback"] .club-card__cover { display:none; }
  .club-card__content {
    display:grid;
    gap:.8rem;
    width:100%;
    min-width:0;
    padding:clamp(1.1rem,2.4vw,1.65rem);
  }
  .club-card__head { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; }
  .club-card__topic { margin:0; color:var(--ke-color-club-card-topic); font-size:.82rem; font-weight:850; letter-spacing:.055em; text-transform:uppercase; }
  .club-card__future {
    flex:0 0 auto;
    padding:.3rem .62rem;
    border:var(--ke-shape-border-hairline) solid var(--ke-color-club-card-future-line);
    border-radius:var(--ke-shape-radius-pill);
    background:var(--ke-color-club-card-future-surface);
    color:var(--ke-color-club-card-future-text);
    font-size:.76rem;
    font-weight:900;
    white-space:nowrap;
  }
  .club-card__future--desktop {
    position:absolute;
    z-index:2;
    top:1.2rem;
    right:1.2rem;
    padding:.46rem .78rem;
    border-color:var(--ke-color-club-card-future-desktop-line);
    background:linear-gradient(180deg,var(--ke-color-club-card-future-desktop-start),var(--ke-color-club-card-future-desktop-end));
    box-shadow:var(--ke-elevation-club-future);
    pointer-events:none;
  }
  .club-card__future--desktop::after {
    content:"";
    position:absolute;
    z-index:-1;
    top:calc(100% - .12rem);
    right:5%;
    left:5%;
    height:1.75rem;
    border-radius:50%;
    background:radial-gradient(ellipse at top,var(--ke-color-club-card-future-glow-start),var(--ke-color-club-card-future-glow-middle) 34%,var(--ke-color-club-card-future-glow-end) 62%,transparent 80%);
    filter:blur(5px);
    mix-blend-mode:screen;
    pointer-events:none;
  }
  .club-card__future--mobile { display:none; }
  h2 { margin:0; font-size:clamp(1.55rem,3vw,2.15rem); line-height:1.08; text-wrap:balance; }
  h2 a { min-height:var(--ke-size-touch-target); display:inline-flex; align-items:center; color:inherit; text-decoration:none; }
  h2 a:hover { text-decoration:underline; }
  .club-card__description { max-width:55ch; margin:0; color:var(--ke-color-club-card-copy); line-height:1.48; }
  .club-card__facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin:.15rem 0 0; border-top:var(--ke-shape-border-hairline) solid var(--ke-color-club-card-fact-line); }
  .club-card__facts div { min-width:0; padding:.6rem .65rem 0 0; }
  .club-card__facts div + div { padding-left:.65rem; border-left:var(--ke-shape-border-hairline) solid rgba(255,255,255,.24); }
  dt { color:var(--ke-color-club-card-fact-label); font-size:.76rem; }
  dd { min-width:0; margin:.1rem 0 0; overflow-wrap:anywhere; font-size:.88rem; font-weight:760; line-height:1.35; }
  .club-card__footer { display:flex; align-items:center; justify-content:space-between; gap:.75rem; min-height:var(--ke-size-touch-target); }
  .club-card__link { min-width:0; min-height:var(--ke-size-touch-target); display:inline-flex; align-items:center; gap:.42rem; margin-left:auto; color:var(--ke-color-club-card-link); font-weight:900; text-decoration:none; }
  .club-card__link:hover { color:var(--ke-color-club-card-link-hover); text-decoration:underline; }
  .club-card__keyboard-hint,
  .club-card__link kbd {
    display:inline-flex;
    gap:.3rem;
    visibility:hidden;
    opacity:0;
    pointer-events:none;
    transition:opacity 140ms ease;
  }
  kbd {
    min-width:24px;
    padding:.2rem .38rem;
    border:1px solid currentColor;
    border-radius:6px;
    font:800 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;
    text-align:center;
  }
  @media (min-width: 1024px) {
    .club-card:focus-visible {
      outline:3px solid var(--ke-color-club-card-focus);
      outline-offset:5px;
      transform:translateY(-3px);
      box-shadow:var(--ke-elevation-club-card-focus);
    }
    .club-card:focus-visible .club-card__keyboard-hint,
    .club-card__link:focus-visible kbd { visibility:visible; opacity:.72; }
  }
  @media (prefers-reduced-motion: reduce) {
    .club-card,
    .club-card__keyboard-hint,
    .club-card__link kbd { transition:none; }
    .club-card:hover,
    .club-card:focus-visible { transform:none; }
  }
  @media (max-width: 760px) {
    .club-card {
      min-height:28rem;
      box-shadow:var(--ke-elevation-club-card-mobile);
    }
    .club-card:hover { transform:none; box-shadow:var(--ke-elevation-club-card-mobile); }
    .club-card__content { padding:1.05rem; }
    .club-card__future--desktop { top:1rem; right:1rem; }
  }
  @media (max-width: 430px) {
    .club-card { border-radius:var(--ke-club-card-radius-mobile); }
    .club-card__head { display:grid; }
    .club-card__future { width:max-content; }
    .club-card__facts { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .club-card__facts div { padding:.55rem .55rem 0 0; }
    .club-card__facts div + div { padding-left:.55rem; }
    .club-card__facts div:nth-child(3) { padding-left:0; border-top:var(--ke-shape-border-hairline) solid var(--ke-color-club-card-fact-line-compact); border-left:0; }
    .club-card__footer { justify-content:flex-end; }
  }
</style>
