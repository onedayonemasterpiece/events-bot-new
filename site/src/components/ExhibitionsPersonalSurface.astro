    .ex-row__dot { top:.55rem; left:calc(-17.5px - .65rem); width:14px; height:14px; box-shadow:var(--ke-elevation-exhibitions-rail-dot-mobile); }
    .ex-row__rail span:last-child { text-align:right; }
