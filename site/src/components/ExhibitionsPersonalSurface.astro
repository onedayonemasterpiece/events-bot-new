      if (event.defaultPrevented) return;
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest('input,textarea,select,[contenteditable="true"]')) return;
      if (target?.closest('.site-footer')) return;
      if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && !root.querySelector('[data-gallery][open]')) {
        event.preventDefault();
        focusAdjacentRow(event.key === 'ArrowDown' ? 1 : -1);
        return;
      }
      if (hasCommandModifier(event) || event.repeat || event.isComposing || target?.closest('button')) return;
      const command = commandFrom(event,modeCommandByCode,modeCommandByKey);
      if (command === 'personal') { event.preventDefault(); switchMode('personal',true); }
      if (command === 'all') { event.preventDefault(); switchMode('all',true); }
    });

    const dialog = root.querySelector('[data-gallery]');
    const galleryImage = root.querySelector('[data-gallery-image]');
    const galleryMedia = root.querySelector('[data-gallery-media]');
    const galleryTitle = root.querySelector('[data-gallery-heading]');
    const galleryCount = root.querySelector('[data-gallery-count]');
    const gallerySkeleton = root.querySelector('[data-gallery-skeleton]');
    const galleryError = root.querySelector('[data-gallery-error]');
    let galleryImages = []; let galleryIndex = 0; let galleryOpener = null; let galleryCloseTimer = 0; let galleryRequestId = 0;
    const renderGallery = () => {
      if (!(galleryImage instanceof HTMLImageElement) || !(galleryMedia instanceof HTMLElement)) return;
      const src = galleryImages[galleryIndex];
      if (!src) return;
      const requestId = ++galleryRequestId;
      galleryMedia.dataset.imageState = 'loading';
      galleryMedia.setAttribute('aria-busy','true');
      galleryImage.hidden = true;
      if (gallerySkeleton instanceof HTMLElement) gallerySkeleton.hidden = false;
      if (galleryError instanceof HTMLElement) galleryError.hidden = true;
      galleryImage.alt = galleryTitle instanceof HTMLElement ? `${galleryTitle.textContent}, фото ${galleryIndex+1}` : `Фото ${galleryIndex+1}`;
      if (galleryCount instanceof HTMLElement) galleryCount.textContent = `${galleryIndex+1} из ${galleryImages.length}`;
      const finish = (state) => {
        if (requestId !== galleryRequestId) return;
        galleryMedia.dataset.imageState = state;
        galleryMedia.setAttribute('aria-busy','false');
        if (gallerySkeleton instanceof HTMLElement) gallerySkeleton.hidden = true;
        if (state === 'loaded') {
          galleryImage.hidden = false;
          if (!reducedMotion.matches) galleryImage.animate([{ opacity:.35, transform:'translate3d(10px,0,0) scale(.992)' },{ opacity:1, transform:'translate3d(0,0,0) scale(1)' }],{ duration:240, easing:'cubic-bezier(.16,1,.3,1)' });
        } else {
          galleryImage.hidden = true;
          if (galleryError instanceof HTMLElement) galleryError.hidden = false;
        }
      };
      galleryImage.onload = () => finish('loaded');
      galleryImage.onerror = () => finish('error');
      galleryImage.src = src;
      if (galleryImage.complete) finish(galleryImage.naturalWidth > 0 ? 'loaded' : 'error');
    };
    const openGallery = (opener,row) => {
      if (!(dialog instanceof HTMLDialogElement) || !(opener instanceof HTMLElement)) return;
      if (compactDeck.matches) return;
      try { galleryImages = JSON.parse(opener.dataset.galleryImages || '[]'); } catch { galleryImages = []; }
      if (!galleryImages.length) return;
      galleryIndex = 0; galleryOpener = opener;
      window.clearTimeout(galleryCloseTimer);
      dialog.classList.remove('is-closing');
      if (galleryTitle instanceof HTMLElement) galleryTitle.textContent = opener.dataset.galleryTitle || '';
      renderGallery(); dialog.showModal(); markSeen(row);
      root.querySelector('[data-gallery-close]')?.focus();
    };
    const closeGallery = () => {
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;
      if (reducedMotion.matches) { dialog.close(); return; }
      dialog.classList.add('is-closing');
      window.clearTimeout(galleryCloseTimer);
      galleryCloseTimer = window.setTimeout(() => { if (dialog.open) dialog.close(); }, 240);
    };
    root.querySelector('[data-gallery-close]')?.addEventListener('click',closeGallery);
    root.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>{ galleryIndex=(galleryIndex-1+galleryImages.length)%galleryImages.length; renderGallery(); });
    root.querySelector('[data-gallery-next]')?.addEventListener('click',()=>{ galleryIndex=(galleryIndex+1)%galleryImages.length; renderGallery(); });
    dialog?.addEventListener('close',()=>{ dialog.classList.remove('is-closing'); if (galleryOpener instanceof HTMLElement) galleryOpener.focus(); });
    dialog?.addEventListener('keydown',(event)=>{
      if (event.key === 'ArrowLeft') { event.preventDefault(); galleryIndex=(galleryIndex-1+galleryImages.length)%galleryImages.length; renderGallery(); }
      if (event.key === 'ArrowRight') { event.preventDefault(); galleryIndex=(galleryIndex+1)%galleryImages.length; renderGallery(); }
      if (event.key === 'Escape') { event.preventDefault(); closeGallery(); }
    });
    dialog?.addEventListener('click',(event)=>{ if (event.target === dialog) closeGallery(); });

    syncActionState(); syncFilters(); scheduleDeckLayout();
  })();
</script>
