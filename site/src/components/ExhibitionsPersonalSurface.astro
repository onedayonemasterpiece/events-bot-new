    .ex-deck { inline-size:100%; max-inline-size:100%; block-size:clamp(160px,48vw,228px); cursor:pointer; }
    .ex-deck__medallion { top:7px; left:7px; width:44px; height:44px; }
    .ex-deck__count { left:0; }
    .ex-row__body { grid-area:body; }
    .ex-row__aside { grid-area:aside; align-content:start; }
    .ex-row__actions { align-items:start; }
    .ex-row__expanded { opacity:1; transform:none; }
    .ex-row__social { font-size:.72rem; }
    .ex-tail-callout { align-items:stretch; flex-direction:column; }
    .ex-tail-toggle,.ex-tail-more { width:100%; }
    .ex-tail-controls { align-items:stretch; flex-direction:column; }
    .ex-gallery { width:100%; height:100dvh; max-height:none; margin:0; border:0; border-radius:0; }
    .ex-gallery__stage { min-height:calc(100dvh - 150px); grid-template-columns:48px 1fr 48px; }
    .ex-gallery__media { height:calc(100dvh - 150px); }
    .ex-row__hidden { flex-direction:column; padding:1rem; }
    .ex-row__hidden button { position:static; }
