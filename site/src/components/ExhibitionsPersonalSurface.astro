---
import './design-system/product-contour-foundations.css';
import ExhibitionPrototypeRow from './ExhibitionPrototypeRow.astro';
import SemanticIcon from './design-system/SemanticIcon.astro';
import type { ExhibitionPersonalProjection } from '../lib/exhibitionsPersonal';

interface Props {
  projection: ExhibitionPersonalProjection;
  kicker?: string;
}

const { projection, kicker = 'Калининградская область · актуальная афиша' } = Astro.props;
const { items, newItems, priorityItems, tailItems } = projection;
const endingSoonCount = priorityItems.filter((item) => item.lifecycle === 'ending').length;
const endingSoonLabel = endingSoonCount === 1 ? 'скоро закроется' : 'скоро закроются';
const newLabel = newItems.length === 1 ? 'новая' : 'новых';
---

<main
  id="main"
  class="ex-page"
  data-ds-family="ExhibitionsPersonalSurface"
  data-ds-version="2"
  data-ds-variant="ranked-personal-catalog"
  data-ds-state={newItems.length + priorityItems.length + tailItems.length > 0 ? 'personal all-topics populated' : 'personal all-topics empty'}
    data-ke-foundation-consumer="exhibitions-personal-surface"
  data-exhibitions-prototype
>
    <a class="ex-skip" href="#exhibition-results">К списку выставок</a>

    <div class="ex-shell" id="top">
      <section class="ex-intro" aria-labelledby="exhibition-heading">
        <div>
          <p class="ex-kicker">{kicker}</p>
          <h1 id="exhibition-heading">Выставки</h1>
          <p class="ex-lead">Сначала — новое, недавно открывшееся и важное. Старые долгие выставки не мешают быстрому выбору.</p>
        </div>
        <div class="ex-intro__summary" aria-label="Сводка раздела">
          <span><strong data-visible-count>{items.length}</strong> выставок</span>
          <span><strong>{newItems.length}</strong> {newLabel}</span>
          <span><strong>{endingSoonCount}</strong> {endingSoonLabel}</span>
        </div>
      </section>

      <section class="ex-controls" aria-label="Настройка списка">
        <div class="ex-mode" role="radiogroup" aria-label="Режим подборки" data-mode-switch>
          <button type="button" role="radio" aria-checked="true" data-mode="personal" tabindex="0">Для меня <kbd aria-hidden="true">F</kbd></button>
          <button type="button" role="radio" aria-checked="false" data-mode="all" tabindex="-1">Все <kbd aria-hidden="true">A</kbd></button>
        </div>
        <p class="ex-personal-note" data-personal-note><strong>Начните с 2–3 оценок.</strong> Пока профиль пуст, «Для меня» показывает новое и общее главное.</p>
        <div class="ex-controls__end">
          <div class="ex-categories" aria-label="Фильтры по теме">
            {['Все темы', 'Искусство', 'История', 'Фотография'].map((category, index) => (
              <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-category-filter={category}>{category}</button>
            ))}
          </div>
          <button type="button" class="ex-help-open" data-help-toggle aria-expanded="false" aria-controls="keyboard-help">
            <span>Клавиши</span><kbd>?</kbd>
          </button>
        </div>
      </section>

      <aside class="ex-keyboard-help" id="keyboard-help" data-keyboard-help hidden aria-labelledby="keyboard-help-title">
        <div>
          <p class="ex-kicker">Навигация без мышки</p>
          <h2 id="keyboard-help-title">Быстро просмотрите список</h2>
        </div>
        <ul>
          <li><kbd>↑</kbd><kbd>↓</kbd><span>между выставками</span></li>
          <li><kbd>←</kbd><kbd>→</kbd><span>листать фото выбранной выставки</span></li>
          <li><kbd>Enter</kbd><span>открыть выставку</span></li>
          <li><kbd>G</kbd><span>открыть фото</span></li>
          <li><kbd>L</kbd><span>нравится</span></li>
          <li><kbd>X</kbd><span>не интересно</span></li>
          <li><kbd>F</kbd><kbd>A</kbd><span>«Для меня» / «Все»</span></li>
        </ul>
      </aside>

      <section id="exhibition-results" class="ex-results" aria-label="Выставки" data-results tabindex="-1">
        <section class="ex-group ex-group--new" aria-labelledby="new-heading" data-new-group>
          <div class="ex-group__heading">
            <div>
              <p class="ex-group__eyebrow">Быстрый разбор</p>
              <h2 id="new-heading">Новое для вас</h2>
              <p>Поставьте лайк, отметьте «не интересно» или откройте — и новинка уйдёт из красного счётчика.</p>
            </div>
            <button
              type="button"
              class="ex-mark-seen"
              data-mark-new-seen
              aria-label="Снять отметку «Новое» со всех новых выставок. Карточки останутся в списке."
            >Снять «новое» у всех</button>
          </div>
          <div class="ex-list" data-list-section="new">
            {newItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={index} />)}
          </div>
        </section>

        <section class="ex-group" aria-labelledby="priority-heading">
          <div class="ex-group__heading">
            <div>
              <p class="ex-group__eyebrow">После нового</p>
              <h2 id="priority-heading">Стоит увидеть</h2>
              <p>Смешиваем общий интерес, обсуждения, недавнее открытие и честную срочность закрытия.</p>
            </div>
            <div class="ex-legend" aria-label="Обозначения статусов">
              <span class="is-recent"><i aria-hidden="true"></i> недавно открылась</span>
              <span class="is-ending"><i aria-hidden="true"></i> скоро закроется</span>
              <span class="is-popular"><i aria-hidden="true"></i> популярное</span>
            </div>
          </div>
          <div class="ex-list" data-list-section="priority">
            {priorityItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={newItems.length + index} />)}
          </div>
        </section>

        <section class="ex-group ex-group--tail" aria-labelledby="tail-heading">
          <div class="ex-tail-callout">
            <div>
              <p class="ex-group__eyebrow">Длинный хвост</p>
              <h2 id="tail-heading">Давно идут</h2>
              <p>Эти выставки всё ещё актуальны, но не поднимаются выше только из-за долгой даты.</p>
            </div>
            <button type="button" class="ex-tail-toggle" data-tail-toggle aria-expanded="false" aria-controls="old-exhibitions">Показать 4 из {tailItems.length}</button>
          </div>
          <div id="old-exhibitions" class="ex-list" data-list-section="tail" hidden>
            {tailItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={newItems.length + priorityItems.length + index} />)}
          </div>
          <div class="ex-tail-controls" data-tail-controls hidden>
            <p data-tail-status role="status" aria-live="polite">Показаны 0 из {tailItems.length}</p>
            <button type="button" class="ex-tail-more" data-tail-more>Показать ещё 4</button>
          </div>
        </section>

        <div class="ex-empty" data-empty hidden>
          <h2>Здесь пока пусто</h2>
          <p>Выберите «Все» или верните одну из скрытых выставок. Новые оценки сразу уточняют подборку в этом браузере.</p>
          <button type="button" data-empty-all>Показать все</button>
        </div>
      </section>
    </div>

    <dialog class="ex-gallery" data-gallery data-app-lower-surface="media" data-app-lower-lifecycle="persistent" aria-labelledby="gallery-title">
      <div class="ex-gallery__bar">
        <div><p>Фотографии выставки</p><h2 id="gallery-title" data-gallery-heading></h2></div>
        <button type="button" data-gallery-close aria-label="Закрыть галерею">Закрыть <kbd aria-hidden="true">Esc</kbd></button>
      </div>
      <div class="ex-gallery__stage">
        <button type="button" data-gallery-prev aria-label="Предыдущее фото"><SemanticIcon name="arrow-left" role="control" /></button>
        <div class="ex-gallery__media" data-gallery-media data-image-state="idle" aria-busy="false">
          <img data-gallery-image alt="" width="1280" height="900" hidden />
          <span class="ex-gallery__skeleton" data-gallery-skeleton aria-hidden="true" hidden></span>
          <p class="ex-gallery__error" data-gallery-error role="status" hidden>Не удалось загрузить фото.</p>
        </div>
        <button type="button" data-gallery-next aria-label="Следующее фото"><SemanticIcon name="arrow-right" role="control" /></button>
      </div>
      <p class="ex-gallery__count" data-gallery-count aria-live="polite"></p>
    </dialog>
    <div class="ex-live" data-live>
      <span data-live-message role="status" aria-live="polite" aria-atomic="true"></span>
      <button type="button" data-live-undo hidden>Отменить</button>
    </div>
    <p class="ex-deck-live" data-deck-live role="status" aria-live="polite" aria-atomic="true"></p>
  </main>

<style is:global>
  .ex-page a:focus-visible, .ex-page button:focus-visible { outline:var(--ke-exhibitions-focus-width) solid var(--ke-color-exhibitions-blue); outline-offset:var(--ke-exhibitions-focus-offset); }
  .ex-page { min-height:100dvh; padding:0; overflow-x:clip; background:radial-gradient(circle at 52% -14%,var(--ke-color-exhibitions-blue-glow),transparent 35rem),radial-gradient(circle at 8% 34%,var(--ke-color-exhibitions-orange-glow),transparent 28rem),var(--ke-color-exhibitions-background); color:var(--ke-color-exhibitions-text); font-size:var(--ke-exhibitions-page-font-size); line-height:var(--ke-exhibitions-page-line); }
  .ex-page button,.ex-page a { touch-action:manipulation; }
  .ex-skip { position:fixed; z-index:var(--ke-exhibitions-skip-layer); top:.8rem; left:.8rem; transform:translateY(-160%); padding:.75rem 1rem; border-radius:6px; background:var(--ke-color-exhibitions-text); color:var(--ke-color-exhibitions-background); font-weight:800; }
  .ex-skip:focus { transform:translateY(0); }
  .ex-help-open { min-height:44px; display:flex; align-items:center; gap:.55rem; border:1px solid var(--ke-color-exhibitions-border); border-radius:6px; padding:.45rem .75rem; background:var(--ke-color-exhibitions-surface); color:var(--ke-color-exhibitions-text); font:inherit; font-weight:750; cursor:pointer; }
  .ex-page kbd { min-width:1.6rem; min-height:1.5rem; display:inline-flex; align-items:center; justify-content:center; padding:.08rem .32rem; border:1px solid var(--ke-color-exhibitions-kbd-line); border-bottom-color:var(--ke-color-exhibitions-kbd-line-strong); border-radius:4px; background:var(--ke-color-exhibitions-kbd-surface); color:var(--ke-color-exhibitions-kbd-text); font:700 .72rem/1 ui-monospace,SFMono-Regular,Consolas,monospace; box-shadow:0 1px 0 var(--ke-color-exhibitions-kbd-shadow); }
  .ex-shell { width:min(var(--ke-exhibitions-shell-max),calc(100% - var(--ke-exhibitions-shell-gutter))); margin:0 auto; padding:var(--ke-exhibitions-shell-padding-start) 0 var(--ke-exhibitions-shell-padding-end); }
  .ex-intro { display:flex; align-items:end; justify-content:space-between; gap:2rem; padding-bottom:2rem; border-bottom:1px solid var(--ke-color-exhibitions-border); }
  .ex-kicker,.ex-group__eyebrow { margin:0 0 .45rem; color:var(--ke-color-exhibitions-blue); font-size:.72rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; }
  .ex-intro h1 { margin:0; font:var(--ke-type-h1); letter-spacing:var(--ke-type-h1-letter); }
  .ex-lead { max-width:58ch; margin:1rem 0 0; color:var(--ke-color-exhibitions-muted); font-size:clamp(1rem,1.5vw,1.2rem); }
  .ex-intro__summary { flex:0 0 auto; display:grid; grid-template-columns:repeat(3,auto); gap:1px; border:1px solid var(--ke-color-exhibitions-border); border-radius:6px; overflow:hidden; background:var(--ke-color-exhibitions-border); }
  .ex-intro__summary span { min-width:var(--ke-exhibitions-summary-item-min-width); display:grid; gap:.12rem; padding:.78rem 1rem; background:var(--ke-color-exhibitions-surface); color:var(--ke-color-exhibitions-muted); font-size:.75rem; }
  .ex-intro__summary strong { color:var(--ke-color-exhibitions-text); font-size:1.24rem; }
  .ex-controls { position:sticky; z-index:30; top:var(--ke-site-header-bar-height); display:grid; grid-template-columns:auto 1fr auto; gap:1rem; align-items:center; min-height:var(--ke-exhibitions-controls-min-height); margin-bottom:1rem; padding:.75rem 0; border-bottom:1px solid var(--ke-color-exhibitions-border); background:var(--ke-color-exhibitions-sticky-surface); backdrop-filter:blur(16px); }
  .ex-mode { display:flex; padding:3px; border:1px solid var(--ke-color-exhibitions-border); border-radius:7px; background:var(--ke-color-exhibitions-mode-surface); }
  .ex-mode button { min-height:44px; display:flex; align-items:center; gap:.5rem; padding:.55rem .9rem; border:0; border-radius:4px; background:transparent; color:var(--ke-color-exhibitions-muted); font:inherit; font-weight:850; cursor:pointer; }
  .ex-mode button[aria-checked="true"] { background:var(--ke-color-exhibitions-raised); color:var(--ke-color-exhibitions-text); box-shadow:inset 0 0 0 1px var(--ke-color-exhibitions-mode-selected-line); }
  .ex-personal-note { margin:0; color:var(--ke-color-exhibitions-muted); font-size:.82rem; }
  .ex-personal-note strong { color:var(--ke-color-exhibitions-text); }
  .ex-categories { display:flex; gap:.42rem; overflow-x:auto; scrollbar-width:none; }
  .ex-categories button { min-height:44px; padding:.45rem .75rem; border:1px solid var(--ke-color-exhibitions-border); border-radius:999px; background:transparent; color:var(--ke-color-exhibitions-muted); font:inherit; font-size:.82rem; font-weight:750; white-space:nowrap; cursor:pointer; }
  .ex-categories button[aria-pressed="true"] { border-color:var(--ke-color-exhibitions-category-selected-border); background:var(--ke-color-exhibitions-category-selected-surface); color:var(--ke-color-exhibitions-text); }
  .ex-controls__end { min-width:0; display:flex; align-items:center; justify-content:flex-end; gap:.55rem; }
  .ex-keyboard-help { display:grid; grid-template-columns:minmax(210px,.7fr) 1fr; gap:1rem; margin:1rem 0 2rem; padding:1rem 1.15rem; border:1px solid var(--ke-color-exhibitions-keyboard-help-border); border-radius:7px; background:linear-gradient(135deg,var(--ke-color-exhibitions-keyboard-help-start),var(--ke-color-exhibitions-keyboard-help-end)); }
  .ex-keyboard-help h2 { margin:0; font-size:1.1rem; }
  .ex-keyboard-help ul { display:flex; flex-wrap:wrap; gap:.55rem 1rem; align-items:center; margin:0; padding:0; list-style:none; }
  .ex-keyboard-help li { display:flex; align-items:center; gap:.3rem; color:var(--ke-color-exhibitions-muted); font-size:.78rem; }
  .ex-results { scroll-margin-top:150px; }
  .ex-group { padding:2.25rem 0; border-bottom:1px solid var(--ke-color-exhibitions-border); }
  .ex-group__heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:1rem; }
  .ex-group__heading h2,.ex-tail-callout h2 { margin:0; font:var(--ke-type-h2); letter-spacing:var(--ke-type-h2-letter); }
  .ex-group__heading p:not(.ex-group__eyebrow),.ex-tail-callout p:not(.ex-group__eyebrow) { max-width:68ch; margin:.55rem 0 0; color:var(--ke-color-exhibitions-muted); font-size:.9rem; }
  .ex-mark-seen,.ex-tail-toggle,.ex-tail-more,.ex-empty button { min-height:44px; padding:.55rem .85rem; border:1px solid var(--ke-color-exhibitions-action-border); border-radius:5px; background:var(--ke-color-exhibitions-raised); color:var(--ke-color-exhibitions-text); font:inherit; font-weight:800; cursor:pointer; }
  .ex-mark-seen { border-color:transparent; background:transparent; color:var(--ke-color-exhibitions-muted); font-size:.78rem; font-weight:720; text-decoration:underline; text-decoration-color:var(--ke-color-exhibitions-action-underline); text-underline-offset:.22em; }
  .ex-mark-seen:hover { border-color:var(--ke-color-exhibitions-keyboard-help-border); background:var(--ke-color-exhibitions-action-hover-surface); color:var(--ke-color-exhibitions-text); text-decoration-color:transparent; }
  .ex-legend { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.55rem 1rem; color:var(--ke-color-exhibitions-muted); font-size:.72rem; }
  .ex-legend span { display:inline-flex; align-items:center; gap:.38rem; }
  .ex-legend i { width:9px; height:9px; border-radius:50%; background:var(--ke-color-exhibitions-blue); box-shadow:0 0 10px currentColor; }
  .ex-legend .is-recent i { background:var(--ke-color-exhibitions-orange); color:var(--ke-color-exhibitions-orange); }
  .ex-legend .is-ending i { background:var(--ke-color-exhibitions-red); color:var(--ke-color-exhibitions-red); }
  .ex-legend .is-popular i { background:var(--ke-color-exhibitions-yellow); color:var(--ke-color-exhibitions-yellow); }
  .ex-list { position:relative; display:grid; gap:7px; padding-left:var(--ke-exhibitions-timeline-gutter); }
  .ex-list::before { content:""; position:absolute; top:1.6rem; bottom:1.6rem; left:6.5px; width:var(--ke-exhibitions-timeline-line-width); border-radius:999px; background:linear-gradient(180deg,var(--ke-color-exhibitions-timeline-brand-faint),var(--ke-color-exhibitions-timeline-mid) 7%,var(--ke-color-exhibitions-timeline-end) 93%,var(--ke-color-exhibitions-timeline-brand-faint)); box-shadow:var(--ke-elevation-exhibitions-timeline); }
  .ex-row {
    --ex-media-column:clamp(420px,42vw,680px);
    --ex-row-gap:clamp(.75rem,1.5vw,1.25rem);
    --ex-surface-start:calc(112px + var(--ex-row-gap) - .6rem);
    --ex-rail-color:var(--ke-color-exhibitions-blue);
    position:relative;
    min-height:var(--ke-exhibitions-row-min-height);
    display:grid;
    grid-template-columns:112px var(--ex-media-column) minmax(250px,1fr) auto;
    gap:var(--ex-row-gap);
    align-items:stretch;
    isolation:isolate;
    padding:.58rem .68rem .58rem 0;
    view-transition-name:var(--row-transition-name);
  }
  .ex-row::after {
    content:"";
    position:absolute;
    z-index:-1;
    inset:0 0 0 var(--ex-surface-start);
    border:1px solid transparent;
    border-radius:var(--ke-exhibitions-row-radius);
    background:linear-gradient(92deg,var(--ke-color-exhibitions-row-start),var(--ke-color-exhibitions-row-end)) padding-box,linear-gradient(118deg,var(--ke-color-exhibitions-row-highlight),var(--ke-color-exhibitions-row-highlight-soft) 40%,var(--ke-color-exhibitions-row-highlight-brand) 100%) border-box;
    box-shadow:var(--ke-elevation-exhibitions-row);
    transition:box-shadow var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic),border-color var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic),background-color var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic);
  }
  .ex-row:hover,.ex-row:focus-within { z-index:2; }
  .ex-row:hover::after,.ex-row:focus-within::after {
    box-shadow:var(--ke-elevation-exhibitions-row-hover);
  }
  .ex-row.is-keyboard-active::after { box-shadow:var(--ke-elevation-exhibitions-row-keyboard); }
  .ex-row.is-keyboard-active .ex-row__halo { opacity:.88; }
  .ex-row.is-keyboard-active .ex-row__edge-light { opacity:1; filter:var(--ke-elevation-exhibitions-row-edge-keyboard); }
  body:has(.ex-page) .ex-row__title:focus-visible { outline:none; }
  .ex-row__halo {
    position:absolute;
    z-index:-1;
    inset:-18px -14px -18px calc(var(--ex-surface-start) - 14px);
    border-radius:var(--ke-exhibitions-row-halo-radius);
    background:radial-gradient(ellipse at 22% 54%,var(--ke-color-exhibitions-row-halo-strong),var(--ke-color-exhibitions-row-halo-soft) 38%,transparent 72%);
    opacity:0;
    pointer-events:none;
    transition:opacity var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic);
  }
  .ex-row__edge-light {
    position:absolute;
    z-index:5;
    inset:-1px -1px -1px calc(var(--ex-surface-start) - 1px);
    border:1px solid transparent;
    border-radius:inherit;
    background:linear-gradient(115deg,var(--ke-color-exhibitions-row-edge-line),transparent 24%,var(--ke-color-exhibitions-row-edge-brand) 72%,transparent 96%) border-box;
    -webkit-mask:linear-gradient(#000 0 0) padding-box,linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) padding-box,linear-gradient(#000 0 0);
    mask-composite:exclude;
    opacity:.36;
    pointer-events:none;
    transition:opacity var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic),filter var(--ke-exhibitions-motion-base) var(--ke-exhibitions-ease-cinematic);
  }
  .ex-row:hover .ex-row__halo,.ex-row:focus-within .ex-row__halo { opacity:1; }
  .ex-row:hover .ex-row__edge-light,.ex-row:focus-within .ex-row__edge-light { opacity:.92; filter:var(--ke-elevation-exhibitions-row-edge-hover); }
  .ex-row--recent { --ex-rail-color:var(--ke-color-exhibitions-orange); }
  .ex-row--ending { --ex-rail-color:var(--ke-color-exhibitions-red); }
  .ex-row--upcoming,.ex-row--long { --ex-rail-color:var(--ke-color-exhibitions-gray); }
  .ex-row--popular { --ex-rail-color:var(--ke-color-exhibitions-yellow); }
  .ex-row__rail { position:relative; display:grid; align-content:start; gap:.2rem; padding:.75rem 0 0 .75rem; color:var(--ke-color-exhibitions-muted); font-size:.7rem; font-variant-numeric:tabular-nums; }
  .ex-row__rail::after { content:""; position:absolute; z-index:0; top:1.01rem; left:-14px; width:20px; height:2px; border-radius:999px; background:linear-gradient(90deg,var(--ex-rail-color),color-mix(in srgb,var(--ex-rail-color),transparent 62%)); pointer-events:none; }
