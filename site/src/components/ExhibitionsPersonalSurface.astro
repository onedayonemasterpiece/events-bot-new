    .ex-categories { inline-size:100%; }
  }
  @media (prefers-reduced-motion:no-preference) {
    .ex-deck__frame[data-image-state="loading"] .ex-deck__skeleton,.ex-gallery__media[data-image-state="loading"] .ex-gallery__skeleton { animation:ex-skeleton-shimmer 1.35s linear infinite; }
  }
  @media (prefers-reduced-motion:reduce) {
