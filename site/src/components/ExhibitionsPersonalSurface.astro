  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-exhibitions-prototype]');
    if (!(root instanceof HTMLElement)) return;
    const STATE_KEY = 'ke_exhibitions_prototype_v1';
    const rows = () => Array.from(root.querySelectorAll('[data-exhibition-row]'));
    const originalRowOrder = new WeakMap(rows().map((row,index) => [row,index]));
    const focusLinks = () => {
      const seen = new Set();
      return rows()
        .filter((row) => !row.classList.contains('is-filtered') && !row.classList.contains('is-rejected') && !row.closest('[hidden]'))
        .filter((row) => {
          const id = row.dataset.eventId;
          if (!id || seen.has(id)) return false;
          seen.add(id);
          return true;
        })
        .map((row) => row.querySelector('[data-row-focus]'))
        .filter((node) => node instanceof HTMLElement);
    };
    const live = root.querySelector('[data-live]');
    const liveMessage = root.querySelector('[data-live-message]');
    const liveUndo = root.querySelector('[data-live-undo]');
    const deckLive = root.querySelector('[data-deck-live]');
    const personalNote = root.querySelector('[data-personal-note]');
    const visibleCount = root.querySelector('[data-visible-count]');
    const empty = root.querySelector('[data-empty]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const compactDeck = window.matchMedia('(max-width: 820px)');
    const deckStates = new WeakMap();
    const deckManifests = new WeakMap();
    const MAX_STACK_DEPTH = 5;
    const TAIL_BATCH_SIZE = 4;
    const PROFILE_MIN_LIKES = 3;
    const DECK_EASE = 'cubic-bezier(.16,1,.3,1)';
    let imageRequestId = 0;

    root.querySelectorAll('[data-exhibition-medallion] img').forEach((image) => {
      if (!(image instanceof HTMLImageElement)) return;
      const seal = image.closest('[data-exhibition-medallion]');
      const hideBrokenSeal = () => { if (seal instanceof HTMLElement) seal.hidden = true; };
      image.addEventListener('error',hideBrokenSeal,{ once:true });
      if (image.complete && image.naturalWidth === 0) hideBrokenSeal();
    });

    const manifestFor = (deck) => {
      if (deckManifests.has(deck)) return deckManifests.get(deck);
      let manifest = [];
      try { manifest = JSON.parse(deck.dataset.deckManifest || '[]'); } catch {}
      if (!Array.isArray(manifest)) manifest = [];
      deckManifests.set(deck,manifest);
      return manifest;
    };
    const ensureDeckState = (deck) => {
      if (deckStates.has(deck)) return deckStates.get(deck);
      const state = { cursor:0, history:[], page:null, phase:'idle', queued:0, generation:0, animations:new Set() };
      deckStates.set(deck,state);
      return state;
    };
    const clearFrameGeometry = (frame) => {
      frame.hidden = true;
      frame.dataset.deckState = 'hidden';
      delete frame.dataset.deckDepth;
      frame.removeAttribute('data-deck-motion');
      frame.style.removeProperty('inset-inline-start');
      frame.style.removeProperty('inset-block-start');
      frame.style.removeProperty('inline-size');
      frame.style.removeProperty('block-size');
      frame.style.removeProperty('z-index');
      frame.style.removeProperty('--deck-depth');
      frame.style.removeProperty('--deck-saturation');
      frame.style.removeProperty('--deck-brightness');
      frame.style.removeProperty('--deck-contrast');
      frame.style.removeProperty('--deck-blur');
    };
    const settleDeckImage = (frame,image,requestId,state) => {
      if (frame.dataset.imageRequest !== requestId || frame.dataset.deckVisual !== 'media') return;
      frame.dataset.imageState = state;
    };
    const bindFrame = (frame,asset,showImage) => {
      const image = frame.querySelector('[data-deck-image]');
      frame.dataset.mediaIndex = String(asset.mediaIndex);
      frame.dataset.sourceIndex = String(asset.sourceIndex);
      frame.dataset.mediaTreatment = asset.treatment;
      frame.dataset.mediaToken = asset.token;
      frame.dataset.mediaRole = asset.mediaRole;
      frame.dataset.imageTextMode = asset.textMode;
      frame.dataset.safeCrop = asset.safeCrop ? 'true' : 'false';
      frame.dataset.cropReason = asset.cropReason;
      frame.dataset.cropLoss = Number(asset.cropLoss || 0).toFixed(5);
      frame.dataset.sourceRatio = Number(asset.sourceRatio || 1).toFixed(5);
      frame.dataset.presentationRatio = Number(asset.presentationRatio || 1).toFixed(5);
      frame.style.setProperty('--media-ratio',String(asset.presentationRatio || 1));
      frame.style.setProperty('--media-position',asset.objectPosition || '50% 50%');
      frame.dataset.deckVisual = showImage ? 'media' : 'depth-tail';
      if (!(image instanceof HTMLImageElement)) return;
      if (!showImage) {
        frame.dataset.imageState = 'depth';
        return;
      }
      image.width = Number(asset.width || 1);
      image.height = Number(asset.height || 1);
      if (image.dataset.boundSrc === asset.src) {
        frame.dataset.imageState = image.complete ? (image.naturalWidth > 0 ? 'loaded' : 'error') : 'loading';
        return;
      }
      const requestId = String(++imageRequestId);
      frame.dataset.imageRequest = requestId;
      frame.dataset.imageState = 'loading';
      image.dataset.boundSrc = asset.src;
      image.onload = () => settleDeckImage(frame,image,requestId,'loaded');
      image.onerror = () => settleDeckImage(frame,image,requestId,'error');
      if (asset.srcset) image.srcset = asset.srcset;
      else image.removeAttribute('srcset');
      image.src = asset.src;
      if (image.complete) settleDeckImage(frame,image,requestId,image.naturalWidth > 0 ? 'loaded' : 'error');
    };
    const unbindDeckMedia = (deck) => {
      if (!(deck instanceof HTMLElement)) return;
      const state = ensureDeckState(deck);
      if (state.phase !== 'idle') cancelDeckMotion(deck,state);
      deck.querySelectorAll('[data-deck-frame]').forEach((frame) => {
        if (!(frame instanceof HTMLElement)) return;
        const image = frame.querySelector('[data-deck-image]');
        delete frame.dataset.imageRequest;
        frame.dataset.imageState = frame.dataset.deckVisual === 'depth-tail' ? 'depth' : 'idle';
        if (!(image instanceof HTMLImageElement)) return;
        image.onload = null;
        image.onerror = null;
        delete image.dataset.boundSrc;
        image.removeAttribute('srcset');
        image.removeAttribute('src');
      });
    };
    const measureDeckPage = (deck,cursor,options = {}) => {
      const manifest = manifestFor(deck);
      const frames = Array.from(deck.querySelectorAll('[data-deck-frame]')).filter((node) => node instanceof HTMLElement);
      const height = deck.clientHeight;
      const available = deck.clientWidth;
      const total = manifest.length;
      const start = Math.max(0,Math.min(Number(cursor || 0),Math.max(0,total - 1)));
      const gap = compactDeck.matches ? 3 : 4;
      const sliver = compactDeck.matches ? 9 : 13;
      const overlap = compactDeck.matches ? 6 : 8;
      const badgeReserve = compactDeck.matches ? 40 : 46;
      const widthFor = (asset) => Math.max(52,height * Math.max(.25,Number(asset?.presentationRatio || 1)));
      const remaining = manifest.slice(start);
      const startAlignedTerminal = options.alignFinal === 'start' && start > 0;
      const naturalWidth = remaining.reduce((sum,asset) => sum + widthFor(asset),0) + gap * Math.max(0,remaining.length - 1);
      const full = [];
      let fullRight = 0;
      if (remaining.length === 1) {
        const natural = widthFor(remaining[0]);
        const width = Math.min(natural,available);
        const scale = natural ? width / natural : 1;
        full.push({ index:start, left:startAlignedTerminal ? 0 : Math.max(0,(available - width) / 2), top:Math.max(0,(height - height * scale) / 2), width, height:height * scale, depth:0, state:'full' });
        fullRight = full[0].left + width;
      } else if (remaining.length <= frames.length && naturalWidth <= available) {
        let left = startAlignedTerminal ? 0 : Math.max(0,(available - naturalWidth) / 2);
        remaining.forEach((asset,index) => {
          const width = widthFor(asset);
          full.push({ index:start + index, left, top:0, width, height, depth:0, state:'full' });
          left += width + gap;
        });
        fullRight = full.length ? full.at(-1).left + full.at(-1).width : 0;
      } else {
        let left = 0;
        const maxFull = Math.max(1,frames.length - 1);
        while (full.length < maxFull && start + full.length < total) {
          const index = start + full.length;
          const width = widthFor(manifest[index]);
          const candidateRight = left + width;
          const hasAfter = index + 1 < total;
          if (full.length > 0 && hasAfter && candidateRight > available - badgeReserve) break;
          full.push({ index, left, top:0, width, height, depth:0, state:'full' });
          fullRight = candidateRight;
          left = candidateRight + gap;
        }
      }
      const next = start + full.length;
      const stackIndexes = [];
      const stackCapacity = Math.max(0,frames.length - full.length);
      for (let index = next; index < total && stackIndexes.length < Math.min(MAX_STACK_DEPTH,stackCapacity); index += 1) stackIndexes.push(index);
      const stack = [];
      if (stackIndexes.length) {
        const widths = stackIndexes.map((index,depthIndex) => {
          const depth = depthIndex + 1;
          const depthScale = 1 / (1 + depth * .05);
          return { width:widthFor(manifest[index]) * depthScale, height:height * depthScale, depth };
        });
        const naturalFirstLeft = available - Math.max(0,stackIndexes.length - 1) * sliver - widths[0].width;
        const firstLeft = Math.max(0,Math.min(naturalFirstLeft,fullRight - overlap));
        let previousRight = 0;
        stackIndexes.forEach((index,stackIndex) => {
          const metric = widths[stackIndex];
          let left = firstLeft + stackIndex * sliver;
          if (stackIndex > 0) {
            left = Math.min(left,previousRight - 6);
            if (left + metric.width <= previousRight + 2) left = previousRight + 2 - metric.width;
          }
          const right = left + metric.width;
          previousRight = right;
          stack.push({ index, left, top:(height - metric.height) / 2, width:metric.width, height:metric.height, depth:metric.depth, state:'stack' });
        });
        const overflow = Math.max(0,stack.at(-1).left + stack.at(-1).width - available);
        if (overflow) stack.forEach((item) => { item.left -= overflow; });
      }
      return { start, full, stack, placements:[...full,...stack], next, remaining:Math.max(0,total - next), total, available, height, gap, overlap };
    };
    const resolveForwardPage = (deck,current) => {
      const rawNext = current.next;
      const raw = measureDeckPage(deck,rawNext,{ alignFinal:'start' });
      if (raw.next !== raw.total || raw.remaining > 0) return raw;
      for (let start = current.start + 1; start < rawNext; start += 1) {
        const candidate = measureDeckPage(deck,start,{ alignFinal:'start' });
        const terminal = candidate.next === candidate.total && candidate.remaining === 0;
        const promotesNewMedia = candidate.full.some((item) => item.index >= rawNext);
        if (terminal && promotesNewMedia) return candidate;
      }
      return raw;
    };
    const updateDeckA11y = (deck,page) => {
      const title = deck.dataset.galleryTitle || 'выставки';
      const count = deck.querySelector('[data-deck-count]');
      const first = page.total ? page.start + 1 : 0;
      const last = page.start + page.full.length;
      const remainingText = page.remaining ? `, ещё ${page.remaining}` : '';
      deck.dataset.deckCursor = String(page.start);
      deck.dataset.deckPageSize = String(page.full.length);
      deck.dataset.deckOverflow = String(page.remaining > 0);
      deck.setAttribute('aria-label',`Фото ${first}–${last} из ${page.total} выставки «${title}»${remainingText}. Стрелки влево и вправо листают фото; Enter открывает галерею.`);
      if (count instanceof HTMLElement) {
        if (page.remaining > 0 && page.stack.length) {
          const lastStack = page.stack.at(-1);
          count.hidden = false;
          count.textContent = `+${page.remaining}`;
          count.setAttribute('aria-label',`Ещё ${page.remaining} фото`);
          count.style.insetInlineStart = `${Math.max(4,Math.min(page.available - 38,lastStack.left + lastStack.width - 19))}px`;
        } else {
          count.hidden = true;
          count.style.removeProperty('inset-inline-start');
        }
      }
    };
    const applyDeckPage = (deck,page,state) => {
      const manifest = manifestFor(deck);
      const frames = Array.from(deck.querySelectorAll('[data-deck-frame]')).filter((node) => node instanceof HTMLElement);
      const required = page.placements.map((placement) => placement.index);
      const slotByIndex = new Map();
      frames.forEach((frame) => {
        const index = Number(frame.dataset.mediaIndex);
        if (required.includes(index)) slotByIndex.set(index,frame);
      });
      const free = frames.filter((frame) => !slotByIndex.has(Number(frame.dataset.mediaIndex)));
      required.forEach((index) => {
        if (!slotByIndex.has(index)) slotByIndex.set(index,free.shift());
      });
      frames.forEach(clearFrameGeometry);
      page.placements.forEach((placement,placementIndex) => {
        const frame = slotByIndex.get(placement.index);
        const asset = manifest[placement.index];
        if (!(frame instanceof HTMLElement) || !asset) return;
        const showImage = placement.state === 'full' || placement.depth < MAX_STACK_DEPTH;
        bindFrame(frame,asset,showImage);
        frame.hidden = false;
        frame.dataset.deckState = placement.state;
        frame.style.insetInlineStart = `${placement.left}px`;
        frame.style.insetBlockStart = `${placement.top}px`;
        frame.style.inlineSize = `${placement.width}px`;
        frame.style.blockSize = `${placement.height}px`;
        if (placement.state === 'full') {
          // Full photographs stay genuinely readable; the right-hand pile is
          // tucked underneath them and only its progressively exposed right
          // edges remain visible when the column becomes narrow.
          frame.style.zIndex = String(200 + placementIndex);
        } else {
          frame.dataset.deckDepth = String(placement.depth);
          frame.style.setProperty('--deck-depth',String(placement.depth));
          frame.style.setProperty('--deck-saturation',String(.82 + (placement.depth - 1) * .09));
          frame.style.setProperty('--deck-brightness',String(Math.max(.76,.96 - (placement.depth - 1) * .05)));
          frame.style.setProperty('--deck-contrast',String(1.02 + (placement.depth - 1) * .01));
          frame.style.setProperty('--deck-blur',`${Math.max(0,placement.depth - 1) * .15}px`);
          frame.style.zIndex = String(120 - placement.depth);
        }
      });
      state.page = page;
      updateDeckA11y(deck,page);
    };
    const layoutDeck = (deck) => {
      if (!(deck instanceof HTMLElement) || deck.offsetParent === null) return;
      const state = ensureDeckState(deck);
      if (compactDeck.matches && state.cursor !== 0) { state.cursor = 0; state.history = []; }
      const page = measureDeckPage(deck,state.cursor);
      if (!page.height || !page.available || !page.total) return;
      applyDeckPage(deck,page,state);
    };
    const cancelDeckMotion = (deck,state = ensureDeckState(deck)) => {
      state.generation += 1;
      state.animations.forEach((animation) => { try { animation.cancel(); } catch {} });
      state.animations.clear();
      deck.querySelectorAll('[data-deck-motion]').forEach((frame) => frame.removeAttribute('data-deck-motion'));
      state.phase = 'idle';
      state.queued = 0;
      deck.dataset.deckPhase = 'idle';
    };
    const trackedAnimation = (state,frame,keyframes,options) => {
      if (typeof frame.animate !== 'function') return null;
      frame.dataset.deckMotion = 'true';
      const animation = frame.animate(keyframes,{ ...options, fill:'none' });
      state.animations.add(animation);
      animation.finished.catch(() => {}).finally(() => {
        state.animations.delete(animation);
        frame.removeAttribute('data-deck-motion');
      });
      return animation;
    };
    const waitAnimations = async (animations) => {
      await Promise.allSettled(animations.filter(Boolean).map((animation) => animation.finished));
    };
    let deckLiveTimer;
    const announceDeckStatus = (message) => {
      if (!(deckLive instanceof HTMLElement)) return;
      window.clearTimeout(deckLiveTimer);
      deckLiveTimer = window.setTimeout(() => { deckLive.textContent = message; },reducedMotion.matches ? 0 : 250);
    };
    const announceDeckPage = (deck,page) => {
      const first = page.start + 1;
      const last = page.start + page.full.length;
      announceDeckStatus(`Фото ${first}–${last} из ${page.total}${page.remaining ? `, ещё ${page.remaining}` : ', конец колоды'}.`);
    };
    const pageDeck = async (deck,direction) => {
      if (!(deck instanceof HTMLElement) || compactDeck.matches) return;
      const state = ensureDeckState(deck);
      const current = state.page || measureDeckPage(deck,state.cursor);
      if (state.phase !== 'idle') { state.queued = direction; return; }
      const historyCursor = state.history.at(-1);
      const target = direction > 0 ? resolveForwardPage(deck,current) : (historyCursor === undefined ? null : measureDeckPage(deck,historyCursor));
      const targetCursor = target?.start;
      if (!target || targetCursor === undefined || targetCursor === null || targetCursor === state.cursor || (direction > 0 && current.remaining === 0)) {
        announceDeckStatus(direction > 0 ? 'Это последние фотографии.' : 'Это начало колоды.');
        return;
      }
      const nextHistory = direction > 0 ? [...state.history,state.cursor] : state.history.slice(0,-1);
      if (reducedMotion.matches || typeof Element.prototype.animate !== 'function') {
        state.cursor = targetCursor;
        state.history = nextHistory;
        applyDeckPage(deck,target,state);
        announceDeckPage(deck,target);
        return;
      }
      state.phase = direction > 0 ? 'forward' : 'backward';
      state.queued = 0;
      const generation = ++state.generation;
      deck.dataset.deckPhase = state.phase;
      const deckRect = deck.getBoundingClientRect();
      const oldRects = new Map();
      deck.querySelectorAll('[data-deck-frame]:not([hidden])').forEach((frame) => {
        if (frame instanceof HTMLElement) oldRects.set(Number(frame.dataset.mediaIndex),frame.getBoundingClientRect());
      });
      const targetIndexes = new Set(target.placements.map((placement) => placement.index));
      const exitAnimations = current.full.filter((placement) => !targetIndexes.has(placement.index)).map((placement) => {
        const frame = deck.querySelector(`[data-deck-frame][data-media-index="${placement.index}"]`);
        if (!(frame instanceof HTMLElement)) return null;
        const rect = frame.getBoundingClientRect();
        const travel = direction > 0 ? -(rect.right - deckRect.left + 28) : deckRect.right - rect.left + 28;
        return trackedAnimation(state,frame,[
          { transform:'translate3d(0,0,0)', opacity:1 },
          { transform:`translate3d(${travel}px,0,0)`, opacity:0 },
        ],{ duration:190, easing:'cubic-bezier(.55,.085,.68,.53)' });
      });
      await waitAnimations(exitAnimations);
      if (generation !== state.generation) return;
      state.cursor = targetCursor;
      state.history = nextHistory;
      applyDeckPage(deck,target,state);
      const arrivalAnimations = target.placements.map((placement,placementIndex) => {
        const frame = deck.querySelector(`[data-deck-frame][data-media-index="${placement.index}"]`);
        if (!(frame instanceof HTMLElement)) return null;
        const finalRect = frame.getBoundingClientRect();
        const previous = oldRects.get(placement.index);
        const origin = previous || (direction > 0
          ? { left:deckRect.right - 34, top:deckRect.top + deckRect.height / 2 - 24, width:68, height:48 }
          : { left:deckRect.left - Math.max(68,finalRect.width), top:finalRect.top, width:finalRect.width, height:finalRect.height });
        const scaleX = Math.max(.2,origin.width / Math.max(1,finalRect.width));
        const scaleY = Math.max(.2,origin.height / Math.max(1,finalRect.height));
        const delay = placement.state === 'full' ? Math.min(108,placementIndex * 36) : Math.min(72,placement.depth * 18);
        return trackedAnimation(state,frame,[
          { transform:`translate3d(${origin.left - finalRect.left}px,${origin.top - finalRect.top}px,0) scale(${scaleX},${scaleY})`, opacity:previous ? .72 : .16 },
          { transform:'translate3d(0,0,0) scale(1,1)', opacity:1 },
        ],{ duration:470, delay, easing:DECK_EASE });
      });
      await waitAnimations(arrivalAnimations);
      if (generation !== state.generation) return;
      state.phase = 'idle';
      deck.dataset.deckPhase = 'idle';
      announceDeckPage(deck,target);
      const queued = state.queued;
      state.queued = 0;
      if (queued) pageDeck(deck,queued);
    };
    const layoutDecks = () => root.querySelectorAll('[data-deck]').forEach((deck) => {
      if (!(deck instanceof HTMLElement)) return;
      const state = ensureDeckState(deck);
      if (state.phase !== 'idle') return;
      if (deck.closest('[data-list-section="tail"]') && deck.dataset.tailDeckActive !== 'true') return;
      layoutDeck(deck);
    });
    let deckResizeFrame = 0;
    const scheduleDeckLayout = (cancelActive = false) => {
      window.cancelAnimationFrame(deckResizeFrame);
      if (cancelActive) root.querySelectorAll('[data-deck][data-deck-phase]:not([data-deck-phase="idle"])').forEach((deck) => {
        if (deck instanceof HTMLElement) cancelDeckMotion(deck,ensureDeckState(deck));
      });
      deckResizeFrame = window.requestAnimationFrame(layoutDecks);
    };
    window.addEventListener('resize', () => scheduleDeckLayout(true), { passive:true });
    compactDeck.addEventListener?.('change',() => scheduleDeckLayout(true));
    const deckResizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(() => scheduleDeckLayout()) : null;
    root.querySelectorAll('[data-deck]').forEach((deck) => deckResizeObserver?.observe(deck));
    document.fonts?.ready.then(scheduleDeckLayout);
    const deactivateTailDeck = (deck) => {
      if (!(deck instanceof HTMLElement)) return;
      delete deck.dataset.tailDeckActive;
      unbindDeckMedia(deck);
    };
    const activateTailDeck = (deck) => {
      if (!(deck instanceof HTMLElement) || deck.offsetParent === null) return;
      deck.dataset.tailDeckActive = 'true';
      layoutDeck(deck);
    };
    const tailDeckObserver = typeof IntersectionObserver === 'function'
      ? new IntersectionObserver((entries) => entries.forEach((entry) => {
        const deck = entry.target;
        if (!(deck instanceof HTMLElement)) return;
        if (entry.isIntersecting && deck.offsetParent !== null) activateTailDeck(deck);
        else deactivateTailDeck(deck);
      }), { rootMargin:'80px 0px' })
