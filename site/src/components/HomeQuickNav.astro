---
import { withBase } from '../lib/events';
import { getCollectionNavigationEntries } from '../lib/staticCollections';
import Button from './design-system/Button.astro';

const availableCollections = new Set(getCollectionNavigationEntries().map(entry => entry.key));
const items = [
  { label: 'Сегодня', href: '/segodnya/' },
  { label: 'Завтра', href: '/zavtra/' },
  { label: 'Выходные', href: '/vyhodnye/' },
  ...(availableCollections.has('free') ? [{ label: 'Бесплатно', href: '/podborki/besplatnye-sobytiya/' }] : []),
  { label: 'Выставки', href: '/vystavki/' },
  ...(availableCollections.has('unusual') ? [{ label: 'Необычное', href: '/neobychnoe/' }] : []),
];
---
<nav class="home-quick-nav" data-ds-family="HomeQuickNav" data-ds-version="2"
  data-ds-variant="inline-routes" data-ds-state="populated" data-home-quick-nav aria-label="Быстрый выбор событий">
  {items.map((item, index) => (
    <span data-home-quick-nav-item={index + 1}><Button variant="quiet" size="compact" href={withBase(item.href)}>{item.label}</Button></span>
  ))}
</nav>
<style>
  .home-quick-nav { display:flex; flex-wrap:wrap; gap:var(--ke-space-2); margin-block:var(--ke-space-4); }
  .home-quick-nav > span { min-width:0; }
</style>
