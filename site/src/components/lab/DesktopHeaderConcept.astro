---
import { withBase } from '../../lib/events';
import AnnouncementsLockup from '../brand/AnnouncementsLockup.astro';
import AnnouncementsWordmark from '../brand/AnnouncementsWordmark.astro';

export type DesktopHeaderVariant = 'text-tag' | 'logo-eyelet' | 'signature-tab';

interface Props {
  variant: DesktopHeaderVariant;
  current?: 'today' | 'tomorrow' | 'weekend' | 'exhibitions' | 'popular';
}

const { variant, current } = Astro.props;
const navigation = [
  { key: 'today', label: 'Сегодня', href: '/segodnya/' },
  { key: 'tomorrow', label: 'Завтра', href: '/zavtra/' },
  { key: 'weekend', label: 'Выходные', href: '/vyhodnye/' },
  { key: 'exhibitions', label: 'Выставки', href: '/vystavki/' },
  { key: 'popular', label: 'Популярное', href: '/populyarnoe/' },
] as const;
---

<header class:list={['desktop-header-concept', `desktop-header-concept--${variant}`]} data-desktop-header-concept={variant}>
  <div class="desktop-header-concept__inner">
    {variant === 'text-tag' && (
      <a class="desktop-header-concept__text-tag" href={withBase('/__preview/')} aria-label="Полюбить Калининград Анонсы — на главную">
        <AnnouncementsLockup variant="desktop" class="desktop-header-concept__text-lockup" />
      </a>
    )}

    {variant === 'logo-eyelet' && (
      <div class="desktop-header-concept__logo-eyelet-group">
        <a class="desktop-header-concept__logo-eyelet" href={withBase('/__preview/')} aria-label="Полюбить Калининград Анонсы — на главную">
          <img src={withBase('/brand-mark-white.svg')} alt="" width="970" height="820" />
        </a>
        <a class="desktop-header-concept__inline-name" href={withBase('/__preview/')} tabindex="-1" aria-hidden="true">
          <strong>Полюбить Калининград</strong>
          <AnnouncementsWordmark class="desktop-header-concept__inline-wordmark" />
        </a>
      </div>
    )}

    {variant === 'signature-tab' && (
      <a class="desktop-header-concept__signature" href={withBase('/__preview/')} aria-label="Полюбить Калининград Анонсы — на главную">
        <span class="desktop-header-concept__signature-mark"><img src={withBase('/brand-mark-white.svg')} alt="" width="970" height="820" /></span>
        <span class="desktop-header-concept__signature-copy"><small>Полюбить Калининград</small><AnnouncementsWordmark class="desktop-header-concept__signature-wordmark" /></span>
      </a>
    )}

    <nav class="desktop-header-concept__nav" aria-label="Основная навигация">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={item.key === current ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .desktop-header-concept {
    --header-bg:#fffaf2;
    --header-ink:#28211c;
    --header-muted:#71665e;
    --header-line:#e3d6c8;
    --header-brand:#a54821;
    --header-brand-dark:#7b3014;
    --header-brand-tab:#98401f;
    --header-brand-tab-hover:#893719;
    --header-focus:#0f766e;
    position:relative;
    z-index:20;
    min-width:760px;
    border-bottom:1px solid var(--header-line);
    background:rgba(255,250,242,.96);
    color:var(--header-ink);
    box-shadow:0 6px 22px rgba(69,45,28,.035);
  }
  .desktop-header-concept,
  .desktop-header-concept * { box-sizing:border-box; }
  .desktop-header-concept__inner {
    position:relative;
    width:min(1440px,calc(100% - clamp(3rem,5vw,6rem)));
    height:56px;
    min-height:56px;
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:clamp(2rem,4vw,4rem);
  }
  .desktop-header-concept a { color:inherit; }
  .desktop-header-concept a:focus-visible {
    outline:3px solid color-mix(in srgb,var(--header-focus) 72%,transparent);
    outline-offset:3px;
  }
  .desktop-header-concept__nav { min-width:0; flex:0 0 auto; margin-left:auto; }
  .desktop-header-concept__nav ul {
    display:flex;
    align-items:stretch;
    justify-content:flex-end;
    gap:4px;
    margin:0;
    padding:0;
    list-style:none;
  }
  .desktop-header-concept__nav a {
    position:relative;
    min-height:44px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.18rem 1rem;
    border-radius:8px;
    color:var(--header-muted);
    font-size:clamp(.89rem,1vw,.98rem);
    font-weight:600;
    line-height:1.1;
    text-decoration:none;
    white-space:nowrap;
  }
  .desktop-header-concept__nav a::after {
    content:"";
    position:absolute;
    left:.72rem;
    right:.72rem;
    bottom:2px;
    height:2px;
    border-radius:999px;
    background:var(--header-brand);
    opacity:0;
    transform:scaleX(.55);
    transition:opacity 160ms ease,transform 160ms ease;
  }
  .desktop-header-concept__nav a:hover { background:#f5eadc; color:var(--header-ink); }
  .desktop-header-concept__nav a[aria-current="page"] { color:var(--header-brand-dark); font-weight:760; }
  .desktop-header-concept__nav a[aria-current="page"]::after { opacity:1; transform:scaleX(1); }

  .desktop-header-concept__text-tag {
    flex:0 0 auto;
    align-self:flex-start;
    width:240px;
    height:88px;
    display:block;
    padding:18px 24px 16px;
    border-radius:0 0 12px 12px;
    background:var(--header-brand-tab);
    color:#fffaf2!important;
    box-shadow:none;
    text-decoration:none;
    transition:background-color 160ms ease;
  }
  .desktop-header-concept__text-tag:hover { background:var(--header-brand-tab-hover); }
  :global(.desktop-header-concept__text-lockup) {
    display:grid;
    grid-template-rows:12px auto;
    align-content:start;
    gap:4px;
  }
  :global(.desktop-header-concept__text-lockup .announcements-lockup__endorsement) {
    overflow:visible;
    font-size:11px;
    font-weight:600;
    letter-spacing:.08em;
    line-height:12px;
    text-transform:uppercase;
    white-space:nowrap;
  }
  :global(.desktop-header-concept__text-lockup .announcements-lockup__wordmark) { display:block; width:192px; height:auto; color:#fff; overflow:visible; }

  .desktop-header-concept__logo-eyelet-group {
    position:relative;
    flex:0 0 auto;
    align-self:flex-start;
    height:78px;
    display:flex;
    align-items:flex-start;
    gap:.9rem;
  }
  .desktop-header-concept__logo-eyelet {
    flex:0 0 auto;
    width:72px;
    height:78px;
    display:grid;
    place-items:center;
    padding:.6rem;
    border-radius:0 0 16px 16px;
    background:linear-gradient(155deg,var(--header-brand-dark),var(--header-brand));
    box-shadow:0 14px 28px rgba(103,43,19,.2),inset 0 1px rgba(255,255,255,.14);
    text-decoration:none;
  }
  .desktop-header-concept__logo-eyelet img {
    width:51px;
    height:44px;
    object-fit:contain;
    transform:translateY(-4px);
  }
  .desktop-header-concept__inline-name {
    height:56px;
    display:grid;
    align-content:center;
    gap:.05rem;
    line-height:1;
    text-decoration:none;
  }
  .desktop-header-concept__inline-name strong { font-size:.93rem; font-weight:850; letter-spacing:-.025em; }
  :global(.desktop-header-concept__inline-wordmark) { display:block; width:146px; height:auto; color:var(--header-brand); overflow:visible; }

  .desktop-header-concept__signature {
    flex:0 0 auto;
    align-self:flex-start;
    width:248px;
    min-height:68px;
    display:grid;
    grid-template-columns:52px minmax(0,1fr);
    align-items:center;
    gap:.72rem;
    padding:.48rem .9rem .55rem .62rem;
    border-radius:0 0 14px 14px;
    background:linear-gradient(155deg,var(--header-brand-dark),var(--header-brand));
    color:#fffaf2!important;
    box-shadow:0 12px 24px rgba(103,43,19,.18),inset 0 1px rgba(255,255,255,.14);
    text-decoration:none;
  }
  .desktop-header-concept__signature-mark {
    width:50px;
    height:46px;
    display:grid;
    place-items:center;
  }
  .desktop-header-concept__signature-mark img { width:45px; height:38px; object-fit:contain; transform:translateY(-2px); }
  .desktop-header-concept__signature-copy { min-width:0; display:grid; gap:.05rem; line-height:1; }
  .desktop-header-concept__signature-copy small { font-size:.62rem; font-weight:790; letter-spacing:.045em; text-transform:uppercase; white-space:nowrap; }
  :global(.desktop-header-concept__signature-wordmark) { display:block; width:100%; height:auto; color:#fff; overflow:visible; }

  @media (max-width:1120px) {
    .desktop-header-concept__inner { gap:2rem; }
    .desktop-header-concept__nav ul { gap:0; }
    .desktop-header-concept__nav a { padding-inline:.7rem; font-size:.86rem; }
    .desktop-header-concept__logo-eyelet-group { gap:.62rem; }
    .desktop-header-concept__inline-name strong { font-size:.82rem; }
    :global(.desktop-header-concept__inline-wordmark) { width:126px; }
    .desktop-header-concept__signature { width:218px; }
    .desktop-header-concept__signature-copy small { font-size:.55rem; }
    .desktop-header-concept__inline-name { display:none; }
  }
  @media (max-width:880px) {
    .desktop-header-concept__signature { width:76px; grid-template-columns:1fr; padding:.55rem; }
    .desktop-header-concept__signature-copy { display:none; }
  }
  @media (prefers-reduced-motion:reduce) {
    .desktop-header-concept__nav a::after,
    .desktop-header-concept__text-tag { transition:none; }
  }
</style>
