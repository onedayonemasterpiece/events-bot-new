---
import Icon from '../Icon.astro';
import type { PreviewEvent } from '../../lib/types';
import DesktopEventFacts from './DesktopEventFacts.astro';
import DesktopEventActions from './DesktopEventActions.astro';
import DesktopEventDescription from './DesktopEventDescription.astro';
import DesktopEventFeedback from './DesktopEventFeedback.astro';

type Variant = 'editorial' | 'split' | 'gallery';

interface FeedbackItem {
  tone: 'positive' | 'neutral' | 'question';
  text: string;
}

interface Props {
  event: PreviewEvent;
  related: PreviewEvent[];
  variant: Variant;
  rationale: string;
  feedback: FeedbackItem[];
  transport?: boolean;
  semanticGate?: string;
}

const { event, related, variant, rationale, feedback, transport = false, semanticGate } = Astro.props;
const assets = (event.image_assets || []).slice(0, 12);
const primary = assets[0];
const isOcr = event.image_text_mode === 'ocr_text';
const admission = event.ticket?.is_free ? 'Бесплатно' : (event.ticket?.price_label || 'Билеты');
const galleryVisible = assets.slice(0, 6);
const galleryMore = assets.slice(6);
const pageId = `desktop-event-${event.id}`;
---

<article
  id={pageId}
  class:list={['desktop-event-page', `desktop-event-page--${variant}`, isOcr && 'desktop-event-page--ocr']}
  data-desktop-full-page
  data-desktop-variant={variant}
  data-event-id={event.id}
  style={`--poster-ratio:${primary?.width && primary?.height ? primary.width / primary.height : .8};`}
>
  <aside class="desktop-event-page__lab-note" aria-label="Статус прототипа">
    <strong>{variant === 'editorial' ? 'Editorial Slab' : variant === 'split' ? 'Split Canvas' : 'Gallery Exhibition'}</strong>
    <span>реальное событие #{event.id} · desktop-only prototype</span>
    <p>{rationale}</p>
  </aside>

  {variant === 'editorial' ? (
    <section class="event-lead event-lead--editorial" data-parallax-shell>
      <figure class="event-lead__media" data-hero-media>
        <img
          data-parallax-image
          src={primary?.src || event.image_url || ''}
          alt={primary?.alt || event.image_alt}
          width={primary?.width || 1600}
          height={primary?.height || 900}
          fetchpriority="high"
          decoding="async"
        />
        <a class="event-lead__photo-count" href="#event-gallery"><Icon name="image" /> {assets.length} фото · смотреть ниже</a>
      </figure>
      <div class="event-lead__editorial-info">
        <DesktopEventFacts event={event} />
      </div>
      <div class="event-lead__editorial-action"><DesktopEventActions event={event} compact showAdmission /></div>
    </section>
  ) : (
    <section class="event-story" data-sticky-story>
      <div class="event-story__media-column">
        <figure class="event-story__media" data-parallax-shell={variant === 'split' ? '' : undefined} data-hero-media>
          <img
            data-parallax-image={variant === 'split' ? '' : undefined}
            src={primary?.src || event.image_url || ''}
            alt={primary?.alt || event.image_alt}
            width={primary?.width || 1080}
            height={primary?.height || 1350}
            fetchpriority="high"
            decoding="async"
          />
          <a class="event-lead__photo-count" href="#event-gallery"><Icon name="image" /> {assets.length} фото · смотреть ниже</a>
        </figure>
      </div>
      <div class="event-story__copy">
        <section class="event-story__facts"><DesktopEventFacts event={event} inlineActions /></section>
        <DesktopEventDescription event={event} />
        <DesktopEventFeedback eventId={event.id} items={feedback} />
      </div>
    </section>
  )}

  {variant === 'editorial' && (
    <section class="event-editorial-copy page-flow">
      <DesktopEventDescription event={event} />
      <DesktopEventFeedback eventId={event.id} items={feedback} />
    </section>
  )}

  <section class="event-gallery page-flow" id="event-gallery" aria-labelledby={`gallery-title-${event.id}`}>
    <header class="section-heading">
      <p>несколько иллюстраций · без автоплея</p>
      <h2 id={`gallery-title-${event.id}`}>Посмотреть событие ближе</h2>
      <span>Hero остаётся редакционным выбором; остальные изображения доступны явно и не меняют компоновку страницы.</span>
    </header>
    {galleryVisible.length > 0 && (
      <div class="event-gallery__viewer" data-gallery-viewer>
        <figure class="event-gallery__focus">
          <img
            data-gallery-focus
            src={galleryVisible[0].src}
            alt={galleryVisible[0].alt}
            width={galleryVisible[0].width}
            height={galleryVisible[0].height}
            loading="lazy"
            decoding="async"
          />
          <figcaption data-gallery-caption>Фото 1 из {assets.length}</figcaption>
        </figure>
        {galleryVisible.length > 1 && (
          <div class="event-gallery__rail" role="group" aria-label="Выбрать фотографию">
            {galleryVisible.map((asset, index) => (
              <button
                type="button"
                class="event-gallery__thumb"
                data-gallery-thumb
                data-src={asset.src}
                data-alt={asset.alt}
                data-index={index + 1}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Показать фото ${index + 1} из ${assets.length}`}
              >
                <img src={asset.src} alt="" width={asset.width} height={asset.height} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}
      </div>
    )}
    {galleryMore.length > 0 && (
      <details class="event-gallery__more">
        <summary>Показать остальные {galleryMore.length} фото</summary>
        <div>
          {galleryMore.map((asset) => <img src={asset.src} alt={asset.alt} width={asset.width} height={asset.height} loading="lazy" decoding="async" />)}
        </div>
      </details>
    )}
  </section>

  <section class="event-practical page-flow" aria-labelledby={`practical-title-${event.id}`}>
    <header class="section-heading">
      <p>практическая информация</p>
      <h2 id={`practical-title-${event.id}`}>Перед тем как ехать</h2>
    </header>
    <div class="event-practical__grid">
      <article><span>Где</span><strong>{event.venue_name}</strong><p>{event.address || event.city}</p></article>
      <article><span>Вход</span><strong>{admission}</strong><p>{event.ticket?.price_label ? 'Цена известна из карточки события.' : 'Переход ведёт к билетам; цена на странице не выдумывается.'}</p></article>
      <article><span>Источники</span><strong>{event.source_count || event.source_urls?.length || 1}</strong><p>Сведения объединены из публичных источников события.</p></article>
    </div>
    {semanticGate && <p class="event-practical__gate"><Icon name="info" /><span><strong>Почему не выбрали landscape автоматически:</strong> {semanticGate}</span></p>}
  </section>

  {transport && (
    <section class="transport-card page-flow" aria-labelledby={`transport-title-${event.id}`}>
      <div class="transport-card__copy">
        <p>будущий transport media slot</p>
        <h2 id={`transport-title-${event.id}`}>Как добраться до {event.city}</h2>
        <span>Горизонтальная desktop-карточка появится здесь; для mobile предусмотрен отдельный вертикальный asset.</span>
        <strong>Расписание ещё не загружено — прототип не показывает выдуманные рейсы.</strong>
      </div>
      <div class="transport-card__media" role="img" aria-label={`Зарезервированная карточка маршрута Калининград — ${event.city}; расписание не загружено`}>
        <span>Калининград</span><i></i><b>электричка · автобус</b><i></i><span>{event.city}</span>
        <small>desktop 16:7 media contract</small>
      </div>
    </section>
  )}

  <section class="related-events" id="related-events" data-related-start aria-labelledby={`related-title-${event.id}`}>
    <div class="page-flow">
      <header class="section-heading section-heading--light">
        <p>стандартное продолжение страницы</p>
        <h2 id={`related-title-${event.id}`}>Смотрите дальше</h2>
        <span>Sticky media и параллакс уже закончились: прошлое событие больше не конкурирует с выбором следующего.</span>
      </header>
      <div class="related-events__grid">
        {related.map((item) => (
          <article>
            <img src={item.image_url || ''} alt={item.image_alt} width="480" height="320" loading="lazy" decoding="async" />
            <div><span>{item.event_type} · {item.city}</span><h3>{item.title}</h3><p>{item.start_date} · {item.display_time || 'время уточняется'}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const root = document.querySelector('[data-desktop-full-page]');
    if (root instanceof HTMLElement) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const updateParallax = () => {
        if (reducedMotion.matches) {
          root.style.setProperty('--parallax-y', '0px');
          return;
        }
        root.querySelectorAll<HTMLElement>('[data-parallax-shell]').forEach((shell) => {
          const rect = shell.getBoundingClientRect();
          const range = Math.max(1, window.innerHeight + rect.height);
          const progress = Math.max(-1, Math.min(1, (window.innerHeight - rect.top) / range - .5));
          shell.style.setProperty('--parallax-y', `${(progress * 34).toFixed(2)}px`);
        });
      };
      let scheduled = false;
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => { scheduled = false; updateParallax(); });
      };
      updateParallax();
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      reducedMotion.addEventListener?.('change', schedule);

      root.querySelectorAll<HTMLElement>('[data-gallery-viewer]').forEach((viewer) => {
        const focus = viewer.querySelector<HTMLImageElement>('[data-gallery-focus]');
        const caption = viewer.querySelector<HTMLElement>('[data-gallery-caption]');
        viewer.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((button) => {
          button.addEventListener('click', () => {
            if (!focus) return;
            focus.src = button.dataset.src || focus.src;
            focus.alt = button.dataset.alt || focus.alt;
            viewer.querySelectorAll('[data-gallery-thumb]').forEach((item) => item.setAttribute('aria-pressed', item === button ? 'true' : 'false'));
            if (caption) caption.textContent = `Фото ${button.dataset.index} из ${viewer.querySelectorAll('[data-gallery-thumb]').length}`;
          });
        });
      });
    }
  </script>
</article>

<style>
  .desktop-event-page { --ink:#241b16; --muted:#75675e; --paper:#fffaf2; --cream:#f0e2d1; --rust:#aa451e; --green:#285852; color:var(--ink); background:var(--paper); }
  .desktop-event-page__lab-note { display:grid; grid-template-columns:auto auto minmax(260px,1fr); align-items:center; gap:.7rem 1rem; padding:.65rem max(1rem,calc((100vw - 1500px)/2)); background:#211e1b; color:#fff9ef; font-size:.78rem; }
  .desktop-event-page__lab-note strong { padding:.24rem .55rem; border-radius:999px; background:#b64b21; }
  .desktop-event-page__lab-note span { color:#d8cbc0; text-transform:uppercase; letter-spacing:.06em; }
  .desktop-event-page__lab-note p { margin:0; text-align:right; }
  .page-flow { width:min(1180px,calc(100% - 3rem)); margin-inline:auto; }
  .event-lead { position:relative; min-height:clamp(360px,calc(100svh - 222px),820px); overflow:clip; background:#d8c5ad; }
  .event-lead__media { position:absolute; inset:0; margin:0; overflow:hidden; background:#d8c5ad; }
  .event-lead__media::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(22,17,14,.03) 38%,rgba(22,17,14,.62) 100%); pointer-events:none; }
  .event-lead__media img { width:100%; height:calc(100% + 76px); margin-top:-38px; display:block; object-fit:cover; object-position:50% 46%; transform:translate3d(0,var(--parallax-y,0),0) scale(1.025); will-change:transform; }
  .event-lead__photo-count { position:absolute; z-index:2; top:1.15rem; right:1.25rem; min-height:44px; display:inline-flex; align-items:center; gap:.45rem; padding:.5rem .75rem; border:1px solid rgba(255,255,255,.42); border-radius:999px; background:rgba(24,20,17,.76); color:#fff; font-weight:850; text-decoration:none; }
  .event-lead__photo-count :global(.icon) { width:1.25rem; height:1.25rem; }
  .event-lead__editorial-info { position:absolute; z-index:3; left:max(2rem,calc((100vw - 1500px)/2)); bottom:0; width:min(760px,62vw); max-height:calc(100% - 2.2rem); overflow:auto; padding:clamp(1.25rem,2.3vw,2.2rem); border-radius:30px 30px 0 0; background:rgba(255,250,242,.97); box-shadow:0 -18px 55px rgba(37,25,17,.2); }
  .event-lead__editorial-action { position:absolute; z-index:4; right:max(2rem,calc((100vw - 1500px)/2)); bottom:2rem; width:min(380px,29vw); }
  .event-kicker { display:flex; justify-content:space-between; gap:.7rem; margin:0 0 .75rem; color:#8d3918; font-size:.75rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .event-kicker b { color:#6d5b50; }
  .event-date { display:grid; grid-template-columns:auto 1fr auto; align-items:baseline; gap:clamp(.55rem,1.7vw,1.5rem); margin-bottom:1rem; padding:.82rem 1rem; border-radius:20px; background:#282421; color:#fff; font-variant-numeric:tabular-nums; }
  .event-date strong { font-size:clamp(2rem,3.6vw,3.55rem); line-height:.88; letter-spacing:-.055em; white-space:nowrap; }
  .event-date strong span { font-size:.72em; }
  .event-date > b { color:#e2bd62; font-size:clamp(1rem,1.55vw,1.35rem); }
  .event-date time { font-size:clamp(1.5rem,2.8vw,2.7rem); font-weight:900; }
  .desktop-event-page h1 { max-width:17ch; margin:.25rem 0 .85rem; font-size:clamp(2.25rem,min(4.35vw,7vh),5.15rem); line-height:.94; letter-spacing:-.055em; overflow-wrap:anywhere; }
  .event-place { display:grid; grid-template-columns:1.35rem minmax(0,1fr); gap:.65rem; margin:.6rem 0 0; }
  .event-place :global(.icon) { width:1.35rem; height:1.35rem; color:var(--rust); }
  .event-place span { display:grid; gap:.08rem; }
  .event-place strong { font-size:1.02rem; }
  .event-place small { color:var(--muted); font-weight:700; }
  .event-actions { display:grid; gap:.75rem; padding:1rem; border-radius:24px; background:#282421; color:#fffaf2; box-shadow:0 18px 45px rgba(42,27,19,.24); }
  .event-actions > p { display:grid; gap:.1rem; margin:0; }
  .event-actions > p span { color:#cfc1b6; font-size:.7rem; font-weight:850; letter-spacing:.09em; text-transform:uppercase; }
  .event-actions > p strong { font-size:1.25rem; }
  .event-actions__primary { min-height:58px; display:flex; align-items:center; justify-content:center; gap:.6rem; padding:.65rem 1rem; border-radius:18px; background:#b84a20; color:#fff; font-size:1.05rem; font-weight:900; text-decoration:none; }
  .event-actions__primary :global(.icon) { width:1.55rem; height:1.55rem; }
  .event-actions__secondary { display:flex; gap:.6rem; }
  .event-actions__secondary button { min-width:56px; min-height:52px; display:inline-flex; align-items:center; justify-content:center; gap:.28rem; border:0; border-radius:15px; background:rgba(255,255,255,.08); color:#fff; font:inherit; cursor:pointer; }
  .event-actions__secondary :global(.icon) { width:29px; height:29px; }
  .event-actions__secondary b { font-size:.92rem; font-variant-numeric:tabular-nums; }
  .event-story { width:min(1500px,100%); min-height:calc(100svh - 72px); display:grid; grid-template-columns:minmax(420px,47%) minmax(0,1fr); margin-inline:auto; background:#fffaf2; }
  .event-story__media-column { position:relative; background:#dfd2c2; }
  .event-story__media { position:sticky; top:0; height:100svh; margin:0; overflow:hidden; background:#2b2927; }
  .event-story__media > img { width:100%; height:calc(100% + 70px); margin-top:-35px; display:block; object-fit:cover; object-position:50% 50%; transform:translate3d(0,var(--parallax-y,0),0) scale(1.025); }
  .desktop-event-page--gallery .event-story { grid-template-columns:min(50%,calc((100svh - 3rem) * var(--poster-ratio,.8))) minmax(0,1fr); background:#ede2d3; }
  .desktop-event-page--gallery .event-story__media-column { padding:1.5rem; }
  .desktop-event-page--gallery .event-story__media { top:1.5rem; height:calc(100svh - 3rem); box-shadow:0 20px 55px rgba(48,33,23,.2); }
  .desktop-event-page--gallery .event-story__media > img { height:100%; margin:0; object-fit:contain; transform:none; }
  .event-story__copy { display:grid; align-content:start; gap:1.2rem; padding:clamp(1.2rem,3vw,3rem); }
  .event-story__facts { min-height:calc(100svh - 250px); display:grid; align-content:start; }
  .event-story__actions { max-width:460px; }
  .event-editorial-copy { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(320px,.75fr); gap:2.2rem; padding-block:clamp(3rem,7vw,7rem); }
  .event-description { padding-block:clamp(2rem,4vw,4rem); }
  .section-label,.event-feedback>p,.section-heading>p,.transport-card__copy>p { margin:0 0 .55rem; color:#963c19; font-size:.72rem; font-weight:900; letter-spacing:.09em; text-transform:uppercase; }
  .event-description h2,.event-feedback h2,.section-heading h2,.transport-card h2 { margin:0 0 1rem; font-size:clamp(1.75rem,3vw,3.25rem); line-height:1; letter-spacing:-.04em; }
  .event-description__html { max-width:70ch; color:#3f332c; font-size:clamp(1rem,1.25vw,1.16rem); line-height:1.7; }
  .event-description__html :global(h3) { margin:1.8rem 0 .45rem; font-size:1.3rem; }
  .event-description__html :global(p),.event-description__html :global(blockquote) { margin:.65rem 0; }
  .event-description__html :global(blockquote) { padding:.8rem 1rem; border-left:4px solid var(--green); background:#edf2ed; }
  .event-feedback { align-self:start; display:grid; gap:.65rem; margin-block:clamp(2rem,4vw,4rem); padding:clamp(1.2rem,2.4vw,2rem); border:1px solid rgba(40,88,82,.2); border-radius:28px; background:#eef3ee; }
  .event-feedback ul { display:grid; gap:.55rem; margin:0; padding:0; list-style:none; }
  .event-feedback li { display:grid; grid-template-columns:1.35rem 1fr; gap:.55rem; padding:.65rem .7rem; border-radius:14px; background:rgba(255,255,255,.76); }
  .event-feedback li :global(.icon) { width:1.2rem; height:1.2rem; color:var(--green); }
  .event-feedback small { color:#65736d; }
  .section-heading { max-width:850px; }
  .section-heading>span { color:var(--muted); }
  .event-gallery { padding-block:clamp(4rem,8vw,8rem); scroll-margin-top:1rem; }
  .event-gallery__viewer { display:grid; grid-template-columns:minmax(0,1fr) 132px; gap:1rem; margin-top:2rem; }
  .event-gallery__focus { position:relative; min-height:560px; margin:0; overflow:hidden; border-radius:28px; background:#262321; }
  .event-gallery__focus img { width:100%; height:100%; position:absolute; inset:0; object-fit:contain; }
  .event-gallery__focus figcaption { position:absolute; left:1rem; bottom:1rem; padding:.42rem .62rem; border-radius:999px; background:rgba(20,17,15,.75); color:#fff; font-weight:800; }
  .event-gallery__rail { max-height:620px; display:grid; gap:.65rem; overflow:auto; }
  .event-gallery__thumb { height:92px; padding:0; overflow:hidden; border:3px solid transparent; border-radius:15px; background:#d8c8b5; cursor:pointer; }
  .event-gallery__thumb[aria-pressed="true"] { border-color:var(--rust); }
  .event-gallery__thumb img { width:100%; height:100%; object-fit:cover; }
  .event-gallery__more { margin-top:1rem; }
  .event-gallery__more summary { cursor:pointer; font-weight:900; }
  .event-gallery__more>div { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1rem; }
  .event-gallery__more img { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:18px; }
  .event-practical { padding-block:clamp(3rem,6vw,6rem); border-top:1px solid rgba(121,48,20,.15); }
  .event-practical__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:1.5rem; }
  .event-practical__grid article { display:grid; align-content:start; gap:.35rem; min-height:180px; padding:1.25rem; border-radius:22px; background:#f1e3d3; }
  .event-practical__grid span { color:#93401f; font-size:.72rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .event-practical__grid strong { font-size:1.22rem; }
  .event-practical__grid p { margin:0; color:var(--muted); }
  .event-practical__gate { display:grid; grid-template-columns:1.5rem 1fr; gap:.7rem; margin:1rem 0 0; padding:1rem; border-left:5px solid var(--green); background:#e8efea; }
  .event-practical__gate :global(.icon) { width:1.35rem; height:1.35rem; color:var(--green); }
  .transport-card { display:grid; grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr); gap:2rem; padding-block:clamp(3rem,6vw,6rem); }
  .transport-card__copy span,.transport-card__copy strong { display:block; margin-top:.75rem; }
  .transport-card__copy span { color:var(--muted); }
  .transport-card__copy strong { color:#8d3517; }
  .transport-card__media { min-height:290px; display:grid; grid-template-columns:auto 1fr auto 1fr auto; align-items:center; gap:.7rem; padding:2rem; border-radius:30px; background:linear-gradient(135deg,#254f4b,#18312f); color:#fff; box-shadow:0 24px 58px rgba(27,55,51,.22); }
  .transport-card__media i { height:3px; background:repeating-linear-gradient(90deg,#e7c765 0 12px,transparent 12px 18px); }
  .transport-card__media b { font-size:.8rem; text-align:center; }
  .transport-card__media small { grid-column:1/-1; align-self:end; color:#b9d0cb; text-align:right; }
  .related-events { padding-block:clamp(4rem,7vw,7rem); background:#26221f; color:#fffaf2; }
  .section-heading--light>p { color:#e3a484; }
  .section-heading--light>span { color:#cfc2b8; }
  .related-events__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .related-events__grid article { overflow:hidden; border-radius:22px; background:#fffaf2; color:var(--ink); }
  .related-events__grid img { width:100%; aspect-ratio:4/3; display:block; object-fit:cover; }
  .related-events__grid div { padding:1rem; }
  .related-events__grid span { color:#9d421f; font-size:.72rem; font-weight:900; text-transform:uppercase; }
  .related-events__grid h3 { margin:.35rem 0; font-size:1.2rem; line-height:1.05; }
