---
import Icon from '../Icon.astro';
import CalendarLink from '../CalendarLink.astro';
import EventCard from '../EventCard.astro';
import EventTokenMedallions from '../EventTokenMedallions.astro';
import type { EventImageAsset, PreviewEvent } from '../../lib/types';
import {
  displayDate,
  displayDateTime,
  displayWeekdayLong,
  eventAbsoluteUrl,
  eventActionHref,
  eventAdmissionLabel,
  eventTicketActionLabel,
  isCalendarEligible,
  isExternalHttpUrl,
  isTelephoneUrl,
  isTicketSoldOut,
  withBase,
} from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';

type Candidate = 'editorial' | 'split' | 'gallery' | 'reading';
type MediaPolicy = 'non-ocr' | 'ocr';

interface Props {
  event: PreviewEvent;
  related: PreviewEvent[];
  candidate: Candidate;
  mediaPolicy: MediaPolicy;
  transport?: boolean;
  heroImageIndex?: number;
  editorialRail?: boolean;
  autoRotate?: boolean;
  ocrSafeCover?: boolean;
}

type GalleryImage = {
  src: string;
  alt: string;
  image_text_mode: EventImageAsset['image_text_mode'];
  width?: number;
  height?: number;
  position?: string;
};

const {
  event,
  related,
  candidate,
  mediaPolicy,
  transport = false,
  heroImageIndex = 0,
  editorialRail = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  autoRotate = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  ocrSafeCover = false,
} = Astro.props;
const isOcr = mediaPolicy === 'ocr';
const heroAlt = event.image_alt || `Афиша события «${event.title}»`;
const rawAssets = event.image_assets || [];
const preferredAsset = rawAssets[heroImageIndex] || rawAssets[0];
const preferredUrl = eventImageUrl(preferredAsset?.src || event.image_url) || preferredAsset?.src || event.image_url || '';
const preferredWidth = preferredAsset?.width || 1600;
const preferredHeight = preferredAsset?.height || 1000;
const ratio = preferredWidth / preferredHeight;
const preferredPosition = preferredAsset?.recommended_object_position || event.image_object_position || '50% 50%';

const galleryImages = (() => {
  const out: GalleryImage[] = [];
  const seen = new Set<string>();
  const add = (asset: EventImageAsset | null | undefined, fallbackMode: PreviewEvent['image_text_mode']) => {
    const src = eventImageUrl(asset?.src) || asset?.src || '';
    if (!src || seen.has(src) || src.includes('files.catbox.moe')) return;
    seen.add(src);
    out.push({
      src,
      alt: asset?.alt || heroAlt,
      image_text_mode: asset?.image_text_mode || fallbackMode || 'unknown',
      width: asset?.width,
      height: asset?.height,
      position: asset?.recommended_object_position,
    });
  };
  if (preferredAsset) add(preferredAsset, event.image_text_mode);
  else if (event.image_url) {
    const src = eventImageUrl(event.image_url) || event.image_url;
    seen.add(src);
    out.push({ src, alt: heroAlt, image_text_mode: event.image_text_mode, width: preferredWidth, height: preferredHeight });
  }
  rawAssets.forEach((asset) => add(asset, event.image_text_mode));
  return out.slice(0, 12);
})();
const galleryId = `clean-hero-gallery-${event.id}`;
const galleryTitleId = `${galleryId}-title`;
const photoCount = galleryImages.length;
const readingImages = (galleryImages.filter((image) => image.image_text_mode === 'visual_only').length >= 2
  ? galleryImages.filter((image) => image.image_text_mode === 'visual_only')
  : galleryImages).slice(0, 5);
const railImages = (candidate === 'reading' ? readingImages : galleryImages).slice(0, 5);

const dateLabel = displayDate(event);
const weekdayLabel = displayWeekdayLong(event);
const dateTimeLabel = displayDateTime(event);
const placeLabel = [event.venue_name, event.city].filter(Boolean).join(' · ') || 'Место уточняется';
const addressLabel = event.address || event.city || 'Адрес уточняется';
const admissionLabel = event.ticket.is_free ? 'Бесплатно' : (event.ticket.price_label || 'Билеты');
const ctaHref = eventActionHref(event);
const ctaIsExternal = isExternalHttpUrl(ctaHref);
const ctaIsTelephone = isTelephoneUrl(ctaHref);
const soldOut = isTicketSoldOut(event);
const canAddToCalendar = isCalendarEligible(event);
const requiresExplicitBooking = event.ticket.kind === 'registration' || event.ticket.kind === 'phone';
const calendarPrimary = canAddToCalendar && (!ctaHref || (event.ticket.is_free && !requiresExplicitBooking));
const ctaLabel = !event.ticket.is_free && !event.ticket.price_label && ctaHref ? 'Билеты' : eventTicketActionLabel(event);
const canonicalUrl = eventAbsoluteUrl(event);
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count || 0;
const shareText = [event.title, dateTimeLabel, placeLabel, eventAdmissionLabel(event)].filter(Boolean).join('\n');
const shareImageType = preferredUrl.toLowerCase().includes('.webp') ? 'image/webp' : preferredUrl.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
---

<main
  class:list={['desktop-clean-event', `desktop-clean-event--${candidate}`, `desktop-clean-event--${mediaPolicy}`]}
  data-desktop-clean-event
  data-desktop-family={candidate}
  data-media-policy={mediaPolicy}
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-reading-scroll-gallery={candidate === 'reading' ? 'true' : undefined}
  data-event-id={event.id}
  style={`--image-ratio:${ratio};--image-position:${preferredPosition};`}
>
  <div class="desktop-clean-reading-shell">
  <article class:list={['desktop-prototype', 'desktop-prototype--clean', `desktop-prototype--${candidate}`, `desktop-prototype--${mediaPolicy}`]} data-clean-hero>
    <div class="desktop-prototype__canvas">
      <section class="desktop-prototype__stage" aria-labelledby={`clean-event-title-${event.id}`}>
        <figure class="desktop-prototype__media" data-media-frame data-ocr-safe-cover={ocrSafeCover ? 'true' : 'false'} data-desktop-parallax={isOcr ? undefined : ''}>
          {preferredUrl && (
            <button type="button" class="desktop-prototype__media-opener" data-hero-gallery-open={galleryId} aria-label={`Открыть фотографии события «${event.title}» на весь экран`}>
              <img
                class="desktop-prototype__media-image"
                data-clean-hero-image
                src={preferredUrl}
                alt={heroAlt}
                width={preferredWidth}
                height={preferredHeight}
                fetchpriority="high"
                decoding="async"
              />
            </button>
          )}
          {photoCount > 0 && (
            <button type="button" class="desktop-prototype__photo-count" data-hero-gallery-open={galleryId} aria-label={`Открыть ${photoCount} фото события на весь экран`}>
              <Icon name="image" /><span>{photoCount > 1 ? `${photoCount} фото` : 'Открыть фото'}</span>
            </button>
          )}
          {editorialRail && railImages.length > 1 && (
            <div class="desktop-prototype__media-rail" data-hero-rail aria-label="Выбрать фотографию в hero">
              {railImages.map((image, index) => (
                <button
                  type="button"
                  class:list={[index === 0 && 'is-current']}
                  data-clean-hero-thumb
                  data-index={index}
                  data-src={image.src}
                  data-alt={image.alt}
                  data-mode={image.image_text_mode}
                  data-width={image.width || 1600}
                  data-height={image.height || 1000}
                  data-position={image.position || '50% 50%'}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  aria-label={`Показать фото ${index + 1} из ${railImages.length}`}
                >
                  <img src={image.src} alt="" width={image.width || 160} height={image.height || 100} loading="lazy" decoding="async" />
                </button>
              ))}
              {autoRotate && <button type="button" class="desktop-prototype__rotation-toggle" data-hero-rotation-toggle aria-pressed="true" aria-label="Остановить автоматическую смену фотографий">Авто</button>}
            </div>
          )}
          {candidate === 'editorial' && !isOcr && (
            <aside class="desktop-prototype__action desktop-prototype__action--media" data-feedback-scope aria-label="Действия события">
              <p><span>вход</span><strong>{admissionLabel}</strong></p>
              {calendarPrimary ? (
                <CalendarLink event={event} className="desktop-prototype__primary-action" label="Добавить в календарь" />
              ) : ctaHref ? (
                <a class="desktop-prototype__primary-action" href={ctaHref} target={ctaIsExternal ? '_blank' : undefined} rel={ctaIsExternal ? 'noopener noreferrer nofollow' : undefined}>
                  <Icon name={ctaIsTelephone ? 'phone' : 'ticket'} /><span>{ctaLabel}</span>
                </a>
              ) : soldOut ? (
                <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Билеты закончились</span>
              ) : canAddToCalendar ? (
                <CalendarLink event={event} className="desktop-prototype__primary-action" label="Добавить в календарь" />
              ) : (
                <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Информация уточняется</span>
              )}
              <div class="desktop-prototype__action-row event-hero__metric-row">
                {!calendarPrimary && <CalendarLink event={event} className="desktop-prototype__icon-action" compact />}
                <button type="button" class="desktop-prototype__icon-action" data-nosnippet data-native-share data-share-event-id={event.id} data-share-event-title={event.title} data-share-base-count={sharesCount} data-share-title={event.title} data-share-text={shareText} data-share-url={canonicalUrl} data-share-image={preferredUrl} data-share-image-type={shareImageType} data-share-file-name={shareFileName} data-share-date-time={dateTimeLabel} data-share-place={placeLabel} data-share-admission={admissionLabel} aria-label={`Поделиться: ${event.title}. Сейчас ${sharesCount}`} title="Поделиться"><Icon name="share" /><strong data-share-count>{sharesCount}</strong></button>
                <button type="button" class="desktop-prototype__icon-action feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={`Нравится: ${event.title}. Сейчас ${likesCount}`} title="Нравится"><Icon name="heart" /><strong data-feedback-count>{likesCount}</strong></button>
              </div>
            </aside>
          )}
        </figure>

        <div class="desktop-prototype__info" data-title-panel>
          <p class="desktop-prototype__kicker">
            <span>{event.event_type || 'событие'}</span>
            <time datetime={event.starts_at || event.start_date}>
              <strong>{dateLabel}</strong>
              {weekdayLabel && <b>{weekdayLabel}</b>}
              {event.display_time && <strong>{event.display_time}</strong>}
            </time>
          </p>
          <h1 id={`clean-event-title-${event.id}`} data-event-title>{event.title}</h1>
          {candidate === 'editorial' && isOcr && <p class="desktop-prototype__digest" data-event-digest>{event.summary}</p>}
          <p class="desktop-prototype__place">
            <Icon name="pin" />
            <span><strong>{event.venue_name || event.city || 'Место уточняется'}</strong><small>{addressLabel}</small></span>
          </p>
          <div class="desktop-prototype__medallions"><EventTokenMedallions event={event} /></div>
        </div>

        <aside class="desktop-prototype__action desktop-prototype__action--flow" data-feedback-scope aria-label="Действия события">
          <p><span>вход</span><strong>{admissionLabel}</strong></p>
          {calendarPrimary ? (
            <CalendarLink event={event} className="desktop-prototype__primary-action" label="Добавить в календарь" />
          ) : ctaHref ? (
            <a class="desktop-prototype__primary-action" href={ctaHref} target={ctaIsExternal ? '_blank' : undefined} rel={ctaIsExternal ? 'noopener noreferrer nofollow' : undefined}>
              <Icon name={ctaIsTelephone ? 'phone' : 'ticket'} /><span>{ctaLabel}</span>
            </a>
          ) : soldOut ? (
            <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Билеты закончились</span>
          ) : canAddToCalendar ? (
            <CalendarLink event={event} className="desktop-prototype__primary-action" label="Добавить в календарь" />
          ) : (
            <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Информация уточняется</span>
          )}
          <div class="desktop-prototype__action-row event-hero__metric-row">
            {!calendarPrimary && <CalendarLink event={event} className="desktop-prototype__icon-action" compact />}
            <button
              type="button"
              class="desktop-prototype__icon-action"
              data-nosnippet
              data-native-share
              data-share-event-id={event.id}
              data-share-event-title={event.title}
              data-share-base-count={sharesCount}
              data-share-title={event.title}
              data-share-text={shareText}
              data-share-url={canonicalUrl}
              data-share-image={preferredUrl}
              data-share-image-type={shareImageType}
              data-share-file-name={shareFileName}
              data-share-date-time={dateTimeLabel}
              data-share-place={placeLabel}
              data-share-admission={admissionLabel}
              aria-label={`Поделиться: ${event.title}. Сейчас ${sharesCount}`}
              title="Поделиться"
            ><Icon name="share" /><strong data-share-count>{sharesCount}</strong></button>
            <button
              type="button"
              class="desktop-prototype__icon-action feedback-button--like"
              data-nosnippet
              data-feedback-action="like"
              data-event-id={event.id}
              data-event-title={event.title}
              data-base-count={likesCount}
              aria-pressed="false"
              aria-label={`Нравится: ${event.title}. Сейчас ${likesCount}`}
              title="Нравится"
            ><Icon name="heart" /><strong data-feedback-count>{likesCount}</strong></button>
          </div>
        </aside>
      </section>
    </div>
  </article>

  <section class="desktop-clean-story page-shell" aria-labelledby={`about-${event.id}`}>
    <article class="desktop-clean-description">
      <p class="eyebrow">О событии</p>
      <h2 id={`about-${event.id}`}>{event.summary || event.title}</h2>
      <div class="desktop-clean-description__text prose" set:html={event.description_html} />
    </article>
    <aside class="desktop-clean-feedback" aria-labelledby={`feedback-${event.id}`}>
      <span class="desktop-clean-feedback__icon"><Icon name="spark" /></span>
      <div>
        <p class="eyebrow">Что говорят</p>
        <h2 id={`feedback-${event.id}`}>Общего вывода пока нет</h2>
        <p>Отзывов недостаточно, чтобы уверенно выделить повторяющиеся впечатления.</p>
      </div>
    </aside>
  </section>

  <section class="desktop-clean-practical page-shell" aria-labelledby={`practical-${event.id}`}>
    <p class="eyebrow">Перед посещением</p>
    <h2 id={`practical-${event.id}`}>Всё главное в одном месте</h2>
    <div class="desktop-clean-practical__grid">
      <article><Icon name="calendar" /><span>Когда</span><strong>{dateTimeLabel}</strong></article>
      <article><Icon name="pin" /><span>Где</span><strong>{event.venue_name || event.city || 'Место уточняется'}</strong><small>{addressLabel}</small></article>
      <article><Icon name="ticket" /><span>Вход</span><strong>{admissionLabel}</strong></article>
    </div>
  </section>

  {transport && event.city && event.city !== 'Калининград' && (
    <section class="desktop-clean-travel page-shell" aria-labelledby={`travel-${event.id}`}>
      <div>
        <p class="eyebrow">Как добраться</p>
        <h2 id={`travel-${event.id}`}>Калининград → {event.city}</h2>
        <p>Расписание пока уточняется. Проверьте время отправления перед поездкой.</p>
      </div>
      <div class="desktop-clean-travel__route" aria-label={`Маршрут Калининград — ${event.city}`}>
        <span>Калининград</span><i></i><b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3l2 3h-2.3l-1.4-2H8.7l-1.4 2H5l2-3a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v5h12V6a1 1 0 0 0-1-1H7Zm1 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"/></svg> электричка · автобус</b><i></i><span>{event.city}</span>
      </div>
    </section>
  )}
  </div>

  <section class="desktop-clean-related" data-related-start aria-labelledby={`related-${event.id}`}>
    <div class="page-shell">
      <header>
        <p class="eyebrow">Продолжить выбор</p>
        <h2 id={`related-${event.id}`}>Смотрите дальше</h2>
      </header>
      <div class="cards-grid cards-grid--immersive desktop-clean-related__grid" data-lab-row-normalize data-lab-crop-budget="0.15">
        {related.map((item) => <EventCard event={item} variant="split-actions" />)}
      </div>
    </div>
  </section>

  {photoCount > 0 && (
    <div class="hero-gallery" id={galleryId} data-hero-gallery data-active-index="0" role="dialog" aria-modal="true" aria-labelledby={galleryTitleId} tabindex="-1" hidden>
      <div class="hero-gallery__chrome" aria-hidden="true"></div>
      <div class="hero-gallery__topbar">
        <a class="hero-gallery__brand" href={withBase('/__preview/')} aria-label="Перейти к афише Полюбить Калининград Анонсы"><span>Полюбить Калининград</span><strong>Анонсы</strong></a>
        <h2 id={galleryTitleId} class="sr-only">Фото события: {event.title}</h2>
        <button type="button" class="hero-gallery__close" data-hero-gallery-close aria-label="Закрыть просмотр фото">×</button>
      </div>
      <div class="hero-gallery__viewport">
        <div class="hero-gallery__track" data-hero-gallery-track>
          {galleryImages.map((image, index) => (
            <figure class="hero-gallery__slide" data-hero-gallery-slide data-gallery-slide-kind="image" data-gallery-index={index} aria-hidden={index === 0 ? 'false' : 'true'}>
              <img class="hero-gallery__image" data-gallery-src={image.src} alt={image.alt} loading="lazy" decoding="async" data-image-text-mode={image.image_text_mode} data-event-id={event.id} data-event-title={event.title} style={image.position ? `object-position:${image.position}` : undefined} />
              <figcaption class="sr-only">Фото события: {event.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="hero-gallery__caption" aria-hidden="true"><span>Фото события</span><strong>{event.title}</strong></div>
      {photoCount > 1 && <><button type="button" class="hero-gallery__nav hero-gallery__nav--prev" data-hero-gallery-prev aria-label="Предыдущее фото">‹</button><button type="button" class="hero-gallery__nav hero-gallery__nav--next" data-hero-gallery-next aria-label="Следующее фото">›</button></>}
      <div class="hero-gallery__counter" data-hero-gallery-counter>{`1 / ${photoCount}`}</div>
    </div>
  )}

  <script>
    const cleanRoot = document.querySelector<HTMLElement>('[data-desktop-clean-event]');
    if (cleanRoot) {
      document.body.classList.add('desktop-clean-event-page');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mediaFrame = cleanRoot.querySelector<HTMLElement>('[data-media-frame]');
      const heroImage = cleanRoot.querySelector<HTMLImageElement>('[data-clean-hero-image]');
      const thumbButtons = Array.from(cleanRoot.querySelectorAll<HTMLButtonElement>('[data-clean-hero-thumb]'));
      const rotationToggle = cleanRoot.querySelector<HTMLButtonElement>('[data-hero-rotation-toggle]');
      let frame = 0;
      let imageRequest = 0;
      let rotationEnabled = cleanRoot.dataset.autoRotate === 'true';
      let mediaHovered = false;

      const clamp = (value:number, min=0, max=1) => Math.max(min, Math.min(max, value));
      const markRotation = () => {
        if (!rotationToggle) return;
        rotationToggle.setAttribute('aria-pressed', rotationEnabled ? 'true' : 'false');
        rotationToggle.setAttribute('aria-label', rotationEnabled ? 'Остановить автоматическую смену фотографий' : 'Включить автоматическую смену фотографий');
        rotationToggle.textContent = rotationEnabled ? 'Авто' : 'Пауза';
      };

      const selectHero = async (index:number, source:'manual'|'auto'|'scroll'='manual') => {
        if (!heroImage || !thumbButtons.length) return;
        if (source === 'manual' && cleanRoot.dataset.readingScrollGallery !== 'true') {
          rotationEnabled = false;
          markRotation();
        }
        const next = Math.max(0, Math.min(thumbButtons.length - 1, index));
        const button = thumbButtons[next];
        const src = button?.dataset.src;
        if (!button || !src) return;
        const token = ++imageRequest;
        const probe = new Image();
        probe.src = src;
        try { await probe.decode(); } catch {}
        if (token !== imageRequest) return;
        heroImage.src = src;
        heroImage.alt = button.dataset.alt || heroImage.alt;
        heroImage.width = Number(button.dataset.width || probe.naturalWidth || heroImage.width);
        heroImage.height = Number(button.dataset.height || probe.naturalHeight || heroImage.height);
        heroImage.style.objectPosition = button.dataset.position || '50% 50%';
        thumbButtons.forEach((item, itemIndex) => {
          const current = itemIndex === next;
          item.setAttribute('aria-pressed', current ? 'true' : 'false');
          item.classList.toggle('is-current', current);
        });
        cleanRoot.dataset.activeHeroIndex = String(next);
      };

      const readingScrollTarget = (index:number) => {
        const related = cleanRoot.querySelector<HTMLElement>('[data-related-start]');
        if (!related || thumbButtons.length < 2) return window.scrollY;
        const start = cleanRoot.offsetTop;
        const end = Math.max(start, related.offsetTop - window.innerHeight);
        return start + (end - start) * (index / (thumbButtons.length - 1));
      };

      thumbButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          if (cleanRoot.dataset.readingScrollGallery === 'true') {
            window.scrollTo({ top:readingScrollTarget(index), behavior:reducedMotion.matches ? 'auto' : 'smooth' });
          } else {
            void selectHero(index, 'manual');
          }
        });
      });
      rotationToggle?.addEventListener('click', () => {
        rotationEnabled = !rotationEnabled;
        markRotation();
      });
      mediaFrame?.addEventListener('pointerenter', () => { mediaHovered = true; });
      mediaFrame?.addEventListener('pointerleave', () => { mediaHovered = false; });
      markRotation();

      window.setInterval(() => {
        if (!rotationEnabled || reducedMotion.matches || mediaHovered || document.visibilityState !== 'visible' || window.scrollY > 4 || !mediaFrame || !thumbButtons.length) return;
        const rect = mediaFrame.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;
        const current = Number(cleanRoot.dataset.activeHeroIndex || '0');
        void selectHero((current + 1) % thumbButtons.length, 'auto');
      }, 8500);

      const updateReadingImage = () => {
        if (cleanRoot.dataset.readingScrollGallery !== 'true' || thumbButtons.length < 2) return;
        const related = cleanRoot.querySelector<HTMLElement>('[data-related-start]');
        if (!related) return;
        const start = cleanRoot.offsetTop;
        const end = Math.max(start + 1, related.offsetTop - window.innerHeight);
        const progress = clamp((window.scrollY - start) / (end - start));
        const next = Math.min(thumbButtons.length - 1, Math.floor(progress * thumbButtons.length));
        if (Number(cleanRoot.dataset.activeHeroIndex || '0') !== next) void selectHero(next, 'scroll');
      };

      const updateParallax = () => {
        frame = 0;
        cleanRoot.querySelectorAll<HTMLElement>('[data-desktop-parallax]').forEach((media) => {
          if (reducedMotion.matches) {
            media.style.setProperty('--desktop-parallax-y', '0px');
            return;
          }
          const viewport = window.innerHeight || 800;
          const stage = media.closest<HTMLElement>('.desktop-prototype__stage');
          let progress = 0;
          let amplitude = 48;
          if (stage && cleanRoot.dataset.desktopFamily === 'editorial') {
            const rect = stage.getBoundingClientRect();
            const travel = Math.max(1, rect.height - viewport + 73);
