---
import Icon from '../Icon.astro';
import EventCard from '../EventCard.astro';
import EventTokenMedallions from '../EventTokenMedallions.astro';
import DesktopEventActionPanel from './DesktopEventActionPanel.astro';
import type { EventImageAsset, PreviewEvent } from '../../lib/types';
import {
  displayDate,
  displayDateTime,
  displayWeekdayLong,
  withBase,
} from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';

type Candidate = 'editorial' | 'split';
type MediaPolicy = 'non-ocr' | 'ocr';
type EditorialMotion = 'pinned' | 'continuous';
type SplitMediaFit = 'natural' | 'viewport-cover';
type RelatedMediaTreatment = 'cover' | 'ambient' | 'hybrid';

interface Props {
  event: PreviewEvent;
  related: PreviewEvent[];
  candidate: Candidate;
  mediaPolicy: MediaPolicy;
  transport?: boolean;
  heroImageIndex?: number;
  heroWidth?: number;
  heroHeight?: number;
  heroObjectPosition?: string;
  editorialRail?: boolean;
  editorialMotion?: EditorialMotion;
  ocrCompanionImageIndex?: number;
  autoRotate?: boolean;
  ocrSafeCover?: boolean;
  ocrSourceIndexes?: number[];
  duplicateSourceIndexes?: number[];
  splitMediaFit?: SplitMediaFit;
  relatedMediaTreatment?: RelatedMediaTreatment;
}

type GalleryImage = {
  src: string;
  alt: string;
  image_text_mode: EventImageAsset['image_text_mode'];
  width?: number;
  height?: number;
  position?: string;
  sourceIndex?: number;
};

const {
  event,
  related,
  candidate,
  mediaPolicy,
  transport = false,
  heroImageIndex = 0,
  heroWidth,
  heroHeight,
  heroObjectPosition,
  editorialRail = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  editorialMotion = 'pinned',
  ocrCompanionImageIndex,
  autoRotate = candidate === 'editorial' && mediaPolicy === 'non-ocr',
  ocrSafeCover = false,
  ocrSourceIndexes = [],
  duplicateSourceIndexes = [],
  splitMediaFit = 'natural',
  relatedMediaTreatment = 'hybrid',
} = Astro.props;
const forcedOcrSourceIndexes = new Set(ocrSourceIndexes);
const hiddenDuplicateSourceIndexes = new Set(duplicateSourceIndexes);
const heroAlt = event.image_alt || `Афиша события «${event.title}»`;
const rawAssets = event.image_assets || [];
const preferredAsset = rawAssets[heroImageIndex] || rawAssets[0];
const preferredUrl = eventImageUrl(preferredAsset?.src || event.image_url) || preferredAsset?.src || event.image_url || '';
const preferredWidth = heroWidth || preferredAsset?.width || 1600;
const preferredHeight = heroHeight || preferredAsset?.height || 1000;
const ratio = preferredWidth / preferredHeight;
const preferredPosition = heroObjectPosition || preferredAsset?.recommended_object_position || event.image_object_position || '50% 50%';
const selectedMediaMode = forcedOcrSourceIndexes.has(heroImageIndex)
  ? 'ocr_text'
  : preferredAsset?.image_text_mode || event.image_text_mode || 'unknown';
const selectedHeroIsOcr = selectedMediaMode !== 'visual_only';

const galleryImages = (() => {
  const out: GalleryImage[] = [];
  const seen = new Set<string>();
  const add = (asset: EventImageAsset | null | undefined, fallbackMode: PreviewEvent['image_text_mode'], sourceIndex?: number) => {
    const src = eventImageUrl(asset?.src) || asset?.src || '';
    if (!src || seen.has(src) || src.includes('files.catbox.moe')) return;
    seen.add(src);
    out.push({
      src,
      alt: asset?.alt || heroAlt,
      image_text_mode: sourceIndex !== undefined && forcedOcrSourceIndexes.has(sourceIndex)
        ? 'ocr_text'
        : asset?.image_text_mode || fallbackMode || 'unknown',
      width: asset?.width,
      height: asset?.height,
      position: asset?.recommended_object_position,
      sourceIndex,
    });
  };
  if (preferredAsset) add(preferredAsset, event.image_text_mode, heroImageIndex);
  else if (event.image_url) {
    const src = eventImageUrl(event.image_url) || event.image_url;
    seen.add(src);
    out.push({ src, alt: heroAlt, image_text_mode: event.image_text_mode, width: preferredWidth, height: preferredHeight });
  }
  rawAssets.forEach((asset, index) => add(asset, event.image_text_mode, index));
  return out.slice(0, 12);
})();
const galleryId = `clean-hero-gallery-${event.id}`;
const galleryTitleId = `${galleryId}-title`;
const photoCount = galleryImages.length;
const railCellLimit = 6;
const indexedGalleryImages = galleryImages.map((image, galleryIndex) => ({ image, galleryIndex }));
const ocrCompanion = ocrCompanionImageIndex === undefined
  ? undefined
  : indexedGalleryImages.find(({ image }) => image.sourceIndex === ocrCompanionImageIndex);
const editorialRailCandidates = indexedGalleryImages.filter(({ galleryIndex }) => galleryIndex !== ocrCompanion?.galleryIndex);
const editorialRailImages = editorialRailCandidates.slice(0, editorialRailCandidates.length > railCellLimit ? railCellLimit - 1 : railCellLimit);
const editorialRailRemainingCount = editorialRailCandidates.length - editorialRailImages.length;
// Gallery keeps every source rendition so its source indexes remain stable. The compact rail,
// however, only advertises distinct media identities supplied by the upstream/lab contract.
const splitRailCandidates = indexedGalleryImages.filter(({ image, galleryIndex }) => galleryIndex !== 0 && !hiddenDuplicateSourceIndexes.has(image.sourceIndex ?? -1));
const splitRailImages = splitRailCandidates.slice(0, splitRailCandidates.length > railCellLimit ? railCellLimit - 1 : railCellLimit);
const splitRailRemainingCount = splitRailCandidates.length - splitRailImages.length;
const railAspectBucket = (image: GalleryImage) => {
  const imageRatio = image.width && image.height ? image.width / image.height : 1;
  if (imageRatio < .9) return 'portrait';
  if (imageRatio > 1.18) return 'landscape';
  return 'square';
};
const usesLongFlow = true;

const dateLabel = displayDate(event);
const weekdayLabel = displayWeekdayLong(event);
const dateTimeLabel = displayDateTime(event);
const addressLabel = event.address || event.city || 'Адрес уточняется';
const admissionLabel = event.ticket.is_free ? 'Бесплатно' : (event.ticket.price_label || 'Билеты');
// The page owns the section heading; source descriptions occasionally repeat it.
// Remaining source headings are lowered one semantic level so they cannot compete with the event H1.
const descriptionHtml = (event.description_html || '')
  .replace(/<h([2-6])[^>]*>\s*О событии[^<]*<\/h\1>/giu, '')
  .replace(/<(\/?)h([2-5])([^>]*)>/giu, (_match, closing, level, attrs) => closing
    ? `</h${Number(level) + 1}>`
    : `<h${Number(level) + 1}${attrs}>`);
---

<main
  class:list={['desktop-clean-event', `desktop-clean-event--${candidate}`, `desktop-clean-event--${mediaPolicy}`, selectedHeroIsOcr ? 'desktop-clean-event--hero-ocr' : 'desktop-clean-event--hero-photo']}
  data-desktop-clean-event
  data-desktop-family={candidate}
  data-media-policy={mediaPolicy}
  data-selected-media-policy={selectedMediaMode}
  data-editorial-motion={candidate === 'editorial' ? editorialMotion : undefined}
  data-split-media-fit={candidate === 'split' ? splitMediaFit : undefined}
  data-related-media-treatment={relatedMediaTreatment}
  data-auto-rotate={autoRotate ? 'true' : 'false'}
  data-event-id={event.id}
  style={`--image-ratio:${ratio};--image-position:${preferredPosition};--media-count:${Math.max(1, photoCount)};`}
>
  <div class="desktop-clean-reading-shell">
  <article class:list={['desktop-prototype', 'desktop-prototype--clean', `desktop-prototype--${candidate}`, `desktop-prototype--${mediaPolicy}`]} data-clean-hero>
    <div class="desktop-prototype__canvas">
      <section
        class="desktop-prototype__stage"
        data-scroll-stage={usesLongFlow ? '' : undefined}
        data-scroll-kind={candidate}
        aria-labelledby={`clean-event-title-${event.id}`}
      >
        {candidate === 'split' ? (
          <figure class="desktop-prototype__media desktop-prototype__media--poster-scroll" data-media-frame data-slow-media-viewport data-split-media-fit={splitMediaFit}>
            <div class="desktop-poster-track" data-slow-media-track data-slow-media-speed="0.36">
              <button type="button" class="desktop-prototype__media-opener" data-hero-gallery-open={galleryId} data-hero-gallery-index="0" aria-label={`Открыть афишу события «${event.title}» на весь экран`}>
                <img class="desktop-prototype__media-image" data-clean-hero-image src={preferredUrl} alt={heroAlt} width={preferredWidth} height={preferredHeight} fetchpriority="high" decoding="async" />
              </button>
              {splitRailImages.length > 0 && (
                <div class="desktop-prototype__media-rail desktop-prototype__media-rail--poster" data-split-media-rail aria-label="Другие изображения события">
                  {splitRailImages.map(({ image, galleryIndex }) => (
                    <button type="button" data-rail-aspect={railAspectBucket(image)} data-image-text-mode={image.image_text_mode} data-source-index={image.sourceIndex} data-hero-gallery-open={galleryId} data-hero-gallery-index={galleryIndex} aria-label={image.image_text_mode === 'ocr_text' ? `Открыть афишу, изображение ${galleryIndex + 1}` : `Открыть фото ${galleryIndex + 1}`}>
                      <img src={image.src} alt="" width={image.width || 160} height={image.height || 100} loading="lazy" decoding="async" />
                      {image.image_text_mode === 'ocr_text' && <span>Афиша</span>}
                    </button>
                  ))}
                  {splitRailRemainingCount > 0 && (
                    <button type="button" class="desktop-prototype__media-rail-more" data-remaining-count={splitRailRemainingCount} data-hero-gallery-open={galleryId} data-hero-gallery-index={splitRailImages.at(-1)!.galleryIndex + 1} aria-label={`Открыть ещё ${splitRailRemainingCount} фото`}>
                      <strong>+{splitRailRemainingCount}</strong><span>фото</span>
                    </button>
                  )}
                </div>
              )}
            </div>
          </figure>
        ) : (
          <figure class="desktop-prototype__media" data-media-frame data-ocr-safe-cover={ocrSafeCover ? 'true' : 'false'} data-desktop-parallax={selectedHeroIsOcr ? undefined : ''} data-editorial-media>
            {preferredUrl && (
              <button type="button" class="desktop-prototype__media-opener" data-hero-gallery-open={galleryId} data-hero-gallery-index="0" aria-label={`Открыть фотографии события «${event.title}» на весь экран`}>
                <img class="desktop-prototype__media-image" data-clean-hero-image src={preferredUrl} alt={heroAlt} width={preferredWidth} height={preferredHeight} fetchpriority="high" decoding="async" />
              </button>
            )}
            {photoCount > 0 && !(editorialRail && editorialRailImages.length > 1) && <button type="button" class="desktop-prototype__photo-count" data-hero-gallery-open={galleryId} data-hero-gallery-index="0" aria-label={`Открыть ${photoCount} фото события на весь экран`}><Icon name="image" /><span>{photoCount > 1 ? `${photoCount} фото` : 'Открыть фото'}</span></button>}
          </figure>
        )}

        {candidate === 'editorial' && (
          <aside class="desktop-editorial-side" data-editorial-side>
            <DesktopEventActionPanel event={event} shareImage={preferredUrl} className="desktop-prototype__action--side" />
            {ocrCompanion && (
              <button
                type="button"
                class="desktop-editorial-companion"
                data-editorial-ocr-companion
                data-source-index={ocrCompanion.image.sourceIndex}
                data-hero-gallery-open={galleryId}
                data-hero-gallery-index={ocrCompanion.galleryIndex}
                aria-label="Открыть афишу события на весь экран"
              >
                <span class="desktop-editorial-companion__image">
                  <img src={ocrCompanion.image.src} alt="" width={ocrCompanion.image.width || 800} height={ocrCompanion.image.height || 1200} loading="lazy" decoding="async" />
                </span>
                <span class="desktop-editorial-companion__copy"><small>Оригинальная афиша</small><strong>Открыть полностью</strong></span>
                <Icon name="image" />
              </button>
            )}
            {editorialRail && editorialRailImages.length > 1 && (
              <div class="desktop-prototype__media-rail" data-hero-rail aria-label="Выбрать изображение">
                {editorialRailImages.map(({ image, galleryIndex }, index) => (
                  <button type="button" class:list={[index === 0 && 'is-current']} data-image-text-mode={image.image_text_mode} data-source-index={image.sourceIndex} data-hero-gallery-open={galleryId} data-hero-gallery-index={galleryIndex} aria-label={image.image_text_mode === 'ocr_text' ? `Открыть афишу в полноэкранной галерее, фото ${galleryIndex + 1}` : `Открыть фото ${galleryIndex + 1} в полноэкранной галерее`}>
                    <img src={image.src} alt="" width={image.width || 160} height={image.height || 100} loading="lazy" decoding="async" />
                    {image.image_text_mode === 'ocr_text' && <span>Афиша</span>}
                  </button>
                ))}
                {editorialRailRemainingCount > 0 && (
                  <button
                    type="button"
                    class="desktop-prototype__media-rail-more"
                    data-hero-rail-more
                    data-remaining-count={editorialRailRemainingCount}
                    data-hero-gallery-open={galleryId}
                    data-hero-gallery-index={editorialRailImages.at(-1)!.galleryIndex + 1}
                    aria-label={`Открыть ещё ${editorialRailRemainingCount} фото`}
                  >
                    <strong>+{editorialRailRemainingCount}</strong><span>фото</span>
                  </button>
                )}
              </div>
            )}
          </aside>
        )}

        <div class:list={['desktop-prototype__content-flow', usesLongFlow && 'desktop-prototype__content-flow--long']} data-scroll-content={usesLongFlow ? '' : undefined}>
          <div class="desktop-prototype__info" data-title-panel>
            <p class="desktop-prototype__kicker">
              <span>{event.event_type || 'событие'}</span>
              <time datetime={event.starts_at || event.start_date}><strong>{dateLabel}</strong>{weekdayLabel && <b>{weekdayLabel}</b>}{event.display_time && <strong>{event.display_time}</strong>}</time>
            </p>
            <h1 id={`clean-event-title-${event.id}`} data-event-title>{event.title}</h1>
            {candidate === 'editorial' && <p class="desktop-prototype__digest" data-event-digest>{event.summary}</p>}
            <p class="desktop-prototype__place"><Icon name="pin" /><span><strong>{event.venue_name || event.city || 'Место уточняется'}</strong><small>{addressLabel}</small></span></p>
            <div class="desktop-prototype__medallions"><EventTokenMedallions event={event} /></div>
          </div>

          {usesLongFlow && candidate !== 'editorial' && <DesktopEventActionPanel event={event} shareImage={preferredUrl} className="desktop-prototype__action--inline" />}

          {usesLongFlow && (
            <div class="desktop-prototype__flow-body" data-continuous-event-body>
              <article class="desktop-clean-description">
                <h2 class="desktop-clean-description__heading" id={`about-${event.id}`}>О событии</h2>
                <p class="desktop-clean-description__lead">{event.summary || event.title}</p>
                <div class="desktop-clean-description__text prose" set:html={descriptionHtml} />
              </article>
              <aside class="desktop-clean-feedback" aria-labelledby={`feedback-${event.id}`}>
                <span class="desktop-clean-feedback__icon"><Icon name="spark" /></span>
                <div><p class="eyebrow">Что говорят</p><h2 id={`feedback-${event.id}`}>Общего вывода пока нет</h2><p>Отзывов недостаточно, чтобы уверенно выделить повторяющиеся впечатления.</p></div>
              </aside>
              <section class="desktop-clean-practical" aria-labelledby={`practical-${event.id}`}>
                <p class="eyebrow">Перед посещением</p><h2 id={`practical-${event.id}`}>Всё главное в одном месте</h2>
                <div class="desktop-clean-practical__grid">
                  <article><Icon name="calendar" /><span>Когда</span><strong>{dateTimeLabel}</strong></article>
                  <article><Icon name="pin" /><span>Где</span><strong>{event.venue_name || event.city || 'Место уточняется'}</strong><small>{addressLabel}</small></article>
                  <article><Icon name="ticket" /><span>Вход</span><strong>{admissionLabel}</strong></article>
                </div>
              </section>
            </div>
          )}
        </div>

        {!usesLongFlow && <DesktopEventActionPanel event={event} shareImage={preferredUrl} className="desktop-prototype__action--flow" />}
      </section>
    </div>
  </article>

  {!usesLongFlow && <section class="desktop-clean-story page-shell" aria-labelledby={`about-${event.id}`}>
    <article class="desktop-clean-description">
      <h2 class="desktop-clean-description__heading" id={`about-${event.id}`}>О событии</h2>
      <p class="desktop-clean-description__lead">{event.summary || event.title}</p>
      <div class="desktop-clean-description__text prose" set:html={descriptionHtml} />
    </article>
    <aside class="desktop-clean-feedback" aria-labelledby={`feedback-${event.id}`}>
      <span class="desktop-clean-feedback__icon"><Icon name="spark" /></span>
      <div>
        <p class="eyebrow">Что говорят</p>
        <h2 id={`feedback-${event.id}`}>Общего вывода пока нет</h2>
        <p>Отзывов недостаточно, чтобы уверенно выделить повторяющиеся впечатления.</p>
      </div>
    </aside>
  </section>}

  {!usesLongFlow && <section class="desktop-clean-practical page-shell" aria-labelledby={`practical-${event.id}`}>
    <p class="eyebrow">Перед посещением</p>
    <h2 id={`practical-${event.id}`}>Всё главное в одном месте</h2>
    <div class="desktop-clean-practical__grid">
      <article><Icon name="calendar" /><span>Когда</span><strong>{dateTimeLabel}</strong></article>
      <article><Icon name="pin" /><span>Где</span><strong>{event.venue_name || event.city || 'Место уточняется'}</strong><small>{addressLabel}</small></article>
      <article><Icon name="ticket" /><span>Вход</span><strong>{admissionLabel}</strong></article>
    </div>
  </section>}

  {!usesLongFlow && transport && event.city && event.city !== 'Калининград' && (
    <section class="desktop-clean-travel page-shell" aria-labelledby={`travel-${event.id}`}>
      <div>
        <p class="eyebrow">Как добраться</p>
        <h2 id={`travel-${event.id}`}>Калининград → {event.city}</h2>
        <p>Расписание пока уточняется. Проверьте время отправления перед поездкой.</p>
      </div>
      <div class="desktop-clean-travel__route" aria-label={`Маршрут Калининград — ${event.city}`}>
        <span>Калининград</span><i></i><b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3l2 3h-2.3l-1.4-2H8.7l-1.4 2H5l2-3a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v5h12V6a1 1 0 0 0-1-1H7Zm1 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"/></svg> электричка · автобус</b><i></i><span>{event.city}</span>
      </div>
    </section>
  )}
  </div>

  <section class="desktop-clean-related" data-related-start data-related-treatment={relatedMediaTreatment} aria-labelledby={`related-${event.id}`}>
    <div class="page-shell">
      <header>
        <p class="eyebrow">Продолжить выбор</p>
        <h2 id={`related-${event.id}`}>Смотрите дальше</h2>
      </header>
      <div class="cards-grid cards-grid--immersive desktop-clean-related__grid" data-lab-row-normalize>
        {related.map((item) => <EventCard event={item} variant="split-actions" />)}
      </div>
    </div>
  </section>

  {photoCount > 0 && (
    <div class="hero-gallery" id={galleryId} data-hero-gallery data-active-index="0" role="dialog" aria-modal="true" aria-labelledby={galleryTitleId} tabindex="-1" hidden>
      <div class="hero-gallery__chrome" aria-hidden="true"></div>
      <div class="hero-gallery__topbar">
        <a class="hero-gallery__brand" href={withBase('/__preview/')} aria-label="Перейти к афише Полюбить Калининград Анонсы"><span>Полюбить Калининград</span><strong>Анонсы</strong></a>
        <h2 id={galleryTitleId} class="sr-only">Фото события: {event.title}</h2>
        <button type="button" class="hero-gallery__close" data-hero-gallery-close aria-label="Закрыть просмотр фото">×</button>
      </div>
      <div class="hero-gallery__viewport">
        <div class="hero-gallery__track" data-hero-gallery-track>
          {galleryImages.map((image, index) => (
            <figure class="hero-gallery__slide" data-hero-gallery-slide data-gallery-slide-kind="image" data-gallery-index={index} data-source-index={image.sourceIndex} aria-hidden={index === 0 ? 'false' : 'true'}>
              <img class="hero-gallery__image" data-gallery-src={image.src} alt={image.alt} loading="lazy" decoding="async" data-image-text-mode={image.image_text_mode} data-source-index={image.sourceIndex} data-event-id={event.id} data-event-title={event.title} style={image.position ? `object-position:${image.position}` : undefined} />
              <figcaption class="sr-only">Фото события: {event.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="hero-gallery__caption" aria-hidden="true"><span>Фото события</span><strong>{event.title}</strong></div>
      {photoCount > 1 && <><button type="button" class="hero-gallery__nav hero-gallery__nav--prev" data-hero-gallery-prev aria-label="Предыдущее фото">‹</button><button type="button" class="hero-gallery__nav hero-gallery__nav--next" data-hero-gallery-next aria-label="Следующее фото">›</button></>}
      <div class="hero-gallery__counter" data-hero-gallery-counter>{`1 / ${photoCount}`}</div>
    </div>
  )}

  <script>
    const cleanRoot = document.querySelector<HTMLElement>('[data-desktop-clean-event]');
    const desktopViewport = window.matchMedia('(min-width: 1024px)');
    if (cleanRoot && desktopViewport.matches) {
      document.body.classList.add('desktop-clean-event-page');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mediaFrame = cleanRoot.querySelector<HTMLElement>('[data-media-frame]');
      const heroImage = cleanRoot.querySelector<HTMLImageElement>('[data-clean-hero-image]');
      const thumbButtons = Array.from(cleanRoot.querySelectorAll<HTMLButtonElement>('[data-clean-hero-thumb]'));
      const rotationToggle = cleanRoot.querySelector<HTMLButtonElement>('[data-hero-rotation-toggle]');
      let frame = 0;
      let imageRequest = 0;
      let rotationEnabled = cleanRoot.dataset.autoRotate === 'true';
      let mediaHovered = false;

      const clamp = (value:number, min=0, max=1) => Math.max(min, Math.min(max, value));
      const markRotation = () => {
        if (!rotationToggle) return;
        rotationToggle.setAttribute('aria-pressed', rotationEnabled ? 'true' : 'false');
        rotationToggle.setAttribute('aria-label', rotationEnabled ? 'Остановить автоматическую смену фотографий' : 'Включить автоматическую смену фотографий');
        rotationToggle.textContent = rotationEnabled ? 'Авто' : 'Пауза';
      };

      const selectHero = async (index:number, source:'manual'|'auto'='manual') => {
        if (!heroImage || !thumbButtons.length) return;
        if (source === 'manual') {
          rotationEnabled = false;
          markRotation();
        }
        const next = Math.max(0, Math.min(thumbButtons.length - 1, index));
        const button = thumbButtons[next];
        const src = button?.dataset.src;
        if (!button || !src) return;
        const token = ++imageRequest;
        const probe = new Image();
        probe.src = src;
        try { await probe.decode(); } catch {}
        if (token !== imageRequest) return;
        heroImage.src = src;
        heroImage.alt = button.dataset.alt || heroImage.alt;
        heroImage.width = Number(button.dataset.width || probe.naturalWidth || heroImage.width);
        heroImage.height = Number(button.dataset.height || probe.naturalHeight || heroImage.height);
        heroImage.style.objectPosition = button.dataset.position || '50% 50%';
        cleanRoot.dataset.selectedMediaPolicy = button.dataset.mode || 'unknown';
        thumbButtons.forEach((item, itemIndex) => {
          const current = itemIndex === next;
          item.setAttribute('aria-pressed', current ? 'true' : 'false');
          item.classList.toggle('is-current', current);
        });
        cleanRoot.dataset.activeHeroIndex = String(next);
        updateOcrFrame();
      };

      const indexedGalleryOpeners = Array.from(cleanRoot.querySelectorAll<HTMLElement>('[data-hero-gallery-open][data-hero-gallery-index]'));
      indexedGalleryOpeners.forEach((opener) => {
        opener.addEventListener('click', () => {
          const requested = Number(opener.dataset.heroGalleryIndex || 0);
          if (requested <= 0) return;
          queueMicrotask(() => {
            const galleryId = opener.dataset.heroGalleryOpen;
            const gallery = galleryId ? document.getElementById(galleryId) : null;
            const slides = gallery?.querySelectorAll('[data-hero-gallery-slide]');
            const next = gallery?.querySelector<HTMLButtonElement>('[data-hero-gallery-next]');
            if (!gallery || gallery.hidden || !slides?.length || !next) return;
            const selected = Math.min(requested, slides.length - 1);
            for (let step = 0; step < selected; step += 1) next.click();
          });
        });
      });
      rotationToggle?.addEventListener('click', () => {
        rotationEnabled = !rotationEnabled;
        markRotation();
      });
      mediaFrame?.addEventListener('pointerenter', () => { mediaHovered = true; });
      mediaFrame?.addEventListener('pointerleave', () => { mediaHovered = false; });
      markRotation();

      window.setInterval(() => {
        if (!rotationEnabled || reducedMotion.matches || mediaHovered || document.visibilityState !== 'visible' || window.scrollY > 4 || !mediaFrame || !thumbButtons.length) return;
        const rect = mediaFrame.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) return;
        const current = Number(cleanRoot.dataset.activeHeroIndex || '0');
        void selectHero((current + 1) % thumbButtons.length, 'auto');
      }, 8500);

      let layoutFrame = 0;
      const layoutScrollMedia = () => {
        layoutFrame = 0;
        cleanRoot.querySelectorAll<HTMLElement>('[data-bento-tile]').forEach((tile) => {
          const image = tile.querySelector<HTMLImageElement>('img');
          if (!image?.naturalWidth || !image.naturalHeight) return;
          const ratio = image.naturalWidth / image.naturalHeight;
          const mode = tile.dataset.imageTextMode || 'unknown';
          let span = 'square';
          if (mode === 'visual_only' && ratio >= 1.3) span = 'wide';
          tile.dataset.bentoSpan = span;
          tile.dataset.naturalRatio = ratio.toFixed(4);
        });
        cleanRoot.querySelectorAll<HTMLElement>('[data-bento-grid]').forEach((grid) => {
          const style = getComputedStyle(grid);
          const columns = style.gridTemplateColumns.split(/\s+/u).filter(Boolean).length;
          const gap = Number.parseFloat(style.columnGap) || 0;
          const inlinePadding = (Number.parseFloat(style.paddingLeft) || 0) + (Number.parseFloat(style.paddingRight) || 0);
          const cell = columns > 0 ? (grid.clientWidth - inlinePadding - gap * (columns - 1)) / columns : 0;
          if (cell <= 0) return;
          grid.style.setProperty('--bento-cell', `${cell.toFixed(2)}px`);
          grid.dataset.bentoColumns = String(columns);
        });
        cleanRoot.querySelectorAll<HTMLElement>('[data-scroll-stage]').forEach((stage) => {
          const viewport = stage.querySelector<HTMLElement>('[data-slow-media-viewport]');
          const track = viewport?.querySelector<HTMLElement>('[data-slow-media-track]');
          const content = stage.querySelector<HTMLElement>('[data-scroll-content]');
          if (!viewport || !track || !content) return;
          content.style.removeProperty('min-height');
          stage.style.removeProperty('--scroll-stage-min-height');
          const speed = clamp(Number(track.dataset.slowMediaSpeed || '.5'), .2, .7);
          const overflow = Math.max(0, track.scrollHeight - viewport.clientHeight);
          const requiredHeight = Math.ceil(viewport.clientHeight + overflow / speed);
          const targetHeight = Math.max(content.scrollHeight, requiredHeight);
          stage.style.setProperty('--scroll-stage-min-height', `${targetHeight}px`);
          stage.dataset.mediaOverflow = overflow.toFixed(2);
          stage.dataset.mediaSpeed = speed.toFixed(2);
        });
        scheduleMotion();
      };
      const scheduleLayout = () => {
        if (layoutFrame) return;
        layoutFrame = window.requestAnimationFrame(layoutScrollMedia);
      };
      cleanRoot.querySelectorAll<HTMLImageElement>('[data-slow-media-track] img').forEach((image) => {
        if (!image.complete) image.addEventListener('load', scheduleLayout, { once:true });
      });

      const updateParallax = () => {
        frame = 0;
        cleanRoot.querySelectorAll<HTMLElement>('[data-desktop-parallax]').forEach((media) => {
          if (reducedMotion.matches) {
            media.style.setProperty('--desktop-parallax-y', '0px');
            media.style.removeProperty('transform');
            media.dataset.editorialMediaShift = '0.00';
            return;
          }
          const viewport = window.innerHeight || 800;
          const stage = media.closest<HTMLElement>('.desktop-prototype__stage');
          if (stage && cleanRoot.dataset.desktopFamily === 'editorial') {
            const rect = stage.getBoundingClientRect();
            const stageTravel = Math.max(0, 73 - rect.top);
            const motion = cleanRoot.dataset.editorialMotion || 'pinned';
            const scrollRange = Math.max(1, stage.offsetHeight - viewport + 73);
            if (motion === 'continuous') {
              const maxShift = Math.max(0, stage.offsetHeight - media.offsetHeight);
              const shift = Math.min(maxShift, stageTravel * .35);
              media.style.transform = `translate3d(0,${shift.toFixed(2)}px,0)`;
              media.style.setProperty('--desktop-parallax-y', '0px');
              media.dataset.editorialMediaShift = shift.toFixed(2);
              stage.dataset.editorialMediaNetRatio = '.65';
            } else {
              media.style.removeProperty('transform');
              const image = media.querySelector<HTMLImageElement>('[data-clean-hero-image]');
              const availableBleed = Math.max(0, (image?.offsetHeight || media.offsetHeight) - media.clientHeight);
              // Start at the uncropped top edge and reveal virtually the whole lower overflow.
              const internalTravel = Math.min(240, availableBleed);
              const progress = clamp(stageTravel / scrollRange);
              const offset = -internalTravel * progress;
              media.style.setProperty('--desktop-parallax-y', `${offset.toFixed(1)}px`);
              media.dataset.editorialMediaShift = '0.00';
              stage.dataset.editorialInternalTravel = internalTravel.toFixed(2);
              stage.dataset.editorialMediaNetRatio = 'sticky-then-1.00';
            }
          }
        });
        cleanRoot.querySelectorAll<HTMLElement>('[data-slow-media-viewport]').forEach((viewport) => {
          const stage = viewport.closest<HTMLElement>('[data-scroll-stage]');
          const track = viewport.querySelector<HTMLElement>('[data-slow-media-track]');
          if (!stage || !track) return;
          if (reducedMotion.matches) {
            track.style.transform = 'none';
            return;
          }
          const stageRect = stage.getBoundingClientRect();
          const viewportHeight = viewport.clientHeight;
          const overflow = Math.max(0, track.scrollHeight - viewportHeight);
          const scrollRange = Math.max(1, stage.offsetHeight - viewportHeight);
          const progress = clamp((73 - stageRect.top) / scrollRange);
          const speed = clamp(Number(track.dataset.slowMediaSpeed || '.5'), .2, .7);
          const travel = Math.min(overflow, scrollRange * speed);
          track.style.transform = `translate3d(0,${(-travel * progress).toFixed(2)}px,0)`;
          stage.dataset.mediaProgress = progress.toFixed(4);
          stage.dataset.mediaTravel = travel.toFixed(2);
        });
      };
      const scheduleMotion = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(updateParallax);
      };
      updateParallax();
      scheduleLayout();
      window.addEventListener('scroll', scheduleMotion, { passive:true });
      window.addEventListener('resize', scheduleLayout, { passive:true });
      reducedMotion.addEventListener?.('change', scheduleMotion);
      new ResizeObserver(scheduleLayout).observe(cleanRoot);

      const updateOcrFrame = () => {
        if (cleanRoot.dataset.selectedMediaPolicy === 'visual_only') {
          cleanRoot.classList.remove('is-safe-cover', 'is-safe-contain');
          cleanRoot.dataset.measuredCrop = '0.0000';
          return;
        }
        const image = mediaFrame?.querySelector<HTMLImageElement>('[data-clean-hero-image]');
        if (!mediaFrame || !image) return;
        const imageWidth = image.naturalWidth || Number(image.getAttribute('width'));
        const imageHeight = image.naturalHeight || Number(image.getAttribute('height'));
        if (!mediaFrame.clientWidth || !mediaFrame.clientHeight || !imageWidth || !imageHeight) return;
        const scale = Math.max(mediaFrame.clientWidth / imageWidth, mediaFrame.clientHeight / imageHeight);
        const visibleFraction = (mediaFrame.clientWidth * mediaFrame.clientHeight) / (imageWidth * imageHeight * scale * scale);
        const potentialCrop = clamp(1 - visibleFraction);
        const safeCover = mediaFrame.dataset.ocrSafeCover === 'true' && potentialCrop <= .2;
        cleanRoot.classList.toggle('is-safe-cover', safeCover);
        cleanRoot.classList.toggle('is-safe-contain', !safeCover);
        cleanRoot.dataset.potentialCoverCrop = potentialCrop.toFixed(4);
        cleanRoot.dataset.measuredCrop = safeCover ? potentialCrop.toFixed(4) : '0.0000';
      };
      if (heroImage && !heroImage.complete) heroImage.addEventListener('load', updateOcrFrame, { once:true });
      updateOcrFrame();
      window.addEventListener('resize', updateOcrFrame, { passive:true });

      const relatedGrid = cleanRoot.querySelector<HTMLElement>('[data-lab-row-normalize]');
      const relatedMediaTreatment = cleanRoot.dataset.relatedMediaTreatment || 'hybrid';
      let normalizeFrame = 0;
      const normalizeRelatedRows = () => {
        normalizeFrame = 0;
        if (!relatedGrid) return;
        const cards = Array.from(relatedGrid.querySelectorAll<HTMLElement>(':scope > [data-event-card]'));
        if (window.innerWidth < 1024) {
          cards.forEach((card) => {
            card.removeAttribute('data-lab-related-card');
            card.removeAttribute('data-lab-media-kind');
            card.removeAttribute('data-lab-row-media');
            card.removeAttribute('data-lab-row-index');
            card.removeAttribute('data-lab-row-worst-crop');
            card.removeAttribute('data-lab-media-treatment');
            card.removeAttribute('data-lab-cover-crop');
            card.removeAttribute('data-media-text-mode');
            card.style.removeProperty('--lab-row-media-ratio');
            card.querySelector<HTMLElement>('.event-card__media-shell')?.style.removeProperty('--lab-ambient-image');
          });
          return;
        }
        cards.forEach((card) => {
          card.dataset.labRelatedCard = 'true';
          const shell = card.querySelector<HTMLElement>('.event-card__media-shell');
          card.dataset.labMediaKind = shell?.classList.contains('event-card__media-shell--preserve') ? 'document' : 'visual';
        });
        const rows:Array<HTMLElement[]> = [];
        cards.forEach((card) => {
          const top = card.getBoundingClientRect().top;
          const row = rows.find((items) => Math.abs(items[0].getBoundingClientRect().top - top) <= 2);
          if (row) row.push(card); else rows.push([card]);
        });
        rows.forEach((row, rowIndex) => {
          const documents = row.filter((card) => card.dataset.labMediaKind === 'document');
          const visuals = row.filter((card) => card.dataset.labMediaKind === 'visual');
          const ratiosOf = (items:HTMLElement[]) => items
            .map((card) => {
              const image = card.querySelector<HTMLImageElement>('.event-card__media');
              if (!image?.naturalWidth || !image.naturalHeight) return null;
              const imageRatio = image.naturalWidth / image.naturalHeight;
              return Number.isFinite(imageRatio) && imageRatio > 0 ? imageRatio : null;
            })
            .filter((value):value is number => value !== null);
          const documentRatios = ratiosOf(documents);
          const visualRatios = ratiosOf(visuals);
          let targetRatio = 1;
          let mode = 'visual-square';
          if (documents.length === 0) {
            const geometricMean = visualRatios.length
              ? Math.exp(visualRatios.reduce((sum, imageRatio) => sum + Math.log(imageRatio), 0) / visualRatios.length)
              : 1;
            targetRatio = Math.min(4 / 3, Math.max(1, geometricMean));
            mode = 'visual-squareish';
          } else if (visuals.length > 0) {
            if (relatedMediaTreatment === 'cover') {
              targetRatio = 1.12;
              mode = 'mixed-compact-cover';
            } else if (relatedMediaTreatment === 'ambient') {
              targetRatio = 1;
              mode = 'mixed-square-ambient';
            } else {
              const buckets = [.8, 1, 4 / 3];
              const documentCenter = Math.exp(documentRatios.reduce((sum, imageRatio) => sum + Math.log(imageRatio), 0) / documentRatios.length);
              targetRatio = buckets.sort((a, b) => Math.abs(Math.log(a / documentCenter)) - Math.abs(Math.log(b / documentCenter)))[0];
              mode = 'mixed-adaptive-ambient';
            }
          } else if (documentRatios.length === 1) {
            targetRatio = documentRatios[0];
            mode = 'document-natural';
          } else if (documentRatios.length > 1) {
            targetRatio = Math.sqrt(Math.min(...documentRatios) * Math.max(...documentRatios));
            mode = 'document-minimax-contained';
          } else {
            mode = 'document-pending-contained';
          }
          row.forEach((card) => {
            card.style.setProperty('--lab-row-media-ratio', targetRatio.toFixed(5));
            card.dataset.labRowMedia = mode;
            card.dataset.labRowIndex = String(rowIndex);
            const shell = card.querySelector<HTMLElement>('.event-card__media-shell');
            const image = card.querySelector<HTMLImageElement>('.event-card__media');
            const imageRatio = image?.naturalWidth && image.naturalHeight ? image.naturalWidth / image.naturalHeight : targetRatio;
            const coverCrop = 1 - Math.min(imageRatio / targetRatio, targetRatio / imageRatio);
            const isDocument = card.dataset.labMediaKind === 'document';
            let cardTreatment = 'visual-cover';
            if (isDocument) {
              if (relatedMediaTreatment === 'ambient') cardTreatment = 'ambient';
              else if (relatedMediaTreatment === 'cover') cardTreatment = 'document-cover';
              else cardTreatment = 'ambient';
            }
            card.dataset.labMediaTreatment = cardTreatment;
            card.dataset.labCoverCrop = Math.max(0, coverCrop).toFixed(4);
            card.dataset.labRowWorstCrop = Math.max(0, ...documentRatios.map((documentRatio) => 1 - Math.min(documentRatio / targetRatio, targetRatio / documentRatio))).toFixed(4);
            if (shell && image?.currentSrc) shell.style.setProperty('--lab-ambient-image', `url(${JSON.stringify(image.currentSrc)})`);
          });
        });
      };
      const scheduleNormalize = () => {
        if (normalizeFrame) return;
        normalizeFrame = window.requestAnimationFrame(normalizeRelatedRows);
      };
      if (relatedGrid) {
        const images = Array.from(relatedGrid.querySelectorAll<HTMLImageElement>('.event-card__media'));
        images.forEach((image) => image.addEventListener('load', scheduleNormalize, { once:true }));
        Promise.allSettled(images.map((image) => image.decode?.())).then(scheduleNormalize);
        new ResizeObserver(scheduleNormalize).observe(relatedGrid);
        new MutationObserver(scheduleNormalize).observe(relatedGrid, { childList:true, subtree:true });
        window.addEventListener('resize', scheduleNormalize, { passive:true });
        scheduleNormalize();
      }
    }
  </script>
</main>

