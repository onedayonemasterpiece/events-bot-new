---
import Icon from '../Icon.astro';
import EventTokenMedallions from '../EventTokenMedallions.astro';
import DesktopEventActions from './DesktopEventActions.astro';
import type { PreviewEvent } from '../../lib/types';

interface Props { event: PreviewEvent; inlineActions?: boolean; }
const { event, inlineActions = false } = Astro.props;
const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const weekdays = ['воскресенье', 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота'];
const date = new Date(`${event.start_date}T12:00:00+02:00`);
const day = String(date.getDate()).padStart(2, '0');
const month = months[date.getMonth()];
const weekday = weekdays[date.getDay()];
const time = event.display_time || event.start_time || 'время уточняется';
---

<div class:list={['event-facts', inlineActions && 'event-facts--with-actions']}>
  <p class="event-kicker"><span>{event.event_type}</span><b>{event.festival || `событие #${event.id}`}</b></p>
  <div class="event-date" aria-label={`${day} ${month}, ${weekday}, ${time}`}>
    <strong>{day} <span>{month}</span></strong><b>{weekday}</b><time>{time}</time>
  </div>
  {inlineActions && <DesktopEventActions event={event} compact />}
  <h1>{event.title}</h1>
  <p class="event-place"><Icon name="pin" /><span><strong>{event.venue_name}</strong><small>{[event.address, event.city].filter(Boolean).join(' · ')}</small></span></p>
  <EventTokenMedallions event={event} />
</div>

<style>
  .event-kicker { display:flex; justify-content:space-between; gap:.7rem; margin:0 0 .75rem; color:#8d3918; font-size:.75rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .event-kicker b { color:#6d5b50; }
  .event-date { min-width:0; display:grid; grid-template-columns:auto 1fr auto; align-items:baseline; gap:clamp(.55rem,1.7vw,1.5rem); margin-bottom:1rem; padding:.82rem 1rem; border-radius:20px; background:#282421; color:#fff; font-variant-numeric:tabular-nums; }
  .event-date strong { font-size:clamp(2rem,3.6vw,3.55rem); line-height:.88; letter-spacing:-.055em; white-space:nowrap; }
  .event-date strong span { font-size:.72em; }
  .event-date>b { color:#e2bd62; font-size:clamp(1rem,1.55vw,1.35rem); }
  .event-date time { font-size:clamp(1.5rem,2.8vw,2.7rem); font-weight:900; }
  h1 { max-width:17ch; margin:.25rem 0 .85rem; font-size:clamp(2.25rem,min(4.35vw,7vh),5.15rem); line-height:.94; letter-spacing:-.055em; overflow-wrap:anywhere; }
  .event-place { display:grid; grid-template-columns:1.35rem minmax(0,1fr); gap:.65rem; margin:.6rem 0 0; }
  .event-place :global(.icon) { width:1.35rem; height:1.35rem; color:#aa451e; }
  .event-place span { display:grid; gap:.08rem; }
  .event-place strong { font-size:1.02rem; }
  .event-place small { color:#75675e; font-weight:700; }
  @media (min-width:1024px) and (max-height:700px) {
    .event-facts--with-actions { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(340px,.95fr); gap:0 .65rem; align-items:start; }
    .event-facts--with-actions .event-kicker,.event-facts--with-actions h1,.event-facts--with-actions .event-place,.event-facts--with-actions :global(.event-token-section) { grid-column:1/-1; }
    .event-facts--with-actions .event-date { grid-column:1; }
    .event-facts--with-actions :global(.event-actions--compact) { grid-column:2; grid-row:2; align-self:stretch; margin:0 0 .65rem; }
    .event-date { gap:.4rem; margin-bottom:.65rem; padding:.62rem .7rem; }
    .event-date strong { font-size:2.15rem; }
    .event-date>b { font-size:.9rem; }
    .event-date time { font-size:1.45rem; }
    h1 { margin-bottom:.55rem; font-size:clamp(2rem,min(3.7vw,6vh),3.7rem); }
  }
</style>
