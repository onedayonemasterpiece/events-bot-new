---
import './design-system/product-contour-foundations.css';
import type { FocusEggId, FocusEggState } from '../lib/focus-easter-eggs';

interface Props {
  eggId: FocusEggId;
  title: string;
  state: FocusEggState;
  compact?: boolean;
}

const { eggId, title, state, compact = false } = Astro.props;
const labels: Record<FocusEggState, string> = {
  locked: 'Пока закрыто',
  eligible: 'Можно найти',
  found: 'Найдено',
  unavailable: 'Временно недоступно',
};
---

<article
  class:list={['focus-egg-artifact', compact && 'focus-egg-artifact--compact']}
  data-ds-family="FocusEggArtifact"
  data-ds-version="1"
  data-ds-variant={compact ? 'compact' : 'default'}
  data-ds-state={state}
  data-ke-foundation-consumer="focus-egg-artifact"
  data-focus-egg-artifact
  data-egg-id={eggId}
  data-egg-state={state}
>
  <span class="focus-egg-artifact__glyph" aria-hidden="true">
    {state === 'found' ? '✦' : state === 'eligible' ? '◇' : state === 'unavailable' ? '—' : '·'}
  </span>
  <span class="focus-egg-artifact__copy">
    <small>{eggId} · <span data-focus-egg-state-label>{labels[state]}</span></small>
    <strong>{title}</strong>
  </span>
  <button
    class="focus-egg-artifact__action"
    type="button"
    data-focus-egg-find
    aria-label={`Пасхалка: ${title}. Добавить в локальную коллекцию`}
    hidden={state !== 'eligible'}
  >
    Забрать
  </button>
  <span
    class="focus-egg-artifact__done"
    data-focus-egg-found-label
    aria-label={`Пасхалка: ${title}. Найдено`}
    hidden={state !== 'found'}
  >
    В коллекции
  </span>
</article>

<style>
  .focus-egg-artifact {
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr) auto;
    gap: .7rem;
    align-items: center;
    border: var(--ke-shape-border-hairline) solid #d4b66a;
    border-radius: var(--ke-space-lg);
    padding: .75rem;
    background: linear-gradient(135deg, #fffdf5, #fff1c7);
    color: #2f2417;
    box-shadow: 0 .5rem 1.5rem rgb(75 47 5 / 10%);
  }
  .focus-egg-artifact[data-egg-state='locked'],
  .focus-egg-artifact[data-egg-state='unavailable'] {
    border-color: var(--ke-color-border-default);
    background: var(--ke-color-background-page);
    box-shadow: none;
    color: var(--ke-color-text-muted);
  }
  .focus-egg-artifact[data-egg-state='found'] {
    border-color: #6ea977;
    background: linear-gradient(135deg, #f7fff5, #e8f8df);
  }
  .focus-egg-artifact__glyph {
    width: 2.8rem;
    height: 2.8rem;
    display: grid;
    place-items: center;
    border-radius: var(--ke-shape-radius-pill);
    background: color-mix(in srgb, var(--ke-color-background-surface-strong) 78%, transparent);
    color: #9c6410;
    font-size: 1.45rem;
    font-weight: 900;
  }
  .focus-egg-artifact__copy { min-width: 0; display: grid; gap: .16rem; }
  .focus-egg-artifact__copy small {
    color: currentColor;
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .focus-egg-artifact__copy strong { font-size: .94rem; line-height: 1.2; }
  .focus-egg-artifact__action {
    min-width: 76px;
    min-height: var(--ke-size-touch-target);
    border: 0;
    border-radius: var(--ke-shape-radius-control);
    padding: .55rem .7rem;
    background: #6f4510;
    color: var(--ke-color-text-inverse);
    font: 850 .78rem/1 var(--ke-font-family-sans);
    cursor: pointer;
  }
  .focus-egg-artifact__done { color: #396840; font-size: .72rem; font-weight: 900; }
  .focus-egg-artifact__action[hidden],
  .focus-egg-artifact__done[hidden] { display: none; }
  .focus-egg-artifact__action:focus-visible {
    outline: var(--ke-shape-border-ring) solid var(--ke-color-focus-ring-accent);
    outline-offset: 3px;
  }
  .focus-egg-artifact--compact { padding: .6rem; }
  @media (max-width: 420px) {
    .focus-egg-artifact { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .focus-egg-artifact__glyph { width: 2.5rem; height: 2.5rem; }
    .focus-egg-artifact__action,
    .focus-egg-artifact__done { grid-column: 2; justify-self: start; }
  }
</style>
