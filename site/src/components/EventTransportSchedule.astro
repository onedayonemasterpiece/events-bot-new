---
import Icon from './Icon.astro';
import { eventTransportCalendarPath, getEventTransportSuggestion, type EventTrainOption, type EventTransportDirection } from '../lib/eventTransport';
import { withBase } from '../lib/events';
import type { PreviewEvent } from '../lib/types';

interface Props {
  event: PreviewEvent;
}

const { event } = Astro.props;
const suggestion = getEventTransportSuggestion(event);
const headingId = suggestion ? `event-transport-heading-${event.id}` : undefined;
const formatDuration = (minutes: number) => `${minutes} мин`;
const formatLead = (minutes: number | undefined) => typeof minutes === 'number' ? `за ${minutes} мин до начала` : '';
const formatWait = (option: EventTrainOption) => {
  const wait = option.waitAfterEventMinutes;
  if (typeof wait !== 'number') return '';
  const ending = suggestion?.eventEndBasis === 'forecast'
    ? 'ориентировочного окончания'
    : 'окончания';
  return wait === 0 ? `сразу после ${ending}` : `через ${wait} мин после ${ending}`;
};
const calendarHref = (direction: EventTransportDirection, train: EventTrainOption) => withBase(eventTransportCalendarPath(event, suggestion!, direction, train));
const calendarLabel = (direction: EventTransportDirection, train: EventTrainOption) => {
  const from = direction === 'outbound' ? suggestion?.originStation : suggestion?.destinationStation;
  const to = direction === 'outbound' ? suggestion?.destinationStation : suggestion?.originStation;
  return `Добавить электричку ${from} — ${to}: ${train.departure}–${train.arrival} в календарь`;
};
const eventStartMinutes = Number(suggestion?.eventStart.slice(0, 2) || 0) * 60 + Number(suggestion?.eventStart.slice(3, 5) || 0);
const lastReturnMinutes = suggestion?.lastSameDayReturn ? Number(suggestion.lastSameDayReturn.departure.slice(0, 2)) * 60 + Number(suggestion.lastSameDayReturn.departure.slice(3, 5)) : null;
const returnHeading = suggestion?.eventEndBasis === 'explicit' && suggestion.eventEnd
  ? `После окончания в ${suggestion.eventEnd}`
  : suggestion?.eventEndBasis === 'forecast' && suggestion.eventEnd
    ? `Ориентировочно после ${suggestion.eventEnd}`
    : 'Последний поезд в день события';
const lastSameDaySummary = suggestion?.lastSameDayReturn
  ? lastReturnMinutes !== null && lastReturnMinutes <= eventStartMinutes
    ? `После начала ${suggestion.eventTypeGenitive} поездов в этот день больше нет.`
    : `Последний поезд в день события — в ${suggestion.lastSameDayReturn.departure}.`
  : '';
---
{suggestion && (
  <aside
    class="event-transport"
    data-event-transport-schedule
    data-event-city={suggestion.city}
    data-outbound-count={suggestion.outbound.length}
    data-return-count={suggestion.returns.length}
    data-event-end-basis={suggestion.eventEndBasis}
    aria-labelledby={headingId}
  >
    <header class="event-transport__header">
      <div class="event-transport__intro">
        <h2 id={headingId}>Как добраться на электричке</h2>
        <p>{suggestion.originStation} ⇄ {suggestion.destinationStation}</p>
      </div>
      <img
        class="event-transport__train"
        src={withBase('/assets/transport/kppk-lastochka.webp')}
        width="500"
        height="101"
        alt="Поезд «Ласточка»"
        loading="lazy"
        decoding="async"
      />
    </header>

    <div class="event-transport__directions">
      <section class="event-transport__direction" aria-labelledby={`event-transport-outbound-${event.id}`}>
        <div class="event-transport__direction-heading">
          <p class="event-transport__step">Туда</p>
          <h3 id={`event-transport-outbound-${event.id}`}>К началу {suggestion.eventTypeGenitive} в {suggestion.eventStart}</h3>
        </div>
        {suggestion.outbound.length > 0 ? (
          <ol class="event-transport__trains">
            {suggestion.outbound.map((train) => (
              <li class="event-transport__train-row" data-transport-direction="outbound" data-train-number={train.number}>
                <a class="event-transport__train-link" href={calendarHref('outbound', train)} type="text/calendar" aria-label={calendarLabel('outbound', train)}>
                  <div class="event-transport__times">
                    <time datetime={train.departureIso}>{train.departure}</time>
                    <span aria-hidden="true">→</span>
                    <time datetime={train.arrivalIso}>{train.arrival}</time>
                  </div>
                  <small>{train.trainType} № {train.number} · {formatDuration(train.durationMinutes)} · {formatLead(train.minutesBeforeEvent)}</small>
                  <span class="event-transport__calendar-icon" aria-hidden="true"><Icon name="calendar" /></span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="event-transport__empty">Поезда с прибытием за 20 минут — 1,5 часа до начала нет.</p>
        )}
      </section>

      <section class="event-transport__direction" aria-labelledby={`event-transport-return-${event.id}`}>
        <div class="event-transport__direction-heading">
          <p class="event-transport__step">Обратно</p>
          <h3 id={`event-transport-return-${event.id}`}>{returnHeading}</h3>
        </div>
        {suggestion.eventEndBasis === 'schedule_cutoff' ? (
          <div class="event-transport__cutoff" data-return-schedule-cutoff>
            {suggestion.lastSameDayReturn && (
              <a class="event-transport__cutoff-item" data-last-same-day-return={suggestion.lastSameDayReturn.departure} href={calendarHref('return', suggestion.lastSameDayReturn)} type="text/calendar" aria-label={calendarLabel('return', suggestion.lastSameDayReturn)}>
                <span class="event-transport__cutoff-copy">
                  <p>{lastSameDaySummary}</p>
                  <strong>{suggestion.lastSameDayReturn.departure} → {suggestion.lastSameDayReturn.arrival}</strong>
                  <small>{suggestion.lastSameDayReturn.trainType} № {suggestion.lastSameDayReturn.number}</small>
                </span>
                <span class="event-transport__calendar-icon" aria-hidden="true"><Icon name="calendar" /></span>
              </a>
            )}
            <p class="event-transport__cutoff-note">Точное время окончания неизвестно, поэтому поезд на следующий день не предлагаем: ожидание до утра может быть неприемлемым. Уточните время окончания у организатора.</p>
          </div>
        ) : suggestion.returns.length > 0 ? (
          <>
            {suggestion.eventEndBasis === 'forecast' && (
              <p class="event-transport__forecast-note">
                Время окончания ориентировочное — перед поездкой проверьте его у организатора.
              </p>
            )}
            <p class="event-transport__return-buffer" data-return-access-minutes={suggestion.returnAccessMinutes}>{suggestion.returnAccessLabel} Первый безопасный выезд — после {suggestion.returnReadyTime}.</p>
            <ol class="event-transport__trains">
              {suggestion.returns.map((train) => (
                <li class="event-transport__train-row" data-transport-direction="return" data-train-number={train.number}>
                  <a class="event-transport__train-link" href={calendarHref('return', train)} type="text/calendar" aria-label={calendarLabel('return', train)}>
                    <div class="event-transport__times">
                      <time datetime={train.departureIso}>{train.departure}</time>
                      <span aria-hidden="true">→</span>
                      <time datetime={train.arrivalIso}>{train.arrival}</time>
                    </div>
                    <small>{train.trainType} № {train.number} · {formatDuration(train.durationMinutes)} · {formatWait(train)}{train.nextDay ? ' · на следующий день' : ''}</small>
                    <span class="event-transport__calendar-icon" aria-hidden="true"><Icon name="calendar" /></span>
                  </a>
                </li>
              ))}
            </ol>
          </>
        ) : suggestion.returnCalendarCovered ? (
          <p class="event-transport__empty event-transport__empty--warning">
            {suggestion.eventEndBasis === 'forecast'
              ? 'После ориентировочного окончания и запаса на дорогу подходящих поездов в Калининград в этот день больше нет. Уточните время окончания у организатора.'
              : 'После окончания события поездов в Калининград в этот вечер больше нет.'}
          </p>
        ) : (
          <p class="event-transport__empty">Для обратной поездки нет подтверждённых данных.</p>
        )}
      </section>
    </div>

    <footer class="event-transport__footer">
      <p>Перевозчик — <a href="https://www.kppk39.ru/" target="_blank" rel="noopener noreferrer nofollow">КППК</a>.</p>
    </footer>
  </aside>
)}

<style>
  .event-transport {
    margin: 1.4rem 0 0;
    overflow: hidden;
    container: event-rail / inline-size;
    border: 1px solid var(--ke-color-train-border);
    border-radius: 12px;
    background: var(--ke-color-train-surface);
    box-shadow: var(--ke-elevation-train);
  }
  .event-transport__header {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 126px;
    padding: 0.9rem 1rem 0.72rem;
    background: var(--ke-color-train-header-surface);
  }
  .event-transport__intro h2 { margin: 0.28rem 0; font-size: clamp(1.45rem, 4vw, 2.15rem); line-height: 1.02; color: var(--ke-color-train-heading); }
  .event-transport__intro > p:last-child { margin: 0; color: var(--muted); font-weight: 760; }
  .event-transport__train { display: block; width: 100%; height: auto; max-height: 76px; object-fit: contain; object-position: center; }
  .event-transport__directions { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--ke-color-train-section-line); }
  .event-transport__direction { min-width: 0; padding: 0.78rem 0.9rem 0.88rem; }
  .event-transport__direction + .event-transport__direction { border-top: 1px solid var(--ke-color-train-section-line); }
  .event-transport__direction-heading { min-height: 2.8rem; }
  .event-transport__direction h3 { margin: 0.1rem 0 0; font-size: 1rem; color: var(--ke-color-train-heading); }
  .event-transport__step { margin: 0; color: var(--ke-color-train-step); font-size: 0.76rem; font-weight: 920; letter-spacing: 0.08em; text-transform: uppercase; }
  .event-transport__trains { display: grid; gap: 0.42rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
  .event-transport__forecast-note { margin:.5rem 0 0; color:var(--ke-color-train-copy); font-size:.78rem; line-height:1.4; }
  .event-transport__return-buffer { margin:.5rem 0 0; padding:.58rem .66rem; border-radius:12px; color:var(--ke-color-train-buffer-text); background:var(--ke-color-train-buffer-surface); font-size:.78rem; line-height:1.4; }
  .event-transport__train-link { display: grid; grid-template-columns: minmax(0,1fr) 2.4rem; grid-template-areas: "times icon" "meta icon"; align-items: center; gap: 0.1rem 0.55rem; min-height: 4.15rem; padding: 0.58rem 0.68rem; border: 1px solid var(--ke-color-train-row-line); border-radius: 14px; color: inherit; background: var(--ke-color-train-row-surface); text-decoration: none; touch-action: manipulation; }
  .event-transport__train-link:hover,.event-transport__cutoff-item:hover { border-color: var(--ke-color-train-row-hover-line); background: var(--ke-color-train-row-hover-surface); }
  .event-transport__train-link:active,.event-transport__cutoff-item:active { background: var(--ke-color-train-row-pressed-surface); }
  .event-transport__train-link:focus-visible,.event-transport__cutoff-item:focus-visible { outline: 3px solid var(--ke-color-train-focus); outline-offset: 2px; }
  .event-transport__times { grid-area: times; display: flex; align-items: center; gap: 0.46rem; color: var(--ke-color-train-heading); font-size: 1.22rem; font-weight: 950; font-variant-numeric: tabular-nums; }
  .event-transport__times span { color: var(--ke-color-train-step); }
  .event-transport__train-link > small { grid-area: meta; display: block; color: var(--muted); line-height: 1.28; }
  .event-transport__calendar-icon { grid-area: icon; display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border-radius: 50%; color: var(--ke-color-train-calendar-text); background: var(--ke-color-train-calendar-surface); }
  .event-transport__calendar-icon :global(.icon) { width: 1.25rem; height: 1.25rem; }
  .event-transport__cutoff { display: grid; gap: 0.42rem; margin-top: 0.5rem; }
  .event-transport__cutoff-item { display: grid; grid-template-columns: minmax(0,1fr) 2.4rem; align-items: center; gap: 0.55rem; padding: 0.62rem 0.68rem; border: 1px solid var(--ke-color-train-row-line); border-radius: 14px; color: inherit; background: var(--ke-color-train-row-surface); text-decoration: none; touch-action: manipulation; }
  .event-transport__cutoff-copy { min-width: 0; }
  .event-transport__cutoff-item p { margin: 0; color: var(--ke-color-train-cutoff-copy); font-size: 0.82rem; line-height: 1.38; }
  .event-transport__cutoff-item strong { display: block; margin-top: 0.22rem; color: var(--ke-color-train-heading); font-size: 1.12rem; font-variant-numeric: tabular-nums; }
  .event-transport__cutoff-item small { display: block; margin-top: 0.18rem; color: var(--muted); }
  .event-transport__cutoff-item--muted { background: var(--ke-color-train-muted-surface); }
  .event-transport__cutoff-note { margin: 0; color: var(--muted); font-size: 0.78rem; }
  .event-transport__empty { min-height: 5rem; margin: 0.7rem 0 0; padding: 0.8rem; border-radius: 18px; background: var(--ke-color-train-muted-surface); color: var(--muted); font-weight: 730; }
  .event-transport__empty--warning { color: #78342f; background: rgba(151,53,46,0.08); }
  .event-transport__footer { padding: 0.62rem 0.9rem 0.72rem; border-top: 1px solid var(--ke-color-train-section-line); color: var(--muted); font-size: 0.78rem; }
  .event-transport__footer p { margin: 0; }
  .event-transport__footer a { color: var(--ke-color-train-calendar-text); font-weight: 850; }
  @container event-rail (min-width: 540px) {
    .event-transport { border-radius: 20px; }
    .event-transport__header { grid-template-columns: minmax(0, 1fr) minmax(170px, 38%); }
    .event-transport__train { max-height: 92px; }
    .event-transport__directions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .event-transport__direction + .event-transport__direction { border-top: 0; border-left: 1px solid var(--ke-color-train-section-line); }
  }
  @container event-rail (max-width: 539px) {
    .event-transport__header { min-height: 0; }
    .event-transport__direction-heading { min-height: 0; }
  }
</style>
