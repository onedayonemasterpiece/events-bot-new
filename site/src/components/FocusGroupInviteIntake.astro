---
import FocusLabBadge from './FocusLabBadge.astro';
import FocusPwaInstallAction from './FocusPwaInstallAction.astro';
import { withBase } from '../lib/events';

const homeHref = withBase('/');
const programmeHref = withBase('/fokus-gruppa/');
const focusIconHref = withBase('/assets/pwa/announcements-brand-v2-192.png');
---

<main
  class="focus-intake"
  data-focus-intake
  data-home-href={homeHref}
>
  <header class="focus-intake__brand">
    <img src={focusIconHref} width="192" height="192" alt="Полюбить Калининград · Анонсы" />
  </header>

  <section class="focus-intake__card" data-intake-pending aria-live="polite">
    <span class="focus-intake__spinner" aria-hidden="true"></span>
    <h1>Открываем приглашение…</h1>
    <p>Подождите немного.</p>
  </section>

  <section class="focus-intake__card" data-intake-error hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <h1 data-intake-error-title>Не получилось открыть приглашение</h1>
    <p data-intake-error-message>Отсканируйте QR-код ещё раз.</p>
    <a class="ke-button ke-button--primary" href={programmeHref}>Получить новую ссылку</a>
  </section>

  <section class="focus-intake__card" data-intake-stage="install" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <p class="focus-intake__eyebrow">Приглашение принято</p>
    <h1>Как вам удобнее возвращаться к афише?</h1>
    <p>
      Можно установить «Анонсы» на телефон или продолжить на сайте.
      Участие от этого не зависит.
    </p>
    <FocusPwaInstallAction />
  </section>

  <section class="focus-intake__card" data-intake-stage="identity" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <h1>Хотите участвовать в розыгрыше двух билетов?</h1>
    <p>
      Для этого подтвердите себя по электронной почте или через Яндекс.
      Афишей можно пользоваться и без подтверждения.
    </p>

    <div class="focus-intake__choices" data-static-auth-signed-out hidden>
      <button class="ke-button ke-button--primary" type="button" data-focus-email-open>
        По электронной почте
      </button>
      <button class="ke-button ke-button--secondary" type="button" data-focus-yandex>
        Через Яндекс
      </button>
      <button class="focus-intake__skip" type="button" data-focus-skip>
        Пропустить
      </button>
    </div>

    <div class="focus-intake__signed" data-static-auth-signed-in hidden>
      <strong>Вы вошли как <span data-static-auth-name></span></strong>
      <span>Продолжите с этим аккаунтом или выйдите, чтобы проверить другой способ.</span>
      <button class="ke-button ke-button--primary" type="button" data-focus-account-continue>
        Продолжить с этим аккаунтом
      </button>
      <button class="focus-intake__skip" type="button" data-focus-account-logout>
        Выйти и выбрать другой способ
      </button>
    </div>

    <div class="focus-intake__email" data-focus-email-panel hidden>
      <form data-focus-email-form>
        <label for="focus-email">
          <span>Электронная почта</span>
          <input
            id="focus-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="name@example.ru"
            required
          />
        </label>
        <button class="ke-button ke-button--primary" type="submit" data-focus-email-send>
          Получить код и ссылку
        </button>
        <span data-focus-email-resend-status aria-live="polite"></span>
      </form>

      <form data-focus-email-otp-form hidden>
        <label for="focus-email-otp">
          <span>Код из письма</span>
          <input
            id="focus-email-otp"
            name="otp"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            enterkeyhint="done"
            pattern="[0-9]{6}"
            minlength="6"
            maxlength="6"
            placeholder="000000"
            required
          />
        </label>
        <p>Введите шесть цифр. После последней цифры продолжим автоматически.</p>
        <button class="ke-button ke-button--secondary" type="submit" data-focus-email-otp-submit disabled>
          Подтвердить
        </button>
      </form>
    </div>

    <p class="focus-intake__status" data-focus-identity-status role="status" aria-live="polite"></p>
  </section>

  <section class="focus-intake__card focus-intake__card--done" data-intake-stage="done" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <span class="focus-intake__check" aria-hidden="true">✓</span>
    <h1 data-focus-done-title>Готово, можно начинать</h1>
    <p data-focus-done-copy>Теперь можно выбирать события и делиться впечатлениями.</p>
    <a class="ke-button ke-button--primary ke-button--large" href={homeHref}>Перейти к афише</a>
    <button class="focus-intake__skip" type="button" data-focus-restart hidden>
      Пройти подключение заново на этом устройстве
    </button>
  </section>
</main>

<script>
  import {
    cleanStaticAuthUrl,
    getStaticSiteAuth,
    staticAuthDisplayName,
  } from '../lib/staticSiteAuth';
  import { EMAIL_OTP_LENGTH, canSubmitEmailOtp, normalizeEmailOtp } from '../lib/emailOtp';
  import {
    activateFocusParticipation,
    clearFocusParticipationMarker,
    inspectFocusInviteUrl,
    readFocusParticipationMarker,
    storeFocusParticipationMarker,
    updateFocusParticipationIdentityChoice,
    type FocusIdentityChoice,
  } from '../lib/focus-group-prototype';

  document.querySelectorAll<HTMLElement>('[data-focus-intake]').forEach((root) => {
    const initialUrl = new URL(window.location.href);
    const emailCallbackAttempted = initialUrl.searchParams.get('email_callback') === '1'
      || Boolean(initialUrl.searchParams.get('token_hash'));
    const intake = inspectFocusInviteUrl(window.location.href);
    window.history.replaceState(window.history.state, '', intake.cleanHref);

    const pending = root.querySelector<HTMLElement>('[data-intake-pending]');
    const error = root.querySelector<HTMLElement>('[data-intake-error]');
    const errorTitle = root.querySelector<HTMLElement>('[data-intake-error-title]');
    const errorMessage = root.querySelector<HTMLElement>('[data-intake-error-message]');
    const stages = Array.from(root.querySelectorAll<HTMLElement>('[data-intake-stage]'));
    const identityStatus = root.querySelector<HTMLElement>('[data-focus-identity-status]');
    const doneTitle = root.querySelector<HTMLElement>('[data-focus-done-title]');
    const doneCopy = root.querySelector<HTMLElement>('[data-focus-done-copy]');
    const restartButton = root.querySelector<HTMLButtonElement>('[data-focus-restart]');
    const homeHref = root.dataset.homeHref || '/';
    let storage: Storage | null = null;
    try { storage = window.localStorage; } catch { storage = null; }

    const showStage = (stage: 'install' | 'identity' | 'done') => {
      stages.forEach((node) => { node.hidden = node.dataset.intakeStage !== stage; });
    };

    let participation = storage ? readFocusParticipationMarker(storage) : null;
    if (intake.status === 'accepted' && storage && !participation) {
      participation = storeFocusParticipationMarker(storage);
    }
    if (pending) pending.hidden = true;

    if (!participation) {
      if (error) error.hidden = false;
      if (intake.status === 'invalid') {
        if (errorTitle) errorTitle.textContent = 'Ссылка устарела';
        if (errorMessage) errorMessage.textContent = 'Отсканируйте новый QR-код.';
      } else if (intake.status === 'accepted') {
        if (errorTitle) errorTitle.textContent = 'Не получилось сохранить приглашение';
        if (errorMessage) errorMessage.textContent = 'Откройте ссылку в обычной вкладке и попробуйте ещё раз.';
      }
      return;
    }

    const intakeUrl = new URL(intake.cleanHref, window.location.origin);
    const launchFromApp = intakeUrl.searchParams.get('launch') === 'pwa';
    const confirmationRequested = intakeUrl.searchParams.get('confirm') === '1';
    if (participation.status === 'active' && confirmationRequested) showStage('identity');
    else if (participation.status === 'active') {
      if (doneTitle) doneTitle.textContent = 'Вы уже участвуете';
      if (doneCopy) doneCopy.textContent = 'Можно открыть афишу или пройти подключение заново на этом устройстве.';
      if (restartButton) restartButton.hidden = false;
      showStage('done');
    }
    else if (launchFromApp || participation.identityChoice !== 'undecided') showStage('identity');
    else showStage('install');

    root.querySelector<HTMLButtonElement>('[data-focus-install-skip]')?.addEventListener('click', () => {
      showStage('identity');
      root.querySelector<HTMLElement>('[data-intake-stage="identity"] h1')?.focus();
    });

    root.addEventListener('focuspwainstalled', () => {
      if (identityStatus) identityStatus.textContent = '«Анонсы» установлены. Откройте приложение с главного экрана или продолжите здесь.';
    });

    const emailOpen = root.querySelector<HTMLButtonElement>('[data-focus-email-open]');
    const emailPanel = root.querySelector<HTMLElement>('[data-focus-email-panel]');
    const emailForm = root.querySelector<HTMLFormElement>('[data-focus-email-form]');
    const emailInput = root.querySelector<HTMLInputElement>('#focus-email');
    const emailSend = root.querySelector<HTMLButtonElement>('[data-focus-email-send]');
    const resendStatus = root.querySelector<HTMLElement>('[data-focus-email-resend-status]');
    const otpForm = root.querySelector<HTMLFormElement>('[data-focus-email-otp-form]');
    const otpInput = root.querySelector<HTMLInputElement>('#focus-email-otp');
    const otpSubmit = root.querySelector<HTMLButtonElement>('[data-focus-email-otp-submit]');
    const yandexButton = root.querySelector<HTMLButtonElement>('[data-focus-yandex]');
    const skipButton = root.querySelector<HTMLButtonElement>('[data-focus-skip]');
    const signedInPanel = root.querySelector<HTMLElement>('[data-static-auth-signed-in]');
    const signedOutChoices = root.querySelector<HTMLElement>('[data-static-auth-signed-out]');
    const signedInName = root.querySelector<HTMLElement>('[data-static-auth-name]');
    const accountContinue = root.querySelector<HTMLButtonElement>('[data-focus-account-continue]');
    const accountLogout = root.querySelector<HTMLButtonElement>('[data-focus-account-logout]');
    const authRuntime = document.querySelector<HTMLElement>('[data-static-site-auth-runtime]');
    const auth = authRuntime?.dataset.authEnabled === 'true'
      && authRuntime.dataset.supabaseUrl
      && authRuntime.dataset.supabaseKey
      ? getStaticSiteAuth({
          supabaseUrl: authRuntime.dataset.supabaseUrl,
          publishableKey: authRuntime.dataset.supabaseKey,
          provider: authRuntime.dataset.yandexProvider || 'custom:yandex',
        })
      : null;
    if (!auth && signedOutChoices) signedOutChoices.hidden = false;

    let selectedChoice: Exclude<FocusIdentityChoice, 'undecided'> = participation.identityChoice === 'undecided'
      ? 'skipped'
      : participation.identityChoice;
    let pendingEmail = '';
    let otpVerifying = false;
    let lastSubmittedOtp = '';
    let resendTimer = 0;
    let completed = participation.status === 'active';

    restartButton?.addEventListener('click', () => {
      if (!storage) return;
      clearFocusParticipationMarker(storage);
      const restarted = storeFocusParticipationMarker(storage);
      if (!restarted) {
        if (doneCopy) doneCopy.textContent = 'Не получилось начать заново. Обновите страницу и повторите.';
        return;
      }
      participation = restarted;
      completed = false;
      selectedChoice = 'skipped';
      if (restartButton) restartButton.hidden = true;
      showStage('install');
      root.querySelector<HTMLElement>('[data-intake-stage="install"] h1')?.focus();
    });

    const finish = (choice: Exclude<FocusIdentityChoice, 'undecided'>, verified: boolean) => {
      if (!storage) return;
      if (completed) {
        if (verified) {
          if (doneTitle) doneTitle.textContent = 'Готово, участие подтверждено';
          if (doneCopy) doneCopy.textContent = 'Теперь можно участвовать в розыгрыше.';
          showStage('done');
          window.setTimeout(() => window.location.replace(homeHref), 1400);
        }
        return;
      }
      const activated = activateFocusParticipation(storage, choice);
      if (!activated) {
        if (identityStatus) identityStatus.textContent = 'Не получилось продолжить. Откройте приглашение ещё раз.';
        return;
      }
      completed = true;
      if (doneTitle) doneTitle.textContent = verified ? 'Готово, участие подтверждено' : 'Готово, можно начинать';
      if (doneCopy) {
        doneCopy.textContent = verified
          ? 'Теперь можно выбирать события и участвовать в розыгрыше.'
          : 'Подтвердить участие для розыгрыша можно позже.';
      }
      showStage('done');
      window.setTimeout(() => window.location.replace(homeHref), 1400);
    };

    emailOpen?.addEventListener('click', () => {
      if (emailPanel) emailPanel.hidden = false;
      if (otpForm) otpForm.hidden = false;
      emailInput?.focus();
    });

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!emailForm.reportValidity()) return;
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Сейчас письмо отправить не получилось. Можно продолжить без подтверждения.';
        return;
      }
      const email = emailInput?.value.trim() || '';
      selectedChoice = 'email_intent';
      if (storage) updateFocusParticipationIdentityChoice(storage, selectedChoice);
      if (emailSend) {
        emailSend.disabled = true;
        emailSend.setAttribute('aria-busy', 'true');
        emailSend.textContent = 'Отправляем…';
      }
      if (identityStatus) identityStatus.textContent = 'Отправляем письмо…';
      let sent = false;
      try {
        const emailRedirect = new URL(cleanStaticAuthUrl(window.location.href));
        emailRedirect.searchParams.set('email_callback', '1');
        sent = await auth.signInWithEmailOtp(email, emailRedirect.href);
      } catch {
        sent = false;
      }
      emailSend?.removeAttribute('aria-busy');
      pendingEmail = email;
      lastSubmittedOtp = '';
      if (otpInput) otpInput.value = '';
      if (otpSubmit) otpSubmit.disabled = true;
      if (otpForm) otpForm.hidden = false;
      otpInput?.focus();
      if (identityStatus) {
        identityStatus.textContent = sent
          ? 'Письмо отправлено. Введите код или нажмите кнопку в письме.'
          : 'Проверьте почту: письмо могло уже прийти. Если его нет, отправьте ещё раз через минуту.';
      }
      if (emailSend) emailSend.textContent = 'Отправить ещё раз';
      let remaining = 60;
      const tick = () => {
        if (resendStatus) resendStatus.textContent = remaining > 0 ? `Повторить через ${remaining} сек.` : 'Можно отправить ещё раз.';
        if (emailSend) emailSend.disabled = remaining > 0;
        if (remaining <= 0) {
          window.clearInterval(resendTimer);
          resendTimer = 0;
          return;
        }
        remaining -= 1;
      };
      if (resendTimer) window.clearInterval(resendTimer);
      tick();
      resendTimer = window.setInterval(tick, 1000);
    });

    emailInput?.addEventListener('input', () => {
      if (!pendingEmail || emailInput.value.trim() === pendingEmail) return;
      pendingEmail = '';
      if (resendTimer) window.clearInterval(resendTimer);
      if (emailSend) {
        emailSend.disabled = false;
        emailSend.textContent = 'Получить код и ссылку';
      }
    });

    const verifyOtp = async () => {
      if (!auth || !otpInput) return;
      const email = pendingEmail || emailInput?.value.trim() || '';
      if (!email || !emailInput?.checkValidity()) {
        if (identityStatus) identityStatus.textContent = 'Сначала укажите адрес, на который пришёл код.';
        emailInput?.focus();
        return;
      }
      const token = normalizeEmailOtp(otpInput.value);
      otpInput.value = token;
      if (!canSubmitEmailOtp(token, { inFlight: otpVerifying, lastSubmitted: lastSubmittedOtp })) return;
      otpVerifying = true;
      lastSubmittedOtp = token;
      otpInput.disabled = true;
      if (otpSubmit) otpSubmit.disabled = true;
      if (identityStatus) identityStatus.textContent = 'Проверяем код…';
      const verified = await auth.verifyEmailOtp(email, token);
      otpVerifying = false;
      if (!verified) {
        otpInput.disabled = false;
        lastSubmittedOtp = '';
        otpInput.select();
        if (otpSubmit) otpSubmit.disabled = false;
      }
    };

    otpInput?.addEventListener('input', () => {
      const token = normalizeEmailOtp(otpInput.value);
      otpInput.value = token;
      if (otpSubmit) otpSubmit.disabled = token.length !== EMAIL_OTP_LENGTH || otpVerifying;
      if (token.length === EMAIL_OTP_LENGTH) void verifyOtp();
    });
    otpForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void verifyOtp();
    });

    yandexButton?.addEventListener('click', async () => {
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Сейчас вход через Яндекс недоступен. Можно продолжить без подтверждения.';
        return;
      }
      selectedChoice = 'yandex_intent';
      if (storage) updateFocusParticipationIdentityChoice(storage, selectedChoice);
      if (identityStatus) identityStatus.textContent = 'Открываем Яндекс…';
      const started = await auth.linkYandexIdentity();
      if (!started && identityStatus) identityStatus.textContent = 'Не получилось открыть Яндекс. Попробуйте ещё раз.';
    });

    skipButton?.addEventListener('click', () => finish('skipped', false));
    accountContinue?.addEventListener('click', () => {
      const choice = selectedChoice === 'yandex_intent' ? 'yandex_intent' : 'email_intent';
      finish(choice, true);
    });
    accountLogout?.addEventListener('click', async () => {
      if (!auth) return;
      accountLogout.disabled = true;
      if (identityStatus) identityStatus.textContent = 'Выходим из аккаунта…';
      const signedOut = await auth.signOut();
      accountLogout.disabled = false;
      if (!signedOut) return;
      if (signedInPanel) signedInPanel.hidden = true;
      if (signedOutChoices) signedOutChoices.hidden = false;
      if (identityStatus) identityStatus.textContent = 'Вы вышли. Теперь выберите способ подтверждения или пропустите этот шаг.';
    });

    if (auth) {
      auth.subscribe((snapshot) => {
        if (snapshot.status === 'signed_in') {
          const intendedChoice = selectedChoice !== 'skipped'
            ? selectedChoice
            : participation.identityChoice;
          if (
            participation.status === 'joining'
            && (intendedChoice === 'email_intent' || intendedChoice === 'yandex_intent')
          ) {
            finish(intendedChoice, true);
            return;
          }
          if (signedInName) signedInName.textContent = staticAuthDisplayName(snapshot.user);
          if (signedInPanel) signedInPanel.hidden = false;
          if (signedOutChoices) signedOutChoices.hidden = true;
          if (identityStatus) identityStatus.textContent = 'Аккаунт уже подключён. Выберите, как продолжить.';
        } else if (snapshot.status === 'signed_out') {
          if (signedInPanel) signedInPanel.hidden = true;
          if (signedOutChoices) signedOutChoices.hidden = false;
        } else if (snapshot.status === 'error' && identityStatus) {
          if (snapshot.callbackAttempted && emailCallbackAttempted) {
            if (emailPanel) emailPanel.hidden = false;
            if (otpForm) otpForm.hidden = false;
            identityStatus.textContent = 'Ссылка не подтвердила вход. Укажите адрес и введите шестизначный код из этого же письма.';
            window.setTimeout(() => (emailInput?.value ? otpInput?.focus() : emailInput?.focus()), 0);
          } else {
            identityStatus.textContent = snapshot.message;
          }
          if (otpInput) otpInput.disabled = false;
        }
      });
      auth.initialize().catch(() => {
        if (identityStatus) identityStatus.textContent = 'Не получилось проверить вход. Можно продолжить без подтверждения.';
      });
    }
  });
</script>

<style>
  .focus-intake {
    width: min(560px, calc(100% - 1rem));
    margin: 0 auto;
    padding: clamp(.75rem, 3vw, 1.5rem) 0 3rem;
    color: var(--ke-color-copy, #44362d);
    font-family: var(--ke-font-sans, system-ui, sans-serif);
  }
  .focus-intake__brand { display: flex; justify-content: center; padding: .2rem 0 .8rem; }
  .focus-intake__brand img {
    width: 6.5rem;
    height: 6.5rem;
    min-width: 6.5rem;
    min-height: 6.5rem;
    max-width: 6.5rem;
    max-height: 6.5rem;
    flex: 0 0 6.5rem;
    border-radius: 24%;
    object-fit: contain;
    box-shadow: 0 12px 30px rgb(72 45 25 / 14%);
  }
  .focus-intake__card {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--ke-color-line, #e1d3c2);
    border-radius: 1.5rem;
    padding: clamp(1.15rem, 5vw, 2rem);
    background: #fffdf8;
    box-shadow: 0 18px 52px rgb(72 45 25 / 12%);
  }
  .focus-intake__card[hidden] { display: none; }
  .focus-intake__card h1 { margin: 0; color: #221a14; font-size: clamp(1.8rem, 7vw, 2.8rem); line-height: 1.02; letter-spacing: -.045em; }
  .focus-intake__card > p { margin: 0; color: #6d6259; font-size: 1rem; line-height: 1.5; }
  :global(.focus-intake .ke-button) { max-width: 100%; box-sizing: border-box; }
  .focus-intake__eyebrow { color: #98401f !important; font-size: .72rem !important; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .focus-intake__choices { display: grid; gap: .7rem; }
  .focus-intake__choices .ke-button { width: 100%; min-height: 50px; }
  .focus-intake__skip { min-height: 44px; border: 0; background: transparent; color: #6d6259; font: 800 .9rem/1.2 var(--ke-font-sans); text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .focus-intake__email, .focus-intake__email form, .focus-intake__signed { display: grid; gap: .75rem; }
  .focus-intake__email[hidden], .focus-intake__email form[hidden], .focus-intake__signed[hidden] { display: none; }
  .focus-intake__email label { display: grid; gap: .35rem; font-size: .84rem; font-weight: 850; }
  .focus-intake__email input { width: 100%; min-height: 52px; box-sizing: border-box; border: 1px solid #cdbfad; border-radius: .9rem; padding: .75rem .85rem; background: #fff; color: #221a14; font: 1rem/1.2 var(--ke-font-sans); }
  .focus-intake__email input:focus-visible, .focus-intake__skip:focus-visible { outline: 3px solid rgb(15 118 110 / 35%); outline-offset: 2px; }
  .focus-intake__email form > .ke-button { width: 100%; }
  .focus-intake__email form > span, .focus-intake__email form > p { margin: 0; color: #6d6259; font-size: .78rem; line-height: 1.4; }
