---
import FocusLabBadge from './FocusLabBadge.astro';
import FocusGroupThankYou from './FocusGroupThankYou.astro';
import FocusPwaInstallAction from './FocusPwaInstallAction.astro';
import { withBase } from '../lib/events';

const secretHref = withBase('/zakrytaya-afisha/');
const programmeHref = withBase('/fokus-gruppa/');
const focusIconHref = withBase('/assets/pwa/focus-group-icon.png');
---

<main
  class="focus-intake"
  data-focus-intake
  data-secret-href={secretHref}
  data-programme-href={programmeHref}
>
  <header class="focus-intake__brand">
    <img
      src={focusIconHref}
      width="1254"
      height="1254"
      alt="Полюбить Калининград"
    />
    <span>Фокус-группа · новая версия афиши</span>
  </header>

  <section class="focus-intake__card" data-intake-pending aria-live="polite">
    <span class="focus-intake__spinner" aria-hidden="true"></span>
    <h1>Проверяем ссылку</h1>
    <p>Это займёт всего несколько секунд.</p>
  </section>

  <section class="focus-intake__card focus-intake__card--error" data-intake-error hidden>
    <FocusLabBadge label="Фокус-группа" detail="Приглашение" />
    <p class="focus-intake__eyebrow">Приглашение не принято</p>
    <h1 data-intake-error-title>Нужна исходная ссылка</h1>
    <p data-intake-error-message>
      Откройте исходную ссылку или отсканируйте QR-код ещё раз.
    </p>
    <div class="focus-intake__actions">
      <a class="ke-button ke-button--primary" href={programmeHref}>О программе</a>
      <a class="ke-button ke-button--secondary" href={withBase('/')}>На стартовый экран</a>
    </div>
  </section>

  <div class="focus-intake__journey" data-intake-journey hidden>
    <section class="focus-intake__hero">
      <FocusLabBadge label="Добро пожаловать" detail="30 дней вместе" size="hero" />
      <p class="focus-intake__eyebrow">Шаг 1 из 3 · всё готово</p>
      <h1>Спасибо, что готовы проверить афишу вместе с нами</h1>
      <p class="focus-intake__lead">
        На этом телефоне участие сохранено на 30 дней. Ссылка больше не
        понадобится: возвращайтесь в афишу как обычно.
      </p>
      <div class="focus-intake__safety">
        <strong>После исследования ничего удалять или настраивать заново не нужно.</strong>
        <span>
          Приложение «Анонсы», аккаунт, избранное и ваши настройки продолжат
          работать как обычно.
        </span>
      </div>
    </section>

    <FocusPwaInstallAction />

    <section class="focus-intake__identity" aria-labelledby="focus-identity-title">
      <div class="focus-intake__identity-copy">
        <p class="focus-intake__eyebrow">Шаг 3 из 3 · по желанию</p>
        <h2 id="focus-identity-title">Хотите подтвердить участие?</h2>
        <p>
          Без подтверждения можно пользоваться афишей и участвовать в
          исследовании. Подтверждение понадобится только тем, кто хочет
          участвовать в розыгрыше двух билетов в театр.
        </p>
      </div>

      <div class="focus-intake__account" data-static-auth-signed-in hidden>
        <span>
          <strong>Вы вошли как <span data-static-auth-name></span></strong>
          Участие закреплено за вами — вы сможете участвовать в розыгрыше билетов.
        </span>
        <button class="ke-button ke-button--secondary" type="button" data-static-auth-logout hidden>
          Выйти
        </button>
      </div>

      <label class="focus-intake__consent">
        <input type="checkbox" data-focus-research-consent />
        <span>
          <strong>Хочу получать итоги фокус-группы, результат розыгрыша и важные новости «Анонсов».</strong>
          Этот выбор сохранится и после исследования. Отказаться можно в любой момент.
        </span>
      </label>

      <div class="focus-intake__auth-choices" data-static-auth-signed-out>
      <div class="focus-intake__methods">
        <section class="focus-intake__method">
          <span class="focus-intake__method-number" aria-hidden="true">01</span>
          <h3>Подтвердить по email</h3>
          <p>
            Отправим одно письмо: в нём будут удобная кнопка входа и
            шестизначный код.
          </p>
          <form class="focus-intake__email-request" data-focus-email-form>
            <label for="focus-email">
              <span>Email</span>
              <input
                id="focus-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@example.ru"
                required
              />
            </label>
            <button class="ke-button ke-button--primary" type="submit" data-focus-email-send>
              Получить код и ссылку
            </button>
            <span class="focus-intake__resend-status" data-focus-email-resend-status aria-live="polite"></span>
          </form>

          <form class="focus-intake__otp" data-focus-email-otp-form hidden>
            <div class="focus-intake__otp-copy">
              <strong>Введите код из письма</strong>
              <span>После шестой цифры проверка начнётся автоматически — Enter нажимать не нужно.</span>
            </div>
            <label for="focus-email-otp">
              <span>Шестизначный код</span>
              <input
                id="focus-email-otp"
                name="otp"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                enterkeyhint="done"
                pattern="[0-9]{6}"
                minlength="6"
                maxlength="6"
                placeholder="000000"
                aria-describedby="focus-email-otp-help"
                required
              />
            </label>
            <span id="focus-email-otp-help" class="focus-intake__otp-help">
              Только цифры. Код одноразовый; никому его не сообщайте.
            </span>
            <button class="ke-button ke-button--secondary" type="submit" data-focus-email-otp-submit disabled>
              Подтвердить код
            </button>
          </form>
        </section>

        <section class="focus-intake__method">
          <span class="focus-intake__method-number" aria-hidden="true">02</span>
          <h3>Подтвердить через Яндекс</h3>
          <p>Откроется официальный экран Яндекса; пароль KenigEvents не получает.</p>
          <button class="ke-button ke-button--secondary" type="button" data-focus-yandex>
            Выбрать Яндекс
          </button>
        </section>
      </div>

      <button class="focus-intake__skip" type="button" data-focus-skip>
        Продолжить пока без подтверждения
      </button>
      </div>

      <p class="focus-intake__identity-status" data-focus-identity-status role="status"></p>
      <div class="focus-intake__continue" data-focus-continue hidden>
        <div>
          <strong data-focus-continue-title>Можно продолжать.</strong>
          <span data-focus-continue-copy>Подтвердить участие для розыгрыша билетов можно позже.</span>
        </div>
        <button class="ke-button ke-button--primary ke-button--large" type="button" data-focus-enter>
          Открыть закрытую афишу
        </button>
      </div>
    </section>

    <FocusGroupThankYou />
  </div>
</main>

<script>
  import { getStaticSiteAuth } from '../lib/staticSiteAuth';
  import {
    EMAIL_OTP_LENGTH,
    canSubmitEmailOtp,
    normalizeEmailOtp,
  } from '../lib/emailOtp';
  import {
    activateFocusParticipation,
    inspectFocusInviteUrl,
    readFocusContinuingConsent,
    readFocusParticipationMarker,
    setFocusContinuingConsent,
    storeFocusParticipationMarker,
    updateFocusParticipationIdentityChoice,
    type FocusIdentityChoice,
  } from '../lib/focus-group-prototype';

  document.querySelectorAll<HTMLElement>('[data-focus-intake]').forEach((root) => {
    // Fragment inspection and removal must stay before every other client action.
    const intake = inspectFocusInviteUrl(window.location.href);
    window.history.replaceState(window.history.state, '', intake.cleanHref);

    const pending = root.querySelector<HTMLElement>('[data-intake-pending]');
    const error = root.querySelector<HTMLElement>('[data-intake-error]');
    const errorTitle = root.querySelector<HTMLElement>('[data-intake-error-title]');
    const errorMessage = root.querySelector<HTMLElement>('[data-intake-error-message]');
    const journey = root.querySelector<HTMLElement>('[data-intake-journey]');
    let focusStorage: Storage | null = null;
    try {
      focusStorage = window.localStorage;
    } catch {
      focusStorage = null;
    }
    const launchFromPwa = new URL(intake.cleanHref, window.location.origin)
      .searchParams.get('launch') === 'pwa';
    let participation = focusStorage ? readFocusParticipationMarker(focusStorage) : null;
    if (intake.status === 'accepted' && focusStorage && !participation) {
      participation = storeFocusParticipationMarker(focusStorage);
    }

    if (pending) pending.hidden = true;

    if (launchFromPwa && participation?.status === 'active') {
      window.location.replace(root.dataset.secretHref || '/zakrytaya-afisha/');
      return;
    }

    if (intake.status === 'accepted' && participation) {
      if (journey) journey.hidden = false;
    } else if (intake.status === 'missing' && participation) {
      if (journey) journey.hidden = false;
      const eyebrow = journey?.querySelector<HTMLElement>('.focus-intake__eyebrow');
      if (eyebrow) {
        eyebrow.textContent = participation.status === 'active'
          ? 'Возврат в программу · участие сохранено'
          : 'Возврат к вступлению · можно продолжить';
      }
    } else {
      if (error) error.hidden = false;
      if (intake.status === 'accepted' && !participation) {
        if (errorTitle) errorTitle.textContent = 'Не получилось сохранить участие';
        if (errorMessage) {
          errorMessage.textContent = 'Откройте ссылку в обычной вкладке браузера и попробуйте ещё раз.';
        }
      } else if (intake.status === 'invalid') {
        if (errorTitle) errorTitle.textContent = 'Ссылка повреждена или устарела';
        if (errorMessage) {
          errorMessage.textContent = 'Попросите новую ссылку или снова отсканируйте QR-код.';
        }
      } else if (launchFromPwa) {
        if (errorTitle) errorTitle.textContent = 'Приглашение не найдено';
        if (errorMessage) {
          errorMessage.textContent = 'Откройте обычную афишу. Чтобы снова присоединиться к фокус-группе, используйте исходное приглашение.';
        }
      }
    }

    const emailForm = root.querySelector<HTMLFormElement>('[data-focus-email-form]');
    const emailInput = root.querySelector<HTMLInputElement>('#focus-email');
    const emailSendButton = root.querySelector<HTMLButtonElement>('[data-focus-email-send]');
    const emailResendStatus = root.querySelector<HTMLElement>('[data-focus-email-resend-status]');
    const otpForm = root.querySelector<HTMLFormElement>('[data-focus-email-otp-form]');
    const otpInput = root.querySelector<HTMLInputElement>('#focus-email-otp');
    const otpSubmit = root.querySelector<HTMLButtonElement>('[data-focus-email-otp-submit]');
    const yandexButton = root.querySelector<HTMLButtonElement>('[data-focus-yandex]');
    const identityStatus = root.querySelector<HTMLElement>('[data-focus-identity-status]');
    const researchConsent = root.querySelector<HTMLInputElement>('[data-focus-research-consent]');
    const continueBlock = root.querySelector<HTMLElement>('[data-focus-continue]');
    const skipButton = root.querySelector<HTMLButtonElement>('[data-focus-skip]');
    const enterButton = root.querySelector<HTMLButtonElement>('[data-focus-enter]');
    const continueTitle = root.querySelector<HTMLElement>('[data-focus-continue-title]');
    const continueCopy = root.querySelector<HTMLElement>('[data-focus-continue-copy]');
    const authRuntime = document.querySelector<HTMLElement>('[data-static-site-auth-runtime]');
    const auth = authRuntime?.dataset.authEnabled === 'true'
      && authRuntime.dataset.supabaseUrl
      && authRuntime.dataset.supabaseKey
      ? getStaticSiteAuth({
          supabaseUrl: authRuntime.dataset.supabaseUrl,
          publishableKey: authRuntime.dataset.supabaseKey,
          provider: authRuntime.dataset.yandexProvider || 'custom:yandex',
        })
      : null;
    let selectedChoice: Exclude<FocusIdentityChoice, 'undecided'> = participation?.identityChoice === 'undecided'
      || !participation
      ? 'skipped'
      : participation.identityChoice;
    let pendingEmail = '';
    let otpVerifying = false;
    let lastSubmittedOtp = '';
    let resendTimer = 0;

    if (researchConsent && focusStorage) {
      researchConsent.checked = Boolean(readFocusContinuingConsent(focusStorage));
      researchConsent.addEventListener('change', () => {
        if (!focusStorage) return;
        setFocusContinuingConsent(focusStorage, researchConsent.checked);
      });
    }

    const revealContinue = (choice: Exclude<FocusIdentityChoice, 'undecided'>) => {
      if (!focusStorage) return;
      selectedChoice = choice;
      updateFocusParticipationIdentityChoice(focusStorage, choice);
      if (continueBlock) continueBlock.hidden = false;
      enterButton?.focus();
    };

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!emailForm.reportValidity()) return;
      const email = emailInput?.value.trim() || '';
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Вход временно недоступен. Можно продолжить без подтверждения.';
        return;
      }
      if (focusStorage) updateFocusParticipationIdentityChoice(focusStorage, 'email_intent');
      selectedChoice = 'email_intent';
      const emailRedirectTo = new URL(intake.cleanHref, window.location.origin).href;
      if (emailSendButton) {
        emailSendButton.disabled = true;
        emailSendButton.setAttribute('aria-busy', 'true');
        emailSendButton.textContent = 'Отправляем письмо…';
      }
      if (identityStatus) identityStatus.textContent = 'Отправляем письмо с кодом и ссылкой…';
      const sent = await auth.signInWithEmailOtp(email, emailRedirectTo);
      if (emailSendButton) emailSendButton.removeAttribute('aria-busy');
      if (identityStatus) {
        identityStatus.textContent = sent
          ? 'Письмо отправлено. Введите шесть цифр ниже или нажмите кнопку в письме.'
          : 'Не удалось отправить письмо. Проверьте адрес или продолжите без подтверждения.';
      }
      if (!sent) {
        if (emailSendButton) {
          emailSendButton.disabled = false;
          emailSendButton.textContent = 'Получить код и ссылку';
        }
        return;
      }
      pendingEmail = email;
      lastSubmittedOtp = '';
      if (otpInput) otpInput.value = '';
      if (otpSubmit) otpSubmit.disabled = true;
      if (otpForm) otpForm.hidden = false;
      otpInput?.focus();
      if (emailSendButton) emailSendButton.textContent = 'Отправить код ещё раз';
      let remaining = 60;
      const tick = () => {
        if (emailResendStatus) {
          emailResendStatus.textContent = remaining > 0
            ? `Новый код можно запросить через ${remaining} сек.`
            : 'Можно отправить код ещё раз.';
        }
        if (emailSendButton) emailSendButton.disabled = remaining > 0;
        if (remaining <= 0) {
          window.clearInterval(resendTimer);
          resendTimer = 0;
          return;
        }
        remaining -= 1;
      };
      if (resendTimer) window.clearInterval(resendTimer);
      tick();
      resendTimer = window.setInterval(tick, 1000);
    });

    emailInput?.addEventListener('input', () => {
      if (!pendingEmail || emailInput.value.trim() === pendingEmail) return;
      pendingEmail = '';
      lastSubmittedOtp = '';
      if (otpInput) otpInput.value = '';
      if (otpForm) otpForm.hidden = true;
      if (resendTimer) {
        window.clearInterval(resendTimer);
        resendTimer = 0;
      }
      if (emailSendButton) {
        emailSendButton.disabled = false;
        emailSendButton.textContent = 'Получить код и ссылку';
      }
      if (emailResendStatus) emailResendStatus.textContent = 'Отправьте новый код на изменённый адрес.';
    });

    yandexButton?.addEventListener('click', async () => {
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Вход через Яндекс временно недоступен. Можно продолжить без подтверждения.';
        return;
      }
      if (focusStorage) updateFocusParticipationIdentityChoice(focusStorage, 'yandex_intent');
      selectedChoice = 'yandex_intent';
      const started = await auth.linkYandexIdentity();
      if (!started && identityStatus) {
        identityStatus.textContent = 'Не удалось открыть Яндекс. Попробуйте ещё раз или продолжите без подтверждения.';
      }
    });

    skipButton?.addEventListener('click', () => {
      if (identityStatus) {
        identityStatus.textContent = 'Можно продолжать без подтверждения. Для розыгрыша билетов вернитесь сюда позже и войдите.';
      }
      if (continueTitle) continueTitle.textContent = 'Вы продолжаете без подтверждения.';
      if (continueCopy) {
        continueCopy.textContent = 'Участие сохранено на этом телефоне на 30 дней. Для розыгрыша билетов потребуется войти.';
      }
      revealContinue('skipped');
    });

    const submitOtp = async () => {
      if (!auth || !otpInput || !pendingEmail) return;
      const token = normalizeEmailOtp(otpInput.value);
      otpInput.value = token;
      if (!canSubmitEmailOtp(token, {
        inFlight: otpVerifying,
        lastSubmitted: lastSubmittedOtp,
      })) return;
      otpVerifying = true;
      lastSubmittedOtp = token;
      otpInput.disabled = true;
      if (otpSubmit) otpSubmit.disabled = true;
      if (identityStatus) identityStatus.textContent = 'Проверяю одноразовый код…';
      const verified = await auth.verifyEmailOtp(pendingEmail, token);
      otpVerifying = false;
      if (!verified) {
        otpInput.disabled = false;
        lastSubmittedOtp = '';
        otpInput.select();
        if (otpSubmit) otpSubmit.disabled = token.length !== EMAIL_OTP_LENGTH;
        return;
      }
      otpInput.value = '';
      if (otpForm) otpForm.hidden = true;
      pendingEmail = '';
    };

    otpInput?.addEventListener('input', () => {
      const token = normalizeEmailOtp(otpInput.value);
      if (otpInput.value !== token) otpInput.value = token;
      otpInput.removeAttribute('aria-invalid');
      if (otpSubmit) otpSubmit.disabled = token.length !== EMAIL_OTP_LENGTH || otpVerifying;
      if (token.length === EMAIL_OTP_LENGTH) void submitOtp();
    });

    otpForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void submitOtp();
    });

    if (participation?.status === 'active') {
      if (continueTitle) continueTitle.textContent = 'Участие уже сохранено на этом телефоне.';
      if (continueCopy) {
        continueCopy.textContent = 'Аккаунт, избранное и настройки продолжат работать после исследования.';
      }
      if (continueBlock) continueBlock.hidden = false;
    }

    if (auth) {
      auth.subscribe((snapshot) => {
        if (snapshot.status === 'signed_in') {
          if (identityStatus) identityStatus.textContent = 'Участие подтверждено. Вы сможете участвовать в розыгрыше билетов.';
          if (continueTitle) continueTitle.textContent = 'Участие подтверждено.';
          if (continueCopy) {
            continueCopy.textContent = 'Можно открыть афишу. Выйти из аккаунта можно здесь в любой момент.';
          }
          const choice = selectedChoice === 'yandex_intent' ? 'yandex_intent' : 'email_intent';
          revealContinue(choice);
        } else if (snapshot.status === 'error' && identityStatus) {
          identityStatus.textContent = snapshot.message;
          if (otpInput) otpInput.setAttribute('aria-invalid', 'true');
        }
      });
      auth.initialize().catch(() => {
        if (identityStatus) identityStatus.textContent = 'Не удалось проверить вход. Можно продолжить без подтверждения.';
      });
    }

    enterButton?.addEventListener('click', () => {
      if (!focusStorage) return;
      const activated = activateFocusParticipation(focusStorage, selectedChoice);
      if (!activated) {
        if (identityStatus) {
          identityStatus.textContent = 'Не получилось сохранить участие. Откройте исходное приглашение в обычной вкладке браузера.';
        }
        return;
      }
      window.location.assign(root.dataset.secretHref || '/zakrytaya-afisha/');
    });
  });
</script>

<style>
  .focus-intake {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1rem, 4vw, 3rem) 0 4rem;
    color: var(--ke-color-copy, #44362d);
    font-family: var(--ke-font-sans, system-ui, sans-serif);
  }

  .focus-intake__brand {
    display: grid;
    justify-items: center;
    gap: .55rem;
    padding: .25rem 0 1rem;
    text-align: center;
  }
  .focus-intake__brand img {
    width: clamp(7.5rem, 28vw, 11rem);
    height: clamp(7.5rem, 28vw, 11rem);
    aspect-ratio: 1;
    border-radius: 24%;
    object-fit: cover;
    box-shadow: 0 16px 36px rgb(72 45 25 / 14%);
  }
  .focus-intake__brand span {
    color: var(--ke-color-brand-700, #98401f);
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .focus-intake__card,
  .focus-intake__hero,
  .focus-intake__identity {
    border: 1px solid var(--ke-color-line, #e1d3c2);
    border-radius: 1.75rem;
    background: var(--ke-color-surface-strong, #fff);
    box-shadow: var(--ke-shadow-2, 0 18px 45px rgb(72 45 25 / 12%));
  }

  .focus-intake__card {
    min-height: min(520px, 68dvh);
    display: grid;
    place-items: center;
    align-content: center;
    gap: .8rem;
    padding: clamp(1.5rem, 5vw, 4rem);
    text-align: center;
  }

  .focus-intake__card[hidden],
  .focus-intake__journey[hidden] { display: none; }
  .focus-intake__card h1 { margin: 0; font-size: clamp(2rem, 6vw, 4rem); }
  .focus-intake__card p { max-width: 56ch; margin: 0; color: var(--ke-color-muted, #6d6259); line-height: 1.55; }
  .focus-intake__spinner { width: 36px; height: 36px; border: 3px solid var(--ke-color-line, #e1d3c2); border-right-color: var(--ke-color-brand-600, #a54821); border-radius: 50%; animation: focus-spin 700ms linear infinite; }
  .focus-intake__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; margin-top: .5rem; }
  .focus-intake__journey { display: grid; gap: 1rem; }

  .focus-intake__hero {
    position: relative;
    overflow: hidden;
    padding: clamp(1.4rem, 5vw, 4rem);
