---
import Button from './design-system/Button.astro';
import SemanticIcon from './design-system/SemanticIcon.astro';
import FocusLabBadge from './FocusLabBadge.astro';
import FocusPwaInstallAction from './FocusPwaInstallAction.astro';
import './design-system/product-contour-foundations.css';
import { withBase } from '../lib/events';

const homeHref = withBase('/');
const programmeHref = withBase('/fokus-gruppa/');
const focusIconHref = withBase('/assets/pwa/announcements-brand-v2-192.png');
---

<main
  class="focus-intake"
  data-ds-family="FocusGroupInviteIntake"
  data-ds-version="1"
  data-ds-variant="pwa-membership"
  data-ds-state="pending"
  data-ke-foundation-consumer="focus-invite-intake"
  data-focus-intake
  data-home-href={homeHref}
>
  <header class="focus-intake__brand">
    <img src={focusIconHref} width="192" height="192" alt="Полюбить Калининград · Анонсы" />
  </header>

  <section class="focus-intake__card focus-intake__card--pending" data-intake-pending aria-live="polite">
    <span class="focus-intake__spinner" aria-hidden="true"></span>
    <h1 data-intake-pending-title>Открываем приглашение…</h1>
    <p data-intake-pending-copy>Подождите немного.</p>
  </section>

  <section class="focus-intake__card" data-intake-error hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <h1 data-intake-error-title>Не получилось открыть приглашение</h1>
    <p data-intake-error-message>Отсканируйте QR-код ещё раз.</p>
    <Button variant="primary" href={programmeHref}>Получить новую ссылку</Button>
  </section>

  <section class="focus-intake__card" data-intake-stage="install" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <p class="focus-intake__eyebrow">Шаг 1 из 3</p>
    <h1 tabindex="-1">Присоединяйтесь к фокус-группе</h1>
    <p>
      Пользуйтесь афишей и помогайте нам сделать её понятнее и удобнее.
    </p>
    <div class="focus-intake__prize-note">
      <strong>Можно выиграть два билета в театр</strong>
      <span>
        В розыгрыше смогут участвовать те, кто пользуется афишей, находит
        артефакты, сообщает об ошибках, оценивает удобство и оставляет честные оценки.
      </span>
    </div>
    <div class="focus-intake__next">
      <strong>Сначала добавьте «Анонсы» на телефон</strong>
      <span>Так к афише будет удобно возвращаться. Можно продолжить и без установки.</span>
    </div>
    <FocusPwaInstallAction />
    <button class="focus-intake__skip" type="button" data-focus-install-skip>
      Продолжить без установки
    </button>
  </section>

  <section class="focus-intake__card" data-intake-stage="identity" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />

    <div class="focus-intake__heading" data-focus-identity-heading>
      <p class="focus-intake__eyebrow">Шаг 2 из 3</p>
      <h1 tabindex="-1">Подтвердите участие</h1>
      <p>
        Выберите почту или Яндекс. Так мы сможем связать ваши отзывы и находки
        с участием в розыгрыше. Подтверждённый адрес сохранится для связи по
        фокус-группе.
      </p>
    </div>

    <label class="focus-intake__contact-choice" data-focus-contact-choice>
      <input type="checkbox" data-focus-contact-consent />
      <span>
        <strong>Получать новости после презентации</strong>
        <small>
          Итоги фокус-группы, важные обновления «Анонсов» и новости клуба друзей.
          Это необязательно — отказаться можно в любой момент.
        </small>
      </span>
    </label>

    <div class="focus-intake__choices" data-focus-auth-signed-out hidden>
      <button class="ke-button ke-button--primary" type="button" data-ke-button-compat="runtime-hook" data-focus-email-open>
        По электронной почте
      </button>
      <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-focus-yandex>
        Через Яндекс
      </button>
      <button class="focus-intake__skip" type="button" data-focus-skip>
        Продолжить без подтверждения
      </button>
      <p class="focus-intake__helper">
        Афиша откроется сразу, но для участия в розыгрыше подтверждение понадобится позже.
      </p>
    </div>

    <div class="focus-intake__signed" data-focus-auth-signed-in hidden>
      <strong>Вы вошли как <span data-static-auth-name></span></strong>
      <span>Можно продолжить с этим аккаунтом или выбрать другой.</span>
      <button class="ke-button ke-button--primary" type="button" data-ke-button-compat="runtime-hook" data-focus-account-continue>
        Продолжить с этим аккаунтом
      </button>
      <button class="focus-intake__skip" type="button" data-focus-account-logout>
        Выйти и выбрать другой способ
      </button>
    </div>

    <div class="focus-intake__email" data-focus-email-panel hidden>
      <div class="focus-intake__email-step" data-focus-email-address-step>
        <div class="focus-intake__subheading">
          <p class="focus-intake__eyebrow">Подтверждение по почте</p>
          <h2 data-focus-email-address-title>Куда отправить письмо?</h2>
          <p data-focus-email-address-copy>
            Пришлём одну ссылку и шестизначный код. Вы сможете выбрать любой способ.
          </p>
        </div>
        <form data-focus-email-form>
          <label for="focus-email">
            <span>Электронная почта</span>
            <input
              id="focus-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="name@example.ru"
              required
            />
          </label>
          <button class="ke-button ke-button--primary" type="submit" data-ke-button-compat="runtime-hook" data-focus-email-send>
            Получить код и ссылку
          </button>
        </form>
        <button class="focus-intake__back" type="button" data-focus-email-back>
          Выбрать другой способ
        </button>
      </div>

      <div class="focus-intake__email-step" data-focus-email-code-step hidden>
        <div class="focus-intake__subheading">
          <p class="focus-intake__eyebrow">Письмо отправлено</p>
          <h2>Введите код</h2>
          <p>
            Нажмите кнопку в письме или введите шесть цифр, отправленных на
            <strong data-focus-email-destination></strong>.
          </p>
        </div>
        <form data-focus-email-otp-form>
          <label class="focus-intake__otp" for="focus-email-otp">
            <span class="focus-intake__otp-label">Код из письма</span>
            <span class="focus-intake__otp-boxes" data-focus-otp-boxes aria-hidden="true">
              <span data-focus-otp-digit></span>
              <span data-focus-otp-digit></span>
              <span data-focus-otp-digit></span>
              <span data-focus-otp-digit></span>
              <span data-focus-otp-digit></span>
              <span data-focus-otp-digit></span>
            </span>
            <input
              id="focus-email-otp"
              class="focus-intake__otp-input"
              name="otp"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              enterkeyhint="done"
              pattern="[0-9]{6}"
              minlength="6"
              maxlength="6"
              placeholder="000000"
              required
            />
          </label>
          <p
            class="focus-intake__otp-status"
            data-focus-email-otp-status
            role="status"
            aria-live="polite"
          >После шестой цифры продолжим автоматически.</p>
          <button type="submit" data-focus-email-otp-submit disabled hidden>
            Подтвердить
          </button>
        </form>
        <button class="focus-intake__back" type="button" data-focus-email-resend hidden>
          Отправить ещё раз
        </button>
        <span class="focus-intake__resend" data-focus-email-resend-status aria-live="polite"></span>
        <button class="focus-intake__back" type="button" data-focus-email-change>
          Изменить адрес
        </button>
      </div>
    </div>

    <p class="focus-intake__status" data-focus-identity-status role="status" aria-live="polite"></p>
  </section>

  <section class="focus-intake__card focus-intake__card--done" data-intake-stage="done" hidden>
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <p class="focus-intake__eyebrow">Шаг 3 из 3</p>
    <span class="focus-intake__check" aria-hidden="true"><SemanticIcon name="check" role="feature" /></span>
    <h1 data-focus-done-title tabindex="-1">Вы в фокус-группе</h1>
    <p data-focus-done-copy>
      Пользуйтесь афишей, находите артефакты, сообщайте об ошибках и оставляйте честные оценки.
    </p>
    <Button variant="primary" size="large" href={homeHref}>Открыть афишу</Button>
    <button class="focus-intake__skip" type="button" data-focus-restart hidden>
      Пройти подключение заново на этом устройстве
    </button>
  </section>
</main>

<script>
  import {
    cleanStaticAuthUrl,
    getStaticSiteAuth,
    staticAuthDisplayName,
  } from '../lib/staticSiteAuth';
  import { EMAIL_OTP_LENGTH, canSubmitEmailOtp, normalizeEmailOtp } from '../lib/emailOtp';
  import {
    activateFocusParticipation,
    clearFocusContinuingConsent,
    clearFocusParticipationMarker,
    inspectFocusInviteUrl,
    readFocusContinuingConsent,
    readFocusParticipationMarker,
    setFocusContinuingConsent,
    storeFocusParticipationMarker,
    updateFocusParticipationIdentityChoice,
    type FocusIdentityChoice,
  } from '../lib/focus-group-prototype';

  type IdentityView = 'choices' | 'signed_in' | 'email_address' | 'email_code';

  document.querySelectorAll<HTMLElement>('[data-focus-intake]').forEach((root) => {
    void bootstrapFocusIntake(root);
  });

  async function bootstrapFocusIntake(root: HTMLElement) {
    const initialUrl = new URL(window.location.href);
    const agentTestEmail = initialUrl.searchParams.get('agent_test_email') === 'focus-agent-e2e@kenigevents.ru'
      ? 'focus-agent-e2e@kenigevents.ru'
      : '';
    const resetRequested = initialUrl.searchParams.get('focus_test_reset') === '1';
    const emailCallbackAttempted = initialUrl.searchParams.get('email_callback') === '1'
      || Boolean(initialUrl.searchParams.get('token_hash'));
    const intake = inspectFocusInviteUrl(window.location.href);
    const pending = root.querySelector<HTMLElement>('[data-intake-pending]');
    const pendingTitle = root.querySelector<HTMLElement>('[data-intake-pending-title]');
    const pendingCopy = root.querySelector<HTMLElement>('[data-intake-pending-copy]');
    const error = root.querySelector<HTMLElement>('[data-intake-error]');
    const errorTitle = root.querySelector<HTMLElement>('[data-intake-error-title]');
    const errorMessage = root.querySelector<HTMLElement>('[data-intake-error-message]');
    const stages = Array.from(root.querySelectorAll<HTMLElement>('[data-intake-stage]'));
    const identityStatus = root.querySelector<HTMLElement>('[data-focus-identity-status]');
    const identityHeading = root.querySelector<HTMLElement>('[data-focus-identity-heading]');
    const doneTitle = root.querySelector<HTMLElement>('[data-focus-done-title]');
    const doneCopy = root.querySelector<HTMLElement>('[data-focus-done-copy]');
    const restartButton = root.querySelector<HTMLButtonElement>('[data-focus-restart]');
    const homeHref = root.dataset.homeHref || '/';
    const authRuntime = document.querySelector<HTMLElement>('[data-static-site-auth-runtime]');
    const auth = authRuntime?.dataset.authEnabled === 'true'
      && authRuntime.dataset.supabaseUrl
      && authRuntime.dataset.supabaseKey
      ? getStaticSiteAuth({
          supabaseUrl: authRuntime.dataset.supabaseUrl,
          relayUrl: authRuntime.dataset.supabaseRelayUrl || '',
          publishableKey: authRuntime.dataset.supabaseKey,
          provider: authRuntime.dataset.yandexProvider || 'custom:yandex',
        })
      : null;
    let storage: Storage | null = null;
    try { storage = window.localStorage; } catch { storage = null; }

    if (resetRequested) {
      if (pendingTitle) pendingTitle.textContent = 'Начинаем проверку заново…';
      if (pendingCopy) pendingCopy.textContent = 'Сбрасываем только вход в фокус-группу на этом устройстве.';
      if (storage) {
        clearFocusParticipationMarker(storage);
        clearFocusContinuingConsent(storage);
      }
      const authReset = await auth?.resetForOnboardingTest();
      if (auth && authReset !== true) {
        if (pendingTitle) pendingTitle.textContent = 'Не получилось очистить вход';
        if (pendingCopy) pendingCopy.textContent = 'Закройте другие вкладки «Анонсов», обновите страницу и повторите сброс.';
        return;
      }
      const restartUrl = new URL(initialUrl);
      restartUrl.searchParams.delete('focus_test_reset');
      restartUrl.searchParams.delete('code');
      restartUrl.searchParams.delete('email_callback');
      restartUrl.searchParams.delete('token_hash');
      restartUrl.searchParams.delete('type');
      window.location.replace(restartUrl.toString());
      return;
    }

    const cleanIntakeUrl = new URL(intake.cleanHref, window.location.origin);
    cleanIntakeUrl.searchParams.delete('agent_test_email');
    window.history.replaceState(
      window.history.state,
      '',
      `${cleanIntakeUrl.pathname}${cleanIntakeUrl.search}`,
    );

    const showStage = (stage: 'install' | 'identity' | 'done') => {
      stages.forEach((node) => { node.hidden = node.dataset.intakeStage !== stage; });
      root.dataset.dsState = stage;
      window.setTimeout(() => {
        root.querySelector<HTMLElement>(`[data-intake-stage="${stage}"] h1`)?.focus();
      }, 0);
    };

    let participation = storage ? readFocusParticipationMarker(storage) : null;
    if (intake.status === 'accepted' && storage && !participation) {
      participation = storeFocusParticipationMarker(storage);
    }
    if (pending) pending.hidden = true;

    if (!participation) {
      root.dataset.dsState = 'error';
      if (error) error.hidden = false;
      if (intake.status === 'invalid') {
        if (errorTitle) errorTitle.textContent = 'Ссылка устарела';
        if (errorMessage) errorMessage.textContent = 'Отсканируйте новый QR-код.';
      } else if (intake.status === 'accepted') {
        if (errorTitle) errorTitle.textContent = 'Не получилось сохранить приглашение';
        if (errorMessage) errorMessage.textContent = 'Откройте ссылку в обычной вкладке и попробуйте ещё раз.';
      }
      return;
    }

    const emailOpen = root.querySelector<HTMLButtonElement>('[data-focus-email-open]');
    const emailPanel = root.querySelector<HTMLElement>('[data-focus-email-panel]');
    const emailAddressStep = root.querySelector<HTMLElement>('[data-focus-email-address-step]');
    const emailCodeStep = root.querySelector<HTMLElement>('[data-focus-email-code-step]');
    const emailAddressTitle = root.querySelector<HTMLElement>('[data-focus-email-address-title]');
    const emailAddressCopy = root.querySelector<HTMLElement>('[data-focus-email-address-copy]');
    const emailForm = root.querySelector<HTMLFormElement>('[data-focus-email-form]');
    const emailInput = root.querySelector<HTMLInputElement>('#focus-email');
    const emailSend = root.querySelector<HTMLButtonElement>('[data-focus-email-send]');
    const resendButton = root.querySelector<HTMLButtonElement>('[data-focus-email-resend]');
    const resendStatus = root.querySelector<HTMLElement>('[data-focus-email-resend-status]');
    const emailDestination = root.querySelector<HTMLElement>('[data-focus-email-destination]');
    const otpForm = root.querySelector<HTMLFormElement>('[data-focus-email-otp-form]');
    const otpInput = root.querySelector<HTMLInputElement>('#focus-email-otp');
    const otpDigits = Array.from(root.querySelectorAll<HTMLElement>('[data-focus-otp-digit]'));
    const otpSubmit = root.querySelector<HTMLButtonElement>('[data-focus-email-otp-submit]');
    const otpStatus = root.querySelector<HTMLElement>('[data-focus-email-otp-status]');
    const yandexButton = root.querySelector<HTMLButtonElement>('[data-focus-yandex]');
    const skipButton = root.querySelector<HTMLButtonElement>('[data-focus-skip]');
    const signedInPanel = root.querySelector<HTMLElement>('[data-focus-auth-signed-in]');
    const signedOutChoices = root.querySelector<HTMLElement>('[data-focus-auth-signed-out]');
    const signedInName = root.querySelector<HTMLElement>('[data-static-auth-name]');
    const accountContinue = root.querySelector<HTMLButtonElement>('[data-focus-account-continue]');
    const accountLogout = root.querySelector<HTMLButtonElement>('[data-focus-account-logout]');
    const contactChoice = root.querySelector<HTMLElement>('[data-focus-contact-choice]');
    const contactConsent = root.querySelector<HTMLInputElement>('[data-focus-contact-consent]');
    let identityView: IdentityView = 'choices';

    if (contactConsent && storage) {
      contactConsent.checked = Boolean(readFocusContinuingConsent(storage));
      contactConsent.addEventListener('change', () => {
        setFocusContinuingConsent(storage!, contactConsent.checked);
      });
    }

    const showIdentityView = (view: IdentityView) => {
      identityView = view;
      if (identityHeading) identityHeading.hidden = view !== 'choices' && view !== 'signed_in';
      if (contactChoice) contactChoice.hidden = view !== 'choices' && view !== 'signed_in';
      if (signedOutChoices) signedOutChoices.hidden = view !== 'choices';
      if (signedInPanel) signedInPanel.hidden = view !== 'signed_in';
      if (emailPanel) emailPanel.hidden = view !== 'email_address' && view !== 'email_code';
      if (emailAddressStep) emailAddressStep.hidden = view !== 'email_address';
      if (emailCodeStep) emailCodeStep.hidden = view !== 'email_code';
    };

    const showEmailAddress = (recovery = false) => {
      showIdentityView('email_address');
      if (emailAddressTitle) {
        emailAddressTitle.textContent = recovery ? 'Получить новое письмо' : 'Куда отправить письмо?';
      }
      if (emailAddressCopy) {
        emailAddressCopy.textContent = recovery
          ? 'Предыдущая ссылка не сработала. Укажите адрес — пришлём новую ссылку и код.'
          : 'Пришлём одну ссылку и шестизначный код. Вы сможете выбрать любой способ.';
      }
      if (emailSend) emailSend.textContent = recovery ? 'Получить новое письмо' : 'Получить код и ссылку';
      window.setTimeout(() => emailInput?.focus(), 0);
    };

    const showEmailCode = () => {
      showIdentityView('email_code');
      if (emailDestination) emailDestination.textContent = pendingEmail;
      if (otpInput) {
        otpInput.disabled = false;
        otpInput.value = '';
      }
      lastSubmittedOtp = '';
      if (otpStatus) {
        otpStatus.dataset.state = 'idle';
        otpStatus.textContent = 'После шестой цифры продолжим автоматически.';
      }
      renderOtp();
      window.setTimeout(() => otpInput?.focus(), 0);
    };

    const intakeUrl = new URL(intake.cleanHref, window.location.origin);
    const launchFromApp = intakeUrl.searchParams.get('launch') === 'pwa';
    const confirmationRequested = intakeUrl.searchParams.get('confirm') === '1';
    if (participation.status === 'active' && confirmationRequested) {
      showStage('identity');
      showIdentityView('choices');
    } else if (participation.status === 'active' && launchFromApp) {
      window.location.replace(homeHref);
      return;
    } else if (participation.status === 'active') {
      if (doneTitle) doneTitle.textContent = 'Вы уже в фокус-группе';
      if (doneCopy) doneCopy.textContent = 'Можно открыть афишу или пройти подключение заново на этом устройстве.';
      if (restartButton) restartButton.hidden = false;
      showStage('done');
    } else if (launchFromApp || participation.identityChoice !== 'undecided' || emailCallbackAttempted) {
      showStage('identity');
      showIdentityView('choices');
    } else {
      showStage('install');
    }

    root.querySelector<HTMLButtonElement>('[data-focus-install-skip]')?.addEventListener('click', () => {
      showStage('identity');
      showIdentityView('choices');
    });

    let selectedChoice: Exclude<FocusIdentityChoice, 'undecided'> = participation.identityChoice === 'undecided'
      ? 'skipped'
      : participation.identityChoice;
    let pendingEmail = '';
    let otpVerifying = false;
    let lastSubmittedOtp = '';
    let resendTimer = 0;
    let completed = participation.status === 'active';
    let completionInFlight = false;
    let emailSending = false;

    const renderOtp = () => {
      if (!otpInput) return;
      const token = normalizeEmailOtp(otpInput.value);
      otpInput.value = token;
      otpDigits.forEach((digit, index) => {
        digit.textContent = token[index] || '';
        digit.toggleAttribute('data-filled', index < token.length);
        digit.toggleAttribute(
          'data-active',
          !otpVerifying && index === Math.min(token.length, EMAIL_OTP_LENGTH - 1),
        );
      });
      root.toggleAttribute('data-otp-verifying', otpVerifying);
      if (otpSubmit) otpSubmit.disabled = token.length !== EMAIL_OTP_LENGTH || otpVerifying;
    };

    if (agentTestEmail && participation.status === 'joining') {
      pendingEmail = agentTestEmail;
      selectedChoice = 'email_intent';
      if (storage) updateFocusParticipationIdentityChoice(storage, selectedChoice);
      showStage('identity');
      showEmailCode();
      if (identityStatus) {
        identityStatus.textContent = 'Введите временный код, выданный для проверки. Письмо не требуется.';
      }
    }

    const clearResendTimer = () => {
      if (resendTimer) window.clearInterval(resendTimer);
      resendTimer = 0;
    };

    const startResendTimer = () => {
      clearResendTimer();
      let remaining = 60;
      const tick = () => {
        if (resendStatus) {
          resendStatus.textContent = remaining > 0
            ? `Повторить можно через ${remaining} сек.`
            : '';
        }
        if (resendButton) resendButton.hidden = remaining > 0;
        if (remaining <= 0) {
          clearResendTimer();
          return;
        }
        remaining -= 1;
      };
      tick();
      resendTimer = window.setInterval(tick, 1000);
    };

    restartButton?.addEventListener('click', async () => {
      if (!storage) return;
      clearFocusParticipationMarker(storage);
      clearFocusContinuingConsent(storage);
      const authReset = await auth?.resetForOnboardingTest();
      if (auth && authReset !== true) {
        if (doneCopy) doneCopy.textContent = 'Не получилось очистить сохранённый вход. Закройте другие вкладки и повторите.';
        return;
      }
      const restarted = storeFocusParticipationMarker(storage);
      if (!restarted) {
        if (doneCopy) doneCopy.textContent = 'Не получилось начать заново. Обновите страницу и повторите.';
        return;
      }
      participation = restarted;
      completed = false;
      selectedChoice = 'skipped';
      if (restartButton) restartButton.hidden = true;
      showStage('install');
    });

    const finish = async (choice: Exclude<FocusIdentityChoice, 'undecided'>, verified: boolean) => {
      if (!storage) return;
      if (completionInFlight) return;
      completionInFlight = true;
      if (verified) {
        if (identityStatus) identityStatus.textContent = 'Сохраняем участие…';
        const saved = await auth?.registerFocusGroupParticipant({
          focusUpdatesConsent: contactConsent?.checked === true,
          sourceRoute: window.location.pathname,
        });
        if (!saved) {
          completionInFlight = false;
          if (accountContinue) accountContinue.textContent = 'Повторить сохранение';
          if (identityStatus) {
            identityStatus.dataset.state = 'warning';
            identityStatus.textContent = 'Вход подтверждён. Участие ещё не сохранилось — нажмите «Повторить сохранение».';
          }
          showIdentityView('signed_in');
          return;
        }
        if (accountContinue) accountContinue.textContent = 'Продолжить с этим аккаунтом';
        if (identityStatus) delete identityStatus.dataset.state;
        setFocusContinuingConsent(storage, contactConsent?.checked === true);
      }
      if (!completed) {
        const activated = activateFocusParticipation(storage, choice);
        if (!activated) {
          completionInFlight = false;
          if (identityStatus) identityStatus.textContent = 'Не получилось продолжить. Откройте приглашение ещё раз.';
          return;
        }
        completed = true;
      }
      if (doneTitle) doneTitle.textContent = verified ? 'Участие подтверждено' : 'Вы в фокус-группе';
      if (doneCopy) {
        doneCopy.textContent = verified
          ? 'Пользуйтесь афишей, находите артефакты, сообщайте об ошибках и оставляйте честные оценки.'
          : 'Афиша уже доступна. Чтобы участвовать в розыгрыше, подтвердите участие позже.';
      }
      showStage('done');
      completionInFlight = false;
    };

    const setSending = (sending: boolean) => {
      if (!emailSend) return;
      emailSend.disabled = sending;
      emailSend.toggleAttribute('aria-busy', sending);
      if (sending) emailSend.textContent = 'Отправляем…';
    };

    const sendEmail = async (email: string) => {
      if (emailSending) return;
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Сейчас письмо отправить не получилось. Выберите другой способ.';
        return;
      }
      pendingEmail = email;
      selectedChoice = 'email_intent';
      if (storage) updateFocusParticipationIdentityChoice(storage, selectedChoice);
      emailSending = true;
      setSending(true);
      if (identityStatus) identityStatus.textContent = 'Отправляем письмо…';
      let result = null;
      try {
        const emailRedirect = new URL(cleanStaticAuthUrl(window.location.href));
        emailRedirect.searchParams.set('email_callback', '1');
        result = await auth.signInWithEmailOtp(email, emailRedirect.href);
      } catch {
        result = {
          status: 'request_failed',
          accepted: false,
          message: 'Не удалось отправить письмо. Проверьте соединение и попробуйте ещё раз.',
        } as const;
      }
      emailSending = false;
      setSending(false);
      if (result.accepted) {
        showEmailCode();
        if (identityStatus) identityStatus.textContent = '';
        startResendTimer();
        return;
      }
      if (result.status === 'ambiguous') {
        // The selected-once request may have been accepted before its response
        // was lost. Let a delivered code finish the journey, but do not resend.
        showEmailCode();
        if (identityStatus) identityStatus.textContent = result.message;
        startResendTimer();
        return;
      }
      showEmailAddress(false);
      if (identityStatus) identityStatus.textContent = result.message;
      if (result.status === 'rate_limited') {
        if (emailSend) emailSend.disabled = true;
        window.setTimeout(() => {
          if (emailSend) emailSend.disabled = false;
        }, 60_000);
      }
    };

    emailOpen?.addEventListener('click', () => showEmailAddress(false));

    root.querySelectorAll<HTMLButtonElement>('[data-focus-email-back]').forEach((button) => {
      button.addEventListener('click', () => {
        clearResendTimer();
        if (identityStatus) identityStatus.textContent = '';
        showIdentityView('choices');
      });
    });

    root.querySelector<HTMLButtonElement>('[data-focus-email-change]')?.addEventListener('click', () => {
      clearResendTimer();
      if (identityStatus) identityStatus.textContent = '';
      showEmailAddress(false);
    });

    emailForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!emailForm.reportValidity()) return;
      void sendEmail(emailInput?.value.trim() || '');
    });

    resendButton?.addEventListener('click', () => {
      if (!pendingEmail || resendButton.disabled) return;
      void sendEmail(pendingEmail);
    });

    const verifyOtp = async () => {
      if (!auth || !otpInput) return;
      if (!pendingEmail) {
        if (identityStatus) identityStatus.textContent = 'Сначала укажите адрес, на который пришёл код.';
        showEmailAddress(false);
        return;
      }
      const token = normalizeEmailOtp(otpInput.value);
      otpInput.value = token;
      renderOtp();
      if (!canSubmitEmailOtp(token, { inFlight: otpVerifying, lastSubmitted: lastSubmittedOtp })) return;
      otpVerifying = true;
      lastSubmittedOtp = token;
      otpInput.setAttribute('aria-busy', 'true');
      if (otpSubmit) otpSubmit.disabled = true;
      if (otpStatus) {
        otpStatus.dataset.state = 'checking';
        otpStatus.textContent = 'Проверяем код…';
      }
      if (identityStatus) identityStatus.textContent = '';
      renderOtp();
      try {
        const verified = await auth.verifyEmailOtp(pendingEmail, token);
        if (verified.ok) {
          if (otpStatus) {
            otpStatus.dataset.state = 'success';
            otpStatus.textContent = 'Код подтверждён.';
          }
          otpInput.blur();
          await finish('email_intent', true);
          return;
        }
        lastSubmittedOtp = '';
        if (otpStatus) {
          otpStatus.dataset.state = 'error';
          otpStatus.textContent = verified.message;
        }
        if (identityStatus) identityStatus.textContent = '';
      } catch {
        lastSubmittedOtp = '';
        const message = 'Не получилось проверить код. Проверьте соединение и повторите.';
        if (otpStatus) {
          otpStatus.dataset.state = 'error';
          otpStatus.textContent = message;
        }
        if (identityStatus) identityStatus.textContent = '';
      } finally {
        otpVerifying = false;
        otpInput.removeAttribute('aria-busy');
        renderOtp();
        if (!completed && identityView === 'email_code') {
          otpInput.select();
          window.setTimeout(() => otpInput.focus(), 0);
        }
      }
    };

    const handleOtpMutation = () => {
      renderOtp();
      const token = otpInput?.value || '';
      if (token.length === EMAIL_OTP_LENGTH) void verifyOtp();
    };
    otpInput?.addEventListener('input', handleOtpMutation);
    // Android autofill/password managers may commit the code with `change`
    // rather than a final `input` event.
    otpInput?.addEventListener('change', handleOtpMutation);
    otpInput?.addEventListener('focus', renderOtp);
    otpInput?.addEventListener('blur', renderOtp);

    const useClipboardOtp = async (promptForPermission: boolean) => {
      if (!otpInput || !navigator.clipboard?.readText || otpVerifying) return false;
      if (!promptForPermission && navigator.permissions?.query) {
        try {
          const permission = await navigator.permissions.query({ name: 'clipboard-read' as PermissionName });
          if (permission.state !== 'granted') return false;
        } catch {
          return false;
        }
      }
      try {
        const token = normalizeEmailOtp(await navigator.clipboard.readText());
        if (token.length !== EMAIL_OTP_LENGTH) return false;
        otpInput.value = token;
        renderOtp();
        void verifyOtp();
        return true;
      } catch {
        if (promptForPermission && identityStatus) {
          identityStatus.textContent = 'Не получилось прочитать код. Нажмите на первую ячейку и вставьте его вручную.';
        }
        return false;
      }
    };

    window.addEventListener('focus', () => {
      if (identityView === 'email_code') void useClipboardOtp(false);
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && identityView === 'email_code') void useClipboardOtp(false);
    });
    otpForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      void verifyOtp();
    });

    yandexButton?.addEventListener('click', async () => {
      if (!auth) {
        if (identityStatus) identityStatus.textContent = 'Сейчас вход через Яндекс недоступен. Выберите почту или продолжите без подтверждения.';
        return;
      }
      selectedChoice = 'yandex_intent';
      if (storage) updateFocusParticipationIdentityChoice(storage, selectedChoice);
      yandexButton.disabled = true;
      yandexButton.setAttribute('aria-busy', 'true');
      if (identityStatus) identityStatus.textContent = 'Открываем Яндекс…';
      const started = await auth.linkYandexIdentity();
      if (!started) {
        yandexButton.disabled = false;
        yandexButton.removeAttribute('aria-busy');
        if (identityStatus) identityStatus.textContent = 'Не получилось открыть Яндекс. Попробуйте ещё раз.';
      }
    });

    skipButton?.addEventListener('click', () => { void finish('skipped', false); });
    accountContinue?.addEventListener('click', () => {
      const choice = selectedChoice === 'yandex_intent' ? 'yandex_intent' : 'email_intent';
      void finish(choice, true);
    });
    accountLogout?.addEventListener('click', async () => {
      if (!auth) return;
      accountLogout.disabled = true;
      if (identityStatus) identityStatus.textContent = 'Выходим из аккаунта…';
      const signedOut = await auth.signOut();
      accountLogout.disabled = false;
      if (!signedOut) return;
      if (identityStatus) identityStatus.textContent = 'Вы вышли. Теперь выберите способ подтверждения.';
      showIdentityView('choices');
    });

    if (!auth) {
      showIdentityView('choices');
      return;
    }

    auth.subscribe((snapshot) => {
      if (snapshot.status === 'signed_in') {
        if (signedInName) signedInName.textContent = staticAuthDisplayName(snapshot.user);
        const intendedChoice = selectedChoice !== 'skipped'
          ? selectedChoice
          : participation.identityChoice;
        if (
          participation.status === 'joining'
          && (intendedChoice === 'email_intent' || intendedChoice === 'yandex_intent')
        ) {
          void finish(intendedChoice, true);
          return;
        }
        showIdentityView('signed_in');
        if (identityStatus) identityStatus.textContent = '';
      } else if (snapshot.status === 'signed_out') {
        if (identityView === 'signed_in') showIdentityView('choices');
      } else if (snapshot.status === 'error') {
        if (snapshot.callbackAttempted && emailCallbackAttempted) {
          showEmailAddress(true);
          if (identityStatus) identityStatus.textContent = 'Ссылка не сработала. Получите новое письмо или выберите другой способ.';
        } else if (identityStatus) {
          identityStatus.textContent = snapshot.message;
        }
        if (otpInput) otpInput.disabled = false;
      }
    });
    auth.initialize().catch(() => {
      if (identityStatus) identityStatus.textContent = 'Не получилось проверить вход. Выберите способ ещё раз.';
      showIdentityView('choices');
    });
  }
</script>

