---
import type { PreviewEvent } from '../lib/types';
import { displayDate, displayDateTime, eventHref } from '../lib/events';

interface Props {
  event: PreviewEvent;
  occurrences?: PreviewEvent[];
  variant: 'desktop' | 'mobile' | 'practical';
}

type OccurrenceGroup = {
  date: string;
  dateLabel: string;
  weekdayFull: string;
  weekdayShort: string;
  occurrences: PreviewEvent[];
};

const { event, occurrences = [], variant } = Astro.props;
const weekdaysFull = ['воскресенье', 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота'];
const weekdaysShort = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
const weekdayIndex = (value: string) => {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/u.exec(value);
  if (!match) return -1;
  return new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3]))).getUTCDay();
};
const timeSortValue = (item: PreviewEvent) => {
  const match = /(\d{1,2}):(\d{2})/u.exec(item.start_time || item.display_time || '');
  return match ? `${match[1].padStart(2, '0')}:${match[2]}` : `99:${String(item.id).padStart(10, '0')}`;
};
const slotKey = (item: PreviewEvent) => {
  const raw = (item.start_time || item.display_time || '').trim().toLocaleLowerCase('ru-RU');
  const match = /(\d{1,2}):(\d{2})/u.exec(raw);
  return `${item.start_date}|${match ? `${match[1].padStart(2, '0')}:${match[2]}` : raw}`;
};
const unique = new Map<string, PreviewEvent>();
for (const item of [event, ...occurrences]) {
  const slot = slotKey(item);
  if (!unique.has(slot)) unique.set(slot, item);
}
const grouped = new Map<string, PreviewEvent[]>();
for (const item of unique.values()) {
  if (!grouped.has(item.start_date)) grouped.set(item.start_date, []);
  grouped.get(item.start_date)?.push(item);
}
const groups: OccurrenceGroup[] = [...grouped.entries()]
  .map(([date, items]) => {
    const dayIndex = weekdayIndex(date);
    return {
      date,
      dateLabel: displayDate(items[0]),
      weekdayFull: dayIndex >= 0 ? weekdaysFull[dayIndex] : '',
      weekdayShort: dayIndex >= 0 ? weekdaysShort[dayIndex] : '',
      occurrences: items.sort((left, right) => timeSortValue(left).localeCompare(timeSortValue(right)) || left.id - right.id),
    };
  })
  .sort((left, right) => left.date.localeCompare(right.date));
const currentGroup = groups.find((group) => group.date === event.start_date);
const hasAlternatives = unique.size > 1;
const alternativeCount = Math.max(0, unique.size - 1);
---

{!hasAlternatives ? (
  <div class:list={['event-occurrences', `event-occurrences--${variant}`, 'event-occurrences--single', variant === 'mobile' && 'event-hero__when']} data-event-occurrences data-occurrence-variant={variant} data-occurrence-current-id={event.id} data-occurrence-alternative-count="0">
    {variant === 'mobile' ? (
      <>
        {currentGroup?.weekdayShort && <span class="event-hero__weekday">{currentGroup.weekdayShort}</span>}
        <span class="event-hero__date">{currentGroup?.dateLabel || displayDate(event)}</span>
        {event.display_time && <span class="event-hero__time">{event.display_time}</span>}
      </>
    ) : variant === 'desktop' ? (
      <time datetime={event.starts_at || event.start_date} aria-current="page">
        <strong>{currentGroup?.dateLabel || displayDate(event)}</strong>
        {currentGroup?.weekdayFull && <b>{currentGroup.weekdayFull}</b>}
        {event.display_time && <strong>{event.display_time}</strong>}
      </time>
    ) : (
      <strong class="event-occurrences__practical-current">{displayDateTime(event)}</strong>
    )}
  </div>
) : (
  <nav
    class:list={['event-occurrences', `event-occurrences--${variant}`, 'event-occurrences--multiple', variant === 'mobile' && 'event-hero__when']}
    aria-label="Расписание сеансов"
    data-event-occurrences
    data-occurrence-variant={variant}
    data-occurrence-current-id={event.id}
    data-occurrence-alternative-count={alternativeCount}
  >
    {variant !== 'practical' && <span class="event-occurrences__title">Расписание</span>}
    <div class="event-occurrences__rows">
      {groups.map((group) => (
        <div class:list={['event-occurrences__date-row', group.occurrences.some((item) => item.id === event.id) && 'is-current-date']}>
          <span class="event-occurrences__date-copy">
            {variant === 'mobile' ? (
              <>
                {group.weekdayShort && <span class="event-hero__weekday">{group.weekdayShort}</span>}
                <strong class="event-hero__date">{group.dateLabel}</strong>
              </>
            ) : (
              <>
                <strong>{group.dateLabel}</strong>
                {group.weekdayFull && <span>{group.weekdayFull}</span>}
              </>
            )}
          </span>
          <span class="event-occurrences__times">
            {group.occurrences.map((item) => item.id === event.id ? (
              <time class="event-occurrences__time is-current" datetime={item.starts_at || item.start_date} aria-current="page">{item.display_time || 'время уточняется'}</time>
            ) : (
              <a class="event-occurrences__time" href={eventHref(item)} aria-label={`${group.dateLabel}, ${group.weekdayFull}, ${item.display_time || 'подробнее'}`}>{item.display_time || 'Подробнее'}</a>
            ))}
          </span>
        </div>
      ))}
    </div>
  </nav>
)}

<style>
  .event-occurrences { min-width:0; }
  .event-occurrences--single time { display:flex; align-items:baseline; gap:.65rem; color:inherit; font-variant-numeric:tabular-nums; }
  .event-occurrences--single time strong { font-size:clamp(.9rem,1.5vw,1.18rem); }
  .event-occurrences--single time b { color:#7b6b5e; }
  .event-occurrences__title { color:#75665b; font-size:.68rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
  .event-occurrences__rows { display:grid; gap:.34rem; min-width:0; }
  .event-occurrences__date-row { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.55rem 1rem; min-width:0; }
  .event-occurrences__date-copy { display:flex; flex-wrap:wrap; align-items:baseline; gap:.18rem .42rem; min-width:0; color:#352820; }
  .event-occurrences__date-copy strong { font-size:.82rem; font-weight:950; }
  .event-occurrences__date-copy > span:not(.event-hero__weekday) { color:#75665b; font-size:.72rem; font-weight:800; }
  .event-occurrences__times { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.32rem; min-width:0; font-variant-numeric:tabular-nums; }
  .event-occurrences__time { display:inline-flex; min-height:32px; align-items:center; justify-content:center; padding:.34rem .58rem; border:1px solid rgba(141,52,23,.28); border-radius:999px; background:#fffaf2; color:#8d3417; font-size:.76rem; font-weight:950; line-height:1; text-decoration:underline; text-decoration-thickness:1.5px; text-underline-offset:.18em; white-space:nowrap; }
  a.event-occurrences__time:hover { border-color:#b54d22; background:#fff3e8; color:#b54d22; }
  .event-occurrences__time:focus-visible { outline:2px solid #b54d22; outline-offset:2px; }
  .event-occurrences__time.is-current { border-color:#b54d22; background:#b54d22; color:#fffaf2; text-decoration:none; box-shadow:0 4px 12px rgba(141,52,23,.18); }

  .event-occurrences--desktop { display:grid; justify-items:end; gap:.3rem; max-width:min(31rem,100%); text-align:right; text-transform:none; }
  .event-occurrences--desktop .event-occurrences__rows { justify-items:stretch; min-width:min(25rem,48vw); }
  .event-occurrences--desktop .event-occurrences__date-copy { justify-content:flex-end; }
  .event-occurrences--desktop .event-occurrences__date-row + .event-occurrences__date-row { padding-top:.34rem; border-top:1px solid rgba(121,48,20,.12); }

  .event-occurrences--mobile.event-occurrences--multiple { display:grid !important; grid-template-columns:minmax(0,1fr) !important; gap:.38rem !important; line-height:1.15 !important; }
  .event-occurrences--mobile .event-occurrences__title { padding:.08rem .02rem 0; }
  .event-occurrences--mobile .event-occurrences__rows { gap:0; }
  .event-occurrences--mobile .event-occurrences__date-row { grid-template-columns:minmax(0,1fr) auto; min-height:54px; padding:.3rem .02rem; }
  .event-occurrences--mobile .event-occurrences__date-row + .event-occurrences__date-row { border-top:1px solid rgba(121,48,20,.12); }
  .event-occurrences--mobile .event-occurrences__date-copy { flex-wrap:nowrap; }
  .event-occurrences--mobile .event-occurrences__times { max-width:11.5rem; }
  .event-occurrences--mobile .event-occurrences__time { min-width:44px; min-height:44px; padding:.42rem .62rem; }

  .event-occurrences--practical { width:100%; margin-top:.24rem; text-transform:none; }
  .event-occurrences--practical .event-occurrences__rows { gap:.48rem; }
  .event-occurrences--practical .event-occurrences__date-row { grid-template-columns:minmax(9.5rem,1fr) minmax(8rem,auto); }
  .event-occurrences--practical .event-occurrences__date-row + .event-occurrences__date-row { padding-top:.48rem; border-top:1px solid rgba(121,48,20,.12); }
  .event-occurrences--practical .event-occurrences__times { justify-content:flex-start; }
  .event-occurrences__practical-current { display:block; }

  @media (max-width:430px) {
    .event-occurrences--mobile .event-occurrences__date-row { grid-template-columns:minmax(0,1fr); gap:.32rem; }
    .event-occurrences--mobile .event-occurrences__times { max-width:none; justify-content:flex-start; padding-left:2.72rem; }
  }
</style>
