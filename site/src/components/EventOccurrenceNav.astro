---
import type { PreviewEvent } from '../lib/types';
import { displayDate, displayDateTime, eventHref } from '../lib/events';

interface Props {
  event: PreviewEvent;
  occurrences?: PreviewEvent[];
  variant: 'desktop' | 'mobile' | 'practical';
}

type OccurrenceGroup = {
  date: string;
  dateLabel: string;
  weekdayFull: string;
  weekdayShort: string;
  occurrences: PreviewEvent[];
};

const { event, occurrences = [], variant } = Astro.props;
const weekdaysFull = ['воскресенье', 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота'];
const weekdaysShort = ['вс', 'пн', 'вт', 'ср', 'чт', 'пт', 'сб'];
const weekdayIndex = (value: string) => {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/u.exec(value);
  if (!match) return -1;
  return new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3]))).getUTCDay();
};
const timeSortValue = (item: PreviewEvent) => {
  const match = /(\d{1,2}):(\d{2})/u.exec(item.start_time || item.display_time || '');
  return match ? `${match[1].padStart(2, '0')}:${match[2]}` : `99:${String(item.id).padStart(10, '0')}`;
};
const slotKey = (item: PreviewEvent) => {
  const raw = (item.start_time || item.display_time || '').trim().toLocaleLowerCase('ru-RU');
  const match = /(\d{1,2}):(\d{2})/u.exec(raw);
  return `${item.start_date}|${match ? `${match[1].padStart(2, '0')}:${match[2]}` : raw}`;
};
const unique = new Map<string, PreviewEvent>();
for (const item of [event, ...occurrences]) {
  const slot = slotKey(item);
  if (!unique.has(slot)) unique.set(slot, item);
}
const grouped = new Map<string, PreviewEvent[]>();
for (const item of unique.values()) {
  if (!grouped.has(item.start_date)) grouped.set(item.start_date, []);
  grouped.get(item.start_date)?.push(item);
}
const groups: OccurrenceGroup[] = [...grouped.entries()]
  .map(([date, items]) => {
    const dayIndex = weekdayIndex(date);
    return {
      date,
      dateLabel: displayDate(items[0]),
      weekdayFull: dayIndex >= 0 ? weekdaysFull[dayIndex] : '',
      weekdayShort: dayIndex >= 0 ? weekdaysShort[dayIndex] : '',
      occurrences: items.sort((left, right) => timeSortValue(left).localeCompare(timeSortValue(right)) || left.id - right.id),
    };
  })
  .sort((left, right) => left.date.localeCompare(right.date));
const currentGroup = groups.find((group) => group.date === event.start_date);
const sameDateAlternatives = (currentGroup?.occurrences || []).filter((item) => item.id !== event.id);
const otherDateGroups = groups.filter((group) => group.date !== event.start_date);
const hasAlternatives = unique.size > 1;
const alternativeCount = Math.max(0, unique.size - 1);
const scheduleId = `event-schedule-${event.id}`;
---

{!hasAlternatives ? (
  <div class:list={['event-occurrences', `event-occurrences--${variant}`, 'event-occurrences--single', variant === 'mobile' && 'event-hero__when']} id={variant === 'practical' ? scheduleId : undefined} data-event-occurrences data-occurrence-variant={variant} data-occurrence-current-id={event.id} data-occurrence-alternative-count="0">
    {variant === 'mobile' ? (
      <>
        {currentGroup?.weekdayShort && <span class="event-hero__weekday">{currentGroup.weekdayShort}</span>}
        <span class="event-hero__date">{currentGroup?.dateLabel || displayDate(event)}</span>
        {event.display_time && <span class="event-hero__time">{event.display_time}</span>}
      </>
    ) : variant === 'desktop' ? (
      <time datetime={event.starts_at || event.start_date} aria-current="page">
        <strong>{currentGroup?.dateLabel || displayDate(event)}</strong>
        {currentGroup?.weekdayFull && <b>{currentGroup.weekdayFull}</b>}
        {event.display_time && <strong>{event.display_time}</strong>}
      </time>
    ) : (
      <strong class="event-occurrences__practical-current">{displayDateTime(event)}</strong>
    )}
  </div>
) : variant === 'practical' ? (
  <nav
    class="event-occurrences event-occurrences--practical event-occurrences--multiple"
    id={scheduleId}
    aria-label="Полное расписание сеансов"
    data-event-occurrences
    data-occurrence-variant="practical"
    data-occurrence-current-id={event.id}
    data-occurrence-alternative-count={alternativeCount}
  >
    <div class="event-occurrences__rows">
      {groups.map((group) => (
        <div class:list={['event-occurrences__date-row', group.occurrences.some((item) => item.id === event.id) && 'is-current-date']}>
          <span class="event-occurrences__date-copy">
            <strong>{group.dateLabel}</strong>
            {group.weekdayFull && <span>{group.weekdayFull}</span>}
          </span>
          <span class="event-occurrences__times event-occurrences__times--chips">
            {group.occurrences.map((item) => item.id === event.id ? (
              <time class="event-occurrences__time-chip is-current" datetime={item.starts_at || item.start_date} aria-current="page">{item.display_time || 'время уточняется'}</time>
            ) : (
              <a class="event-occurrences__time-chip" href={eventHref(item)} aria-label={`${group.dateLabel}, ${group.weekdayFull}, ${item.display_time || 'подробнее'}`}>{item.display_time || 'Подробнее'}</a>
            ))}
          </span>
        </div>
      ))}
    </div>
  </nav>
) : (
  <div
    class:list={['event-occurrences', `event-occurrences--${variant}`, 'event-occurrences--summary', variant === 'mobile' && 'event-hero__when']}
    data-event-occurrences
    data-occurrence-variant={variant}
    data-occurrence-current-id={event.id}
    data-occurrence-alternative-count={alternativeCount}
  >
    <div class="event-occurrences__current">
      {variant === 'mobile' ? (
        <>
          {currentGroup?.weekdayShort && <span class="event-hero__weekday">{currentGroup.weekdayShort}</span>}
          <span class="event-hero__date">{currentGroup?.dateLabel || displayDate(event)}</span>
          {event.display_time && <time class="event-hero__time" datetime={event.starts_at || event.start_date} aria-current="page">{event.display_time}</time>}
        </>
      ) : (
        <time datetime={event.starts_at || event.start_date} aria-current="page">
          <strong>{currentGroup?.dateLabel || displayDate(event)}</strong>
          {currentGroup?.weekdayFull && <b>{currentGroup.weekdayFull}</b>}
          {event.display_time && <strong>{event.display_time}</strong>}
        </time>
      )}
    </div>

    {(sameDateAlternatives.length > 0 || otherDateGroups.length > 0) && (
      <div class="event-occurrences__summary-links">
        {sameDateAlternatives.length > 0 && (
          <div class="event-occurrences__same-date" aria-label="Другое время в эту дату">
            <span>Другое время</span>
            <span class="event-occurrences__text-links">
              {sameDateAlternatives.map((item, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">, </span>}
                  <a href={eventHref(item)} aria-label={`${currentGroup?.dateLabel || displayDate(item)}, ${item.display_time || 'подробнее'}`}>{item.display_time || 'Подробнее'}</a>
                </>
              ))}
            </span>
          </div>
        )}
        {otherDateGroups.length > 0 && variant === 'desktop' && (
          <a class="event-occurrences__schedule-jump" href={`#${scheduleId}`}>Другие даты <span>({otherDateGroups.length})</span><span aria-hidden="true"> ↓</span></a>
        )}
      </div>
    )}

    {variant === 'mobile' && otherDateGroups.length > 0 && (
      <div class="event-occurrences__other-dates">
        <span class="event-occurrences__other-title">Другие даты</span>
        <nav class="event-occurrences__mobile-list" aria-label="Другие даты и время события">
          {otherDateGroups.map((group) => (
            <div class="event-occurrences__mobile-row">
              <span class="event-occurrences__mobile-date">
                {group.weekdayShort && <small>{group.weekdayShort}</small>}
                <strong>{group.dateLabel}</strong>
              </span>
              <span class="event-occurrences__text-links">
                {group.occurrences.map((item, index) => (
                  <>
                    {index > 0 && <span aria-hidden="true">, </span>}
                    <a href={eventHref(item)} aria-label={`${group.weekdayFull}, ${group.dateLabel}, ${item.display_time || 'подробнее'}`}>{item.display_time || 'Подробнее'}</a>
                  </>
                ))}
              </span>
            </div>
          ))}
        </nav>
      </div>
    )}
  </div>
)}

<style>
  .event-occurrences { min-width:0; }
  .event-occurrences--single time,
  .event-occurrences--desktop .event-occurrences__current time { display:flex; align-items:baseline; justify-content:flex-end; gap:.65rem; color:inherit; font-variant-numeric:tabular-nums; }
  .event-occurrences--single time strong,
  .event-occurrences--desktop .event-occurrences__current time strong { font-size:clamp(.9rem,1.5vw,1.18rem); }
  .event-occurrences--single time b,
  .event-occurrences--desktop .event-occurrences__current time b { color:#7b6b5e; }

  .event-occurrences--desktop { display:flex; flex-direction:column; align-items:flex-end; max-width:min(34rem,100%); text-align:right; text-transform:none; }
  .event-occurrences--desktop .event-occurrences__summary-links { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:baseline; gap:.12rem .8rem; min-height:1.55rem; margin-top:.12rem; color:#75665b; font-size:.74rem; letter-spacing:0; }
  .event-occurrences__same-date { display:flex; flex-wrap:wrap; align-items:baseline; gap:.25rem .45rem; }
  .event-occurrences__text-links { color:#8d3417; font-variant-numeric:tabular-nums; font-weight:900; white-space:nowrap; }
  .event-occurrences__text-links a,
  .event-occurrences__schedule-jump { color:#8d3417; font-weight:900; text-decoration:underline; text-decoration-thickness:1.5px; text-underline-offset:.2em; }
  .event-occurrences__schedule-jump span { text-decoration:none; }
  .event-occurrences__text-links a:hover,
  .event-occurrences__schedule-jump:hover { color:#b54d22; }
  .event-occurrences__text-links a:focus-visible,
  .event-occurrences__schedule-jump:focus-visible { outline:2px solid #b54d22; outline-offset:3px; border-radius:3px; }

  .event-occurrences--mobile.event-occurrences--summary { display:grid !important; grid-template-columns:minmax(0,1fr) !important; gap:0 !important; line-height:1.15 !important; }
  .event-occurrences--mobile .event-occurrences__current { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:.5rem; min-height:44px; }
  .event-occurrences--mobile .event-occurrences__summary-links { display:grid; gap:0; }
  .event-occurrences--mobile .event-occurrences__same-date { min-height:44px; color:#75665b; font-size:.78rem; line-height:1.35; }
  .event-occurrences--mobile .event-occurrences__text-links a { display:inline-flex; min-width:44px; min-height:44px; align-items:center; justify-content:center; margin:-.55rem -.35rem; padding:.55rem .35rem; }
  .event-occurrences__other-dates { margin-top:.12rem; }
  .event-occurrences__other-title { display:flex; min-height:36px; align-items:center; color:#8d3417; font-size:.8rem; font-weight:900; text-decoration:none; }
  .event-occurrences__mobile-list { display:grid; padding:.1rem .65rem; border:1px solid rgba(121,48,20,.2); border-radius:10px; background:rgba(255,250,242,.64); }
  .event-occurrences__mobile-row { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.7rem; min-height:50px; }
  .event-occurrences__mobile-row + .event-occurrences__mobile-row { border-top:1px solid rgba(121,48,20,.12); }
  .event-occurrences__mobile-date { display:flex; align-items:baseline; gap:.45rem; min-width:0; }
  .event-occurrences__mobile-date small { color:#7b6b5e; font-size:.68rem; font-weight:900; text-transform:uppercase; }
  .event-occurrences__mobile-date strong { color:#352820; font-size:.82rem; }

  .event-occurrences--practical { width:100%; margin-top:.24rem; scroll-margin-top:7rem; text-transform:none; }
  .event-occurrences__rows { display:grid; gap:.48rem; min-width:0; }
  .event-occurrences__date-row { display:grid; grid-template-columns:minmax(9.5rem,1fr) minmax(8rem,auto); align-items:center; gap:.55rem 1rem; min-width:0; }
  .event-occurrences__date-row + .event-occurrences__date-row { padding-top:.48rem; border-top:1px solid rgba(121,48,20,.12); }
  .event-occurrences__date-copy { display:flex; flex-wrap:wrap; align-items:baseline; gap:.18rem .42rem; min-width:0; color:#352820; }
  .event-occurrences__date-copy strong { font-size:.82rem; font-weight:950; }
  .event-occurrences__date-copy > span { color:#75665b; font-size:.72rem; font-weight:800; }
  .event-occurrences__times { display:flex; flex-wrap:wrap; justify-content:flex-start; gap:.32rem; min-width:0; font-variant-numeric:tabular-nums; }
  .event-occurrences__time-chip { display:inline-flex; min-height:32px; align-items:center; justify-content:center; padding:.34rem .58rem; border:1px solid rgba(141,52,23,.28); border-radius:999px; background:#fffaf2; color:#8d3417; font-size:.76rem; font-weight:950; line-height:1; text-decoration:underline; text-decoration-thickness:1.5px; text-underline-offset:.18em; white-space:nowrap; }
  a.event-occurrences__time-chip:hover { border-color:#b54d22; background:#fff3e8; color:#b54d22; }
  .event-occurrences__time-chip:focus-visible { outline:2px solid #b54d22; outline-offset:2px; }
  .event-occurrences__time-chip.is-current { border-color:#b54d22; background:#b54d22; color:#fffaf2; text-decoration:none; box-shadow:0 4px 12px rgba(141,52,23,.18); }
  .event-occurrences__practical-current { display:block; }
</style>
