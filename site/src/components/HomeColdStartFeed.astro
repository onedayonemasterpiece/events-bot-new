---
import AdaptiveEventCardGrid, { type AdaptiveEventCardItemRoot } from './AdaptiveEventCardGrid.astro';
import './design-system/product-contour-foundations.css';
import type { PreviewEvent } from '../lib/types';
import { getCurrentDate } from '../lib/events';
import { toPersonalFeedCandidate } from '../lib/personalization/catalog';
import { rankHomeCandidates } from '../lib/homeFeed.mjs';

interface Props { events: PreviewEvent[]; }
const { events } = Astro.props;
// Eligibility and shared diversity/ranking see the entire catalogue pool before the home budget.
const candidates = events.map((event, index) => ({
  ...toPersonalFeedCandidate(event, getCurrentDate()),
  static_score: Math.max(0, 1 - index / Math.max(1, events.length)),
}));
const generalPlan = rankHomeCandidates(candidates);
const byId = new Map(events.map((event) => [String(event.id), event]));
const eligibleEvents = generalPlan.items.slice(0, 30).map((item) => byId.get(String(item.event_id))!);
const serializedPool = JSON.stringify({ v:1, currentDate:getCurrentDate(), candidates }).replace(/</g, '\\u003c');
const itemRoots: Record<string, AdaptiveEventCardItemRoot> = Object.fromEntries(
  eligibleEvents.map((event, index) => [
    `${event.id}:${index}`,
    {
      className:'home-feed__item',
      attributes:{
        'data-home-feed-item':'',
        'data-event-id':event.id,
        'data-home-base-rank':index,
      },
    },
  ]),
);
---

<section
  class="home-feed"
  data-ds-family="HomeColdStartFeed"
  data-ds-version="2"
  data-ds-variant="shared-ranked-finite-feed"
  data-ds-state={`static-fallback ${eligibleEvents.length ? 'populated' : 'empty'}`}
  data-home-cold-start-feed
  data-home-feed-mode="static_fallback"
  aria-labelledby="home-feed-title"
>
  <header class="home-feed__head">
    <div>
      <h2 id="home-feed-title">Куда сходить</h2>
    </div>
    <p data-home-feed-status role="status" aria-live="polite">Общая подборка</p>
  </header>
  <script type="application/json" data-home-feed-candidates set:html={serializedPool} />
  <p data-home-feed-empty hidden={eligibleEvents.length > 0}>Пока нет подходящих событий. Попробуйте уточнить выбор в поиске выше.</p>
  <AdaptiveEventCardGrid
    events={eligibleEvents}
    mode="flow"
    limit={30}
    rowSize={3}
    responsive="progressive"
    mobileFlowMedia
    runtimeManaged
    runtimeVisibleOnly
    runtimeSourcePolicy="all-direct"
    className="home-feed__grid"
    rootAttributes={{
      'data-home-feed-grid':'',
      'data-home-feed-limit':'30',
    }}
    itemRoots={itemRoots}
  />
</section>

<script>
  import { bindHomeFeeds } from '../lib/homeFeedRuntime';
  bindHomeFeeds();
</script>

<style>
  .home-feed {
    margin-top: 1rem;
    padding: 0;
  }
  .home-feed__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .home-feed__head h2 {
    margin: .1rem 0 0;
    font: var(--ke-type-h2);
    letter-spacing: var(--ke-type-h2-letter);
  }
  .home-feed__head > p {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: .92rem;
    font-weight: 720;
    text-align: right;
  }
  @media (max-width: 620px) {
    .home-feed__head { display: grid; align-items: start; }
    .home-feed__head > p { text-align: left; }
  }
</style>
