---
import AdaptiveEventCardGrid, { type AdaptiveEventCardItemRoot } from './AdaptiveEventCardGrid.astro';
import './design-system/product-contour-foundations.css';
import type { PreviewEvent } from '../lib/types';
import { eventCategory, eventTags } from '../lib/events';

interface Props { events: PreviewEvent[]; }
const { events } = Astro.props;
const visibleEvents = events.slice(0, 30);
const itemRoots: Record<string, AdaptiveEventCardItemRoot> = Object.fromEntries(
  visibleEvents.map((event, index) => [
    `${event.id}:${index}`,
    {
      className:'home-feed__item',
      attributes:{
        'data-home-feed-item':'',
        'data-event-id':event.id,
        'data-home-base-rank':index,
        'data-home-category':eventCategory(event),
        'data-home-tags':JSON.stringify(eventTags(event)),
      },
    },
  ]),
);
---

<section
  class="home-feed"
  data-ds-family="HomeColdStartFeed"
  data-ds-version="1"
  data-ds-variant="local-profile-rerank"
  data-ds-state={`static-fallback ${visibleEvents.length ? 'populated' : 'empty'}`}
  data-home-cold-start-feed
  data-home-feed-mode="static_fallback"
  aria-labelledby="home-feed-title"
>
  <header class="home-feed__head">
    <div>
      <p class="eyebrow">Общее главное</p>
      <h2 id="home-feed-title">Можно начать отсюда</h2>
    </div>
    <p data-home-feed-status role="status" aria-live="polite">Разнообразная общая подборка — вход и внешние сервисы не нужны.</p>
  </header>
  <AdaptiveEventCardGrid
    events={visibleEvents}
    mode="flow"
    limit={30}
    rowSize={3}
    responsive="progressive"
    mobileFlowMedia
    runtimeManaged
    runtimeVisibleOnly
    runtimeSourcePolicy="all-direct"
    className="home-feed__grid"
    rootAttributes={{
      'data-home-feed-grid':'',
      'data-home-feed-limit':'30',
    }}
    itemRoots={itemRoots}
  />
</section>

<script>
  import { homeProfileSignalCount, rankHomeFeedItems } from '../lib/homeFeed.mjs';

  const PROFILE_KEY = 'ke_personalization_profile';
  const roots = Array.from(document.querySelectorAll('[data-home-cold-start-feed]'));

  function readProfile() {
    try { return JSON.parse(window.localStorage.getItem(PROFILE_KEY) || 'null'); }
    catch { return null; }
  }

  for (const root of roots) {
    if (!(root instanceof HTMLElement) || root.dataset.homeFeedBound === 'true') continue;
    root.dataset.homeFeedBound = 'true';
    const grid = root.querySelector('[data-home-feed-grid]');
    const status = root.querySelector('[data-home-feed-status]');
    if (!(grid instanceof HTMLElement)) continue;
    const staticItems = Array.from(grid.querySelectorAll(':scope > [data-home-feed-item]'))
      .filter((item) => item instanceof HTMLElement)
      .map((item) => {
        let tags = [];
        try { tags = JSON.parse(item.dataset.homeTags || '[]'); } catch {}
        return {
          id: item.dataset.eventId || '',
          baseRank: Number(item.dataset.homeBaseRank || 0),
          category: item.dataset.homeCategory || '',
          tags,
          element: item,
        };
      });

    const rerank = () => {
      const profile = readProfile();
      const ranked = rankHomeFeedItems(staticItems, profile);
      const visible = new Set(ranked.map((item) => String(item.id)));
      for (const item of staticItems) item.element.hidden = !visible.has(String(item.id));
      for (const item of ranked) {
        item.element.dataset.homeFeedRank = String(item.rank);
        item.element.dataset.homeFeedScore = Number(item.score || 0).toFixed(3);
        grid.appendChild(item.element);
      }
      const signals = homeProfileSignalCount(profile);
      if (status) {
        status.textContent = signals > 0
          ? `Порядок уточнён по локальным оценкам: ${signals}. В ленте не больше 30 событий.`
          : 'Разнообразная общая подборка — вход и внешние сервисы не нужны.';
      }
      const mode = signals > 0 ? 'local_rerank' : 'static_fallback';
      root.dataset.homeFeedMode = mode;
      root.dataset.dsState = `${mode.replace('_', '-')} ${ranked.length ? 'populated' : 'empty'}`;
    };

    rerank();
    window.addEventListener('storage', (event) => {
      if (event.key === PROFILE_KEY) rerank();
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-feedback-action]')) return;
      window.setTimeout(rerank, 180);
    });
  }
</script>

<style>
  .home-feed {
    margin-top: 1rem;
    padding: var(--ke-space-home-feed-padding);
    border: 1px solid var(--ke-color-border-brand-soft);
    border-radius: var(--ke-shape-radius-home-feed);
    background: var(--ke-color-home-feed-surface);
  }
  .home-feed__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .home-feed__head h2 {
    margin: .1rem 0 0;
    font: var(--ke-type-h2);
    letter-spacing: var(--ke-type-h2-letter);
  }
  .home-feed__head > p {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: .92rem;
    font-weight: 720;
    text-align: right;
  }
  @media (max-width: 620px) {
    .home-feed { padding: .7rem; }
    .home-feed__head { display: grid; align-items: start; padding: .35rem; }
    .home-feed__head > p { text-align: left; }
  }
</style>
