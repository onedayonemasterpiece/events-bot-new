---
interface Props {
  total: number;
  label?: string;
}
const { total, label = 'списке' } = Astro.props;
---
<div class="listing-filter" data-listing-filter data-listing-total={total} data-nosnippet hidden>
  <div class="listing-filter__copy" tabindex="-1" data-listing-filter-summary-focus>
    <strong data-listing-filter-title>Все события</strong>
    <span data-listing-filter-summary>Показаны все события в {label}.</span>
  </div>
  <div class="listing-filter__actions" role="group" aria-label="Режим списка событий">
    <button type="button" data-listing-mode-button="personal" aria-pressed="false">Для меня</button>
    <button type="button" data-listing-mode-button="all" aria-pressed="true">Все <span data-listing-total-count>{total}</span></button>
  </div>
</div>
<div class="listing-filter-bar" data-listing-filter-bar data-nosnippet hidden>
  <button type="button" data-listing-mode-button="personal" aria-pressed="false">Для меня <span data-listing-visible-count>{total}</span></button>
  <button type="button" data-listing-mode-button="all" aria-pressed="true">Все <span data-listing-total-count>{total}</span></button>
  <span data-listing-hidden-count>Скрыто 0</span>
</div>
