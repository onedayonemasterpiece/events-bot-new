---
import { withBase } from '../lib/events';

const PRELAUNCH_LAUNCH_DATE = '2026-09-01';
const statePattern = ['sealed', 'dim', 'revealed', 'dim', 'sealed', 'dim'];
const tiles = Array.from({ length: 72 }, (_, index) => ({
  state: statePattern[(index * 5 + Math.floor(index / 8) * 3) % statePattern.length],
  duration: 4.6 + ((index * 17) % 31) / 10,
  delay: -((index * 11) % 29) / 10,
}));
---

<main
  id="main"
  class="prelaunch"
  data-home-page
  data-prelaunch-page
  data-launch-date={PRELAUNCH_LAUNCH_DATE}
>
  <div class="prelaunch__background" aria-hidden="true">
    <img
      class="prelaunch__projection"
      src={withBase('/assets/pwa/announcements-brand-v2-512.png')}
      width="512"
      height="512"
      alt=""
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="prelaunch__mosaic" aria-hidden="true" data-prelaunch-mosaic>
    {tiles.map((tile, index) => (
      <span
        class="prelaunch__tile"
        data-prelaunch-tile
        data-index={index}
        data-state={tile.state}
        style={`--speed:${tile.duration}s;--delay:${tile.delay}s;`}
      ></span>
    ))}
  </div>

  <div class="prelaunch__atmosphere" aria-hidden="true">
    <span class="prelaunch__halo prelaunch__halo--warm"></span>
    <span class="prelaunch__halo prelaunch__halo--soft"></span>
    <span class="prelaunch__spark prelaunch__spark--one"></span>
    <span class="prelaunch__spark prelaunch__spark--two"></span>
    <span class="prelaunch__spark prelaunch__spark--three"></span>
  </div>

  <div class="prelaunch__foreground">
    <header class="prelaunch__brand" aria-label="Полюбить Калининград Анонсы">
      <img
        src={withBase('/assets/pwa/announcements-brand-v2-192.png')}
        width="192"
        height="192"
        alt=""
        decoding="async"
      />
      <p><span>Полюбить</span><span>Калининград</span><span>Анонсы</span></p>
    </header>

    <section class="prelaunch__copy" aria-labelledby="prelaunch-title">
      <h1 id="prelaunch-title">Запуск 1 сентября</h1>
      <p>
        Персонализированный сервис анонсов<br class="prelaunch__desktop-break" />
        и навигатор по культурным<br class="prelaunch__desktop-break" />
        и просветительским событиям<br class="prelaunch__desktop-break" />
        Калининградской области
      </p>
    </section>

    <section class="prelaunch__notify" aria-labelledby="notify-title">
      <h2 id="notify-title">Напомнить о запуске</h2>
      <form class="prelaunch-form" data-prelaunch-form novalidate>
        <div class="prelaunch-form__row">
          <label class="prelaunch-form__field">
            <span>Email</span>
            <input
              type="email"
              name="email"
              inputmode="email"
              autocomplete="email"
              maxlength="254"
              placeholder="E-mail"
              aria-describedby="prelaunch-consent prelaunch-status"
              required
            />
          </label>
          <button type="submit" data-prelaunch-submit>
            <span data-prelaunch-submit-label>Напомнить о запуске</span>
          </button>
        </div>

        <label class="prelaunch-form__consent" id="prelaunch-consent">
          <input type="checkbox" name="consent" required />
          <span>Согласен получить одно письмо о запуске. Email используется только для этого уведомления.</span>
        </label>

        <label class="prelaunch-form__trap" aria-hidden="true">
          <span>Ваш сайт</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <p
          class="prelaunch-form__status"
          id="prelaunch-status"
          data-prelaunch-status
          role="status"
          aria-live="polite"
        ></p>
        <noscript><p class="prelaunch-form__noscript">Для отправки формы нужен JavaScript.</p></noscript>
      </form>
    </section>
  </div>
</main>

<script>
  import { getResilientDataClient } from '../lib/resilientDataClient';
  import { parseSupabaseTransportError } from '../lib/resilientSupabaseTransport';

  type TileState = 'sealed' | 'dim' | 'revealed';

  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-prelaunch-tile]'));
  let mosaicTimer = 0;
  let previousIndices = new Set<number>();

  const randomBetween = (minimum: number, maximum: number) => minimum + Math.random() * (maximum - minimum);
  const randomState = (current: string | undefined): TileState => {
    if (current === 'sealed') return Math.random() > .45 ? 'dim' : 'revealed';
    if (current === 'revealed') return Math.random() > .35 ? 'dim' : 'sealed';
    return Math.random() > .5 ? 'sealed' : 'revealed';
  };

  function stopMosaic(): void {
    if (!mosaicTimer) return;
    window.clearTimeout(mosaicTimer);
    mosaicTimer = 0;
  }

  function scheduleMosaic(): void {
    stopMosaic();
    if (motionQuery.matches || document.hidden || tiles.length === 0) return;
    mosaicTimer = window.setTimeout(() => {
      const available = tiles
        .map((tile, index) => ({ tile, index }))
        .filter(({ index }) => !previousIndices.has(index))
        .sort(() => Math.random() - .5);
      const changeCount = Math.floor(randomBetween(2, 6));
      const changed = available.slice(0, changeCount);
      previousIndices = new Set(changed.map(({ index }) => index));
      for (const { tile } of changed) {
        tile.dataset.state = randomState(tile.dataset.state);
        tile.style.setProperty('--speed', `${randomBetween(4.2, 8.1).toFixed(2)}s`);
        tile.style.setProperty('--delay', '0s');
      }
      scheduleMosaic();
    }, randomBetween(1800, 3600));
  }

  document.addEventListener('visibilitychange', scheduleMosaic);
  motionQuery.addEventListener?.('change', scheduleMosaic);
  scheduleMosaic();

  const form = document.querySelector<HTMLFormElement>('[data-prelaunch-form]');
  const status = document.querySelector<HTMLElement>('[data-prelaunch-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-prelaunch-submit]');
  const submitLabel = document.querySelector<HTMLElement>('[data-prelaunch-submit-label]');
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/u;

  function announce(kind: 'idle' | 'success' | 'error', message: string): void {
    if (!status) return;
    status.dataset.kind = kind;
    status.textContent = message;
  }

  function setSubmitting(active: boolean): void {
    if (!submit || !submitLabel) return;
    submit.disabled = active;
    submit.setAttribute('aria-busy', String(active));
    submitLabel.textContent = active ? 'Сохраняем…' : 'Напомнить о запуске';
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    announce('idle', '');

    const data = new FormData(form);
    const email = String(data.get('email') || '').trim().toLocaleLowerCase('ru-RU');
    const consent = data.get('consent') === 'on';
    const website = String(data.get('website') || '').trim();
    const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
    const consentInput = form.elements.namedItem('consent') as HTMLInputElement | null;

    if (!email || email.length > 254 || !emailPattern.test(email)) {
      announce('error', 'Проверьте адрес электронной почты.');
      emailInput?.focus();
      return;
    }
    if (!consent) {
      announce('error', 'Подтвердите согласие на одно письмо о запуске.');
      consentInput?.focus();
      return;
    }

    const directUrl = String(import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
    const relayUrl = String(import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL || '').replace(/\/+$/u, '');
    const publishableKey = String(import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '');
    if (!directUrl || !publishableKey) {
      announce('error', 'Форма временно недоступна. Попробуйте ещё раз немного позже.');
      return;
    }

    setSubmitting(true);
    try {
      const client = getResilientDataClient({
        directUrl,
        relayUrl,
        publishableKey,
        routeCacheNamespace: 'prelaunch-notification-v1',
      });
      const response = await client.request(
        `${directUrl}/rest/v1/rpc/register_prelaunch_notification_v1`,
        {
          method: 'POST',
          cache: 'no-store',
          credentials: 'omit',
          headers: {
            apikey: publishableKey,
            Authorization: `Bearer ${publishableKey}`,
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            p_email: email,
            p_source: 'prelaunch_home',
            p_consent_version: 'launch-2026-09-01-v1',
            p_website: website,
          }),
        },
      );
      const payload = await response.json().catch(() => null) as { accepted?: boolean; status?: string } | null;
      if (!response.ok) throw new Error(`prelaunch_signup_http_${response.status}`);
      if (!payload || payload.accepted !== true) {
        throw new Error(payload?.status === 'daily_capacity_reached'
          ? 'prelaunch_signup_capacity'
          : 'prelaunch_signup_rejected');
      }
      form.reset();
      try { window.localStorage.setItem('ke_prelaunch_notification_v1', 'registered'); } catch { /* UX hint only. */ }
      announce('success', 'Готово. 1 сентября отправим одно письмо со ссылкой на сервис.');
    } catch (error) {
      const transport = parseSupabaseTransportError(error);
      if (transport?.code === 'ambiguous') {
        announce('error', 'Связь прервалась. Повторите отправку — второй записи не появится.');
      } else if (String((error as Error)?.message || '').includes('capacity')) {
        announce('error', 'Сейчас слишком много запросов. Попробуйте ещё раз позже.');
      } else {
        announce('error', 'Не удалось сохранить email. Проверьте соединение и повторите отправку.');
      }
    } finally {
      setSubmitting(false);
    }
  });
</script>

<style>
  .prelaunch {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: #0a0c0f;
    color: #f2e5d8;
  }

  .prelaunch__background,
  .prelaunch__mosaic,
  .prelaunch__atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .prelaunch__background { z-index: 0; overflow: hidden; }
  .prelaunch__background::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(8,10,13,.74) 0%, rgba(8,10,13,.2) 48%, rgba(8,10,13,.38) 100%),
      linear-gradient(180deg, rgba(7,9,12,.36), transparent 45%, rgba(7,9,12,.32));
  }

  .prelaunch__projection {
    position: absolute;
    width: clamp(780px, 82vw, 1380px);
    max-width: none;
    height: auto;
    left: 57%;
    top: 35%;
    transform: translateX(-50%);
    filter: saturate(.86) contrast(1.03) brightness(.82);
  }

  .prelaunch__mosaic {
    --tile-size: clamp(148px, 14vw, 236px);
    z-index: 1;
    inset: calc(var(--tile-size) * -.58) auto auto calc(var(--tile-size) * -.5);
    width: max-content;
    height: max-content;
    display: grid;
    grid-template-columns: repeat(9, var(--tile-size));
    grid-auto-rows: var(--tile-size);
    gap: clamp(7px, .75vw, 13px);
    transform: rotate(-.08deg);
  }

  .prelaunch__tile {
    position: relative;
    border: 1px solid rgba(235,220,204,.13);
    border-radius: clamp(10px, 1vw, 17px);
    background: rgb(11, 14, 18);
    backdrop-filter: blur(var(--tile-blur, 1px)) saturate(var(--tile-saturation, .78));
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.07),
      inset 0 -12px 26px rgba(0,0,0,.18),
      0 2px 7px rgba(0,0,0,.32);
  }
  .prelaunch__tile::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background:
      radial-gradient(circle at 72% 16%, rgba(255,222,196,var(--tile-glow,0)), transparent 46%),
      linear-gradient(135deg, rgba(255,255,255,.055), transparent 31%, rgba(0,0,0,.13));
  }
  .prelaunch__tile[data-state="sealed"] { --veil: .94; --tile-blur: 3px; --tile-saturation: .4; --tile-glow: .01; }
  .prelaunch__tile[data-state="dim"] { --veil: .7; --tile-blur: 1.4px; --tile-saturation: .68; --tile-glow: .055; }
  .prelaunch__tile[data-state="revealed"] { --veil: .28; --tile-blur: .2px; --tile-saturation: .94; --tile-glow: .16; }

  .prelaunch__atmosphere {
    z-index: 2;
    overflow: hidden;
    background:
      radial-gradient(circle at 86% 23%, rgba(237,176,136,.2), transparent 23%),
      radial-gradient(circle at 63% 48%, rgba(197,95,51,.13), transparent 34%),
      linear-gradient(90deg, rgba(4,6,9,.54), transparent 36%, rgba(4,6,9,.1) 72%, rgba(4,6,9,.37));
  }
  .prelaunch__atmosphere::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .16;
    background-image:
      repeating-radial-gradient(circle at 15% 28%, rgba(255,255,255,.14) 0 1px, transparent 1px 6px),
      linear-gradient(115deg, transparent 0 63%, rgba(255,236,219,.04) 71%, transparent 80%);
    background-size: 37px 43px, 100% 100%;
    mix-blend-mode: soft-light;
  }
  .prelaunch__halo { position: absolute; border-radius: 50%; filter: blur(70px); }
  .prelaunch__halo--warm { width: 42vw; height: 38vw; right: -12vw; top: 3vh; background: rgba(215,126,85,.18); }
  .prelaunch__halo--soft { width: 34vw; height: 30vw; left: 35%; bottom: 4vh; background: rgba(144,69,42,.12); }
  .prelaunch__spark {
    position: absolute;
    width: 7px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #f7dfce;
    box-shadow: 0 0 14px 4px rgba(248,211,185,.44);
    opacity: .55;
  }
  .prelaunch__spark--one { top: 12%; right: 9%; }
  .prelaunch__spark--two { top: 31%; right: 4%; width: 4px; }
  .prelaunch__spark--three { right: 10%; bottom: 9%; width: 10px; border-radius: 0 100% 0 100%; transform: rotate(45deg); }

  .prelaunch__foreground {
    position: relative;
    z-index: 3;
    width: min(1360px, 100%);
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(34px, 5.2vh, 78px) clamp(28px, 6.7vw, 112px) clamp(30px, 5.8vh, 86px);
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .prelaunch__brand {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.5vw, 24px);
    width: max-content;
  }
  .prelaunch__brand img {
    width: clamp(72px, 7.7vw, 124px);
    border-radius: 23%;
    box-shadow: 0 14px 36px rgba(0,0,0,.3), 0 0 28px rgba(207,102,61,.1);
  }
  .prelaunch__brand p {
    margin: 0;
    display: grid;
    color: #ead8c8;
    font-size: clamp(1.15rem, 2.25vw, 2.35rem);
    font-weight: 650;
    line-height: .95;
    letter-spacing: -.035em;
    text-shadow: 0 2px 16px rgba(0,0,0,.5);
  }

  .prelaunch__copy {
    align-self: start;
    margin-top: clamp(72px, 12vh, 190px);
    max-width: 1180px;
  }
  .prelaunch__copy h1 {
    margin: 0;
    color: #f4e8dc;
    font-size: clamp(4.25rem, 8.4vw, 9.2rem);
    font-weight: 590;
    line-height: .9;
    letter-spacing: -.065em;
    text-shadow: 0 5px 35px rgba(0,0,0,.48);
    text-wrap: balance;
  }
  .prelaunch__copy p {
    max-width: 31ch;
    margin: clamp(30px, 4.5vh, 58px) 0 0;
    color: rgba(233,218,204,.9);
    font-size: clamp(1.15rem, 1.75vw, 2rem);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -.018em;
    text-shadow: 0 3px 20px rgba(0,0,0,.75);
  }

  .prelaunch__notify { width: min(760px, 68vw); }
  .prelaunch__notify h2 {
    margin: 0 0 14px;
    color: rgba(238,221,205,.92);
    font-size: clamp(.95rem, 1.25vw, 1.28rem);
    font-weight: 460;
  }
  .prelaunch-form__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
  }
  .prelaunch-form__field { min-width: 0; }
  .prelaunch-form__field > span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
  .prelaunch-form input[type="email"] {
    width: 100%;
    min-height: clamp(58px, 6.7vh, 78px);
    padding: 0 clamp(18px, 2vw, 28px);
    border: 1px solid rgba(231,160,122,.66);
    border-radius: 12px;
    background: rgba(19,23,28,.76);
    color: #f6e8db;
    caret-color: #e9a077;
    box-shadow: inset 0 1px 8px rgba(0,0,0,.23), 0 8px 26px rgba(0,0,0,.16);
    backdrop-filter: blur(18px);
  }
  .prelaunch-form input[type="email"]::placeholder { color: rgba(207,202,198,.48); }
  .prelaunch-form input[type="email"]:focus { border-color: #efb08d; outline: none; }
  .prelaunch-form button {
    min-height: clamp(58px, 6.7vh, 78px);
    padding: 0 clamp(22px, 2.35vw, 36px);
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #e4a079, #bc6d4d);
    color: #24130f;
    font-weight: 640;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 13px 32px rgba(126,55,36,.28), inset 0 1px rgba(255,255,255,.3);
    transition: transform .2s ease, filter .2s ease;
  }
  .prelaunch-form button:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.07); }
  .prelaunch-form button:disabled { cursor: progress; opacity: .72; }
  .prelaunch-form__consent {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    max-width: 620px;
    margin-top: 11px;
    color: rgba(220,208,197,.68);
    font-size: .72rem;
    line-height: 1.42;
    cursor: pointer;
  }
  .prelaunch-form__consent input { width: 15px; height: 15px; margin: 1px 0 0; accent-color: #d78661; }
  .prelaunch-form__trap {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0,0,0,0) !important;
    white-space: nowrap !important;
  }
  .prelaunch-form__status,
  .prelaunch-form__noscript {
    min-height: 1.3rem;
    margin: 8px 0 0;
    font-size: .78rem;
    line-height: 1.4;
  }
  .prelaunch-form__status:empty { min-height: 0; margin-top: 0; }
  .prelaunch-form__status[data-kind="success"] { color: var(--prelaunch-success); }
  .prelaunch-form__status[data-kind="error"],
  .prelaunch-form__noscript { color: var(--prelaunch-error); }

  @media (max-width: 760px) {
    .prelaunch { min-height: max(100svh, 760px); overflow-y: auto; }
    .prelaunch__projection { width: 164vw; left: 58%; top: 14%; filter: saturate(.84) brightness(.7); }
    .prelaunch__background::before {
      background: linear-gradient(180deg, rgba(8,10,13,.22), rgba(8,10,13,.38) 43%, rgba(8,10,13,.8) 76%, #090b0e 100%);
    }
    .prelaunch__mosaic {
      --tile-size: clamp(88px, 28vw, 126px);
      inset: calc(var(--tile-size) * -.45) auto auto 50%;
      grid-template-columns: repeat(6, var(--tile-size));
      transform: translateX(-50%);
      gap: 7px;
    }
    .prelaunch__atmosphere {
      background:
        radial-gradient(circle at 87% 18%, rgba(237,176,136,.18), transparent 25%),
        linear-gradient(180deg, rgba(4,6,9,.05), rgba(4,6,9,.18) 48%, rgba(4,6,9,.6));
    }
    .prelaunch__foreground {
      min-height: max(100svh, 760px);
      padding: clamp(22px, 5.5vw, 34px) clamp(18px, 6vw, 30px) 26px;
    }
    .prelaunch__brand { gap: 12px; }
    .prelaunch__brand img { width: clamp(54px, 17vw, 72px); }
    .prelaunch__brand p { font-size: clamp(.95rem, 4.6vw, 1.25rem); }
    .prelaunch__copy { align-self: center; margin-top: clamp(190px, 31vh, 300px); }
    .prelaunch__copy h1 { font-size: clamp(3.25rem, 15.2vw, 5.35rem); line-height: .92; max-width: 9ch; }
    .prelaunch__copy p { margin-top: 22px; max-width: 29ch; font-size: clamp(1rem, 4.4vw, 1.2rem); line-height: 1.38; }
    .prelaunch__desktop-break { display: none; }
    .prelaunch__notify { width: 100%; margin-top: 44px; }
    .prelaunch__notify h2 { margin-bottom: 10px; font-size: .95rem; }
    .prelaunch-form__row { grid-template-columns: 1fr; gap: 10px; }
    .prelaunch-form input[type="email"],
    .prelaunch-form button { min-height: 58px; width: 100%; border-radius: 10px; }
    .prelaunch-form__consent { font-size: .68rem; }
  }

  @media (max-height: 760px) and (min-width: 761px) {
    .prelaunch__foreground { padding-block: 26px; }
    .prelaunch__brand img { width: 70px; }
    .prelaunch__brand p { font-size: 1.15rem; }
    .prelaunch__copy { margin-top: 38px; }
    .prelaunch__copy h1 { font-size: clamp(4rem, 7vw, 6.8rem); }
    .prelaunch__copy p { margin-top: 20px; font-size: 1.08rem; }
    .prelaunch-form input[type="email"], .prelaunch-form button { min-height: 54px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prelaunch__tile,
    .prelaunch-form button { transition: none !important; }
  }
</style>
