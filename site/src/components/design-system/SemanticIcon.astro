---
import Icon from '../Icon.astro';
import './foundations.css';
import type { IconSizeRole, SemanticIconName, UiIconName } from './foundations';

interface Props {
  name: SemanticIconName;
  role?: IconSizeRole;
  className?: string;
  title?: string;
}

const {
  name,
  role = 'control',
  className = '',
  title,
} = Astro.props;

const classes = [
  'ke-icon-role',
  `ke-icon-role--${role}`,
  'ke-icon-contract--four-role-v1',
  'ke-icon-size-owner--foundations',
  `ke-semantic-icon--${name}`,
  className,
].filter(Boolean).join(' ');
const existingName = name as UiIconName;
const labelled = Boolean(title);
const localSemantic = name === 'trend-up'
  || name === 'close'
  || name === 'arrow-left'
  || name === 'arrow-right'
  || name === 'chevron-down'
  || name === 'link'
  || name === 'catalog-grid';
---
{localSemantic ? (
  <svg
    class={classes}
    data-ke-icon-name={name}
    data-ke-icon-role={role}
    data-ke-icon-contract="four-role-v1"
    data-ke-icon-size-owner="foundations.css"
    aria-hidden={labelled ? undefined : 'true'}
    role={labelled ? 'img' : undefined}
    viewBox="0 0 24 24"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    {title && <title>{title}</title>}
    {name === 'trend-up' && (
      <path d="M3 17.5 8.7 12l3.8 3.4L20.8 7v4H23V3h-8v2.2h4.2l-6.8 6.9-3.8-3.4L1.5 15.8 3 17.5Z" />
    )}
    {name === 'close' && (
      <path d="M6.75 6.75 17.25 17.25M17.25 6.75 6.75 17.25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    )}
    {name === 'arrow-left' && (
      <path d="m10 5-7 7 7 7M3 12h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )}
    {name === 'arrow-right' && (
      <path d="m14 5 7 7-7 7M21 12H3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )}
    {name === 'chevron-down' && (
      <path d="m5 9 7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    )}
    {name === 'link' && (
      <path d="M9.5 14.5l5-5M8.25 15.75l-1.1 1.1a3.25 3.25 0 0 1-4.6-4.6l2.7-2.7a3.25 3.25 0 0 1 4.6 0l.65.65M15.75 8.25l1.1-1.1a3.25 3.25 0 0 1 4.6 4.6l-2.7 2.7a3.25 3.25 0 0 1-4.6 0l-.65-.65" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    )}
    {name === 'catalog-grid' && (
      <path d="M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    )}
  </svg>
) : (
  <Icon name={existingName} className={classes} title={title} />
)}
