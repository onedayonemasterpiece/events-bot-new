---
import Button from './Button.astro';
import './component-foundations.css';

interface Props {
  title: string;
  message: string;
  tone?: 'neutral' | 'info' | 'success' | 'warning' | 'danger' | 'loading';
  mark?: string;
  actionLabel?: string;
  actionHref?: string;
}
const { title, message, tone = 'neutral', mark = '•', actionLabel, actionHref } = Astro.props;
---
<section
  class={`ke-foundation-state-panel ke-foundation-state-panel--${tone}`}
  aria-live={tone === 'danger' ? 'assertive' : tone === 'loading' ? 'polite' : undefined}
  aria-busy={tone === 'loading' ? 'true' : undefined}
  data-ds-component="StatePanel"
  data-ds-family="StatePanel"
  data-ds-version="2"
  data-ds-variant={tone}
  data-ds-state={tone === 'loading' ? 'loading' : 'default'}
  data-ke-foundation-consumer="state-panel"
  data-ke-style-owner="component-foundations"
>
  <span
    class="ke-foundation-state-panel__mark"
    data-ke-icon-role={tone === 'loading' ? 'control' : undefined}
    aria-hidden="true"
  >{mark}</span>
  <h3>{title}</h3>
  <p>{message}</p>
  {actionLabel && <div><Button variant="secondary" size="compact" href={actionHref}>{actionLabel}</Button></div>}
</section>
