---
import SemanticIcon from './SemanticIcon.astro';
import './component-foundations.css';

interface Props {
  value: string;
  ariaLabel: string;
  successLabel?: string;
  errorLabel?: string;
  variant?: 'secondary' | 'inverse';
  size?: 'default' | 'large';
  previewState?: 'success' | 'error';
  className?: string;
  resetDelayMs?: number;
}

const {
  value,
  ariaLabel,
  successLabel = 'Скопировано',
  errorLabel = 'Не удалось скопировать — выделите значение вручную',
  variant = 'secondary',
  size = 'default',
  previewState,
  className = '',
  resetDelayMs = 2200,
} = Astro.props;

const initialState = previewState || 'default';
const initialLabel = previewState === 'success'
  ? successLabel
  : previewState === 'error'
    ? errorLabel
    : ariaLabel;
---

<button
  type="button"
  class:list={['ke-copy-action', `ke-copy-action--${variant}`, size === 'large' && 'ke-copy-action--large', className]}
  data-ke-copy-action
  data-copy-value={value}
  data-copy-default-label={ariaLabel}
  data-copy-success-label={successLabel}
  data-copy-error-label={errorLabel}
  data-copy-reset-ms={Math.max(0, resetDelayMs)}
  data-copy-preview-state={previewState}
  data-copy-state-source={previewState ? 'catalog-preview' : 'runtime'}
  data-copy-state={previewState}
  data-ds-component="CopyAction"
  data-ds-family="CopyAction"
  data-ds-version="2"
  data-ds-variant={variant}
  data-ds-size={size}
  data-ds-state={initialState}
  data-ke-foundation-consumer="copy-action"
  data-ke-style-owner="CopyAction.astro"
  data-ke-icon-role="control"
  aria-label={initialLabel}
  title={initialLabel}
>
  <span class="ke-copy-action__icon ke-copy-action__icon--copy" aria-hidden="true"><SemanticIcon name="copy" role="control" /></span>
  <span class="ke-copy-action__icon ke-copy-action__icon--success" aria-hidden="true"><SemanticIcon name="check" role="control" /></span>
  <span class="sr-only" data-ke-copy-status role="status" aria-live="polite" aria-atomic="true">{previewState ? initialLabel : ''}</span>
</button>

<script>
  const fallbackCopy = (value:string) => {
    const fallback = document.createElement('textarea');
    fallback.value = value;
    fallback.setAttribute('readonly', '');
    fallback.style.position = 'fixed';
    fallback.style.opacity = '0';
    document.body.appendChild(fallback);
    fallback.select();
    const copied = document.execCommand('copy');
    fallback.remove();
    if (!copied) throw new Error('clipboard unavailable');
  };

  const copyPlainText = async (value:string) => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return;
      } catch {
        // Embedded browsers can expose Clipboard API while denying the call.
      }
    }
    fallbackCopy(value);
  };

  if (!document.documentElement.dataset.keCopyActionBound) {
    document.documentElement.dataset.keCopyActionBound = 'true';
    const resetTimers = new WeakMap<HTMLButtonElement, number>();
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-ke-copy-action]') : null;
      if (!button || button.getAttribute('aria-busy') === 'true') return;
      const value = button.dataset.copyValue || '';
      const defaultLabel = button.dataset.copyDefaultLabel || 'Скопировать';
      const successLabel = button.dataset.copySuccessLabel || 'Скопировано';
      const errorLabel = button.dataset.copyErrorLabel || 'Не удалось скопировать';
      const status = button.querySelector<HTMLElement>('[data-ke-copy-status]');
      const currentTimer = resetTimers.get(button);
      if (currentTimer) window.clearTimeout(currentTimer);
      if (button.dataset.copyPreviewState) {
        delete button.dataset.copyPreviewState;
        delete button.dataset.copyState;
        button.dataset.dsState = 'default';
        button.setAttribute('aria-label', defaultLabel);
        button.title = defaultLabel;
        if (status) status.textContent = '';
      }
      button.dataset.copyStateSource = 'runtime';
      button.setAttribute('aria-busy', 'true');
      try {
        await copyPlainText(value);
        button.dataset.copyState = 'success';
        button.dataset.dsState = 'success';
        button.setAttribute('aria-label', successLabel);
        button.title = successLabel;
        if (status) status.textContent = successLabel;
      } catch {
        button.dataset.copyState = 'error';
        button.dataset.dsState = 'error';
        button.setAttribute('aria-label', errorLabel);
        button.title = errorLabel;
        if (status) status.textContent = errorLabel;
      } finally {
        button.removeAttribute('aria-busy');
      }
      const delay = Number.parseInt(button.dataset.copyResetMs || '2200', 10);
      if (!Number.isFinite(delay) || delay <= 0) return;
      const timer = window.setTimeout(() => {
        delete button.dataset.copyState;
        button.dataset.dsState = 'default';
        button.setAttribute('aria-label', defaultLabel);
        button.title = defaultLabel;
        if (status) status.textContent = '';
      }, delay);
      resetTimers.set(button, timer);
    });
  }
</script>

<style>
  .ke-copy-action {
    --ke-copy-action-target-size: var(--ke-size-touch-target);
    position: relative;
    width: var(--ke-copy-action-target-size);
    min-width: var(--ke-copy-action-target-size);
    height: var(--ke-copy-action-target-size);
    min-height: var(--ke-copy-action-target-size);
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    padding: 0;
    overflow: visible;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-copy-action-border);
    border-radius: var(--ke-shape-radius-control);
    color: var(--ke-color-copy-action-foreground);
    background: var(--ke-color-copy-action-background);
    font: inherit;
    cursor: pointer;
  }
  .ke-copy-action--large {
    --ke-copy-action-target-size: var(--ke-size-control-large);
  }
  .ke-copy-action--inverse {
    --ke-color-copy-action-border: var(--ke-color-copy-action-inverse-border);
    --ke-color-copy-action-foreground: var(--ke-color-copy-action-inverse-foreground);
    --ke-color-copy-action-background: var(--ke-color-copy-action-inverse-background);
  }
  .ke-copy-action:focus-visible {
    outline: var(--ke-border-width-focus) solid var(--ke-color-focus-ring-warm);
    outline-offset: var(--ke-focus-outline-offset);
  }
  .ke-copy-action[data-copy-state="success"] {
    --ke-color-copy-action-background: var(--ke-color-copy-action-success-background);
    --ke-color-copy-action-border: var(--ke-color-copy-action-success-border);
    --ke-color-copy-action-foreground: var(--ke-color-copy-action-success-foreground);
  }
  .ke-copy-action[data-copy-state="error"] {
    --ke-color-copy-action-border: var(--ke-color-copy-action-error-border);
    --ke-color-copy-action-background: var(--ke-color-copy-action-error-background);
    --ke-color-copy-action-foreground: var(--ke-color-copy-action-error-foreground);
    box-shadow: 0 0 0 var(--ke-shape-border-strong) var(--ke-color-copy-action-error-ring);
  }
  .ke-copy-action[data-copy-state="error"]::after {
    content: "!";
    position: absolute;
    top: var(--ke-copy-action-status-mark-inset);
    right: var(--ke-copy-action-status-mark-inset);
    width: var(--ke-copy-action-status-mark-size);
    min-width: var(--ke-copy-action-status-mark-size);
    height: var(--ke-copy-action-status-mark-size);
    min-height: var(--ke-copy-action-status-mark-size);
    display: grid;
    place-items: center;
    border-radius: var(--ke-shape-radius-pill);
    background: var(--ke-color-copy-action-error-mark-background);
    color: var(--ke-color-copy-action-error-mark-foreground);
    font: var(--ke-copy-action-status-mark-weight) var(--ke-copy-action-status-mark-type-size) / var(--ke-copy-action-status-mark-line) var(--ke-font-family-sans);
  }
  .ke-copy-action__icon {
    grid-area: 1 / 1;
    width: var(--ke-icon-size-control);
    min-width: var(--ke-icon-size-control);
    height: var(--ke-icon-size-control);
    min-height: var(--ke-icon-size-control);
    display: inline-grid;
    place-items: center;
  }
  .ke-copy-action__icon--success {
    opacity: 0;
    transform: scale(.8);
  }
  .ke-copy-action[data-copy-state="success"] .ke-copy-action__icon--copy {
    opacity: 0;
    transform: scale(.8);
  }
  .ke-copy-action[data-copy-state="success"] .ke-copy-action__icon--success {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ke-copy-action__icon {
      transition:
        opacity var(--ke-duration-fast) var(--ke-ease-standard),
        transform var(--ke-duration-fast) var(--ke-ease-standard);
    }
  }
</style>
