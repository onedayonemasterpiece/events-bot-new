---
import Icon from '../Icon.astro';

interface Props {
  value: string;
  ariaLabel: string;
  successLabel?: string;
  errorLabel?: string;
  variant?: 'secondary' | 'inverse';
  className?: string;
  resetDelayMs?: number;
}

const {
  value,
  ariaLabel,
  successLabel = 'Скопировано',
  errorLabel = 'Не удалось скопировать — выделите значение вручную',
  variant = 'secondary',
  className = '',
  resetDelayMs = 2200,
} = Astro.props;
---

<button
  type="button"
  class:list={['ke-copy-action', `ke-copy-action--${variant}`, className]}
  data-ke-copy-action
  data-copy-value={value}
  data-copy-default-label={ariaLabel}
  data-copy-success-label={successLabel}
  data-copy-error-label={errorLabel}
  data-copy-reset-ms={Math.max(0, resetDelayMs)}
  aria-label={ariaLabel}
  title={ariaLabel}
>
  <span class="ke-copy-action__icon ke-copy-action__icon--copy" aria-hidden="true"><Icon name="copy" /></span>
  <span class="ke-copy-action__icon ke-copy-action__icon--success" aria-hidden="true"><Icon name="check" /></span>
  <span class="sr-only" data-ke-copy-status role="status" aria-live="polite" aria-atomic="true"></span>
</button>

<script>
  const fallbackCopy = (value:string) => {
    const fallback = document.createElement('textarea');
    fallback.value = value;
    fallback.setAttribute('readonly', '');
    fallback.style.position = 'fixed';
    fallback.style.opacity = '0';
    document.body.appendChild(fallback);
    fallback.select();
    const copied = document.execCommand('copy');
    fallback.remove();
    if (!copied) throw new Error('clipboard unavailable');
  };

  const copyPlainText = async (value:string) => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return;
      } catch {
        // Embedded browsers can expose Clipboard API while denying the call.
      }
    }
    fallbackCopy(value);
  };

  if (!document.documentElement.dataset.keCopyActionBound) {
    document.documentElement.dataset.keCopyActionBound = 'true';
    const resetTimers = new WeakMap<HTMLButtonElement, number>();
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-ke-copy-action]') : null;
      if (!button || button.getAttribute('aria-busy') === 'true') return;
      const value = button.dataset.copyValue || '';
      const defaultLabel = button.dataset.copyDefaultLabel || 'Скопировать';
      const successLabel = button.dataset.copySuccessLabel || 'Скопировано';
      const errorLabel = button.dataset.copyErrorLabel || 'Не удалось скопировать';
      const status = button.querySelector<HTMLElement>('[data-ke-copy-status]');
      const currentTimer = resetTimers.get(button);
      if (currentTimer) window.clearTimeout(currentTimer);
      button.setAttribute('aria-busy', 'true');
      try {
        await copyPlainText(value);
        button.dataset.copyState = 'success';
        button.setAttribute('aria-label', successLabel);
        button.title = successLabel;
        if (status) status.textContent = successLabel;
      } catch {
        button.dataset.copyState = 'error';
        button.setAttribute('aria-label', errorLabel);
        button.title = errorLabel;
        if (status) status.textContent = errorLabel;
      } finally {
        button.removeAttribute('aria-busy');
      }
      const delay = Number.parseInt(button.dataset.copyResetMs || '2200', 10);
      if (!Number.isFinite(delay) || delay <= 0) return;
      const timer = window.setTimeout(() => {
        delete button.dataset.copyState;
        button.setAttribute('aria-label', defaultLabel);
        button.title = defaultLabel;
        if (status) status.textContent = '';
      }, delay);
      resetTimers.set(button, timer);
    });
  }
</script>

<style>
  .ke-copy-action {
    width: max(44px, var(--ke-control-min, 44px));
    min-width: max(44px, var(--ke-control-min, 44px));
    height: max(44px, var(--ke-control-min, 44px));
    min-height: max(44px, var(--ke-control-min, 44px));
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--ke-copy-action-border, rgba(55, 38, 27, .18));
    border-radius: var(--ke-radius-control, 12px);
    color: var(--ke-copy-action-color, var(--ke-color-copy-action));
    background: var(--ke-copy-action-background, rgba(255, 255, 255, .72));
    font: inherit;
    cursor: pointer;
  }
  .ke-copy-action--inverse {
    --ke-copy-action-border: rgba(255, 255, 255, .2);
    --ke-copy-action-color: var(--ke-color-copy-action-inverse);
    --ke-copy-action-background: rgba(255, 255, 255, .09);
  }
  .ke-copy-action:focus-visible { outline: 3px solid var(--ke-focus-ring, var(--ke-color-focus-ring-warm)); outline-offset: 3px; }
  .ke-copy-action[data-copy-state="success"] { --ke-copy-action-background: var(--ke-color-success-action); --ke-copy-action-border: var(--ke-color-success-action-line); }
  .ke-copy-action[data-copy-state="error"] { --ke-copy-action-border: var(--ke-color-error-action-line); box-shadow: 0 0 0 2px rgba(242, 140, 118, .2); }
  .ke-copy-action__icon { grid-area: 1 / 1; display: inline-grid; place-items: center; }
  .ke-copy-action__icon :global(.icon) { width: 1.35rem; height: 1.35rem; }
  .ke-copy-action__icon--success { opacity: 0; transform: scale(.8); }
  .ke-copy-action[data-copy-state="success"] .ke-copy-action__icon--copy { opacity: 0; transform: scale(.8); }
  .ke-copy-action[data-copy-state="success"] .ke-copy-action__icon--success { opacity: 1; transform: scale(1); }
  @media (prefers-reduced-motion: no-preference) {
    .ke-copy-action__icon { transition: opacity .14s ease, transform .14s ease; }
  }
</style>
