---
import Icon from './Icon.astro';
import CalendarLink from './CalendarLink.astro';
import type { PreviewEvent } from '../lib/types';
import {
  eventAbsoluteUrl,
  eventActionHref,
  eventAdmissionLabel,
  eventTicketActionLabel,
  getOccurrencePresentation,
  isEventDetailCalendarEligible,
  isExternalHttpUrl,
  isTelephoneUrl,
  isTicketSoldOut,
  withBase,
} from '../lib/events';

interface Props {
  event: PreviewEvent;
  shareImage?: string;
  shareImageTextMode?: PreviewEvent['image_text_mode'];
  className?: string;
  family?: 'split' | 'editorial';
}

const { event, shareImage = event.image_url || '', shareImageTextMode = event.image_text_mode || 'unknown', className = '', family = 'editorial' } = Astro.props;
const dateTimeLabel = getOccurrencePresentation(event).compactLabel;
const placeLabel = [event.venue_name, event.city].filter(Boolean).join(' · ') || 'Место уточняется';
const admissionLabel = event.ticket.is_free ? 'Бесплатно' : (event.ticket.price_label || 'Билеты');
const ctaHref = eventActionHref(event);
const ctaIsExternal = isExternalHttpUrl(ctaHref);
const ctaIsTelephone = isTelephoneUrl(ctaHref);
const phoneValue = ctaIsTelephone ? String(ctaHref || '').replace(/^tel:/iu, '').trim() : '';
const phoneDigits = phoneValue.replace(/\D/gu, '');
const normalizedPhoneDigits = phoneDigits.length === 11 && phoneDigits.startsWith('8')
  ? `7${phoneDigits.slice(1)}`
  : phoneDigits;
const phoneCopyValue = normalizedPhoneDigits.length === 11 && normalizedPhoneDigits.startsWith('7')
  ? `+${normalizedPhoneDigits}`
  : phoneValue;
const phoneDisplay = normalizedPhoneDigits.length === 11 && normalizedPhoneDigits.startsWith('7')
  ? `+7 ${normalizedPhoneDigits.slice(1, 4)} ${normalizedPhoneDigits.slice(4, 7)}-${normalizedPhoneDigits.slice(7, 9)}-${normalizedPhoneDigits.slice(9, 11)}`
  : phoneValue;
const soldOut = isTicketSoldOut(event);
const calendarPrimary = !soldOut
  && event.ticket.kind === 'free'
  && isEventDetailCalendarEligible(event);
const ctaLabel = !event.ticket.is_free && !event.ticket.price_label && ctaHref ? 'Билеты' : eventTicketActionLabel(event);
const canonicalUrl = eventAbsoluteUrl(event);
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count || 0;
const shareText = [event.title, dateTimeLabel, placeLabel, eventAdmissionLabel(event)].filter(Boolean).join('\n');
const shareImageType = shareImage.toLowerCase().includes('.webp') ? 'image/webp' : shareImage.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
---

<aside
  class:list={['desktop-prototype__action', className]}
  data-feedback-scope
  data-desktop-action-panel
  data-action-family={family}
  data-action-layout={family === 'split' ? 'inline' : 'stacked'}
  data-primary-action-kind={calendarPrimary ? 'calendar' : (ctaIsTelephone ? 'phone' : 'default')}
  aria-label="Действия события"
>
  <p><span>вход</span><strong>{admissionLabel}</strong></p>
  {calendarPrimary ? (
    <CalendarLink event={event} className="desktop-prototype__primary-action" label="Добавить в календарь" />
  ) : ctaIsTelephone && phoneValue ? (
    <button
      type="button"
      class="desktop-prototype__primary-action desktop-prototype__phone-copy"
      data-desktop-phone-copy
      data-phone-copy-value={phoneCopyValue}
      data-phone-display={phoneDisplay}
      aria-label={`Показать и скопировать номер организатора ${phoneDisplay}`}
      title="Показать телефон"
    >
      <Icon name="copy" />
      <span class="desktop-prototype__phone-label" data-desktop-phone-label>Показать телефон</span>
      <span class="desktop-prototype__phone-toast" data-desktop-phone-toast aria-hidden="true">Номер скопирован</span>
      <span class="sr-only" data-desktop-phone-status role="status" aria-live="polite" aria-atomic="true"></span>
    </button>
  ) : ctaHref ? (
    <a class="desktop-prototype__primary-action" href={ctaHref} target={ctaIsExternal ? '_blank' : undefined} rel={ctaIsExternal ? 'noopener noreferrer nofollow' : undefined}>
      <Icon name={ctaIsTelephone ? 'phone' : 'ticket'} /><span data-desktop-primary-label>{ctaLabel}</span>
    </a>
  ) : soldOut ? (
    <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Билеты закончились</span>
  ) : event.ticket.is_free ? (
    <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Билеты не требуются</span>
  ) : (
    <span class="desktop-prototype__primary-action is-disabled" aria-disabled="true">Информация уточняется</span>
  )}
  <div class="desktop-prototype__action-row event-hero__metric-row" data-desktop-action-row="calendar-share-like">
    {!calendarPrimary && <CalendarLink event={event} className="desktop-prototype__icon-action" compact />}
    <button
      type="button"
      class="desktop-prototype__icon-action"
      data-nosnippet
      data-native-share
      data-share-event-id={event.id}
      data-share-event-title={event.title}
      data-share-base-count={sharesCount}
      data-share-title={event.title}
      data-share-text={shareText}
      data-share-url={canonicalUrl}
      data-share-image={shareImage}
      data-share-image-type={shareImageType}
      data-share-image-text-mode={shareImageTextMode}
      data-share-brand-image={withBase('/brand/announcements-wordmark-ui.svg')}
      data-share-file-name={shareFileName}
      data-share-date-time={dateTimeLabel}
      data-share-place={placeLabel}
      data-share-admission={admissionLabel}
      aria-label={`Поделиться: ${event.title}. Сейчас ${sharesCount}`}
      title="Поделиться"
    ><Icon name="share" /><strong data-share-count>{sharesCount}</strong></button>
    <button
      type="button"
      class="desktop-prototype__icon-action feedback-button--like"
      data-nosnippet
      data-feedback-action="like"
      data-event-id={event.id}
      data-event-title={event.title}
      data-base-count={likesCount}
      aria-pressed="false"
      aria-label={`Нравится: ${event.title}. Сейчас ${likesCount}`}
      title="Нравится"
    ><Icon name="heart" /><strong data-feedback-count>{likesCount}</strong></button>
  </div>
</aside>

<script>
  const fallbackCopyPhone = (value:string) => {
    const fallback = document.createElement('textarea');
    fallback.value = value;
    fallback.setAttribute('readonly', '');
    fallback.style.position = 'fixed';
    fallback.style.opacity = '0';
    document.body.appendChild(fallback);
    fallback.select();
    const copied = document.execCommand('copy');
    fallback.remove();
    if (!copied) throw new Error('clipboard unavailable');
  };

  const copyPhone = async (value:string) => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return;
      } catch {
        // Embedded browsers can expose Clipboard API while rejecting writes.
      }
    }
    fallbackCopyPhone(value);
  };

  if (!document.documentElement.dataset.desktopPhoneCopyBound) {
    document.documentElement.dataset.desktopPhoneCopyBound = 'true';
    const resetTimers = new Map<HTMLButtonElement, number>();
    const copyEpochs = new WeakMap<HTMLButtonElement, number>();
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>('[data-desktop-phone-copy]')
        : null;
      if (!button || button.getAttribute('aria-busy') === 'true') return;
      const value = button.dataset.phoneCopyValue || '';
      const phoneDisplay = button.dataset.phoneDisplay || value;
      const label = button.querySelector<HTMLElement>('[data-desktop-phone-label]');
      const toast = button.querySelector<HTMLElement>('[data-desktop-phone-toast]');
      const status = button.querySelector<HTMLElement>('[data-desktop-phone-status]');
      const currentTimer = resetTimers.get(button);
      if (currentTimer) window.clearTimeout(currentTimer);
      resetTimers.delete(button);
      const epoch = Number(copyEpochs.get(button) || 0) + 1;
      copyEpochs.set(button, epoch);

      button.dataset.phoneRevealed = 'true';
      if (label) label.textContent = phoneDisplay;
      button.setAttribute('aria-label', `Скопировать номер организатора ${phoneDisplay}`);
      button.title = `Скопировать ${phoneDisplay}`;
      button.setAttribute('aria-busy', 'true');
      try {
        await copyPhone(value);
        button.dataset.copyState = 'success';
        if (toast) toast.textContent = 'Номер скопирован';
        if (status) status.textContent = 'Номер скопирован';
        if (window.matchMedia('(max-width: 759px)').matches) (window as any).KenigEventsToast?.show?.({ message:'Номер скопирован', type:'success', dedupeKey:'phone-copy', announce:false });
      } catch {
        button.dataset.copyState = 'error';
        if (toast) toast.textContent = 'Не удалось скопировать';
        if (status) status.textContent = `Не удалось скопировать. Номер: ${phoneDisplay}`;
        if (window.matchMedia('(max-width: 759px)').matches) (window as any).KenigEventsToast?.show?.({ message:'Не удалось скопировать номер', type:'error', dedupeKey:'phone-copy', announce:false });
      } finally {
        button.removeAttribute('aria-busy');
      }

      const timer = window.setTimeout(() => {
        if (copyEpochs.get(button) !== epoch) return;
        delete button.dataset.copyState;
        if (status) status.textContent = '';
        resetTimers.delete(button);
      }, 2400);
      resetTimers.set(button, timer);
    });
    window.addEventListener('pagehide', () => {
      resetTimers.forEach((timer) => window.clearTimeout(timer));
      resetTimers.clear();
    }, { once:true });
  }
</script>

<style>
  .desktop-prototype__action {
    z-index: 3;
    display: grid;
    align-content: start;
    gap: clamp(.65rem, 1.6vh, 1rem);
    padding: clamp(1rem, 2.2vw, 1.4rem);
    color: #fffaf2;
    background: #292521;
    container: desktop-actions / inline-size;
  }
  .desktop-prototype__action[data-action-layout="stacked"] {
    grid-template-columns:minmax(0,1fr) !important;
    grid-template-rows:auto auto auto !important;
    align-items:stretch !important;
  }
  .desktop-prototype__action[data-action-layout="stacked"] > p { grid-column:1 !important; grid-row:1 !important; }
  .desktop-prototype__action[data-action-layout="stacked"] > :global(.desktop-prototype__primary-action) { grid-column:1 !important; grid-row:2 !important; }
  .desktop-prototype__action[data-action-layout="stacked"] > .desktop-prototype__action-row { grid-column:1 !important; grid-row:3 !important; }
  .desktop-prototype__action[data-action-layout="inline"] {
    grid-template-columns:minmax(112px,max-content) minmax(0,1fr) auto !important;
    grid-template-rows:auto !important;
    align-items:center !important;
    column-gap:clamp(.65rem,1.4vw,.95rem);
    row-gap:0;
  }
  .desktop-prototype__action[data-action-layout="inline"] > p { grid-column:1 !important; grid-row:1 !important; }
  .desktop-prototype__action[data-action-layout="inline"] > :global(.desktop-prototype__primary-action) { grid-column:2 !important; grid-row:1 !important; min-width:0; }
  .desktop-prototype__action[data-action-layout="inline"] > .desktop-prototype__action-row { grid-column:3 !important; grid-row:1 !important; justify-self:end; }
  .desktop-prototype__action > p { display: grid; gap: .06rem; margin: 0; }
  .desktop-prototype__action > p span {
    color: #d7c9bc;
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .desktop-prototype__action > p strong { font-size: clamp(1.1rem, 2vw, 1.42rem); line-height: 1.05; }
  :global(.desktop-prototype__primary-action) {
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .62rem;
    padding: .7rem .9rem;
    border-radius: 18px;
    background: var(--clean-accent, #b54d22);
    color: #fff;
    font-size: .98rem;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 12px 24px rgba(124, 49, 20, .25);
  }
  :global(.desktop-prototype__primary-action [data-desktop-primary-label]),
  :global(.desktop-prototype__primary-action [data-calendar-label]) { min-width:0; }
  :global(.desktop-prototype__primary-action .icon) { width: 1.5rem; height: 1.5rem; }
  :global(button.desktop-prototype__primary-action) { border:0; font:inherit; cursor:pointer; }
  /* The success toast intentionally escapes the rounded CTA; a later page-level
     primary-action rule otherwise clips it even though it does not affect layout. */
  .desktop-prototype__phone-copy { position:relative; width:100%; min-width:0; overflow:visible !important; white-space:nowrap; }
  .desktop-prototype__phone-copy:active { box-shadow:0 6px 14px rgba(124,49,20,.22); }
  .desktop-prototype__phone-copy:focus-visible { outline:3px solid var(--ke-focus-ring,#f1ae79); outline-offset:3px; }
  .desktop-prototype__phone-label { min-width:0; overflow:hidden; font-size:var(--ke-font-size-300,1rem); font-variant-numeric:tabular-nums; text-overflow:ellipsis; }
  .desktop-prototype__phone-copy[data-phone-revealed="true"] .desktop-prototype__phone-label { user-select:all; }
  .desktop-prototype__phone-toast {
    position:absolute;
    left:50%;
    bottom:calc(100% + .5rem);
    z-index:5;
    padding:.42rem .65rem;
    border:1px solid rgba(255,255,255,.25);
    border-radius:10px;
    color:#fff;
    background:#2d6f58;
    box-shadow:0 8px 18px rgba(20,52,41,.28);
    font-size:.76rem;
    font-weight:850;
    line-height:1;
    opacity:0;
    pointer-events:none;
    transform:translate(-50%,.3rem);
  }
  .desktop-prototype__phone-copy[data-copy-state="success"] .desktop-prototype__phone-toast { opacity:1; transform:translate(-50%,0); }
  .desktop-prototype__phone-copy[data-copy-state="error"] .desktop-prototype__phone-toast { opacity:1; transform:translate(-50%,0); background:#8c3327; }
  @media (max-width:759px) { .desktop-prototype__phone-toast { display:none; } }
  @media (prefers-reduced-motion:no-preference) {
    .desktop-prototype__phone-toast { transition:opacity .16s ease, transform .16s ease; }
  }
  :global(.desktop-prototype__primary-action.is-disabled) { opacity: .7; }
  .desktop-prototype__action-row { display: flex; gap: .45rem; }
  :global(.desktop-prototype__icon-action) {
    min-width: 52px;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .28rem;
    padding: .3rem;
    border: 0;
    border-radius: 14px;
    background: rgba(255, 255, 255, .08);
    color: #fffaf2;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  :global(.desktop-prototype__icon-action[data-calendar-adaptive-label]) {
    width: auto;
    padding-inline: .75rem;
    /* Geometry is measured synchronously; an in-flight width transition would
       expose an intermediate box and could falsely admit a clipped inline CTA. */
    transition: none;
  }
  :global(.desktop-prototype__icon-action[data-calendar-adaptive-label] [data-calendar-label]) {
    max-width: 9rem;
    overflow: hidden;
    white-space: nowrap;
    font-size: .88rem;
    font-weight: 850;
    opacity: 1;
    transition: none;
  }
  :global(.desktop-prototype__icon-action[data-calendar-adaptive-label].is-calendar-label-compact) {
    width: 52px;
    min-width: 52px;
    padding-inline: .3rem;
  }
  :global(.desktop-prototype__icon-action[data-calendar-adaptive-label].is-calendar-label-compact [data-calendar-label]) {
    max-width: 0;
    opacity: 0;
  }
  :global(.desktop-prototype__icon-action .icon) { width: 29px; height: 29px; }
  :global(.desktop-prototype__icon-action strong) { font-size: .92rem; font-variant-numeric: tabular-nums; }
  :global(.desktop-prototype__action[data-action-density="compact"] .desktop-prototype__icon-action[data-calendar-adaptive-label]) { width:52px; min-width:52px; padding-inline:.3rem; }
  :global(.desktop-prototype__action[data-action-density="compact"] .desktop-prototype__icon-action[data-calendar-adaptive-label]),
  :global(.desktop-prototype__action[data-action-density="compact"] .desktop-prototype__icon-action[data-calendar-adaptive-label] [data-calendar-label]) { transition:none; }
  :global(.desktop-prototype__action[data-action-density="compact"] .desktop-prototype__icon-action[data-calendar-adaptive-label] [data-calendar-label]) { width:0; max-width:0; opacity:0; }

</style>
