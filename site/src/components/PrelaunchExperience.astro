---
import transparentArtwork from '../assets/announcements-brand-transparent-384.webp';
import '../styles/prelaunch-fit-v12.css';
import '../styles/prelaunch-fit-v13.css';
import '../styles/prelaunch-fit-v14.css';
import '../styles/prelaunch-fit-v15.css';

const artworkSrc = transparentArtwork.src;
---

<script is:inline define:vars={{ artworkSrc }}>
  (() => {
    const root = document.querySelector('[data-prelaunch-page]');
    const background = root?.querySelector('.prelaunch__background');
    if (!(root instanceof HTMLElement) || !(background instanceof HTMLElement)) return;

    const previous = background.querySelector('.prelaunch__artwork');
    previous?.remove();

    const artwork = document.createElement('img');
    artwork.className = 'prelaunch__artwork';
    artwork.src = artworkSrc;
    artwork.alt = '';
    artwork.width = 384;
    artwork.height = 384;
    artwork.decoding = 'async';
    artwork.fetchPriority = 'high';
    artwork.draggable = false;
    artwork.setAttribute('aria-hidden', 'true');
    background.append(artwork);

    const markReady = () => {
      root.dataset.transparentArtworkBound = 'image';
      root.dataset.artworkReady = 'true';
      window.dispatchEvent(new CustomEvent('prelaunch-artwork-ready'));
    };
    if (artwork.complete) markReady();
    else artwork.addEventListener('load', markReady, { once: true });
  })();
</script>

<script>
  import '../scripts/prelaunchExperience';
</script>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    html body .prelaunch[data-prelaunch-page] .prelaunch__tile::before,
    html body .prelaunch[data-prelaunch-page] .prelaunch__tile::after {
      transition: none !important;
    }
  }

  @media (orientation: landscape) and (min-width: 600px) and (max-height: 500px) {
    html body .prelaunch[data-prelaunch-page] .prelaunch__notify {
      transform: translateY(-13px);
    }
  }
</style>