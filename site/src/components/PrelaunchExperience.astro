---
import '../styles/prelaunch-fit-v12.css';
import '../styles/prelaunch-fit-v13.css';
import '../styles/prelaunch-fit-v14.css';
import '../styles/prelaunch-fit-v15.css';
import '../styles/prelaunch-fit-v16.css';
import '../styles/prelaunch-fit-v17.css';
---

<script is:inline>
  (() => {
    const root = document.querySelector('[data-prelaunch-page]');
    const background = root?.querySelector('.prelaunch__background');
    const source = root?.querySelector('.prelaunch__projection');
    if (!(root instanceof HTMLElement)
      || !(background instanceof HTMLElement)
      || !(source instanceof HTMLImageElement)) return;

    const isConnectedStudioPixel = (red, green, blue, alpha) => {
      if (alpha < 8) return true;
      const maximum = Math.max(red, green, blue);
      const minimum = Math.min(red, green, blue);
      const luminance = red * .2126 + green * .7152 + blue * .0722;
      return luminance > 205 && maximum - minimum < 48;
    };

    const buildTransparentArtwork = () => {
      if (!source.naturalWidth || !source.naturalHeight || root.dataset.artworkReady === 'true') return;

      const canvas = document.createElement('canvas');
      canvas.className = 'prelaunch__artwork';
      canvas.width = source.naturalWidth;
      canvas.height = source.naturalHeight;
      canvas.setAttribute('aria-hidden', 'true');
      canvas.setAttribute('role', 'presentation');

      const context = canvas.getContext('2d', { willReadFrequently: true });
      if (!context) return;
      context.drawImage(source, 0, 0);

      const image = context.getImageData(0, 0, canvas.width, canvas.height);
      const pixels = image.data;
      const pixelCount = canvas.width * canvas.height;
      const visited = new Uint8Array(pixelCount);
      const queue = new Uint32Array(pixelCount);
      let head = 0;
      let tail = 0;

      const enqueue = (index) => {
        if (visited[index]) return;
        const offset = index * 4;
        if (!isConnectedStudioPixel(
          pixels[offset],
          pixels[offset + 1],
          pixels[offset + 2],
          pixels[offset + 3],
        )) return;
        visited[index] = 1;
        queue[tail] = index;
        tail += 1;
      };

      for (let x = 0; x < canvas.width; x += 1) {
        enqueue(x);
        enqueue((canvas.height - 1) * canvas.width + x);
      }
      for (let y = 1; y < canvas.height - 1; y += 1) {
        enqueue(y * canvas.width);
        enqueue(y * canvas.width + canvas.width - 1);
      }

      while (head < tail) {
        const index = queue[head];
        head += 1;
        const x = index % canvas.width;
        const y = Math.floor(index / canvas.width);
        if (x > 0) enqueue(index - 1);
        if (x + 1 < canvas.width) enqueue(index + 1);
        if (y > 0) enqueue(index - canvas.width);
        if (y + 1 < canvas.height) enqueue(index + canvas.width);
      }

      for (let index = 0; index < pixelCount; index += 1) {
        if (visited[index]) pixels[index * 4 + 3] = 0;
      }

      /* Feather only the light antialias fringe touching the removed field. */
      for (let y = 1; y < canvas.height - 1; y += 1) {
        for (let x = 1; x < canvas.width - 1; x += 1) {
          const index = y * canvas.width + x;
          if (visited[index]) continue;
          const touchesRemoved = visited[index - 1]
            || visited[index + 1]
            || visited[index - canvas.width]
            || visited[index + canvas.width];
          if (!touchesRemoved) continue;
          const offset = index * 4;
          const maximum = Math.max(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const minimum = Math.min(pixels[offset], pixels[offset + 1], pixels[offset + 2]);
          const luminance = pixels[offset] * .2126 + pixels[offset + 1] * .7152 + pixels[offset + 2] * .0722;
          if (luminance > 184 && maximum - minimum < 62) {
            pixels[offset + 3] = Math.min(pixels[offset + 3], 80);
          }
        }
      }

      context.putImageData(image, 0, 0);
      background.querySelector('.prelaunch__artwork')?.remove();
      background.append(canvas);
      root.dataset.transparentArtworkBound = 'canvas';
      root.dataset.artworkReady = 'true';
      window.dispatchEvent(new CustomEvent('prelaunch-artwork-ready'));
    };

    if (source.complete) buildTransparentArtwork();
    else source.addEventListener('load', buildTransparentArtwork, { once: true });
  })();
</script>

<script>
  import '../scripts/prelaunchExperience';
</script>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    html body .prelaunch[data-prelaunch-page] .prelaunch__tile::before,
    html body .prelaunch[data-prelaunch-page] .prelaunch__tile::after {
      transition: none !important;
    }
  }

  @media (orientation: landscape) and (min-width: 600px) and (max-height: 500px) {
    html body .prelaunch[data-prelaunch-page] .prelaunch__notify {
      transform: translateY(-13px);
    }
  }
</style>