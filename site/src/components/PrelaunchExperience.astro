---
import '../styles/prelaunch-fit-v12.css';
---

<script>
  import '../scripts/prelaunchExperience';
</script>

<style is:global>
  /*
   * The reveal map is assigned after hydration. Keep its optical aperture as a
   * direct material property rather than relying only on inherited custom
   * properties: older fit layers are intentionally still present in the
   * cascade and may otherwise re-close a mapped pane after extraction order is
   * changed by Astro/Vite.
   */
  body .prelaunch[data-prelaunch-page] .prelaunch__tile[data-window="true"]::before {
    background-color: rgba(10, 13, 17, .28) !important;
  }
</style>
