<section class="keyboard-quickstart" data-keyboard-quickstart aria-labelledby="keyboard-quickstart-title">
  <div class="page-shell keyboard-quickstart__inner">
    <div>
      <p class="eyebrow">Попробуй быструю навигацию</p>
      <h2 id="keyboard-quickstart-title">Ищи следующее событие без мышки</h2>
      <p>Начни со стрелки вниз: она сразу выберет первое похожее событие. Дальше перемещайся по карточкам стрелками.</p>
    </div>
    <button type="button" class="keyboard-quickstart__start" data-keyboard-prototype-start>
      <span>Начать с похожих</span><kbd>↓</kbd>
    </button>
    <ul aria-label="Клавиши быстрой навигации">
      <li><kbd>← ↑ → ↓</kbd><span>выбирать события</span></li>
      <li><kbd>↑</kbd><span>открыть фото наверху</span></li>
      <li><kbd>Enter</kbd><span>открыть</span></li>
      <li><kbd>L</kbd><span>лайк</span></li>
      <li><kbd>K</kbd><span>календарь</span></li>
      <li><kbd>S</kbd><span>скопировать событие</span></li>
      <li><kbd>Space</kbd><span>прокрутка</span></li>
    </ul>
  </div>
</section>

<p class="sr-only" id="keyboard-prototype-instructions">
  Быстрая навигация по событиям. Стрелка вниз переводит к похожим событиям.
  На карточках используйте стрелки для перехода между событиями. Пробел прокручивает страницу.
  Enter открывает событие или основное действие. L ставит лайк, K добавляет в календарь,
  S копирует название и ссылку. Стрелки влево и вправо в верхнем блоке листают фотографии,
  стрелка вверх открывает полноэкранную галерею.
</p>
<p class="sr-only" data-keyboard-prototype-status role="status" aria-live="polite" aria-atomic="true"></p>
<div class="keyboard-action-toast" data-keyboard-action-toast aria-hidden="true" hidden>
  <span data-keyboard-action-toast-icon>✓</span><strong data-keyboard-action-toast-text></strong>
</div>

<script is:inline>
  const root = document.querySelector('[data-desktop-clean-event]');
  const status = document.querySelector('[data-keyboard-prototype-status]');
  const actionToast = document.querySelector('[data-keyboard-action-toast]');
  const actionToastIcon = actionToast?.querySelector('[data-keyboard-action-toast-icon]');
  const actionToastText = actionToast?.querySelector('[data-keyboard-action-toast-text]');
  const startButton = document.querySelector('[data-keyboard-prototype-start]');

  const isVisible = (element) => {
    if (!(element instanceof HTMLElement) || element.hidden) return false;
    const rect = element.getBoundingClientRect();
    const style = window.getComputedStyle(element);
    return rect.width > 0 && rect.height > 0 && style.display !== 'none' && style.visibility !== 'hidden';
  };

  const surface = root instanceof HTMLElement
    ? Array.from(root.querySelectorAll('[data-desktop-action-panel]')).find(isVisible)
    : null;
  const desktopKeyboard = window.matchMedia('(min-width:1024px)');

  if (root instanceof HTMLElement && surface instanceof HTMLElement && desktopKeyboard.matches) {
    root.setAttribute('data-closed-hero-keyboard-scope', '');
    surface.tabIndex = 0;
    surface.setAttribute('data-keyboard-event-surface', '');
    surface.setAttribute('aria-describedby', 'keyboard-prototype-instructions');
    surface.setAttribute('aria-keyshortcuts', 'ArrowLeft ArrowRight ArrowUp ArrowDown Enter L K S');

    const primary = surface.querySelector('.desktop-prototype__primary-action:not(.is-disabled)');
    const currentLike = surface.querySelector('[data-feedback-action="like"]');
    if (currentLike instanceof HTMLElement) {
      // The shared feedback renderer reads identity from its scope. Keep this
      // one-page prototype self-contained while making consent replay visible.
      surface.dataset.eventId = currentLike.dataset.eventId || '';
      surface.dataset.eventTitle = currentLike.dataset.eventTitle || '';
    }
    const shortcutUsageKey = 'ke_keyboard_shortcut_usage_v1';
    const regularUseCount = 6;
    const regularUseWindowMs = 14 * 24 * 60 * 60 * 1000;
    const readShortcutUsage = () => {
      try {
        const value = JSON.parse(localStorage.getItem(shortcutUsageKey) || 'null');
        return {
          count: Math.max(0, Number(value?.count || 0)),
          lastUsedAt: Math.max(0, Number(value?.lastUsedAt || 0)),
        };
      } catch {
        return { count: 0, lastUsedAt: 0 };
      }
    };
    const shortcutHintsAreCompact = () => {
      const usage = readShortcutUsage();
      return usage.count >= regularUseCount && Date.now() - usage.lastUsedAt <= regularUseWindowMs;
    };
    const updateShortcutHintVisibility = () => {
      const compact = shortcutHintsAreCompact();
      surface.dataset.keyboardShortcutHints = compact ? 'hidden' : 'visible';
      surface.querySelectorAll('[data-keyboard-shortcut-badge]').forEach((badge) => { badge.hidden = compact; });
    };
    const recordShortcutUse = () => {
      const usage = readShortcutUsage();
      const isRecent = Date.now() - usage.lastUsedAt <= regularUseWindowMs;
      try {
        localStorage.setItem(shortcutUsageKey, JSON.stringify({ count: isRecent ? usage.count + 1 : 1, lastUsedAt: Date.now() }));
      } catch {}
      updateShortcutHintVisibility();
    };
    const shortcutTargets = [
      [primary, 'Enter', 'Основное действие — клавиша Enter'],
      [surface.querySelector('[data-calendar-action]:not(.desktop-prototype__primary-action)'), 'K', 'Добавить в календарь — клавиша K'],
      [surface.querySelector('[data-native-share]'), 'S', 'Скопировать название и ссылку события — клавиша S'],
      [surface.querySelector('[data-feedback-action="like"]'), 'L', 'Поставить лайк — клавиша L'],
    ];
    shortcutTargets.forEach(([target, key, title]) => {
      if (!(target instanceof HTMLElement) || target.querySelector('[data-keyboard-shortcut-badge]')) return;
      target.setAttribute('data-keyboard-shortcut-target', '');
      target.setAttribute('aria-keyshortcuts', key);
      target.setAttribute('title', title);
      const badge = document.createElement('span');
      badge.className = 'keyboard-shortcut-badge';
      badge.dataset.keyboardShortcutBadge = '';
      badge.setAttribute('aria-hidden', 'true');
      badge.textContent = key;
      target.append(badge);
    });
    updateShortcutHintVisibility();

    let footerShare = null;
    let footerImageAction = null;
    let footerTextAction = null;
    let footerStatusObserver = null;
    const enhanceFooterShare = () => {
      footerShare = document.querySelector('[data-service-share-root][data-service-share-surface="footer"]');
      footerImageAction = footerShare?.querySelector('[data-service-share-button][data-service-share-intent="image"]') || null;
      footerTextAction = footerShare?.querySelector('[data-service-share-button][data-service-share-intent="text"]') || null;
      [
        [footerImageAction, 'P', 'Скопировать карточку сервиса — клавиша P'],
        [footerTextAction, 'S', 'Скопировать текст и ссылку сервиса — клавиша S'],
      ].forEach(([target, key, title]) => {
        if (!(target instanceof HTMLElement)) return;
        target.setAttribute('title', title);
        target.setAttribute('aria-keyshortcuts', key);
        const label = target.querySelector('span:last-of-type');
        if (!(label instanceof HTMLElement) || target.querySelector('[data-service-shortcut-badge]')) return;
        const keycap = document.createElement('kbd');
        keycap.className = 'service-share-inline-shortcut';
        keycap.dataset.serviceShortcutBadge = '';
        keycap.setAttribute('aria-hidden', 'true');
        keycap.textContent = key;
        label.after(keycap);
      });
      const footerStatus = footerShare?.querySelector('[data-service-share-status]');
      if (footerStatus instanceof HTMLElement && !footerStatusObserver) {
        footerStatusObserver = new MutationObserver(() => {
          const message = footerStatus.textContent?.trim();
          if (message) showActionToast(message, /не удалось|ошиб/iu.test(message) ? 'error' : 'success');
        });
        footerStatusObserver.observe(footerStatus, { childList:true, characterData:true, subtree:true });
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enhanceFooterShare, { once:true });
    else enhanceFooterShare();

    const cards = () => Array.from(root.querySelectorAll('[data-related-start] [data-event-card]')).filter(isVisible);
    const gallerySlides = Array.from(root.querySelectorAll('[data-hero-gallery-slide][data-gallery-slide-kind="image"]'));
    const heroImage = root.querySelector('[data-clean-hero-image]');
    const heroOpener = heroImage?.closest('[data-hero-gallery-open]');
    const heroStatus = root.querySelector('[data-closed-hero-status]');

    let statusTimer;
    let actionToastTimer;
    let gallerySpaceArm = null;
    const setStatus = (message) => {
      if (!(status instanceof HTMLElement)) return;
      window.clearTimeout(statusTimer);
      status.textContent = '';
      statusTimer = window.setTimeout(() => { status.textContent = message; }, 20);
    };

    function showActionToast(message, state = 'success') {
      if (!(actionToast instanceof HTMLElement) || !(actionToastText instanceof HTMLElement)) return;
      window.clearTimeout(actionToastTimer);
      actionToastText.textContent = message;
      actionToast.dataset.state = state;
      if (actionToastIcon instanceof HTMLElement) actionToastIcon.textContent = state === 'error' ? '!' : '✓';
      actionToast.hidden = false;
      window.requestAnimationFrame(() => actionToast.classList.add('is-visible'));
      actionToastTimer = window.setTimeout(() => {
        actionToast.classList.remove('is-visible');
        window.setTimeout(() => { actionToast.hidden = true; }, 180);
      }, 2600);
    }

    const fallbackCopyText = (value) => {
      const previousFocus = document.activeElement;
      const field = document.createElement('textarea');
      field.value = value;
      field.setAttribute('readonly', '');
      field.style.position = 'fixed';
      field.style.opacity = '0';
      document.body.appendChild(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      if (previousFocus instanceof HTMLElement && document.contains(previousFocus)) previousFocus.focus({ preventScroll:true });
      if (!copied) throw new Error('clipboard unavailable');
    };

    const copyText = async (value) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(value);
          return;
        } catch {}
      }
      fallbackCopyText(value);
    };

    const copyEventLink = async (button) => {
      if (!(button instanceof HTMLElement) || button.dataset.keyboardCopyPending === 'true') return;
      const title = String(button.dataset.shareEventTitle || button.dataset.shareTitle || '').trim();
      const url = String(button.dataset.shareUrl || '').trim();
      if (!title || !url) {
        button.dataset.keyboardCopyState = 'error';
        showActionToast('Не удалось определить ссылку события', 'error');
        setStatus('Не удалось определить ссылку выбранного события.');
        window.setTimeout(() => { delete button.dataset.keyboardCopyState; }, 2600);
        return;
      }
      button.dataset.keyboardCopyPending = 'true';
      button.setAttribute('aria-busy', 'true');
      try {
        await copyText(`${title}\n${url}`);
        button.dataset.keyboardCopyState = 'success';
        showActionToast('Название и ссылка на событие скопированы');
        setStatus('Название и ссылка на событие скопированы.');
      } catch {
        button.dataset.keyboardCopyState = 'error';
        showActionToast('Не удалось скопировать ссылку', 'error');
        setStatus('Не удалось скопировать ссылку на событие.');
      } finally {
        delete button.dataset.keyboardCopyPending;
        button.setAttribute('aria-busy', 'false');
        window.setTimeout(() => { delete button.dataset.keyboardCopyState; }, 2600);
      }
    };

    // On desktop the event share control is deliberately a deterministic copy
    // action. It never enters Web Share or image generation in this prototype.
    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-native-share]') : null;
      if (!(button instanceof HTMLElement) || !root.contains(button)) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      void copyEventLink(button);
    }, true);

    const focusSurface = () => {
      surface.focus({ preventScroll: true });
      surface.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
    };

    const focusCard = (card) => {
      if (!(card instanceof HTMLElement)) return;
      card.focus({ preventScroll: true });
      card.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
    };

    const focusFirstCard = () => {
      const first = cards()[0];
      if (first) focusCard(first);
    };

    const rowsFor = (allCards) => {
      const rows = [];
      for (const card of allCards) {
        const rect = card.getBoundingClientRect();
        let row = rows.find((candidate) => Math.abs(candidate.top - rect.top) < 32);
        if (!row) {
          row = { top: rect.top, cards: [] };
          rows.push(row);
        }
        row.cards.push({ card, centerX: rect.left + rect.width / 2 });
      }
      rows.sort((a, b) => a.top - b.top);
      rows.forEach((row) => row.cards.sort((a, b) => a.centerX - b.centerX));
      return rows;
    };

    const verticalNeighbor = (current, direction, allCards) => {
      const rows = rowsFor(allCards);
      const rowIndex = rows.findIndex((row) => row.cards.some((entry) => entry.card === current));
      if (rowIndex < 0) return null;
      const targetRowIndex = rowIndex + direction;
      if (targetRowIndex < 0) return surface;
      const targetRow = rows[targetRowIndex];
      if (!targetRow) return null;
      const rect = current.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      return targetRow.cards.reduce((best, entry) => Math.abs(entry.centerX - centerX) < Math.abs(best.centerX - centerX) ? entry : best).card;
    };

    const actionFor = (scope, code) => {
      if (!(scope instanceof HTMLElement)) return null;
      if (code === 'KeyL') return scope.querySelector('[data-feedback-action="like"]');
      if (code === 'KeyK') return scope.querySelector('[data-calendar-action]');
      if (code === 'KeyS') return scope.querySelector('[data-native-share]');
      return null;
    };

    const actionLabel = (code) => ({ KeyL: 'Лайк', KeyK: 'Календарь', KeyS: 'Поделиться' })[code] || 'Действие';
    const runAction = (scope, event) => {
      const action = actionFor(scope, event.code);
      event.preventDefault();
      if (!(action instanceof HTMLElement)) {
        setStatus(`${actionLabel(event.code)}: действие недоступно для выбранного события.`);
        return;
      }
      action.click();
      recordShortcutUse();
      setStatus(`${actionLabel(event.code)}: команда передана для выбранного события.`);
    };

    const selectHero = (direction) => {
      if (!(heroImage instanceof HTMLImageElement) || gallerySlides.length < 2) return false;
      const current = Number(root.dataset.activeHeroGalleryIndex || '0');
      const next = (current + direction + gallerySlides.length) % gallerySlides.length;
      const slide = gallerySlides[next];
      const image = slide?.querySelector('.hero-gallery__image[data-gallery-src]');
      const src = image?.dataset.gallerySrc;
      if (!(image instanceof HTMLImageElement) || !src) return false;
      root.dataset.activeHeroGalleryIndex = String(next);
      heroImage.src = src;
      heroImage.alt = image.alt || heroImage.alt;
      const width = Number(image.getAttribute('width') || 0);
      const height = Number(image.getAttribute('height') || 0);
      if (width) heroImage.width = width;
      if (height) heroImage.height = height;
      heroImage.style.objectPosition = image.dataset.objectPosition || '50% 50%';
      if (heroOpener instanceof HTMLElement) heroOpener.dataset.heroGalleryIndex = String(next);
      if (heroStatus instanceof HTMLElement) heroStatus.textContent = `Фото ${next + 1} из ${gallerySlides.length}`;
      return true;
    };

    const dialogIsOpen = () => [
      '[data-hero-gallery]:not([hidden])',
      '[data-efficient-viewer]:not([hidden])',
      '[role="dialog"]:not([hidden])',
    ].some((selector) => Array.from(document.querySelectorAll(selector)).some(isVisible));

    const activeHeroGallery = () => Array.from(document.querySelectorAll('[data-hero-gallery]:not([hidden])'))
      .find((gallery) => gallery instanceof HTMLElement && gallery.classList.contains('is-open') && isVisible(gallery));

    const activeGalleryRecommendation = (gallery) => {
      if (!(gallery instanceof HTMLElement)) return null;
      const slides = Array.from(gallery.querySelectorAll('[data-hero-gallery-slide]'));
      const slide = slides[Number(gallery.dataset.activeIndex || '0')];
      if (!(slide instanceof HTMLElement) || slide.dataset.gallerySlideKind !== 'cta') return null;
      return slide.querySelector('a[href]');
    };

    const elementIntersectsViewport = (element) => {
      if (!(element instanceof HTMLElement)) return false;
      const rect = element.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
    };

    const footerOwnsShortcut = (target, code) => {
      if (!(footerShare instanceof HTMLElement) || !['KeyP', 'KeyS'].includes(code)) return false;
      if (footerShare.contains(target)) return true;
      if (!elementIntersectsViewport(footerShare)) return false;
      // Scrolling does not move DOM focus. At the footer, allow its shortcuts
      // when the previously focused event control has left the viewport.
      return target === document.body || target === document.documentElement || !elementIntersectsViewport(target);
    };

    const isEditing = (target) => target instanceof HTMLElement && (
      target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
    );

    document.addEventListener('keydown', (event) => {
      if (!desktopKeyboard.matches || event.defaultPrevented || event.isComposing || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || isEditing(event.target)) return;
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const gallery = activeHeroGallery();
      if (gallery instanceof HTMLElement) {
        const recommendation = activeGalleryRecommendation(gallery);
        if (event.code !== 'Space') gallerySpaceArm = null;
        if (recommendation instanceof HTMLAnchorElement && event.code === 'Enter' && !event.repeat) {
          if (target === gallery) {
            event.preventDefault();
            recommendation.click();
          }
        } else if (recommendation instanceof HTMLAnchorElement && event.code === 'Space' && !event.repeat) {
          if (target === gallery || target === recommendation) {
            event.preventDefault();
            gallerySpaceArm = { gallery, recommendation, target };
          }
        }
        return;
      }

      const consent = document.querySelector('[data-personalization-consent].is-visible');
      if (consent instanceof HTMLElement) {
        if (event.code === 'Escape') {
          event.preventDefault();
          consent.querySelector('[data-personalization-consent-dismiss]')?.click();
        } else if (event.code === 'Enter') {
          event.preventDefault();
          consent.querySelector('[data-personalization-consent-accept]')?.click();
        }
        return;
      }
      if (dialogIsOpen()) return;

      if (event.code === 'ArrowDown' && (target === document.body || target === document.documentElement)) {
        event.preventDefault();
        focusFirstCard();
        return;
      }

      if (footerOwnsShortcut(target, event.code)) {
        const serviceAction = event.code === 'KeyP' ? footerImageAction : event.code === 'KeyS' ? footerTextAction : null;
        if (serviceAction instanceof HTMLElement && !event.repeat) {
          event.preventDefault();
          serviceAction.click();
          recordShortcutUse();
        }
        return;
      }

      if (target === surface || surface.contains(target)) {
        if (event.code === 'ArrowLeft' || event.code === 'ArrowRight') {
          if (selectHero(event.code === 'ArrowRight' ? 1 : -1)) event.preventDefault();
          return;
        }
        if (event.code === 'ArrowDown') {
          event.preventDefault();
          focusFirstCard();
          return;
        }
        if (event.code === 'ArrowUp') {
          if (heroOpener instanceof HTMLElement) {
            event.preventDefault();
            heroOpener.click();
            recordShortcutUse();
          }
          return;
        }
        if (event.code === 'Enter' && target === surface) {
          if (primary instanceof HTMLElement) {
            event.preventDefault();
            primary.click();
            recordShortcutUse();
          }
          return;
        }
        if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) runAction(surface, event);
        return;
      }

      const current = target.closest('[data-related-start] [data-event-card]');
      if (!(current instanceof HTMLElement)) return;
      const allCards = cards();
      const index = allCards.indexOf(current);

      if (event.code === 'Escape' && target !== current) {
        event.preventDefault();
        focusCard(current);
        return;
      }
      if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) {
        runAction(current, event);
        return;
      }
      if (event.code === 'Home' && allCards[0]) {
        event.preventDefault();
        focusCard(allCards[0]);
        return;
      }
      if (event.code === 'End' && allCards.at(-1)) {
        event.preventDefault();
        focusCard(allCards.at(-1));
        return;
      }
      if (event.code === 'ArrowLeft' || event.code === 'ArrowRight') {
        const neighbor = allCards[index + (event.code === 'ArrowLeft' ? -1 : 1)];
        if (neighbor) {
          event.preventDefault();
          focusCard(neighbor);
        }
        return;
      }
      if (event.code === 'ArrowUp' || event.code === 'ArrowDown') {
        const neighbor = verticalNeighbor(current, event.code === 'ArrowUp' ? -1 : 1, allCards);
        if (neighbor) {
          event.preventDefault();
          neighbor === surface ? focusSurface() : focusCard(neighbor);
        }
      }
    });

    document.addEventListener('keyup', (event) => {
      if (!desktopKeyboard.matches || event.defaultPrevented || event.isComposing || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.code !== 'Space' || !gallerySpaceArm) return;
      const arm = gallerySpaceArm;
      gallerySpaceArm = null;
      const gallery = activeHeroGallery();
      const recommendation = activeGalleryRecommendation(gallery);
      if (gallery !== arm.gallery || recommendation !== arm.recommendation || event.target !== arm.target || document.activeElement !== arm.target) return;
      event.preventDefault();
      recommendation.click();
    });

    document.addEventListener('focusin', () => {
      if (gallerySpaceArm && document.activeElement !== gallerySpaceArm.target) gallerySpaceArm = null;
    });

    startButton?.addEventListener('click', focusFirstCard);
    window.requestAnimationFrame(() => surface.focus({ preventScroll: true }));
  }
</script>

<style is:global is:inline>
  .keyboard-quickstart { display:none; }

  @media (min-width:1024px) {
    [data-keyboard-event-surface]:focus-visible {
      outline:2px solid rgba(244,185,66,.34);
      outline-offset:3px;
    }
    [data-related-start] [data-event-card]:focus-visible,
    [data-related-start] [data-event-card]:has(:focus-visible) {
      outline:3px solid #f4b942;
      outline-offset:5px;
      box-shadow:0 12px 36px rgba(46,31,22,.2);
    }
    [data-keyboard-shortcut-target] { position:relative; }
    .keyboard-shortcut-badge {
      position:absolute;
      right:5px;
      bottom:4px;
      z-index:2;
      min-width:14px;
      padding:1px 3px;
      border:1px solid currentColor;
      border-radius:4px;
      color:inherit;
      font:700 8px/1.15 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing:0;
      text-align:center;
      opacity:.46;
      pointer-events:none;
    }
    .service-share-inline-shortcut {
      display:inline-grid;
      min-width:20px;
      min-height:20px;
      place-items:center;
      margin-left:.2rem;
      padding:1px 5px;
      border:1px solid rgba(121,48,20,.22);
      border-radius:6px;
      background:#fffaf2;
      color:#793014;
      box-shadow:0 1px 0 rgba(34,26,20,.12);
