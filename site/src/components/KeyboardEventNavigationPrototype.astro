<div class="keyboard-prototype-mobile-note" role="note">
  Этот прототип предназначен для десктопа с физической клавиатурой.
</div>

<aside class="keyboard-prototype-dock" data-keyboard-prototype-dock aria-label="Подсказка по быстрой навигации">
  <strong>Быстрый просмотр событий</strong>
  <p><kbd>↓</kbd> похожие <kbd>← ↑ → ↓</kbd> карточки <kbd>Space</kbd> прокрутка</p>
  <p><kbd>Enter</kbd> открыть · <kbd>L</kbd> лайк · <kbd>K</kbd> календарь · <kbd>S</kbd> ссылка</p>
  <button type="button" data-keyboard-prototype-home>К текущему событию</button>
  <span class="keyboard-prototype-dock__state" data-keyboard-prototype-state aria-hidden="true">Текущее событие</span>
</aside>

<p class="sr-only" id="keyboard-prototype-instructions">
  Быстрая навигация по событиям. Стрелка вниз переводит к похожим событиям.
  На карточках используйте стрелки для перехода между событиями. Пробел прокручивает страницу.
  Enter открывает событие или основное действие. L ставит лайк, K добавляет в календарь,
  S делится ссылкой. Escape возвращает фокус с действия карточки на карточку.
</p>
<p class="sr-only" data-keyboard-prototype-status role="status" aria-live="polite" aria-atomic="true"></p>

<script>
  const root = document.querySelector('[data-desktop-clean-event]');
  const surface = root?.querySelector('[data-title-panel]');
  const status = document.querySelector('[data-keyboard-prototype-status]');
  const dockState = document.querySelector('[data-keyboard-prototype-state]');
  const homeButton = document.querySelector('[data-keyboard-prototype-home]');

  if (root instanceof HTMLElement && surface instanceof HTMLElement) {
    surface.tabIndex = 0;
    surface.setAttribute('role', 'group');
    surface.setAttribute('data-keyboard-event-surface', '');
    surface.setAttribute('aria-label', 'Текущее событие. Быстрая навигация');
    surface.setAttribute('aria-describedby', 'keyboard-prototype-instructions');
    surface.setAttribute('aria-keyshortcuts', 'ArrowDown Enter L K S');

    const hint = document.createElement('p');
    hint.className = 'keyboard-prototype-surface-hint';
    hint.setAttribute('aria-hidden', 'true');
    hint.innerHTML = '<kbd>↓</kbd> похожие <span>·</span> <kbd>Space</kbd> читать <span>·</span> <kbd>Enter</kbd> билеты <span>·</span> <kbd>L</kbd><kbd>K</kbd><kbd>S</kbd>';
    surface.append(hint);

    const isVisible = (element) => {
      if (!(element instanceof HTMLElement) || element.hidden) return false;
      const rect = element.getBoundingClientRect();
      const style = window.getComputedStyle(element);
      return rect.width > 0 && rect.height > 0 && style.display !== 'none' && style.visibility !== 'hidden';
    };

    const cards = () => Array.from(root.querySelectorAll('[data-related-start] [data-event-card]')).filter(isVisible);

    let statusTimer;
    const setStatus = (message) => {
      if (!(status instanceof HTMLElement)) return;
      window.clearTimeout(statusTimer);
      status.textContent = '';
      statusTimer = window.setTimeout(() => { status.textContent = message; }, 20);
    };

    const cardTitle = (card) => card.getAttribute('data-event-title') || card.querySelector('[data-card-title]')?.textContent?.trim() || 'Событие';

    const updateDock = (element) => {
      if (!(dockState instanceof HTMLElement)) return;
      const card = element?.closest?.('[data-event-card]');
      dockState.textContent = card instanceof HTMLElement ? cardTitle(card) : 'Текущее событие';
    };

    const focusSurface = () => {
      surface.focus({ preventScroll: true });
      surface.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
      updateDock(surface);
    };

    const focusCard = (card) => {
      if (!(card instanceof HTMLElement)) return;
      card.focus({ preventScroll: true });
      card.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
      updateDock(card);
    };

    const rowsFor = (allCards) => {
      const rows = [];
      for (const card of allCards) {
        const rect = card.getBoundingClientRect();
        let row = rows.find((candidate) => Math.abs(candidate.top - rect.top) < 32);
        if (!row) {
          row = { top: rect.top, cards: [] };
          rows.push(row);
        }
        row.cards.push({ card, centerX: rect.left + rect.width / 2 });
      }
      rows.sort((a, b) => a.top - b.top);
      rows.forEach((row) => row.cards.sort((a, b) => a.centerX - b.centerX));
      return rows;
    };

    const verticalNeighbor = (current, direction, allCards) => {
      const rows = rowsFor(allCards);
      const rowIndex = rows.findIndex((row) => row.cards.some((entry) => entry.card === current));
      if (rowIndex < 0) return null;
      const targetRowIndex = rowIndex + direction;
      if (targetRowIndex < 0) return surface;
      const targetRow = rows[targetRowIndex];
      if (!targetRow) return null;
      const rect = current.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      return targetRow.cards.reduce((best, entry) => Math.abs(entry.centerX - centerX) < Math.abs(best.centerX - centerX) ? entry : best).card;
    };

    const actionFor = (scope, code) => {
      if (!(scope instanceof HTMLElement)) return null;
      if (code === 'KeyL') return scope.querySelector('[data-feedback-action="like"]');
      if (code === 'KeyK') return scope.querySelector('[data-calendar-action]');
      if (code === 'KeyS') return scope.querySelector('[data-native-share]');
      return null;
    };

    const actionLabel = (code) => ({ KeyL: 'Лайк', KeyK: 'Календарь', KeyS: 'Поделиться' })[code] || 'Действие';

    const runAction = (scope, event) => {
      const action = actionFor(scope, event.code);
      event.preventDefault();
      if (!(action instanceof HTMLElement)) {
        setStatus(`${actionLabel(event.code)}: действие недоступно для выбранного события.`);
        return;
      }
      action.click();
      setStatus(`${actionLabel(event.code)}: команда передана для выбранного события.`);
    };

    const dialogIsOpen = () => [
      '[data-hero-gallery]:not([hidden])',
      '[data-efficient-viewer]:not([hidden])',
      '[role="dialog"]:not([hidden])',
    ].some((selector) => Array.from(document.querySelectorAll(selector)).some(isVisible));

    const isEditing = (target) => target instanceof HTMLElement && (
      target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
    );

    document.addEventListener('focusin', (event) => {
      if (event.target instanceof HTMLElement && (event.target === surface || event.target.closest('[data-event-card]'))) {
        updateDock(event.target);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.isComposing || dialogIsOpen() || isEditing(event.target)) return;
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      if (target === surface) {
        if (event.code === 'ArrowDown') {
          const first = cards()[0];
          if (first) {
            event.preventDefault();
            focusCard(first);
          }
          return;
        }
        if (event.code === 'Enter') {
          const primary = Array.from(root.querySelectorAll('.desktop-prototype__primary-action:not(.is-disabled)')).find(isVisible);
          if (primary instanceof HTMLElement) {
            event.preventDefault();
            primary.click();
          }
          return;
        }
        if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) {
          const panel = Array.from(root.querySelectorAll('[data-desktop-action-panel]')).find(isVisible);
          runAction(panel, event);
        }
        return;
      }

      const current = target.closest('[data-related-start] [data-event-card]');
      if (!(current instanceof HTMLElement)) return;
      const allCards = cards();
      const index = allCards.indexOf(current);

      if (event.code === 'Escape' && target !== current) {
        event.preventDefault();
        focusCard(current);
        return;
      }
      if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) {
        runAction(current, event);
        return;
      }
      if (event.code === 'Home' && allCards[0]) {
        event.preventDefault();
        focusCard(allCards[0]);
        return;
      }
      if (event.code === 'End' && allCards.at(-1)) {
        event.preventDefault();
        focusCard(allCards.at(-1));
        return;
      }
      if (event.code === 'ArrowLeft' || event.code === 'ArrowRight') {
        const step = event.code === 'ArrowLeft' ? -1 : 1;
        const neighbor = allCards[index + step];
        if (neighbor) {
          event.preventDefault();
          focusCard(neighbor);
        }
        return;
      }
      if (event.code === 'ArrowUp' || event.code === 'ArrowDown') {
        const neighbor = verticalNeighbor(current, event.code === 'ArrowUp' ? -1 : 1, allCards);
        if (neighbor) {
          event.preventDefault();
          neighbor === surface ? focusSurface() : focusCard(neighbor);
        }
      }
    });

    homeButton?.addEventListener('click', focusSurface);
    window.requestAnimationFrame(focusSurface);
  }
</script>

<style is:global>
  .keyboard-prototype-mobile-note { display:none; }
  .keyboard-prototype-dock { display:none; }

  @media (min-width: 1024px) {
    [data-keyboard-event-surface] {
      border-radius:1.2rem;
      outline:3px solid transparent;
      outline-offset:.5rem;
      transition:outline-color 140ms ease, box-shadow 140ms ease;
    }
    [data-keyboard-event-surface]:focus-visible {
      outline-color:#f4b942;
      box-shadow:0 0 0 .8rem rgba(244,185,66,.16);
    }
    [data-related-start] [data-event-card]:focus-visible,
    [data-related-start] [data-event-card]:has(:focus-visible) {
      outline:3px solid #f4b942;
      outline-offset:5px;
      box-shadow:0 12px 36px rgba(46,31,22,.2);
    }
    .keyboard-prototype-surface-hint {
      display:flex;
      flex-wrap:wrap;
      align-items:center;
      gap:.4rem;
      margin:1rem 0 0;
      color:#6d6259;
      font-size:.78rem;
      font-weight:700;
      letter-spacing:.01em;
    }
    .keyboard-prototype-surface-hint kbd,
    .keyboard-prototype-dock kbd {
      min-width:1.55rem;
      padding:.13rem .38rem;
      border:1px solid rgba(255,255,255,.26);
      border-radius:.38rem;
      background:#fffdf8;
      color:#35251c;
      box-shadow:0 1px 0 rgba(34,26,20,.2);
      font:700 .74rem/1.25 ui-monospace, SFMono-Regular, Menlo, monospace;
      text-align:center;
    }
    .keyboard-prototype-surface-hint kbd { border-color:#d8c8b6; }
    .keyboard-prototype-dock {
      position:fixed;
      right:1rem;
      bottom:1rem;
      z-index:80;
      display:grid;
      width:min(31rem, calc(100vw - 2rem));
      grid-template-columns:1fr auto;
      gap:.4rem .85rem;
      padding:.85rem 1rem;
      border:1px solid rgba(255,255,255,.14);
      border-radius:1rem;
      background:rgba(34,26,20,.94);
      color:#fffaf1;
      box-shadow:0 18px 50px rgba(25,16,10,.3);
      backdrop-filter:blur(14px);
    }
    .keyboard-prototype-dock strong { grid-column:1; font-size:.88rem; }
    .keyboard-prototype-dock p { grid-column:1; margin:0; color:#ddd0c2; font-size:.72rem; line-height:1.5; }
    .keyboard-prototype-dock button {
      grid-column:2;
      grid-row:1 / span 3;
      align-self:stretch;
      padding:.55rem .7rem;
      border:1px solid rgba(255,255,255,.22);
      border-radius:.65rem;
      background:#a54821;
      color:white;
      font:700 .74rem/1.25 inherit;
      cursor:pointer;
    }
    .keyboard-prototype-dock button:focus-visible { outline:3px solid #f4b942; outline-offset:3px; }
    .keyboard-prototype-dock__state {
      grid-column:1 / -1;
      overflow:hidden;
      color:#f4b942;
      font-size:.72rem;
      font-weight:750;
      text-overflow:ellipsis;
      white-space:nowrap;
    }
  }

  @media (max-width: 1023px) {
    .keyboard-prototype-mobile-note {
      display:block;
      max-width:34rem;
      margin:7rem auto 2rem;
      padding:1.25rem;
      border:1px solid #e1d3c2;
      border-radius:1rem;
      background:#fffdf8;
      color:#221a14;
      text-align:center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-keyboard-event-surface] { transition:none; }
  }
</style>
