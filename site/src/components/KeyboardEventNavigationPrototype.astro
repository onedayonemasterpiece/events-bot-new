<section class="keyboard-quickstart" data-keyboard-quickstart aria-labelledby="keyboard-quickstart-title">
  <div class="page-shell keyboard-quickstart__inner">
    <div>
      <p class="eyebrow">Попробуй быструю навигацию</p>
      <h2 id="keyboard-quickstart-title">Ищи следующее событие без мышки</h2>
      <p>Начни со стрелки вниз: она сразу выберет первое похожее событие. Дальше перемещайся по карточкам стрелками.</p>
    </div>
    <button type="button" class="keyboard-quickstart__start" data-keyboard-prototype-start>
      <span>Начать с похожих</span><kbd>↓</kbd>
    </button>
    <ul aria-label="Клавиши быстрой навигации">
      <li><kbd>← ↑ → ↓</kbd><span>выбирать события</span></li>
      <li><kbd>Enter</kbd><span>открыть</span></li>
      <li><kbd>L</kbd><span>лайк</span></li>
      <li><kbd>K</kbd><span>календарь</span></li>
      <li><kbd>S</kbd><span>поделиться</span></li>
      <li><kbd>Space</kbd><span>прокрутка</span></li>
    </ul>
  </div>
</section>

<p class="sr-only" id="keyboard-prototype-instructions">
  Быстрая навигация по событиям. Стрелка вниз переводит к похожим событиям.
  На карточках используйте стрелки для перехода между событиями. Пробел прокручивает страницу.
  Enter открывает событие или основное действие. L ставит лайк, K добавляет в календарь,
  S делится ссылкой. Стрелки влево и вправо в верхнем блоке листают фотографии.
</p>
<p class="sr-only" data-keyboard-prototype-status role="status" aria-live="polite" aria-atomic="true"></p>

<script is:inline>
  const root = document.querySelector('[data-desktop-clean-event]');
  const status = document.querySelector('[data-keyboard-prototype-status]');
  const startButton = document.querySelector('[data-keyboard-prototype-start]');

  const isVisible = (element) => {
    if (!(element instanceof HTMLElement) || element.hidden) return false;
    const rect = element.getBoundingClientRect();
    const style = window.getComputedStyle(element);
    return rect.width > 0 && rect.height > 0 && style.display !== 'none' && style.visibility !== 'hidden';
  };

  const surface = root instanceof HTMLElement
    ? Array.from(root.querySelectorAll('[data-desktop-action-panel]')).find(isVisible)
    : null;

  if (root instanceof HTMLElement && surface instanceof HTMLElement) {
    root.setAttribute('data-closed-hero-keyboard-scope', '');
    surface.tabIndex = 0;
    surface.setAttribute('data-keyboard-event-surface', '');
    surface.setAttribute('aria-describedby', 'keyboard-prototype-instructions');
    surface.setAttribute('aria-keyshortcuts', 'ArrowLeft ArrowRight ArrowDown Enter L K S');

    const primary = surface.querySelector('.desktop-prototype__primary-action:not(.is-disabled)');
    const shortcutTargets = [
      [primary, 'Enter'],
      [surface.querySelector('[data-calendar-action]:not(.desktop-prototype__primary-action)'), 'K'],
      [surface.querySelector('[data-native-share]'), 'S'],
      [surface.querySelector('[data-feedback-action="like"]'), 'L'],
    ];
    shortcutTargets.forEach(([target, key]) => {
      if (!(target instanceof HTMLElement) || target.querySelector('[data-keyboard-shortcut-badge]')) return;
      target.setAttribute('data-keyboard-shortcut-target', '');
      const badge = document.createElement('span');
      badge.className = 'keyboard-shortcut-badge';
      badge.dataset.keyboardShortcutBadge = '';
      badge.setAttribute('aria-hidden', 'true');
      badge.textContent = key;
      target.append(badge);
    });

    const cards = () => Array.from(root.querySelectorAll('[data-related-start] [data-event-card]')).filter(isVisible);
    const gallerySlides = Array.from(root.querySelectorAll('[data-hero-gallery-slide][data-gallery-slide-kind="image"]'));
    const heroImage = root.querySelector('[data-clean-hero-image]');
    const heroOpener = heroImage?.closest('[data-hero-gallery-open]');
    const heroStatus = root.querySelector('[data-closed-hero-status]');

    let statusTimer;
    const setStatus = (message) => {
      if (!(status instanceof HTMLElement)) return;
      window.clearTimeout(statusTimer);
      status.textContent = '';
      statusTimer = window.setTimeout(() => { status.textContent = message; }, 20);
    };

    const focusSurface = () => {
      surface.focus({ preventScroll: true });
      surface.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
    };

    const focusCard = (card) => {
      if (!(card instanceof HTMLElement)) return;
      card.focus({ preventScroll: true });
      card.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
    };

    const focusFirstCard = () => {
      const first = cards()[0];
      if (first) focusCard(first);
    };

    const rowsFor = (allCards) => {
      const rows = [];
      for (const card of allCards) {
        const rect = card.getBoundingClientRect();
        let row = rows.find((candidate) => Math.abs(candidate.top - rect.top) < 32);
        if (!row) {
          row = { top: rect.top, cards: [] };
          rows.push(row);
        }
        row.cards.push({ card, centerX: rect.left + rect.width / 2 });
      }
      rows.sort((a, b) => a.top - b.top);
      rows.forEach((row) => row.cards.sort((a, b) => a.centerX - b.centerX));
      return rows;
    };

    const verticalNeighbor = (current, direction, allCards) => {
      const rows = rowsFor(allCards);
      const rowIndex = rows.findIndex((row) => row.cards.some((entry) => entry.card === current));
      if (rowIndex < 0) return null;
      const targetRowIndex = rowIndex + direction;
      if (targetRowIndex < 0) return surface;
      const targetRow = rows[targetRowIndex];
      if (!targetRow) return null;
      const rect = current.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      return targetRow.cards.reduce((best, entry) => Math.abs(entry.centerX - centerX) < Math.abs(best.centerX - centerX) ? entry : best).card;
    };

    const actionFor = (scope, code) => {
      if (!(scope instanceof HTMLElement)) return null;
      if (code === 'KeyL') return scope.querySelector('[data-feedback-action="like"]');
      if (code === 'KeyK') return scope.querySelector('[data-calendar-action]');
      if (code === 'KeyS') return scope.querySelector('[data-native-share]');
      return null;
    };

    const actionLabel = (code) => ({ KeyL: 'Лайк', KeyK: 'Календарь', KeyS: 'Поделиться' })[code] || 'Действие';
    const runAction = (scope, event) => {
      const action = actionFor(scope, event.code);
      event.preventDefault();
      if (!(action instanceof HTMLElement)) {
        setStatus(`${actionLabel(event.code)}: действие недоступно для выбранного события.`);
        return;
      }
      action.click();
      setStatus(`${actionLabel(event.code)}: команда передана для выбранного события.`);
    };

    const selectHero = (direction) => {
      if (!(heroImage instanceof HTMLImageElement) || gallerySlides.length < 2) return false;
      const current = Number(root.dataset.activeHeroGalleryIndex || '0');
      const next = (current + direction + gallerySlides.length) % gallerySlides.length;
      const slide = gallerySlides[next];
      const image = slide?.querySelector('.hero-gallery__image[data-gallery-src]');
      const src = image?.dataset.gallerySrc;
      if (!(image instanceof HTMLImageElement) || !src) return false;
      root.dataset.activeHeroGalleryIndex = String(next);
      heroImage.src = src;
      heroImage.alt = image.alt || heroImage.alt;
      const width = Number(image.getAttribute('width') || 0);
      const height = Number(image.getAttribute('height') || 0);
      if (width) heroImage.width = width;
      if (height) heroImage.height = height;
      heroImage.style.objectPosition = image.dataset.objectPosition || '50% 50%';
      if (heroOpener instanceof HTMLElement) heroOpener.dataset.heroGalleryIndex = String(next);
      if (heroStatus instanceof HTMLElement) heroStatus.textContent = `Фото ${next + 1} из ${gallerySlides.length}`;
      return true;
    };

    const dialogIsOpen = () => [
      '[data-hero-gallery]:not([hidden])',
      '[data-efficient-viewer]:not([hidden])',
      '[role="dialog"]:not([hidden])',
    ].some((selector) => Array.from(document.querySelectorAll(selector)).some(isVisible));

    const isEditing = (target) => target instanceof HTMLElement && (
      target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
    );

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.isComposing || dialogIsOpen() || isEditing(event.target)) return;
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      if (target === surface || surface.contains(target)) {
        if (event.code === 'ArrowLeft' || event.code === 'ArrowRight') {
          if (selectHero(event.code === 'ArrowRight' ? 1 : -1)) event.preventDefault();
          return;
        }
        if (event.code === 'ArrowDown') {
          event.preventDefault();
          focusFirstCard();
          return;
        }
        if (event.code === 'Enter' && target === surface) {
          if (primary instanceof HTMLElement) {
            event.preventDefault();
            primary.click();
          }
          return;
        }
        if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) runAction(surface, event);
        return;
      }

      const current = target.closest('[data-related-start] [data-event-card]');
      if (!(current instanceof HTMLElement)) return;
      const allCards = cards();
      const index = allCards.indexOf(current);

      if (event.code === 'Escape' && target !== current) {
        event.preventDefault();
        focusCard(current);
        return;
      }
      if (['KeyL', 'KeyK', 'KeyS'].includes(event.code) && !event.repeat) {
        runAction(current, event);
        return;
      }
      if (event.code === 'Home' && allCards[0]) {
        event.preventDefault();
        focusCard(allCards[0]);
        return;
      }
      if (event.code === 'End' && allCards.at(-1)) {
        event.preventDefault();
        focusCard(allCards.at(-1));
        return;
      }
      if (event.code === 'ArrowLeft' || event.code === 'ArrowRight') {
        const neighbor = allCards[index + (event.code === 'ArrowLeft' ? -1 : 1)];
        if (neighbor) {
          event.preventDefault();
          focusCard(neighbor);
        }
        return;
      }
      if (event.code === 'ArrowUp' || event.code === 'ArrowDown') {
        const neighbor = verticalNeighbor(current, event.code === 'ArrowUp' ? -1 : 1, allCards);
        if (neighbor) {
          event.preventDefault();
          neighbor === surface ? focusSurface() : focusCard(neighbor);
        }
      }
    });

    startButton?.addEventListener('click', focusFirstCard);
    window.requestAnimationFrame(() => surface.focus({ preventScroll: true }));
  }
</script>

<style is:global is:inline>
  .keyboard-quickstart { display:none; }

  @media (min-width:1024px) {
    [data-keyboard-event-surface]:focus-visible {
      outline:2px solid rgba(244,185,66,.34);
      outline-offset:3px;
    }
    [data-related-start] [data-event-card]:focus-visible,
    [data-related-start] [data-event-card]:has(:focus-visible) {
      outline:3px solid #f4b942;
      outline-offset:5px;
      box-shadow:0 12px 36px rgba(46,31,22,.2);
    }
    [data-keyboard-shortcut-target] { position:relative; }
    .keyboard-shortcut-badge {
      position:absolute;
      right:5px;
      bottom:4px;
      z-index:2;
      min-width:14px;
      padding:1px 3px;
      border:1px solid currentColor;
      border-radius:4px;
      color:inherit;
      font:700 8px/1.15 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing:0;
      text-align:center;
      opacity:.46;
      pointer-events:none;
    }
    .keyboard-quickstart {
      display:block;
      padding:clamp(3rem,6vw,5.5rem) 0;
      border-top:1px solid rgba(255,255,255,.1);
      background:#241f1b;
      color:#fffaf2;
    }
    .keyboard-quickstart__inner {
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      gap:2rem 3rem;
      align-items:center;
    }
    .keyboard-quickstart .eyebrow { margin:0 0 .75rem; color:#d77a4f; font-weight:900; letter-spacing:.1em; text-transform:uppercase; }
    .keyboard-quickstart h2 { max-width:18ch; margin:0; font-size:clamp(2rem,3.6vw,4rem); line-height:.96; letter-spacing:-.045em; }
    .keyboard-quickstart h2 + p { max-width:60ch; margin:1rem 0 0; color:#cfc2b6; font-size:1rem; line-height:1.6; }
    .keyboard-quickstart__start {
      display:flex;
      align-items:center;
      gap:1rem;
      min-height:72px;
      padding:.8rem .9rem .8rem 1.25rem;
      border:0;
      border-radius:18px;
      background:#b54d22;
      color:white;
      font:900 1rem/1.1 inherit;
      cursor:pointer;
    }
    .keyboard-quickstart__start kbd { min-width:48px; padding:.65rem; border-radius:12px; background:#fffaf2; color:#2a211b; font-size:1.35rem; }
    .keyboard-quickstart ul { grid-column:1 / -1; display:flex; flex-wrap:wrap; gap:.65rem; margin:0; padding:0; list-style:none; }
    .keyboard-quickstart li { display:flex; align-items:center; gap:.5rem; color:#bfb1a5; font-size:.8rem; }
    .keyboard-quickstart li kbd {
      padding:.28rem .48rem;
      border:1px solid rgba(255,255,255,.18);
      border-radius:7px;
      background:#332c27;
      color:#fffaf2;
      box-shadow:0 2px 0 #171310;
      font:800 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    }
  }
</style>
