<div class="mobile-toast-region" data-mobile-toast-region aria-label="Уведомления" hidden>
  <div class="mobile-toast" data-mobile-toast data-kind="info">
    <p class="mobile-toast__message" data-mobile-toast-message></p>
    <div class="mobile-toast__controls">
      <button class="mobile-toast__action" data-mobile-toast-action type="button" hidden></button>
      <button class="mobile-toast__close" data-mobile-toast-close type="button" aria-label="Закрыть уведомление">×</button>
    </div>
    <span class="mobile-toast__countdown" data-mobile-toast-countdown aria-hidden="true"></span>
  </div>
</div>
<p class="sr-only" data-mobile-toast-status role="status" aria-live="polite" aria-atomic="true"></p>
<p class="sr-only" data-mobile-toast-alert role="alert" aria-live="assertive" aria-atomic="true"></p>

<script>
  type ToastKind = 'info' | 'success' | 'error';
  type ToastInput = string | {
    message:string; type?:ToastKind; dedupeKey?:string; duration?:number;
    action?:{ label:string; callback?:() => void } | null; announce?:boolean;
  };
  type ToastEntry = {
    id:number; message:string; type:ToastKind; dedupeKey:string; duration:number | null;
    action:{ label:string; callback?:() => void } | null; announce:boolean;
  };
  const host = window as typeof window & { KenigEventsToast?: { show:(input:ToastInput, options?:Partial<Exclude<ToastInput, string>>) => number; dismiss:() => void; clear:() => void } };
  const region = document.querySelector<HTMLElement>('[data-mobile-toast-region]');
  const toast = region?.querySelector<HTMLElement>('[data-mobile-toast]');
  const message = region?.querySelector<HTMLElement>('[data-mobile-toast-message]');
  const action = region?.querySelector<HTMLButtonElement>('[data-mobile-toast-action]');
  const close = region?.querySelector<HTMLButtonElement>('[data-mobile-toast-close]');
  const countdown = region?.querySelector<HTMLElement>('[data-mobile-toast-countdown]');
  const polite = document.querySelector<HTMLElement>('[data-mobile-toast-status]');
  const assertive = document.querySelector<HTMLElement>('[data-mobile-toast-alert]');
  if (region && toast && message && action && close && countdown && polite && assertive) {
    const controller = new AbortController();
    const { signal } = controller;
    const queue:ToastEntry[] = [];
    const pauseReasons = new Set<string>();
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const MAX_QUEUE = 4;
    let sequence = 0;
    let generation = 0;
    let current:ToastEntry | null = null;
    let timer = 0;
    let remaining = 0;
    let startedAt = 0;

    const clearTimer = () => { if (timer) clearTimeout(timer); timer = 0; };
    const announce = (entry:ToastEntry) => {
      polite.textContent = '';
      assertive.textContent = '';
      if (!entry.announce) return;
      const target = entry.type === 'error' ? assertive : polite;
      requestAnimationFrame(() => { if (current?.id === entry.id) target.textContent = entry.message; });
    };
    const setCountdown = (entry:ToastEntry) => {
      countdown.hidden = entry.duration === null;
      countdown.classList.remove('is-running', 'is-paused');
      countdown.style.setProperty('--mobile-toast-duration', `${remaining}ms`);
      if (entry.duration !== null && !reducedMotion.matches) {
        void countdown.offsetWidth;
        countdown.classList.add('is-running');
      }
      if (pauseReasons.size) countdown.classList.add('is-paused');
    };
    const dismiss = (expectedGeneration = generation) => {
      if (!current || expectedGeneration !== generation) return;
      clearTimer();
      current = null;
      region.hidden = true;
      countdown.classList.remove('is-running', 'is-paused');
      polite.textContent = '';
      assertive.textContent = '';
      renderNext();
    };
    const armTimer = () => {
      clearTimer();
      if (!current || current.duration === null || pauseReasons.size) return;
      startedAt = performance.now();
      const ownGeneration = generation;
      timer = window.setTimeout(() => dismiss(ownGeneration), remaining);
      countdown.classList.remove('is-paused');
    };
    const pause = (reason:string) => {
      if (pauseReasons.has(reason)) return;
      pauseReasons.add(reason);
      if (current?.duration !== null && timer) remaining = Math.max(0, remaining - (performance.now() - startedAt));
      clearTimer();
      countdown.classList.add('is-paused');
    };
    const resume = (reason:string) => {
      pauseReasons.delete(reason);
      if (!pauseReasons.size) armTimer();
    };
    const render = (entry:ToastEntry) => {
      generation += 1;
      current = entry;
      remaining = entry.duration || 0;
      region.hidden = false;
      toast.dataset.kind = entry.type;
      message.textContent = entry.message;
      action.hidden = !entry.action;
      action.textContent = entry.action?.label || '';
      setCountdown(entry);
      announce(entry);
      armTimer();
    };
    function renderNext() {
      const next = queue.shift();
      if (next) render(next);
    }
    const normalize = (input:ToastInput, options:Record<string, unknown> = {}):ToastEntry | null => {
      const source = typeof input === 'string' ? { message:input, ...options } : { ...input, ...options };
      const value = String(source.message || '').trim().replace(/\s+/gu, ' ');
      if (!value) return null;
      const type:ToastKind = ['success','error'].includes(String(source.type)) ? source.type as ToastKind : 'info';
      const rawAction = source.action && typeof source.action === 'object' ? source.action as ToastEntry['action'] : null;
      const normalizedAction = rawAction?.label ? { ...rawAction, label:String(rawAction.label).trim() } : null;
      const persistent = type === 'error' || Boolean(normalizedAction);
      return {
        id:++sequence, message:value, type,
        dedupeKey:String(source.dedupeKey || `${type}:${value}`),
        duration:persistent ? null : Math.max(1000, Number(source.duration) || 5000),
        action:normalizedAction, announce:source.announce !== false,
      };
    };
    const show = (input:ToastInput, options = {}) => {
      const entry = normalize(input, options as Record<string, unknown>);
      if (!entry) return 0;
      if (current?.dedupeKey === entry.dedupeKey) render(entry);
      else {
        const queuedIndex = queue.findIndex((item) => item.dedupeKey === entry.dedupeKey);
        if (queuedIndex >= 0) queue[queuedIndex] = entry;
        else if (!current) render(entry);
        else {
          queue.push(entry);
          if (queue.length > MAX_QUEUE) queue.shift();
        }
      }
      return entry.id;
    };
    const api = { show, dismiss:() => dismiss(), clear:() => { queue.length = 0; dismiss(); } };
    host.KenigEventsToast = api;
    window.addEventListener('kenigevents:toast', (event) => show((event as CustomEvent<ToastInput>).detail), { signal });
    close.addEventListener('click', () => dismiss(), { signal });
    action.addEventListener('click', () => { const callback = current?.action?.callback; dismiss(); callback?.(); }, { signal });
    region.addEventListener('pointerenter', () => pause('pointer'), { signal });
    region.addEventListener('pointerleave', () => resume('pointer'), { signal });
    region.addEventListener('focusin', () => pause('focus'), { signal });
    region.addEventListener('focusout', (event) => { if (!region.contains((event as FocusEvent).relatedTarget as Node | null)) resume('focus'); }, { signal });
    region.addEventListener('touchstart', () => pause('touch'), { passive:true, signal });
    region.addEventListener('touchend', () => resume('touch'), { passive:true, signal });
    region.addEventListener('touchcancel', () => resume('touch'), { passive:true, signal });
    window.addEventListener('blur', () => pause('window'), { signal });
    window.addEventListener('focus', () => resume('window'), { signal });
    document.addEventListener('visibilitychange', () => document.hidden ? pause('visibility') : resume('visibility'), { signal });
    document.querySelector('[data-mobile-discovery-menu]')?.addEventListener('toggle', (event) => {
      const open = (event.currentTarget as HTMLDetailsElement).open;
      region.classList.toggle('is-drawer-obscured', open);
      open ? pause('drawer') : resume('drawer');
    }, { signal });
    window.addEventListener('pagehide', () => {
      generation += 1; clearTimer(); queue.length = 0; current = null; controller.abort();
      if (host.KenigEventsToast === api) delete host.KenigEventsToast;
    }, { once:true, signal });
  }
</script>

<style is:global>
  .mobile-toast-region {
    position:fixed; z-index:60;
    top:calc(var(--mobile-top-chrome-bottom) + var(--mobile-header-handle-overhang, 24px) + 8px);
    left:max(12px,env(safe-area-inset-left)); right:max(12px,env(safe-area-inset-right));
    max-width:560px; margin-inline:auto; pointer-events:none;
  }
  .mobile-toast-region[hidden] { display:none; }
  .mobile-toast-region.is-drawer-obscured { opacity:0; visibility:hidden; }
  .mobile-toast { position:relative; min-height:56px; max-height:72px; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:8px; overflow:hidden; padding:8px 8px 8px 14px; border:1px solid var(--ke-color-toast-border); border-radius:var(--ke-toast-radius); background:var(--ke-color-toast-surface); color:var(--ke-color-toast-text); box-shadow:var(--ke-elevation-toast); pointer-events:auto; }
  .mobile-toast[data-kind="success"] { border-color:var(--ke-color-toast-success-border); }
  .mobile-toast[data-kind="error"] { border-color:var(--ke-color-toast-error-border); }
  .mobile-toast__message { min-width:0; max-height:2.7em; margin:0; overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; font-size:.88rem; font-weight:760; line-height:1.35; }
  .mobile-toast__controls { display:flex; align-items:center; }
  .mobile-toast__action,.mobile-toast__close { min-width:var(--ke-toast-control-size); min-height:var(--ke-toast-control-size); border:0; background:transparent; color:var(--ke-color-toast-action); font:850 .82rem/1 inherit; cursor:pointer; }
  .mobile-toast__close { font-size:var(--ke-toast-close-icon-size); font-weight:500; }
  .mobile-toast__countdown { position:absolute; left:0; right:0; bottom:0; height:3px; background:var(--ke-color-toast-progress); transform:scaleX(1); transform-origin:left; }
  .mobile-toast__countdown.is-running { animation:mobile-toast-retreat var(--mobile-toast-duration) linear forwards; }
  .mobile-toast__countdown.is-paused { animation-play-state:paused; }
  @keyframes mobile-toast-retreat { to { transform:scaleX(0); } }
  @media (prefers-reduced-motion:reduce) {
    .mobile-toast-region,.mobile-toast { transition:none!important; animation:none!important; }
    .mobile-toast__countdown { animation:none!important; transform:scaleX(1); }
  }
</style>
