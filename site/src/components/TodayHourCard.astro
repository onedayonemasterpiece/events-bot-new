---
import type { PreviewEvent } from '../lib/types';
import { eventHref, withBase } from '../lib/events';
import { eventImageUrl } from '../lib/assets';
import { getListingVenueMedallion } from '../lib/listingVenueMedallions';

interface Props { event: PreviewEvent }
const { event } = Astro.props;
const href = eventHref(event);
const imageUrl = eventImageUrl(event.image_url);
const primaryAsset = event.image_assets?.[0];
const rawRatio = primaryAsset?.width && primaryAsset?.height
  ? primaryAsset.width / primaryAsset.height
  : 0.75;
const ratio = Math.max(0.58, Math.min(2.35, rawRatio));
const medallion = getListingVenueMedallion(event);
const place = [event.venue_name, event.city].filter(Boolean).join(' · ');
const cardStyle = `--today-poster-ratio:${ratio.toFixed(5)}`;
const medallionFallbackSrc = medallion?.avatarUrl.endsWith('.webp')
  ? (medallion.fallbackPngUrl || medallion.avatarUrl)
  : medallion?.avatarUrl;
const medallionStyle = medallion
  ? [
      medallion.background ? `--venue-medallion-bg:${medallion.background}` : '',
      medallion.ring ? `--venue-medallion-ring:${medallion.ring}` : '',
    ].filter(Boolean).join(';')
  : undefined;
---
<article
  class="today-hour-card"
  style={cardStyle}
  data-today-hour-card
  data-event-id={event.id}
  data-image-text-mode={event.image_text_mode}
  data-venue-medallion={medallion?.slug}
>
  <a class="today-hour-card__media" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={event.image_alt || `Афиша события «${event.title}»`}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="today-hour-card__fallback" aria-hidden="true">{event.event_type || 'событие'}</span>
    )}
    {medallion ? (
      <span
        class="today-hour-card__medallion"
        style={medallionStyle}
        title={medallion.name}
        aria-label={medallion.ariaLabel}
      >
        <picture>
          {medallion.avatarUrl.endsWith('.webp') && medallion.fallbackPngUrl
            ? <source srcset={withBase(medallion.avatarUrl)} type="image/webp" />
            : null}
          <img src={withBase(medallionFallbackSrc || medallion.avatarUrl)} alt="" loading="lazy" decoding="async" />
        </picture>
      </span>
    ) : null}
  </a>
  <div class="today-hour-card__copy">
    <a class="today-hour-card__title" href={href} data-prefetch>{event.title}</a>
    {place ? <p>{place}</p> : null}
  </div>
</article>
