---
import {
  FOCUS_INTERESTS,
  FOCUS_STORAGE_KEY,
  type FocusRecommendation,
} from '../lib/focus-personalization';
import { eventHref, withBase } from '../lib/events';

interface Props {
  recommendations: FocusRecommendation[];
}

const { recommendations } = Astro.props;
const groups = ['Музыка', 'Культура', 'Город и досуг'] as const;
const clientInterests = FOCUS_INTERESTS.map(({ id, label, group }) => ({ id, label, group }));
const clientRecommendations = recommendations.map(({ event, interestIds }) => ({
  id: String(event.id),
  interestIds,
}));
const staticRecommendations = recommendations.slice(0, 3);
---

<section class="focus-product" data-focus-product>
  <div class="focus-product__notice" role="note">
    <span class="focus-product__prototype">Prototype</span>
    <p><strong>Работает только в этом браузере.</strong> Без аккаунта, сервера и скрытого профилирования.</p>
  </div>

  <section class="focus-consent" data-focus-consent aria-labelledby="focus-consent-title">
    <div class="focus-consent__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M7.5 10V7.5a4.5 4.5 0 0 1 9 0V10m-10 0h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M12 14v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </div>
    <div>
      <p class="focus-kicker">Сначала — ваше решение</p>
      <h2 id="focus-consent-title">Разрешить локальный профиль?</h2>
      <p>Прототип сохранит выбранные темы и реакции в <code>localStorage</code> этого устройства. Он ничего не отправляет в интернет и не использует онлайн‑ML.</p>
      <ul>
        <li>Вы видите и меняете каждый сигнал.</li>
        <li>Явный выбор не смешивается с индексом интереса и достаточностью данных.</li>
        <li>Профиль можно удалить одной кнопкой.</li>
      </ul>
      <label class="focus-consent__check">
        <input type="checkbox" data-focus-consent-check />
        <span>Понимаю: данные останутся только в этом браузере</span>
      </label>
      <button class="focus-button focus-button--primary" type="button" data-focus-consent-accept disabled>
        Разрешить локальный профиль
      </button>
      <p class="focus-status" data-focus-consent-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <div class="focus-workspace" data-focus-workspace hidden>
    <header class="focus-workspace__head">
      <div>
        <p class="focus-kicker">Ваши настройки</p>
        <h2>Что вам действительно интересно?</h2>
        <p>Для каждой темы выберите «Чаще», «Без предпочтения» или «Реже». Явный выбор главнее любых подсказок по реакциям.</p>
      </div>
      <button class="focus-button focus-button--quiet" type="button" data-focus-reset>Удалить локальный профиль</button>
    </header>

    <div class="focus-legend" aria-label="Как читать показатели">
      <div>
        <span class="focus-legend__swatch focus-legend__swatch--preference" aria-hidden="true"></span>
        <p><strong>Ваш выбор</strong> — только явное «Чаще», «Без предпочтения» или «Реже». Проценты к нему не приписываются.</p>
      </div>
      <div>
        <span class="focus-legend__swatch focus-legend__swatch--confidence" aria-hidden="true"></span>
        <p><strong>Индекс интереса</strong> — отдельная шкала по явным реакциям на карточки. Отсутствие реакции не считается неприязнью.</p>
      </div>
    </div>

    <div class="focus-groups">
      {groups.map((group) => (
        <section class="focus-group" aria-labelledby={`focus-group-${group.replaceAll(' ', '-')}`}>
          <div class="focus-group__head">
            <h3 id={`focus-group-${group.replaceAll(' ', '-')}`}>{group}</h3>
            <p>{group === 'Музыка' ? 'От камерного зала до клубной сцены' : group === 'Культура' ? 'Форматы для внимания и разговора' : 'Планы для города, области и выходного дня'}</p>
          </div>
          <div class="focus-interest-grid">
            {FOCUS_INTERESTS.filter((interest) => interest.group === group).map((interest) => (
              <article class="focus-interest" data-focus-interest={interest.id}>
                <div class="focus-interest__title">
                  <h4>{interest.label}</h4>
                </div>
                <p>{interest.description}</p>
                <fieldset class="focus-stance" data-focus-stance-group>
                  <legend>Ваш выбор</legend>
                  <label>
                    <input type="radio" name={`interest-${interest.id}`} value="like" data-focus-stance-input />
                    <span>Чаще</span>
                  </label>
                  <label>
                    <input type="radio" name={`interest-${interest.id}`} value="neutral" data-focus-stance-input checked />
                    <span>Без предпочтения</span>
                  </label>
                  <label>
                    <input type="radio" name={`interest-${interest.id}`} value="not-for-me" data-focus-stance-input />
                    <span>Реже</span>
                  </label>
                </fieldset>
                <dl class="focus-meters">
                  <div>
                    <dt>Ваш выбор</dt>
                    <dd><strong data-focus-preference-label>Без предпочтения</strong></dd>
                  </div>
                  <div>
                    <dt>Индекс интереса</dt>
                    <dd>
                      <meter min="0" max="100" value="50" data-focus-index-meter aria-label={`${interest.label}: индекс интереса`} hidden></meter>
                      <span data-focus-index-label>Пока недостаточно данных</span>
                    </dd>
                  </div>
                </dl>
                <details class="focus-interest__why">
                  <summary>Почему так?</summary>
                  <p data-focus-index-why>Пока нет реакций на карточки этой темы. Стартовое значение 50 нейтрально и не означает ни интереса, ни неприязни.</p>
                </details>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="focus-map" aria-labelledby="focus-map-title">
      <div class="focus-map__head">
        <div>
          <p class="focus-kicker">Понятная карта, не «облако»</p>
          <h2 id="focus-map-title">Сигналы профиля</h2>
          <p>Явный выбор показан словами. Непрерывная шкала относится только к вычисленному индексу, а достаточность данных — отдельной подписью.</p>
        </div>
        <p class="focus-map__summary" data-focus-summary>Пока нет выбранных тем.</p>
      </div>
      <div class="focus-map__rows" data-focus-map-rows role="list"></div>
    </section>

    <section class="focus-digest" aria-labelledby="focus-digest-title" data-focus-digest>
      <div>
        <p class="focus-kicker">Интерфейс / eligibility prototype</p>
        <h2 id="focus-digest-title">Автоматические персональные подборки</h2>
        <p>Это только макет управления допуском. Он ничего не отправляет, не создаёт рассылку и не связывается с сервером.</p>
      </div>
      <div class="focus-digest__panel">
        <p class="focus-digest__state" data-focus-digest-state>Выключено</p>
        <p data-focus-digest-eligibility>Для допуска нужны согласие, 3 явных сигнала темы (хотя бы один «Чаще») и 3 реакции на карточки.</p>
        <ul aria-label="Сигналы допуска">
          <li data-focus-digest-consent>Согласие: есть</li>
          <li data-focus-digest-explicit>Явные сигналы «Чаще/Реже»: 0 из 3</li>
          <li data-focus-digest-reactions>Реакции: 0 из 3</li>
        </ul>
        <button class="focus-button focus-button--primary" type="button" data-focus-digest-toggle disabled>
          Включить интерфейс подборок
        </button>
        <p class="focus-status" data-focus-digest-status role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="focus-recommendations" aria-labelledby="focus-recommendations-title">
      <div class="focus-recommendations__head">
        <div>
          <p class="focus-kicker">Объяснимый порядок</p>
          <h2 id="focus-recommendations-title">Можно попробовать</h2>
          <p>Это локальная сортировка ограниченного списка, а не предсказание вкуса. Реакции меняют только этот прототип.</p>
        </div>
        <button class="focus-button focus-button--quiet" type="button" data-focus-show-hidden hidden>Вернуть скрытые</button>
      </div>
      <div class="focus-recommendations__grid" data-focus-recommendations>
        {recommendations.map(({ event, interestIds, fallbackReason }) => (
          <article class="focus-rec" data-focus-rec={event.id} data-focus-rec-interests={interestIds.join(' ')}>
            <div class="focus-rec__meta">
              <span>{event.display_date}{event.display_time ? ` · ${event.display_time}` : ''}</span>
              <span>{event.event_type || 'Событие'}</span>
            </div>
            <h3><a href={eventHref(event)}>{event.title}</a></h3>
            <p class="focus-rec__place">{[event.city, event.venue_name].filter(Boolean).join(' · ') || 'Место уточняется'}</p>
            <div class="focus-rec__tags" aria-label="Темы рекомендации">
              {interestIds.map((id) => (
                <span>{FOCUS_INTERESTS.find((interest) => interest.id === id)?.label || id}</span>
              ))}
            </div>
            <details class="focus-why">
              <summary>Почему это</summary>
              <p data-focus-why>{fallbackReason}</p>
            </details>
            <fieldset class="focus-feedback">
              <legend>Как вам эта рекомендация?</legend>
              <button type="button" data-focus-rec-action="like" aria-pressed="false">Нравится</button>
              <button type="button" data-focus-rec-action="neutral" aria-pressed="false">Нейтрально</button>
              <button type="button" data-focus-rec-action="not-for-me" aria-pressed="false">Не для меня</button>
            </fieldset>
          </article>
        ))}
      </div>
      <p class="focus-status" data-focus-action-status role="status" aria-live="polite"></p>
    </section>
  </div>

  <noscript>
    <section class="focus-static" aria-labelledby="focus-static-title">
      <p class="focus-kicker">Статический режим</p>
      <h2 id="focus-static-title">Персонализация выключена</h2>
      <p>Без JavaScript профиль не создаётся и данные не сохраняются. Вот несколько общих вариантов без заявления о персональном соответствии.</p>
      <ul>
        {staticRecommendations.map(({ event }) => (
          <li>
            <a href={eventHref(event)}>{event.title}</a>
            <span>{event.display_date} · {[event.city, event.venue_name].filter(Boolean).join(' · ') || 'Место уточняется'}</span>
          </li>
        ))}
      </ul>
      <a class="focus-button focus-button--quiet" href={withBase('/populyarnoe/')}>Открыть общее популярное</a>
    </section>
  </noscript>
</section>

<script
  define:vars={{
    storageKey: FOCUS_STORAGE_KEY,
    interests: clientInterests,
    recommendationIndex: clientRecommendations,
  }}
>
  const root = document.querySelector('[data-focus-product]');
  if (!root) throw new Error('Focus personalization root is missing');

  const emptyState = () => ({
    version: 1,
    consent: false,
    interests: {},
    reactions: {},
    digestOptIn: false,
    updatedAt: null,
  });

  let state = emptyState();
  let storageAvailable = true;

  const readState = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(storageKey) || 'null');
      if (parsed?.version === 1 && parsed?.consent === true) {
        return {
          ...emptyState(),
          ...parsed,
          interests: parsed.interests || {},
          reactions: parsed.reactions || {},
        };
      }
    } catch (_) {
      storageAvailable = false;
    }
    return emptyState();
  };

  const persist = () => {
    state.updatedAt = new Date().toISOString();
    try {
      localStorage.setItem(storageKey, JSON.stringify(state));
    } catch (_) {
      storageAvailable = false;
      const status = root.querySelector('[data-focus-action-status]');
      if (status) status.textContent = 'Настройки работают до закрытия страницы: браузер запретил локальное сохранение.';
    }
  };

  const interestById = new Map(interests.map((interest) => [interest.id, interest]));
  const reactionWeight = { like: 1, neutral: 0, 'not-for-me': -1 };
  const stanceWeight = { like: 1, neutral: 0, 'not-for-me': -1 };

  const interestEvidence = (interestId) => {
    const matching = recommendationIndex.filter((item) => item.interestIds.includes(interestId));
    const reacted = matching.filter((item) => state.reactions[item.id]);
    const score = reacted.reduce((sum, item) => sum + reactionWeight[state.reactions[item.id]], 0);
    const index = reacted.length ? Math.round(50 + (score / reacted.length) * 50) : 50;
    const sufficiency = reacted.length >= 4 ? 'много данных' : reacted.length >= 2 ? 'достаточно данных' : 'мало данных';
    return { reacted: reacted.length, score, index, sufficiency };
  };

  const explicitScore = (interestId) => {
    const entry = state.interests[interestId];
    if (!entry?.selected) return 0;
    return (stanceWeight[entry.stance || 'neutral'] || 0) * 100;
  };

  const recommendationScore = (item) => {
    const explicit = item.interestIds.reduce((sum, id) => sum + explicitScore(id), 0);
    const reaction = reactionWeight[state.reactions[item.id]] || 0;
    return explicit - (reaction === -1 ? 1000 : 0) + (reaction === 1 ? 25 : 0);
  };

  const preferenceLabel = (stance, selected) => {
    if (!selected || stance === 'neutral') return 'Без предпочтения';
    return stance === 'like' ? 'Чаще' : 'Реже';
  };

  const renderInterest = (card) => {
    const id = card.dataset.focusInterest;
    const entry = state.interests[id] || { selected: false, stance: 'neutral' };
    const evidence = interestEvidence(id);
    card.querySelectorAll('[data-focus-stance-input]').forEach((input) => {
      input.checked = input.value === (entry.stance || 'neutral');
    });
    card.querySelector('[data-focus-preference-label]').textContent = preferenceLabel(entry.stance, entry.selected);
    const indexMeter = card.querySelector('[data-focus-index-meter]');
    indexMeter.value = evidence.index;
    indexMeter.hidden = evidence.reacted === 0;
    card.querySelector('[data-focus-index-label]').textContent = evidence.reacted
      ? `${evidence.index} из 100 · ${evidence.sufficiency}`
      : 'Пока недостаточно данных';
    card.querySelector('[data-focus-index-why]').textContent = evidence.reacted
      ? `Индекс рассчитан по ${evidence.reacted} ${evidence.reacted === 1 ? 'явной реакции' : 'явным реакциям'} на карточки с этой темой. Отсутствие реакции не учитывается. Ваш выбор «${preferenceLabel(entry.stance, entry.selected)}» имеет приоритет.`
      : 'Пока нет реакций на карточки этой темы. Стартовое значение 50 нейтрально и не означает ни интереса, ни неприязни.';
    card.dataset.selected = String(Boolean(entry.selected));
  };

  const renderMap = () => {
    const rows = root.querySelector('[data-focus-map-rows]');
    rows.replaceChildren();
    const chosen = interests
      .map((interest) => ({
        ...interest,
        entry: state.interests[interest.id],
        evidence: interestEvidence(interest.id),
      }))
      .filter((interest) => interest.entry?.selected || interest.evidence.reacted > 0)
      .sort((left, right) => Number(Boolean(right.entry?.selected)) - Number(Boolean(left.entry?.selected)) || right.evidence.reacted - left.evidence.reacted);

    root.querySelector('[data-focus-summary]').textContent = chosen.length
      ? `${chosen.filter((item) => item.entry?.selected).length} тем выбрано явно · ${Object.keys(state.reactions).length} реакций на карточки`
      : 'Пока нет выбранных тем или реакций.';

    if (!chosen.length) {
      const empty = document.createElement('p');
      empty.className = 'focus-map__empty';
      empty.textContent = 'Выберите тему выше или оцените рекомендацию — здесь появится объяснимая шкала.';
      rows.append(empty);
      return;
    }

    chosen.forEach((interest) => {
      const row = document.createElement('article');
      row.className = 'focus-map-row';
      row.setAttribute('role', 'listitem');
      const choice = preferenceLabel(interest.entry?.stance, interest.entry?.selected);
      const indexMarkup = interest.evidence.reacted
        ? `<span>Индекс интереса: ${interest.evidence.index} из 100</span>
           <meter min="0" max="100" value="${interest.evidence.index}" aria-label="${interest.label}: индекс интереса ${interest.evidence.index} из 100"></meter>`
        : '<span>Индекс интереса: пока недостаточно данных</span>';
      row.innerHTML = `
        <div class="focus-map-row__label">
          <strong>${interest.label}</strong>
          <span>Ваш выбор: ${choice}</span>
        </div>
        <div class="focus-map-row__index">
          ${indexMarkup}
        </div>
        <div class="focus-map-row__evidence">
          <strong>${interest.evidence.sufficiency}</strong>
          <span>${interest.evidence.reacted} ${interest.evidence.reacted === 1 ? 'реакция' : 'реакций'}; отсутствие не считается сигналом</span>
        </div>`;
      rows.append(row);
    });
  };

  const renderDigest = () => {
    const explicitOverrides = interests.filter((interest) => {
      const entry = state.interests[interest.id];
      return entry?.selected && entry.stance !== 'neutral';
    });
    const explicitCount = explicitOverrides.length;
    const hasPositive = explicitOverrides.some((interest) => state.interests[interest.id]?.stance === 'like');
    const reactionCount = Object.keys(state.reactions).length;
    const eligible = state.consent && explicitCount >= 3 && hasPositive && reactionCount >= 3;
    const panel = root.querySelector('[data-focus-digest]');
    const toggle = panel.querySelector('[data-focus-digest-toggle]');
    panel.querySelector('[data-focus-digest-explicit]').textContent = `Явные сигналы «Чаще/Реже»: ${Math.min(explicitCount, 3)} из 3${hasPositive ? ' · «Чаще» есть' : ' · нужен хотя бы один «Чаще»'}`;
    panel.querySelector('[data-focus-digest-reactions]').textContent = `Реакции: ${Math.min(reactionCount, 3)} из 3`;
    panel.querySelector('[data-focus-digest-eligibility]').textContent = eligible
      ? 'Сигналов достаточно для допуска интерфейса. Отправка всё равно не реализована.'
      : `Пока не хватает: ${Math.max(0, 3 - explicitCount)} явных сигналов темы, ${hasPositive ? 0 : 1} сигнала «Чаще» и ${Math.max(0, 3 - reactionCount)} реакций.`;
    panel.querySelector('[data-focus-digest-state]').textContent = state.digestOptIn
      ? 'Запрос включён · отправка не реализована'
      : 'Выключено';
    toggle.disabled = !eligible && !state.digestOptIn;
    toggle.textContent = state.digestOptIn ? 'Выключить и отписаться' : 'Включить интерфейс подборок';
  };

  const renderRecommendations = () => {
    const grid = root.querySelector('[data-focus-recommendations]');
    const cards = [...grid.querySelectorAll('[data-focus-rec]')];
    cards.sort((left, right) => {
      const leftItem = recommendationIndex.find((item) => item.id === left.dataset.focusRec);
      const rightItem = recommendationIndex.find((item) => item.id === right.dataset.focusRec);
      return recommendationScore(rightItem) - recommendationScore(leftItem);
    }).forEach((card) => {
      const id = card.dataset.focusRec;
      const reaction = state.reactions[id] || null;
      card.hidden = reaction === 'not-for-me';
      card.dataset.reaction = reaction || '';
      card.querySelectorAll('[data-focus-rec-action]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.focusRecAction === reaction));
      });
      const item = recommendationIndex.find((candidate) => candidate.id === id);
      const selectedMatches = item.interestIds
        .map((interestId) => interestById.get(interestId))
        .filter((interest) => state.interests[interest.id]?.selected);
      const why = card.querySelector('[data-focus-why]');
      if (selectedMatches.length) {
        why.textContent = `Совпало с вашим явным выбором: ${selectedMatches.map((interest) => interest.label).join(', ')}. Реакции влияют только на локальный порядок.`;
      } else if (Object.keys(state.interests).length) {
        why.textContent = 'Прямого совпадения с выбранными темами нет. Оставлено как вариант для исследования, а не как уверенное предсказание.';
      }
      grid.append(card);
    });
    const hiddenCount = cards.filter((card) => card.hidden).length;
    const showHidden = root.querySelector('[data-focus-show-hidden]');
    showHidden.hidden = hiddenCount === 0;
    showHidden.textContent = `Вернуть скрытые (${hiddenCount})`;
  };

  const render = () => {
    root.querySelectorAll('[data-focus-interest]').forEach(renderInterest);
    renderMap();
    renderDigest();
    renderRecommendations();
  };

  const consent = root.querySelector('[data-focus-consent]');
  const workspace = root.querySelector('[data-focus-workspace]');
  const showWorkspace = () => {
    consent.hidden = true;
    workspace.hidden = false;
    render();
  };

  state = readState();
  if (state.consent) showWorkspace();

  const consentCheck = root.querySelector('[data-focus-consent-check]');
  const consentAccept = root.querySelector('[data-focus-consent-accept]');
  consentCheck.addEventListener('change', () => {
    consentAccept.disabled = !consentCheck.checked;
  });
  consentAccept.addEventListener('click', () => {
    if (!consentCheck.checked) return;
    state.consent = true;
    persist();
    showWorkspace();
    root.querySelector('[data-focus-consent-status]').textContent = storageAvailable
      ? 'Локальный профиль включён.'
      : 'Профиль включён только до закрытия страницы: локальное хранилище недоступно.';
    workspace.querySelector('h2')?.focus?.();
  });

  root.addEventListener('change', (event) => {
    const card = event.target.closest('[data-focus-interest]');
    if (!card) return;
    const id = card.dataset.focusInterest;
    if (!event.target.matches('[data-focus-stance-input]')) return;
    state.interests[id] = { selected: true, stance: event.target.value };
    persist();
    render();
  });

  root.addEventListener('click', (event) => {
    const reactionButton = event.target.closest('[data-focus-rec-action]');
    if (reactionButton) {
      const card = reactionButton.closest('[data-focus-rec]');
      const id = card.dataset.focusRec;
      const action = reactionButton.dataset.focusRecAction;
      state.reactions[id] = state.reactions[id] === action ? null : action;
      if (!state.reactions[id]) delete state.reactions[id];
      persist();
      render();
      root.querySelector('[data-focus-action-status]').textContent = action === 'not-for-me'
        ? 'Карточка скрыта. Её можно вернуть кнопкой над списком.'
        : 'Реакция сохранена локально. Явные настройки интересов не изменены.';
      return;
    }

    if (event.target.closest('[data-focus-digest-toggle]')) {
      state.digestOptIn = !state.digestOptIn;
      persist();
      render();
      root.querySelector('[data-focus-digest-status]').textContent = state.digestOptIn
        ? 'Интерфейсный запрос сохранён локально. Никакая подборка не отправляется.'
        : 'Автоматические подборки выключены; локальный профиль остаётся.';
      return;
    }

    if (event.target.closest('[data-focus-show-hidden]')) {
      Object.keys(state.reactions).forEach((id) => {
        if (state.reactions[id] === 'not-for-me') delete state.reactions[id];
      });
      persist();
      render();
      root.querySelector('[data-focus-action-status]').textContent = 'Скрытые карточки возвращены.';
      return;
    }

    if (event.target.closest('[data-focus-reset]')) {
      try { localStorage.removeItem(storageKey); } catch (_) {}
      state = emptyState();
      workspace.hidden = true;
      consent.hidden = false;
      consentCheck.checked = false;
      consentAccept.disabled = true;
      root.querySelector('[data-focus-consent-status]').textContent = 'Локальный профиль удалён.';
      consentAccept.focus();
    }
  });
</script>

