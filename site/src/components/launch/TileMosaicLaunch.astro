---
interface Props {
  imageSrc?: string;
  imageMode?: 'brand' | 'cover';
  focalX?: number;
  focalY?: number;
}

const baseUrl = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${baseUrl.replace(/\/+$/u, '')}/${path.replace(/^\/+|\/+$/gu, '')}`;
const {
  imageSrc = withBase('/assets/launch/PWA-icon.png'),
  imageMode = 'brand',
  focalX = 0.5,
  focalY = 0.5,
} = Astro.props;

const normalizedFocalX = Math.min(1, Math.max(0, Number.isFinite(focalX) ? focalX : 0.5));
const normalizedFocalY = Math.min(1, Math.max(0, Number.isFinite(focalY) ? focalY : 0.5));
const tiles = Array.from({ length: 72 }, (_, index) => index);
---

<main class="launch" data-tile-mosaic-launch data-seed="20260901" data-image-mode={imageMode}>
  <header class="launch__header">
    <a class="launch__brand" href={withBase('/')} aria-label="Полюбить Калининград Анонсы — на главную">
      <img
        data-launch-brand-image
        src={withBase('/assets/launch/PWA-icon.png')}
        width="1254"
        height="1254"
        alt=""
      />
    </a>
    <p class="launch__status">СКОРО ЗАПУСК <span aria-hidden="true">•</span> 1 СЕНТЯБРЯ</p>
  </header>

  <div class="launch__layout">
    <section class="launch__copy" aria-labelledby="launch-title">
      <h1 id="launch-title"><span>Полюбить</span><span>Калининград</span><span>Анонсы</span></h1>
      <p class="launch__date"><time datetime="2026-09-01">1 СЕНТЯБРЯ</time></p>
      <p class="launch__description">
        <span>Персонализированный сервис анонсов</span>
        <span>и навигатор по культурным</span>
        <span>и просветительским событиям</span>
        <span>Калининградской области</span>
      </p>

      <form class="subscribe" data-launch-subscribe-form>
        <div class="subscribe__trap" aria-hidden="true">
          <label for="launch-company">Название компании</label>
          <input id="launch-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <label class="subscribe__label" for="launch-email">Email для напоминания о запуске</label>
        <div class="subscribe__row">
          <div class="subscribe__field">
            <svg class="subscribe__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.75 6.75h16.5v10.5H3.75zM4.5 7.5l7.5 5.75 7.5-5.75" />
            </svg>
            <input
              class="subscribe__input"
              id="launch-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="Ваш email"
              aria-describedby="launch-form-status launch-privacy"
              required
            />
          </div>
          <button class="subscribe__button" type="submit" data-idle-label="Сообщить мне">
            <span data-button-label>Сообщить мне</span>
          </button>
        </div>
        <p class="subscribe__status" id="launch-form-status" role="status" aria-live="polite"></p>
        <p class="subscribe__privacy" id="launch-privacy">
          Отправляя email, вы соглашаетесь получить одно письмо о запуске. Без спама.
        </p>
      </form>
    </section>

    <section
      class="mosaic"
      aria-label="Мозаичное изображение проекта"
      data-image-mode={imageMode}
      data-tile-size-contract="one-sixth-viewport-height"
      data-seam-policy="opaque"
    >
      <div class="mosaic__halo" aria-hidden="true"></div>
      <div class="mosaic__light" aria-hidden="true"></div>
      <div class="mosaic__grid" data-desktop-columns="12" data-mobile-columns="6" aria-hidden="true">
        <div class="mosaic__projection" data-projection-surface>
          <img
            class="mosaic__image"
            data-mosaic-image
            data-image-mode={imageMode}
            src={imageSrc}
            alt=""
            width="1254"
            height="1254"
            decoding="async"
            style={`object-position:${normalizedFocalX * 100}% ${normalizedFocalY * 100}%`}
          />
        </div>
        {tiles.map((index) => (
          <span
            class="mosaic__tile"
            data-tile-index={index}
            data-state="sleeping"
            style={`--tile-delay:${(index % 9) * -0.13}s;--tile-depth:${(index % 5) + 1}px;--rough-x:${17 + ((index * 37) % 68)}%;--rough-y:${13 + ((index * 29) % 74)}%`}
          ></span>
        ))}
      </div>
      <div class="mosaic__noise" aria-hidden="true"></div>
      <div class="mosaic__seams" data-opaque-seams aria-hidden="true"></div>
    </section>
  </div>
</main>

<script>
  import { getResilientDataClient } from '../../lib/resilientDataClient';

  const supabaseUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
  const supabaseRelayUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL || '').replace(/\/+$/u, '');
  const supabaseKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
  const siteBaseUrl = import.meta.env.BASE_URL || '/';

  (() => {
    const root = document.querySelector('[data-tile-mosaic-launch]');
    if (!(root instanceof HTMLElement)) return;

    const image = root.querySelector('[data-mosaic-image]');
    const mosaic = root.querySelector('.mosaic');
    const tileElements = Array.from(root.querySelectorAll('.mosaic__tile'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clampUnit = (value, fallback = 0.5) => {
      if (value === null || value === undefined || value === '') return fallback;
      const number = Number(value);
      return Number.isFinite(number) ? Math.min(1, Math.max(0, number)) : fallback;
    };

    const validImageUrl = (candidate) => {
      if (typeof candidate !== 'string' || !candidate.trim()) return null;
      try {
        const trimmed = candidate.trim();
        if (trimmed.startsWith('//')) return null;
        const absolute = /^[a-z][a-z\d+.-]*:/iu.test(trimmed);
        const previewBase = new URL(siteBaseUrl, window.location.origin);
        const parsed = absolute
          ? new URL(trimmed)
          : new URL(trimmed.replace(/^\/+/, ''), previewBase);
        const allowed = parsed.origin === window.location.origin || parsed.protocol === 'https:';
        const basePath = previewBase.pathname.replace(/\/+$/u, '');
        const staysInPreview = parsed.origin !== window.location.origin
          || !basePath
          || parsed.pathname === basePath
          || parsed.pathname.startsWith(`${basePath}/`);
        if (!allowed || !staysInPreview || parsed.username || parsed.password) return null;
        return parsed.href;
      } catch {
        return null;
      }
    };

    const normalizedMode = (value, fallback = 'cover') => value === 'brand' || value === 'cover' ? value : fallback;

    const setImage = ({ src, focalX, focalY, mode, imageMode: eventImageMode } = {}) => {
      if (!(image instanceof HTMLImageElement)) return false;
      const requestedMode = mode ?? eventImageMode;
      const hasSource = typeof src === 'string' && Boolean(src.trim());
      const safeSrc = hasSource ? validImageUrl(src) : null;
      if (hasSource && !safeSrc) return false;
      if (!hasSource && requestedMode !== 'brand' && requestedMode !== 'cover') return false;
      if (safeSrc) image.src = safeSrc;
      const x = clampUnit(focalX, 0.5);
      const y = clampUnit(focalY, 0.5);
      image.style.objectPosition = `${x * 100}% ${y * 100}%`;
      const nextMode = normalizedMode(requestedMode, safeSrc ? 'cover' : root.dataset.imageMode || 'brand');
      root.dataset.imageMode = nextMode;
      image.dataset.imageMode = nextMode;
      if (mosaic instanceof HTMLElement) mosaic.dataset.imageMode = nextMode;
      return true;
    };

    const query = new URLSearchParams(window.location.search);
    const queryMode = query.get('mosaicMode') || query.get('mosaicImageMode');
    if (query.has('mosaicImage')) {
      setImage({
        src: query.get('mosaicImage'),
        focalX: query.get('focalX'),
        focalY: query.get('focalY'),
        mode: queryMode,
      });
    } else if (queryMode) {
      setImage({ mode: queryMode, focalX: query.get('focalX'), focalY: query.get('focalY') });
    }
    window.addEventListener('tile-mosaic:set-image', (event) => {
      if (event instanceof CustomEvent) setImage(event.detail);
    });

    let seed = Number(root.dataset.seed) || 20260901;
    const random = () => {
      seed |= 0;
      seed = (seed + 0x6D2B79F5) | 0;
      let value = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
      return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
    };

    const initialStates = [
      ...Array(30).fill('sealed'),
      ...Array(11).fill('dim'),
      ...Array(9).fill('sleeping'),
      ...Array(19).fill('revealed'),
      ...Array(3).fill('glint'),
    ];
    for (let index = initialStates.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(random() * (index + 1));
      [initialStates[index], initialStates[swapIndex]] = [initialStates[swapIndex], initialStates[index]];
    }
    tileElements.forEach((tile, index) => {
      if (!(tile instanceof HTMLElement)) return;
      tile.dataset.state = initialStates[index];
    });

    const recent = new Map();
    let cycle = 0;
    let tileTimer = 0;
    let lightFrame = 0;
    let pointerX = 0.5;
    let pointerY = 0.45;
    let pointerInfluence = 0;

    const animateTiles = () => {
      cycle += 1;
      const candidates = tileElements.filter((_, index) => cycle - (recent.get(index) || -10) > 2);
      const changeCount = 1 + Math.floor(random() * 4);
      const states = tileElements.map((tile) => tile instanceof HTMLElement ? tile.dataset.state : 'sealed');
      let visibleCount = states.filter((state) => state === 'revealed' || state === 'glint').length;
      let glintCount = states.filter((state) => state === 'glint').length;

      for (let changed = 0; changed < changeCount && candidates.length; changed += 1) {
        const candidateIndex = Math.floor(random() * candidates.length);
        const tile = candidates.splice(candidateIndex, 1)[0];
        if (!(tile instanceof HTMLElement)) continue;
        const index = Number(tile.dataset.tileIndex);
        const chance = random();
        let nextState = chance < 0.42 ? 'sealed' : chance < 0.56 ? 'dim' : 'sleeping';
        if (chance >= 0.70 && visibleCount < Math.floor(tileElements.length * 0.32)) {
          nextState = chance > 0.965 && glintCount < 3 ? 'glint' : 'revealed';
          visibleCount += 1;
          if (nextState === 'glint') glintCount += 1;
        }
        tile.dataset.state = nextState;
        recent.set(index, cycle);
      }
      tileTimer = window.setTimeout(animateTiles, 1200 + random() * 1600);
    };

    const moveLight = (now) => {
      if (!(mosaic instanceof HTMLElement)) return;
      const autoX = 0.52 + Math.sin(now / 13200) * 0.26 + Math.cos(now / 9100) * 0.07;
      const autoY = 0.46 + Math.cos(now / 15800) * 0.24;
      pointerInfluence *= 0.985;
      const influence = Math.min(0.18, pointerInfluence);
      const lightX = autoX * (1 - influence) + pointerX * influence;
      const lightY = autoY * (1 - influence) + pointerY * influence;
      mosaic.style.setProperty('--light-x', `${lightX * 100}%`);
      mosaic.style.setProperty('--light-y', `${lightY * 100}%`);
      lightFrame = window.requestAnimationFrame(moveLight);
    };

    const startMotion = () => {
      window.clearTimeout(tileTimer);
      window.cancelAnimationFrame(lightFrame);
      if (reducedMotion.matches) {
        if (mosaic instanceof HTMLElement) {
          mosaic.style.setProperty('--light-x', '58%');
          mosaic.style.setProperty('--light-y', '38%');
        }
        return;
      }
      tileTimer = window.setTimeout(animateTiles, 1600);
      lightFrame = window.requestAnimationFrame(moveLight);
    };

    if (mosaic instanceof HTMLElement) {
      mosaic.addEventListener('pointermove', (event) => {
        if (reducedMotion.matches) return;
        const bounds = mosaic.getBoundingClientRect();
        pointerX = clampUnit((event.clientX - bounds.left) / bounds.width);
        pointerY = clampUnit((event.clientY - bounds.top) / bounds.height);
        pointerInfluence = 0.18;
      }, { passive: true });
      mosaic.addEventListener('pointerleave', () => { pointerInfluence = 0; }, { passive: true });
    }
    reducedMotion.addEventListener?.('change', startMotion);
    startMotion();

    const form = root.querySelector('[data-launch-subscribe-form]');
    if (!(form instanceof HTMLFormElement)) return;
    const emailInput = form.elements.namedItem('email');
    const honeypot = form.elements.namedItem('company');
    const button = form.querySelector('button[type="submit"]');
    const buttonLabel = form.querySelector('[data-button-label]');
    const status = form.querySelector('[role="status"]');

    const setFormState = (state, message = '') => {
      form.dataset.state = state;
      if (button instanceof HTMLButtonElement) {
        button.disabled = state === 'submitting';
        button.toggleAttribute('aria-busy', state === 'submitting');
      }
      if (emailInput instanceof HTMLInputElement) {
        emailInput.disabled = state === 'submitting';
        emailInput.setAttribute('aria-invalid', state === 'error' ? 'true' : 'false');
      }
      if (buttonLabel) buttonLabel.textContent = state === 'submitting' ? 'Отправляем…' : state === 'success' ? 'Готово' : 'Сообщить мне';
      if (status) status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(emailInput instanceof HTMLInputElement) || !emailInput.reportValidity()) return;
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        setFormState('success', 'Спасибо! Мы сообщим о запуске.');
        return;
      }

      const email = emailInput.value.trim().toLowerCase();
      if (!supabaseUrl || !supabaseKey) {
        setFormState('error', 'Подписка временно недоступна. Email сохранён в поле — попробуйте позже.');
        return;
      }

      setFormState('submitting', 'Отправляем email…');
      try {
        const dataClient = getResilientDataClient({
          directUrl: supabaseUrl,
          relayUrl: supabaseRelayUrl,
          publishableKey: supabaseKey,
        });
        const response = await dataClient.request(`${supabaseUrl}/rest/v1/rpc/subscribe_site_launch_v1`, {
          method: 'POST',
          headers: {
            apikey: supabaseKey,
            Authorization: `Bearer ${supabaseKey}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            p_email: email,
            p_source: 'tile-mosaic-launch',
            p_page_path: window.location.pathname,
            p_locale: document.documentElement.lang || 'ru',
          }),
        });
        if (!response.ok) {
          setFormState('error', response.status >= 400 && response.status < 500
            ? 'Проверьте email и попробуйте ещё раз.'
            : 'Не удалось подтвердить подписку. Email сохранён в поле — попробуйте позже.');
          return;
        }
        const result = await response.json().catch(() => null);
        const subscription = Array.isArray(result) ? result[0] : result;
        if (subscription?.accepted !== true || subscription?.status !== 'subscribed') {
          throw new Error('RPC response contract mismatch');
        }
        emailInput.value = '';
        setFormState('success', 'Готово! Напомним о запуске 1 сентября.');
      } catch {
        setFormState('error', 'Не удалось подтвердить подписку. Email сохранён в поле — попробуйте позже.');
      }
    });
  })();
</script>

<style>
  @property --tile-cover-alpha { syntax: '<number>'; inherits: true; initial-value: .72; }
  @property --tile-image-saturation { syntax: '<number>'; inherits: true; initial-value: .68; }
  @property --tile-image-brightness { syntax: '<number>'; inherits: true; initial-value: .66; }
  @property --tile-blur { syntax: '<length>'; inherits: true; initial-value: 2px; }
  @property --tile-glint-alpha { syntax: '<number>'; inherits: true; initial-value: .03; }
  @property --tile-edge-alpha { syntax: '<number>'; inherits: true; initial-value: .08; }

  .launch {
    --ink: #f3eee8;
    --copy: #aaa5a0;
    --ember: #e56f48;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 100svh;
    min-height: 760px;
    overflow: hidden;
    color: var(--ink);
    background:
      radial-gradient(ellipse 42% 70% at 7% 50%, rgb(88 49 32 / .21), transparent 68%),
      radial-gradient(ellipse 34% 56% at 30% 16%, rgb(105 54 34 / .12), transparent 70%),
      radial-gradient(circle at 66% 40%, rgb(107 42 24 / .12), transparent 35%),
      #07090a;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    isolation: isolate;
  }

  .launch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .2;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.012 .16' numOctaves='4' seed='37'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .launch *, .launch *::before, .launch *::after { box-sizing: border-box; }

  .launch__header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: clamp(28px, 4.25svh, 46px) clamp(34px, 4.2vw, 80px) 0;
    pointer-events: none;
  }

  .launch__brand {
    position: relative;
    display: block;
    width: clamp(118px, 8.4vw, 142px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 25%;
    background: #c84f30;
    box-shadow: 0 10px 32px rgb(0 0 0 / .38), 0 0 0 1px rgb(255 255 255 / .08);
    pointer-events: auto;
  }

  .launch__brand img {
    position: absolute;
    top: -8.5%;
    left: -8.5%;
    display: block;
    width: 117%;
    height: 117%;
    max-width: none;
    object-fit: cover;
  }

  .launch__brand:focus-visible { outline: 3px solid #f6c4ae; outline-offset: 5px; }

  .launch__status {
    margin: 5px 0 0;
    color: #d1cbc5;
    font-size: 11px;
    font-weight: 740;
    letter-spacing: .175em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .launch__status span { color: var(--ember); padding-inline: .25em; }

  .launch__layout { position: relative; z-index: 1; width: 100%; height: 100%; }

  .launch__copy {
    position: absolute;
    z-index: 12;
    top: clamp(162px, 22svh, 238px);
    left: 0;
    width: min(640px, 48vw);
    padding-left: clamp(34px, 4.2vw, 80px);
  }

  .launch h1 {
    display: flex;
    flex-direction: column;
    margin: 0;
    color: #f5f0eb;
    font-size: clamp(50px, 4.4vw, 86px);
    font-weight: 570;
    letter-spacing: -.057em;
    line-height: .89;
  }

  .launch h1 span { display: block; }

  .launch__date {
    margin: clamp(18px, 2.6svh, 28px) 0 0;
    color: var(--ember);
    font-size: clamp(13px, .9vw, 16px);
    font-weight: 810;
    letter-spacing: .19em;
    line-height: 1.2;
  }

  .launch__description {
    display: flex;
    flex-direction: column;
    margin: clamp(15px, 2.2svh, 23px) 0 0;
    color: var(--copy);
    font-size: clamp(14px, 1.02vw, 17px);
    font-weight: 430;
    letter-spacing: -.012em;
    line-height: 1.42;
  }

  .launch__description span { display: block; }

  .subscribe { position: relative; width: clamp(581px, 46.2vw, 649px); margin-top: clamp(18px, 2.5svh, 26px); }

  .subscribe__label,
  .subscribe__trap {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
  }

  .subscribe__row { display: flex; gap: 16px; width: 100%; }

  .subscribe__field {
    position: relative;
    min-width: 0;
    flex: 1 1 auto;
  }

  .subscribe__input,
  .subscribe__button { min-height: clamp(76px, 8.3svh, 80px); border-radius: 6px; font: inherit; }

  .subscribe__input {
    width: 100%;
    border: 1px solid rgb(255 255 255 / .15);
    padding: 0 16px 0 48px;
    color: #f8f2ec;
    background:
      linear-gradient(180deg, rgb(255 255 255 / .075), rgb(255 255 255 / .035)),
      rgb(19 18 18 / .72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .04), inset 0 -10px 28px rgb(0 0 0 / .13);
    outline: none;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .subscribe__icon {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 17px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #a79e96;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .subscribe__input::placeholder { color: #8d8781; }
  .subscribe__input:hover { border-color: rgb(255 255 255 / .27); }
  .subscribe__input:focus-visible {
    border-color: #e88a68;
    box-shadow: 0 0 0 3px rgb(229 111 72 / .2), inset 0 1px rgb(255 255 255 / .06);
  }
  .subscribe__input[aria-invalid="true"] { border-color: #ef9a8d; }

  .subscribe__button {
    flex: 0 0 clamp(245px, 18vw, 265px);
    border: 1px solid rgb(255 159 120 / .26);
    padding: 0 20px;
    color: #fff3ed;
    background:
      radial-gradient(circle at 72% 15%, rgb(255 194 163 / .1), transparent 32%),
      linear-gradient(180deg, #a9462d, #87331f);
    box-shadow: 0 11px 28px rgb(111 34 15 / .23), inset 0 1px rgb(255 255 255 / .16), inset 0 -1px rgb(0 0 0 / .28);
    font-weight: 720;
    cursor: pointer;
    touch-action: manipulation;
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }

  .subscribe__button:hover { filter: brightness(1.09); transform: translateY(-1px); }
  .subscribe__button:active { transform: translateY(1px); }
  .subscribe__button:focus-visible { outline: 3px solid rgb(255 229 216 / .82); outline-offset: 3px; }
  .subscribe__button:disabled { cursor: wait; filter: saturate(.55); opacity: .74; transform: none; }

  .subscribe__status { min-height: 18px; margin: 7px 0 0; color: #c9c2bb; font-size: 12px; line-height: 1.35; }
  .subscribe[data-state="success"] .subscribe__status { color: #a9d8b8; }
  .subscribe[data-state="error"] .subscribe__status { color: #f2a99f; }
  .subscribe__privacy { margin: 1px 0 0; color: #85807b; font-size: 11px; line-height: 1.38; }

  .mosaic {
    --light-x: 58%;
