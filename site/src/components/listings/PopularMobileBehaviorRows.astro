---
import type { PopularListingGroup } from '../../lib/listingPresentation';
import { cityKey } from '../../lib/listingPresentation';
import EventCard from '../EventCard.astro';

interface Props { groups: PopularListingGroup[]; }
const { groups } = Astro.props;
---
<div
  class="ke-popular-behavior ke-popular-behavior--mobile"
  data-ds-component="PopularMobileBehaviorRows"
  data-ds-version="4"
  data-popular-representation="mobile-large"
  data-popular-mobile-layout="large"
>
  {groups.map((group) => (
    <section
      class="ke-popular-behavior__group"
      data-popular-behavior-group
      data-popular-reason={group.key}
      aria-labelledby={`popular-mobile-large-${group.key}`}
    >
      <i class="ke-popular-behavior__sentinel" data-popular-group-sentinel aria-hidden="true"></i>
      <header class="ke-popular-behavior__head">
        <div class="ke-popular-behavior__head-label">
          <h2 id={`popular-mobile-large-${group.key}`}>{group.label}</h2>
          <span data-popular-group-count>{group.events.length}</span>
        </div>
      </header>
      <div class="ke-popular-behavior__row">
        {group.events.map((event) => (
          <div
            class="ke-popular-mobile-card-slot"
            data-listing-item
            data-event-id={event.id}
            data-listing-city={cityKey(event.city)}
            data-listing-event-type={cityKey(event.event_type || 'other')}
          >
            <EventCard event={event} variant="split-actions" />
          </div>
        ))}
      </div>
    </section>
  ))}
</div>
