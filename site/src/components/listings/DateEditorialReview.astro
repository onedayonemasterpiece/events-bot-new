---
import draft from '../../data/date-editorial-prototype.json';
import catalog from '../../data/preview-events.json';
import { eventHref, PREVIEW_BUILD_ID, SITE_MODE } from '../../lib/events';
import type { PreviewEvent } from '../../lib/types';
interface Props { date: string; events: PreviewEvent[]; }
const { date, events } = Astro.props;
const items = draft.items.map(item => ({ ...item, event: events.find(event => event.id === item.event_id) }));
const enabled = SITE_MODE === 'preview'
  && ['preview-islands-review-20260906','preview-islands-sequential-20260906'].includes(PREVIEW_BUILD_ID)
  && draft.source_snapshot === catalog.build.generated_at && date === draft.date
  && items.every(item => item.event);
---
{enabled && <aside class="date-editorial-prototype" data-date-editorial-prototype aria-labelledby="date-editorial-title">
  <p class="date-editorial-prototype__eyebrow">ИИ-обзор · пример</p>
  <h2 id="date-editorial-title">На что обратить внимание</h2>
  <p class="date-editorial-prototype__intro">Три идеи на 23 июля по всей области. Это альтернативы для вечера, а не маршрут: события начинаются в близкое время.</p>
  {items.map(({ event, lead, text }) => event && <p data-editorial-event-id={event.id}><strong>{lead}</strong> <a href={eventHref(event)}>{event.title}</a>. {text}</p>)}
  <p class="date-editorial-prototype__note">Пример текста, заранее подготовленного ИИ по историческому срезу афиши от 23 июля 2026. Обзор всей области не зависит от фильтра городов. Время, условия и билеты — на страницах событий.</p>
</aside>}
<style>
  .date-editorial-prototype {display:none;}
  @media(max-width:720px) {
    .date-editorial-prototype {display:block;margin:0 12px 24px;padding:22px 20px;border:1px solid #fff;border-radius:22px;background:#fffcf6;color:#241d17;box-shadow:0 8px 24px -14px #37251838;font:14px/1.65 var(--ke-font-family-sans,system-ui);}
    .date-editorial-prototype h2 {margin:6px 0 12px;font-size:25px;line-height:1.16;letter-spacing:-.5px;}
    .date-editorial-prototype p {margin:0 0 16px;}
    .date-editorial-prototype a {color:#a54821;text-decoration:underline;text-underline-offset:3px;}
    .date-editorial-prototype a:focus-visible {outline:2px solid #a54821;outline-offset:3px;}
    .date-editorial-prototype .date-editorial-prototype__eyebrow {margin:0;color:#8b4021;font-size:11px;font-weight:750;letter-spacing:.07em;text-transform:uppercase;}
    .date-editorial-prototype .date-editorial-prototype__intro {color:#786e64;}
    .date-editorial-prototype .date-editorial-prototype__note {margin:20px 0 0;padding-top:14px;border-top:1px solid #e8ded0;color:#786e64;font-size:11px;line-height:1.5;}
  }
</style>
