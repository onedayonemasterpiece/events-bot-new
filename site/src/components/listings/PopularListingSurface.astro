---
import type { PreviewEvent } from '../../lib/types';
import {
  buildPopularDesktopListing,
  buildPopularDesktopPersonalizationCandidates,
  buildPopularListingGroups,
  deduplicateListingEvents,
  eventCountLabel,
} from '../../lib/listingPresentation';
import ListingDiscoveryRail from './ListingDiscoveryRail.astro';
import ListingPageHeader from './ListingPageHeader.astro';
import PopularBehaviorRows from './PopularBehaviorRows.astro';
import PopularMobileBehaviorRows from './PopularMobileBehaviorRows.astro';
import PopularMobileAdaptiveRows from './PopularMobileAdaptiveRows.astro';
import ListingMobileDensitySwitch from './ListingMobileDensitySwitch.astro';
import PopularMobileGroupContext from './PopularMobileGroupContext.astro';
import PopularPersonalizedRow from './PopularPersonalizedRow.astro';
import MobileListingRailSurface from './MobileListingRailSurface.astro';
import { collapseOccurrenceCards } from '../../lib/eventOccurrences';

interface Props { events: PreviewEvent[]; desktopEvents: PreviewEvent[]; }
const events = deduplicateListingEvents(Astro.props.events);
const groups = buildPopularListingGroups(events, 5);
const desktop = buildPopularDesktopListing(Astro.props.desktopEvents, 5);
const desktopPersonalizationCandidates = buildPopularDesktopPersonalizationCandidates(
  Astro.props.desktopEvents,
  desktop.allocatedFamilyKeys,
  30,
);
const visibleEvents = groups.flatMap((group) => group.events);
const mobileFamilyGroups = groups.map((group) => ({
  ...group,
  events: collapseOccurrenceCards(group.events, 'per-family'),
}));
const mobileFamilyEvents = mobileFamilyGroups.flatMap((group) => group.events);
const popularGroupSubtitles = {
  fast_growth: 'Сильнее всего растут реакции',
  multi_source: 'Встречаются в нескольких источниках',
  discussed: 'На них активнее реагируют',
  frequently_shared: 'Ими чаще делятся',
  score_fallback: 'Популярное по совокупности сигналов',
} as const;
const cities = [...new Set(visibleEvents.map((event) => event.city || 'Калининградская область'))]
  .map((name) => ({ name, count: visibleEvents.filter((event) => (event.city || 'Калининградская область') === name).length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name, 'ru'));
---
<div
  class="ke-listing-shell ke-popular-listing"
  data-ds-family="PopularListingSurface"
  data-ds-version="1"
  data-ds-variant="social-signal-groups"
  data-ds-state={visibleEvents.length ? 'populated' : 'empty'}
  data-date-listing="popular"
  data-listing-variant="POPULAR-V26"
  data-desktop-popular-version="V28"
  data-mobile-card-density="large"
>
  <script is:inline>
    try {
      const surface = document.currentScript.closest('[data-date-listing="popular"]');
      const saved = window.localStorage.getItem('ke_listing_density_v2');
      if (surface && (saved === 'large' || saved === 'adaptive')) surface.dataset.mobileCardDensity = saved;
    } catch {}
  </script>
  <ListingPageHeader title="Популярное" dateLabel="По реакции аудитории" count={visibleEvents.length} current="popular" />
  <ListingDiscoveryRail cities={cities} total={visibleEvents.length} label="популярное" hasTime={false} />
  <div class="ke-popular-desktop" data-popular-representation="desktop">
    <PopularBehaviorRows groups={desktop.groups}>
      <PopularPersonalizedRow events={desktopPersonalizationCandidates} />
    </PopularBehaviorRows>
  </div>
  <MobileListingRailSurface
    sections={mobileFamilyGroups.map((group) => ({
      id:`popular-${group.key}`,
      title:group.label,
      subtitle:popularGroupSubtitles[group.key],
      events:group.events,
    }))}
    occurrenceMode="per-family"
    title="Популярное"
    meta={`По реакции аудитории · ${mobileFamilyEvents.length} ${eventCountLabel(mobileFamilyEvents.length)}`}
    feedTitle="По реакции аудитории"
    feedMeta="Категории сменяют друг друга"
    current="popular"
    cities={cities}
  />
  <div class="ke-popular-mobile-existing" aria-hidden="true" inert>
    <PopularMobileBehaviorRows groups={groups} />
    <PopularMobileAdaptiveRows groups={groups} />
    <PopularMobileGroupContext />
  </div>
  <div class="ke-listing-empty" data-listing-no-events hidden={visibleEvents.length > 0}>
    <strong>Пока нет событий с подтверждённой активностью</strong>
  </div>
  <ListingMobileDensitySwitch />
</div>