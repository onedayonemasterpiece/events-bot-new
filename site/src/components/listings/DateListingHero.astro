---
import type { DateListingHeroSelection } from '../../lib/dateListingHero';
import { createDateHeroTileSchedule } from '../../lib/dateListingHero';
import { eventHref } from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';

interface Props {
  selection: DateListingHeroSelection;
  date: string;
}

const { selection, date } = Astro.props;
const { event, asset } = selection;
const src = eventImageUrl(asset.src);
const focalX = Math.max(0, Math.min(1, Number(asset.focal_point?.x ?? .5)));
const focalY = Math.max(0, Math.min(1, Number(asset.focal_point?.y ?? .5)));
const tiles = createDateHeroTileSchedule(`${date}:${event.id}:${asset.asset_key || asset.src}`);
const dateLabel = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Kaliningrad',
}).format(new Date(`${date}T12:00:00+02:00`));
---

{src && (
  <a
    class="date-listing-hero"
    data-date-listing-hero
    data-event-id={event.id}
    data-source-width={asset.width}
    data-source-height={asset.height}
    data-focus-x={focalX}
    data-focus-y={focalY}
    data-face-boxes={JSON.stringify(asset.face_boxes || [])}
    data-parallax="true"
    style={`--date-hero-focal-x:${focalX * 100}%;--date-hero-focal-y:${focalY * 100}%`}
    href={eventHref(event)}
    aria-label={`Открыть событие «${event.title}» на ${dateLabel}`}
  >
    <img
      class="date-listing-hero__preload"
      data-date-listing-hero-image
      src={src}
      width={asset.width}
      height={asset.height}
      alt=""
      loading="eager"
      decoding="async"
    />
    <span class="date-listing-hero__tiles" aria-hidden="true">
      {tiles.map((tile) => (
        <span
          class="date-listing-hero__tile"
          data-date-listing-hero-tile
          data-col={tile.col}
          data-row={tile.row}
          data-exit-start={tile.exitStart}
          data-exit-end={tile.exitEnd}
          style={`--base-alpha:${tile.baseAlpha};--entry-delay:${tile.entryDelay}ms;--entry-duration:${tile.entryDuration}ms`}
        ></span>
      ))}
    </span>
  </a>
)}

<style is:global>
  @media (max-width:720px) {
    body.mobile-shell-reference4[data-mobile-bottom-mode="nav"]:has(.ke-mobile-listing-rails--v23 .date-listing-hero) > main.ke-listing-page {
      padding-top:64px;
    }
    .ke-mobile-listing-rails--v23 .page-head:has(.date-listing-hero) {
      position:relative;
      isolation:isolate;
      height:148px;
      overflow:visible;
    }
    .ke-mobile-listing-rails--v23 .page-head:has(.date-listing-hero) h1,
    .ke-mobile-listing-rails--v23 .page-head:has(.date-listing-hero) > p {
      position:relative;
      z-index:2;
      max-width:72%;
      pointer-events:none;
      text-shadow:0 1px 0 #fbf7ef, 0 0 12px #fbf7ef;
    }
    .date-listing-hero {
      position:absolute;
      z-index:1;
      top:-64px;
      right:0;
      width:min(calc(100vw - 18px),372px);
      aspect-ratio:372/202;
      overflow:hidden;
      color:inherit;
      text-decoration:none;
      contain:layout paint;
      transform:translate3d(0,0,0);
      -webkit-tap-highlight-color:transparent;
    }
    .date-listing-hero:focus-visible {
      outline:3px solid #0f766e;
      outline-offset:-4px;
      border-radius:6px;
    }
    .date-listing-hero__preload {
      position:absolute;
      width:1px;
      height:1px;
      opacity:0;
      pointer-events:none;
    }
    .date-listing-hero__tiles {
      position:absolute;
      inset:0;
      display:grid;
      grid-template-columns:repeat(11,1fr);
      grid-template-rows:repeat(6,1fr);
      gap:2px;
    }
    .date-listing-hero__tile {
      position:relative;
      overflow:hidden;
      opacity:0;
    }
    .date-listing-hero__tile::before {
      content:"";
      position:absolute;
      left:var(--tile-image-left);
      top:var(--tile-image-top);
      width:var(--mosaic-render-width);
      height:var(--mosaic-render-height);
      background-image:var(--date-hero-image);
      background-repeat:no-repeat;
      background-size:100% 100%;
      filter:saturate(.9) contrast(1.02);
    }
    .date-listing-hero.is-entering .date-listing-hero__tile {
      animation:date-listing-hero-in var(--entry-duration) cubic-bezier(.65,0,.35,1) var(--entry-delay) both;
    }
    .date-listing-hero.is-present .date-listing-hero__tile {
      opacity:var(--render-alpha,var(--base-alpha));
    }
    @keyframes date-listing-hero-in { from { opacity:0; } to { opacity:var(--render-alpha,var(--base-alpha)); } }
  }
  @media (min-width:721px) { .date-listing-hero { display:none; } }
  @media (prefers-reduced-motion:reduce) {
    .date-listing-hero { transform:none!important; }
    .date-listing-hero.is-present .date-listing-hero__tile {
      opacity:var(--render-alpha,var(--base-alpha))!important;
      animation:none!important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-date-listing-hero]').forEach((hero) => {
    if (hero.dataset.ready === 'true') return;
    hero.dataset.ready = 'true';
    const image = hero.querySelector<HTMLImageElement>('[data-date-listing-hero-image]');
    const tiles = [...hero.querySelectorAll<HTMLElement>('[data-date-listing-hero-tile]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let geometryWidth = 0;
    let endY = 1;
    let frame = 0;
    let randoms: Uint32Array | null = null;

    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const smooth = (value: number) => value * value * (3 - 2 * value);
    const ensureSchedule = () => {
      if (randoms) return randoms;
      randoms = new Uint32Array(tiles.length);
      try { crypto.getRandomValues(randoms); }
      catch { randoms = Uint32Array.from(tiles, () => Math.floor(Math.random() * 0xffffffff)); }
      const order = [...tiles.keys()].sort((left, right) => randoms![left] - randoms![right]);
      order.forEach((tileIndex, rank) => {
        const tile = tiles[tileIndex];
        const unit = randoms![tileIndex] / 0xffffffff;
        const start = .03 + rank / Math.max(1, tiles.length - 1) * .72;
        const duration = .16 + unit * .13;
        tile.dataset.exitStart = String(start);
        tile.dataset.exitEnd = String(Math.min(.98, start + duration));
        tile.style.setProperty('--entry-delay', `${35 + Math.round(unit * 720)}ms`);
        tile.style.setProperty('--entry-duration', `${260 + Math.round(((randoms![(tileIndex + 17) % tiles.length] / 0xffffffff)) * 340)}ms`);
      });
      hero.dataset.loadSeed = String(randoms[0] || 0);
      return randoms;
    };
    const measureEnd = () => {
      const surface = hero.closest('[data-mobile-listing-rails]');
      const firstRow = surface?.querySelector<HTMLElement>('[data-mobile-listing-row]');
      const brandBottom = document.querySelector<HTMLElement>('.site-header')?.getBoundingClientRect().bottom || 64;
      endY = Math.max(1, firstRow ? window.scrollY + firstRow.getBoundingClientRect().top - brandBottom : 160);
      hero.dataset.heroEndY = String(endY);
    };
    const configure = () => {
      if (!image?.naturalWidth) return;
      const rect = hero.getBoundingClientRect();
      const sourceWidth = Number(hero.dataset.sourceWidth);
      const sourceHeight = Number(hero.dataset.sourceHeight);
      const focusX = Number(hero.dataset.focusX || .5);
      const focusY = Number(hero.dataset.focusY || .5);
      const schedule = ensureSchedule();
      let faceBoxes: Array<{ x:number; y:number; w:number; h:number }> = [];
      try { faceBoxes = JSON.parse(hero.dataset.faceBoxes || '[]'); } catch { faceBoxes = []; }
      if (!rect.width || !rect.height || !sourceWidth || !sourceHeight) return;
      const scale = Math.max(rect.width / sourceWidth, rect.height / sourceHeight);
      const renderWidth = sourceWidth * scale;
      const renderHeight = sourceHeight * scale;
      const offsetX = (rect.width - renderWidth) * focusX;
      const offsetY = (rect.height - renderHeight) * focusY;
      let cropSafe = true;
      const projectedFaces = faceBoxes.map((box) => {
        const padX = Math.max(.012, Math.min(.04, box.w * .12));
        const padY = Math.max(.012, Math.min(.04, box.h * .12));
        const projected = {
          left: offsetX + Math.max(0, box.x - padX) * renderWidth,
          top: offsetY + Math.max(0, box.y - padY) * renderHeight,
          right: offsetX + Math.min(1, box.x + box.w + padX) * renderWidth,
          bottom: offsetY + Math.min(1, box.y + box.h + padY) * renderHeight,
        };
        if (projected.left < -.5 || projected.top < -.5 || projected.right > rect.width + .5 || projected.bottom > rect.height + .5) cropSafe = false;
        return projected;
      });
      if (faceBoxes.length && !cropSafe) {
        hero.remove();
        return;
      }
      hero.style.setProperty('--date-hero-image', `url("${image.currentSrc || image.src}")`);
      hero.style.setProperty('--date-hero-focal-x', `${focusX * 100}%`);
      hero.style.setProperty('--date-hero-focal-y', `${focusY * 100}%`);
      hero.style.setProperty('--mosaic-render-width', `${renderWidth}px`);
      hero.style.setProperty('--mosaic-render-height', `${renderHeight}px`);
      const textRects = [
        hero.closest('.page-head')?.querySelector('h1'),
        hero.closest('.page-head')?.querySelector('p'),
      ].filter(Boolean).map((node) => (node as Element).getBoundingClientRect());
      tiles.forEach((tile, index) => {
        const tileRect = tile.getBoundingClientRect();
        tile.style.setProperty('--tile-image-left', `${offsetX - (tileRect.left - rect.left)}px`);
        tile.style.setProperty('--tile-image-top', `${offsetY - (tileRect.top - rect.top)}px`);
        const local = {
          left: tileRect.left - rect.left,
          top: tileRect.top - rect.top,
          right: tileRect.right - rect.left,
          bottom: tileRect.bottom - rect.top,
        };
        const faceShield = projectedFaces.some((box) => (
          Math.min(local.right, box.right) - Math.max(local.left, box.left) > 1
          && Math.min(local.bottom, box.bottom) - Math.max(local.top, box.top) > 1
        ));
        const textShield = textRects.some((box) => (
          Math.min(tileRect.right, box.right) - Math.max(tileRect.left, box.left) > 1
          && Math.min(tileRect.bottom, box.bottom) - Math.max(tileRect.top, box.top) > 1
        ));
        const unit = schedule[index] / 0xffffffff;
        const col = Number(tile.dataset.col);
        let alpha = Number(tile.style.getPropertyValue('--base-alpha') || 0) * (.78 + unit * .44) + (unit - .5) * .20;
        if (faceShield) alpha = Math.max(alpha, .56);
        if (col < 2) alpha = Math.min(alpha, .06);
        if (textShield) alpha = Math.min(alpha, .04);
        alpha = Math.max(0, Math.min(.92, alpha));
        tile.toggleAttribute('data-face-shield', faceShield);
        tile.toggleAttribute('data-text-shield', textShield);
        tile.style.setProperty('--base-alpha', String(alpha));
        tile.style.setProperty('--render-alpha', String(alpha));
      });
      geometryWidth = window.innerWidth;
      hero.toggleAttribute('data-tiles-ready', true);
      if (!reduced) {
        hero.classList.add('is-entering');
        const budget = Math.max(...tiles.map((tile) => (
          Number.parseFloat(getComputedStyle(tile).getPropertyValue('--entry-delay'))
          + Number.parseFloat(getComputedStyle(tile).getPropertyValue('--entry-duration'))
        )), 0) + 30;
        window.setTimeout(() => {
          hero.classList.remove('is-entering');
          hero.classList.add('is-present');
          render();
        }, budget);
      } else {
        hero.classList.add('is-present');
      }
      measureEnd();
      render();
    };
    const render = () => {
      frame = 0;
      if (reduced) return;
      const progress = clamp(window.scrollY / endY);
      const exitProgress = clamp(progress + .2 * progress * (1 - progress));
      tiles.forEach((tile) => {
        const start = Number(tile.dataset.exitStart);
        const end = Number(tile.dataset.exitEnd);
        const local = smooth(clamp((exitProgress - start) / Math.max(.001, end - start)));
        const alpha = Number(tile.style.getPropertyValue('--base-alpha') || 0) * (1 - local);
        tile.style.opacity = String(alpha);
        tile.style.setProperty('--render-alpha', String(alpha));
      });
      hero.style.visibility = progress >= 1 ? 'hidden' : 'visible';
      hero.style.transform = `translate3d(0,${window.scrollY * .28}px,0)`;
    };
    const queueRender = () => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };
    const ready = () => {
      configure();
      if (!reduced) {
        document.addEventListener('scroll', queueRender, { passive:true });
        window.addEventListener('resize', () => {
          if (window.innerWidth !== geometryWidth) configure();
          else {
            measureEnd();
            queueRender();
          }
        }, { passive:true });
      }
    };
    if (image?.complete && image.naturalWidth) ready();
    else image?.addEventListener('load', ready, { once:true });
  });
</script>
