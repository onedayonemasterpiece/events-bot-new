---
import { getAvailableWeekendRanges, getEvents, getWeekendRange, withBase } from '../../lib/events';
import { buildEventDateAvailability } from '../../lib/eventDateAvailability';

interface Props {
  today: string;
  selectedDate: string;
  current: 'today' | 'tomorrow' | 'weekend' | 'date';
  weekendEnd?: string;
}
const { today, selectedDate, current, weekendEnd = '' } = Astro.props;
const DAY = 86_400_000;
const parseDate = (value: string) => new Date(`${value}T12:00:00Z`);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const tomorrow = isoDate(new Date(parseDate(today).getTime() + DAY));
const currentWeekendStart = getWeekendRange().start;
const availableWeekendStarts = new Set(getAvailableWeekendRanges().map((range) => range.start));
const availability = buildEventDateAvailability(getEvents(), today);
const dates = availability.allDates.map((iso) => {
  const date = parseDate(iso);
  const weekday = new Intl.DateTimeFormat('ru-RU', { weekday:'short', timeZone:'Europe/Kaliningrad' })
    .format(date).replace('.', '').toLocaleUpperCase('ru-RU');
  const day = date.getUTCDate();
  const month = new Intl.DateTimeFormat('ru-RU', { month:'short', timeZone:'Europe/Kaliningrad' })
    .format(date).replace('.', '').toLocaleUpperCase('ru-RU');
  const monthLong = new Intl.DateTimeFormat('ru-RU', { month:'long', year:'numeric', timeZone:'Europe/Kaliningrad' })
    .format(date);
  const monthKey = iso.slice(0, 7);
  const isSaturday = date.getUTCDay() === 6;
  const isSunday = date.getUTCDay() === 0;
  const nextDate = new Date(date.getTime() + DAY);
  const hasEvents = availability.availableDates.has(iso);
  const weekendAvailable = isSaturday && availableWeekendStarts.has(iso);
  const href: string | null = !hasEvents
    ? null
    : iso === today
      ? '/segodnya/'
      : iso === tomorrow
        ? '/zavtra/'
        : weekendAvailable
          ? (iso === currentWeekendStart ? '/vyhodnye/' : `/vyhodnye/${iso}/`)
          : `/date-${iso}/`;
  return {
    iso,
    weekday,
    day,
    month,
    monthLong,
    monthKey,
    href,
    hasEvents,
    isSaturday,
    isSunday,
    isWeekendRange: weekendAvailable,
    rangeLabel: weekendAvailable ? `${day}–${nextDate.getUTCDate()}` : String(day),
    selected: iso === selectedDate,
  };
});
const monthGroups = [...new Set(dates.map((item) => item.monthKey))].map((monthKey) => {
  const items = dates.filter((item) => item.monthKey === monthKey);
  // The first (current) month intentionally starts at `today`, not at day 1.
  // Align the grid from the first rendered date; otherwise the weekday headers
  // and the selectable dates drift whenever earlier days are omitted.
  const firstVisibleIso = items[0]?.iso || `${monthKey}-01`;
  const firstWeekday = (parseDate(firstVisibleIso).getUTCDay() + 6) % 7;
  return { monthKey, label: items[0]?.monthLong || monthKey, firstWeekday, items };
});
const selectedMonth = monthGroups.some((month) => month.monthKey === selectedDate.slice(0, 7))
  ? selectedDate.slice(0, 7)
  : monthGroups[0]?.monthKey;
const selectedLabel = current === 'weekend' && weekendEnd
  ? `${selectedDate} — ${weekendEnd}`
  : selectedDate;
const dateAria = (item: typeof dates[number]) => item.isWeekendRange
  ? `Выходные, ${item.rangeLabel} ${item.month.toLocaleLowerCase('ru-RU')}`
  : `${item.weekday}, ${item.day} ${item.month.toLocaleLowerCase('ru-RU')}`;
---
<div
  class="date-accessory"
  data-mobile-date-accessory
  data-selected-date={selectedDate}
  data-calendar-horizon={availability.horizonEnd}
  data-calendar-furthest-event-date={availability.furthestEventDate}
>
  <nav class="date-rail" aria-label="Выбор даты">
    {dates.map((item, index) => item.href ? (
      <a
        class:list={[
          'date-chip',
          item.iso === today && 'date-chip--today',
          (item.isSaturday || item.isSunday) && 'date-chip--weekend',
          item.isWeekendRange && 'date-chip--weekend-range',
        ]}
        href={withBase(item.href)}
        data-date={item.iso}
        aria-current={item.selected ? 'date' : undefined}
        aria-label={dateAria(item)}
      >
        <span>{item.isWeekendRange ? 'СБ+ВС' : item.weekday}</span>
        <strong>{item.rangeLabel}</strong>
        <small>{index === 0 || item.day === 1 ? item.month : ''}</small>
      </a>
    ) : (
      <span
        class:list={['date-chip', 'date-chip--disabled', (item.isSaturday || item.isSunday) && 'date-chip--weekend']}
        data-date={item.iso}
        aria-disabled="true"
        aria-label={`${dateAria(item)}. Событий нет`}
      >
        <span>{item.weekday}</span><strong>{item.day}</strong><small>{index === 0 || item.day === 1 ? item.month : ''}</small>
      </span>
    ))}
  </nav>
  <button type="button" class="date-calendar-trigger" data-calendar-open aria-haspopup="dialog" aria-label="Открыть календарь">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h.25A2.75 2.75 0 0 1 21 6.75v11.5A2.75 2.75 0 0 1 18.25 21H5.75A2.75 2.75 0 0 1 3 18.25V6.75A2.75 2.75 0 0 1 5.75 4H6V3a1 1 0 0 1 1-1ZM5 9v9.25c0 .41.34.75.75.75h12.5c.41 0 .75-.34.75-.75V9H5Z" clip-rule="evenodd"></path></svg>
  </button>
</div>
<div class="calendar-sheet" data-calendar-sheet hidden aria-hidden="true">
  <section class="calendar-panel" role="dialog" aria-modal="true" aria-labelledby="mobile-calendar-title">
    <header>
      <div><h2 id="mobile-calendar-title">Выбрать дату</h2><p>{selectedLabel} · события до {availability.furthestEventDate}</p></div>
      <button type="button" data-calendar-close aria-label="Закрыть">×</button>
    </header>
    <div class="calendar-month-nav" aria-label="Месяцы календаря">
      <button type="button" data-calendar-month-previous aria-label="Предыдущий месяц">←</button>
      <strong data-calendar-month-label aria-live="polite"></strong>
      <button type="button" data-calendar-month-next aria-label="Следующий месяц">→</button>
    </div>
    <div class="calendar-weekdays" aria-hidden="true"><span>ПН</span><span>ВТ</span><span>СР</span><span>ЧТ</span><span>ПТ</span><span>СБ</span><span>ВС</span></div>
    <div class="calendar-months" data-calendar-months data-selected-month={selectedMonth}>
      {monthGroups.map((month) => (
        <section class="calendar-month" data-calendar-month={month.monthKey} data-calendar-month-label={month.label} hidden={month.monthKey !== selectedMonth}>
          <h3 class="sr-only">{month.label}</h3>
          <div class="calendar-grid">
            {Array.from({ length:month.firstWeekday }, () => <span class="calendar-grid__blank" aria-hidden="true"></span>)}
            {month.items.map((item) => item.href ? (
              <a href={withBase(item.href)} data-calendar-date={item.iso} aria-current={item.selected ? 'date' : undefined} aria-label={dateAria(item)}>
                <span>{item.weekday}</span><b>{item.day}</b>
              </a>
            ) : (
              <span data-calendar-date={item.iso} aria-disabled="true" aria-label={`${dateAria(item)}. Событий нет`}>
                <span>{item.weekday}</span><b>{item.day}</b>
              </span>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</div>

<script>
  document.querySelectorAll('[data-mobile-date-accessory]').forEach((accessory) => {
    if (accessory.dataset.calendarReady === 'true') return;
    accessory.dataset.calendarReady = 'true';
    const sheet = accessory.nextElementSibling;
    const trigger = accessory.querySelector('[data-calendar-open]');
    const close = sheet?.querySelector('[data-calendar-close]');
    const selected = accessory.querySelector('[aria-current="date"]');
    const monthsRoot = sheet?.querySelector('[data-calendar-months]');
    const months = [...(monthsRoot?.querySelectorAll('[data-calendar-month]') || [])];
    const monthLabel = sheet?.querySelector('[data-calendar-month-label]');
    const previous = sheet?.querySelector('[data-calendar-month-previous]');
    const next = sheet?.querySelector('[data-calendar-month-next]');
    let monthIndex = Math.max(0, months.findIndex((month) => month.dataset.calendarMonth === monthsRoot?.dataset.selectedMonth));
    const showMonth = (index) => {
      monthIndex = Math.max(0, Math.min(months.length - 1, index));
      months.forEach((month, itemIndex) => { month.hidden = itemIndex !== monthIndex; });
      if (monthLabel) monthLabel.textContent = months[monthIndex]?.dataset.calendarMonthLabel || '';
      if (previous) previous.disabled = monthIndex === 0;
      if (next) next.disabled = monthIndex >= months.length - 1;
    };
    const centerSelected = () => selected?.scrollIntoView({ inline:'center', block:'nearest', behavior:'instant' });
    const closeSheet = () => {
      if (!sheet || sheet.hidden) return;
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      setTimeout(() => { sheet.hidden = true; trigger?.focus(); }, 220);
    };
    const openSheet = () => {
      if (!sheet) return;
      sheet.hidden = false;
      sheet.setAttribute('aria-hidden', 'false');
      showMonth(monthIndex);
      requestAnimationFrame(() => {
        sheet.classList.add('is-open');
        sheet.querySelector('[data-calendar-close]')?.focus();
      });
    };
    showMonth(monthIndex);
    requestAnimationFrame(centerSelected);
    addEventListener('pageshow', centerSelected);
    previous?.addEventListener('click', () => showMonth(monthIndex - 1));
    next?.addEventListener('click', () => showMonth(monthIndex + 1));
    trigger?.addEventListener('click', openSheet);
    close?.addEventListener('click', closeSheet);
    sheet?.addEventListener('click', (event) => { if (event.target === sheet) closeSheet(); });
    addEventListener('keydown', (event) => { if (event.key === 'Escape' && !sheet?.hidden) closeSheet(); });
  });
</script>
