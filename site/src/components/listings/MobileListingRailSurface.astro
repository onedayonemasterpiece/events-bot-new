    .ke-mobile-listing-rails--v23{--rail-bg:#fbf7ef;--rail-surface:#fffdf8;--rail-text:#221a14;--rail-muted:#6d6259;--rail-line:#e1d3c2;--rail-primary:#a54821;--rail-primary-strong:#793014;--rail-time-surface:#efe3d3;--rail-time-ink:#793014;--rail-cue:#8a7f76;display:block;width:100%;margin:0;color:var(--rail-text);font-family:var(--ke-font-family-sans)}
    .ke-mobile-listing-rails--v23 .page-head{height:96px;padding:27px 12px 8px;display:flex;flex-direction:column;justify-content:flex-end}
