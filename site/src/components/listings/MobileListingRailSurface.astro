    .ke-mobile-listing-rails--v23 .feed-head__copy{display:grid;gap:3px;min-width:0}.ke-mobile-listing-rails--v23 .feed-head__copy strong{font-size:13px;line-height:1;font-weight:850}.ke-mobile-listing-rails--v23 .feed-head__copy span{color:var(--rail-muted);font-size:9.5px;line-height:1;font-weight:720;white-space:nowrap}
    .ke-mobile-listing-rails--v23 .city-picker{position:relative;z-index:7;flex:none}.ke-mobile-listing-rails--v23 .city-picker>summary,.ke-mobile-listing-rails--v23 .city-pill{min-height:42px;max-width:146px;padding:0 28px 0 13px;border:1px solid rgba(121,48,20,.15);border-radius:999px;background:#fffdf8;color:var(--rail-text);display:flex;align-items:center;overflow:hidden;font:800 11px/1 var(--ke-font-family-sans);text-overflow:ellipsis;white-space:nowrap;list-style:none;cursor:pointer}.ke-mobile-listing-rails--v23 .city-picker>summary::-webkit-details-marker{display:none}.ke-mobile-listing-rails--v23 .city-picker>summary::after{content:'⌄';position:absolute;right:12px;color:var(--rail-primary)}
