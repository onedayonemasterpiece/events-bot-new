    body:has(.ke-mobile-listing-rails--v23) .ke-listing-shell{width:100%;max-width:none;margin:0;padding:0}
    body:has(.ke-mobile-listing-rails--v23) .ke-listing-head,
    body:has(.ke-mobile-listing-rails--v23) .ke-listing-discovery-rail,
