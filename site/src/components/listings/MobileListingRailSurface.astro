    .ke-mobile-listing-rails--v23 .mobile-v23-sections{display:block;overflow:visible}.ke-mobile-listing-rails--v23 .group{position:relative;display:block;overflow:visible}.ke-mobile-listing-rails--v23 .group[hidden]{display:none}.ke-mobile-listing-rails--v23 .group-head{position:sticky;z-index:30;top:64px;min-height:54px;padding:9px 12px 8px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-block:1px solid var(--rail-line);background:rgba(251,247,239,.985);box-shadow:0 6px 12px rgba(72,45,25,.045)}.ke-mobile-listing-rails--v23[data-mobile-v23-page=popular] .group-head{box-sizing:border-box;height:80px;min-height:80px;padding:21px 12px 4px}.ke-mobile-listing-rails--v23 .group-head__copy{min-width:0;display:flex;align-items:center;gap:7px}.ke-mobile-listing-rails--v23 .group-head__icon{width:18px;height:18px;flex:0 0 18px;color:var(--rail-primary)}.ke-mobile-listing-rails--v23 .group-head h2{margin:0;font:880 17px/19px var(--ke-font-family-sans);letter-spacing:-.025em}.ke-mobile-listing-rails--v23[data-mobile-v23-page=popular] .group-head h2{font-size:18px;line-height:20px}.ke-mobile-listing-rails--v23 .group-head p{margin:3px 0 0;color:var(--rail-muted);font:700 10px/12px var(--ke-font-family-sans)}.ke-mobile-listing-rails--v23 .group-head>span{flex:none;min-width:28px;text-align:right;color:var(--rail-primary);font:900 12px/1 var(--ke-font-family-sans)}
    .ke-mobile-listing-rails--v23 .event-list{display:grid;gap:10px;padding:10px 0 24px}.ke-mobile-listing-rails--v23 .event-row{height:112px;min-width:0;overflow:hidden}.ke-mobile-listing-rails--v23 .event-row[hidden]{display:none}
    .ke-mobile-listing-rails--v23 .rail-window{--dislike-progress:0;--like-progress:0;--rail-max:0px;--rail-view-width:100vw;position:relative;display:block;width:100vw;height:112px;overflow-x:auto;overflow-y:hidden;border:0;border-radius:0;background:transparent;box-shadow:none;color:inherit;text-decoration:none;scrollbar-width:none;overscroll-behavior-inline:contain;touch-action:pan-x pan-y;cursor:grab;-webkit-tap-highlight-color:transparent}.ke-mobile-listing-rails--v23 .rail-window::-webkit-scrollbar{display:none}.ke-mobile-listing-rails--v23 .rail-window.is-dragging{cursor:grabbing}.ke-mobile-listing-rails--v23 .event-link{display:contents;color:inherit;text-decoration:none}.ke-mobile-listing-rails--v23 .event-link:focus-visible{outline:none}.ke-mobile-listing-rails--v23 .event-link:focus-visible .event-summary{outline:3px solid rgba(15,118,110,.62);outline-offset:-3px}
    .ke-mobile-listing-rails--v23 .event-track{position:relative;z-index:1;width:max-content;height:112px;display:flex;align-items:center;gap:7px;padding:0 12px 0 0;background:transparent;border:0;border-radius:0;box-shadow:none;transform:translate3d(0,0,0)}.ke-mobile-listing-rails--v23 .rail-window.is-dislike-active .event-track,.ke-mobile-listing-rails--v23 .rail-window.is-like-pulling .event-track{will-change:transform}.ke-mobile-listing-rails--v23 .rail-window.is-settling .event-track{transition:transform 400ms cubic-bezier(.2,.8,.2,1)}
    .ke-mobile-listing-rails--v23 .dislike-underlay{position:absolute;z-index:0;inset:0 auto 0 0;width:100vw;display:flex;align-items:center;padding-left:12px;background:linear-gradient(90deg,rgba(177,38,38,.94),rgba(177,38,38,.34) 55%,rgba(177,38,38,0));opacity:var(--dislike-progress);color:#fff;pointer-events:none}.ke-mobile-listing-rails--v23 .dislike-underlay span{opacity:0;font:900 10px/1 var(--ke-font-family-sans);transition:opacity 140ms ease}.ke-mobile-listing-rails--v23 .rail-window.is-armed .dislike-underlay span{opacity:1}.ke-mobile-listing-rails--v23 .like-underlay{position:absolute;z-index:0;top:0;bottom:0;left:var(--rail-max);width:var(--rail-view-width);display:flex;align-items:center;justify-content:flex-end;padding-right:4px;background:linear-gradient(270deg,rgba(47,122,86,.96),rgba(47,122,86,.42) 58%,rgba(47,122,86,0));opacity:var(--like-progress);color:#fff;pointer-events:none}.ke-mobile-listing-rails--v23 .like-underlay svg{fill:currentColor}.ke-mobile-listing-rails--v23 .like-underlay .icon__heart-outline{display:none}.ke-mobile-listing-rails--v23 .like-underlay .icon__heart-solid{display:block!important}
