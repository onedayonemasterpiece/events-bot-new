<script>
  document.querySelectorAll('[data-mobile-listing-rails]').forEach((surface) => {
    if (surface.dataset.mobileV23Ready === 'true') return;
    surface.dataset.mobileV23Ready = 'true';
    const rows = [...surface.querySelectorAll('[data-mobile-listing-row]')];
    const label = surface.querySelector('[data-mobile-v23-city-label]');
    const empty = surface.querySelector('[data-mobile-v23-empty]');
    const picker = surface.querySelector('[data-mobile-v23-city-picker]');
    const buttons = [...surface.querySelectorAll('[data-mobile-v23-city]')];
    const pinSentinel = surface.querySelector('[data-mobile-listing-pin-sentinel]');
    const stickyTitle = surface.querySelector('[data-mobile-listing-sticky-title]');
    let pinFrame = 0;
    const syncPinnedTitle = () => {
      pinFrame = 0;
      const pinned = Boolean(pinSentinel && pinSentinel.getBoundingClientRect().top <= 64);
      document.body.classList.toggle('is-date-pinned', pinned);
      stickyTitle?.setAttribute('aria-hidden', String(!pinned));
    };
    function applyCity(city) {
      let visible = 0;
      rows.forEach((row) => {
        row.hidden = city !== 'all' && row.dataset.listingCity !== city;
        if (!row.hidden) visible += 1;
      });
      surface.querySelectorAll('[data-mobile-v23-group]').forEach((group) => {
        const count = [...group.querySelectorAll('[data-mobile-listing-row]')].filter((row) => !row.hidden).length;
        group.hidden = count === 0;
        const countNode = group.querySelector('[data-mobile-v23-group-count]');
        if (countNode) countNode.textContent = String(count);
      });
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mobileV23City === city)));
      if (label) label.textContent = city === 'all' ? 'Вся область' : city;
      if (empty) empty.hidden = visible !== 0;
      if (picker) picker.open = false;
    }
    buttons.forEach((button) => button.addEventListener('click', () => applyCity(button.dataset.mobileV23City || 'all')));
    surface.querySelectorAll('.rail-window').forEach((rail) => {
      rail.scrollLeft = 0;
      const sync = () => {
        rail.style.setProperty('--rail-max', `${Math.max(0, rail.scrollWidth - rail.clientWidth)}px`);
        rail.style.setProperty('--rail-view-width', `${rail.clientWidth}px`);
      };
      requestAnimationFrame(sync);
      new ResizeObserver(sync).observe(rail);
    });
    surface.querySelectorAll('.event-media img').forEach((img) => {
      const shell = img.closest('.event-media');
      if (!shell || shell.dataset.mediaRuntimeReady === 'true') return;
      shell.dataset.mediaRuntimeReady = 'true';
      const done = (ok) => {
        shell.classList.remove('is-loading');
        shell.classList.toggle('is-loaded', ok);
        shell.classList.toggle('is-error', !ok);
        shell.dataset.mediaState = ok ? 'loaded' : 'error';
      };
      const decodeLoaded = () => {
        if (!img.naturalWidth) { done(false); return; }
        if (typeof img.decode !== 'function') { done(true); return; }
        img.decode().then(() => done(true)).catch(() => done(img.naturalWidth > 0));
      };
      if (img.complete) decodeLoaded();
      else {
        img.addEventListener('load', decodeLoaded, { once:true });
        img.addEventListener('error', () => done(false), { once:true });
      }
    });
    addEventListener('scroll', () => {
      if (pinFrame) return;
      pinFrame = requestAnimationFrame(syncPinnedTitle);
    }, { passive:true });
    addEventListener('resize', syncPinnedTitle, { passive:true });
    syncPinnedTitle();
  });
  addEventListener('pageshow', () => document.querySelectorAll('.ke-mobile-listing-rails--v23 .rail-window').forEach((rail) => { rail.scrollLeft = 0; }));
</script>
