          dragged = true;
          event.preventDefault();
          rail.setPointerCapture?.(event.pointerId);
          setDislike(dx);
        } else if (mode === 'like') {
          dragged = true;
          event.preventDefault();
          rail.setPointerCapture?.(event.pointerId);
          setLikePull(likeAnchorX - event.clientX);
        } else if (mode === 'scroll' && Math.abs(dx) > 7) {
          dragged = true;
          rail.classList.add('is-dragging');
          event.preventDefault();
          rail.setPointerCapture?.(event.pointerId);
          rail.scrollLeft = startScroll - dx;
          if (dx < 0 && horizontal && likeEligible()) {
            mode = 'like';
            likeAnchorX = event.clientX;
            rail.classList.remove('is-dragging');
          }
        }
      });
      rail.addEventListener('pointerup', () => {
        if (dragged) armClickSuppression();
        if (mode === 'dislike') {
          const armed = rail.classList.contains('is-armed');
          resetDislike();
          if (armed) commitSwipeNegative(row);
        } else if (mode === 'like') finishLike(rail.classList.contains('is-like-armed'));
        down = false;
        mode = 'idle';
        rail.classList.remove('is-dragging');
      });
      rail.addEventListener('pointercancel', () => {
        if (dragged) armClickSuppression();
        if (mode === 'dislike') resetDislike();
        if (mode === 'like') resetLikePull();
        down = false;
        mode = 'idle';
        rail.classList.remove('is-dragging');
      });
      rail.addEventListener('touchstart', (event) => {
        const touch = event.touches[0];
        touchStartScroll = rail.scrollLeft;
        touchStartX = touchLastX = touch?.clientX || 0;
        touchStartY = touchLastY = touch?.clientY || 0;
        touchMode = 'pending';
        touchLikeAnchorX = 0;
      }, { passive:true });
      rail.addEventListener('touchmove', (event) => {
        const touch = event.touches[0];
        if (!touch) return;
        touchLastX = touch.clientX;
        touchLastY = touch.clientY;
        const dx = touchLastX - touchStartX;
        const dy = touchLastY - touchStartY;
        const horizontal = Math.abs(dx) >= Math.abs(dy) * 1.25;
        if (touchMode === 'pending' && Math.hypot(dx, dy) > 12) {
          if (dx > 0 && horizontal && touchStartScroll <= 1 && edgeEligible()) {
            touchMode = 'dislike';
            startX = touchStartX;
          } else if (dx < 0 && horizontal && likeEligible()) {
            touchMode = 'like';
            touchLikeAnchorX = touchStartX;
          } else touchMode = 'native';
        }
        if (touchMode === 'native' && dx < 0 && horizontal && likeEligible()) {
          touchMode = 'like';
          touchLikeAnchorX = touchLastX;
        }
        if (touchMode === 'dislike') { dragged = true; event.preventDefault(); setDislike(dx); }
        else if (touchMode === 'like') { dragged = true; event.preventDefault(); setLikePull(touchLikeAnchorX - touchLastX); }
      }, { passive:false });
      rail.addEventListener('touchend', () => {
        if (dragged) armClickSuppression();
        if (touchMode === 'dislike') {
          const armed = rail.classList.contains('is-armed');
          resetDislike();
          if (armed) commitSwipeNegative(row);
        } else if (touchMode === 'like') finishLike(rail.classList.contains('is-like-armed'));
        touchMode = 'idle';
      }, { passive:true });
      rail.addEventListener('touchcancel', () => {
        if (dragged) armClickSuppression();
        if (touchMode === 'dislike') resetDislike();
        if (touchMode === 'like') resetLikePull();
        touchMode = 'idle';
      }, { passive:true });
      rail.addEventListener('click', (event) => {
        if (!event.isTrusted) return;
        if (!suppressClick && !dragged) return;
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        suppressClick = false;
        dragged = false;
      }, { capture:true });
    });
    const syncTodayTemporalMedia = () => {
      if (surface.dataset.mobileV23Page !== 'today') return;
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone:'Europe/Kaliningrad',
        year:'numeric',
        month:'2-digit',
        day:'2-digit',
      }).formatToParts(new Date());
      const clock = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      const kaliningradDate = `${clock.year}-${clock.month}-${clock.day}`;
      const listingDate = surface.dataset.mobileListingDate || '';
      const listingDayElapsed = /^\d{4}-\d{2}-\d{2}$/u.test(listingDate)
        && listingDate < kaliningradDate;
      const now = Date.now();
      rows.forEach((row) => {
        const endAt = row.dataset.eventEndAt || '';
        const startAt = row.dataset.eventStartsAt || '';
        const endMs = Date.parse(endAt);
        const startMs = Date.parse(startAt);
        const hasExplicitEnd = endAt.trim().length > 0;
        const completed = Number.isFinite(endMs) && endMs <= now;
        const elapsedListingDayWithoutEnd = !hasExplicitEnd && listingDayElapsed;
        const startedEarlier = !hasExplicitEnd
          && kaliningradDate === listingDate
          && Number.isFinite(startMs)
          && startMs <= now - 60 * 60 * 1000;
        const state = completed || elapsedListingDayWithoutEnd ? 'past' : startedEarlier ? 'started-earlier' : 'current';
        row.dataset.mobileRailTemporalState = state;
        row.querySelectorAll('.event-media').forEach((media) => media.classList.toggle('is-temporally-muted', state !== 'current'));
      });
    };
    syncTodayTemporalMedia();
    if (surface.dataset.mobileV23Page === 'today') setInterval(syncTodayTemporalMedia, 60_000);
    surface.querySelectorAll('.event-media img').forEach((img) => {
      const shell = img.closest('.event-media');
      if (!shell || shell.dataset.mediaRuntimeReady === 'true') return;
      shell.dataset.mediaRuntimeReady = 'true';
      const done = (ok) => {
        shell.classList.remove('is-loading');
        shell.classList.toggle('is-loaded', ok);
        shell.classList.toggle('is-error', !ok);
        shell.dataset.mediaState = ok ? 'loaded' : 'error';
      };
      const decodeLoaded = () => {
        if (!img.naturalWidth) { done(false); return; }
        if (typeof img.decode !== 'function') { done(true); return; }
        img.decode().then(() => done(true)).catch(() => done(img.naturalWidth > 0));
      };
      if (img.complete) decodeLoaded();
      else {
        img.addEventListener('load', decodeLoaded, { once:true });
        img.addEventListener('error', () => done(false), { once:true });
      }
    });
    addEventListener('scroll', () => {
      if (pinFrame) return;
      pinFrame = requestAnimationFrame(syncPinnedTitle);
    }, { passive:true });
    addEventListener('resize', syncPinnedTitle, { passive:true });
    syncPinnedTitle();
  });
  addEventListener('pageshow', () => document.querySelectorAll('.ke-mobile-listing-rails--v23 .rail-window').forEach((rail) => { rail.scrollLeft = 0; }));
</script>
