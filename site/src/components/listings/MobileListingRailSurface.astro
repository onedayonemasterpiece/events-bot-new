    .ke-mobile-listing-rails--v23 .event-like-cta{flex:0 0 auto;min-width:58px;height:56px;padding:0 8px;display:inline-flex;align-items:center;justify-content:center;gap:5px;border:0;border-radius:12px;background:transparent;color:rgba(58,48,40,.70);font:inherit;cursor:pointer}.ke-mobile-listing-rails--v23 .event-like-cta svg{width:28px;height:28px;flex:none;fill:currentColor}.ke-mobile-listing-rails--v23 .event-like-cta strong{font:900 15px/1 Inter,system-ui}.ke-mobile-listing-rails--v23 .event-like-cta[aria-pressed=true]{background:rgba(201,52,52,.10);color:#c93434}
    .ke-mobile-listing-rails--v23 .empty{margin:24px 12px;padding:20px 16px;border-radius:14px;background:rgba(121,48,20,.06);text-align:center}
    .ke-mobile-listing-rails--v23 .date-accessory{position:fixed;z-index:39;left:0;right:0;bottom:calc(64px + env(safe-area-inset-bottom));height:56px;border-top:1px solid rgba(121,48,20,.13);border-bottom:1px solid rgba(121,48,20,.10);background:rgba(255,253,248,.985);backdrop-filter:blur(14px)}.ke-mobile-listing-rails--v23 .date-rail{height:56px;display:flex;align-items:center;gap:6px;padding:4px 66px 4px 12px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;overscroll-behavior-inline:contain;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch}.ke-mobile-listing-rails--v23 .date-rail::-webkit-scrollbar{display:none}.ke-mobile-listing-rails--v23 .date-chip{flex:0 0 60px;width:60px;height:48px;display:grid;place-content:center;justify-items:center;gap:2px;border:0;border-radius:13px;background:transparent;color:#665b52;text-decoration:none;scroll-snap-align:center}.ke-mobile-listing-rails--v23 .date-chip--disabled{opacity:.48;cursor:not-allowed}.ke-mobile-listing-rails--v23 .date-chip span{font:800 9.5px/1 Inter,system-ui;text-transform:uppercase}.ke-mobile-listing-rails--v23 .date-chip strong{font:900 18px/1 Inter,system-ui;font-variant-numeric:tabular-nums}.ke-mobile-listing-rails--v23 .date-chip small{font:800 8px/1 Inter,system-ui}.ke-mobile-listing-rails--v23 .date-chip--weekend:not([aria-current=date])>span{color:#945247}.ke-mobile-listing-rails--v23 .date-chip--today:not([aria-current=date]){box-shadow:inset 0 0 0 1px rgba(121,48,20,.22)}.ke-mobile-listing-rails--v23 .date-chip[aria-current=date]{background:var(--rail-primary);color:#fff;box-shadow:0 5px 12px rgba(121,48,20,.18);opacity:1}.ke-mobile-listing-rails--v23 .date-chip--weekend-range{flex-basis:74px;width:74px}.ke-mobile-listing-rails--v23 .date-chip--weekend-range strong{font-size:16px}.ke-mobile-listing-rails--v23 .date-calendar-trigger{position:absolute;z-index:2;right:5px;top:5px;width:50px;height:46px;border:0;border-left:1px solid rgba(121,48,20,.12);border-radius:11px;background:rgba(255,253,248,.98);color:var(--rail-primary);box-shadow:-8px 0 12px rgba(255,253,248,.94)}.ke-mobile-listing-rails--v23 .date-calendar-trigger svg{width:23px;height:23px;fill:currentColor}
    .ke-mobile-listing-rails--v23 .calendar-sheet[hidden]{display:none}.ke-mobile-listing-rails--v23 .calendar-sheet{position:fixed;z-index:100;inset:0;display:flex;align-items:flex-end;background:rgba(34,26,20,.34);opacity:0;transition:opacity 220ms ease-out}.ke-mobile-listing-rails--v23 .calendar-sheet.is-open{opacity:1}.ke-mobile-listing-rails--v23 .calendar-panel{width:min(430px,100%);max-height:82dvh;padding:18px 14px calc(16px + env(safe-area-inset-bottom));border-radius:20px 20px 0 0;background:#fffdf8;box-shadow:0 -16px 42px rgba(34,26,20,.18);transform:translate3d(0,calc(100% + 18px),0);transition:transform 360ms cubic-bezier(.16,1,.3,1)}.ke-mobile-listing-rails--v23 .calendar-sheet.is-open .calendar-panel{transform:none}.ke-mobile-listing-rails--v23 .calendar-panel header{display:flex;justify-content:space-between}.ke-mobile-listing-rails--v23 .calendar-panel h2{margin:0;font:900 20px/1 Inter,system-ui}.ke-mobile-listing-rails--v23 .calendar-panel p{margin:6px 0 14px;color:var(--rail-muted);font:700 11px/1 Inter,system-ui}.ke-mobile-listing-rails--v23 .calendar-panel header button{width:44px;height:44px;border:0;border-radius:50%;background:rgba(34,26,20,.07);font-size:22px}.ke-mobile-listing-rails--v23 .calendar-grid{max-height:58dvh;overflow:auto;display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.ke-mobile-listing-rails--v23 .calendar-grid>[data-calendar-date]{min-width:0;height:52px;border-radius:11px;display:grid;place-content:center;justify-items:center;gap:3px;color:var(--rail-text);text-decoration:none}.ke-mobile-listing-rails--v23 .calendar-grid>[data-calendar-date]>span{font:800 8px/1 Inter,system-ui;color:var(--rail-muted)}.ke-mobile-listing-rails--v23 .calendar-grid>[data-calendar-date]>b{font:900 16px/1 Inter,system-ui}.ke-mobile-listing-rails--v23 .calendar-grid>a[aria-current=date]{background:var(--rail-primary);color:#fff}.ke-mobile-listing-rails--v23 .calendar-grid>[aria-disabled=true]{opacity:.42;pointer-events:none}.ke-mobile-listing-rails--v23 .calendar-grid>[data-calendar-date]:nth-child(7n+6):not([aria-current=date]),.ke-mobile-listing-rails--v23 .calendar-grid>[data-calendar-date]:nth-child(7n):not([aria-current=date]){color:#945247}
