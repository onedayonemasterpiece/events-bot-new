      if (picker) picker.open = false;
    }
    buttons.forEach((button) => button.addEventListener('click', () => applyCity(button.dataset.mobileV23City || 'all')));
    rows.forEach((row) => {
      const rail = row.querySelector('.rail-window');
      const track = row.querySelector('.event-track');
      const likeButton = row.querySelector('[data-like]');
      const negativeButton = row.querySelector('[data-rail-negative-control]');
      const smallLike = row.querySelector('[data-small-like]');
      if (!rail || !track) return;
      row.dataset.notInterested = negativeButton?.getAttribute('aria-pressed') === 'true' ? 'true' : 'false';
      const syncFeedbackVisuals = () => {
        const liked = likeButton?.getAttribute('aria-pressed') === 'true';
        const negative = negativeButton?.getAttribute('aria-pressed') === 'true';
        row.classList.toggle('is-liked', liked);
        row.dataset.notInterested = negative ? 'true' : 'false';
        if (smallLike && likeButton) {
          const count = Number(likeButton.querySelector('[data-like-count]')?.textContent || '0');
          const countNode = smallLike.querySelector('[data-small-like-count]');
          if (countNode) countNode.textContent = String(count);
          smallLike.hidden = count <= 0;
        }
        syncRowVisibility(row);
        refreshGroups();
      };
      if (likeButton) new MutationObserver(syncFeedbackVisuals).observe(likeButton, { attributes:true, attributeFilter:['aria-pressed'], childList:true, subtree:true });
      if (negativeButton) new MutationObserver(syncFeedbackVisuals).observe(negativeButton, { attributes:true, attributeFilter:['aria-pressed'] });
      syncFeedbackVisuals();
      rail.scrollLeft = 0;
      const syncRailMetrics = () => {
        rail.style.setProperty('--rail-max', `${Math.max(0, rail.scrollWidth - rail.clientWidth)}px`);
        rail.style.setProperty('--rail-view-width', `${rail.clientWidth}px`);
      };
      requestAnimationFrame(syncRailMetrics);
      new ResizeObserver(syncRailMetrics).observe(rail);
      let down = false;
      let dragged = false;
      let startX = 0;
      let startY = 0;
      let startScroll = 0;
      let mode = 'idle';
      let likeAnchorX = 0;
      let touchStartScroll = 0;
      let touchStartX = 0;
      let touchStartY = 0;
      let touchLastX = 0;
      let touchLastY = 0;
      let touchMode = 'idle';
      let touchLikeAnchorX = 0;
      let suppressClick = false;
      let suppressClickTimer = 0;
      const armClickSuppression = () => {
        suppressClick = true;
        clearTimeout(suppressClickTimer);
        suppressClickTimer = setTimeout(() => {
          suppressClick = false;
          dragged = false;
        }, 550);
      };
      const isLiked = () => row.classList.contains('is-liked');
      const edgeEligible = () => !isLiked() && !reduced;
      const maxScroll = () => Math.max(0, rail.scrollWidth - rail.clientWidth);
      const atEnd = () => maxScroll() - rail.scrollLeft <= 1;
      const likeEligible = () => atEnd() && edgeEligible();
      const setDislike = (dx) => {
        const denominator = Math.max(1, innerWidth - 24 - startX);
        const progress = Math.max(0, Math.min(1, dx / denominator));
        const visual = Math.min(96, Math.max(0, dx * .32));
        const armed = progress >= .86 && dx >= 140;
        rail.classList.add('is-dislike-active');
        rail.classList.toggle('is-armed', armed);
        rail.style.setProperty('--dislike-progress', String(progress));
        const copy = rail.querySelector('.dislike-underlay span');
        if (copy) copy.textContent = armed ? 'Отпустите, чтобы отметить неинтересным' : 'Неинтересно';
        track.style.transform = `translate3d(${visual}px,0,0)`;
        return armed;
      };
      const resetDislike = () => {
        rail.classList.remove('is-dislike-active', 'is-armed');
        rail.classList.add('is-settling');
        rail.style.setProperty('--dislike-progress', '0');
        const copy = rail.querySelector('.dislike-underlay span');
        if (copy) copy.textContent = 'Неинтересно';
        track.style.transform = 'translate3d(0,0,0)';
        setTimeout(() => rail.classList.remove('is-settling'), reduced ? 0 : 410);
      };
      const setLikePull = (overpull) => {
        const physical = Math.max(0, overpull);
        const progress = Math.max(0, Math.min(1, physical / 120));
        const visual = Math.min(96, physical * .32);
        const armed = physical >= 120;
        rail.classList.add('is-like-pulling');
        rail.classList.toggle('is-like-armed', armed);
        rail.style.setProperty('--like-progress', String(progress));
        track.style.transform = `translate3d(${-visual}px,0,0)`;
        return armed;
      };
      const resetLikePull = () => {
        rail.classList.remove('is-like-pulling', 'is-like-armed');
        rail.classList.add('is-settling');
        rail.style.setProperty('--like-progress', '0');
        track.style.transform = 'translate3d(0,0,0)';
        setTimeout(() => rail.classList.remove('is-settling'), reduced ? 0 : 410);
      };
      const finishLike = (armed) => {
        if (!armed || isLiked()) { resetLikePull(); return; }
        armClickSuppression();
        likeButton?.click();
        resetLikePull();
        void waitForPressed(likeButton, true).then((pressed) => {
          if (!pressed) return;
          showToast('Событие добавлено в понравившиеся', () => likeButton.click());
        });
      };
      rail.addEventListener('dragstart', (event) => event.preventDefault());
      rail.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button') || event.pointerType !== 'mouse' || event.button !== 0) return;
        down = true;
        dragged = false;
        mode = 'pending';
        startX = event.clientX;
        startY = event.clientY;
        startScroll = rail.scrollLeft;
