    .ke-mobile-listing-rails--v23 .mobile-listing-sticky-title strong{display:block;max-width:100%;overflow:hidden;font:920 18px/18px var(--ke-font-family-sans);letter-spacing:-.04em;text-overflow:ellipsis;white-space:nowrap}.ke-mobile-listing-rails--v23 .mobile-listing-sticky-title span{display:block;max-width:100%;overflow:hidden;color:var(--rail-muted);font:800 10.5px/12px var(--ke-font-family-sans);text-overflow:ellipsis;white-space:nowrap}
    body.is-date-pinned .ke-mobile-listing-rails--v23 .mobile-listing-sticky-title{opacity:1;visibility:visible}
