---
import type { PreviewEvent } from '../../lib/types';
import type { WeatherRouteKind } from '../../lib/weatherCalendar';
import WeatherDateContext from '../WeatherDateContext.astro';
import SemanticIcon from '../design-system/SemanticIcon.astro';
import MobileListingRailRow from './MobileListingRailRow.astro';
import MobileDateAccessory from './MobileDateAccessory.astro';
import './mobile-listing-foundation-bindings.css';

interface WeatherContext { date: string; dateLabel: string; routeKind: WeatherRouteKind; }
interface Section { id: string; title?: string; subtitle?: string; events: PreviewEvent[]; weather?: WeatherContext; }
interface City { name: string; count: number; }
interface Props {
  sections: Section[];
  occurrenceMode?: 'per-date' | 'per-family';
  title: string;
  meta: string;
  feedTitle: string;
  feedMeta: string;
  current: 'today' | 'tomorrow' | 'weekend' | 'popular' | 'date';
  cities?: City[];
  calendarToday?: string;
  calendarDate?: string;
  weekendEnd?: string;
  amberArtifactTailEventId?: number | null;
  weather?: WeatherContext;
}
const {
  sections,
  occurrenceMode = 'per-date',
  title,
  meta,
  feedTitle,
  feedMeta,
  current,
  cities = [],
  calendarToday = '',
  calendarDate = '',
  weekendEnd = '',
  amberArtifactTailEventId = null,
  weather,
} = Astro.props;
let rowIndex = 0;
const total = sections.reduce((sum, section) => sum + section.events.length, 0);
---
<div
  class="ke-mobile-listing-rails ke-mobile-listing-rails--v23"
  data-ds-family="MobileListingRailSurface"
  data-ds-version="1"
  data-ds-variant={current}
  data-ds-state={total > 0 ? 'populated' : 'empty'}
  data-mobile-listing-rails
  data-mobile-v23-page={current}
  data-mobile-listing-date={calendarDate || undefined}
>
  <section class="page-head" aria-labelledby={`mobile-v23-title-${current}`}>
    <h1 id={`mobile-v23-title-${current}`}>{title}</h1>
    <p>{meta}</p>
  </section>
  {weather ? <WeatherDateContext {...weather} surface="mobile" /> : null}
  <div class="mobile-listing-pin-sentinel" data-mobile-listing-pin-sentinel aria-hidden="true"></div>
  <div class="sticky-date mobile-listing-sticky-title" data-mobile-listing-sticky-title aria-hidden="true">
    <strong>{title}</strong><span>{meta}</span>
  </div>
  <div class="feed-head">
    <div class="feed-head__copy"><strong>{feedTitle}</strong><span>{feedMeta}</span></div>
    {cities.length > 1 ? (
      <details class="city-picker" data-mobile-v23-city-picker>
        <summary data-mobile-v23-city-label>Вся область</summary>
        <div class="city-picker__panel" role="group" aria-label="Города">
          <button type="button" data-mobile-v23-city="all" aria-pressed="true"><span>Вся область</span><b>{total}</b></button>
          {cities.map((city) => <button type="button" data-mobile-v23-city={city.name} aria-pressed="false"><span>{city.name}</span><b>{city.count}</b></button>)}
        </div>
      </details>
    ) : <span class="city-pill">Вся область</span>}
  </div>
  <div class="mobile-v23-sections">
    {sections.map((section) => section.events.length > 0 && (
      <section class="group" aria-labelledby={`mobile-rail-${section.id}`} data-mobile-v23-group>
        {section.title && (
          <header class="group-head">
            <div class="group-head__copy">
              <span class="group-head__icon" aria-hidden="true">
                <SemanticIcon name="trend-up" role="control" />
              </span>
              <div><h2 id={`mobile-rail-${section.id}`}>{section.title}</h2>{section.subtitle && <p>{section.subtitle}</p>}</div>
            </div>
            <span data-mobile-v23-group-count>{section.events.length}</span>
          </header>
        )}
        {section.weather ? <WeatherDateContext {...section.weather} compact surface="mobile" /> : null}
        <div class="event-list">
          {section.events.map((event) => {
            const priority = rowIndex++ < 2;
            return <MobileListingRailRow event={event} occurrenceMode={occurrenceMode} priority={priority} amberArtifactTail={event.id === amberArtifactTailEventId} />;
          })}
        </div>
      </section>
    ))}
  </div>
  <div class="empty" data-mobile-v23-empty hidden>Нет событий с такими фильтрами</div>
  {current !== 'popular' && calendarToday && calendarDate && (
    <MobileDateAccessory
      today={calendarToday}
      selectedDate={calendarDate}
      current={current}
      weekendEnd={weekendEnd}
    />
  )}
  <div class="rail-confirm-sheet" data-rail-confirm hidden role="dialog" aria-modal="true" aria-labelledby={`rail-confirm-title-${current}`}>
    <section class="rail-confirm-panel">
      <h2 id={`rail-confirm-title-${current}`}>Пометить событие как неинтересное?</h2>
      <p>После подтверждения следующие свайпы будут отмечать события без подтверждения. Любую отметку можно отменить.</p>
      <div>
        <button type="button" data-rail-confirm-cancel>Отмена</button>
        <button type="button" data-rail-confirm-negative>Не интересно</button>
      </div>
    </section>
  </div>
  <div class="rail-action-toast" data-rail-action-toast hidden role="status" aria-live="polite">
    <span></span><button type="button">Отменить</button>
  </div>
</div>

