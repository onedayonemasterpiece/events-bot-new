<script>
  document.querySelectorAll('[data-mobile-listing-rails]').forEach((surface) => {
    if (surface.dataset.mobileV23Ready === 'true') return;
    surface.dataset.mobileV23Ready = 'true';
    const rows = [...surface.querySelectorAll('[data-mobile-listing-row]')];
    const label = surface.querySelector('[data-mobile-v23-city-label]');
    const empty = surface.querySelector('[data-mobile-v23-empty]');
    const picker = surface.querySelector('[data-mobile-v23-city-picker]');
    const buttons = [...surface.querySelectorAll('[data-mobile-v23-city]')];
    const pinSentinel = surface.querySelector('[data-mobile-listing-pin-sentinel]');
    const stickyTitle = surface.querySelector('[data-mobile-listing-sticky-title]');
    const confirm = surface.querySelector('[data-rail-confirm]');
    const toast = surface.querySelector('[data-rail-action-toast]');
    const toastText = toast?.querySelector('span');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const negativeSwipeConsentKey = 'ke_rail_negative_swipe_consent_v1';
    const hasNegativeSwipeConsent = () => {
      try {
        return localStorage.getItem(negativeSwipeConsentKey) === 'true';
      } catch (_) {
        return false;
      }
    };
    const rememberNegativeSwipeConsent = () => {
      try {
        localStorage.setItem(negativeSwipeConsentKey, 'true');
        return localStorage.getItem(negativeSwipeConsentKey) === 'true';
      } catch (_) {
        return false;
      }
    };
    let selectedCity = 'all';
    let confirmRow = null;
    let toastUndo = null;
    let toastTimer = 0;
    let pinFrame = 0;
    const refreshGroups = () => {
      let visible = 0;
      surface.querySelectorAll('[data-mobile-v23-group]').forEach((group) => {
        const count = [...group.querySelectorAll('[data-mobile-listing-row]')].filter((row) => !row.hidden).length;
        group.hidden = count === 0;
        visible += count;
        const countNode = group.querySelector('[data-mobile-v23-group-count]');
        if (countNode) countNode.textContent = String(count);
      });
      if (empty) empty.hidden = visible !== 0;
    };
    const syncRowVisibility = (row) => {
      const cityFiltered = selectedCity !== 'all' && row.dataset.listingCity !== selectedCity;
      row.dataset.cityFiltered = cityFiltered ? 'true' : 'false';
      row.hidden = cityFiltered || row.dataset.notInterested === 'true';
    };
    const showToast = (message, undo) => {
      if (!toast || !toastText) return;
      clearTimeout(toastTimer);
      toastText.textContent = message;
      toastUndo = undo || null;
      const undoButton = toast.querySelector('button');
      if (undoButton) undoButton.hidden = !toastUndo;
      toast.hidden = false;
      toastTimer = setTimeout(() => { toast.hidden = true; toastUndo = null; }, 4500);
    };
    const waitForPressed = (button, expected, timeout = 1500) => new Promise((resolve) => {
      if (!button) { resolve(false); return; }
      const value = String(expected);
      if (button.getAttribute('aria-pressed') === value) { resolve(true); return; }
      let settled = false;
      let timer = 0;
      const observer = new MutationObserver(() => {
        if (button.getAttribute('aria-pressed') === value) finish(true);
      });
      const finish = (matched) => {
        if (settled) return;
        settled = true;
        clearTimeout(timer);
        observer.disconnect();
        resolve(matched);
      };
      timer = setTimeout(() => finish(false), timeout);
      observer.observe(button, { attributes:true, attributeFilter:['aria-pressed'] });
    });
    toast?.addEventListener('click', (event) => {
      if (!event.target.closest('button') || !toastUndo) return;
      const undo = toastUndo;
      toastUndo = null;
      toast.hidden = true;
      undo();
    });
    const closeConfirm = () => {
      if (!confirm) return;
      confirm.classList.remove('is-open');
      document.body.classList.remove('rail-confirm-open');
      setTimeout(() => { confirm.hidden = true; }, reduced ? 0 : 240);
    };
    const openConfirm = (row) => {
      if (!confirm) return;
      confirmRow = row;
      const heading = confirm.querySelector('h2');
      const copy = confirm.querySelector('p');
      const liked = row.classList.contains('is-liked');
      if (heading) heading.textContent = liked ? 'Сначала заменить лайк?' : 'Пометить событие как неинтересное?';
      if (copy) copy.textContent = liked
        ? 'Негативный сигнал заменит ваш лайк. После подтверждения следующие свайпы будут отмечать события без подтверждения. Любую отметку можно отменить.'
        : 'После подтверждения следующие свайпы будут отмечать события без подтверждения. Любую отметку можно отменить.';
      confirm.hidden = false;
      document.body.classList.add('rail-confirm-open');
      requestAnimationFrame(() => confirm.classList.add('is-open'));
    };
    const commitNegative = (row, { rememberSwipeConsent = false } = {}) => {
      const negative = row?.querySelector('[data-rail-negative-control]');
      const like = row?.querySelector('[data-like]');
      if (!negative) return Promise.resolve(false);
      const wasLiked = row.classList.contains('is-liked');
      negative.click();
      return waitForPressed(negative, true).then((pressed) => {
        if (!pressed) return false;
        if (rememberSwipeConsent) rememberNegativeSwipeConsent();
        showToast('Событие отмечено как неинтересное', () => {
          negative.click();
          if (wasLiked) {
            void waitForPressed(negative, false).then((cleared) => {
              if (cleared && like?.getAttribute('aria-pressed') !== 'true') like?.click();
            });
          }
        });
        return true;
      });
    };
    const commitSwipeNegative = (row) => {
      if (hasNegativeSwipeConsent()) {
        void commitNegative(row);
        return;
      }
      openConfirm(row);
    };
    confirm?.addEventListener('click', (event) => {
      if (event.target === confirm || event.target.closest('[data-rail-confirm-cancel]')) closeConfirm();
      if (!event.target.closest('[data-rail-confirm-negative]') || !confirmRow) return;
      const row = confirmRow;
      closeConfirm();
      void commitNegative(row, { rememberSwipeConsent:true });
    });
    const syncPinnedTitle = () => {
      pinFrame = 0;
      const pinned = Boolean(pinSentinel && pinSentinel.getBoundingClientRect().top <= 64);
      document.body.classList.toggle('is-date-pinned', pinned);
      stickyTitle?.setAttribute('aria-hidden', String(!pinned));
    };
    function applyCity(city) {
      selectedCity = city;
      rows.forEach((row) => {
        syncRowVisibility(row);
      });
