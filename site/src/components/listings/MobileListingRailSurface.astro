    .ke-mobile-listing-rails--v23 .event-media{position:relative;flex:0 0 var(--media-width);width:var(--media-width);height:112px;border-radius:12px;background:linear-gradient(105deg,#e9dece 8%,#fff7eb 20%,#e9dece 34%);background-size:220% 100%;animation:mobile-rail-media-skeleton 1.25s ease-in-out infinite}.ke-mobile-listing-rails--v23 .event-media img{opacity:0;transition:opacity 180ms ease;pointer-events:none;user-select:none}.ke-mobile-listing-rails--v23 .event-media.is-loaded{animation:none;background:transparent}.ke-mobile-listing-rails--v23 .event-media.is-loaded img{opacity:1}.ke-mobile-listing-rails--v23 .event-media.is-error{animation:none;background:#e9dece}.ke-mobile-listing-rails--v23 .event-media--natural.is-loaded{background:#211d1a}@keyframes mobile-rail-media-skeleton{to{background-position-x:-220%}}
    .ke-mobile-listing-rails--v23 .event-media.is-loaded.is-temporally-muted>img{opacity:.46;filter:grayscale(.72) saturate(.32)}
    .ke-mobile-listing-rails--v23 .event-digest{flex:0 0 168px;width:168px;height:112px;display:flex;align-items:center;padding:8px 10px;color:var(--rail-text)}.ke-mobile-listing-rails--v23 .event-digest__body{width:148px;max-height:96px;display:grid;gap:4px}.ke-mobile-listing-rails--v23 .event-digest b{font:850 8.5px/10px var(--ke-font-family-sans);letter-spacing:.045em;text-transform:uppercase}.ke-mobile-listing-rails--v23 .event-digest span{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:6;font:690 10.5px/12.5px var(--ke-font-family-sans)}
    .ke-mobile-listing-rails--v23 .event-medallion-slot{position:relative;flex:0 0 94px;width:94px;height:112px;display:grid;place-items:center;overflow:visible}.ke-mobile-listing-rails--v23 .event-medallion-slot picture{display:block;width:86px;height:86px}.ke-mobile-listing-rails--v23 .event-medallion{display:block;width:86px;height:86px;border:0;border-radius:50%;object-fit:contain;box-shadow:0 0 0 2px rgba(121,48,20,.13),0 7px 16px rgba(72,45,25,.12)}.ke-mobile-listing-rails--v23 .event-medallion--free{box-shadow:none}
