---
import type { PreviewEvent } from '../../lib/types';
import { displayDate, displayDateRange, eventAdmissionLabel, eventHref, getOccurrencePresentation, withBase } from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';
import { occurrenceTime } from '../../lib/eventOccurrences';
import { selectListingImage } from '../../lib/listingPresentation';
import { resolveMobileListingRailMediaItems } from '../../lib/mobileListingRailMedia.mjs';
import { getListingIdentityMedallions } from '../../lib/listingVenueMedallions';
import './mobile-listing-foundation-bindings.css';
import Icon from '../Icon.astro';
import AmberRailArtifact from './AmberRailArtifact.astro';

interface Props {
  event: PreviewEvent;
  occurrenceMode?: 'per-date' | 'per-family';
  priority?: boolean;
  amberArtifactTail?: boolean;
}

const { event, occurrenceMode = 'per-date', priority = false, amberArtifactTail = false } = Astro.props;
const image = selectListingImage(event, 1.25);
const railMediaItems = resolveMobileListingRailMediaItems(event, image);
const occurrence = occurrenceMode === 'per-family' ? getOccurrencePresentation(event) : null;
const fullDateLine = displayDate(event);
const compactRailDateRange = event.end_date && event.end_date !== event.start_date
  ? displayDateRange(event.start_date, event.end_date).replace(/\s+—\s+/u, '–')
  : null;
const dateLine = compactRailDateRange || occurrence?.railDateLine || fullDateLine;
const timeLine = occurrence?.railTimeLine || occurrenceTime(event) || event.display_time || null;
const scheduleAria = compactRailDateRange
  ? [fullDateLine, timeLine].filter(Boolean).join(', ')
  : occurrence?.ariaLabel || [fullDateLine, timeLine].filter(Boolean).join(', ');
const place = [event.city, event.venue_name].filter(Boolean).join(' · ') || 'Место уточняется';
const identities = getListingIdentityMedallions(event).slice(0, event.ticket?.is_free ? 1 : 2);
const admission = eventAdmissionLabel(event);
const likesCount = event.likes_count || 0;
const href = eventHref(event);
const useDatePrimary = occurrenceMode === 'per-family' && Boolean(occurrence);
const noExactTime = !timeLine;
const scheduleState = compactRailDateRange ? 'date-range' : noExactTime ? 'no-time' : 'exact-time';
const mediaCountState = railMediaItems.length > 1 ? 'multi-media' : 'single-media';
const rowState = [
  scheduleState,
  mediaCountState,
  priority ? 'priority' : 'lazy',
  `identity-${identities.length}`,
  event.ticket?.is_free ? 'free-admission' : null,
  amberArtifactTail ? 'amber-tail' : null,
].filter(Boolean).join(' ');
const mediaFrameKind = (railMedia: (typeof railMediaItems)[number]) => railMedia.imageTextMode === 'visual_only'
  ? 'visual'
  : railMedia.imageTextMode === 'ocr_text'
    ? 'document'
    : 'unknown';
const medallionFallbackSrc = (medallion: (typeof identities)[number]) => medallion.avatarUrl.endsWith('.webp')
  ? (medallion.fallbackPngUrl || medallion.avatarUrl)
  : medallion.avatarUrl;
---
<article
  class="event-row"
  data-ds-family="MobileListingRailRow"
  data-ds-version="1"
  data-ds-variant={occurrenceMode}
  data-ds-state={rowState}
  data-mobile-listing-row
  data-feedback-scope
  data-event={event.id}
  data-event-id={event.id}
  data-event-title={event.title}
  data-event-starts-at={event.starts_at || undefined}
  data-event-end-at={event.end_at || undefined}
  data-listing-city={event.city || 'Калининградская область'}
  data-listing-event-type={event.event_type || 'other'}
  data-mobile-rail-gallery-count={railMediaItems.length}
  data-mobile-rail-media-reason={railMediaItems[0]?.reason}
>
  <div class="rail-window" tabindex="0" aria-label={`${event.title}. ${scheduleAria}. ${railMediaItems.length > 1 ? `${railMediaItems.length} фото, ` : 'Фото, '}описание и действия доступны горизонтальным листанием`}>
    <span class="dislike-underlay" aria-hidden="true"><span>Неинтересно</span></span>
    <span class="like-underlay" aria-hidden="true"><Icon name="heart" className="ke-icon-role ke-icon-role--feature" /></span>
    <span class="event-track">
      <a class="event-link" href={href} data-prefetch aria-label={`${event.title}. ${scheduleAria}`}>
        <span class="track-start"></span>
        <span class:list={['event-summary', useDatePrimary && 'event-summary--family']}>
          <span class:list={['event-time', useDatePrimary && 'event-time--date-primary', noExactTime && 'event-time--no-time']} aria-label={scheduleAria}>
            {useDatePrimary ? (
              <><strong>{dateLine}</strong>{timeLine && <span class="event-date-line">{timeLine}</span>}</>
            ) : noExactTime ? (
              <><strong class="program-label">Программа<br />дня</strong><span class:list={['event-date-line', compactRailDateRange && 'event-date-line--range']}>{dateLine}</span></>
            ) : (
              <><strong>{timeLine}</strong><span class:list={['event-date-line', compactRailDateRange && 'event-date-line--range']}>{dateLine}</span></>
            )}
          </span>
          <span class="event-info">
            <span class="event-title">{event.title}</span>
            <span class="event-description">{place}</span>
            <span class="event-signals">
              <span class="event-signal event-signal--like" data-small-like hidden={likesCount <= 0}>
                <Icon name="heart" className="ke-icon-role ke-icon-role--inline" />
                <span data-small-like-count>{likesCount}</span>
              </span>
            </span>
          </span>
          <span class="event-cue" aria-hidden="true">
            <svg viewBox="0 0 48 23"><path d="M3 11.5H40M31 2.5L40 11.5L31 20.5"></path></svg>
          </span>
        </span>
        {railMediaItems.map((railMedia, mediaIndex) => {
          const imageUrl = railMedia.src.startsWith('/') ? withBase(railMedia.src) : eventImageUrl(railMedia.src);
          const [focusX = '50%', focusY = '50%'] = railMedia.objectPosition.split(/\s+/u);
          const loading = priority && mediaIndex === 0 ? 'eager' : 'lazy';
          const style = `--media-width:${railMedia.width}px;--focus-x:${focusX};--focus-y:${focusY};--rail-media-fit:${railMedia.fit};--media-frame-ratio:${railMedia.ratio};--media-frame-object-position:${railMedia.objectPosition}`;
          return imageUrl ? (
            <span
              class:list={['event-media', 'is-loading', railMedia.fit === 'contain' && 'event-media--natural', railMedia.imageTextMode === 'ocr_text' && 'event-media--ocr']}
              data-media-frame
              data-media-frame-contract="v1"
              data-media-frame-surface="mobile-listing-rail"
              data-media-frame-kind={mediaFrameKind(railMedia)}
              data-media-frame-fit={railMedia.fit}
              data-media-frame-ratio={railMedia.ratio}
              data-media-frame-object-position={railMedia.objectPosition}
              data-media-frame-crop-reason={railMedia.reason}
              data-media-frame-source-width={railMedia.asset?.width || undefined}
              data-media-frame-source-height={railMedia.asset?.height || undefined}
              data-media-frame-loading={loading}
              data-media-frame-priority={priority && mediaIndex === 0 ? 'true' : undefined}
              data-media-frame-interaction-owner="caller"
              data-image-text-mode={railMedia.imageTextMode}
              data-media-state="loading"
              data-rail-media-reason={railMedia.reason}
              data-rail-media-fit={railMedia.fit}
              data-rail-media-ratio={railMedia.ratio}
              data-rail-gallery-index={mediaIndex}
              data-rail-gallery-count={railMediaItems.length}
              style={style}
            >
              <img
                data-media-frame-image
                src={imageUrl}
                width={railMedia.asset?.width || undefined}
                height={railMedia.asset?.height || undefined}
                alt=""
                loading={loading}
                fetchpriority={priority && mediaIndex === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </span>
          ) : null;
        })}
        <span class="event-digest" aria-label="О событии">
          <span class="event-digest__body"><b>О событии</b><span>{event.summary || event.title}</span></span>
        </span>
        {identities.map((medallion) => (
          <span class="event-medallion-slot" aria-label={medallion.ariaLabel} title={medallion.name}>
            <picture>
              {medallion.avatarUrl.endsWith('.webp') && medallion.fallbackPngUrl
                ? <source srcset={withBase(medallion.avatarUrl)} type="image/webp" />
                : null}
              <img class="event-medallion" src={withBase(medallionFallbackSrc(medallion))} alt="" loading="lazy" decoding="async" />
            </picture>
          </span>
        ))}
        {event.ticket?.is_free && (
          <span class="event-medallion-slot event-medallion-slot--free" aria-label="Бесплатное событие">
            <img class="event-medallion event-medallion--free" src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" loading="lazy" decoding="async" />
          </span>
        )}
      </a>
      <button
        type="button"
        class="event-like-cta"
        data-like
        data-feedback-action="like"
        data-event-id={event.id}
        data-event-title={event.title}
        data-base-count={likesCount}
        aria-pressed="false"
        aria-label={`Поставить лайк: ${event.title}. Сейчас ${likesCount}`}
      >
        <Icon name="heart" className="ke-icon-role ke-icon-role--action" />
        <strong data-like-count data-feedback-count>{likesCount}</strong>
      </button>
      <button
        type="button"
        class="rail-negative-control"
        data-rail-negative-control
        data-feedback-action="not_interested"
        data-event-id={event.id}
        data-event-title={event.title}
        aria-pressed="false"
        tabindex="-1"
        hidden
      >Не интересно</button>
      {amberArtifactTail && <AmberRailArtifact eventId={event.id} placement="tail" />}
    </span>
  </div>
</article>
