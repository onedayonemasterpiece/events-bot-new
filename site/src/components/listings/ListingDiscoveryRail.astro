---
import ListingControls from './ListingControls.astro';

interface Props {
  cities: Array<{ name: string; count: number }>;
  total: number;
  label: string;
  hasTime?: boolean;
  dateContext?: {
    date: string;
    weekday: string;
  };
  topBandCandidate?: boolean;
  compactInitially?: boolean;
}
const { cities, total, label, hasTime = true, dateContext, topBandCandidate = false, compactInitially = false } = Astro.props;
---
<div
  class:list={[
    'ke-listing-discovery-rail',
    !hasTime && 'ke-listing-discovery-rail--cities-only',
    dateContext && 'ke-listing-discovery-rail--with-date-context',
  ]}
  data-ds-component="ListingDiscoveryRail"
  data-ds-version="5"
  data-listing-discovery-rail
  data-fi-compact-initial-rail={compactInitially || undefined}
  data-has-time={hasTime ? 'true' : 'false'}
  data-islands-eligible-controls={topBandCandidate ? '' : undefined}
>
  <div class="ke-listing-discovery-rail__inner">
    {dateContext ? (
      <div class="ke-listing-discovery-rail__date-context" data-listing-rail-date-context aria-hidden="true">
        <strong>{dateContext.date}</strong>
        <small>{dateContext.weekday}</small>
      </div>
    ) : null}
    <ListingControls cities={cities} total={total} label={label} compactInitially={compactInitially} />
    {hasTime ? <div class="ke-listing-discovery-rail__time"><slot /></div> : null}
  </div>
</div>

{dateContext ? (
  <script>
    document.querySelectorAll('[data-listing-discovery-rail]:has([data-listing-rail-date-context])').forEach((rail) => {
      if (rail.dataset.dateContextReady === 'true') return;
      rail.dataset.dateContextReady = 'true';
      const context = rail.querySelector('[data-listing-rail-date-context]');
      const desktop = matchMedia('(min-width: 981px)');
      let frame = 0;
      const syncPinnedContext = () => {
        frame = 0;
        const header = document.querySelector('.site-header');
        const railBox = rail.getBoundingClientRect();
        const headerBottom = header?.getBoundingClientRect().bottom || 0;
        const pinned = desktop.matches && scrollY > 0 && Math.abs(railBox.top - headerBottom) <= 1;
        rail.classList.toggle('is-pinned', pinned);
        context?.setAttribute('aria-hidden', String(!pinned));
      };
      const scheduleSync = () => {
        if (!frame) frame = requestAnimationFrame(syncPinnedContext);
      };
      addEventListener('scroll', scheduleSync, { passive:true });
      addEventListener('resize', scheduleSync, { passive:true });
      desktop.addEventListener?.('change', scheduleSync);
      syncPinnedContext();
    });
  </script>
) : null}
