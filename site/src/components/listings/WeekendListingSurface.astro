---
import type { PreviewEvent } from '../../lib/types';
import { deduplicateListingEvents, eventCountLabel, groupListingEvents } from '../../lib/listingPresentation';
import { IS_PRODUCTION, withBase } from '../../lib/events';
import ListingDiscoveryRail from './ListingDiscoveryRail.astro';
import ListingPageHeader from './ListingPageHeader.astro';
import ListingWeekendTimeNav from './ListingWeekendTimeNav.astro';
import WeekendEditorialTimeline from './WeekendEditorialTimeline.astro';
import WeekendRangeNav from './WeekendRangeNav.astro';
import ListingPersonalFilter from '../ListingPersonalFilter.astro';
import MobileListingRailSurface from './MobileListingRailSurface.astro';

interface WeekendLink { href?: string | null; label: string; }
interface WeekendRangeLink { href: string; label: string; selected?: boolean; actualCurrent?: boolean; }
interface Props { events: PreviewEvent[]; start: string; end: string; dateLabel: string; currentDate?: string; previous?: WeekendLink | null; next?: WeekendLink | null; ranges?: WeekendRangeLink[]; }
const { events: rawEvents, start, end, dateLabel, currentDate = '', previous = null, next = null, ranges = [] } = Astro.props;
const events = deduplicateListingEvents(rawEvents);
const AMBER_ARTIFACT_EVENT_ID = 6939;
const amberArtifactResearchEnabled =
  !IS_PRODUCTION
  && import.meta.env.PUBLIC_ENABLE_AMBER_ARTIFACT_RESEARCH === 'tail';
const amberArtifactResearchEvent =
  events.find((event) => event.id === AMBER_ARTIFACT_EVENT_ID)
  || events.find((event) => event.start_date === start)
  || events[0];
const amberArtifactTailEventId =
  amberArtifactResearchEnabled && amberArtifactResearchEvent
    ? amberArtifactResearchEvent.id
    : null;
const days = [
  { key: 'sat', title: 'Суббота', date: start, events: events.filter((event) => event.start_date === start) },
  { key: 'sun', title: 'Воскресенье', date: end, events: events.filter((event) => event.start_date === end) },
].map((day) => ({ ...day, groups: groupListingEvents(day.events) }));
const cities = [...new Set(events.map((event) => event.city || 'Калининградская область'))]
  .map((name) => ({ name, count: events.filter((event) => (event.city || 'Калининградская область') === name).length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name, 'ru'));
function dayDateLabel(date: string): string {
  return new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', timeZone: 'Europe/Kaliningrad' }).format(new Date(`${date}T12:00:00+02:00`));
}
---
<div class="ke-listing-shell" data-date-listing="weekend" data-listing-variant="DATE-LISTING-V19" data-listing-has-time-nav="true" data-weekend-start={start} data-weekend-end={end} data-current-date={currentDate} data-amber-artifact-research={amberArtifactTailEventId ? 'tail' : 'off'}>
  <ListingPageHeader title="Выходные" dateLabel={dateLabel} count={events.length} current="weekend" />
  {ranges.length ? <WeekendRangeNav ranges={ranges} placement="top" /> : null}
  <ListingDiscoveryRail cities={cities} total={events.length} label="на выходных">
    <ListingWeekendTimeNav days={days.map((day) => ({ key: day.key as 'sat' | 'sun', short: day.key === 'sat' ? 'Сб' : 'Вс', dateLabel: dayDateLabel(day.date), groups: day.groups }))} />
  </ListingDiscoveryRail>
  <MobileListingRailSurface
    sections={days.map((day) => ({ id:`weekend-${day.key}`, title:`${day.title}, ${dayDateLabel(day.date)}`, events:day.events }))}
    occurrenceMode="per-date"
    title="Выходные"
    meta={`${dateLabel} · ${events.length} ${eventCountLabel(events.length)}`}
    feedTitle="По времени"
    feedMeta="Фото → о событии → лайк"
    current="weekend"
    cities={cities}
    calendarToday={currentDate || start}
    calendarDate={start}
    weekendEnd={end}
    amberArtifactTailEventId={amberArtifactTailEventId}
  />
  <div class="ke-listing-desktop-body" data-listing-representation="desktop">
  <div class="ke-weekend-board">
    <div class="ke-weekend-heads" aria-label="Дни выходных">
      <div class="ke-weekend-heads__time" aria-hidden="true"></div>
      {days.map((day) => (
        <header class:list={['ke-weekend-day__head', `ke-weekend-day__head--${day.key}`]} id={`weekend-${day.key}-label`} data-weekend-day-summary={day.key}>
          <div class="ke-weekend-day__head-main">
            <b class="ke-weekend-weekday-chip">{day.key === 'sat' ? 'Сб' : 'Вс'}</b>
            <div><span class="ke-weekend-day__label">{day.title}</span><p>{dayDateLabel(day.date)}</p></div>
          </div>
          <span class="ke-weekend-day__count" data-weekend-day-count={day.key} data-weekend-day-count-value={day.events.length}>{day.events.length} {eventCountLabel(day.events.length)}</span>
        </header>
      ))}
    </div>
    <WeekendEditorialTimeline days={days.map((day) => ({ key: day.key as 'sat' | 'sun', title: day.title, date: day.date, groups: day.groups }))} />
  </div>
  {ranges.length ? <WeekendRangeNav ranges={ranges} placement="bottom" /> : (previous || next) ? (
    <nav class="ke-weekend-adjacent" aria-label="Другие выходные">
      <div>
        {previous?.href ? <a href={withBase(previous.href)}>← {previous.label}</a> : previous ? <span aria-disabled="true">← {previous.label} · события пока не опубликованы</span> : null}
      </div>
      <div>
        {next?.href ? <a href={withBase(next.href)}>{next.label} →</a> : next ? <span aria-disabled="true">{next.label} · события пока не опубликованы →</span> : null}
      </div>
    </nav>
  ) : null}
  <div class="ke-weekend-autoposition" role="status" aria-live="polite" hidden data-weekend-autoposition-status>
    <span></span><button type="button" data-weekend-back-to-top>К началу</button>
  </div>
  </div>
  <ListingPersonalFilter total={events.length} label="на выходных" version={2} placement="floating" />
</div>

<script>
  const weekendRoot = document.querySelector('[data-date-listing="weekend"]');
  function kaliningradNow() {
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Kaliningrad', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const value = Object.fromEntries(parts.map((part) => [part.type, part.value]));
    return { date: `${value.year}-${value.month}-${value.day}`, time: `${value.hour}:${value.minute}` };
  }
  function applyWeekendPastState() {
    if (!weekendRoot) return;
    const now = Date.now();
    const clock = kaliningradNow();
    weekendRoot.querySelectorAll('[data-listing-item]').forEach((card) => {
      const group = card.closest('[data-listing-time-group]');
      const date = group?.dataset.listingDate || '';
      const endAt = card.dataset.eventEndAt || '';
      const startAt = card.dataset.eventStartAt || '';
      const endMs = Date.parse(endAt);
      const startMs = Date.parse(startAt);
      const finiteEnd = Number.isFinite(endMs);
      const explicitlyEnded = finiteEnd && endMs <= now;
      const pastDay = date && date < clock.date;
      const startedEarlier = !pastDay && !explicitlyEnded && !finiteEnd && date === clock.date
        && Number.isFinite(startMs) && startMs <= now - 60 * 60 * 1000;
      card.dataset.listingPast = explicitlyEnded || pastDay ? 'true' : 'false';
      card.dataset.listingStartedEarlier = startedEarlier ? 'true' : 'false';
      const status = card.querySelector('[data-listing-temporal-status]');
      if (status) {
        status.hidden = !(explicitlyEnded || pastDay || startedEarlier);
        status.textContent = explicitlyEnded ? 'Завершилось' : pastDay ? 'Прошло' : startedEarlier ? 'Началось ранее' : '';
      }
    });
  }
  function maybePositionCurrentSunday() {
    if (!weekendRoot) return;
    const clock = kaliningradNow();
    if (clock.date !== weekendRoot.dataset.weekendEnd || weekendRoot.dataset.currentDate !== clock.date) return;
    if (location.hash || scrollY > 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const nav = performance.getEntriesByType('navigation')[0];
    if (nav?.type && nav.type !== 'navigate') return;
    let cancelled = false;
    const cancel = () => { cancelled = true; };
    ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((name) => addEventListener(name, cancel, { once: true, passive: true }));
    setTimeout(() => {
      if (cancelled || scrollY > 2) return;
      const candidates = [...weekendRoot.querySelectorAll('[data-listing-day="sun"][data-listing-time]')]
        .filter((group) => group.dataset.listingTime !== 'untimed' && group.dataset.listingTime >= clock.time && !group.hidden);
      const target = candidates[0];
      if (!target) return;
      target.closest('[data-weekend-time-row]')?.scrollIntoView({ block: 'start', behavior: 'instant' });
      const status = weekendRoot.querySelector('[data-weekend-autoposition-status]');
      if (status) {
        status.hidden = false;
        status.querySelector('span').textContent = `Показаны события воскресенья с ${target.dataset.listingTime}`;
        setTimeout(() => { status.hidden = true; }, 8000);
      }
    }, 350);
  }
  weekendRoot?.querySelector('[data-weekend-back-to-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  async function alignWeekendHashAfterLayout() {
    if (!weekendRoot || !location.hash.startsWith('#weekend-time-')) return;
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!target) return;
    await window.KEAlignListingTarget?.(target, { preserveIfVisible: false });
  }
  applyWeekendPastState();
  window.setInterval(applyWeekendPastState, 60_000);
  maybePositionCurrentSunday();
  document.fonts?.ready.then(alignWeekendHashAfterLayout);
  addEventListener('hashchange', alignWeekendHashAfterLayout);
  addEventListener('kenigevents:listing-discovery-measured', alignWeekendHashAfterLayout);
</script>
