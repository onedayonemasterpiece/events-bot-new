---
import type { PreviewEvent } from '../../lib/types';
import Icon from '../Icon.astro';
import { eventHref } from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';
import { cityKey, selectListingImage } from '../../lib/listingPresentation';
import { getListingIdentityMedallions, getListingVenueMedallion } from '../../lib/listingVenueMedallions';
import { withBase } from '../../lib/events';
import '../media-frame.css';

export type ListingEventCardRootAttributeValue = string | number | boolean | null | undefined;
export type ListingEventCardRootAttributes = Record<string, ListingEventCardRootAttributeValue>;

interface Props {
  event: PreviewEvent;
  density?: 'regular' | 'weekend' | 'popular';
  priority?: boolean;
  temporalLabel?: string;
  familyKey?: string;
  supplemental?: boolean;
  rootClassName?: string;
  rootAttributes?: ListingEventCardRootAttributes;
  hidden?: boolean;
}

const {
  event,
  density = 'regular',
  priority = false,
  temporalLabel,
  familyKey,
  supplemental = false,
  rootClassName = '',
  rootAttributes = {},
  hidden = false,
} = Astro.props;
const href = eventHref(event);
const targetRatio = density === 'weekend' ? 1.2 : density === 'popular' ? 1.25 : 1.35;
const image = selectListingImage(event, targetRatio);
const mediaFrameKind = !image.asset
  ? 'fallback'
  : image.asset.media_semantic_status === 'error'
    ? 'unknown'
    : image.mode.startsWith('visual-')
      ? 'visual'
      : image.asset.image_text_mode === 'ocr_text'
        ? 'document'
        : 'unknown';
const mediaFrameFit = image.mode.endsWith('-crop') ? 'cover' : 'contain';
const mediaFrameCropReason = !image.asset
  ? 'listing_fallback'
  : image.asset.media_semantic_status === 'error'
    ? 'semantic_error_fail_closed'
    : image.adaptiveCrop
      ? `listing_reviewed_crop:${image.asset.listing_crop_evidence || 'classified_safe_crop'}`
      : `listing_natural:${image.mode}`;
const derivatives = [...(image.asset?.thumbnail_sources || [])]
  .filter((item) => item.src && item.width > 0 && item.height > 0)
  .sort((left, right) => left.width - right.width);
const responsiveCandidates = [...derivatives];
if (
  image.asset?.src
  && image.asset.width > (responsiveCandidates.at(-1)?.width || 0)
  && !responsiveCandidates.some((item) => item.src === image.asset?.src)
) {
  // The CDN inventory can legitimately stop at 512w. Keep the encoded
  // original as the last DPR safety candidate instead of silently upscaling
  // on compact high-density cards (OCR regression contract: event 6869).
  responsiveCandidates.push({ src: image.asset.src, width: image.asset.width, height: image.asset.height });
}
const listingImageUrl = (src: string | null | undefined) => (
  src?.startsWith('/') ? withBase(src) : eventImageUrl(src)
);
const responsiveSrc = derivatives.at(-1)?.src || image.src;
const imageUrl = listingImageUrl(responsiveSrc);
const responsiveSrcset = responsiveCandidates.length
  ? responsiveCandidates.map((item) => `${listingImageUrl(item.src)} ${item.width}w`).join(', ')
  : undefined;
const responsiveSizes = density === 'weekend'
  // Weekend media can absorb spare row width after the client-side packer has
  // measured the two day columns. Declare that reviewed maximum rather than
  // the old 245px nominal width: the latter selected a 256w file for cards
  // that actually rendered as wide as 317px at DPR 1.
  ? '(min-width: 1880px) 340px, (max-width: 720px) 44vw, 320px'
  : density === 'popular'
    ? '(min-width: 1880px) 290px, (max-width: 720px) 86vw, 250px'
    : '(min-width: 1880px) 396px, (max-width: 720px) 38vw, 332px';
const overlayMedallion = getListingVenueMedallion(event, image.asset);
const identityMedallions = getListingIdentityMedallions(event);
const externalMedallions = overlayMedallion
  ? identityMedallions.filter((item) => item.slug !== overlayMedallion.slug)
  : identityMedallions;
const showFree = event.ticket?.is_free === true;
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count || 0;
const hasSocialProof = likesCount > 0 || sharesCount > 0;
const socialProofRows = Number(sharesCount > 0) + Number(likesCount > 0);
const proofInside = hasSocialProof && image.mode === 'visual-crop' && image.adaptiveCrop;
const identityLimit = 3;
const sideIdentityBudget = Math.max(0, identityLimit - (overlayMedallion ? 1 : 0));
const renderFree = showFree && sideIdentityBudget > 0;
const visibleExternalMedallions = externalMedallions.slice(0, Math.max(0, sideIdentityBudget - (renderFree ? 1 : 0)));
const visibleIdentityCount = visibleExternalMedallions.length + (renderFree ? 1 : 0);
const totalIdentityCount = visibleIdentityCount + (overlayMedallion ? 1 : 0);
const hasRailProof = hasSocialProof && !proofInside;
const hasSideRail = visibleIdentityCount > 0 || hasRailProof;
const splitIdentityProofRail = hasRailProof && visibleIdentityCount === 3 && density !== 'regular';
const tailWidth = splitIdentityProofRail ? 96 : hasSideRail ? (visibleIdentityCount === 0 ? 40 : 64) : 0;
const place = [event.venue_name, event.city].filter(Boolean).join(' · ');
const LISTING_EVENT_CARD_RESERVED_ROOT_ATTRIBUTES = new Set([
  'data-ds-component',
  'data-ds-family',
  'data-ds-version',
  'data-ds-variant',
  'data-ds-state',
  'data-feedback-scope',
  'data-listing-item',
  'data-listing-supplemental',
  'data-event-id',
  'data-listing-family-key',
  'data-event-title',
  'data-linked-event-ids',
  'data-listing-city',
  'data-listing-event-type',
  'data-listing-image-mode',
  'data-listing-crop-adaptive',
  'data-listing-crop-evidence',
  'data-listing-source-width',
  'data-listing-source-height',
  'data-listing-media-role',
  'data-listing-vertical-retention',
  'data-listing-low-resolution',
  'data-listing-density',
  'data-image-text-mode',
  'data-venue-medallion',
  'data-listing-has-social-proof',
  'data-listing-proof-placement',
  'data-listing-proof-rows',
  'data-listing-identity-count',
  'data-listing-side-identity-count',
  'data-listing-tail-layout',
  'data-listing-overlay-kind',
  'data-event-end-at',
  'data-event-start-at',
]);
const safeRootAttributes = Object.fromEntries(
  Object.entries(rootAttributes).filter(([name, value]) => (
    value !== undefined
    && value !== null
    && /^data-[a-z0-9_.:-]+$/u.test(name)
    && !LISTING_EVENT_CARD_RESERVED_ROOT_ATTRIBUTES.has(name)
  )),
);
const cardState = [
  priority && 'priority',
  supplemental && 'supplemental',
  temporalLabel && 'temporal-label',
  hasSocialProof && 'social-proof',
  totalIdentityCount > 0 && 'identity',
  showFree && 'free-admission',
  image.adaptiveCrop && 'adaptive-crop',
  `media-${mediaFrameKind}`,
  Object.keys(safeRootAttributes).length > 0 && 'consumer-metadata',
].filter(Boolean).join(' ') || undefined;
const mediaFrameRatio = image.ratio.toFixed(5);
const mediaFrameObjectPosition = image.objectPosition;
const mediaFrameRole = mediaFrameKind === 'fallback'
  ? 'fallback'
  : image.asset?.media_role || event.image_media_role || 'unknown_document';
const mediaFrameCropPermission = mediaFrameFit === 'cover'
  ? image.adaptiveCrop ? 'reviewed' : 'allowed'
  : 'forbidden';
const mediaFrameInitialState = imageUrl ? 'loading' : 'fallback';
const style = [
  `--ke-listing-image-ratio:${mediaFrameRatio}`,
  `--ke-listing-object-position:${mediaFrameObjectPosition}`,
  `--ke-listing-tail-width:${tailWidth}px`,
  `--media-frame-ratio:${mediaFrameRatio}`,
  `--media-frame-object-position:${mediaFrameObjectPosition}`,
  image.asset ? `--ke-listing-source-width:${image.asset.width}px` : '',
  image.asset ? `--ke-listing-source-height:${image.asset.height}px` : '',
].filter(Boolean).join(';');
const cardClass = ['ke-listing-card', rootClassName].filter(Boolean).join(' ');
const medallionStyle = (medallion: typeof overlayMedallion) => medallion
  ? [medallion.background ? `--venue-medallion-bg:${medallion.background}` : '', medallion.ring ? `--venue-medallion-ring:${medallion.ring}` : ''].filter(Boolean).join(';')
  : undefined;
const medallionFallbackSrc = (medallion: NonNullable<typeof overlayMedallion>) => medallion.avatarUrl.endsWith('.webp')
  ? (medallion.fallbackPngUrl || medallion.avatarUrl)
  : medallion.avatarUrl;
const socialProofLabel = [
  sharesCount > 0 ? `${sharesCount} поделились` : '',
  likesCount > 0 ? `${likesCount} отметок нравится` : '',
].filter(Boolean).join(', ');
---
<article
  {...safeRootAttributes}
  class={cardClass}
  style={style}
  hidden={hidden}
  data-ds-component="ListingEventCard"
  data-ds-family="ListingEventCard"
  data-ds-version="9"
  data-ds-variant={density}
  data-ds-state={cardState}
  data-feedback-scope
  data-listing-item
  data-listing-supplemental={supplemental ? 'true' : undefined}
  data-event-id={event.id}
  data-listing-family-key={familyKey}
  data-event-title={event.title}
  data-linked-event-ids={(event.other_date_ids || []).join(',')}
  data-listing-city={cityKey(event.city)}
  data-listing-event-type={cityKey(event.event_type || 'other')}
  data-listing-image-mode={image.mode}
  data-listing-crop-adaptive={image.adaptiveCrop ? 'true' : 'false'}
  data-listing-crop-evidence={image.asset?.listing_crop_evidence}
  data-listing-source-width={image.asset?.width}
  data-listing-source-height={image.asset?.height}
  data-listing-media-role={image.asset?.media_role}
  data-listing-vertical-retention={image.verticalRetention.toFixed(5)}
  data-listing-low-resolution={image.asset && image.asset.width < 320 ? 'true' : 'false'}
  data-listing-density={density}
  data-image-text-mode={image.asset?.image_text_mode || event.image_text_mode}
  data-venue-medallion={overlayMedallion?.slug || identityMedallions[0]?.slug}
  data-listing-has-social-proof={hasSocialProof ? 'true' : 'false'}
  data-listing-proof-placement={hasSocialProof ? (proofInside ? 'inside' : 'rail') : 'none'}
  data-listing-proof-rows={socialProofRows}
  data-listing-identity-count={totalIdentityCount}
  data-listing-side-identity-count={visibleIdentityCount}
  data-listing-tail-layout={splitIdentityProofRail ? 'split' : 'compact'}
  data-listing-overlay-kind={overlayMedallion ? (imageUrl ? 'reviewed-photo' : 'neutral-fallback') : 'none'}
  data-event-end-at={event.end_at || undefined}
  data-event-start-at={event.starts_at || undefined}
>
  <div class="ke-listing-card__visual">
  <a
    class="ke-listing-card__media ke-skeleton"
    href={href}
    data-prefetch
    aria-label={`Открыть событие: ${event.title}`}
    data-listing-media-loading
  >
    <span
      class="ke-listing-card__media-frame"
      data-media-frame
      data-media-frame-contract="v1"
      data-media-frame-style-owner="media-frame.css"
      data-media-frame-surface="listing-card"
      data-media-frame-role={mediaFrameRole}
      data-media-frame-kind={mediaFrameKind}
      data-media-frame-fit={mediaFrameFit}
      data-media-frame-crop-permission={mediaFrameCropPermission}
      data-media-frame-ratio={mediaFrameRatio}
      data-media-frame-object-position={mediaFrameObjectPosition}
      data-media-frame-focal-position={mediaFrameObjectPosition}
      data-media-frame-crop-reason={mediaFrameCropReason}
      data-media-frame-clip="frame"
      data-media-frame-radius="surface"
      data-media-frame-fill="true"
      data-media-frame-source-width={image.asset?.width}
      data-media-frame-source-height={image.asset?.height}
      data-media-frame-loading={priority ? 'eager' : 'lazy'}
      data-media-frame-priority={priority ? 'true' : undefined}
      data-media-frame-interaction-owner="caller"
      data-media-frame-state={mediaFrameInitialState}
    >
      {imageUrl ? (
        <img
          src={imageUrl}
          srcset={responsiveSrcset}
          sizes={responsiveSizes}
          width={image.asset?.width || undefined}
          height={image.asset?.height || undefined}
          alt={image.asset?.alt || event.image_alt || `Афиша события «${event.title}»`}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          data-listing-native-loading={priority ? 'eager' : 'lazy'}
          data-media-frame-image
        />
      ) : null}
      <span
        class="ke-listing-card__fallback"
        data-media-frame-fallback
        hidden={Boolean(imageUrl)}
        aria-hidden="true"
      >{event.event_type || 'событие'}</span>
    </span>
    {overlayMedallion ? (
      <span class="ke-listing-card__medallion" data-listing-medallion-slug={overlayMedallion.slug} style={medallionStyle(overlayMedallion)} title={overlayMedallion.name} aria-label={overlayMedallion.ariaLabel}>
        <picture>
          {overlayMedallion.avatarUrl.endsWith('.webp') && overlayMedallion.fallbackPngUrl
            ? <source srcset={withBase(overlayMedallion.avatarUrl)} type="image/webp" />
            : null}
          <img src={withBase(medallionFallbackSrc(overlayMedallion))} alt="" loading="lazy" decoding="async" />
        </picture>
      </span>
    ) : null}
  </a>
  {proofInside ? (
    <a class="ke-listing-card__social-proof ke-listing-card__social-proof--inside" href={href} data-prefetch data-nosnippet aria-label={`${socialProofLabel}. Открыть событие: ${event.title}`}>
      {sharesCount > 0 ? <span data-listing-share-proof data-base-count={sharesCount}><Icon name="share" /><b data-listing-share-count>{sharesCount}</b></span> : null}
      {likesCount > 0 ? <span data-listing-like-proof data-base-count={likesCount}><Icon name="heart" /><b data-listing-like-count>{likesCount}</b></span> : null}
    </a>
  ) : null}
  {hasSideRail ? (
    <div class="ke-listing-card__side-rail">
      {visibleIdentityCount > 0 ? (
        <div class="ke-listing-card__identity-rail" aria-label="Свойства события">
          {visibleExternalMedallions.map((medallion) => (
            <span class="ke-listing-card__identity-medallion" data-listing-medallion-slug={medallion.slug} style={medallionStyle(medallion)} title={medallion.name} aria-label={medallion.ariaLabel}>
              <picture>
                {medallion.avatarUrl.endsWith('.webp') && medallion.fallbackPngUrl ? <source srcset={withBase(medallion.avatarUrl)} type="image/webp" /> : null}
                <img src={withBase(medallionFallbackSrc(medallion))} alt="" loading="lazy" decoding="async" />
              </picture>
            </span>
          ))}
          {renderFree ? <span class="ke-listing-card__free-medallion" data-listing-medallion-slug="free" aria-label="Бесплатное событие"><img src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" /></span> : null}
        </div>
      ) : null}
      {hasSocialProof && !proofInside ? (
        <a class="ke-listing-card__social-proof" href={href} data-prefetch data-nosnippet aria-label={`${socialProofLabel}. Открыть событие: ${event.title}`}>
          {sharesCount > 0 ? <span data-listing-share-proof data-base-count={sharesCount}><Icon name="share" /><b data-listing-share-count>{sharesCount}</b></span> : null}
          {likesCount > 0 ? <span data-listing-like-proof data-base-count={likesCount}><Icon name="heart" /><b data-listing-like-count>{likesCount}</b></span> : null}
        </a>
      ) : null}
    </div>
  ) : null}
  </div>
  <div class="ke-listing-card__copy">
    {temporalLabel
      ? <span class="ke-listing-card__temporal-status" data-listing-temporal-status>{temporalLabel}</span>
      : <span class="ke-listing-card__temporal-status" data-listing-temporal-status hidden></span>}
    <a class="ke-listing-card__title" href={href} data-prefetch>{event.title}</a>
    {place ? <p>{place}</p> : null}
  </div>
</article>

<script>
  function initListingMediaSkeletons(root = document) {
    root.querySelectorAll('[data-listing-media-loading]').forEach((frame) => {
      if (!(frame instanceof HTMLElement) || frame.dataset.listingMediaReady === 'true') return;
      const mediaFrame = frame.querySelector('[data-media-frame]');
      const image = frame.querySelector('[data-media-frame-image]');
      const fallback = frame.querySelector('[data-media-frame-fallback]');
      const finish = (loaded) => {
        frame.classList.remove('ke-skeleton');
        frame.dataset.listingMediaReady = 'true';
        if (mediaFrame instanceof HTMLElement) mediaFrame.dataset.mediaFrameState = loaded ? 'loaded' : 'fallback';
        if (fallback instanceof HTMLElement) fallback.hidden = loaded;
        if (!loaded && image instanceof HTMLImageElement) {
          image.hidden = true;
          image.removeAttribute('srcset');
          image.removeAttribute('src');
        }
      };
      if (!(image instanceof HTMLImageElement)) {
        finish(false);
        return;
      }
      const decodeAndFinish = () => {
        if (!image.naturalWidth || !image.naturalHeight) {
          finish(false);
          return;
        }
        if (typeof image.decode !== 'function') {
          finish(true);
          return;
        }
        image.decode().then(() => finish(true)).catch(() => finish(image.naturalWidth > 0 && image.naturalHeight > 0));
      };
      if (image.complete) decodeAndFinish();
      else {
        image.addEventListener('load', decodeAndFinish, { once: true });
        image.addEventListener('error', () => finish(false), { once: true });
      }
    });
  }
  initListingMediaSkeletons();
</script>
