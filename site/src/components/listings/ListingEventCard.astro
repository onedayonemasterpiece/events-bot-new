---
import type { PreviewEvent } from '../../lib/types';
import Icon from '../Icon.astro';
import { eventHref } from '../../lib/events';
import { eventImageUrl } from '../../lib/assets';
import { cityKey, selectListingImage } from '../../lib/listingPresentation';
import { getListingIdentityMedallions, getListingVenueMedallion } from '../../lib/listingVenueMedallions';
import { withBase } from '../../lib/events';

interface Props { event: PreviewEvent; density?: 'regular' | 'weekend'; priority?: boolean }
const { event, density = 'regular', priority = false } = Astro.props;
const href = eventHref(event);
const targetRatio = density === 'weekend' ? 4 / 3 : 1.5;
const image = selectListingImage(event, targetRatio);
const derivatives = [...(image.asset?.thumbnail_sources || [])]
  .filter((item) => item.src && item.width > 0 && item.height > 0)
  .sort((left, right) => left.width - right.width);
const responsiveCandidates = [...derivatives];
if (
  image.asset?.src
  && image.asset.width > (responsiveCandidates.at(-1)?.width || 0)
  && !responsiveCandidates.some((item) => item.src === image.asset?.src)
) {
  // The CDN inventory can legitimately stop at 512w. Keep the encoded
  // original as the last DPR safety candidate instead of silently upscaling
  // on compact high-density cards (OCR regression contract: event 6869).
  responsiveCandidates.push({ src: image.asset.src, width: image.asset.width, height: image.asset.height });
}
const listingImageUrl = (src: string | null | undefined) => (
  src?.startsWith('/') ? withBase(src) : eventImageUrl(src)
);
const responsiveSrc = derivatives.at(-1)?.src || image.src;
const imageUrl = listingImageUrl(responsiveSrc);
const responsiveSrcset = responsiveCandidates.length
  ? responsiveCandidates.map((item) => `${listingImageUrl(item.src)} ${item.width}w`).join(', ')
  : undefined;
const responsiveSizes = density === 'weekend'
  ? (image.asset?.listing_crop_evidence === 'source-reviewed'
      ? '(min-width: 1880px) 297px, (max-width: 720px) 38vw, 267px'
      : '(min-width: 1880px) 291px, (max-width: 720px) 38vw, 245px')
  : '(min-width: 1880px) 396px, (max-width: 720px) 38vw, 332px';
const overlayMedallion = getListingVenueMedallion(event, image.asset);
const identityMedallions = getListingIdentityMedallions(event);
const externalMedallions = overlayMedallion
  ? identityMedallions.filter((item) => item.slug !== overlayMedallion.slug)
  : identityMedallions;
const showFree = event.ticket?.is_free === true;
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count || 0;
const hasSocialProof = likesCount > 0 || sharesCount > 0;
const identityLimit = hasSocialProof ? 2 : 3;
const visibleExternalMedallions = externalMedallions.slice(0, Math.max(0, identityLimit - (showFree ? 1 : 0)));
const visibleIdentityCount = Math.min(identityLimit, visibleExternalMedallions.length + (showFree ? 1 : 0));
const hasSideRail = visibleIdentityCount > 0 || hasSocialProof;
const tailWidth = hasSideRail ? 64 : 0;
const place = [event.venue_name, event.city].filter(Boolean).join(' · ');
const style = [
  `--ke-listing-image-ratio:${image.ratio.toFixed(5)}`,
  `--ke-listing-object-position:${image.objectPosition}`,
  `--ke-listing-tail-width:${tailWidth}px`,
  image.asset ? `--ke-listing-source-width:${image.asset.width}px` : '',
  image.asset ? `--ke-listing-source-height:${image.asset.height}px` : '',
].filter(Boolean).join(';');
const medallionStyle = (medallion: typeof overlayMedallion) => medallion
  ? [medallion.background ? `--venue-medallion-bg:${medallion.background}` : '', medallion.ring ? `--venue-medallion-ring:${medallion.ring}` : ''].filter(Boolean).join(';')
  : undefined;
const medallionFallbackSrc = (medallion: NonNullable<typeof overlayMedallion>) => medallion.avatarUrl.endsWith('.webp')
  ? (medallion.fallbackPngUrl || medallion.avatarUrl)
  : medallion.avatarUrl;
const socialProofLabel = [
  sharesCount > 0 ? `${sharesCount} поделились` : '',
  likesCount > 0 ? `${likesCount} отметок нравится` : '',
].filter(Boolean).join(', ');
---
<article
  class="ke-listing-card"
  style={style}
  data-ds-component="ListingEventCard"
  data-ds-version="6"
  data-feedback-scope
  data-listing-item
  data-event-id={event.id}
  data-event-title={event.title}
  data-linked-event-ids={(event.other_date_ids || []).join(',')}
  data-listing-city={cityKey(event.city)}
  data-listing-image-mode={image.mode}
  data-listing-crop-adaptive={image.adaptiveCrop ? 'true' : 'false'}
  data-listing-crop-evidence={image.asset?.listing_crop_evidence}
  data-listing-source-width={image.asset?.width}
  data-listing-source-height={image.asset?.height}
  data-listing-media-role={image.asset?.media_role}
  data-listing-vertical-retention={image.verticalRetention.toFixed(5)}
  data-listing-low-resolution={image.asset && image.asset.width < 320 ? 'true' : 'false'}
  data-listing-density={density}
  data-image-text-mode={image.asset?.image_text_mode || event.image_text_mode}
  data-venue-medallion={overlayMedallion?.slug || identityMedallions[0]?.slug}
  data-listing-has-social-proof={hasSocialProof ? 'true' : 'false'}
  data-listing-identity-count={visibleIdentityCount}
  data-listing-side-identity-count={visibleIdentityCount}
  data-event-end-at={event.end_at || undefined}
  data-event-start-at={event.starts_at || undefined}
>
  <div class="ke-listing-card__visual">
  <a class="ke-listing-card__media ke-skeleton" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`} data-listing-media-loading>
    {imageUrl ? (
      <>
      <img
        src={priority ? imageUrl : undefined}
        srcset={priority ? responsiveSrcset : undefined}
        data-listing-src={priority ? undefined : imageUrl}
        data-listing-srcset={priority ? undefined : responsiveSrcset}
        sizes={responsiveSizes}
        width={image.asset?.width || undefined}
        height={image.asset?.height || undefined}
        alt={image.asset?.alt || event.image_alt || `Афиша события «${event.title}»`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      {!priority ? (
        <noscript><img src={imageUrl} srcset={responsiveSrcset} sizes={responsiveSizes} width={image.asset?.width || undefined} height={image.asset?.height || undefined} alt={image.asset?.alt || event.image_alt || `Афиша события «${event.title}»`} /></noscript>
      ) : null}
      </>
    ) : (
      <span class="ke-listing-card__fallback" aria-hidden="true">{event.event_type || 'событие'}</span>
    )}
    {overlayMedallion ? (
      <span class="ke-listing-card__medallion" style={medallionStyle(overlayMedallion)} title={overlayMedallion.name} aria-label={overlayMedallion.ariaLabel}>
        <picture>
          {overlayMedallion.avatarUrl.endsWith('.webp') && overlayMedallion.fallbackPngUrl
            ? <source srcset={withBase(overlayMedallion.avatarUrl)} type="image/webp" />
            : null}
          <img src={withBase(medallionFallbackSrc(overlayMedallion))} alt="" loading="lazy" decoding="async" />
        </picture>
      </span>
    ) : null}
  </a>
  {hasSideRail ? (
    <div class="ke-listing-card__side-rail">
      {visibleIdentityCount > 0 ? (
        <div class="ke-listing-card__identity-rail" aria-label="Свойства события">
          {visibleExternalMedallions.map((medallion) => (
            <span class="ke-listing-card__identity-medallion" style={medallionStyle(medallion)} title={medallion.name} aria-label={medallion.ariaLabel}>
              <picture>
                {medallion.avatarUrl.endsWith('.webp') && medallion.fallbackPngUrl ? <source srcset={withBase(medallion.avatarUrl)} type="image/webp" /> : null}
                <img src={withBase(medallionFallbackSrc(medallion))} alt="" loading="lazy" decoding="async" />
              </picture>
            </span>
          ))}
          {showFree && visibleIdentityCount > visibleExternalMedallions.length ? <span class="ke-listing-card__free-medallion" aria-label="Бесплатное событие"><img src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" /></span> : null}
        </div>
      ) : null}
      {hasSocialProof ? (
        <a class="ke-listing-card__social-proof" href={href} data-prefetch data-nosnippet aria-label={`${socialProofLabel}. Открыть событие: ${event.title}`}>
          {sharesCount > 0 ? <span data-listing-share-proof data-base-count={sharesCount}><Icon name="share" /><b data-listing-share-count>{sharesCount}</b></span> : null}
          {likesCount > 0 ? <span data-listing-like-proof data-base-count={likesCount}><Icon name="heart" /><b data-listing-like-count>{likesCount}</b></span> : null}
        </a>
      ) : null}
    </div>
  ) : null}
  </div>
  <div class="ke-listing-card__copy">
    <a class="ke-listing-card__title" href={href} data-prefetch>{event.title}</a>
    {place ? <p>{place}</p> : null}
  </div>
</article>

<script>
  function initListingMediaSkeletons(root = document) {
    root.querySelectorAll('[data-listing-media-loading]').forEach((frame) => {
      if (frame.dataset.listingMediaReady === 'true') return;
      const image = frame.querySelector(':scope > img');
      if (!image) {
        frame.classList.remove('ke-skeleton');
        frame.dataset.listingMediaReady = 'true';
        return;
      }
      const finish = () => {
        frame.classList.remove('ke-skeleton');
        frame.dataset.listingMediaReady = 'true';
      };
      const decodeAndFinish = () => image.decode?.().catch(() => {}).finally(finish) || finish();
      if (image.dataset.listingSrc && !image.currentSrc) {
        image.addEventListener('load', decodeAndFinish, { once: true });
        image.addEventListener('error', finish, { once: true });
      } else if (image.complete) decodeAndFinish();
      else {
        image.addEventListener('load', decodeAndFinish, { once: true });
        image.addEventListener('error', finish, { once: true });
      }
    });
  }
  initListingMediaSkeletons();

  if ('IntersectionObserver' in window) {
    const priorityObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const image = entry.target.querySelector(':scope > img');
        if (image?.loading === 'lazy') {
          image.fetchPriority = 'high';
          if (image.dataset.listingSrcset) image.srcset = image.dataset.listingSrcset;
          if (image.dataset.listingSrc) image.src = image.dataset.listingSrc;
        }
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '200px 0px' });
    document.querySelectorAll('[data-listing-media-loading]').forEach((frame) => priorityObserver.observe(frame));
  }
</script>
