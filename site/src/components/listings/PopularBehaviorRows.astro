---
import { listingEventFamilyKey, type PopularListingGroup } from '../../lib/listingPresentation';
import { popularDesktopTemporalLabel } from '../../lib/events';
import ListingEventCard from './ListingEventCard.astro';

interface Props { groups: PopularListingGroup[]; }
const { groups } = Astro.props;
let priorityIndex = 0;
---
<div class="ke-popular-behavior" data-ds-component="PopularBehaviorRows" data-ds-version="2">
  {groups.map((group) => (
    <section class="ke-popular-behavior__group" data-popular-behavior-group data-popular-reason={group.key} aria-labelledby={`popular-${group.key}`}>
      <header class="ke-popular-behavior__head">
        <h2 id={`popular-${group.key}`}>{group.label}</h2>
        <span data-popular-group-count>{group.events.length}</span>
      </header>
      <div class="ke-popular-behavior__row">
        {group.events.map((event) => <ListingEventCard event={event} density="popular" priority={priorityIndex++ < 4} temporalLabel={popularDesktopTemporalLabel(event)} familyKey={listingEventFamilyKey(event)} />)}
      </div>
    </section>
  ))}
  <slot />
</div>
