---
import Icon from '../Icon.astro';

interface Props {
  route: string;
  title: string;
  subtitle: string;
  originMapUrl: string;
  originMapLabel: string;
}

const { route, title, subtitle, originMapUrl, originMapLabel } = Astro.props;
---

<header class="transport-route-heading">
  <span class="transport-route-heading__badge" aria-label={`Автобус № ${route}`}>
    <Icon name="bus" />
    <strong>{route}</strong>
  </span>
  <span class="transport-route-heading__copy">
    <strong>{title}</strong>
    <small>{subtitle}</small>
  </span>
  <a
    class="transport-route-heading__map"
    href={originMapUrl}
    target="_blank"
    rel="noopener noreferrer nofollow"
    title="Открыть точку посадки на карте"
    aria-label={`${originMapLabel}: открыть точку посадки на карте`}
    data-transport-action="bus_origin_map_click"
  ><Icon name="pin" /></a>
</header>

<style>
  .transport-route-heading {
    display:grid;
    grid-template-columns:auto minmax(0,1fr) 44px;
    align-items:center;
    gap:.62rem;
  }
  .transport-route-heading__badge {
    width:3.1rem;
    min-height:3.1rem;
    display:grid;
    grid-template-columns:.8rem auto;
    place-content:center;
    align-items:center;
    gap:.12rem;
    border-radius:13px;
    color:var(--ke-color-kaup-transfer-action-text);
    background:var(--ke-color-transport-route);
    font-variant-numeric:tabular-nums;
  }
  .transport-route-heading__badge :global(.icon) { width:.8rem; height:.8rem; fill:currentColor; }
  .transport-route-heading__badge strong { font-size:.9rem; line-height:1; }
  .transport-route-heading__copy { min-width:0; display:grid; gap:.1rem; }
  .transport-route-heading__copy>strong { color:var(--ke-color-transport-route-text); font-size:1rem; line-height:1.17; }
  .transport-route-heading__copy small { color:var(--ke-color-transport-route-muted); font-size:.75rem; line-height:1.28; }
  .transport-route-heading__map {
    width:44px;
    min-height:44px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    color:var(--ke-color-transport-route);
    text-decoration:none;
  }
  .transport-route-heading__map:hover { background:var(--ke-color-transport-route-hover); }
  .transport-route-heading__map:focus-visible { outline:3px solid var(--ke-color-transport-focus); outline-offset:2px; }
  .transport-route-heading__map :global(.icon) { width:1.08rem; height:1.08rem; }
  @container kaup-transport (max-width:390px) {
    .transport-route-heading { grid-template-columns:auto minmax(0,1fr) 40px; gap:.5rem; }
    .transport-route-heading__badge { width:2.8rem; min-height:2.8rem; border-radius:11px; }
    .transport-route-heading__copy>strong { font-size:.94rem; }
    .transport-route-heading__copy small { font-size:.7rem; }
    .transport-route-heading__map { width:40px; min-height:44px; }
  }
</style>
