---
import type { KaupBusOption } from '../../lib/eventKaupTransport';

interface Props { route: string; arrivalStop: string; options: KaupBusOption[]; }
const { route, arrivalStop, options } = Astro.props;
const additionalCount = Math.max(0, options.length - 1);
const mod100 = additionalCount % 100;
const mod10 = additionalCount % 10;
const additionalLabel = mod100 >= 11 && mod100 <= 14 ? 'рейсов' : mod10 === 1 ? 'рейс' : mod10 >= 2 && mod10 <= 4 ? 'рейса' : 'рейсов';
const suitableLabel = additionalCount === 1 ? 'подходящий' : 'подходящих';
---
<section class="transport-treatment transport-next" data-transport-treatment="next_departure_queue_v1" hidden aria-label={`Ближайший подходящий автобус № ${route}`}>
  <p class="transport-next__label">Ближайший подходящий · расчёт по расписанию</p>
  <div class="transport-next__primary" data-transport-next-slot></div>
  <details data-transport-queue-details>
    {additionalCount > 0 && <summary data-transport-action="schedule_expand">Ещё {additionalCount} {suitableLabel} {additionalLabel}</summary>}
    <ol data-transport-next-queue>
      {options.map((option) => <li data-transport-c-trip data-transport-trip-id={option.tripId} data-departure-at={option.departureAt}>
        <strong data-terminal-departure={option.terminalDeparture}>{option.departureEstimated ? '≈' : ''}{option.departure}</strong>
        <span>Северный <b>→ {arrivalStop} ≈{option.estimatedStopArrival}</b><small>→ Кауп ≈{option.estimatedVenueArrival}</small></span>
        {option.tight && <em>Небольшой запас</em>}
      </li>)}
    </ol>
  </details>
</section>

<style>
  .transport-treatment[hidden] { display:none !important; }
  .transport-next__label { margin:.45rem 0 .2rem; color:#91401f; font-size:.68rem; font-weight:900; letter-spacing:.05em; text-transform:uppercase; }
  .transport-next__primary { min-height:0; }
  .transport-next__primary :global(li) { margin:.2rem 0 .35rem; padding:.65rem .72rem; border:1px solid rgba(142,61,30,.22); border-radius:12px; background:#fff9f0; }
  summary { display:flex; align-items:center; min-height:44px; cursor:pointer; color:#8e3d1e; font-size:.76rem; font-weight:850; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  ol { display:grid; margin:0; padding:0; list-style:none; }
  li { display:grid; grid-template-columns:3.8rem minmax(0,1fr) auto; gap:.15rem .55rem; align-items:center; padding:.5rem 0; border-top:1px solid rgba(93,71,43,.12); font-variant-numeric:tabular-nums; }
  li>strong { font-size:.92rem; }
  li span { color:#51453d; font-size:.7rem; }
  li span b,li span small { display:block; color:#292119; font-size:.76rem; }
  li span small { color:#6c5c51; }
  li em { color:#8e3d1e; font-size:.65rem; font-style:normal; font-weight:800; }
  li[data-transport-past="true"] { display:none; }
  @container kaup-transport (max-width:360px) { li { grid-template-columns:3.5rem minmax(0,1fr); } li em { grid-column:2; } }
</style>
