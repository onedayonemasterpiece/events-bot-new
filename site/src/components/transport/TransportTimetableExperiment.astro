---
import DepartureBoardTimetable from './DepartureBoardTimetable.astro';
import RouteStripsTimetable from './RouteStripsTimetable.astro';
import NextDepartureQueueTimetable from './NextDepartureQueueTimetable.astro';
import type { KaupTransportSuggestion } from '../../lib/eventKaupTransport';
import {
  TRANSPORT_EXPERIMENT_ALGORITHM,
  TRANSPORT_EXPERIMENT_CONFIG_HASH,
  TRANSPORT_EXPERIMENT_KEY,
  TRANSPORT_EXPERIMENT_VERSION,
  normalizeTransportExperimentMode,
} from '../../lib/transportExperiment';

interface Props {
  eventId: number;
  suggestion: KaupTransportSuggestion;
  mode?: string;
  releaseId?: string;
  supabaseUrl?: string;
  supabaseKey?: string;
}

const { eventId, suggestion } = Astro.props;
const mode = normalizeTransportExperimentMode(Astro.props.mode);
const releaseId = String(Astro.props.releaseId || 'unversioned').slice(0, 160);
const supabaseUrl = String(Astro.props.supabaseUrl || '').replace(/\/+$/u, '');
const supabaseKey = String(Astro.props.supabaseKey || '');
const options = suggestion.outbound;
---
{mode === 'off' ? (
  <ol class="transport-baseline" data-transport-baseline aria-label={`Подходящие рейсы автобуса № ${suggestion.busRoute} до остановки ${suggestion.busArrivalStop}`}>
    {options.map((option) => (
      <li class:list={[option.tight && 'is-tight']} data-transport-trip-id={option.tripId} data-departure-at={option.departureAt}>
        <strong data-terminal-departure={option.terminalDeparture}>{option.departureEstimated ? '≈' : ''}{option.departure}</strong>
        <span><b>→ {suggestion.busArrivalStop} ≈{option.estimatedStopArrival}</b><small>Кауп ≈{option.estimatedVenueArrival}</small></span>
        {option.tight && <em>Небольшой запас — лучше выбрать более ранний рейс.</em>}
      </li>
    ))}
  </ol>
) : (
  <div
    class="transport-experiment"
    data-transport-experiment
    data-experiment-key={TRANSPORT_EXPERIMENT_KEY}
    data-experiment-version={TRANSPORT_EXPERIMENT_VERSION}
    data-experiment-algorithm={TRANSPORT_EXPERIMENT_ALGORITHM}
    data-experiment-config-hash={TRANSPORT_EXPERIMENT_CONFIG_HASH}
    data-experiment-mode={mode}
    data-event-id={eventId}
    data-release-id={releaseId}
    data-transport-snapshot-hash={suggestion.scheduleSnapshotHash}
    data-supabase-url={supabaseUrl || undefined}
    data-supabase-key={supabaseKey || undefined}
  >
    <ol class="transport-baseline" data-transport-baseline aria-label={`Подходящие рейсы автобуса № ${suggestion.busRoute} до остановки ${suggestion.busArrivalStop}`}>
      {options.map((option) => (
        <li class:list={[option.tight && 'is-tight']} data-transport-trip-id={option.tripId} data-departure-at={option.departureAt}>
          <strong data-terminal-departure={option.terminalDeparture}>{option.departureEstimated ? '≈' : ''}{option.departure}</strong>
          <span><b>→ {suggestion.busArrivalStop} ≈{option.estimatedStopArrival}</b><small>Кауп ≈{option.estimatedVenueArrival}</small></span>
          {option.tight && <em>Небольшой запас — лучше выбрать более ранний рейс.</em>}
        </li>
      ))}
    </ol>
    <div data-transport-treatment-set hidden>
      <DepartureBoardTimetable route={suggestion.busRoute} arrivalStop={suggestion.busArrivalStop} options={options} />
      <RouteStripsTimetable route={suggestion.busRoute} arrivalStop={suggestion.busArrivalStop} options={options} />
      <NextDepartureQueueTimetable route={suggestion.busRoute} arrivalStop={suggestion.busArrivalStop} options={options} />
    </div>
  </div>
)}

<script>
  import { initTransportTimetableExperiments } from '../../lib/transportExperimentClient';
  initTransportTimetableExperiments();
</script>

<style>
  .transport-experiment [data-transport-treatment-set][hidden],
  .transport-experiment [data-transport-treatment][hidden],
  .transport-experiment .transport-baseline[hidden] { display:none !important; }
  .transport-baseline { display:grid; margin:.1rem 0 0; padding:0; list-style:none; }
  .transport-baseline>li { display:grid; grid-template-columns:4.2rem minmax(0,1fr) auto; gap:.1rem .55rem; align-items:center; padding:.5rem 0; border-top:1px solid rgba(93,71,43,.12); }
  .transport-baseline>li>strong { font-size:1rem; font-variant-numeric:tabular-nums; }
  .transport-baseline>li span { display:flex; flex-wrap:wrap; gap:.2rem .6rem; color:#51453d; }
  .transport-baseline>li span b { color:#292119; font-size:.84rem; }
  .transport-baseline>li span small { color:#6c5c51; font-size:.76rem; }
  .transport-baseline>li em { color:#8e3d1e; font-size:.73rem; font-style:normal; font-weight:800; }
  @container kaup-transport (max-width:560px) {
    .transport-baseline>li { grid-template-columns:3.8rem minmax(0,1fr); padding:.42rem 0; }
    .transport-baseline>li>strong { font-size:.93rem; }
    .transport-baseline>li span { gap:.1rem .45rem; }
    .transport-baseline>li span b { font-size:.78rem; }
    .transport-baseline>li span small,.transport-baseline>li em { font-size:.7rem; }
    .transport-baseline>li em { grid-column:2; }
  }
</style>
