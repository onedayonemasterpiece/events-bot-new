---
import type { KaupBusOption } from '../../lib/eventKaupTransport';
import TransportRouteHeading from './TransportRouteHeading.astro';
import TransportJourneyAlerts from './TransportJourneyAlerts.astro';

interface Props {
  route: string;
  arrivalStop: string;
  originName: string;
  originMapUrl: string;
  walkRouteUrl: string;
  publicReturnAvailable: boolean;
  options: KaupBusOption[];
  baseline?: boolean;
  hidden?: boolean;
}
const { route, arrivalStop, originName, originMapUrl, walkRouteUrl, publicReturnAvailable, options, baseline = false, hidden = true } = Astro.props;
const visible = options.slice(0, 2);
const additional = options.slice(2);
---
<section
  class="transport-treatment transport-board"
  data-transport-treatment="departure_board_v1"
  data-transport-baseline={baseline ? '' : undefined}
  hidden={hidden}
  aria-label={`Расписание автобуса № ${route}`}
>
  <TransportRouteHeading
    route={route}
    title={`Автобус до ${arrivalStop}`}
    subtitle={`Посадка: ${originName}`}
    originMapUrl={originMapUrl}
    originMapLabel={originName}
  />
  <table>
    <thead><tr><th scope="col">рейс</th><th scope="col">Северный</th><th scope="col">{arrivalStop}</th><th scope="col">КАУП</th></tr></thead>
    <tbody>
      {visible.map((option, index) => <tr data-transport-trip-id={option.tripId} data-departure-at={option.departureAt}>
        <th scope="row">{index + 1}</th>
        <td data-terminal-departure={option.terminalDeparture}>{option.departureEstimated ? '≈' : ''}{option.departure}</td>
        <td>≈{option.estimatedStopArrival}</td><td>≈{option.estimatedVenueArrival}{option.tight && <small>небольшой запас</small>}</td>
      </tr>)}
    </tbody>
  </table>
  {additional.length > 0 && <details data-transport-disclosure>
    <summary data-transport-action="schedule_expand">Показать больше отправлений</summary>
    <table><tbody>{additional.map((option, index) => <tr data-transport-trip-id={option.tripId} data-departure-at={option.departureAt}>
      <th scope="row">{visible.length + index + 1}</th>
      <td data-terminal-departure={option.terminalDeparture}>{option.departureEstimated ? '≈' : ''}{option.departure}</td>
      <td>≈{option.estimatedStopArrival}</td><td>≈{option.estimatedVenueArrival}{option.tight && <small>небольшой запас</small>}</td>
    </tr>)}</tbody></table>
  </details>}
  <TransportJourneyAlerts arrivalStop={arrivalStop} walkRouteUrl={walkRouteUrl} publicReturnAvailable={publicReturnAvailable} treatment="departure-board" />
</section>

<style>
  .transport-treatment[hidden] { display:none !important; }
  .transport-board { min-width:0; }
  .transport-board>:global(.transport-route-heading) { margin-bottom:.45rem; }
  table { width:100%; border-collapse:collapse; table-layout:fixed; font-variant-numeric:tabular-nums; }
  thead th { padding:.38rem .25rem; color:#6a7471; font-size:.62rem; font-weight:850; text-align:left; }
  thead th:first-child,tbody th { width:2rem; }
  tbody th { padding:.52rem .25rem; border-top:1px solid var(--ke-color-transport-row-line); color:#67716e; font-size:.68rem; text-align:left; }
  td { padding:.52rem .25rem; border-top:1px solid var(--ke-color-transport-row-line); color:var(--ke-color-transport-route-text); font-size:.88rem; font-weight:850; white-space:nowrap; }
  td:first-of-type { color:var(--ke-color-transport-departure); }
  td small { display:block; color:var(--ke-color-transport-tight); font-size:.65rem; font-weight:800; white-space:normal; }
  details table { margin-top:.05rem; }
  summary { display:flex; align-items:center; justify-content:center; min-height:44px; margin-top:.35rem; padding:.2rem .55rem; border:1px solid var(--ke-color-transport-control-line); border-radius:12px; cursor:pointer; color:var(--ke-color-transport-route-text); background:var(--ke-color-transport-control-surface); font-size:.76rem; font-weight:850; list-style:none; text-align:center; }
  summary::-webkit-details-marker { display:none; }
  summary:focus-visible { outline:3px solid var(--ke-color-transport-focus); outline-offset:2px; }
  @container kaup-transport (max-width:390px) { th,td { padding-inline:.11rem; } td { font-size:.77rem; } thead th { font-size:.56rem; } thead th:first-child,tbody th { width:1.65rem; } }
</style>
