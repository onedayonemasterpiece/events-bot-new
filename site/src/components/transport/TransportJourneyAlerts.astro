---
import Icon from '../Icon.astro';

interface Props {
  arrivalStop: string;
  walkRouteUrl: string;
  publicReturnAvailable: boolean;
  treatment: 'departure-board' | 'route-strips' | 'next-departure';
}

const { arrivalStop, walkRouteUrl, publicReturnAvailable, treatment } = Astro.props;
const copy = treatment === 'departure-board'
  ? {
      title: `От ${arrivalStop} пешком 4 км`,
      detail: '≈53 минуты, короткого входа нет',
      warning: 'После события обратного автобуса нет',
    }
  : treatment === 'route-strips'
    ? {
        title: 'Последний участок: 4 км пешком · 53 мин',
        detail: '',
        warning: 'Обратно — только авто или трансфер',
      }
    : {
        title: 'Время до КАУП включает 53 мин пешком',
        detail: `4 км от ${arrivalStop}`,
        warning: 'После события обратного автобуса нет',
      };
---

<div class:list={['transport-journey-alerts', `transport-journey-alerts--${treatment}`]} data-transport-journey-alerts={treatment}>
  <div class="transport-journey-alerts__walk" data-kaup-last-mile>
    <Icon name="walk" />
    <p><strong>{copy.title}</strong>{copy.detail && <span>{copy.detail}</span>}</p>
    <a
      href={walkRouteUrl}
      target="_blank"
      rel="noopener noreferrer nofollow"
      title="Открыть пеший маршрут"
      aria-label={`Пешеходный маршрут от остановки ${arrivalStop} на Кауп: около 4 км`}
      data-transport-action="walk_route_click"
    ><Icon name="pin" /></a>
  </div>
  {!publicReturnAvailable && <p class="transport-journey-alerts__warning kaup-transport__warning--strong">{copy.warning}</p>}
</div>

<style>
  .transport-journey-alerts { display:grid; gap:.42rem; margin-top:.5rem; }
  .transport-journey-alerts__walk { display:flex; align-items:center; gap:.5rem; min-height:44px; padding:.34rem .45rem; color:var(--ke-color-transport-route-copy); font-size:.74rem; line-height:1.28; }
  .transport-journey-alerts__walk>:global(.icon) { width:1.15rem; height:1.15rem; flex:0 0 auto; color:var(--ke-color-transport-route); }
  .transport-journey-alerts__walk p { min-width:0; display:grid; margin:0; }
  .transport-journey-alerts__walk p span { color:var(--ke-color-transport-route-walk-muted); font-size:.68rem; }
  .transport-journey-alerts__walk a { width:44px; min-height:44px; display:inline-flex; flex:0 0 auto; align-items:center; justify-content:center; margin-left:auto; border-radius:50%; color:var(--ke-color-transport-route); text-decoration:none; }
  .transport-journey-alerts__walk a:hover { background:var(--ke-color-transport-route-hover); }
  .transport-journey-alerts__walk a:focus-visible { outline:3px solid var(--ke-color-transport-focus); outline-offset:2px; }
  .transport-journey-alerts__walk a :global(.icon) { width:1.1rem; height:1.1rem; }
  .transport-journey-alerts__warning { margin:0; padding:.52rem .62rem; border-left:3px solid var(--ke-color-transport-warning-line); border-radius:0 10px 10px 0; color:var(--ke-color-transport-warning-text); background:var(--ke-color-transport-warning-surface); font-size:.75rem; font-weight:850; line-height:1.35; }
  .transport-journey-alerts--route-strips .transport-journey-alerts__walk { border-radius:10px; background:var(--ke-color-transport-route-surface); }
  .transport-journey-alerts--route-strips .transport-journey-alerts__warning { background:var(--ke-color-transport-warning-surface-strong); }
  .transport-journey-alerts--next-departure .transport-journey-alerts__walk { padding-inline:.15rem; }
  @container kaup-transport (max-width:390px) {
    .transport-journey-alerts__walk { padding-inline:.3rem; font-size:.69rem; }
    .transport-journey-alerts__walk p span { font-size:.64rem; }
  }
</style>
