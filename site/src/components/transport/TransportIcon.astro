---
interface Props { name: 'bus' | 'walk' | 'car'; }
const { name } = Astro.props;
---
<svg class="transport-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'bus' && <><path d="M6 3.5h12a2 2 0 0 1 2 2V17H4V5.5a2 2 0 0 1 2-2Z"/><path d="M6.5 6.5h11v5h-11zM7 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/></>}
  {name === 'walk' && <><circle cx="13" cy="4.5" r="2"/><path d="m10.5 9 2-2 3 2.5 2.5.5M12.5 8l-1 5 3 2.5 1.5 4M11.5 13 8 16l-2 3"/></>}
  {name === 'car' && <><path d="m5 10 1.8-4h10.4L19 10M3.5 10h17v7h-17zM6.5 20v-3m11 3v-3M7 13h.01M17 13h.01"/></>}
</svg>

<style>
  .transport-icon { display:block; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
</style>
