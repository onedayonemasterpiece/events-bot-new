---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { eventCalendarHref, eventHref, eventTicketActionLabel, isCalendarEligible, isExternalHttpUrl } from '../lib/events';

interface Props { event: PreviewEvent }
const { event } = Astro.props;
const href = eventHref(event);
const calendarHref = eventCalendarHref(event);
const canAddToCalendar = isCalendarEligible(event);
const ctaHref = event.ticket.href;
const ctaRel = isExternalHttpUrl(ctaHref) ? 'noopener noreferrer nofollow' : undefined;
const place = [event.venue_name, event.city].filter(Boolean).join(' · ');
const ctaLabel = eventTicketActionLabel(event);
const preservePoster = event.image_text_mode !== 'visual_only';
const mediaLinkClass = ['listing-item__media', preservePoster ? 'listing-item__media--preserve' : 'listing-item__media--cover'].join(' ');
---
<article class="listing-item">
  <a class={mediaLinkClass} href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {event.image_url ? (
      <img class="listing-item__image" src={event.image_url} alt={event.image_alt || `Афиша события «${event.title}»`} loading="lazy" decoding="async" />
    ) : (
      <span class="listing-item__fallback" aria-hidden="true">{event.event_type || 'событие'}</span>
    )}
  </a>
  <div class="listing-item__body">
    <div class="listing-item__meta">
      <span>{event.display_date}{event.display_time ? ` · ${event.display_time}` : ''}</span>
      <span>{event.ticket.price_label || event.status_label}</span>
    </div>
    <a class="listing-item__title" href={href} data-prefetch>{event.title}</a>
    {place && <p>{place}</p>}
    <div class="listing-item__actions">
      {ctaHref && <a class="cta-button" href={ctaHref} target={isExternalHttpUrl(ctaHref) ? '_blank' : undefined} rel={ctaRel}>{ctaLabel}</a>}
      {canAddToCalendar && <a class="secondary-button" href={calendarHref} type="text/calendar"><Icon name="calendar" /> <span>В календарь</span></a>}
      <a class="secondary-button" href={href} data-prefetch>Открыть</a>
    </div>
  </div>
</article>
