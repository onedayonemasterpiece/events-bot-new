---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { displayDateTimeWithWeekday, eventAdmissionLabel, eventCalendarHref, eventHref, isCalendarEligible } from '../lib/events';
import { eventImageUrl } from '../lib/assets';

interface Props { event: PreviewEvent }
const { event } = Astro.props;
const href = eventHref(event);
const calendarHref = eventCalendarHref(event);
const canAddToCalendar = isCalendarEligible(event);
const place = [event.venue_name, event.city].filter(Boolean).join(' · ');
const dateTimeLabel = displayDateTimeWithWeekday(event);
const eventTypeLabel = String(event.event_type || '').trim();
const imageUrl = eventImageUrl(event.image_url);
const linkedEventIds = event.other_date_ids.join(',');
---
<article class="listing-item" data-listing-item data-event-id={event.id} data-event-title={event.title} data-linked-event-ids={linkedEventIds} data-city={event.city || undefined} data-venue={event.venue_name || undefined}>
  <a class="listing-item__media listing-item__media--cover" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {imageUrl ? (
      <img class="listing-item__image" src={imageUrl} alt={event.image_alt || `Афиша события «${event.title}»`} loading="lazy" decoding="async" />
    ) : (
      <span class="listing-item__fallback" aria-hidden="true">{event.event_type || 'событие'}</span>
    )}
  </a>
  <div class="listing-item__body">
    <a class="listing-item__title" href={href} data-prefetch>{event.title}</a>
    <div class="listing-item__meta">
      <span>{dateTimeLabel}</span>
      {eventTypeLabel && <span>{eventTypeLabel}</span>}
      <span>{eventAdmissionLabel(event)}</span>
    </div>
    {place && <p>{place}</p>}
    <div class="listing-item__actions">
      {canAddToCalendar && <a class="secondary-button" href={calendarHref} type="text/calendar"><Icon name="calendar" /> <span>В календарь</span></a>}
      <a class="secondary-button" href={href} data-prefetch>Подробнее</a>
    </div>
  </div>
</article>
