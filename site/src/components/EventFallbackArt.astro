---
import type { PreviewEvent } from '../lib/types';
import { withBase } from '../lib/events';
import { resolveEventFallbackArt } from '../lib/eventFallbackArt';

interface Props {
  event: Pick<PreviewEvent, 'event_type' | 'topics'>;
  surface: 'mobile' | 'desktop';
}

const { event, surface } = Astro.props;
const art = resolveEventFallbackArt(event);
---
{art && (
  <div
    class={`event-fallback-art event-fallback-art--${surface}`}
    data-event-fallback-art={art.kind}
    data-presentation-only="true"
    data-fallback-fit={art.fit}
    aria-hidden="true"
  >
    <img src={withBase(art.src)} alt="" width={art.width} height={art.height} loading="eager" decoding="async" fetchpriority="high" />
  </div>
)}

<style>
  .event-fallback-art { width:100%; height:100%; display:grid; place-items:center; overflow:hidden; background:#181818; }
  .event-fallback-art img { width:100%; height:100%; display:block; object-fit:contain; object-position:center; }
  .event-fallback-art--mobile { min-height:clamp(300px,92vw,560px); }
  .event-fallback-art--desktop { position:absolute; inset:0; min-height:100%; }
</style>
