---
import { siteHomeHref, withBase } from '../lib/events';

interface Props {
  context: 'today' | 'tomorrow' | 'date' | 'weekend' | 'event-detail' | 'exhibitions' | 'popular';
  currentEventId?: number;
  relatedSrc?: string;
}
const { context, currentEventId, relatedSrc } = Astro.props;
const isEventDetail = context === 'event-detail';
const eyebrow = isEventDetail ? 'Продолжить выбор' : 'Личная лента';
const heading = isEventDetail ? 'Ещё события' : 'Дальше — под ваши интересы';
const explanation = isEventDetail
  ? 'Шесть разных событий без бесконечной ленты. Когда накопятся ваши оценки, подборка станет персональной.'
  : 'События меняются с учётом ваших лайков и отметок «Не интересно».';
const headingId = `personal-feed-${context}-title`;
---
<section
  class:list={['section-card', 'personal-feed-section', { 'personal-feed-section--event-detail': isEventDetail }]}
  data-personal-feed-section
  data-personal-feed-src={withBase('/data/personal-feed.json')}
  data-personal-feed-related-src={relatedSrc ? withBase(relatedSrc) : undefined}
  data-current-event-id={currentEventId}
  data-listing-context={context}
  data-personal-feed-mode={isEventDetail ? 'pending' : undefined}
  data-personal-feed-desktop-only={isEventDetail ? 'true' : undefined}
  aria-labelledby={headingId}
  hidden={!isEventDetail}
>
  <div class="section-card__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={headingId} data-personal-feed-title>{heading}</h2>
    <p class="muted-note personal-feed-section__explanation" data-personal-feed-explanation>{explanation}</p>
    <p class="muted-note personal-feed-section__status" data-personal-feed-status role="status" aria-live="polite">Подбираем события…</p>
    <div
      class="cards-grid cards-grid--personal-feed personal-feed-section__feed"
      data-personal-feed-slot
      data-feed-card-variant="split-actions"
      data-listing-context={context}
      aria-live="polite"
    ></div>
    {!isEventDetail && <button type="button" class="secondary-button personal-feed-section__load-more" data-personal-feed-load-more hidden>Показать ещё</button>}
    <button type="button" class="secondary-button personal-feed-section__refresh" data-personal-feed-refresh hidden>Обновить ленту</button>
    {isEventDetail && <a class="secondary-button personal-feed-section__all-events" data-personal-feed-all-events href={siteHomeHref()}>Все анонсы</a>}
  </div>
</section>

<style>
  .personal-feed-section[hidden] {
    display: none;
  }

  .personal-feed-section--event-detail {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: clamp(2rem, 4vw, 4.5rem) max(16px, calc((100vw - min(1180px, calc(100vw - 32px))) / 2));
    border: 0;
    border-radius: 0;
    background: #f5ede2;
    box-shadow: none;
  }

  .personal-feed-section--event-detail > .section-card__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: 0;
  }

  .personal-feed-section--event-detail h2 {
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .personal-feed-section__explanation,
  .personal-feed-section__status {
    max-width: 46rem;
    margin: 0.45rem 0 1rem;
  }

  .personal-feed-section__status {
    margin-top: -0.35rem;
  }

  .personal-feed-section__feed {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.8vw, 1.25rem);
    align-items: stretch;
  }

  .personal-feed-section--event-detail :global([data-lab-related-card]) {
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr) minmax(58px, auto) minmax(56px, auto);
  }

  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__media-link) {
    display: block;
  }

  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__media-shell) {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: auto !important;
    aspect-ratio: var(--lab-row-media-ratio) !important;
    overflow: hidden;
    background: #d2c5b7;
  }

  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__media) {
    position: absolute !important;
    z-index: 2;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  /* Keep row-local intrinsic chrome identical to the server-rendered rail.
     The card stretches only to the tallest real content in its own row. */
  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__body) {
    min-height: 0;
    align-content: start;
  }

  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__utility-row) {
    min-height: 58px;
  }

  .personal-feed-section--event-detail :global([data-lab-related-card] .event-card__feedback--under) {
    min-height: 56px;
  }

  /* EventCard/relatedCardLayout own the exact fit on both continuation
     surfaces. The personal feed may style contain bands, never change fit. */
  .personal-feed-section--event-detail :global([data-card-authoritative-fit="contain"]) {
    background: #15110f;
  }

  .personal-feed-section__load-more,
  .personal-feed-section__refresh,
  .personal-feed-section__all-events {
    margin-top: 1rem;
  }

  .personal-feed-section__all-events {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .personal-feed-section__refresh:not([hidden]) {
    margin-left: 0.5rem;
  }

  @media (max-width: 960px) {
    .personal-feed-section__feed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .personal-feed-section--event-detail[data-personal-feed-mode="pending"],
    .personal-feed-section--event-detail[data-personal-feed-mode="personal"],
    .personal-feed-section--event-detail[data-personal-feed-mode="popular_fallback"],
    .personal-feed-section--event-detail[data-personal-feed-mode="unavailable"] {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .personal-feed-section--event-detail {
      margin-top: 1rem;
      padding: 1.15rem 1rem 1.35rem;
      border-radius: 24px;
    }

    .personal-feed-section__feed {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }

    .personal-feed-section__load-more,
    .personal-feed-section__refresh,
    .personal-feed-section__refresh:not([hidden]),
    .personal-feed-section__all-events {
      width: 100%;
      margin: 0.85rem 0 0;
    }
  }
</style>
