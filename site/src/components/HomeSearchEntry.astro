---
import Button from './design-system/Button.astro';
import Field from './design-system/Field.astro';
import {withBase} from '../lib/events';
import {homeSearchCapability} from '../lib/assistant/homeSearchCapability';
const enabled=homeSearchCapability(import.meta.env);
---
<section class="home-search-entry" data-home-search-entry data-ds-family="HomeSearchEntry" data-ds-version="1" data-ds-variant="inline-capture" data-ds-state={enabled?'signed-out':'disabled'} data-search-enabled="false" data-home-search-state={enabled?'signed-out':'disabled'} data-capability={String(enabled)} data-prefix={withBase('/')} data-worklet={withBase('/voice/pcm-capture-worklet.js')} data-supabase-url={import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL||''} data-supabase-relay-url={import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL||''} data-supabase-key={import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY||''} data-yandex-provider={import.meta.env.PUBLIC_YANDEX_AUTH_PROVIDER||'custom:yandex'}>
  <form data-home-form>
    <div data-home-text><Field id="home-search-question" label="Что вам хочется?" placeholder="Расскажите голосом или напишите" /></div>
    <div class="home-search-entry__actions">
      <span data-home-record><Button type="button" variant="primary">Рассказать голосом</Button></span>
      <span data-home-stop><Button type="button" variant="quiet">Завершить и искать</Button></span>
      <span data-home-cancel><Button type="button" variant="quiet">Отменить запись</Button></span>
      <span data-home-submit><Button type="submit" variant="quiet">Найти события</Button></span>
      <span data-home-login><Button type="button" variant="quiet">Войти через Яндекс</Button></span>
      <a data-home-continue hidden>Открыть отправленный запрос</a>
      <span data-home-new><Button type="button" variant="quiet">Новый запрос</Button></span>
    </div>
  </form>
  <p role="status" aria-live="polite" data-home-status>{enabled?'Подключаю поиск…':'Разговорный поиск пока недоступен.'}</p>
</section>
<script>
 import {mountHomeSearchEntry} from '../lib/assistant/homeSearchEntry';
 for(const root of document.querySelectorAll<HTMLElement>('[data-home-search-entry]')) void mountHomeSearchEntry(root);
</script>
<style>
 .home-search-entry:not([data-home-ready]) form{visibility:hidden}
 .home-search-entry{max-width:48rem;margin:var(--ke-space-5,1.25rem) auto;display:grid;gap:var(--ke-space-3,.75rem)}
 .home-search-entry__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--ke-space-2,.5rem);margin-top:var(--ke-space-3,.75rem)}
 .home-search-entry :global([hidden]){display:none!important}
 p{font-size:var(--ke-font-size-small,.875rem);color:var(--ke-color-text-secondary);margin:0}
</style>
