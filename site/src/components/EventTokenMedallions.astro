---
import Icon from './Icon.astro';
import organizerMedallions from '../data/organizerMedallions.json';
import festivalMedallions from '../data/festivalMedallions.json';
import type { PreviewEvent } from '../lib/types';
import { desktopEventWithExplicitEnd } from '../lib/desktopEventTransport';
import { getEventTransportSuggestion } from '../lib/eventTransport';
import { eventAdmissionLabel, isTicketSoldOut, withBase } from '../lib/events';
import {
  classifyEventMedallionLayout,
  resolveRailTransportMedallion,
  resolveEventMedallions,
  type MedallionEvidence,
  type MedallionIdentityCategory,
  type OrganizerMedallionDefinition,
} from '../lib/eventMedallions';

interface Props {
  event: PreviewEvent;
  layout?: 'inline' | 'desktop-slots';
  allowTopSlot?: boolean;
}

type Token = {
  kind: 'organizer' | 'source' | 'program' | 'pushkin' | 'badge' | 'pill';
  key: string;
  label: string;
  shortLabel?: string;
  ariaLabel: string;
  title?: string;
  imageUrl?: string;
  fallbackImageUrl?: string;
  icon?: 'ticket' | 'spark' | 'info';
  background?: string;
  ring?: string;
  tone?: 'green' | 'brown' | 'blue' | 'purple' | 'neutral';
  slug?: string;
  evidence?: MedallionEvidence;
  identityCategory?: MedallionIdentityCategory;
  layoutRole?: 'main' | 'secondary';
};

const { event, layout = 'inline', allowTopSlot = true } = Astro.props;

function normalize(value: unknown): string {
  return String(value || '').toLowerCase().replace(/<[^>]*>/gu, ' ').replace(/[«»"'`´’‘.,!?()[\]{}:;—–-]+/gu, ' ').replace(/\s+/gu, ' ').trim();
}

const manifest = organizerMedallions as { items?: OrganizerMedallionDefinition[] };
const festivalManifest = festivalMedallions as { items?: OrganizerMedallionDefinition[] };
const organizerItems = manifest.items || [];
const organizerSlugs = new Set(organizerItems.map((item) => item.slug));
const eventPageFestivalItems = (festivalManifest.items || []).filter((item) => (
  item.category === 'festival'
  && item.slug !== 'kgd80-80-stories'
  && !organizerSlugs.has(item.slug)
));
const sourceUrls = Array.from(new Set([...(event.source_urls || []), event.source_url].filter(Boolean).map((url) => String(url))));
const sourceCount = Number.isFinite(event.source_count) && Number(event.source_count) > 0 ? Number(event.source_count) : sourceUrls.length;
const organizerResolution = resolveEventMedallions(event, [...organizerItems, ...eventPageFestivalItems]);
const organizers = organizerResolution.identities;
const identityLayout = classifyEventMedallionLayout(organizerResolution);
const railTransport = resolveRailTransportMedallion(
  getEventTransportSuggestion(desktopEventWithExplicitEnd(event)),
);
const hasMeowAfishaSource = sourceUrls.some((url) => /(^|\/)t\.me\/meowafisha\//i.test(url) || /telegram\.me\/meowafisha\//i.test(url));
const admissionLabel = eventAdmissionLabel(event);
const ticket = event.ticket || {};
const explicitText = normalize([event.title, event.event_type, event.summary, ...(event.topics || [])].join(' '));
const hasKids = /\b(kids|family)\b/u.test(explicitText) || /детск|детям|реб[её]н|семейн|для\s+дет/u.test(explicitText);
const hasCharity = /благотвор|пожертв|донат/u.test(normalize([event.summary, event.description_html, ticket.label, ticket.note].join(' ')));

const tokens: Token[] = [];
organizers.forEach(({ item:organizer, evidence }) => {
  const layoutRole = identityLayout.main?.item.slug === organizer.slug ? 'main' : 'secondary';
  tokens.push({
    kind: 'organizer',
    key: `organizer:${organizer.slug}`,
    label: organizer.shortName || organizer.name,
    shortLabel: organizer.shortName || organizer.name,
    title: organizer.name,
    ariaLabel: organizer.ariaLabel || `Организатор или площадка: ${organizer.name}`,
    imageUrl: organizer.avatarUrl,
    fallbackImageUrl: organizer.fallbackPngUrl,
    background: organizer.background,
    ring: organizer.ring,
    slug: organizer.slug,
    evidence,
    identityCategory:organizer.category || 'organizer',
    layoutRole,
  });
});
if (railTransport) {
  tokens.push({
    kind:'program',
    key:`transport:${railTransport.slug}`,
    label:railTransport.name,
    title:railTransport.name,
    ariaLabel:railTransport.ariaLabel,
    imageUrl:railTransport.avatarUrl,
    fallbackImageUrl:railTransport.fallbackPngUrl,
    slug:railTransport.slug,
    layoutRole:'secondary',
  });
}
if (hasMeowAfishaSource && sourceCount > 0 && sourceCount <= 2) {
  tokens.push({
    kind: 'source',
    key: 'source:meow-afisha',
    label: 'MEOW Афиша',
    title: 'MEOW Афиша',
    ariaLabel: 'Источник события: MEOW Афиша',
    imageUrl: '/assets/sources/meow-afisha.webp',
    fallbackImageUrl: '/assets/sources/meow-afisha.png',
    background: '#FFFFFF',
    ring: '#282828',
    slug: 'meow-afisha',
    layoutRole:'secondary',
  });
}
if (event.pushkin_card) {
  tokens.push({
    kind: 'pushkin',
    key: 'pushkin-card',
    label: 'Пушкинская карта',
    shortLabel: 'Пушкинская карта',
    title: 'Пушкинская карта',
    ariaLabel: 'Можно оплатить Пушкинской картой',
    imageUrl: '/assets/badges/pushkin-card-medallion.webp',
    fallbackImageUrl: '/assets/badges/pushkin-card-medallion.png',
    tone: 'purple',
    layoutRole:'secondary',
  });
}
if (ticket.is_free) {
  tokens.push({
    kind: 'badge',
    key: 'free-admission',
    label: admissionLabel,
    title: admissionLabel,
    ariaLabel: 'Бесплатное событие: 0 рублей',
    imageUrl: '/assets/badges/free-listing-medallion.svg',
    slug: 'free-admission',
    layoutRole:'secondary',
  });
} else if (ticket.price_label) {
  tokens.push({
    kind: 'pill',
    key: 'price',
    label: ticket.price_label,
    ariaLabel: `Стоимость: ${ticket.price_label}`,
    icon: 'ticket',
    tone: 'brown',
    layoutRole:'secondary',
  });
} else if (isTicketSoldOut(event)) {
  tokens.push({
    kind: 'pill',
    key: 'sold-out',
    label: 'Билеты закончились',
    ariaLabel: 'Билеты закончились',
    icon: 'ticket',
    tone: 'neutral',
    layoutRole:'secondary',
  });
}
if (hasKids) {
  tokens.push({
    kind: 'pill',
    key: 'kids-family',
    label: 'Детям / семье',
    ariaLabel: 'Подходит детям или семье по данным события',
    icon: 'spark',
    tone: 'blue',
    layoutRole:'secondary',
  });
}
if (hasCharity) {
  tokens.push({
    kind: 'pill',
    key: 'charity',
    label: 'Благотворительное',
    ariaLabel: 'Благотворительное событие',
    icon: 'spark',
    tone: 'green',
    layoutRole:'secondary',
  });
}
const hasFestivalLogoToken = organizers.some(({ item }) => item.category === 'festival_brand' || item.category === 'festival');
if (event.festival && !hasFestivalLogoToken && tokens.length < 6) {
  tokens.push({
    kind: 'pill',
    key: 'festival',
    label: event.festival,
    ariaLabel: `Фестиваль: ${event.festival}`,
    icon: 'info',
    tone: 'brown',
    layoutRole:'secondary',
  });
}
const admissionBadge = tokens.find((token) => token.kind === 'badge' && token.key === 'free-admission');
const visibleTokens = tokens.length <= 6
  ? tokens
  : (
      admissionBadge && !tokens.slice(0, 6).includes(admissionBadge)
        ? [...tokens.slice(0, 5), admissionBadge]
        : tokens.slice(0, 6)
    );
// Admission is a product-significant medallion on every event-detail surface.
// It is always secondary and therefore can only render inline.
const desktopMedallionTokens = visibleTokens.filter((token) => (
  token.kind === 'organizer'
  || token.kind === 'source'
  || token.kind === 'program'
  || token.kind === 'pushkin'
  || token.kind === 'badge'
));
const resolvedMainToken = layout === 'desktop-slots'
  ? desktopMedallionTokens.find((token) => token.layoutRole === 'main')
  : undefined;
const mainToken = allowTopSlot ? resolvedMainToken : undefined;
const tokenGroups = layout === 'desktop-slots'
  ? [
      ...(mainToken ? [{ slot:'top' as const, tokens:[mainToken] }] : []),
      ...(desktopMedallionTokens.some((token) => token !== mainToken)
        ? [{ slot:'inline' as const, tokens:desktopMedallionTokens.filter((token) => token !== mainToken) }]
        : []),
    ]
  : (visibleTokens.length ? [{ slot:'inline' as const, tokens:visibleTokens }] : []);

function tokenStyle(token: Token): string | undefined {
  const parts: string[] = [];
  if (token.background) parts.push(`--token-brand-bg:${token.background}`);
  if (token.ring) parts.push(`--token-brand-ring:${token.ring}`);
  return parts.length ? parts.join(';') : undefined;
}

function primaryImageSrc(imageUrl: string, fallbackImageUrl?: string): string {
  return imageUrl.endsWith('.webp') ? (fallbackImageUrl || imageUrl) : imageUrl;
}
---
{tokenGroups.length > 0 && (
  <div
    class:list={['event-token-layout', `event-token-layout--${layout}`]}
    data-medallion-layout={layout}
    data-main-medallion-slug={resolvedMainToken?.slug}
    data-top-slot-enabled={allowTopSlot ? 'true' : 'false'}
  >
    {tokenGroups.map((group) => (
      <section
        class:list={['event-token-section', `event-token-section--${group.slot}`]}
        aria-label={group.slot === 'top' ? 'Главный организатор или фестиваль' : 'Быстрые признаки события'}
        data-medallion-slot={group.slot}
        data-identity-resolution={organizerResolution.failClosedReason || 'resolved'}
        data-identity-conflict={organizerResolution.conflictEvidence?.join('|')}
      >
        <ul class="event-token-row" role="list">
          {group.tokens.map((token) => (
            <li
              class={`event-token event-token--${token.kind} event-token--${token.tone || 'custom'} ${token.slug ? `event-token--${token.slug}` : ''}`}
              style={tokenStyle(token)}
              data-medallion-role={token.layoutRole || 'secondary'}
              data-medallion-category={token.identityCategory}
              data-medallion-evidence-field={token.evidence?.field}
              data-medallion-evidence-alias={token.evidence?.alias}
              data-medallion-evidence-match={token.evidence?.match}
            >
              {(token.kind === 'organizer' || token.kind === 'source' || token.kind === 'program' || token.kind === 'badge') && token.imageUrl ? (
                <span class="event-token__circle" aria-label={token.ariaLabel} title={token.title || token.label}>
                  <picture>
                    {token.imageUrl.endsWith('.webp') && token.fallbackImageUrl && <source srcset={withBase(token.imageUrl)} type="image/webp" />}
                    <img src={withBase(primaryImageSrc(token.imageUrl, token.fallbackImageUrl))} alt="" loading="lazy" decoding="async" />
                  </picture>
                </span>
              ) : token.kind === 'pushkin' && token.imageUrl ? (
                <span class="event-token__pushkin-frame" aria-label={token.ariaLabel} title={token.label}>
                  <picture>
                    {token.imageUrl.endsWith('.webp') && token.fallbackImageUrl && <source srcset={withBase(token.imageUrl)} type="image/webp" />}
                    <img class="event-token__pushkin-composite" src={withBase(primaryImageSrc(token.imageUrl, token.fallbackImageUrl))} alt="" loading="lazy" decoding="async" />
                  </picture>
                </span>
              ) : (
                <span class="event-token__pill" aria-label={token.ariaLabel} title={token.label}>
                  {token.icon && <Icon name={token.icon} />}
                  <span>{token.label}</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
