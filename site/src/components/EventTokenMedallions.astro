---
import Icon from './Icon.astro';
import organizerMedallions from '../data/organizerMedallions.json';
import type { PreviewEvent } from '../lib/types';
import { eventAdmissionLabel, isTicketSoldOut, withBase } from '../lib/events';

interface Props {
  event: PreviewEvent;
}

type OrganizerMedallion = {
  slug: string;
  name: string;
  shortName?: string;
  aliases?: string[];
  avatarUrl: string;
  fallbackPngUrl?: string;
  background?: string;
  ring?: string;
  ariaLabel?: string;
};

type Token = {
  kind: 'organizer' | 'source' | 'pushkin' | 'pill';
  key: string;
  label: string;
  shortLabel?: string;
  ariaLabel: string;
  title?: string;
  imageUrl?: string;
  fallbackImageUrl?: string;
  icon?: 'ticket' | 'spark' | 'info';
  background?: string;
  ring?: string;
  tone?: 'green' | 'brown' | 'blue' | 'purple' | 'neutral';
  slug?: string;
};

const { event } = Astro.props;

function normalize(value: unknown): string {
  return String(value || '').toLowerCase().replace(/<[^>]*>/gu, ' ').replace(/[«»"'`´’‘.,!?()[\]{}:;—–-]+/gu, ' ').replace(/\s+/gu, ' ').trim();
}

function includesAlias(haystack: string, aliases: string[] | undefined): boolean {
  return Boolean(aliases?.some((alias) => {
    const needle = normalize(alias);
    return needle && haystack.includes(needle);
  }));
}

function matchesZnanieContext(haystack: string): boolean {
  if (includesAlias(haystack, ['Российское общество Знание', 'Общество Знание', 'Знание Лекторий', 'Знание.Лекторий', 'znanierussia.ru', 'znanie russia'])) return true;
  return /(?:организатор|организаторы|соорганизатор|партнер|партн[её]р|при поддержке|совместно с)\s+(?:российское\s+общество\s+)?знание/u.test(haystack)
    || /знание\s+(?:организатор|соорганизатор|партнер|партн[её]р|поддерживает|проводит|представляет)/u.test(haystack);
}

function isKgd80Festival(festivalValue?: string | null): boolean {
  return normalize(festivalValue).includes('80 историй о главном');
}

function matchesOrganizer(item: OrganizerMedallion, haystack: string, festivalValue?: string | null): boolean {
  const kgd80Festival = isKgd80Festival(festivalValue);
  if (item.slug === 'znanie-russia') return matchesZnanieContext(haystack) || kgd80Festival;
  if (item.slug === 'kgd80') return kgd80Festival || includesAlias(haystack, item.aliases || []);
  if (item.slug === 'kantata-festival') return includesAlias(haystack, item.aliases || []) || normalize(festivalValue).includes('кантата');
  return includesAlias(haystack, item.aliases || [item.name, item.shortName || '']);
}

function organizerPriority(item: OrganizerMedallion, festivalValue?: string | null): number {
  if (isKgd80Festival(festivalValue)) {
    if (item.slug === 'kgd80') return 0;
    if (item.slug === 'znanie-russia') return 1;
  }
  if (item.slug === 'kantata-festival' && normalize(festivalValue).includes('кантата')) return 0;
  return 10;
}

const manifest = organizerMedallions as { items?: OrganizerMedallion[] };
const sourceUrls = Array.from(new Set([...(event.source_urls || []), event.source_url].filter(Boolean).map((url) => String(url))));
const sourceCount = Number.isFinite(event.source_count) && Number(event.source_count) > 0 ? Number(event.source_count) : sourceUrls.length;
const organizerHaystack = normalize([
  event.venue_name,
  event.festival,
  event.city,
  event.description_html,
  event.summary,
  event.source_url,
  ...sourceUrls,
].filter(Boolean).join(' '));
const organizers = (manifest.items || [])
  .filter((item) => matchesOrganizer(item, organizerHaystack, event.festival))
  .sort((left, right) => organizerPriority(left, event.festival) - organizerPriority(right, event.festival))
  .slice(0, 3);
const hasMeowAfishaSource = sourceUrls.some((url) => /(^|\/)t\.me\/meowafisha\//i.test(url) || /telegram\.me\/meowafisha\//i.test(url));
const admissionLabel = eventAdmissionLabel(event);
const ticket = event.ticket || {};
const explicitText = normalize([event.title, event.event_type, event.summary, ...(event.topics || [])].join(' '));
const hasKids = /\b(kids|family)\b/u.test(explicitText) || /детск|детям|реб[её]н|семейн|для\s+дет/u.test(explicitText);
const hasCharity = /благотвор|пожертв|донат/u.test(normalize([event.summary, event.description_html, ticket.label, ticket.note].join(' ')));

const tokens: Token[] = [];
organizers.forEach((organizer) => {
  tokens.push({
    kind: 'organizer',
    key: `organizer:${organizer.slug}`,
    label: organizer.shortName || organizer.name,
    shortLabel: organizer.shortName || organizer.name,
    title: organizer.name,
    ariaLabel: organizer.ariaLabel || `Организатор или площадка: ${organizer.name}`,
    imageUrl: organizer.avatarUrl,
    fallbackImageUrl: organizer.fallbackPngUrl,
    background: organizer.background,
    ring: organizer.ring,
    slug: organizer.slug,
  });
});
if (hasMeowAfishaSource && sourceCount > 0 && sourceCount <= 2) {
  tokens.push({
    kind: 'source',
    key: 'source:meow-afisha',
    label: 'MEOW Афиша',
    title: 'MEOW Афиша',
    ariaLabel: 'Источник события: MEOW Афиша',
    imageUrl: '/assets/sources/meow-afisha.webp',
    fallbackImageUrl: '/assets/sources/meow-afisha.png',
    background: '#FFFFFF',
    ring: '#282828',
    slug: 'meow-afisha',
  });
}
if (event.pushkin_card) {
  tokens.push({
    kind: 'pushkin',
    key: 'pushkin-card',
    label: 'Пушкинская карта',
    shortLabel: 'Пушкинская карта',
    title: 'Пушкинская карта',
    ariaLabel: 'Можно оплатить Пушкинской картой',
    imageUrl: '/assets/badges/pushkin-card-medallion.webp',
    fallbackImageUrl: '/assets/badges/pushkin-card-medallion.png',
    tone: 'purple',
  });
}
if (ticket.is_free) {
  tokens.push({
    kind: 'pill',
    key: 'free-admission',
    label: admissionLabel,
    ariaLabel: admissionLabel,
    icon: 'ticket',
    tone: 'green',
  });
} else if (ticket.price_label) {
  tokens.push({
    kind: 'pill',
    key: 'price',
    label: ticket.price_label,
    ariaLabel: `Стоимость: ${ticket.price_label}`,
    icon: 'ticket',
    tone: 'brown',
  });
} else if (isTicketSoldOut(event)) {
  tokens.push({
    kind: 'pill',
    key: 'sold-out',
    label: 'Билеты закончились',
    ariaLabel: 'Билеты закончились',
    icon: 'ticket',
    tone: 'neutral',
  });
}
if (hasKids) {
  tokens.push({
    kind: 'pill',
    key: 'kids-family',
    label: 'Детям / семье',
    ariaLabel: 'Подходит детям или семье по данным события',
    icon: 'spark',
    tone: 'blue',
  });
}
if (hasCharity) {
  tokens.push({
    kind: 'pill',
    key: 'charity',
    label: 'Благотворительное',
    ariaLabel: 'Благотворительное событие',
    icon: 'spark',
    tone: 'green',
  });
}
const hasFestivalLogoToken = organizers.some((organizer) => organizer.slug === 'kgd80' || organizer.slug === 'kantata-festival');
if (event.festival && !hasFestivalLogoToken && tokens.length < 6) {
  tokens.push({
    kind: 'pill',
    key: 'festival',
    label: event.festival,
    ariaLabel: `Фестиваль: ${event.festival}`,
    icon: 'info',
    tone: 'brown',
  });
}
const visibleTokens = tokens.slice(0, 6);

function tokenStyle(token: Token): string | undefined {
  const parts: string[] = [];
  if (token.background) parts.push(`--token-brand-bg:${token.background}`);
  if (token.ring) parts.push(`--token-brand-ring:${token.ring}`);
  return parts.length ? parts.join(';') : undefined;
}

function primaryImageSrc(imageUrl: string, fallbackImageUrl?: string): string {
  return imageUrl.endsWith('.webp') ? (fallbackImageUrl || imageUrl) : imageUrl;
}
---
{visibleTokens.length > 0 && (
  <section class="event-token-section" aria-label="Быстрые признаки события">
    <ul class="event-token-row" role="list">
      {visibleTokens.map((token) => (
        <li class={`event-token event-token--${token.kind} event-token--${token.tone || 'custom'} ${token.slug ? `event-token--${token.slug}` : ''}`} style={tokenStyle(token)}>
          {(token.kind === 'organizer' || token.kind === 'source') && token.imageUrl ? (
            <span class="event-token__circle" aria-label={token.ariaLabel} title={token.title || token.label}>
              <picture>
                {token.imageUrl.endsWith('.webp') && token.fallbackImageUrl && <source srcset={withBase(token.imageUrl)} type="image/webp" />}
                <img src={withBase(primaryImageSrc(token.imageUrl, token.fallbackImageUrl))} alt="" loading="lazy" decoding="async" />
              </picture>
            </span>
          ) : token.kind === 'pushkin' && token.imageUrl ? (
            <span class="event-token__pushkin-frame" aria-label={token.ariaLabel} title={token.label}>
              <picture>
                {token.imageUrl.endsWith('.webp') && token.fallbackImageUrl && <source srcset={withBase(token.imageUrl)} type="image/webp" />}
                <img class="event-token__pushkin-composite" src={withBase(primaryImageSrc(token.imageUrl, token.fallbackImageUrl))} alt="" loading="lazy" decoding="async" />
              </picture>
            </span>
          ) : (
            <span class="event-token__pill" aria-label={token.ariaLabel} title={token.label}>
              {token.icon && <Icon name={token.icon} />}
              <span>{token.label}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
