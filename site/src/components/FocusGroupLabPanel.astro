---
import FocusLabBadge from './FocusLabBadge.astro';
import SemanticIcon from './design-system/SemanticIcon.astro';
import './design-system/product-contour-foundations.css';
import { withBase } from '../lib/events';
import { FOCUS_GROUP_MASS_INVITE_TOKEN } from '../lib/focus-group-prototype';
import type { FocusGroupPageFamily } from '../lib/focus-group-surface';

interface Props {
  pageFamily: FocusGroupPageFamily;
  pageLabel: string;
  pagePath: string;
}

const { pageFamily, pageLabel, pagePath } = Astro.props;
const invitePath = withBase('/fokus-gruppa/priglashenie/');
const confirmHref = withBase('/fokus-gruppa/priglashenie/?confirm=1');
---

<section
  class="focus-lab-panel"
  data-ds-family="FocusGroupLabPanel"
  data-ds-version="1"
  data-ds-variant="authenticated-research-panel"
  data-ds-state="inactive"
  data-focus-lab-panel
  data-page-family={pageFamily}
  data-page-path={pagePath}
  data-invite-path={invitePath}
  data-invite-token={FOCUS_GROUP_MASS_INVITE_TOKEN}
  hidden
  aria-labelledby="focus-lab-panel-title"
>
  <div class="focus-lab-panel__head">
    <FocusLabBadge label="Lab" detail="Фокус-группа" />
    <div>
      <h2 id="focus-lab-panel-title">Помогла ли вам эта страница?</h2>
      <p>Оцените {pageLabel} от 0 до 10.</p>
    </div>
  </div>

  <div class="focus-lab-panel__scale" role="group" aria-label="Оценка страницы от 0 до 10">
    {Array.from({ length: 11 }, (_, score) => (
      <button type="button" data-focus-score={score} aria-label={`Оценка ${score}`}>{score}</button>
    ))}
  </div>
  <div class="focus-lab-panel__ends" aria-hidden="true"><span>Не помогла</span><span>Очень помогла</span></div>

  <div class="focus-lab-panel__actions">
    <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-focus-issue-open>
      Сообщить о проблеме
    </button>
    <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-focus-invite-open>
      Пригласить человека
    </button>
  </div>

  <p class="focus-lab-panel__status" data-focus-feedback-status role="status" aria-live="polite"></p>
  <a class="focus-lab-panel__confirm" href={confirmHref} data-focus-confirm hidden>
    Подтвердить участие
  </a>

  <dialog class="focus-lab-panel__dialog" data-focus-issue-dialog aria-labelledby="focus-issue-title">
    <form class="focus-lab-panel__sheet" data-focus-issue-form>
      <header>
        <div>
          <FocusLabBadge label="Lab" detail="Фокус-группа" />
          <h2 id="focus-issue-title">Что пошло не так?</h2>
        </div>
        <button type="button" data-focus-dialog-close aria-label="Закрыть"><SemanticIcon name="close" role="control" /></button>
      </header>
      <label>
        <span>Что произошло? Что вы хотели сделать? Что не получилось?</span>
        <textarea name="message" rows="6" maxlength="2000" required></textarea>
      </label>
      <label class="focus-lab-panel__file">
        <span>Добавить скриншот <small>(необязательно)</small></span>
        <input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp" />
        <small>PNG, JPG или WebP до 5 МБ.</small>
      </label>
      <button class="ke-button ke-button--primary" type="submit" data-ke-button-compat="runtime-hook" data-focus-issue-submit>
        Отправить
      </button>
      <p data-focus-issue-status role="status" aria-live="polite"></p>
    </form>
  </dialog>

  <dialog class="focus-lab-panel__dialog" data-focus-invite-dialog aria-labelledby="focus-invite-title">
    <div class="focus-lab-panel__sheet focus-lab-panel__sheet--invite">
      <header>
        <div>
          <FocusLabBadge label="Lab" detail="Фокус-группа" />
          <h2 id="focus-invite-title">Пригласить в фокус-группу</h2>
        </div>
        <button type="button" data-focus-dialog-close aria-label="Закрыть"><SemanticIcon name="close" role="control" /></button>
      </header>
      <div class="focus-lab-panel__qr" data-focus-invite-qr aria-label="QR-код приглашения"></div>
      <p>Покажите QR-код или отправьте ссылку.</p>
      <div class="focus-lab-panel__actions">
        <button class="ke-button ke-button--primary" type="button" data-ke-button-compat="runtime-hook" data-focus-invite-share>Поделиться</button>
        <button class="ke-button ke-button--secondary" type="button" data-ke-button-compat="runtime-hook" data-focus-invite-copy>Скопировать ссылку</button>
      </div>
      <p data-focus-invite-status role="status" aria-live="polite"></p>
    </div>
  </dialog>
</section>

<script>
  import { getStaticSiteAuth } from '../lib/staticSiteAuth';
  import {
    readFocusFeedbackScores,
    rememberFocusFeedbackScore,
  } from '../lib/focus-feedback-state';
  import { getIdempotentOutbox, type IdempotentOutboxRecord } from '../lib/idempotentOutbox';
  import { readFocusParticipationMarker } from '../lib/focus-group-prototype';
  import { createFocusInviteQrSvg } from '../lib/focus-invite-qr';

  document.querySelectorAll<HTMLElement>('[data-focus-lab-panel]').forEach((root) => {
    let participation = null;
    try { participation = readFocusParticipationMarker(window.localStorage); } catch { participation = null; }
    if (participation?.status !== 'active') return;
    root.hidden = false;
    root.dataset.dsState = 'ready';

    const feedbackStatus = root.querySelector<HTMLElement>('[data-focus-feedback-status]');
    const confirmLink = root.querySelector<HTMLAnchorElement>('[data-focus-confirm]');
    const authRuntime = document.querySelector<HTMLElement>('[data-static-site-auth-runtime]');
    const auth = authRuntime?.dataset.authEnabled === 'true'
      && authRuntime.dataset.supabaseUrl
      && authRuntime.dataset.supabaseKey
      ? getStaticSiteAuth({
          supabaseUrl: authRuntime.dataset.supabaseUrl,
          relayUrl: authRuntime.dataset.supabaseRelayUrl || '',
          publishableKey: authRuntime.dataset.supabaseKey,
          provider: authRuntime.dataset.yandexProvider || 'custom:yandex',
        })
      : null;

    const requireSession = async () => {
      if (!auth) return null;
      try { return await auth.getSession(); } catch { return null; }
    };

    const feedbackOutbox = getIdempotentOutbox();
    const sendFeedbackRecord = async (record: IdempotentOutboxRecord, accessToken: string) => {
      if (record.channel !== 'focus_feedback_v2') return 'skip' as const;
      try {
        const response = await auth!.dataClient.request(
          `${auth!.config.supabaseUrl}/rest/v1/rpc/submit_focus_group_feedback_v2`,
          {
            method: 'POST',
            headers: {
              apikey: auth!.config.publishableKey,
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(record.payload),
            keepalive: true,
          },
        );
        if (response.ok || response.status === 409) return 'sent' as const;
        if (response.status === 429 || response.status >= 500) return 'retry' as const;
        return 'drop' as const;
      } catch {
        return 'retry' as const;
      }
    };
    const flushFeedbackOutbox = async () => {
      if (!auth) return;
      const session = await requireSession();
      if (!session?.user || !session.access_token) return;
      await feedbackOutbox.flush((record) => sendFeedbackRecord(record, session.access_token));
    };

    let browserStorage: Storage | null = null;
    try { browserStorage = window.localStorage; } catch { browserStorage = null; }
    const scoreButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-focus-score]'));
    const remembered = browserStorage
      ? readFocusFeedbackScores(browserStorage)[root.dataset.pageFamily || '']
      : null;
    if (remembered) {
      scoreButtons.forEach((item) => {
        const selected = Number(item.dataset.focusScore) === remembered.score;
        item.dataset.selected = selected ? 'true' : 'false';
        item.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      root.dataset.dsState = 'score-recorded';
      if (feedbackStatus) feedbackStatus.textContent = 'Ваша оценка сохранена. Её можно изменить.';
    }

    const needsConfirmation = () => {
      root.dataset.dsState = 'identity-required';
      if (feedbackStatus) feedbackStatus.textContent = 'Чтобы отправить ответ, подтвердите участие.';
      if (confirmLink) confirmLink.hidden = false;
    };

    let scoreInFlight = false;
    scoreButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        if (scoreInFlight) return;
        const session = await requireSession();
        if (!session?.user) {
          needsConfirmation();
          return;
        }
        const score = Number(button.dataset.focusScore);
        const clientRequestId = crypto.randomUUID();
        if (browserStorage) rememberFocusFeedbackScore(
          browserStorage,
          root.dataset.pageFamily || '',
          score,
        );
        scoreButtons.forEach((item) => {
          const selected = item === button;
          item.disabled = true;
          item.dataset.selected = selected ? 'true' : 'false';
          item.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
        scoreInFlight = true;
        root.dataset.dsState = 'submitting-score';
        if (feedbackStatus) feedbackStatus.textContent = 'Отправляем оценку…';
        const payload = {
          p_client_request_id: clientRequestId,
          p_kind: 'page_score',
          p_page_family: root.dataset.pageFamily,
          p_page_path: root.dataset.pagePath,
          p_score: score,
          p_message: null,
          p_attachment_path: null,
        };
        const queued = await feedbackOutbox.enqueue({
          id: clientRequestId,
          channel: 'focus_feedback_v2',
          payload,
        });
        if (!queued) {
          scoreInFlight = false;
          scoreButtons.forEach((item) => { item.disabled = false; });
          root.dataset.dsState = 'score-local-only';
          if (feedbackStatus) feedbackStatus.textContent = 'Оценка сохранена на этой странице, но сейчас не отправилась. Попробуйте ещё раз позже.';
          return;
        }
        await flushFeedbackOutbox();
        const pending = (await feedbackOutbox.inspect()).some((record) => record.id === clientRequestId);
        scoreInFlight = false;
        scoreButtons.forEach((item) => { item.disabled = false; });
        if (pending) {
          root.dataset.dsState = 'score-queued';
          if (feedbackStatus) {
            feedbackStatus.textContent = 'Оценка сохранена на этом устройстве. Отправим её, когда связь восстановится.';
          }
          return;
        }
        root.dataset.dsState = 'score-sent';
        if (feedbackStatus) feedbackStatus.textContent = 'Спасибо, оценка отправлена.';
      });
    });

    const issueDialog = root.querySelector<HTMLDialogElement>('[data-focus-issue-dialog]');
    const issueForm = root.querySelector<HTMLFormElement>('[data-focus-issue-form]');
    const issueStatus = root.querySelector<HTMLElement>('[data-focus-issue-status]');
    root.querySelector<HTMLButtonElement>('[data-focus-issue-open]')?.addEventListener('click', () => {
      root.dataset.dsState = 'issue-dialog';
      issueDialog?.showModal();
    });

    issueForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!issueForm.reportValidity()) return;
      const session = await requireSession();
      if (!session?.user) {
        issueDialog?.close();
        needsConfirmation();
        return;
      }
      const submit = issueForm.querySelector<HTMLButtonElement>('[data-focus-issue-submit]');
      const message = String(new FormData(issueForm).get('message') || '').trim();
      const fileInput = issueForm.elements.namedItem('screenshot') as HTMLInputElement | null;
      const file = fileInput?.files?.[0] || null;
      if (file && (file.size > 5 * 1024 * 1024 || !['image/png', 'image/jpeg', 'image/webp'].includes(file.type))) {
        if (issueStatus) issueStatus.textContent = 'Выберите PNG, JPG или WebP до 5 МБ.';
        return;
      }
      if (submit) submit.disabled = true;
      root.dataset.dsState = 'submitting-issue';
      if (issueStatus) issueStatus.textContent = 'Отправляем…';
      let attachmentPath: string | null = null;
      if (file) {
        const extension = file.type === 'image/png' ? 'png' : file.type === 'image/webp' ? 'webp' : 'jpg';
        attachmentPath = `${session.user.id}/${crypto.randomUUID()}.${extension}`;
        const { error: uploadError } = await auth!.client.storage
          .from('focus-feedback')
          .upload(attachmentPath, file, { contentType: file.type, upsert: false });
        if (uploadError) {
          if (submit) submit.disabled = false;
          root.dataset.dsState = 'issue-upload-error';
          if (issueStatus) issueStatus.textContent = 'Скриншот не загрузился. Попробуйте ещё раз.';
          return;
        }
      }
      const clientRequestId = crypto.randomUUID();
      const payload = {
        p_client_request_id: clientRequestId,
        p_kind: 'issue',
        p_page_family: root.dataset.pageFamily,
        p_page_path: root.dataset.pagePath,
        p_score: null,
        p_message: message,
        p_attachment_path: attachmentPath,
      };
      const queued = await feedbackOutbox.enqueue({
        id: clientRequestId,
        channel: 'focus_feedback_v2',
        payload,
      });
      if (!queued) {
        if (submit) submit.disabled = false;
        root.dataset.dsState = 'issue-local-error';
        if (issueStatus) issueStatus.textContent = 'Сообщение сейчас не сохранилось. Скопируйте текст и попробуйте ещё раз позже.';
        return;
      }
      await flushFeedbackOutbox();
      const pending = (await feedbackOutbox.inspect()).some((record) => record.id === clientRequestId);
      if (pending) {
        if (submit) submit.disabled = false;
        root.dataset.dsState = 'issue-queued';
        if (issueStatus) issueStatus.textContent = 'Сообщение сохранено. Отправим его, когда связь восстановится.';
        return;
      }
      issueForm.reset();
      root.dataset.dsState = 'issue-sent';
      if (issueStatus) issueStatus.textContent = 'Спасибо, сообщение отправлено.';
      window.setTimeout(() => issueDialog?.close(), 900);
      if (submit) submit.disabled = false;
    });

    const inviteDialog = root.querySelector<HTMLDialogElement>('[data-focus-invite-dialog]');
    const qr = root.querySelector<HTMLElement>('[data-focus-invite-qr]');
    const inviteStatus = root.querySelector<HTMLElement>('[data-focus-invite-status]');
    const inviteUrl = new URL(root.dataset.invitePath || '/fokus-gruppa/priglashenie/', window.location.origin);
    inviteUrl.hash = `invite=${root.dataset.inviteToken || ''}`;
    const exactInviteUrl = inviteUrl.toString();
    try { if (qr) qr.innerHTML = createFocusInviteQrSvg(exactInviteUrl); } catch { if (qr) qr.textContent = 'QR-код не загрузился.'; }
    root.querySelector<HTMLButtonElement>('[data-focus-invite-open]')?.addEventListener('click', () => {
      root.dataset.dsState = 'invite-dialog';
      inviteDialog?.showModal();
    });
    root.querySelector<HTMLButtonElement>('[data-focus-invite-share]')?.addEventListener('click', async () => {
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: 'Приглашение в фокус-группу', url: exactInviteUrl });
          root.dataset.dsState = 'invite-shared';
          if (inviteStatus) inviteStatus.textContent = 'Готово.';
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(exactInviteUrl);
        root.dataset.dsState = 'invite-copied';
        if (inviteStatus) inviteStatus.textContent = 'Ссылка скопирована.';
      } catch {
        root.dataset.dsState = 'invite-copy-error';
        if (inviteStatus) inviteStatus.textContent = 'Не получилось скопировать ссылку.';
      }
    });
    root.querySelector<HTMLButtonElement>('[data-focus-invite-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(exactInviteUrl);
        root.dataset.dsState = 'invite-copied';
        if (inviteStatus) inviteStatus.textContent = 'Ссылка скопирована.';
      } catch {
        root.dataset.dsState = 'invite-copy-error';
        if (inviteStatus) inviteStatus.textContent = 'Не получилось скопировать ссылку.';
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-focus-dialog-close]').forEach((button) => {
      button.addEventListener('click', () => {
        root.dataset.dsState = 'ready';
        button.closest('dialog')?.close();
      });
    });

    window.addEventListener('online', () => { void flushFeedbackOutbox(); }, { passive: true });
    void flushFeedbackOutbox();
  });
</script>

<style>
  .focus-lab-panel {
    box-sizing: border-box;
    width: min(1120px, calc(100% - 1rem));
    margin: clamp(2rem, 5vw, 4rem) auto 1rem;
    border: var(--ke-shape-border-hairline) solid var(--ke-color-border-panel-warm);
    border-radius: var(--ke-shape-radius-focus-lab);
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--ke-color-focus-sheet-surface);
    color: var(--ke-color-text-secondary);
    box-shadow: var(--ke-elevation-focus-lab);
    font-family: var(--ke-font-family-sans);
  }
  .focus-lab-panel[hidden] { display: none; }
  .focus-lab-panel__head { display: flex; align-items: center; gap: 1rem; }
  .focus-lab-panel__head h2 { margin: 0 0 .25rem; color: var(--ke-color-text-primary); font-size: clamp(1.2rem, 3vw, 1.65rem); line-height: 1.1; }
  .focus-lab-panel__head p, .focus-lab-panel__sheet p { margin: 0; color: var(--ke-color-text-muted); line-height: 1.45; }
  .focus-lab-panel__scale { display: grid; grid-template-columns: repeat(11, minmax(40px, 1fr)); gap: .35rem; margin-top: 1rem; }
  .focus-lab-panel__scale button { min-width: 0; min-height: var(--ke-focus-control-min); border: var(--ke-shape-border-hairline) solid var(--ke-color-border-score); border-radius: var(--ke-focus-control-radius); background: var(--ke-color-focus-control-surface); color: var(--ke-color-text-secondary); font: 850 .9rem/1 var(--ke-font-family-sans); cursor: pointer; }
  .focus-lab-panel__scale button:hover, .focus-lab-panel__scale button[data-selected="true"] { border-color: var(--ke-color-action-accent); background: var(--ke-color-focus-control-selected-accent); color: var(--ke-color-action-accent-strong); }
  .focus-lab-panel__scale button:focus-visible, .focus-lab-panel__sheet button:focus-visible, .focus-lab-panel__sheet textarea:focus-visible, .focus-lab-panel__sheet input:focus-visible { outline: 3px solid var(--ke-color-focus-ring-accent-subtle); outline-offset: 2px; }
  .focus-lab-panel__ends { display: flex; justify-content: space-between; margin-top: .35rem; color: var(--ke-color-text-muted); font-size: .7rem; }
  .focus-lab-panel__actions { display: flex; flex-wrap: wrap; gap: var(--ke-space-focus-control-gap); margin-top: 1rem; }
  .focus-lab-panel__status { min-height: 1.4em; margin: .7rem 0 0; color: var(--ke-color-status-success-foreground); font-size: .82rem; font-weight: 750; }
  .focus-lab-panel__confirm { display: inline-block; min-height: var(--ke-focus-control-min); color: var(--ke-color-action-primary-hover); font-weight: 850; line-height: var(--ke-focus-control-min); }
  .focus-lab-panel__confirm[hidden] { display: none; }
  .focus-lab-panel__dialog { width: min(var(--ke-focus-dialog-lab-max), calc(100% - 1rem)); max-height: var(--ke-focus-dialog-lab-max-height); border: 0; border-radius: var(--ke-shape-radius-focus-lab); padding: 0; background: transparent; color: var(--ke-color-text-secondary); box-shadow: var(--ke-elevation-focus-dialog); }
  .focus-lab-panel__dialog::backdrop { background: var(--ke-color-focus-dialog-backdrop); backdrop-filter: blur(var(--ke-focus-dialog-backdrop-blur)); }
  .focus-lab-panel__sheet { display: grid; gap: 1rem; overflow: auto; max-height: var(--ke-focus-dialog-lab-max-height); padding: clamp(1rem, 4vw, 1.5rem); background: var(--ke-color-focus-sheet-surface); }
  .focus-lab-panel__sheet header { display: flex; justify-content: space-between; gap: 1rem; }
  .focus-lab-panel__sheet header > div { display: grid; gap: .8rem; }
  .focus-lab-panel__sheet h2 { margin: 0; color: var(--ke-color-text-primary); font: var(--ke-type-focus-dialog-heading); }
  .focus-lab-panel__sheet header > button { width: var(--ke-focus-control-min); height: var(--ke-focus-control-min); flex: 0 0 auto; display: grid; place-items: center; border: var(--ke-shape-border-hairline) solid var(--ke-color-border-panel-warm); border-radius: 50%; background: var(--ke-color-focus-control-surface); color: var(--ke-color-text-primary); cursor: pointer; }
  .focus-lab-panel__sheet label { display: grid; gap: .45rem; font-weight: 800; }
  .focus-lab-panel__sheet textarea { box-sizing: border-box; width: 100%; min-height: 150px; resize: vertical; border: var(--ke-shape-border-hairline) solid var(--ke-color-border-input); border-radius: var(--ke-focus-input-radius); padding: .8rem; background: var(--ke-color-focus-control-surface); color: var(--ke-color-text-primary); font: 1rem/1.45 var(--ke-font-family-sans); }
  .focus-lab-panel__file { border: var(--ke-shape-border-hairline) dashed var(--ke-color-border-input); border-radius: var(--ke-focus-input-radius); padding: .8rem; }
  .focus-lab-panel__file small { color: var(--ke-color-text-muted); font-weight: 600; }
  .focus-lab-panel__sheet > .ke-button { width: 100%; }
  .focus-lab-panel__sheet > p[role="status"] { min-height: 1.4em; color: var(--ke-color-status-success-foreground); font-weight: 750; }
  .focus-lab-panel__sheet--invite { justify-items: center; text-align: center; }
  .focus-lab-panel__qr { width: min(280px, 90%); aspect-ratio: 1; padding: .5rem; border-radius: var(--ke-focus-input-radius); background: var(--ke-color-focus-control-surface); }
  .focus-lab-panel__qr :global(svg) { display: block; width: 100%; height: 100%; }
  .focus-lab-panel__sheet--invite .focus-lab-panel__actions { width: 100%; }
  .focus-lab-panel__sheet--invite .focus-lab-panel__actions .ke-button { flex: 1 1 180px; }
  @media (max-width: 620px) {
    .focus-lab-panel { width: min(100% - .75rem, 1120px); margin-bottom: 5rem; border-radius: var(--ke-focus-panel-radius-compact); }
    .focus-lab-panel__head { align-items: flex-start; flex-direction: column; }
    .focus-lab-panel__scale { grid-template-columns: repeat(6, minmax(40px, 1fr)); }
    .focus-lab-panel__actions .ke-button { flex: 1 1 150px; }
    .focus-lab-panel__dialog { width: 100%; margin: auto 0 0; border-radius: var(--ke-focus-panel-radius-compact) var(--ke-focus-panel-radius-compact) 0 0; }
  }
</style>
