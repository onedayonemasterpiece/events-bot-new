---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { displayDate, displayDateTime, eventAbsoluteUrl, eventCalendarHref, eventCalendarStateExpiryDay, eventHref, eventAdmissionLabel, getOtherDates, isCalendarEligible } from '../lib/events';
import { eventImageUrl } from '../lib/assets';
type CardVariant = 'overlay-controls' | 'split-actions';
interface DesktopRelatedLayout {
  mediaRatio: number;
  rowRatio: number;
  rowIndex: number;
  rowMode: string;
  mediaKind: 'document' | 'visual';
  mediaTreatment: 'document-safe-cover' | 'document-contain' | 'visual-cover';
  coverCrop: number;
  potentialCoverCrop: number;
  rowWorstCrop: number;
}
interface Props {
  event: PreviewEvent;
  label?: string;
  variant?: CardVariant;
  desktopRelatedCrop?: boolean;
  desktopRelatedLayout?: DesktopRelatedLayout;
}
const { event, label, variant = 'split-actions', desktopRelatedCrop = false, desktopRelatedLayout } = Astro.props;
const place = [event.city, event.venue_name].filter(Boolean).join(' · ');
const href = eventHref(event);
const absolute = eventAbsoluteUrl(event);
const dateLabel = displayDate(event);
const dateTimeLabel = displayDateTime(event);
const metaLabel = [label, dateTimeLabel].filter(Boolean).join(' · ');
const statusLabel = eventAdmissionLabel(event);
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count ?? 0;
const imageUrl = eventImageUrl(event.image_url);
const shareText = [event.title, [dateLabel, event.display_time, event.venue_name || event.city].filter(Boolean).join(' · '), statusLabel].filter(Boolean).join('\n');
const shareImageType = imageUrl?.toLowerCase().includes('.webp') ? 'image/webp' : imageUrl?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
function eventTypeLabel(value: string | null | undefined) {
  const raw = String(value || '').trim().replace(/\s+/gu, ' ');
  return raw ? raw.toLowerCase() : '';
}
function normalizeObjectPosition(value: string | null | undefined) {
  const raw = (value || '').trim();
  return /^[a-z0-9.%\s-]+$/i.test(raw) ? raw : null;
}
// Shared/default cards unlock cropping only through the LLM-authored
// event_photo role. The accepted desktop continuation has its own reviewed
// OCR-first framing contract and opts in explicitly below.
const imageMediaRole = event.image_media_role || 'unknown_document';
// The accepted desktop continuation contract is explicitly OCR-first: every
// verified text-free image fills the shared row frame, while OCR/unknown media
// keeps the bounded document crop budget. Other surfaces remain role-first.
const documentMedia = desktopRelatedCrop
  ? event.image_text_mode !== 'visual_only'
  : imageMediaRole !== 'event_photo';
const primaryImageAsset = event.image_assets?.find((asset) => asset.src === event.image_url) || event.image_assets?.[0];
const mediaShellClass = [
  'event-card__media-shell',
  documentMedia ? 'event-card__media-shell--document' : 'event-card__media-shell--cover',
  desktopRelatedCrop && 'event-card__media-shell--dynamic',
  desktopRelatedCrop && 'is-image-loading',
].filter(Boolean).join(' ');
const focalObjectPosition = event.focal_point ? `${Math.round(event.focal_point.x * 100)}% ${Math.round(event.focal_point.y * 100)}%` : null;
const cardObjectPosition = !documentMedia ? normalizeObjectPosition(event.image_object_position || focalObjectPosition) : null;
const focalY = event.focal_point ? Math.max(0, Math.min(1, event.focal_point.y)) : 0.5;
const focalOffset = Math.max(-12, Math.min(12, (0.5 - focalY) * 24));
const likeCountLabel = likesCount > 0 ? String(likesCount) : '';
const shareCountLabel = sharesCount > 0 ? String(sharesCount) : '';
const likeAria = likesCount > 0 ? `Поставить лайк: ${event.title}. Сейчас ${likesCount}` : `Поставить лайк: ${event.title}`;
const canAddToCalendar = isCalendarEligible(event);
const calendarHref = eventCalendarHref(event);
const calendarExpiryDay = eventCalendarStateExpiryDay(event);
const cardClass = ['event-card', `event-card--${variant}`].join(' ');
const feedbackClass = ['event-card__feedback', variant === 'split-actions' ? 'event-card__feedback--under' : 'event-card__feedback--overlay'].join(' ');
const eventTypeTag = eventTypeLabel(event.event_type);
const otherTimeLabels = getOtherDates(event)
  .filter((item) => item.start_date === event.start_date && item.display_time && item.display_time !== event.display_time)
  .map((item) => item.display_time)
  .filter((value, index, list): value is string => Boolean(value) && list.indexOf(value) === index);
const intrinsicMediaRatio = desktopRelatedLayout?.mediaRatio
  || (primaryImageAsset?.width && primaryImageAsset?.height ? primaryImageAsset.width / primaryImageAsset.height : 4 / 5);
const mediaShellStyle = [
  documentMedia ? `--card-focal-y:${focalY};--card-focal-offset:${focalOffset}%` : null,
  desktopRelatedCrop ? `--dynamic-media-ratio:${desktopRelatedLayout?.rowRatio || intrinsicMediaRatio}` : null,
].filter(Boolean).join(';');
const imageLoadHandler = desktopRelatedCrop
  ? "this.closest('.event-card__media-shell')?.classList.remove('is-image-loading'); this.closest('.event-card__media-shell')?.classList.add('is-image-loaded'); this.closest('.event-card__media-shell')?.removeAttribute('aria-busy');"
  : undefined;
const imageErrorHandler = "this.closest('.event-card__media-shell')?.classList.remove('is-image-loading'); this.closest('.event-card__media-shell')?.classList.add('is-image-missing'); this.closest('.event-card__media-shell')?.removeAttribute('aria-busy'); this.hidden = true; this.removeAttribute('src');";
---
<article
  class={cardClass}
  data-event-card
  data-feed-card-variant={variant}
  data-calendar-eligible={canAddToCalendar ? "true" : "false"}
  data-event-id={event.id}
  data-event-title={event.title}
  data-card-href={href}
  data-lab-related-card={desktopRelatedLayout ? 'true' : undefined}
  data-lab-media-kind={desktopRelatedLayout?.mediaKind}
  data-lab-media-ratio={desktopRelatedLayout?.mediaRatio.toFixed(5)}
  data-lab-row-media={desktopRelatedLayout?.rowMode}
  data-lab-row-index={desktopRelatedLayout ? String(desktopRelatedLayout.rowIndex) : undefined}
  data-lab-media-treatment={desktopRelatedLayout?.mediaTreatment}
  data-lab-cover-crop={desktopRelatedLayout?.coverCrop.toFixed(4)}
  data-lab-potential-cover-crop={desktopRelatedLayout?.potentialCoverCrop.toFixed(4)}
  data-lab-row-worst-crop={desktopRelatedLayout?.rowWorstCrop.toFixed(4)}
  style={desktopRelatedLayout ? `--lab-row-media-ratio:${desktopRelatedLayout.rowRatio.toFixed(5)}` : undefined}
  tabindex="0"
  aria-label={`${event.title}: ${dateLabel}`}
>
  <a class="event-card__media-link" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {imageUrl ? (
      <span class={mediaShellClass} data-media-role={imageMediaRole} style={mediaShellStyle || undefined} aria-busy={desktopRelatedCrop ? 'true' : undefined}>
        <span class="event-card__image-fallback" aria-hidden="true">
          <span>{dateLabel}</span>
          <strong>{event.event_type || 'событие'}</strong>
          {event.city && <span>{event.city}</span>}
        </span>
        <img
          class="event-card__media"
          src={imageUrl}
          alt={event.image_alt || `Афиша события «${event.title}»`}
          loading="lazy"
          decoding="async"
          width={primaryImageAsset?.width}
          height={primaryImageAsset?.height}
          style={cardObjectPosition ? `object-position: ${cardObjectPosition}` : undefined}
          onload={imageLoadHandler}
          onerror={imageErrorHandler}
        />
      </span>
    ) : (
      <span class="event-card__media-shell event-card__media-shell--cover event-card__fallback" aria-hidden="true">
        <span>{dateLabel}</span>
        <strong>{event.event_type || 'событие'}</strong>
        {event.city && <span>{event.city}</span>}
      </span>
    )}
  </a>
  <div class="event-card__body">
    <a class="event-card__title" href={href} data-prefetch>{event.title}</a>
    <div class="event-card__meta-row">
      {eventTypeTag && <span class="event-card__tag">{eventTypeTag}</span>}
      <span class="event-card__meta">{metaLabel}</span>
      <span class="event-card__status">{statusLabel}</span>
    </div>
    {otherTimeLabels.length > 0 && <div class="event-card__other-times" aria-label="Другие сеансы">Также: {otherTimeLabels.join(' · ')}</div>}
    {place && <span class="event-card__footer">{place}</span>}
  </div>

  {variant === 'overlay-controls' && (
    <div class={feedbackClass} data-nosnippet aria-label={`Оценить событие: ${event.title}`}>
      <button type="button" class="feedback-button feedback-button--negative" data-nosnippet data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
        <Icon name="dislike" />
        <span>Не интересно</span>
      </button>
      <button
        type="button"
        class="feedback-button feedback-button--share"
        data-nosnippet
        data-native-share
        data-share-event-id={event.id}
        data-share-event-title={event.title}
        data-share-base-count={sharesCount}
        data-share-title={event.title}
        data-share-text={shareText}
        data-share-url={absolute}
        data-share-image={imageUrl || ''}
        data-share-image-type={shareImageType}
        data-share-file-name={shareFileName}
        data-share-date-time={dateTimeLabel}
        data-share-place={event.venue_name || event.city || ''}
        data-share-admission={statusLabel}
        aria-label={`Поделиться событием: ${event.title}`}
      >
        <Icon name="share" />
        <span class="share-label" data-share-label>Поделиться</span>
        <span class="feedback-count" data-share-count>{shareCountLabel}</span>
      </button>
      <button type="button" class="feedback-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
        <Icon name="heart" />
        <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
      </button>
    </div>
  )}

  {variant === 'split-actions' && (
    <>
      <div class="event-card__utility-row" data-nosnippet aria-label={`Дополнительные действия: ${event.title}`}>
        <button type="button" class="feedback-button feedback-button--negative" data-nosnippet data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
          <Icon name="dislike" />
          <span>Не интересно</span>
        </button>
        {canAddToCalendar && (
          <a class="feedback-button feedback-button--calendar" href={calendarHref} type="text/calendar" data-calendar-action data-calendar-event-id={event.id} data-calendar-expiry-day={calendarExpiryDay} data-calendar-event-title={event.title} aria-label={`Добавить в календарь: ${event.title}`}>
            <Icon name="calendar" />
            <span data-calendar-label>В календарь</span>
          </a>
        )}
      </div>
      <div class={feedbackClass} data-nosnippet aria-label={`Оценить событие: ${event.title}`}>
        <button
          type="button"
          class="feedback-button feedback-button--share"
          data-nosnippet
          data-native-share
          data-share-event-id={event.id}
          data-share-event-title={event.title}
          data-share-base-count={sharesCount}
          data-share-title={event.title}
          data-share-text={shareText}
          data-share-url={absolute}
          data-share-image={imageUrl || ''}
          data-share-image-type={shareImageType}
          data-share-file-name={shareFileName}
          data-share-date-time={dateTimeLabel}
          data-share-place={event.venue_name || event.city || ''}
          data-share-admission={statusLabel}
          aria-label={`Поделиться событием: ${event.title}`}
        >
          <Icon name="share" />
          <span class="share-label" data-share-label>Поделиться</span>
          <span class="feedback-count" data-share-count>{shareCountLabel}</span>
        </button>
        <button type="button" class="feedback-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
          <Icon name="heart" />
          <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
        </button>
      </div>
    </>
  )}
</article>
