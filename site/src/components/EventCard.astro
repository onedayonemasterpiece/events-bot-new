---
import Icon from './Icon.astro';
import EventOccurrenceLabel from './EventOccurrenceLabel.astro';
import type { PreviewEvent } from '../lib/types';
import { displayDate, eventAbsoluteUrl, eventCalendarHref, eventCalendarStateExpiryDay, eventHref, eventAdmissionLabel, getOccurrencePresentation, isCalendarEligible, withBase } from '../lib/events';
import { eventImageUrl } from '../lib/assets';
import { relatedCardPrimaryImageAsset, resolveMobileEventCardMedia, resolveRelatedCardMediaTreatment } from '../lib/relatedCardLayout.mjs';
import './media-frame.css';

type CardVariant = 'overlay-controls' | 'split-actions';
export type EventCardRootAttributeValue = string | number | boolean | null | undefined;
export type EventCardRootAttributes = Record<string, EventCardRootAttributeValue>;

interface DesktopRelatedLayout {
  mediaRatio: number;
  rowRatio: number;
  rowIndex: number;
  rowColumn: number;
  rowMode: string;
  mediaKind: 'document' | 'visual';
  mediaTreatment: 'document-safe-cover' | 'document-contain' | 'visual-cover';
  fit: 'contain' | 'cover';
  objectPosition: string;
  cropReason: string;
  coverCrop: number | null;
  potentialCoverCrop: number | null;
  rowWorstCrop: number | null;
  rowCost: number;
}
interface Props {
  event: PreviewEvent;
  label?: string;
  variant?: CardVariant;
  desktopRelatedCrop?: boolean;
  desktopRelatedLayout?: DesktopRelatedLayout;
  runtimeTemplate?: boolean;
  mobileFlowMedia?: boolean;
  rootClassName?: string;
  rootAttributes?: EventCardRootAttributes;
}
const {
  event,
  label,
  variant = 'split-actions',
  desktopRelatedCrop = false,
  desktopRelatedLayout,
  runtimeTemplate = false,
  mobileFlowMedia = false,
  rootClassName = '',
  rootAttributes = {},
} = Astro.props;
const place = [event.city, event.venue_name].filter(Boolean).join(' · ');
const href = eventHref(event);
const absolute = eventAbsoluteUrl(event);
const dateLabel = displayDate(event);
const occurrencePresentation = getOccurrencePresentation(event);
const dateTimeLabel = occurrencePresentation.compactLabel;
const statusLabel = eventAdmissionLabel(event);
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count ?? 0;
const primaryImageAsset = relatedCardPrimaryImageAsset(event);
const imageUrl = primaryImageAsset?.src?.startsWith('/')
  ? withBase(primaryImageAsset.src)
  : eventImageUrl(primaryImageAsset?.src || event.image_url);
const shareText = [event.title, [dateLabel, event.display_time, event.venue_name || event.city].filter(Boolean).join(' · '), statusLabel].filter(Boolean).join('\n');
const shareImageType = imageUrl?.toLowerCase().includes('.webp') ? 'image/webp' : imageUrl?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : 'image/jpeg';
const shareFileName = `kenigevents-${event.slug}`;
function eventTypeLabel(value: string | null | undefined) {
  const raw = String(value || '').trim().replace(/\s+/gu, ' ');
  return raw ? raw.toLowerCase() : '';
}
function normalizeObjectPosition(value: string | null | undefined) {
  const raw = (value || '').trim();
  return /^[a-z0-9.%\s-]+$/i.test(raw) ? raw : null;
}
// Compact recommendation cards use the shared row contract. Outside that
// contract, explicit image-text evidence wins over stale semantic roles:
// visual-only media fills, while OCR/unknown documents remain fail-closed.
const imageTextMode = primaryImageAsset?.image_text_mode || event.image_text_mode || 'unknown';
const imageMediaRole = primaryImageAsset?.media_role || event.image_media_role || 'unknown_document';
const intrinsicMediaRatio = desktopRelatedLayout?.mediaRatio
  || (primaryImageAsset?.width && primaryImageAsset?.height ? primaryImageAsset.width / primaryImageAsset.height : 4 / 5);
const cardTargetAspect = desktopRelatedCrop
  ? (desktopRelatedLayout?.rowRatio || intrinsicMediaRatio)
  : 4 / 5;
// EventCard owns the final related-card treatment. The row packer calls the
// same gate while choosing its shared ratio, and client-rendered continuation
// cards consume the resulting serialized decision.
const relatedMediaDecision = desktopRelatedCrop
  ? resolveRelatedCardMediaTreatment(event, cardTargetAspect)
  : mobileFlowMedia ? resolveMobileEventCardMedia(event) : null;
const documentMedia = desktopRelatedCrop
  ? relatedMediaDecision?.mediaKind === 'document'
  : mobileFlowMedia ? relatedMediaDecision?.mediaKind === 'document' : imageTextMode !== 'visual_only';
const mediaShellClass = [
  'event-card__media-shell',
  documentMedia ? 'event-card__media-shell--document' : 'event-card__media-shell--cover',
  (desktopRelatedCrop || mobileFlowMedia) && 'event-card__media-shell--dynamic',
  'is-image-loading',
].filter(Boolean).join(' ');
// Responsive cards without an exact recommendation-row ratio fail closed. No
// surface CSS may later reinterpret the decision made here.
const cardCrop = relatedMediaDecision || (documentMedia ? {
  fit:'contain' as const,
  objectPosition:'50% 50%',
  cropReason:'document_natural_height',
  mediaTreatment:'document-contain' as const,
  potentialCoverCrop:0,
  coverCrop:0,
} : resolveRelatedCardMediaTreatment(event, cardTargetAspect));
const cardObjectPosition = cardCrop.fit === 'cover'
  ? normalizeObjectPosition(cardCrop.objectPosition)
  : null;
const focalY = event.focal_point ? Math.max(0, Math.min(1, event.focal_point.y)) : 0.5;
const focalOffset = Math.max(-12, Math.min(12, (0.5 - focalY) * 24));
const likeCountLabel = likesCount > 0 ? String(likesCount) : '';
const shareCountLabel = sharesCount > 0 ? String(sharesCount) : '';
const likeAria = likesCount > 0 ? `Поставить лайк: ${event.title}. Сейчас ${likesCount}` : `Поставить лайк: ${event.title}`;
const canAddToCalendar = isCalendarEligible(event);
const calendarHref = runtimeTemplate ? '#' : eventCalendarHref(event);
const calendarExpiryDay = eventCalendarStateExpiryDay(event);
const feedbackClass = ['event-card__feedback', variant === 'split-actions' ? 'event-card__feedback--under' : 'event-card__feedback--overlay'].join(' ');
const eventTypeTag = eventTypeLabel(event.event_type);
const mediaShellStyle = [
  documentMedia ? `--card-focal-y:${focalY};--card-focal-offset:${focalOffset}%` : null,
  (desktopRelatedCrop || mobileFlowMedia) ? `--dynamic-media-ratio:${desktopRelatedLayout?.rowRatio || relatedMediaDecision?.rowRatio || intrinsicMediaRatio}` : null,
].filter(Boolean).join(';');
const imageLoadHandler = `const shell=this.closest('.event-card__media-shell');${mobileFlowMedia && relatedMediaDecision?.useNaturalAspect ? "if(shell&&this.naturalWidth>0&&this.naturalHeight>0){shell.style.setProperty('--dynamic-media-ratio',this.naturalWidth+' / '+this.naturalHeight);shell.dataset.naturalAspectReconciled='true';}" : ''}shell?.classList.remove('is-image-loading');shell?.classList.add('is-image-loaded');shell?.removeAttribute('aria-busy');`;
const imageErrorHandler = "this.closest('.event-card__media-shell')?.classList.remove('is-image-loading'); this.closest('.event-card__media-shell')?.classList.add('is-image-missing'); this.closest('.event-card__media-shell')?.removeAttribute('aria-busy'); this.hidden = true; this.removeAttribute('src');";
const fixedLayoutMetric = (value: number | null | undefined, digits: number) => Number.isFinite(value) ? Number(value).toFixed(digits) : undefined;
const mediaFrameKind = !imageUrl
  ? 'fallback'
  : cardCrop.mediaTreatment === 'visual-cover'
    ? 'visual'
    : imageTextMode === 'ocr_text' && primaryImageAsset?.media_semantic_status !== 'error'
      ? 'document'
      : 'unknown';
const mediaFrameFit = imageUrl ? cardCrop.fit : 'contain';
const mediaFrameRole = imageMediaRole || 'unknown_document';
const mediaFrameFill = desktopRelatedCrop || mobileFlowMedia || !documentMedia;
const mediaFrameCropPermission = mediaFrameFit === 'contain'
  ? 'forbidden'
  : cardCrop.mediaTreatment === 'document-safe-cover'
    ? 'reviewed-bounded'
    : 'allowed';
const mediaFrameRatio = desktopRelatedLayout?.rowRatio || relatedMediaDecision?.rowRatio || intrinsicMediaRatio;
const mediaFrameObjectPosition = cardObjectPosition || '50% 50%';
const mediaFrameStyle = [
  mediaShellStyle,
  `--media-frame-ratio:${mediaFrameRatio}`,
  `--media-frame-object-position:${mediaFrameObjectPosition}`,
].filter(Boolean).join(';');
const EVENT_CARD_RESERVED_ROOT_ATTRIBUTES = new Set([
  'data-event-card',
  'data-ds-component',
  'data-ds-family',
  'data-ds-version',
  'data-ds-variant',
  'data-ds-state',
  'data-feed-card-variant',
  'data-calendar-eligible',
  'data-event-id',
  'data-event-title',
  'data-card-href',
  'data-lab-related-card',
  'data-lab-media-kind',
  'data-lab-media-ratio',
  'data-lab-row-media',
  'data-lab-row-index',
  'data-lab-row-column',
  'data-lab-media-treatment',
  'data-lab-crop-reason',
  'data-lab-cover-crop',
  'data-lab-potential-cover-crop',
  'data-lab-row-worst-crop',
  'data-lab-row-cost',
]);
const safeRootAttributes = Object.fromEntries(
  Object.entries(rootAttributes).filter(([name, value]) => (
    value !== undefined
    && value !== null
    && /^data-[a-z0-9_.:-]+$/u.test(name)
    && !EVENT_CARD_RESERVED_ROOT_ATTRIBUTES.has(name)
  )),
);
const cardState = [
  runtimeTemplate && 'runtime-template',
  desktopRelatedCrop && 'packed-row',
  mobileFlowMedia && 'mobile-flow',
  canAddToCalendar && 'calendar-eligible',
  `media-${mediaFrameKind}`,
  Object.keys(safeRootAttributes).length > 0 && 'consumer-metadata',
].filter(Boolean).join(' ') || undefined;
const cardClass = ['event-card', `event-card--${variant}`, rootClassName].filter(Boolean).join(' ');
---
<article
  {...safeRootAttributes}
  class={cardClass}
  data-event-card
  data-ds-component="EventCard"
  data-ds-family="EventCard"
  data-ds-version="2"
  data-ds-variant={variant}
  data-ds-state={cardState}
  data-feed-card-variant={variant}
  data-calendar-eligible={canAddToCalendar ? "true" : "false"}
  data-event-id={event.id}
  data-event-title={event.title}
  data-card-href={href}
  data-lab-related-card={desktopRelatedLayout ? 'true' : undefined}
  data-lab-media-kind={desktopRelatedLayout?.mediaKind}
  data-lab-media-ratio={desktopRelatedLayout?.mediaRatio.toFixed(5)}
  data-lab-row-media={desktopRelatedLayout?.rowMode}
  data-lab-row-index={desktopRelatedLayout ? String(desktopRelatedLayout.rowIndex) : undefined}
  data-lab-row-column={desktopRelatedLayout ? String(desktopRelatedLayout.rowColumn) : undefined}
  data-lab-media-treatment={desktopRelatedLayout ? cardCrop.mediaTreatment : undefined}
  data-lab-crop-reason={desktopRelatedLayout ? cardCrop.cropReason : undefined}
  data-lab-cover-crop={desktopRelatedLayout ? fixedLayoutMetric(cardCrop.coverCrop, 4) : undefined}
  data-lab-potential-cover-crop={desktopRelatedLayout ? fixedLayoutMetric(cardCrop.potentialCoverCrop, 4) : undefined}
  data-lab-row-worst-crop={fixedLayoutMetric(desktopRelatedLayout?.rowWorstCrop, 4)}
  data-lab-row-cost={desktopRelatedLayout?.rowCost.toFixed(5)}
  style={desktopRelatedLayout ? `--lab-row-media-ratio:${desktopRelatedLayout.rowRatio.toFixed(5)}` : undefined}
  tabindex="0"
  aria-label={`${event.title}: ${dateLabel}`}
>
  <a class="event-card__media-link" href={href} data-card-media-link data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {imageUrl ? (
      <span
        class={mediaShellClass}
        data-card-media-shell
        data-media-role={mediaFrameRole}
        data-media-frame
        data-media-frame-contract="v1"
        data-media-frame-style-owner="media-frame.css"
        data-media-frame-surface="event-card"
        data-media-frame-role={mediaFrameRole}
        data-media-frame-kind={mediaFrameKind}
        data-media-frame-fit={mediaFrameFit}
        data-media-frame-crop-permission={mediaFrameCropPermission}
        data-media-frame-ratio={fixedLayoutMetric(mediaFrameRatio, 5)}
        data-media-frame-object-position={mediaFrameObjectPosition}
        data-media-frame-focal-position={mediaFrameObjectPosition}
        data-media-frame-crop-reason={cardCrop.cropReason}
        data-media-frame-clip="frame"
        data-media-frame-radius="surface"
        data-media-frame-fill={mediaFrameFill ? 'true' : undefined}
        data-media-frame-source-width={primaryImageAsset?.width}
        data-media-frame-source-height={primaryImageAsset?.height}
        data-media-frame-loading="lazy"
        data-media-frame-interaction-owner="caller"
        style={mediaFrameStyle || undefined}
        aria-busy="true"
      >
        <span class="event-card__image-fallback" data-card-image-fallback data-media-frame-fallback aria-hidden="true">
          <span data-card-fallback-date>{dateLabel}</span>
          <strong data-card-fallback-type>{event.event_type || 'событие'}</strong>
          {event.city && <span data-card-fallback-city>{event.city}</span>}
        </span>
        <img
          class="event-card__media"
          data-card-image
          data-media-frame-image
          src={imageUrl}
          alt={event.image_alt || `Афиша события «${event.title}»`}
          loading="lazy"
          decoding="async"
          width={primaryImageAsset?.width}
          height={primaryImageAsset?.height}
          data-card-authoritative-fit={cardCrop.fit}
          data-protected-crop-fit={cardCrop.fit}
          data-protected-crop-reason={cardCrop.cropReason}
          data-card-media-review={primaryImageAsset?.listing_crop_evidence}
          onload={imageLoadHandler}
          onerror={imageErrorHandler}
        />
      </span>
    ) : (
      <span
        class="event-card__media-shell event-card__media-shell--cover event-card__fallback"
        data-card-media-shell
        data-media-frame
        data-media-frame-contract="v1"
        data-media-frame-style-owner="media-frame.css"
        data-media-frame-surface="event-card"
        data-media-frame-role="fallback"
        data-media-frame-kind="fallback"
        data-media-frame-fit="contain"
        data-media-frame-crop-permission="forbidden"
        data-media-frame-ratio={fixedLayoutMetric(mediaFrameRatio, 5)}
        data-media-frame-object-position="50% 50%"
        data-media-frame-focal-position="50% 50%"
        data-media-frame-crop-reason="event_card_fallback"
        data-media-frame-clip="frame"
        data-media-frame-radius="surface"
        data-media-frame-fill="true"
        data-media-frame-loading="lazy"
        data-media-frame-interaction-owner="caller"
        data-media-frame-fallback
        style={`--media-frame-ratio:${mediaFrameRatio};--media-frame-object-position:50% 50%`}
        aria-hidden="true"
      >
        <span data-card-fallback-date>{dateLabel}</span>
        <strong data-card-fallback-type>{event.event_type || 'событие'}</strong>
        {event.city && <span data-card-fallback-city>{event.city}</span>}
      </span>
    )}
  </a>
  <div class="event-card__body">
    <a class="event-card__title" href={href} data-card-title data-prefetch>{event.title}</a>
    <div class="event-card__meta-row">
      {eventTypeTag && <span class="event-card__tag" data-card-type>{eventTypeTag}</span>}
      <span class="event-card__meta" data-card-meta>
        {label && <><span>{label}</span><span aria-hidden="true"> · </span></>}
        <EventOccurrenceLabel presentation={occurrencePresentation} />
      </span>
      <span class="event-card__status" data-card-status>{statusLabel}</span>
    </div>
    {place && <span class="event-card__footer" data-card-place>{place}</span>}
  </div>

  {variant === 'overlay-controls' && (
    <div class={feedbackClass} data-nosnippet aria-label={`Оценить событие: ${event.title}`}>
      <button type="button" class="feedback-button feedback-button--negative" data-nosnippet data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
        <Icon name="dislike" />
        <span>Не интересно</span>
      </button>
      <button
        type="button"
        class="feedback-button feedback-button--share"
        data-nosnippet
        data-native-share
        data-share-event-id={event.id}
        data-share-event-title={event.title}
        data-share-base-count={sharesCount}
        data-share-title={event.title}
        data-share-text={shareText}
        data-share-url={absolute}
        data-share-image={imageUrl || ''}
        data-share-image-type={shareImageType}
        data-share-image-text-mode={imageTextMode}
        data-share-brand-image={withBase('/brand/announcements-wordmark-ui.svg')}
        data-share-file-name={shareFileName}
        data-share-date-time={dateTimeLabel}
        data-share-place={event.venue_name || event.city || ''}
        data-share-admission={statusLabel}
        aria-label={`Поделиться событием: ${event.title}`}
      >
        <Icon name="share" />
        <span class="share-label" data-share-label>Поделиться</span>
        <span class="feedback-count" data-share-count>{shareCountLabel}</span>
      </button>
      <button type="button" class="feedback-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
        <Icon name="heart" />
        <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
      </button>
    </div>
  )}

  {variant === 'split-actions' && (
    <>
      <div class="event-card__utility-row" data-nosnippet aria-label={`Дополнительные действия: ${event.title}`}>
        <button type="button" class="feedback-button feedback-button--negative" data-nosnippet data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
          <Icon name="dislike" />
          <span>Не интересно</span>
        </button>
        {canAddToCalendar && (
          <a class="feedback-button feedback-button--calendar" href={calendarHref} type="text/calendar" data-calendar-action data-calendar-event-id={event.id} data-calendar-expiry-day={calendarExpiryDay} data-calendar-event-title={event.title} aria-label={`Добавить в календарь: ${event.title}`}>
            <Icon name="calendar" />
            <span data-calendar-label>В календарь</span>
          </a>
        )}
      </div>
      <div class={feedbackClass} data-nosnippet aria-label={`Оценить событие: ${event.title}`}>
        <button
          type="button"
          class="feedback-button feedback-button--share"
          data-nosnippet
          data-native-share
          data-share-event-id={event.id}
          data-share-event-title={event.title}
          data-share-base-count={sharesCount}
          data-share-title={event.title}
          data-share-text={shareText}
          data-share-url={absolute}
          data-share-image={imageUrl || ''}
          data-share-image-type={shareImageType}
          data-share-image-text-mode={imageTextMode}
          data-share-brand-image={withBase('/brand/announcements-wordmark-ui.svg')}
          data-share-file-name={shareFileName}
          data-share-date-time={dateTimeLabel}
          data-share-place={event.venue_name || event.city || ''}
          data-share-admission={statusLabel}
          aria-label={`Поделиться событием: ${event.title}`}
        >
          <Icon name="share" />
          <span class="share-label" data-share-label>Поделиться</span>
          <span class="feedback-count" data-share-count>{shareCountLabel}</span>
        </button>
        <button type="button" class="feedback-button feedback-button--like" data-nosnippet data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
          <Icon name="heart" />
          <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
        </button>
      </div>
    </>
  )}
</article>
