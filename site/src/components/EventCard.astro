---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { eventAbsoluteUrl, eventCalendarHref, eventHref } from '../lib/events';
interface Props { event: PreviewEvent; label?: string }
const { event, label } = Astro.props;
const place = [event.city, event.venue_name].filter(Boolean).join(' · ');
const href = eventHref(event);
const calendarHref = eventCalendarHref(event);
const absolute = eventAbsoluteUrl(event);
const metaLabel = [label, event.display_date + (event.display_time ? ` · ${event.display_time}` : '')].filter(Boolean).join(' · ');
const statusLabel = event.ticket.price_label || event.status_label;
const likesCount = event.likes_count || 0;
const shareText = [event.display_date, event.display_time, event.venue_name || event.city].filter(Boolean).join(' · ');
const mediaClass = ['event-card__media', event.image_text_mode === 'visual_only' ? 'event-card__media--cover' : 'event-card__media--preserve'].join(' ');
---
<article class="event-card" data-event-card data-event-id={event.id} data-event-title={event.title} aria-label={`${event.title}: ${event.display_date}`}>
  <a class="event-card__media-link" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {event.image_url ? (
      <img class={mediaClass} src={event.image_url} alt={event.image_alt || `Афиша события «${event.title}»`} width="480" height="640" loading="lazy" decoding="async" />
    ) : (
      <span class="event-card__media event-card__fallback" aria-hidden="true">
        <span>{event.display_date}</span>
        <strong>{event.event_type || 'событие'}</strong>
        {event.city && <span>{event.city}</span>}
      </span>
    )}
  </a>
  <div class="event-card__feedback" aria-label={`Оценить событие: ${event.title}`}>
    <button type="button" class="feedback-button feedback-button--negative" data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
      <Icon name="dislike" />
      <span>Не интересно</span>
    </button>
    <button type="button" class="feedback-button feedback-button--like" data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={`Поставить лайк: ${event.title}`}>
      <Icon name="heart" />
      <span class="feedback-count" data-feedback-count>{likesCount}</span>
    </button>
  </div>

  <button
    type="button"
    class="like-share-callout"
    data-like-share-callout
    data-native-share
    data-share-title={event.title}
    data-share-text={shareText}
    data-share-url={absolute}
    hidden
    aria-label={`Поделиться событием: ${event.title}`}
  >
    <span class="like-share-callout__text">Понравилось?</span>
    <strong><Icon name="share" /> <span data-share-label>Поделиться</span></strong>
  </button>
  <div class="event-card__body">
    <div class="event-card__meta-row">
      <span class="event-card__meta">{metaLabel}</span>
      <span class="event-card__status">{statusLabel}</span>
    </div>
    <a class="event-card__title" href={href} data-prefetch>{event.title}</a>
    {place && <span class="event-card__footer">{place}</span>}
    <div class="event-card__actions" aria-label={`Быстрые действия: ${event.title}`}>
      <a href={calendarHref} type="text/calendar" aria-label={`Добавить в календарь: ${event.title}`}><Icon name="calendar" /> <span>В календарь</span></a>
      <a href={href} data-prefetch>Открыть</a>
    </div>
  </div>
</article>
