---
import Icon from './Icon.astro';
import type { PreviewEvent } from '../lib/types';
import { eventAbsoluteUrl, eventHref } from '../lib/events';
interface Props { event: PreviewEvent; label?: string }
const { event, label } = Astro.props;
const place = [event.city, event.venue_name].filter(Boolean).join(' · ');
const href = eventHref(event);
const absolute = eventAbsoluteUrl(event);
const metaLabel = [label, event.display_date + (event.display_time ? ` · ${event.display_time}` : '')].filter(Boolean).join(' · ');
const statusLabel = event.ticket.price_label || event.status_label;
const likesCount = event.likes_count || 0;
const sharesCount = event.shares_count ?? Math.max(0, Math.round(likesCount * 0.18));
const shareText = [event.display_date, event.display_time, event.venue_name || event.city].filter(Boolean).join(' · ');
const preservePoster = event.image_text_mode !== 'visual_only';
const mediaShellClass = ['event-card__media-shell', preservePoster ? 'event-card__media-shell--preserve' : 'event-card__media-shell--cover'].join(' ');
const likeCountLabel = likesCount > 0 ? String(likesCount) : '';
const shareCountLabel = sharesCount > 0 ? String(sharesCount) : '';
const likeAria = likesCount > 0 ? `Поставить лайк: ${event.title}. Сейчас ${likesCount}` : `Поставить лайк: ${event.title}`;
const feedbackClass = 'event-card__feedback';
---
<article class="event-card" data-event-card data-event-id={event.id} data-event-title={event.title} data-card-href={href} tabindex="0" aria-label={`${event.title}: ${event.display_date}`}>
  <a class="event-card__media-link" href={href} data-prefetch aria-label={`Открыть событие: ${event.title}`}>
    {event.image_url ? (
      <span class={mediaShellClass}>
        <img class="event-card__media" src={event.image_url} alt={event.image_alt || `Афиша события «${event.title}»`} loading="lazy" decoding="async" />
      </span>
    ) : (
      <span class="event-card__media-shell event-card__media-shell--cover event-card__fallback" aria-hidden="true">
        <span>{event.display_date}</span>
        <strong>{event.event_type || 'событие'}</strong>
        {event.city && <span>{event.city}</span>}
      </span>
    )}
  </a>
  <div class={feedbackClass} aria-label={`Оценить событие: ${event.title}`}>
    <button type="button" class="feedback-button feedback-button--negative" data-feedback-action="not_interested" data-event-id={event.id} data-event-title={event.title} aria-pressed="false" aria-label={`Не интересно: ${event.title}`}>
      <Icon name="dislike" />
      <span>Не интересно</span>
    </button>
    <button
      type="button"
      class="feedback-button feedback-button--share"
      data-native-share
      data-share-event-id={event.id}
      data-share-event-title={event.title}
      data-share-base-count={sharesCount}
      data-share-title={event.title}
      data-share-text={shareText}
      data-share-url={absolute}
      aria-label={`Поделиться событием: ${event.title}`}
    >
      <Icon name="share" />
      <span class="share-label" data-share-label>Поделиться</span>
      <span class="feedback-count" data-share-count>{shareCountLabel}</span>
    </button>
    <button type="button" class="feedback-button feedback-button--like" data-feedback-action="like" data-event-id={event.id} data-event-title={event.title} data-base-count={likesCount} aria-pressed="false" aria-label={likeAria}>
      <Icon name="heart" />
      <span class="feedback-count" data-feedback-count>{likeCountLabel}</span>
    </button>
  </div>

  <div class="event-card__body">
    <div class="event-card__meta-row">
      <span class="event-card__meta">{metaLabel}</span>
      <span class="event-card__status">{statusLabel}</span>
    </div>
    <a class="event-card__title" href={href} data-prefetch>{event.title}</a>
    {place && <span class="event-card__footer">{place}</span>}

  </div>
</article>
