---
import AdaptiveEventCardGrid from './AdaptiveEventCardGrid.astro';
import './design-system/foundations.css';
import './design-system/product-contour-foundations.css';
import type { PreviewEvent } from '../lib/types';
import { withBase } from '../lib/events';
import { freeCollectionCountMessage } from '../lib/freeCollection.mjs';
import { toPersonalFeedCandidate } from '../lib/personalization/catalog';
import { planRelatedCardRows } from '../lib/relatedCardLayout.mjs';

interface Props {
  title: string;
  description: string;
  criteria: string;
  updatedDate: string;
  referenceDate: string;
  events: PreviewEvent[];
  /** Runtime may update this after eligible free-event loading. */
  totalEvents?: number;
}
const { title, description, criteria, updatedDate, referenceDate, events, totalEvents = events.length } = Astro.props;
const freeComposition = planRelatedCardRows(events, { rowSize:3, presentation:'flow' });
const plannedEvents = freeComposition.map(({ item }) => item);
const initialEvents = plannedEvents.slice(0, 12);
const loadedCount = initialEvents.length;
const totalCount = Math.max(loadedCount, Number.isFinite(totalEvents) ? Math.floor(totalEvents) : loadedCount);
const surfaceState = events.length ? 'populated' : 'empty';
const freeCatalog = {
  version: 1, schema_version: 'listing-personal-feed-v1',
  feature_schema_version: 'event-detail-related-v1', taxonomy_version: 'event-taxonomy-v1',
  surface: 'free_collection', algorithm_id: 'static_personal_feed_catalog_v1',
  page_size: 12, preload_target: 12, eligibility_filter: 'confirmed-free',
  composition_order: 'global-natural-rows-v1',
  composition_source_event_ids: events.map((event) => event.id),
  related_static: plannedEvents.map((event) => toPersonalFeedCandidate(event, referenceDate)),
};
const freeCatalogJson = JSON.stringify(freeCatalog).replace(/</gu, '\\u003c');
---
<main
  id="main"
  class="free-collection"
  data-ds-family="FreeCollectionSurface"
  data-ds-version="1"
  data-ds-variant="standard-free-listing"
  data-ds-state={surfaceState}
  data-free-collection-surface
>
  <div class="page-shell free-collection__shell">
    <section class="free-collection__hero" aria-labelledby="free-collection-title" data-free-collection-hero>
      <div class="free-collection__copy">
        <h1 id="free-collection-title">Бесплатные события</h1>
        <p class="lead">{description}</p>
      </div>
      <span class="free-collection__medallion free-collection__medallion--hero" aria-label="Бесплатные события: ноль рублей" data-free-collection-medallion="large">
        <img src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" width="512" height="512" />
      </span>
    </section>

    <section id="free-collection-results" class="free-collection__results" aria-labelledby="free-collection-results-title" data-free-collection-event-group="events">
      <div class="free-collection__results-head">
        <h2 id="free-collection-results-title">События</h2>
        <p data-free-collection-result-count data-free-collection-loaded-count={loadedCount} data-free-collection-total-count={totalCount} role="status" aria-live="polite">
          {freeCollectionCountMessage(loadedCount, totalCount)}
        </p>
      </div>
      {events.length ? (
        <AdaptiveEventCardGrid
          events={initialEvents}
          mode="flow"
          rowSize={3}
          responsive="progressive"
          mobileFlowMedia
          discoveryFeed
          discoverySrc="#free-collection-catalog"
          runtimeManaged
          runtimeVisibleOnly
          runtimeSourcePolicy="all-direct"
          rootAttributes={{
            'data-search-collection-results':'',
            'data-free-collection-grid':'',
            'data-free-collection-eligibility':'confirmed-free',
            'data-free-collection-composition-order':'global-natural-rows-v1',
          }}
        />
        <button type="button" class="secondary-button free-collection__load-more" data-free-collection-load-more data-discovery-load-more hidden>Показать ещё</button>
      ) : (
        <p class="free-collection__empty">Сейчас в актуальной выгрузке нет событий с подтверждённым бесплатным входом.</p>
      )}
    </section>
    <script id="free-collection-catalog" type="application/json" set:html={freeCatalogJson}></script>
  </div>
</main>

<style>
  .free-collection { padding:0 0 4rem; }
  /* One grid-spanning native sticky node: no hero/compact copy handoff. */
  .free-collection__shell { display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:var(--ke-space-6); row-gap:1rem; padding-top:12px; }
  @media(min-width:760px) { .free-collection__shell { padding-top:72px; } }
  .free-collection__hero { display:contents; }
  .free-collection__copy { grid-area:2 / 1 / 3 / 2; min-width:0; }
  .free-collection__copy h1 { margin:0 0 var(--ke-space-4); font:var(--ke-type-h1); letter-spacing:var(--ke-type-h1-letter); }
  .free-collection__copy .lead { max-width:58ch; }
  .free-collection__medallion { display:grid; place-items:center; flex:none; }
  .free-collection__medallion img { width:100%; height:100%; object-fit:contain; }
  .free-collection__medallion--hero {
    justify-self:end;align-self:start;grid-area:2 / 2 / 4 / 3;
    position:sticky;top:var(--fi-free-top,88px);z-index:62;
    width:var(--ke-free-medallion-sticky-size);height:var(--ke-free-medallion-sticky-size);
    transform-origin:right top;overflow-anchor:none;pointer-events:none;
    filter:drop-shadow(0 10px 17px var(--ke-color-free-medallion-shadow-strong));
  }
  @keyframes free-medallion-settle { from {transform:scale(1);} to {transform:scale(.84);} }
  @supports(animation-timeline:scroll(root block)) {
    :global(body[data-fi-free]) .free-collection__medallion--hero {animation:free-medallion-settle 1s cubic-bezier(.42,0,.58,1) both;animation-timeline:scroll(root block);animation-range:var(--fi-free-start,0px) var(--fi-free-end,112px);}
  }
  .free-collection__results {
    grid-area:3 / 1 / 4 / -1;
    scroll-margin-top:142px;
    padding-block:var(--ke-space-4);
  }
  .free-collection__results-head { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:1.25rem; }
  .free-collection__results h2 { margin:0; font:var(--ke-type-h2); letter-spacing:var(--ke-type-h2-letter); }
  .free-collection__results-head p { margin:0; color:var(--ke-color-text-muted); }
  .free-collection__empty { max-width:62ch; color:var(--ke-color-text-muted); }
  @media(max-width:759px) {
    .free-collection { padding-bottom:calc(5rem + env(safe-area-inset-bottom)); }
    .free-collection__shell { width:min(100% - 24px,1120px); }
    .free-collection__shell {column-gap:var(--ke-space-3);}
    .free-collection__copy h1 { font:var(--ke-type-h1-compact); letter-spacing:var(--ke-type-h1-compact-letter); max-width:100%; overflow-wrap:normal; word-break:normal; hyphens:none; }
    .free-collection__copy .lead { font-size:.95rem; }
    .free-collection__copy .collection-criteria,.free-collection__copy .muted-note { font-size:.76rem; line-height:1.35; }
    /* Page identity only: owner requested a larger Free medallion, not a
       global badge scale or an overlay that hides a card's poster text. */
    .free-collection__medallion--hero {
      width:calc(2 * var(--ke-free-medallion-sticky-size-compact));
      height:calc(2 * var(--ke-free-medallion-sticky-size-compact));
      top:var(--fi-free-top,20px);
    }
    .free-collection__results { padding-block:var(--ke-space-4); }
    .free-collection__results-head { align-items:start; flex-direction:column; gap:.25rem; }
  }
  @media(prefers-reduced-motion:reduce) {
    :global(body[data-fi-free]) .free-collection__medallion--hero {animation:none;}
  }
</style>
