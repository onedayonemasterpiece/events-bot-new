---
import AdaptiveEventCardGrid from './AdaptiveEventCardGrid.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import './design-system/foundations.css';
import './design-system/product-contour-foundations.css';
import type { PreviewEvent } from '../lib/types';
import { siteHomeHref, withBase } from '../lib/events';

interface Props {
  title: string;
  description: string;
  criteria: string;
  updatedDate: string;
  referenceDate: string;
  events: PreviewEvent[];
}
const { title, description, criteria, updatedDate, referenceDate, events } = Astro.props;
const isExhibition = (event: PreviewEvent) => (event.event_type || '').trim().toLocaleLowerCase('ru-RU') === 'выставка'
  || event.topics.includes('EXHIBITIONS');
const exhibitionEvents = events.filter(isExhibition);
const regularEvents = events.filter((event) => !isExhibition(event));
const surfaceState = events.length
  ? [regularEvents.length ? 'timed' : null, exhibitionEvents.length ? 'exhibitions' : null, 'populated'].filter(Boolean).join(' ')
  : 'empty';
---
<main
  id="main"
  class="free-collection"
  data-ds-family="FreeCollectionSurface"
  data-ds-version="1"
  data-ds-variant="timed-and-exhibitions"
  data-ds-state={surfaceState}
  data-free-collection-surface
>
  <div class="page-shell free-collection__shell">
    <Breadcrumbs
      parents={[
        { label:'Афиша', href:siteHomeHref() },
      ]}
      current={title}
    />

    <section class="free-collection__hero" aria-labelledby="free-collection-title" data-free-collection-hero>
      <div class="free-collection__copy">
        <p class="eyebrow">Готовая подборка</p>
        <h1 id="free-collection-title">{title}</h1>
        <p class="lead">{description}</p>
        <p class="collection-criteria"><strong>Как собрана:</strong> {criteria}</p>
        <p class="muted-note">Данные афиши обновлены {updatedDate}; подборка рассчитана на {referenceDate}. Это не личный сохранённый поиск.</p>
      </div>
      <span class="free-collection__medallion free-collection__medallion--hero" aria-label="Бесплатные события: ноль рублей" data-free-collection-medallion="large">
        <img src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" width="512" height="512" />
      </span>
    </section>

    <div class="free-collection__sticky-identity" data-free-collection-sticky-identity aria-hidden="true">
      <span class="free-collection__medallion free-collection__medallion--compact" data-free-collection-medallion="compact">
        <img src={withBase('/assets/badges/free-listing-medallion.svg')} alt="" width="512" height="512" />
      </span>
    </div>

    <section id="free-collection-results" class="free-collection__results" aria-labelledby="free-collection-results-title" data-free-collection-event-group="events">
      <h2 id="free-collection-results-title">
        {events.length
          ? (regularEvents.length ? `${regularEvents.length} событий` : 'Событий вне выставок пока нет')
          : 'Подходящих событий пока нет'}
      </h2>
      {events.length ? (
        regularEvents.length ? (
          <AdaptiveEventCardGrid
            events={regularEvents}
            mode="flow"
            rowSize={3}
            responsive="progressive"
            mobileFlowMedia
            rootAttributes={{
              'data-search-collection-results':'',
              'data-free-collection-grid':'events',
            }}
          />
        ) : (
          <p class="free-collection__empty">Сейчас все актуальные варианты этой подборки — продолжающиеся выставки. Они собраны отдельно ниже.</p>
        )
      ) : (
        <p class="free-collection__empty">Сейчас в актуальной выгрузке нет событий с подтверждённым бесплатным входом. Неизвестные условия не добавляются ради заполнения страницы.</p>
      )}
    </section>

    {exhibitionEvents.length > 0 && (
      <section class="free-collection__results free-collection__results--exhibitions" aria-labelledby="free-collection-exhibitions-title" data-free-collection-event-group="exhibitions">
        <p class="eyebrow">Можно посетить в течение дня</p>
        <h2 id="free-collection-exhibitions-title">Бесплатные выставки · {exhibitionEvents.length}</h2>
        <p class="free-collection__group-note">Продолжающиеся выставки отделены от событий с конкретным временем, чтобы их было проще просматривать.</p>
        <AdaptiveEventCardGrid
          events={exhibitionEvents}
          mode="flow"
          rowSize={3}
          responsive="progressive"
          mobileFlowMedia
          rootAttributes={{
            'data-search-collection-exhibitions':'',
            'data-free-collection-grid':'exhibitions',
          }}
        />
      </section>
    )}
  </div>
</main>

<script>
  const root = document.querySelector('[data-free-collection-surface]');
  const hero = root?.querySelector('[data-free-collection-hero]');
  const stickyIdentity = root?.querySelector('[data-free-collection-sticky-identity]');
  if (hero instanceof HTMLElement && stickyIdentity instanceof HTMLElement) {
    const sync = () => {
      const top = window.matchMedia('(max-width: 759px)').matches ? 64 : 57;
      stickyIdentity.toggleAttribute('data-compact-visible', hero.getBoundingClientRect().bottom <= top + 16);
    };
    sync();
    document.addEventListener('scroll', sync, { passive:true });
    window.addEventListener('resize', sync, { passive:true });
  }
</script>

<style>
  .free-collection { padding:0 0 4rem; }
  .free-collection__shell { display:grid; gap:1rem; }
  .free-collection__hero {
    min-height:clamp(280px,34vw,430px);
    display:grid;
    grid-template-columns:minmax(0,1fr) var(--ke-free-medallion-hero-size);
    align-items:center;
    gap:var(--ke-free-hero-gap);
    padding:var(--ke-free-hero-padding);
    border:var(--ke-shape-border-hairline) solid var(--ke-color-free-border);
    border-radius:var(--ke-free-hero-radius);
    background:
      radial-gradient(circle at 84% 42%,color-mix(in srgb,var(--ke-color-free-hero-glow) 18%,transparent),transparent 28%),
      linear-gradient(135deg,var(--ke-color-free-hero-start),var(--ke-color-free-hero-end));
    box-shadow:var(--ke-elevation-free-hero);
    overflow:hidden;
  }
  .free-collection__copy { min-width:0; }
  .free-collection__copy h1 { max-width:12ch; margin:.15rem 0 1rem; font:var(--ke-type-display-collection); letter-spacing:var(--ke-type-display-collection-letter); }
  .free-collection__copy .lead { max-width:58ch; }
  .free-collection__medallion { display:grid; place-items:center; flex:none; }
  .free-collection__medallion img { width:100%; height:100%; object-fit:contain; }
  .free-collection__medallion--hero {
    justify-self:end;
    width:var(--ke-free-medallion-hero-size);
    height:var(--ke-free-medallion-hero-size);
    filter:drop-shadow(0 22px 30px var(--ke-color-free-medallion-shadow));
  }
  .free-collection__sticky-identity {
    position:sticky;
    z-index:var(--ke-free-sticky-layer);
    top:var(--ke-free-sticky-top);
    height:0;
    display:flex;
    justify-content:flex-end;
    padding-right:clamp(8px,1.6vw,18px);
    pointer-events:none;
  }
  .free-collection__medallion--compact {
    width:var(--ke-free-medallion-sticky-size);
    height:var(--ke-free-medallion-sticky-size);
    opacity:0;
    transform:translateY(-10px) scale(.82);
    filter:drop-shadow(0 10px 17px var(--ke-color-free-medallion-shadow-strong));
    transition:opacity var(--ke-free-motion-opacity),transform var(--ke-free-motion-transform);
  }
  .free-collection__sticky-identity[data-compact-visible] .free-collection__medallion--compact { opacity:1; transform:none; }
  .free-collection__results {
    scroll-margin-top:142px;
    padding:var(--ke-free-results-padding);
    border:var(--ke-shape-border-hairline) solid var(--ke-color-free-results-border);
    border-radius:var(--ke-free-results-radius);
    background:var(--ke-color-free-results-surface);
  }
  .free-collection__results h2 { margin:0 0 1.25rem; font:var(--ke-type-h2); letter-spacing:var(--ke-type-h2-letter); }
  .free-collection__results--exhibitions { margin-top:.25rem; }
  .free-collection__results--exhibitions .eyebrow { margin-bottom:.35rem; }
  .free-collection__group-note { max-width:64ch; margin:-.65rem 0 1.25rem; color:var(--ke-color-text-muted); }
  .free-collection__empty { max-width:62ch; color:var(--ke-color-text-muted); }
  @media(max-width:759px) {
    .free-collection { padding-bottom:calc(5rem + env(safe-area-inset-bottom)); }
    .free-collection__shell { width:min(100% - 24px,1120px); }
    .free-collection__hero {
      min-height:268px;
      grid-template-columns:minmax(0,1fr) var(--ke-free-medallion-hero-size-compact);
      gap:6px;
      padding:26px 18px 24px;
      border-radius:var(--ke-free-hero-radius-compact);
    }
    .free-collection__copy h1 { overflow-wrap:normal; word-break:normal; hyphens:none; }
    .free-collection__copy .lead { font-size:.95rem; }
    .free-collection__copy .collection-criteria,.free-collection__copy .muted-note { font-size:.76rem; line-height:1.35; }
    .free-collection__medallion--hero {
      width:var(--ke-free-medallion-hero-size-compact);
      height:var(--ke-free-medallion-hero-size-compact);
      align-self:start;
      margin-top:44px;
    }
    .free-collection__sticky-identity { top:var(--ke-free-sticky-top-compact); z-index:var(--ke-free-sticky-layer-compact); padding-right:6px; }
    .free-collection__medallion--compact { width:var(--ke-free-medallion-sticky-size-compact); height:var(--ke-free-medallion-sticky-size-compact); }
    .free-collection__results { padding:20px 12px; border-radius:var(--ke-free-results-radius-compact); }
  }
  @media(prefers-reduced-motion:reduce) {
    .free-collection__medallion--compact { transition:none; }
  }
</style>
