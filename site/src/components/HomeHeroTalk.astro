---
import type { PreviewEvent } from '../lib/types';
import { displayDateTimeWithWeekday, eventAdmissionLabel, eventHref, withBase } from '../lib/events';
import { eventImageUrl } from '../lib/assets';

interface Props { event: PreviewEvent | null; }
const { event } = Astro.props;
const href = event ? eventHref(event) : withBase('/segodnya/');
const image = event ? eventImageUrl(event.image_url) : null;
const fit = event?.image_text_mode === 'visual_only' ? 'cover' : 'contain';
const focalY = event?.focal_point?.y == null ? 50 : Math.round(Math.max(0, Math.min(1, event.focal_point.y)) * 100);
---

<section
  class="home-hero-talk"
  data-ds-family="HomeHeroTalk"
  data-ds-version="1"
  data-ds-variant="editorial-feature"
  data-ds-state={event ? 'featured-event' : 'fallback'}
  data-home-hero-talk
  aria-labelledby="home-hero-title"
>
  <div class="home-hero-talk__copy">
    <p class="eyebrow">Полюбить Калининград · Анонсы</p>
    <h1 id="home-hero-title">Куда пойти — без лишнего шума</h1>
    <p class="home-hero-talk__lead">Актуальные события города и области. Начните с общего выбора: лента уже полезна без входа и постепенно меняется только по вашим локальным оценкам.</p>
    <div class="home-hero-talk__actions">
      <a class="cta-button" href={withBase('/segodnya/')}>Что сегодня</a>
      <a class="secondary-button" href={withBase('/poisk/')}>Найти событие</a>
    </div>
  </div>
  {event && (
    <a class="home-hero-talk__event" href={href} aria-label={`Открыть событие: ${event.title}`}>
      <span class={`home-hero-talk__media home-hero-talk__media--${fit}`} style={`--home-hero-focal-y:${focalY}%`}>
        {image ? <img src={image} alt={event.image_alt || `Афиша события «${event.title}»`} loading="eager" decoding="async" /> : <span aria-hidden="true">Анонсы</span>}
      </span>
      <span class="home-hero-talk__event-copy">
        <small>Ближайший заметный план</small>
        <strong>{event.title}</strong>
        <span>{displayDateTimeWithWeekday(event)}</span>
        <span>{[event.venue_name || event.city, eventAdmissionLabel(event)].filter(Boolean).join(' · ')}</span>
      </span>
    </a>
  )}
</section>

<style>
  .home-hero-talk {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr);
    gap: var(--ke-space-home-hero-gap);
    align-items: stretch;
    padding: var(--ke-space-home-hero-padding);
    border: 1px solid var(--ke-color-border-brand-soft);
    border-radius: var(--ke-shape-radius-home-hero);
    background: linear-gradient(135deg, var(--ke-color-home-hero-start) 0%, var(--ke-color-home-hero-end) 100%);
    box-shadow: var(--ke-elevation-home-hero);
    overflow: hidden;
  }
  .home-hero-talk__copy { display: grid; align-content: center; }
  .home-hero-talk h1 {
    max-width: 11ch;
    margin: .15rem 0 .85rem;
    font: var(--ke-type-display-home);
    letter-spacing: var(--ke-type-display-home-letter);
  }
  .home-hero-talk__lead {
    max-width: 54ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.8vw, 1.22rem);
    line-height: 1.48;
  }
  .home-hero-talk__actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.2rem; }
  .home-hero-talk__event {
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(20rem, 1fr) auto;
    border-radius: 28px;
    overflow: hidden;
    background: var(--ke-color-home-feature-surface);
    color: var(--ke-color-home-feature-text);
    text-decoration: none;
    box-shadow: var(--ke-elevation-home-feature);
  }
  .home-hero-talk__media {
    position: relative;
    min-height: 20rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 30% 20%, var(--ke-color-home-ambient-start), var(--ke-color-home-ambient-end) 72%);
  }
  .home-hero-talk__media img { width: 100%; height: 100%; }
  .home-hero-talk__media--cover img { object-fit: cover; object-position: 50% var(--home-hero-focal-y); }
  .home-hero-talk__media--contain img { object-fit: contain; object-position: 50% 50%; }
  .home-hero-talk__media > span { font-size: 2rem; font-weight: 950; letter-spacing: -.05em; }
  .home-hero-talk__event-copy { display: grid; gap: .24rem; padding: 1rem 1.1rem 1.15rem; }
  .home-hero-talk__event-copy small { color: var(--ke-color-home-feature-eyebrow); font-weight: 850; text-transform: uppercase; letter-spacing: .06em; }
  .home-hero-talk__event-copy strong { font-size: clamp(1.25rem, 2.2vw, 1.8rem); line-height: 1.05; }
  .home-hero-talk__event-copy > span { color: var(--ke-color-home-feature-muted); font-size: .9rem; font-weight: 720; }
  @media (max-width: 820px) {
    .home-hero-talk { grid-template-columns: minmax(0, 1fr); }
    .home-hero-talk__event { grid-template-rows: minmax(18rem, 68vw) auto; }
    .home-hero-talk__media { min-height: 18rem; }
  }
</style>
