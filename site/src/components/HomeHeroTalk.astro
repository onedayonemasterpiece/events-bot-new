---
import type { HomeHeroTalkScene } from '../lib/homeHeroTalk';
import { eventHref } from '../lib/events';
import { eventImageUrl } from '../lib/assets';

interface Props { scenes: HomeHeroTalkScene[]; }
const { scenes } = Astro.props;
const visibleScenes = scenes.slice(0, 4);
const tileIndexes = Array.from({ length: 112 }, (_, index) => index);
const words = (value: string) => value.split(/\s+/u).filter(Boolean);
---

{visibleScenes.length > 0 && (
  <section
    class="home-hero-talk"
    data-home-hero-talk
    data-scene-count={visibleScenes.length}
    aria-labelledby="home-hero-talk-title"
  >
    <h1 id="home-hero-talk-title" class="home-hero-talk__sr-only">Выбор событий KenigEvents</h1>
    <div class="home-hero-talk__stage">
      {visibleScenes.map((scene, sceneIndex) => {
        const asset = scene.asset;
        const image = asset ? eventImageUrl(asset.src) : null;
        const focusX = Number(asset?.focal_point?.x ?? .5);
        const focusY = Number(asset?.focal_point?.y ?? .5);
        return (
          <a
            class={`home-hero-talk__scene home-hero-talk__scene--${scene.mode}`}
            data-home-hero-scene
            data-scene-index={sceneIndex}
            data-mode={scene.mode}
            data-source-width={asset?.width || undefined}
            data-source-height={asset?.height || undefined}
            data-focus-x={focusX}
            data-focus-y={focusY}
            style={`--hero-focus-x:${focusX * 100}%;--hero-focus-y:${focusY * 100}%`}
            href={eventHref(scene.event)}
            aria-label={`${scene.eyebrow}: ${scene.phrase}. ${scene.detail}. Открыть событие`}
            tabindex={sceneIndex === 0 ? '0' : '-1'}
          >
            <span class="home-hero-talk__phrase">
              <small>{scene.eyebrow}</small>
              <strong>
                {words(scene.phrase).map((word, wordIndex) => (
                  <span class="home-hero-talk__word" style={`--word-delay:${90 + wordIndex * 78}ms`}>{word}&nbsp;</span>
                ))}
                <i aria-hidden="true"></i>
              </strong>
              <span>{scene.detail}</span>
            </span>
            {image && asset && (
              <span class="home-hero-talk__mosaic" data-home-hero-mosaic>
                <img
                  data-home-hero-image
                  src={image}
                  width={asset.width}
                  height={asset.height}
                  alt=""
                  loading={sceneIndex === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span class="home-hero-talk__tiles">
                  {tileIndexes.map((tileIndex) => {
                    const col = tileIndex % 16;
                    const row = Math.floor(tileIndex / 16);
                    const delay = (tileIndex * 47 + scene.event.id * 23) % 760;
                    const duration = 320 + ((tileIndex * 31 + scene.event.id) % 310);
                    return (
                      <span
                        class="home-hero-talk__tile"
                        data-home-hero-tile
                        data-col={col}
                        data-row={row}
                        style={`--tile-delay:${delay}ms;--tile-duration:${duration}ms`}
                      ></span>
                    );
                  })}
                </span>
              </span>
            )}
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .home-hero-talk {
    position:relative;
    min-height:clamp(450px,55vw,660px);
    overflow:hidden;
    border:1px solid rgba(121,48,20,.13);
    border-radius:clamp(24px,4vw,42px);
    background:
      radial-gradient(circle at 80% 12%,rgba(220,151,97,.28),transparent 34%),
      linear-gradient(135deg,#fffaf2 0%,#f1dfc9 100%);
    box-shadow:0 24px 65px rgba(72,45,25,.11);
    color:#241913;
    isolation:isolate;
  }
  .home-hero-talk::after {
    content:"";
    position:absolute;
    z-index:-1;
    inset:auto -8% -40% 42%;
    aspect-ratio:1;
    border-radius:50%;
    background:rgba(121,48,20,.08);
    filter:blur(38px);
  }
  .home-hero-talk__sr-only {
    position:absolute!important;
    width:1px!important;
    height:1px!important;
    padding:0!important;
    margin:-1px!important;
    overflow:hidden!important;
    clip:rect(0,0,0,0)!important;
    white-space:nowrap!important;
    border:0!important;
  }
  .home-hero-talk__stage { position:absolute; inset:0; }
  .home-hero-talk__scene {
    box-sizing:border-box;
    position:relative;
    width:100%;
    min-height:100%;
    padding:clamp(30px,6vw,76px);
    display:grid;
    grid-template-columns:minmax(0,.92fr) minmax(340px,1.08fr);
    align-items:center;
    gap:clamp(18px,4vw,54px);
    color:inherit;
    text-decoration:none;
  }
  .home-hero-talk__scene:not(:first-child) { display:none; }
  .home-hero-talk__stage.is-enhanced .home-hero-talk__scene {
    position:absolute;
    inset:0;
    display:grid;
    opacity:0;
    visibility:hidden;
    pointer-events:none;
    transition:opacity 620ms cubic-bezier(.22,1,.36,1),visibility 0s linear 620ms;
  }
  .home-hero-talk__stage.is-enhanced .home-hero-talk__scene.is-active {
    opacity:1;
    visibility:visible;
    pointer-events:auto;
    transition-delay:0s;
  }
  .home-hero-talk__scene--text-only { grid-template-columns:minmax(0,1fr); }
  .home-hero-talk__phrase { position:relative; z-index:2; display:grid; align-content:center; min-width:0; }
  .home-hero-talk__phrase small {
    margin-bottom:clamp(10px,1.8vw,22px);
    color:#a54821;
    font:900 clamp(.72rem,1.2vw,.9rem)/1 var(--ke-font-sans,system-ui);
    letter-spacing:.12em;
    text-transform:uppercase;
  }
  .home-hero-talk__phrase strong {
    max-width:13ch;
    font:950 clamp(3.35rem,7.2vw,7.5rem)/.86 var(--ke-font-sans,system-ui);
    letter-spacing:-.075em;
    text-wrap:balance;
  }
  .home-hero-talk__scene--photo-mosaic .home-hero-talk__phrase strong {
    max-width:10ch;
    font-size:clamp(3.15rem,5.65vw,6.15rem);
    text-shadow:0 2px 0 rgba(255,250,242,.82),0 0 24px rgba(255,250,242,.72);
  }
  .home-hero-talk__scene--text-only .home-hero-talk__phrase strong { max-width:15ch; }
  .home-hero-talk__word { display:inline; opacity:1; transform:none; }
  .home-hero-talk__phrase strong i {
    display:inline-block;
    width:.055em;
    height:.82em;
    margin-left:.05em;
    border-radius:99px;
    background:#a54821;
    vertical-align:-.02em;
  }
  .home-hero-talk__phrase > span:last-child {
    margin-top:clamp(18px,2.5vw,30px);
    color:#6d6259;
    font:760 clamp(.9rem,1.5vw,1.08rem)/1.35 var(--ke-font-sans,system-ui);
  }
  .home-hero-talk__mosaic {
    position:relative;
    width:100%;
    aspect-ratio:16/7;
    align-self:center;
    overflow:hidden;
    border-radius:22px;
    box-shadow:0 22px 55px rgba(48,31,21,.22);
  }
  .home-hero-talk__mosaic > img {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:var(--hero-focus-x,50%) var(--hero-focus-y,50%);
    filter:saturate(.92) contrast(1.03);
  }
  .home-hero-talk__tiles {
    position:absolute;
    inset:0;
    display:grid;
    grid-template-columns:repeat(16,1fr);
    grid-template-rows:repeat(7,1fr);
    gap:2px;
  }
  .home-hero-talk__tile { position:relative; overflow:hidden; opacity:0; }
  .home-hero-talk__tile::before {
    content:"";
    position:absolute;
    left:var(--tile-image-left);
    top:var(--tile-image-top);
    width:var(--mosaic-render-width);
    height:var(--mosaic-render-height);
    background-image:var(--hero-image);
    background-repeat:no-repeat;
    background-size:100% 100%;
    filter:saturate(.92) contrast(1.03);
  }
  .home-hero-talk__mosaic[data-mosaic-ready] > img { opacity:0; }
  .home-hero-talk__scene.is-active .home-hero-talk__tile {
    animation:home-hero-tile-in var(--tile-duration) cubic-bezier(.65,0,.35,1) var(--tile-delay) both;
  }
  .home-hero-talk__stage.is-enhanced .home-hero-talk__scene.is-active .home-hero-talk__word {
    display:inline-block;
    opacity:0;
    transform:translate3d(0,.18em,0);
    animation:home-hero-word-in 460ms cubic-bezier(.16,1,.3,1) var(--word-delay) forwards;
  }
  .home-hero-talk__stage.is-enhanced .home-hero-talk__scene.is-active .home-hero-talk__phrase strong i {
    animation:home-hero-cursor 720ms steps(1,end) infinite;
  }
  .home-hero-talk__scene:focus-visible { outline:4px solid #0f766e; outline-offset:-7px; border-radius:inherit; }
  @keyframes home-hero-word-in { to { opacity:1; transform:none; } }
  @keyframes home-hero-tile-in { from { opacity:0; transform:scale(.92); } to { opacity:1; transform:none; } }
  @keyframes home-hero-cursor { 0%,48% { opacity:1; } 49%,100% { opacity:0; } }
  @media(max-width:820px) {
    .home-hero-talk { min-height:470px; }
    .home-hero-talk__scene {
      padding:28px 18px 24px;
      grid-template-columns:minmax(0,1fr);
      grid-template-rows:1fr auto;
      align-content:center;
      gap:18px;
    }
    .home-hero-talk__phrase strong {
      max-width:100%;
      font-size:clamp(2.4rem,11.8vw,4.8rem);
      line-height:.9;
      letter-spacing:-.065em;
    }
    .home-hero-talk__phrase > span:last-child {
      max-width:100%;
      overflow-wrap:anywhere;
    }
    .home-hero-talk__mosaic { border-radius:16px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .home-hero-talk__scene:not(:first-child) { display:none!important; }
    .home-hero-talk__scene:first-child { position:relative!important; opacity:1!important; visibility:visible!important; }
    .home-hero-talk__word,.home-hero-talk__tile,.home-hero-talk__phrase strong i { animation:none!important; opacity:1!important; transform:none!important; }
    .home-hero-talk__mosaic > img { opacity:1!important; }
    .home-hero-talk__tiles { display:none!important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-hero-talk]').forEach((root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const stage = root.querySelector<HTMLElement>('.home-hero-talk__stage');
    const scenes = [...root.querySelectorAll<HTMLAnchorElement>('[data-home-hero-scene]')];
    if (!stage || !scenes.length) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer = 0;
    let visible = true;

    const configureMosaic = (scene: HTMLAnchorElement) => {
      const mosaic = scene.querySelector<HTMLElement>('[data-home-hero-mosaic]');
      const image = scene.querySelector<HTMLImageElement>('[data-home-hero-image]');
      const tiles = [...scene.querySelectorAll<HTMLElement>('[data-home-hero-tile]')];
      if (!mosaic || !image?.naturalWidth || !tiles.length) return;
      const rect = mosaic.getBoundingClientRect();
      const sourceWidth = Number(scene.dataset.sourceWidth);
      const sourceHeight = Number(scene.dataset.sourceHeight);
      const focusX = Number(scene.dataset.focusX || .5);
      const focusY = Number(scene.dataset.focusY || .5);
      const scale = Math.max(rect.width / sourceWidth, rect.height / sourceHeight);
      const renderWidth = sourceWidth * scale;
      const renderHeight = sourceHeight * scale;
      const offsetX = (rect.width - renderWidth) * focusX;
      const offsetY = (rect.height - renderHeight) * focusY;
      mosaic.style.setProperty('--hero-image', `url("${image.currentSrc || image.src}")`);
      mosaic.style.setProperty('--hero-focus-x', `${focusX * 100}%`);
      mosaic.style.setProperty('--hero-focus-y', `${focusY * 100}%`);
      mosaic.style.setProperty('--mosaic-render-width', `${renderWidth}px`);
      mosaic.style.setProperty('--mosaic-render-height', `${renderHeight}px`);
      tiles.forEach((tile) => {
        const tileRect = tile.getBoundingClientRect();
        tile.style.setProperty('--tile-image-left', `${offsetX - (tileRect.left - rect.left)}px`);
        tile.style.setProperty('--tile-image-top', `${offsetY - (tileRect.top - rect.top)}px`);
      });
      mosaic.toggleAttribute('data-mosaic-ready', !reduced);
    };
    scenes.forEach((scene) => {
      const image = scene.querySelector<HTMLImageElement>('[data-home-hero-image]');
      if (image?.complete && image.naturalWidth) configureMosaic(scene);
      else image?.addEventListener('load', () => configureMosaic(scene), { once:true });
    });

    const activate = (index: number) => {
      active = index % scenes.length;
      scenes.forEach((scene, sceneIndex) => {
        const selected = sceneIndex === active;
        scene.classList.toggle('is-active', selected);
        scene.tabIndex = selected ? 0 : -1;
      });
      configureMosaic(scenes[active]);
    };
    const stop = () => { window.clearTimeout(timer); timer = 0; };
    const schedule = () => {
      stop();
      if (reduced || !visible || document.hidden || scenes.length < 2) return;
      timer = window.setTimeout(() => {
        activate(active + 1);
        schedule();
      }, 6_800);
    };
    stage.classList.add('is-enhanced');
    activate(0);
    if (!reduced) {
      const observer = new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= .15);
        if (visible) schedule(); else stop();
      }, { threshold:[0,.15,.5] });
      observer.observe(root);
      document.addEventListener('visibilitychange', schedule);
      window.addEventListener('resize', () => scenes.forEach(configureMosaic), { passive:true });
      schedule();
    }
  });
</script>
