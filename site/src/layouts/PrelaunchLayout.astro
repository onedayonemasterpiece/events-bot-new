---
import { IS_PRODUCTION, IS_SECRET_CANDIDATE, SITE_NAME, SITE_ORIGIN, withBase } from '../lib/events';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_NAME} — запуск 1 сентября`,
  description = 'Персонализированный сервис анонсов и навигатор по культурным и просветительским событиям Калининградской области. Запуск 1 сентября 2026 года.',
} = Astro.props;
const canonicalUrl = `${SITE_ORIGIN}${withBase('/')}`;
const robots = IS_PRODUCTION ? 'index,follow' : 'noindex,nofollow,noarchive,nosnippet';
const shareImage = `${SITE_ORIGIN}${withBase('/assets/pwa/announcements-brand-v2-512.png')}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: SITE_NAME,
      description,
      inLanguage: 'ru',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#prelaunch`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'ru',
      isPartOf: { '@id': `${canonicalUrl}#website` },
      about: { '@id': `${canonicalUrl}#service` },
    },
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: SITE_NAME,
      description,
      areaServed: [
        { '@type': 'City', name: 'Калининград' },
        { '@type': 'AdministrativeArea', name: 'Калининградская область' },
      ],
      serviceType: 'Персонализированный сервис анонсов культурных и просветительских событий',
    },
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    {IS_SECRET_CANDIDATE && <meta name="referrer" content="no-referrer" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Логотип «Полюбить Калининград Анонсы»" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href={withBase('/assets/pwa/announcements-brand-v2-192.png')} type="image/png" />
    <meta name="theme-color" content="#080a0e" />
    <meta name="color-scheme" content="dark" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        --prelaunch-bg: #080a0e;
        --prelaunch-text: #f5efe6;
        --prelaunch-muted: #bbb5aa;
        --prelaunch-copper-soft: #f0c89e;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; min-height: 100%; background: var(--prelaunch-bg); }
      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        overflow: hidden;
        background: var(--prelaunch-bg);
        color: var(--prelaunch-text);
      }
      button, input { font: inherit; }
      button { -webkit-tap-highlight-color: transparent; }
      a { color: inherit; }
      img { display: block; max-width: 100%; }
      ::selection { color: #15100b; background: var(--prelaunch-copper-soft); }
      :focus-visible { outline: 2px solid var(--prelaunch-copper-soft); outline-offset: 4px; }
      .prelaunch-skip {
        position: fixed;
        left: 1rem;
        top: 1rem;
        z-index: 100;
        padding: .7rem 1rem;
        border-radius: 999px;
        background: #f6efe5;
        color: #17110d;
        transform: translateY(-180%);
        transition: transform .2s ease;
      }
      .prelaunch-skip:focus { transform: translateY(0); }
    </style>
  </head>
  <body>
    <a class="prelaunch-skip" href="#main">К содержанию</a>
    <slot />
  </body>
</html>
