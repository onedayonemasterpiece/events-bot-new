---
import '../styles/prelaunch-calibration.css';
import { IS_PRODUCTION, IS_SECRET_CANDIDATE, SITE_NAME, SITE_ORIGIN, withBase } from '../lib/events';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE_NAME} — запуск 20 сентября`,
  description = 'Персонализированный сервис анонсов и навигатор по культурным и просветительским событиям Калининградской области. Запуск 20 сентября 2026 года.',
} = Astro.props;
const canonicalUrl = `${SITE_ORIGIN}${withBase('/')}`;
const robots = IS_PRODUCTION
  ? 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
  : 'noindex,nofollow,noarchive,nosnippet';
const shareImage = `${SITE_ORIGIN}${withBase('/assets/pwa/announcements-brand-v2-512.png')}`;
const logoImage = `${SITE_ORIGIN}${withBase('/assets/pwa/announcements-brand-v2-512.png')}`;
const organizationId = `${SITE_ORIGIN}/#organization`;
const websiteId = `${canonicalUrl}#website`;
const pageId = `${canonicalUrl}#prelaunch`;
const serviceId = `${canonicalUrl}#service`;
const imageId = `${canonicalUrl}#primaryimage`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Полюбить Калининград',
      alternateName: ['Полюбить Калининград Анонсы', 'Калининград Анонсы'],
      url: SITE_ORIGIN,
      logo: { '@id': imageId },
    },
    {
      '@type': 'ImageObject',
      '@id': imageId,
      url: logoImage,
      contentUrl: logoImage,
      width: 512,
      height: 512,
      caption: 'Полюбить Калининград Анонсы',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: canonicalUrl,
      name: SITE_NAME,
      alternateName: 'Калининград Анонсы',
      description,
      inLanguage: 'ru-RU',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'ru-RU',
      isPartOf: { '@id': websiteId },
      about: { '@id': serviceId },
      primaryImageOfPage: { '@id': imageId },
      dateModified: '2026-08-23',
    },
    {
      '@type': 'Service',
      '@id': serviceId,
      name: SITE_NAME,
      description,
      provider: { '@id': organizationId },
      areaServed: [
        { '@type': 'City', name: 'Калининград' },
        { '@type': 'AdministrativeArea', name: 'Калининградская область' },
      ],
      serviceType: 'Персонализированный сервис анонсов культурных и просветительских событий',
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceUrl: canonicalUrl,
      },
    },
  ],
};
---
<!doctype html>
<html lang="ru-RU">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    {IS_SECRET_CANDIDATE && <meta name="referrer" content="no-referrer" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE_NAME} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ru-RU" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link
      rel="preload"
      as="image"
      href={withBase('/assets/prelaunch/prelaunch-scene-desktop.webp')}
      type="image/webp"
      media="(min-width: 900px) and (min-aspect-ratio: 5/4)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={withBase('/assets/prelaunch/prelaunch-scene-mobile.webp')}
      type="image/webp"
      media="(max-width: 899px), (max-aspect-ratio: 5/4)"
      fetchpriority="high"
    />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Логотип «Полюбить Калининград Анонсы»" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href={withBase('/assets/pwa/announcements-brand-v2-192.png')} type="image/png" />
    <meta name="theme-color" content="#080a0e" />
    <meta name="color-scheme" content="dark" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <style is:global>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        --prelaunch-bg: #080a0e;
        --prelaunch-text: #f5efe6;
        --prelaunch-muted: #bbb5aa;
        --prelaunch-copper-soft: #f0c89e;
      }

      * { box-sizing: border-box; }
      html {
        min-width: 320px;
        min-height: 100%;
        background: var(--prelaunch-bg);
        overscroll-behavior: none;
        touch-action: manipulation;
      }
      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        overflow: hidden;
        overscroll-behavior: none;
        touch-action: manipulation;
        background: var(--prelaunch-bg);
        color: var(--prelaunch-text);
      }
      button, input { font: inherit; }
      button { -webkit-tap-highlight-color: transparent; }
      a { color: inherit; }
      img { display: block; max-width: 100%; }
      ::selection { color: #15100b; background: var(--prelaunch-copper-soft); }
      :focus-visible { outline: 2px solid var(--prelaunch-copper-soft); outline-offset: 4px; }
      .prelaunch-skip {
        position: fixed;
        left: 1rem;
        top: 1rem;
        z-index: 100;
        padding: .7rem 1rem;
        border-radius: 999px;
        background: #f6efe5;
        color: #17110d;
        transform: translateY(-180%);
        transition: transform .2s ease;
      }
      .prelaunch-skip:focus { transform: translateY(0); }
    </style>
  </head>
  <body>
    <a class="prelaunch-skip" href="#main">К содержанию</a>
    <slot />
  </body>
</html>
