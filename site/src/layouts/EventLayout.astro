---
import EventCard from '../components/EventCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnnouncementsLockup from '../components/brand/AnnouncementsLockup.astro';
import MobileBottomNav, { type MobileSection } from '../components/MobileBottomNav.astro';
import MobileToastRegion from '../components/MobileToastRegion.astro';
import Reference4MobileMenu from '../components/Reference4MobileMenu.astro';
import StaticSiteAuthRuntime from '../components/auth/StaticSiteAuthRuntime.astro';
import '../styles/design-system.css';
import { BASE_PATH, getCurrentDate, IS_PRODUCTION, IS_SECRET_CANDIDATE, siteHomeHref, SITE_NAME, SITE_ORIGIN, withBase } from '../lib/events';
import { INTEREST_CLUBS_PUBLIC_ENABLED } from '../lib/clubs';
import type { PreviewEvent } from '../lib/types';

export type HeaderCurrent = 'today' | 'tomorrow' | 'weekend' | 'exhibitions' | 'festivals' | 'popular' | 'clubs';
export type MobileTopMode = 'standard' | 'contextual' | 'immersive';
export type MobileBottomMode = 'nav' | 'cta' | 'none';

interface HeaderBadge {
  key: HeaderCurrent;
  text: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string | null;
  ogImageAlt?: string | null;
  ogImageType?: string | null;
  ogImageWidth?: number | null;
  ogImageHeight?: number | null;
  ogType?: 'article' | 'website';
  structuredData?: unknown[];
  heroChrome?: 'standard' | 'immersive';
  headerCurrent?: HeaderCurrent;
  mobileTopMode?: MobileTopMode;
  mobileSection?: MobileSection;
  mobileBottomMode?: MobileBottomMode;
  noindex?: boolean;
  disableViewportZoom?: boolean;
  headerBadge?: HeaderBadge;
}

const { title, description, canonicalUrl, ogImage, ogImageAlt, ogImageType, ogImageWidth, ogImageHeight, ogType = 'article', structuredData = [], heroChrome = 'standard', headerCurrent, mobileTopMode, mobileSection: explicitMobileSection, mobileBottomMode, noindex = false, disableViewportZoom = false, headerBadge } = Astro.props;
const robots = IS_SECRET_CANDIDATE
  ? 'noindex,nofollow,noarchive,nosnippet'
  : (noindex ? 'noindex,nofollow,noarchive' : (IS_PRODUCTION ? 'index,follow' : 'noindex,nofollow,noarchive'));
const safeDescription = description || 'Анонс события в Калининградской области.';
const routePath = Astro.url.pathname.replace(/\/+$/u, '') || '/';
const derivedMobileSection: MobileSection = heroChrome === 'immersive'
  ? null
  : /\/(?:poisk|podborki)(?:\/|$)/u.test(`${routePath}/`)
    ? 'search'
    : /\/(?:segodnya|zavtra)(?:\/|$)/u.test(`${routePath}/`) || headerCurrent === 'today' || headerCurrent === 'tomorrow'
      ? 'dates'
      : /\/dlya-menya(?:\/|$)/u.test(`${routePath}/`)
        ? 'personal'
        : 'afisha';
const mobileSection = explicitMobileSection === undefined ? derivedMobileSection : explicitMobileSection;
const resolvedMobileTopMode: MobileTopMode = mobileTopMode || (heroChrome === 'immersive' ? 'immersive' : mobileSection === 'dates' ? 'contextual' : 'standard');
const resolvedMobileBottomMode: MobileBottomMode = mobileBottomMode || (resolvedMobileTopMode === 'immersive' ? 'cta' : mobileSection === null ? 'none' : 'nav');
const bodyClass = ['mobile-shell-reference4', resolvedMobileTopMode === 'immersive' ? 'hero-chrome-immersive' : null].filter(Boolean).join(' ');
const personalizationSupabaseUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
const personalizationSupabaseKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
const personalFeedRpcName = import.meta.env.PUBLIC_PERSONAL_FEED_RPC_NAME || 'get_listing_personal_feed_v1';
const mobileDiscoveryBases = {
  calendarBase: import.meta.env.PUBLIC_MOBILE_CALENDAR_BASE_URL,
  searchBase: import.meta.env.PUBLIC_MOBILE_SEARCH_BASE_URL,
};
// Inert source data for the canonical runtime-card templates below. Dynamic
// manifests only populate clones of EventCard's DOM; they never build a second
// handwritten card tree in the browser.
const runtimeTemplateEvent: PreviewEvent = {
  id: 0,
  title: 'Шаблон события',
  slug: '__runtime-event-card-template__',
  event_type: 'событие',
  festival: null,
  status_label: 'Условия уточняются',
  lifecycle_status: 'active',
  starts_at: '2099-01-01T12:00:00+02:00',
  start_date: '2099-01-01',
  start_time: '12:00',
  end_date: '2099-01-01',
  end_at: '2099-01-01T14:00:00+02:00',
  time_range_end: null,
  timezone: 'Europe/Kaliningrad',
  display_date: '1 января 2099',
  display_time: '12:00',
  city: 'Калининград',
  venue_name: 'Площадка',
  address: null,
  map_query: null,
  ticket: { kind: 'status', label: 'Условия уточняются', href: null, status: null, is_free: false, price_label: null },
  age_restriction: null,
  age_restriction_status: 'unknown',
  age_restriction_provenance: null,
  age_restriction_decision_version: null,
  age_recommendation: null,
  age_recommendation_label: null,
  source_url: null,
  telegraph_url: null,
  image_url: withBase('/favicon.svg'),
  image_alt: 'Шаблон изображения события',
  image_text_mode: 'visual_only',
  image_media_role: 'event_photo',
  image_assets: [{ src: withBase('/favicon.svg'), width: 512, height: 512, alt: 'Шаблон изображения события', image_text_mode: 'visual_only', media_role: 'event_photo' }],
  summary: '',
  meta_description: '',
  description_html: '',
  topics: [],
  likes_count: 0,
  source_likes_count: 0,
  service_likes_count: 0,
  shares_count: 0,
  pushkin_card: false,
  other_date_ids: [],
  source_prod_id: 0,
  data_quality_notes: [],
  updated_at: null,
};

const FOOTER_SOCIAL_LINKS = [
  { network: 'Telegram', label: 'Анонсы', href: 'https://t.me/kenigevents', icon: 'telegram' },
  { network: 'Telegram', label: 'Афиша', href: 'https://t.me/kldevents', icon: 'telegram' },
  { network: 'ВК', label: 'Анонсы', href: 'https://vk.com/kenigeventsofficial', icon: 'vk' },
  { network: 'ВК', label: 'Афиша', href: 'https://vk.com/klgdevents', icon: 'vk' },
  { network: 'VK', label: 'канал Афиши', href: 'https://vk.ru/im/channels/-239844596', icon: 'vk' },
  { network: 'Max', label: 'Анонсы', href: 'https://max.ru/channel_kenigevents', icon: 'max' },
] as const;
const HEADER_NAVIGATION = [
  { key: 'today', label: 'Сегодня', href: '/segodnya/' },
  { key: 'tomorrow', label: 'Завтра', href: '/zavtra/' },
  { key: 'weekend', label: 'Выходные', href: '/vyhodnye/' },
  { key: 'exhibitions', label: 'Выставки', href: '/vystavki/' },
  { key: 'festivals', label: 'Фестивали', href: '/festivali/' },
  { key: 'popular', label: 'Популярное', href: '/populyarnoe/' },
  { key: 'clubs', label: 'Клубы', href: '/kluby-po-interesam/' },
] as const;
const visibleHeaderNavigation = HEADER_NAVIGATION.filter((item) => item.key !== 'clubs' || INTEREST_CLUBS_PUBLIC_ENABLED);
const drawerCurrent = headerCurrent || (mobileSection === 'search' ? 'search' : mobileSection === 'personal' ? 'personal' : mobileSection === 'afisha' ? 'all' : null);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={disableViewportZoom ? 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' : 'width=device-width, initial-scale=1'} />
    <meta name="robots" content={robots} />
    {IS_SECRET_CANDIDATE && <meta name="referrer" content="no-referrer" />}
    <title>{title}</title>
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#f7efe3" />
    <meta name="format-detection" content="telephone=yes" />
    {structuredData.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <style is:global>
      :root {
        --bg: #fbf7ef;
        --bg-soft: #f2e7d7;
        --surface: #fffdf8;
        --surface-strong: #ffffff;
        --text: #221a14;
        --muted: #6d6259;
        --line: #e1d3c2;
        --primary: #a54821;
        --primary-strong: #793014;
        --primary-text: #ffffff;
        --accent: #0f766e;
        --accent-soft: #d7f0ec;
        --warning: #a16207;
        --shadow: 0 18px 45px rgba(72, 45, 25, 0.12);
        --radius-xl: 28px;
        --radius-lg: 20px;
        --radius-md: 14px;
        --mobile-header-h: 64px;
        --mobile-top-chrome-bottom: calc(env(safe-area-inset-top) + var(--mobile-header-h));
        --mobile-header-handle-overhang: 24px;
        --mobile-nav-h: 64px;
        --mobile-bottom-stack-h: calc(var(--mobile-nav-h) + env(safe-area-inset-bottom));
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { min-width: 320px; scroll-behavior: smooth; }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(165, 72, 33, 0.12), transparent 32rem),
          linear-gradient(180deg, #fff8ed 0%, var(--bg) 42%, #f7efe3 100%);
        color: var(--text);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.1;
        background-image: linear-gradient(rgba(121, 48, 20, 0.035) 1px, transparent 1px);
        background-size: 28px 28px;
      }
      a { color: inherit; text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 3px solid rgba(15, 118, 110, 0.65); outline-offset: 3px; }
      img { display: block; max-width: 100%; height: auto; }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: 1rem;
        z-index: 80;
        transform: translateY(-180%);
        background: var(--text);
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 999px;
      }
      .skip-link:focus { transform: translateY(0); }
      .site-header {
        position: sticky;
        top: 0;
        height: var(--ke-site-header-bar-height);
        min-height: var(--ke-site-header-bar-height);
        z-index: 60;
        border-bottom: 1px solid rgba(121, 48, 20, 0.12);
        background: var(--ke-color-header);
        box-shadow: 0 6px 22px rgba(69,45,28,0.035);
      }
      .site-header__inner {
        position: relative;
        width: min(var(--ke-content-wide-max), calc(100% - clamp(3rem, 5vw, 6rem)));
        margin: 0 auto;
        height: 56px;
        min-height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: clamp(2rem, 4vw, 4rem);
      }
      .site-header__brand-tag {
        align-self: flex-start;
        flex: 0 0 240px;
        width: 240px;
        height: 88px;
        display: block;
        padding: 18px 24px 16px;
        border-radius: 0 0 12px 12px;
        background-color: #98401f;
        color: #fffaf2;
        text-decoration: none;
        transition: background-color 160ms ease;
      }
      .site-header__brand-tag:hover { background-color: #893719; }
      .site-header__desktop-lockup { display: grid; grid-template-rows: 12px auto; align-content: start; gap: 4px; }
      .site-header__desktop-lockup .announcements-lockup__endorsement { overflow: visible; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; line-height: 12px; text-transform: uppercase; white-space: nowrap; }
      .site-header__desktop-lockup .announcements-lockup__wordmark { display: block; width: 192px; height: auto; color: #fff; overflow: visible; }
      .mobile-discovery-menu { display: none; }
      .mobile-discovery-menu__summary { list-style: none; cursor: pointer; }
      .mobile-discovery-menu__summary::-webkit-details-marker { display: none; }
      .mobile-discovery-menu__panel { display: block; }
      .mobile-discovery-menu__nav { display: block; }
      .mobile-discovery-menu__links { display: flex; flex-wrap: wrap; gap: 0.55rem 1rem; overflow-x: visible; overscroll-behavior-inline: auto; scrollbar-width: auto; }
      .mobile-discovery-menu__links a {
        min-height: 44px;
        flex: 0 1 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.28rem 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--primary-strong);
        text-decoration: none;
        font-weight: 850;
        white-space: nowrap;
      }
      .mobile-discovery-menu__links a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 0.28em; }
      .site-nav { min-width: 0; display: flex; gap: 4px; flex-wrap: nowrap; justify-content: flex-end; margin-left: auto; }
      .site-nav a {
        position: relative;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.18rem 1rem;
        border: 0;
        border-radius: 8px;
        color: var(--muted);
        font-size: clamp(0.89rem, 1vw, 0.98rem);
        font-weight: 600;
        line-height: 1.1;
        text-decoration: none;
        white-space: nowrap;
      }
      .site-nav a::after { content: ""; position: absolute; left: 0.72rem; right: 0.72rem; bottom: 2px; height: 2px; border-radius: 999px; background: var(--primary); opacity: 0; transform: scaleX(0.55); transition: opacity 160ms ease, transform 160ms ease; }
      .site-nav a:hover { color: var(--text); background: #f5eadc; }
      .site-nav a[aria-current="page"] { color: var(--primary-strong); font-weight: 760; }
      .site-nav a[aria-current="page"]::after { opacity: 1; transform: scaleX(1); }
      .site-header__badge {
        min-width: 1.25rem;
        min-height: 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 0.38rem;
        padding: 0.08rem 0.38rem;
        border-radius: 999px;
        background: #d93b48;
        color: #fff;
        box-shadow: 0 0 0 1px rgba(255,255,255,0.72), 0 5px 16px rgba(217,59,72,0.3);
        font-size: 0.66rem;
        font-weight: 900;
        line-height: 1;
        white-space: nowrap;
      }
      .site-header__badge.is-soft { background: #746b65; box-shadow: 0 0 0 1px rgba(255,255,255,0.62), 0 5px 14px rgba(58,47,40,0.16); }
      .mobile-discovery-menu__summary > .site-header__badge {
        position: absolute;
        z-index: 3;
        top: max(0.42rem, env(safe-area-inset-top));
        right: 0.42rem;
        margin: 0;
        box-shadow: 0 0 0 2px #98401f, 0 5px 16px rgba(217,59,72,0.32);
      }
      .mobile-discovery-menu__links .site-header__badge { margin-left: 0.3rem; }
      .page-shell { position: relative; z-index: 1; width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
      main { padding: 1.2rem 0 5.5rem; }
      .crumbs { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin: 0.5rem 0 1rem; color: var(--muted); font-size: 0.92rem; }
      .crumbs a { min-height: 32px; display: inline-flex; align-items: center; color: var(--primary-strong); }
      .event-grid { display: grid; gap: 1rem; }
      .main-col, .side-col { min-width: 0; }
      .section-card {
        background: rgba(255, 253, 248, 0.92);
        border: 1px solid rgba(121, 48, 20, 0.13);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
      }
      .section-card--quiet { box-shadow: none; background: rgba(255, 253, 248, 0.74); }
      .section-card--event-details { overflow: hidden; }
      .section-card__inner { padding: clamp(0.85rem, 2.8vw, 1.55rem); }
      .authorized-search {
        margin-top: 1rem;
        padding: clamp(0.9rem, 2.8vw, 1.35rem);
        border: 1px solid rgba(121, 48, 20, 0.14);
        border-radius: var(--radius-xl);
        background: linear-gradient(180deg, rgba(255,253,248,0.96), rgba(255,248,239,0.92));
        box-shadow: var(--shadow);
      }
      .authorized-search__head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
      }
      .authorized-search--standalone { margin-top: clamp(0.8rem, 3vw, 1.4rem); }
      .authorized-search__copy { min-width: 0; }
      .authorized-search__head h1,
      .authorized-search__head h2 { margin-bottom: 0.35rem; }
      .authorized-search__auth { flex: 0 0 auto; display: flex; gap: 0.55rem; flex-wrap: wrap; justify-content: flex-end; align-items: flex-start; }
      .authorized-search__yandex-icon {
        width: 1.38rem;
        height: 1.38rem;
        display: inline-grid;
        place-items: center;
        border-radius: 999px;
        background: #fc3f1d;
        color: #fff;
        font-size: 0.88rem;
        font-weight: 950;
        line-height: 1;
      }
      .authorized-search__account-menu { position: relative; }
      .authorized-search__account-toggle {
        width: auto;
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        gap: 0.48rem;
        padding: 0.25rem 0.72rem 0.25rem 0.28rem;
        list-style: none;
        border: 1px solid rgba(121,48,20,0.16);
        border-radius: 999px;
        background: rgba(255,253,248,0.92);
        color: var(--primary-strong);
        box-shadow: 0 12px 26px rgba(72,45,25,0.10);
        cursor: pointer;
        touch-action: manipulation;
      }
      .authorized-search__account-toggle::-webkit-details-marker { display: none; }
      .authorized-search__account-toggle::marker { content: ""; }
      .authorized-search__account-toggle:hover { background: #fff7ea; border-color: rgba(165,72,33,0.30); }
      .authorized-search__avatar {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: grid;
        place-items: center;
        overflow: hidden;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(165,72,33,0.18), rgba(15,118,110,0.16));
        color: var(--primary-strong);
      }
      .authorized-search__avatar-initial {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
      }
      .authorized-search__avatar-initial {
        display: grid;
        place-items: center;
        font-weight: 950;
        font-size: 1rem;
        line-height: 1;
      }
      .authorized-search__account-label {
        max-width: 8rem;
        overflow: hidden;
        color: var(--primary-strong);
        font-size: 0.86rem;
        font-weight: 850;
        line-height: 1;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .authorized-search__account-popover {
        position: absolute;
        top: calc(100% + 0.55rem);
        right: 0;
        z-index: 42;
        width: min(78vw, 260px);
        display: grid;
        gap: 0.7rem;
        padding: 0.8rem;
        border: 1px solid rgba(121,48,20,0.15);
        border-radius: 20px;
        background: rgba(255,253,248,0.98);
        box-shadow: 0 20px 48px rgba(72,45,25,0.18);
        color: var(--text);
      }
      .authorized-search__account-menu:not([open]) .authorized-search__account-popover { display: none; }
      .authorized-search__account-info { display: grid; gap: 0.12rem; font-size: 0.86rem; color: var(--muted); }
      .authorized-search__account-info strong { color: var(--text); overflow-wrap: anywhere; }
      .authorized-search__logout {
        min-height: 42px;
        border: 1px solid rgba(121,48,20,0.14);
        border-radius: 999px;
        background: #fff7ea;
        color: var(--primary-strong);
        padding: 0.45rem 0.75rem;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
      }
      .authorized-search__logout:hover { background: #fff; color: var(--text); }
      .authorized-search__form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.6rem;
        margin-top: 1rem;
      }
      .authorized-search__form input,
      .authorized-search__form textarea {
        width: 100%;
        min-height: 48px;
        border: 1px solid rgba(121,48,20,0.18);
        border-radius: 999px;
        background: #fffdf8;
        color: var(--text);
        padding: 0.65rem 1rem;
        font: inherit;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
      }
      .authorized-search__form textarea { resize: vertical; }
      .authorized-search--standalone .authorized-search__form {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        margin-top: 0.25rem;
        padding: 0.85rem 0 1rem;
        border-top: 1px solid rgba(121,48,20,0.14);
        border-bottom: 1px solid rgba(121,48,20,0.14);
      }
      .authorized-search--standalone .authorized-search__query-label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 850;
        line-height: 1.2;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .authorized-search--standalone .authorized-search__form textarea {
        box-sizing: border-box;
        min-height: 82px;
        resize: none;
        border: 0;
        border-bottom: 2px solid var(--text);
        border-radius: 0;
        background: transparent;
        padding: 0.25rem 0 0.65rem;
        color: var(--text);
        font-family: inherit;
        font-size: 1.3125rem;
        font-weight: 650;
        line-height: 1.25;
        box-shadow: none;
        outline-offset: 4px;
      }
      .authorized-search--standalone .authorized-search__submit {
        width: 100%;
        min-height: 50px;
        margin-top: 0.75rem;
        border-radius: 8px;
