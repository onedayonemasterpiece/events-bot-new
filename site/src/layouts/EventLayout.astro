  </head>
  <body class={bodyClass} style={`--desktop-brand-tag-skin:url('${withBase('/assets/ui/desktop-head-leather-r5.webp')}')`} data-mobile-top-mode={resolvedMobileTopMode} data-mobile-section={mobileSection || 'none'} data-mobile-bottom-mode={resolvedMobileBottomMode} data-current-year={getCurrentDate().slice(0, 4)} data-site-base-path={BASE_PATH || '/'} data-site-origin={SITE_ORIGIN} data-personal-feed-supabase-url={personalizationSupabaseUrl || undefined} data-personal-feed-supabase-key={personalizationSupabaseKey || undefined} data-personal-feed-rpc-name={personalFeedRpcName}>
    <a href="#main" class="skip-link">Перейти к событию</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand-tag" href={siteHomeHref()} aria-label="Полюбить Калининград Анонсы — на главную">
          <AnnouncementsLockup variant="desktop" class="site-header__desktop-lockup" />
        </a>
        <Reference4MobileMenu current={drawerCurrent} discoveryBases={mobileDiscoveryBases} badge={headerBadge} />
        <nav class="site-nav" aria-label="Основная навигация">
          {visibleHeaderNavigation.map((item) => (
            <a href={withBase(item.href)} aria-current={item.key === headerCurrent ? 'page' : undefined}>
              {item.label}
              {headerBadge?.key === item.key && (
                <span class="site-header__badge" data-header-badge={item.key} aria-live="polite">
                  <span data-header-badge-count>{headerBadge.text}</span>
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <MobileToastRegion />
    <StaticSiteAuthRuntime />
    <slot />
    <!-- EventCard is the single DOM/interaction source for every client-added card. -->
    <template data-event-card-template="split-actions">
      <EventCard event={runtimeTemplateEvent} variant="split-actions" desktopRelatedCrop runtimeTemplate />
    </template>
    <template data-event-card-template="overlay-controls">
      <EventCard event={runtimeTemplateEvent} variant="overlay-controls" desktopRelatedCrop runtimeTemplate />
    </template>
    <SiteFooter socialLinks={FOOTER_SOCIAL_LINKS} />
    {resolvedMobileBottomMode === 'nav' && <MobileBottomNav current={mobileSection} />}

    <script>
      import { packRelatedCardRows, relatedCardMediaGeometry, relatedCardPrimaryImageAsset, resolveMobileEventCardMedia } from '../lib/relatedCardLayout.mjs';
      import { selectEventContinuation } from '../lib/eventContinuation.mjs';
      import { composeEventShareImage } from '../lib/eventShareImage.mjs';
      Object.assign(window, {
        KenigEventsPackRelatedCardRows: packRelatedCardRows,
        KenigEventsRelatedCardMediaGeometry: relatedCardMediaGeometry,
        KenigEventsResolveMobileEventCardMedia: resolveMobileEventCardMedia,
        KenigEventsRelatedCardPrimaryImageAsset: relatedCardPrimaryImageAsset,
        KenigEventsSelectEventContinuation: selectEventContinuation,
        KenigEventsComposeEventShareImage: composeEventShareImage,
      });
    </script>
    <script is:inline>
      (() => {
        const PROFILE_KEY = 'ke_personalization_profile';
        const LOG_KEY = 'ke_event_feedback_log_v1';
        const SHARE_PROMPT_KEY = 'ke_like_share_prompt_count_v1';
        const RESET_AT_KEY = 'ke_personalization_last_reset_at_v1';
        const PROFILE_VERSION = 'anon-profile-v1';
        const FEATURE_SCHEMA_VERSION = 'event-detail-related-v1';
        const TAXONOMY_VERSION = 'event-taxonomy-v1';
        const SURFACE_EVENT_DETAIL_RELATED = 'event_detail_related';
        const STATIC_ALGORITHM_ID = 'static_related_v1';
        const LOCAL_ALGORITHM_ID = 'local_related_rerank_v1';
        const LOCAL_FALLBACK_ALGORITHM_ID = 'local_related_rerank_v1_fallback';
        const MAX_LOG = 240;
        const MAX_SHARE_PROMPTS_PER_SESSION = 2;
        const DEFAULT_PRELOAD_TARGET = 10;
        const CURRENT_BASE_PATH = String(document.body?.dataset.siteBasePath || '/').replace(/\/+$/u, '') || '';
        const SITE_INTERNAL_ORIGIN = (() => {
          try { return new URL(document.body?.dataset.siteOrigin || location.origin).origin; }
          catch (_) { return location.origin; }
        })();
        const PERSONAL_FEED_CACHE_KEY = `ke_listing_personal_feed_cache_v1:${CURRENT_BASE_PATH || '/'}`;
        const PERSONAL_FEED_SURFACE = 'listing_personal_feed';
        const PERSONAL_FEED_SCHEMA_VERSION = 'listing-personal-feed-v1';
        const PERSONAL_FEED_LIMIT = 30;
        const PERSONAL_FEED_TTL_MS = 30 * 60 * 1000;
        const EVENT_CONTINUATION_RECENT_KEY = `ke_event_continuation_recent_v1:${CURRENT_BASE_PATH || '/'}`;
        const EVENT_CONTINUATION_RECENT_TTL_MS = 6 * 60 * 60 * 1000;
        const EVENT_CONTINUATION_RECENT_BLOCKS = 12;
        const LISTING_MODE_KEY = 'ke_listing_mode_v1';
        const CALENDAR_STATE_KEY = 'ke_calendar_saved_v1';
        const CALENDAR_STATE_VERSION = 1;
        const CALENDAR_STATE_LIMIT = 256;
        const CALENDAR_USAGE_KEY = 'ke_calendar_usage_v1';
        const CALENDAR_USAGE_VERSION = 1;
        const CALENDAR_USAGE_REGULAR_THRESHOLD = 3;
        const CALENDAR_USAGE_RECENT_MS = 30 * 24 * 60 * 60 * 1000;
        const NEGATIVE_HARD_FILTER_THRESHOLD = 0.95;
        const DEFAULT_WEIGHTS = {
          staticContext: 0.80,
          profileAffinity: 0.10,
          priceMatch: 0.04,
          timeMatch: 0.03,
          explicitLike: 0.60,
          exploration: 0.02,
          negativeInterest: 0.55,
          fatigue: 0.18,
          soldOut: 0.20,
        };
        const sessionPinnedNotInterested = new Set();
        const discoveryStores = new WeakMap();
        const servedListByFeed = new WeakMap();
        let shareCalloutTimer = 0;
        let pendingConsentAction = null;
        let personalFeedRequest = null;

        function readJson(key, fallback) {
          try {
            const raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : fallback;
          } catch (_) {
            return fallback;
          }
        }

        function writeJson(key, value) {
          try {
            localStorage.setItem(key, JSON.stringify(value));
            return true;
          } catch (_) {
            return false;
          }
        }

        // Dynamic manifests and localStorage outlive an individual preview build.
        // Treat their links as data, not trusted navigation: same-site event paths
        // always belong to the currently open preview, while genuine external
        // ticket URLs must remain untouched.
        function rebaseInternalEventUrl(value, options = {}) {
          const raw = typeof value === 'string' ? value.trim() : '';
          if (!raw || raw === '#') return raw || '#';
          let url;
          try {
            const hasScheme = /^[a-z][a-z0-9+.-]*:/iu.test(raw) || raw.startsWith('//');
            url = new URL(hasScheme || raw.startsWith('/') ? raw : `/${raw}`, location.origin);
          } catch (_) {
            return raw;
          }
          if (url.origin !== location.origin && url.origin !== SITE_INTERNAL_ORIGIN) return raw;
          const eventMarker = '/sobytiya/';
          const eventIndex = url.pathname.lastIndexOf(eventMarker);
          if (eventIndex < 0) return raw;
          const eventSuffix = url.pathname.slice(eventIndex);
          if (!/^\/sobytiya\/[^/]+\/(?:.*)?$/u.test(eventSuffix)) return raw;
          const rebased = `${CURRENT_BASE_PATH}${eventSuffix}${url.search}${url.hash}`;
          return options.absolute ? `${SITE_INTERNAL_ORIGIN}${rebased}` : rebased;
        }

        window.KenigEventsNormalizeInternalEventUrl = rebaseInternalEventUrl;

        function kaliningradEpochDay() {
          return Math.floor((Date.now() + 2 * 60 * 60 * 1000) / 86400000);
        }

        function calendarExpiryDayFromIso(value) {
          const match = /^(\d{4})-(\d{2})-(\d{2})$/u.exec(String(value || '').trim());
          if (!match) return 0;
          const day = Math.floor(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])) / 86400000);
          return Number.isFinite(day) ? day + 1 : 0;
        }

        function normalizeCalendarState(value) {
          const today = kaliningradEpochDay();
          const entries = value && value.v === CALENDAR_STATE_VERSION && value.e && typeof value.e === 'object' && !Array.isArray(value.e)
            ? Object.entries(value.e)
                .filter(([id, expiry]) => /^\d+$/u.test(id) && Number.isInteger(expiry) && expiry > today)
                .sort((a, b) => a[1] - b[1])
                .slice(0, CALENDAR_STATE_LIMIT)
            : [];
          return { v: CALENDAR_STATE_VERSION, e: Object.fromEntries(entries) };
        }

        function persistCalendarState(state) {
          const normalized = normalizeCalendarState(state);
          const hasEntries = Object.keys(normalized.e).length > 0;
          try {
            if (hasEntries) localStorage.setItem(CALENDAR_STATE_KEY, JSON.stringify(normalized));
            else localStorage.removeItem(CALENDAR_STATE_KEY);
          } catch (_) {}
          return normalized;
        }

        function readCalendarState() {
          const raw = readJson(CALENDAR_STATE_KEY, null);
          const normalized = normalizeCalendarState(raw);
          const serialized = Object.keys(normalized.e).length > 0 ? JSON.stringify(normalized) : '';
          try {
            const current = localStorage.getItem(CALENDAR_STATE_KEY) || '';
            if (serialized !== current) {
              if (serialized) localStorage.setItem(CALENDAR_STATE_KEY, serialized);
              else localStorage.removeItem(CALENDAR_STATE_KEY);
            }
          } catch (_) {}
          return normalized;
        }

        function markCalendarAdded(eventId, expiryDay) {
          const id = String(eventId || '').trim();
          const expiry = Number(expiryDay);
          if (!/^\d+$/u.test(id) || !Number.isInteger(expiry) || expiry <= kaliningradEpochDay()) return false;
          const state = readCalendarState();
          if (!state.e[id] && Object.keys(state.e).length >= CALENDAR_STATE_LIMIT) {
            const farthest = Object.entries(state.e).sort((a, b) => b[1] - a[1])[0];
            if (farthest) delete state.e[farthest[0]];
          }
          state.e[id] = expiry;
          persistCalendarState(state);
          return true;
        }

        function normalizeCalendarUsage(value) {
          const count = value && value.v === CALENDAR_USAGE_VERSION
            ? Math.max(0, Math.min(9999, Number(value.count || 0)))
            : 0;
          const lastUsedAt = value && value.v === CALENDAR_USAGE_VERSION
            ? Math.max(0, Number(value.last_used_at || 0))
            : 0;
          return {
            v: CALENDAR_USAGE_VERSION,
            count: Number.isFinite(count) ? Math.floor(count) : 0,
            last_used_at: Number.isFinite(lastUsedAt) ? lastUsedAt : 0,
          };
        }

        function readCalendarUsage() {
          return normalizeCalendarUsage(readJson(CALENDAR_USAGE_KEY, null));
        }

        function markCalendarUsed() {
          const usage = readCalendarUsage();
          writeJson(CALENDAR_USAGE_KEY, {
            v: CALENDAR_USAGE_VERSION,
            count: Math.min(9999, usage.count + 1),
            last_used_at: Date.now(),
          });
        }

        function calendarLabelMayCollapse(usage = readCalendarUsage()) {
          if (usage.count < CALENDAR_USAGE_REGULAR_THRESHOLD) return false;
          if (!usage.last_used_at) return false;
          return Date.now() - usage.last_used_at <= CALENDAR_USAGE_RECENT_MS;
        }

        function syncCalendarControls() {
          const state = readCalendarState();
          const collapseAdaptiveLabels = calendarLabelMayCollapse();
          document.querySelectorAll('a[data-calendar-action]').forEach((anchor) => {
            const label = anchor.querySelector('[data-calendar-label]');
            if (label && !label.dataset.calendarOriginalLabel) label.dataset.calendarOriginalLabel = label.textContent?.trim() || 'В календарь';
            const added = Boolean(state.e[String(anchor.dataset.calendarEventId || '')]);
            anchor.classList.toggle('is-calendar-added', added);
            anchor.dataset.calendarState = added ? 'added' : 'available';
            if (label) label.textContent = added ? 'Добавлено' : (label.dataset.calendarOriginalLabel || 'В календарь');
            const title = anchor.dataset.calendarEventTitle || 'событие';
            anchor.setAttribute('aria-label', added ? `Скачать файл календаря ещё раз: ${title}` : `Добавить в календарь: ${title}`);
            const adaptive = anchor.hasAttribute('data-calendar-adaptive-label');
            const collapsed = adaptive && collapseAdaptiveLabels;
            anchor.classList.toggle('is-calendar-label-compact', collapsed);
            anchor.dataset.calendarLabelMode = collapsed ? 'icon' : 'text';
          });
        }

        function triggerCalendarDownload(blob, eventId) {
          const objectUrl = URL.createObjectURL(blob);
          const download = document.createElement('a');
          download.href = objectUrl;
          download.download = `kenigevents-event-${eventId}.ics`;
          download.hidden = true;
          document.body.appendChild(download);
          download.click();
          download.remove();
          window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1500);
        }

        function fallbackCalendarNavigation(anchor) {
          const fallback = document.createElement('a');
          fallback.href = anchor.href;
          fallback.target = anchor.target || '';
          fallback.rel = anchor.rel || '';
          fallback.hidden = true;
          document.body.appendChild(fallback);
          fallback.click();
          fallback.remove();
        }

        let calendarActionsHydrated = false;
        function hydrateCalendarActions() {
          syncCalendarControls();
          if (calendarActionsHydrated) return;
          calendarActionsHydrated = true;
          document.addEventListener('click', async (event) => {
            const anchor = event.target.closest('a[data-calendar-action]');
            if (!anchor || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const eventId = String(anchor.dataset.calendarEventId || '').trim();
            const expiryDay = Number(anchor.dataset.calendarExpiryDay || 0);
            if (!eventId || !Number.isInteger(expiryDay) || anchor.dataset.calendarPending === 'true') return;
            event.preventDefault();
            anchor.dataset.calendarPending = 'true';
            markCalendarUsed();
            syncCalendarControls();
            try {
              const response = await fetch(anchor.href, { credentials: 'omit' });
              if (!response.ok) throw new Error(`ICS HTTP ${response.status}`);
              const blob = await response.blob();
              triggerCalendarDownload(blob, eventId);
              markCalendarAdded(eventId, expiryDay);
              syncCalendarControls();
            } catch (_) {
              fallbackCalendarNavigation(anchor);
            } finally {
              delete anchor.dataset.calendarPending;
            }
          }, true);
          window.addEventListener('storage', (event) => {
            if (event.key === CALENDAR_STATE_KEY || event.key === CALENDAR_USAGE_KEY) syncCalendarControls();
          });
          window.addEventListener('pageshow', syncCalendarControls);
        }

        function formatLocalResetTime(value) {
          const date = new Date(value);
          if (!Number.isFinite(date.getTime())) return '';
          try {
            return new Intl.DateTimeFormat('ru-RU', {
              day: '2-digit',
              month: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
            }).format(date);
          } catch (_) {
            return date.toLocaleString();
          }
        }

        function updatePersonalizationResetStatus() {
          const node = document.querySelector('[data-personalization-reset-status]');
          if (!node) return;
          let value = '';
          try { value = localStorage.getItem(RESET_AT_KEY) || ''; } catch (_) {}
          const label = formatLocalResetTime(value);
          if (!label) {
            node.hidden = true;
            node.textContent = '';
            return;
          }
          node.hidden = false;
          node.textContent = `Последний сброс: ${label}`;
        }

        function toArray(value) {
          return Array.isArray(value) ? value : [];
        }

        function asId(value) {
          return value == null ? null : String(value);
        }

        function unique(values) {
          return Array.from(new Set(toArray(values).filter((value) => value != null).map((value) => String(value)).filter(Boolean)));
        }

        function viewportClass(width) {
          if (width < 768) return 'mobile';
          if (width < 1024) return 'tablet';
          return 'desktop';
        }

        function relatedPresentationMode(width) {
          return viewportClass(width) === 'mobile' ? 'vertical_related' : 'grid_related';
        }

        function relatedLayoutMode() {
          return 'module';
        }

        function isUuid(value) {
          return typeof value === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
        }

        function createUuid() {
          const cryptoObj = globalThis.crypto || {};
          if (cryptoObj.randomUUID) return cryptoObj.randomUUID();
          const bytes = new Uint8Array(16);
          if (cryptoObj.getRandomValues) {
            cryptoObj.getRandomValues(bytes);
          } else {
            for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
          }
          bytes[6] = (bytes[6] & 0x0f) | 0x40;
          bytes[8] = (bytes[8] & 0x3f) | 0x80;
          const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
          return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
        }

        function randomId(prefix) {
          return `${prefix}-${createUuid()}`;
        }

        function stableHash(value) {
          const text = typeof value === 'string' ? value : JSON.stringify(value);
          let hash = 2166136261;
          for (let index = 0; index < text.length; index += 1) {
            hash ^= text.charCodeAt(index);
            hash = Math.imul(hash, 16777619);
          }
          return (hash >>> 0).toString(16);
        }

        function createEmptyProfile(seed) {
          return {
            consent_ok: true,
            profile_version: PROFILE_VERSION,
            feature_schema_version: FEATURE_SCHEMA_VERSION,
            taxonomy_version: TAXONOMY_VERSION,
            anon_id: createUuid(),
            session_id: createUuid(),
            positive_tags: {},
            negative_interest_tags: {},
            liked_event_ids: [],
            not_interested_event_ids: [],
            hidden_event_ids: [],
            seen_event_ids: [],
            seen_venue_ids: [],
            price_preferences: { prefer_free: false },
            share_counts: {},
            updated_at: new Date().toISOString(),
            ...(seed || {}),
          };
        }

        function profileHasConsent(profile) {
          return Boolean(profile && profile.consent_ok === true);
        }

        function isCompatibleProfile(profile, featureSchemaVersion = FEATURE_SCHEMA_VERSION, taxonomyVersion = TAXONOMY_VERSION) {
          if (!profileHasConsent(profile)) return false;
          if (profile.profile_version !== PROFILE_VERSION) return false;
          if (profile.feature_schema_version !== (featureSchemaVersion || FEATURE_SCHEMA_VERSION)) return false;
          if (profile.taxonomy_version !== (taxonomyVersion || TAXONOMY_VERSION)) return false;
          if (!isUuid(profile.anon_id) || !isUuid(profile.session_id)) return false;
          if (Object.prototype.hasOwnProperty.call(profile, 'negative_tags')) return false;
          return true;
        }

        function readProfile() {
          return readJson(PROFILE_KEY, null);
        }

        function activeProfile(manifest) {
          const profile = readProfile();
          return isCompatibleProfile(profile, manifest?.feature_schema_version, manifest?.taxonomy_version) ? profile : null;
        }

        function saveProfile(profile) {
          return writeJson(PROFILE_KEY, profile);
        }

        function ensureProfileAfterConsent(seed) {
          const existing = readProfile();
          if (isCompatibleProfile(existing)) return existing;
          const profile = createEmptyProfile(seed);
          saveProfile(profile);
          return profile;
        }

        function consentBanner() {
          let banner = document.querySelector('[data-personalization-consent]');
          if (banner) return banner;
          banner = document.createElement('div');
          banner.className = 'personalization-consent';
          banner.dataset.personalizationConsent = 'true';
          banner.setAttribute('role', 'dialog');
          banner.setAttribute('aria-live', 'polite');
          banner.innerHTML = `<p><strong>Настроить рекомендации?</strong> Лайки и отметки «не интересно» сохранятся только в этом браузере и помогут убрать неподходящее.</p><div class="personalization-consent__actions"><button type="button" class="secondary-button" data-personalization-consent-dismiss>Пока нет</button><button type="button" class="cta-button" data-personalization-consent-accept>ОК</button></div>`;
          document.body.appendChild(banner);
          banner.querySelector('[data-personalization-consent-dismiss]')?.addEventListener('click', () => {
            pendingConsentAction = null;
            banner.classList.remove('is-visible');
          });
          banner.querySelector('[data-personalization-consent-accept]')?.addEventListener('click', async () => {
            ensureProfileAfterConsent();
            banner.classList.remove('is-visible');
            const action = pendingConsentAction;
            pendingConsentAction = null;
            await applyFeedbackState();
            if (typeof action === 'function') setTimeout(action, 0);
          });
          return banner;
        }

        function requestConsent(action) {
          pendingConsentAction = action || null;
          consentBanner().classList.add('is-visible');
        }

        function mapScore(map, key) {
          if (!map || key == null) return 0;
          const value = map[key];
          const num = Number(value || 0);
          return Number.isFinite(num) ? num : 0;
        }

        function collectWeightedProfileMap(profile, fieldName) {
          const result = { ...(profile && profile[fieldName] ? profile[fieldName] : {}) };
          const horizons = [
            ['session', 1.0],
            ['short', 0.65],
            ['mid', 0.35],
            ['long', 0.20],
          ];
          for (const [horizon, weight] of horizons) {
            const section = profile && profile[horizon];
            if (!section || !section[fieldName]) continue;
            for (const [key, value] of Object.entries(section[fieldName])) {
              result[key] = mapScore(result, key) + Number(value || 0) * weight;
            }
          }
          return result;
        }

        function candidateId(candidate) {
          return candidate && (candidate.event_id != null ? candidate.event_id : candidate.id);
        }

        function currentEventId(manifest) {
          if (!manifest) return null;
          if (manifest.current_event && manifest.current_event.event_id != null) return manifest.current_event.event_id;
          return manifest.event_id != null ? manifest.event_id : null;
        }

        function displayOf(candidate) {
          return candidate && candidate.display ? candidate.display : (candidate || {});
        }

        function candidatePositiveMatchingTags(candidate) {
          if (!candidate) return [];
          const display = displayOf(candidate);
          const values = [];
          for (const key of ['category', 'event_type']) {
            if (candidate[key]) values.push(String(candidate[key]));
            if (display[key]) values.push(String(display[key]));
          }
          for (const key of ['tags', 'audience_tags', 'format_tags', 'time_tags', 'price_tags']) {
            for (const item of toArray(candidate[key])) values.push(String(item));
          }
          for (const reason of toArray(candidate.reason_codes)) {
            const text = String(reason);
            if (text.startsWith('tag:')) values.push(text.slice(4));
            if (text.startsWith('same_category:')) values.push(text.slice('same_category:'.length));
          }
          return unique(values);
        }

        function hiddenSet(profile) {
          return new Set([
            ...toArray(profile && profile.hidden_event_ids).map(asId),
            ...toArray(profile && profile.not_interested_event_ids).map(asId),
          ]);
        }

        function readListingMode() {
          try {
            const value = localStorage.getItem(LISTING_MODE_KEY);
            if (value === 'personal' || value === 'all') return value;
            return null;
          } catch (_) {
            return null;
          }
        }

        function writeListingMode(mode) {
          try {
            localStorage.setItem(LISTING_MODE_KEY, mode === 'personal' ? 'personal' : 'all');
          } catch (_) {}
        }

        function listingItems() {
          return Array.from(document.querySelectorAll('[data-listing-item]:not([data-listing-supplemental="true"])'));
        }

        function listingItemShouldHide(item, hiddenIds) {
          const id = asId(item.dataset.eventId);
          if (id && hiddenIds.has(id)) return true;
          return String(item.dataset.linkedEventIds || '')
            .split(',')
            .map((value) => asId(value.trim()))
            .filter(Boolean)
            .some((linkedId) => hiddenIds.has(linkedId));
        }

        function syncListingPersonalFilter(options = {}) {
          const items = listingItems();
          const filters = Array.from(document.querySelectorAll('[data-listing-filter]'));
          const bars = Array.from(document.querySelectorAll('[data-listing-filter-bar]'));
          if (!items.length || (!filters.length && !bars.length)) return;
          const profile = readProfile();
          const validProfile = isCompatibleProfile(profile);
          const hiddenIds = validProfile ? hiddenSet(profile) : new Set();
          const explicitMode = readListingMode();
          const hiddenCandidates = items.filter((item) => listingItemShouldHide(item, hiddenIds));
          const hiddenCount = hiddenCandidates.length;
          const total = items.length;
          const mode = explicitMode || (hiddenCount > 0 ? 'personal' : 'all');
          const personalMode = mode === 'personal';
          if (hiddenCount <= 0) {
            items.forEach((item) => {
              item.hidden = false;
              item.dataset.personalHidden = 'false';
            });
            document.querySelectorAll('[data-listing-daypart]').forEach((section) => {
              const count = section.querySelectorAll('[data-listing-item]').length;
              const badge = section.querySelector('[data-listing-daypart-count]');
              if (badge) badge.textContent = String(count);
            });
            [...filters, ...bars].forEach((root) => {
              root.hidden = true;
              root.classList.remove('is-visible');
            });
            document.body.classList.remove('has-listing-filter-bar');
            return;
          }
          items.forEach((item) => {
            const shouldHide = personalMode && listingItemShouldHide(item, hiddenIds);
            item.hidden = shouldHide;
            item.dataset.personalHidden = shouldHide ? 'true' : 'false';
          });
          document.querySelectorAll('[data-listing-daypart]').forEach((section) => {
            const count = Array.from(section.querySelectorAll('[data-listing-item]')).filter((item) => !item.hidden).length;
            const badge = section.querySelector('[data-listing-daypart-count]');
            if (badge) badge.textContent = String(count);
          });
          const visible = items.filter((item) => !item.hidden).length;
          const summaryText = personalMode
            ? `Для вас · показано ${visible} из ${total}. Скрыто ${hiddenCount} по вашим отметкам.`
            : hiddenCount > 0
              ? `Показаны все ${total}. Режим «Для меня» скроет ${hiddenCount} отмеченных событий.`
              : `Показаны все ${total}. Пока нечего скрывать по вашим отметкам.`;
          const titleText = personalMode ? 'Для меня' : 'Все события';
          [...filters, ...bars].forEach((root) => {
            root.hidden = false;
            root.classList.add('is-visible');
            root.querySelectorAll('[data-listing-mode-button]').forEach((button) => {
              const pressed = button.dataset.listingModeButton === mode;
              button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
              button.setAttribute('aria-checked', pressed ? 'true' : 'false');
            });
            root.querySelectorAll('[data-listing-total-count]').forEach((node) => { node.textContent = String(total); });
            root.querySelectorAll('[data-listing-visible-count]').forEach((node) => { node.textContent = String(visible); });
            root.querySelectorAll('[data-listing-hidden-count]').forEach((node) => { node.textContent = `Скрыто ${hiddenCount}`; });
            const title = root.querySelector('[data-listing-filter-title]');
            const summary = root.querySelector('[data-listing-filter-summary]');
            if (title) title.textContent = titleText;
            if (summary) summary.textContent = summaryText;
          });
          document.body.classList.toggle('has-listing-filter-bar', bars.length > 0);
          if (options.focusSummary) {
            const focusTarget = filters[0]?.querySelector('[data-listing-filter-summary-focus]');
            if (focusTarget) focusTarget.focus({ preventScroll: true });
          }
        }

        function likedSet(profile) {
          return new Set(toArray(profile && profile.liked_event_ids).map(asId));
        }

        function staticCandidateScore(candidate) {
          const raw = candidate && (candidate.static_score != null ? candidate.static_score : candidate.base_similarity);
          const score = Number(raw || 0);
          if (!Number.isFinite(score)) return 0;
          return Math.max(0, Math.min(1, score));
        }

        function isCancelledLike(candidate) {
          const lifecycle = String((candidate && candidate.lifecycle_status) || '').toLowerCase();
          const status = String((candidate && (candidate.status || candidate.ticket_status)) || '').toLowerCase();
          return ['cancelled', 'postponed', 'duplicate', 'merged'].includes(lifecycle) || ['cancelled', 'postponed'].includes(status);
        }

        function tagAffinity(candidate, profile) {
          const positive = collectWeightedProfileMap(profile || {}, 'positive_tags');
          const positiveCategories = collectWeightedProfileMap(profile || {}, 'positive_categories');
          let sum = 0;
          for (const tag of candidatePositiveMatchingTags(candidate)) sum += mapScore(positive, tag);
          if (candidate && candidate.category) sum += mapScore(positiveCategories, candidate.category);
          return Math.min(1.5, sum / 2);
        }

        function negativeInterestPenalty(candidate, profile) {
          const negative = collectWeightedProfileMap(profile || {}, 'negative_interest_tags');
          let penalty = 0;
          for (const tag of candidatePositiveMatchingTags(candidate)) penalty += Math.max(0, mapScore(negative, tag));
          return Math.min(1.5, penalty);
        }

        function priceMatch(candidate, profile) {
          if (!profile || !profile.price_preferences) return 0;
          if (profile.price_preferences.prefer_free && candidate && candidate.is_free) return 1;
          return 0;
        }

        function timeMatch(candidate, profile) {
          const prefs = collectWeightedProfileMap(profile || {}, 'positive_time_tags');
          let score = 0;
          for (const tag of toArray(candidate && candidate.time_tags)) score += mapScore(prefs, tag);
          for (const tag of candidatePositiveMatchingTags(candidate)) {
            if (tag === 'evening' || tag === 'daytime') score += mapScore(prefs, tag);
          }
          return Math.min(1, score);
        }

        function fatiguePenalty(candidate, profile) {
          if (!profile) return 0;
          const id = asId(candidateId(candidate));
          const venue = asId(candidate && (candidate.venue_id || candidate.location_name));
          let penalty = 0;
          if (new Set(toArray(profile.seen_event_ids).map(asId)).has(id)) penalty += 0.7;
          if (venue && new Set(toArray(profile.seen_venue_ids).map(asId)).has(venue)) penalty += 0.35;
          return Math.min(1, penalty);
        }

        function isEligibleCandidate(candidate, manifest, profile) {
          if (!candidate) return false;
          const id = candidateId(candidate);
          if (id == null) return false;
          if (asId(id) === asId(currentEventId(manifest))) return false;
          if (isCancelledLike(candidate)) return false;
          if (profileHasConsent(profile) && hiddenSet(profile).has(asId(id))) return false;
          if (profileHasConsent(profile) && negativeInterestPenalty(candidate, profile) >= NEGATIVE_HARD_FILTER_THRESHOLD) return false;
          return true;
        }

        function scoreRelatedCandidate(candidate, manifest, profile) {
          const weights = DEFAULT_WEIGHTS;
          const base = staticCandidateScore(candidate);
          if (!profileHasConsent(profile)) {
            return { score: base, base_similarity: base, reason_codes: toArray(candidate && candidate.reason_codes).slice() };
          }
          const affinity = tagAffinity(candidate, profile);
          const negative = negativeInterestPenalty(candidate, profile);
          const fatigue = fatiguePenalty(candidate, profile);
          const price = priceMatch(candidate, profile);
          const time = timeMatch(candidate, profile);
          const soldOut = String((candidate && (candidate.status || candidate.ticket_status)) || '').toLowerCase() === 'sold_out' ? 1 : 0;
          const exploration = candidate && candidate.exploration_candidate ? 1 : 0;
          const explicitLike = likedSet(profile).has(asId(candidateId(candidate))) ? 1 : 0;
          const score =
            weights.staticContext * base +
            weights.profileAffinity * affinity +
            weights.priceMatch * price +
            weights.timeMatch * time +
            weights.explicitLike * explicitLike +
            weights.exploration * exploration -
            weights.negativeInterest * negative -
            weights.fatigue * fatigue -
            weights.soldOut * soldOut;
          const reasonCodes = toArray(candidate && candidate.reason_codes).slice();
          if (affinity > 0) reasonCodes.push('profile:positive_affinity');
          if (explicitLike > 0) reasonCodes.push('profile:explicit_like');
          if (negative > 0) reasonCodes.push('profile:negative_interest_penalty');
          if (fatigue > 0) reasonCodes.push('profile:fatigue_penalty');
          if (price > 0) reasonCodes.push('profile:price_match');
          return { score, base_similarity: base, reason_codes: unique(reasonCodes) };
        }

        function applyDiversity(sorted, options = {}) {
          const maxSameCategory = options.maxSameCategory == null ? 3 : Number(options.maxSameCategory);
          const maxSameVenue = options.maxSameVenue == null ? 2 : Number(options.maxSameVenue);
          const result = [];
          const postponed = [];
          const categoryCounts = new Map();
          const venueCounts = new Map();
          for (const item of sorted) {
            const candidate = item.candidate;
            const category = candidate.category || candidate.event_type || 'unknown';
            const venue = candidate.venue_id || candidate.location_name || 'unknown';
            const catCount = categoryCounts.get(category) || 0;
            const venueCount = venueCounts.get(venue) || 0;
            if (catCount >= maxSameCategory || venueCount >= maxSameVenue) {
              postponed.push({ ...item, diversity_postponed: true });
              continue;
            }
            result.push(item);
            categoryCounts.set(category, catCount + 1);
            venueCounts.set(venue, venueCount + 1);
          }
          return result.concat(postponed);
        }

        function rankEventDetailRelated(manifest, profile, options = {}) {
          const candidates = toArray(manifest && (manifest.related_static || manifest.candidates || manifest.events));
          const active = isCompatibleProfile(profile, manifest && manifest.feature_schema_version, manifest && manifest.taxonomy_version) ? profile : null;
          const scored = [];
          for (const candidate of candidates) {
            if (!isEligibleCandidate(candidate, manifest, active)) continue;
            const scoreInfo = scoreRelatedCandidate(candidate, manifest, active);
            scored.push({ candidate, score: scoreInfo.score, base_similarity: scoreInfo.base_similarity, reason_codes: scoreInfo.reason_codes });
          }
          scored.sort((left, right) => {
            const byScore = right.score - left.score;
            if (byScore !== 0) return byScore;
            const byBase = right.base_similarity - left.base_similarity;
            if (byBase !== 0) return byBase;
            return Number(candidateId(left.candidate) || 0) - Number(candidateId(right.candidate) || 0);
          });
          return applyDiversity(scored, options).map((item, index) => ({
            event_id: candidateId(item.candidate),
            candidate: item.candidate,
            rank: index,
            personal_score: Number(item.score.toFixed(4)),
            base_similarity: Number(item.base_similarity.toFixed(4)),
            reason_codes: item.reason_codes,
            diversity_postponed: Boolean(item.diversity_postponed),
          }));
        }

        function normalizeManifest(payload, feed) {
          if (payload && Array.isArray(payload.related_static)) return payload;
          const events = toArray(payload && payload.events).map((item, index) => ({
            event_id: item.id ?? item.event_id,
            title: item.title || 'Событие',
            category: item.event_type || 'event',
            tags: unique([item.event_type]),
            audience_exclusion_tags: [],
            city: item.city || null,
            location_name: item.venue_name || null,
            date: item.date || item.display_date || '',
            status: item.status_label || 'available',
            lifecycle_status: 'active',
            is_free: /бесплат|свободн/iu.test(item.price_label || ''),
            base_similarity: Math.max(0, 1 - index * 0.01),
            static_score: Math.max(0, 1 - index * 0.01),
            reason_codes: ['legacy_json_payload'],
            exploration_candidate: false,
            display: item,
          }));
          return {
            version: payload?.version || 1,
            schema_version: FEATURE_SCHEMA_VERSION,
            feature_schema_version: FEATURE_SCHEMA_VERSION,
            taxonomy_version: TAXONOMY_VERSION,
            surface: SURFACE_EVENT_DETAIL_RELATED,
            algorithm_id: STATIC_ALGORITHM_ID,
            event_id: Number(feed?.dataset.currentEventId || payload?.event_id || 0),
            current_event: { event_id: Number(feed?.dataset.currentEventId || payload?.event_id || 0), title: document.title, category: 'event', tags: [], audience_exclusion_tags: [], city: null, location_name: null, date: '' },
            preload_target: Number(payload?.preload_target || DEFAULT_PRELOAD_TARGET),
            page_size: Number(payload?.page_size || DEFAULT_PRELOAD_TARGET),
            related_static: events,
          };
        }


        function personalFeedProfileHash(profile) {
          return stableHash({
            profile_version: profile?.profile_version || null,
            feature_schema_version: profile?.feature_schema_version || FEATURE_SCHEMA_VERSION,
            taxonomy_version: profile?.taxonomy_version || TAXONOMY_VERSION,
            anon_id: profile?.anon_id || null,
            positive_tags: profile?.positive_tags || {},
            negative_interest_tags: profile?.negative_interest_tags || {},
            liked_event_ids: toArray(profile?.liked_event_ids).slice(-80),
            not_interested_event_ids: toArray(profile?.not_interested_event_ids).slice(-120),
            hidden_event_ids: toArray(profile?.hidden_event_ids).slice(-120),
            price_preferences: profile?.price_preferences || {},
          });
        }

        function personalFeedSignalCount(profile) {
          if (!isCompatibleProfile(profile)) return 0;
          const explicitIds = new Set([
            ...toArray(profile.liked_event_ids).map(asId),
            ...toArray(profile.not_interested_event_ids).map(asId),
            ...toArray(profile.hidden_event_ids).map(asId),
          ].filter(Boolean));
          const shareSignals = Object.values(profile.share_counts || {}).reduce((sum, value) => sum + Math.max(0, Number(value || 0)), 0);
          return explicitIds.size + Math.min(3, shareSignals);
        }

        function personalFeedProfileIsReady(profile) {
          return isCompatibleProfile(profile) && personalFeedSignalCount(profile) >= 3;
        }

        function normalizePersonalFeedItem(item, index) {
          const candidate = item && item.candidate ? item.candidate : item;
          const display = displayOf(candidate);
          const id = candidateId(candidate) ?? display.id ?? display.event_id;
          return {
            event_id: id,
            title: candidate?.title || display.title || 'Событие',
            category: candidate?.category || display.event_type || 'event',
            tags: unique([...(toArray(candidate?.tags)), display.event_type, candidate?.category]),
            audience_exclusion_tags: toArray(candidate?.audience_exclusion_tags),
            city: candidate?.city || display.city || null,
            location_name: candidate?.location_name || display.venue_name || null,
            date: candidate?.date || display.display_date || display.date || '',
            status: candidate?.status || display.status_label || 'available',
            lifecycle_status: candidate?.lifecycle_status || 'active',
            is_free: Boolean(candidate?.is_free) || /бесплат|свободн/iu.test(display.price_label || ''),
            base_similarity: Number(candidate?.base_similarity ?? candidate?.personal_score ?? Math.max(0, 1 - index * 0.001)),
            static_score: Number(candidate?.static_score ?? candidate?.base_similarity ?? Math.max(0, 1 - index * 0.001)),
            reason_codes: unique([...(toArray(candidate?.reason_codes)), 'catalog:personal_feed']),
            exploration_candidate: Boolean(candidate?.exploration_candidate),
            slot_type: candidate?.slot_type || null,
            vector_similarity: Number.isFinite(Number(candidate?.vector_similarity)) ? Number(candidate.vector_similarity) : null,
            llm_semantic_score: Number.isFinite(Number(candidate?.llm_semantic_score)) ? Number(candidate.llm_semantic_score) : null,
            verification_state: candidate?.verification_state || 'not_run',
            gemma_reject: candidate?.gemma_reject === true,
            retrieval_sources: toArray(candidate?.retrieval_sources).map(String),
            display: {
              ...display,
              id,
              href: rebaseInternalEventUrl(display.href || candidate?.href || '#'),
              absolute_url: rebaseInternalEventUrl(display.absolute_url || candidate?.absolute_url || display.href || candidate?.href || location.href, { absolute: true }),
              title: display.title || candidate?.title || 'Событие',
              image_url: display.image_url || candidate?.image_url || null,
              image_alt: display.image_alt || candidate?.image_alt || `Афиша события «${display.title || candidate?.title || 'событие'}»`,
              image_text_mode: display.image_text_mode || candidate?.image_text_mode || 'unknown',
              image_media_role: display.image_media_role || candidate?.image_media_role || 'unknown_document',
              image_width: Number(display.image_width || candidate?.image_width || 0),
              image_height: Number(display.image_height || candidate?.image_height || 0),
              focal_y: Number.isFinite(Number(display.focal_y)) ? Math.max(0, Math.min(1, Number(display.focal_y))) : 0.5,
              display_date: display.display_date || candidate?.date || '',
              display_date_time: display.display_date_time || display.display_date || candidate?.date || '',
              city: display.city || candidate?.city || null,
              venue_name: display.venue_name || candidate?.location_name || null,
              place: display.place || [display.city || candidate?.city, display.venue_name || candidate?.location_name].filter(Boolean).join(' · '),
              status_label: display.status_label || candidate?.status || '',
              price_label: display.price_label || null,
              likes_count: Number(display.likes_count || 0),
              shares_count: Number(display.shares_count || 0),
              calendar_href: rebaseInternalEventUrl(display.calendar_href || candidate?.calendar_href || '#'),
              calendar_eligible: Boolean(display.calendar_eligible || candidate?.calendar_eligible),
            },
          };
        }

        function normalizePersonalFeedManifest(payload, options = {}) {
          const items = toArray(payload?.related_static || payload?.items || payload?.events || payload?.recommendations);
          const relatedItems = toArray(options.relatedPayload?.related_static);
          const currentEventId = asId(options.currentEventId || options.relatedPayload?.event_id || options.relatedPayload?.current_event?.event_id);
          return {
            version: payload?.version || 1,
            schema_version: payload?.schema_version || PERSONAL_FEED_SCHEMA_VERSION,
            feature_schema_version: payload?.feature_schema_version || FEATURE_SCHEMA_VERSION,
            taxonomy_version: payload?.taxonomy_version || TAXONOMY_VERSION,
            surface: payload?.surface || PERSONAL_FEED_SURFACE,
            algorithm_id: payload?.algorithm_id || 'static_personal_feed_catalog_v1',
            generated_at: payload?.generated_at || new Date().toISOString(),
            preload_target: Number(payload?.preload_target || PERSONAL_FEED_LIMIT),
            page_size: Number(payload?.page_size || PERSONAL_FEED_LIMIT),
            current_event: currentEventId ? { event_id: currentEventId } : null,
            current_event_id: currentEventId || null,
            related_static: items.map(normalizePersonalFeedItem).filter((item) => item.event_id != null),
            related_adjacent: relatedItems.map(normalizePersonalFeedItem).filter((item) => item.event_id != null),
          };
        }

        function personalFeedCurrentEventId(section) {
          return asId(section?.dataset.currentEventId);
        }

        function readPersonalFeedCache(profile, section) {
          const cache = readJson(PERSONAL_FEED_CACHE_KEY, null);
          if (!cache || cache.schema_version !== PERSONAL_FEED_SCHEMA_VERSION) return null;
          if (cache.base_path !== CURRENT_BASE_PATH) return null;
          if (Number(cache.expires_at || 0) <= Date.now()) return null;
          if (cache.profile_hash !== personalFeedProfileHash(profile)) return null;
          if (asId(cache.current_event_id) !== personalFeedCurrentEventId(section)) return null;
          if (!cache.manifest || !Array.isArray(cache.manifest.related_static)) return null;
          return cache.manifest;
        }

        function writePersonalFeedCache(manifest, profile, section) {
          if (!manifest || !Array.isArray(manifest.related_static) || !manifest.related_static.length) return;
          writeJson(PERSONAL_FEED_CACHE_KEY, {
            schema_version: PERSONAL_FEED_SCHEMA_VERSION,
            base_path: CURRENT_BASE_PATH,
            profile_hash: personalFeedProfileHash(profile),
            current_event_id: personalFeedCurrentEventId(section),
            saved_at: Date.now(),
            expires_at: Date.now() + PERSONAL_FEED_TTL_MS,
            manifest,
          });
        }

        function personalFeedConfig() {
          const url = String(document.body.dataset.personalFeedSupabaseUrl || '').replace(/\/+$/u, '');
          const key = String(document.body.dataset.personalFeedSupabaseKey || '');
          const rpc = String(document.body.dataset.personalFeedRpcName || 'get_listing_personal_feed_v1');
          if (!url || !key || !rpc) return null;
          return { url, key, rpc };
        }

        function compactProfileForRpc(profile) {
          if (!isCompatibleProfile(profile)) return null;
          return {
            anon_id: profile.anon_id,
            session_id: profile.session_id,
            feature_schema_version: profile.feature_schema_version,
            taxonomy_version: profile.taxonomy_version,
            positive_tags: profile.positive_tags || {},
            negative_interest_tags: profile.negative_interest_tags || {},
            liked_event_ids: toArray(profile.liked_event_ids).slice(-80),
            not_interested_event_ids: toArray(profile.not_interested_event_ids).slice(-120),
            hidden_event_ids: toArray(profile.hidden_event_ids).slice(-120),
            seen_event_ids: toArray(profile.seen_event_ids).slice(-120),
            seen_venue_ids: toArray(profile.seen_venue_ids).slice(-80),
            price_preferences: profile.price_preferences || {},
          };
        }

        async function fetchPersonalFeedManifest(profile, section) {
          const source = String(section?.dataset.personalFeedSrc || '').trim();
          let payload = null;
          if (source) {
            try {
              const response = await fetch(source, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
              if (response.ok) payload = await response.json();
            } catch (_) {}
          }
          if (!payload && personalFeedProfileIsReady(profile)) {
            const config = personalFeedConfig();
            if (config) {
              const response = await fetch(`${config.url}/rest/v1/rpc/${encodeURIComponent(config.rpc)}`, {
                method: 'POST',
                headers: {
                  Accept: 'application/json',
                  'Content-Type': 'application/json',
                  apikey: config.key,
                  Authorization: `Bearer ${config.key}`,
                },
                body: JSON.stringify({
                  p_surface: PERSONAL_FEED_SURFACE,
                  p_limit: PERSONAL_FEED_LIMIT,
                  p_profile: compactProfileForRpc(profile),
                }),
              });
              if (response.ok) payload = await response.json();
            }
          }
          if (!payload) return null;
          let relatedPayload = null;
          const relatedSource = String(section?.dataset.personalFeedRelatedSrc || '').trim();
          if (relatedSource) {
            try {
              const response = await fetch(relatedSource, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
              if (response.ok) relatedPayload = await response.json();
            } catch (_) {}
          }
          return normalizePersonalFeedManifest(payload, {
            currentEventId: personalFeedCurrentEventId(section),
            relatedPayload,
          });
        }

        async function getPersonalFeedManifest(section, { force = false } = {}) {
          const profile = readProfile();
          const allowsPopularFallback = section?.dataset.listingContext === 'event-detail';
          if (!personalFeedProfileIsReady(profile) && !allowsPopularFallback) return null;
          if (!force) {
            const cached = readPersonalFeedCache(profile, section);
            if (cached) return cached;
          }
          const requestKey = `${personalFeedProfileHash(profile)}:${personalFeedCurrentEventId(section)}`;
          if (personalFeedRequest?.key === requestKey && !force) return personalFeedRequest.promise;
          const promise = fetchPersonalFeedManifest(profile, section)
            .then((manifest) => {
              if (manifest) writePersonalFeedCache(manifest, profile, section);
              return manifest;
            })
            .catch(() => null)
            .finally(() => { if (personalFeedRequest?.key === requestKey) personalFeedRequest = null; });
          personalFeedRequest = { key: requestKey, promise };
          return promise;
        }

        function personalFeedPopularity(candidate) {
          const display = displayOf(candidate);
          const likes = Math.max(0, Number(display.likes_count || 0));
          const shares = Math.max(0, Number(display.shares_count || 0));
          return Math.min(1, Math.log1p(likes + shares * 1.5) / Math.log(80));
        }

        function collapseRankedOccurrenceFamilies(items) {
          const seen = new Set();
          return toArray(items).filter((item) => {
            const display = displayOf(item?.candidate);
            const memberIds = unique(toArray(display?.occurrence_member_ids).map(asId).filter(Boolean)).sort((left, right) => left - right);
            const eventId = asId(item?.event_id) || asId(candidateId(item?.candidate));
            const familyKey = memberIds.length > 1 ? `family:${memberIds.join(',')}` : `event:${eventId || ''}`;
            if (seen.has(familyKey)) return false;
            seen.add(familyKey);
            return true;
          }).map((item, index) => ({ ...item, rank:index }));
        }

        function rankPersonalFeedCandidates(manifest, profile) {
          if (!personalFeedProfileIsReady(profile)) return [];
          const scored = [];
          for (const candidate of toArray(manifest?.related_static)) {
            if (!isEligibleCandidate(candidate, manifest, profile)) continue;
            const affinity = tagAffinity(candidate, profile);
            const negative = negativeInterestPenalty(candidate, profile);
            const fatigue = fatiguePenalty(candidate, profile);
            const price = priceMatch(candidate, profile);
            const time = timeMatch(candidate, profile);
            const popularity = personalFeedPopularity(candidate);
            const exploration = candidate?.exploration_candidate ? 1 : 0;
            const score =
              0.60 * affinity +
              0.16 * popularity +
              0.09 * price +
              0.06 * time +
              0.05 * staticCandidateScore(candidate) +
              0.04 * exploration -
              0.62 * negative -
              0.16 * fatigue;
            const reasonCodes = toArray(candidate.reason_codes).slice();
            if (affinity > 0) reasonCodes.push('profile:positive_affinity');
            if (popularity > 0) reasonCodes.push('catalog:popularity');
            if (price > 0) reasonCodes.push('profile:price_match');
            scored.push({ candidate, score, base_similarity: staticCandidateScore(candidate), reason_codes: unique(reasonCodes) });
          }
          scored.sort((left, right) => right.score - left.score || right.base_similarity - left.base_similarity || Number(candidateId(left.candidate) || 0) - Number(candidateId(right.candidate) || 0));
          return applyDiversity(scored, { maxSameCategory: 3, maxSameVenue: 2 }).map((item, index) => ({
            event_id: candidateId(item.candidate),
            candidate: item.candidate,
            rank: index,
            personal_score: Number(item.score.toFixed(4)),
            base_similarity: Number(item.base_similarity.toFixed(4)),
            reason_codes: item.reason_codes,
            diversity_postponed: Boolean(item.diversity_postponed),
          }));
        }

        function rankPopularFallbackCandidates(manifest, profile) {
          const active = isCompatibleProfile(profile) ? profile : null;
          const scored = [];
          for (const candidate of toArray(manifest?.related_static)) {
            if (!isEligibleCandidate(candidate, manifest, active)) continue;
            const popularity = personalFeedPopularity(candidate);
            const currentDay = Date.parse(`${String(manifest?.current_date || '').slice(0, 10)}T00:00:00Z`);
            const candidateDay = Date.parse(`${String(candidate?.date || candidate?.start_date || '').slice(0, 10)}T00:00:00Z`);
            const daysAway = Number.isFinite(currentDay) && Number.isFinite(candidateDay)
              ? Math.max(0, Math.round((candidateDay - currentDay) / 86400000))
              : 30;
            const upcomingProximity = 1 / (1 + daysAway / 7);
            const score = 0.68 * popularity + 0.32 * upcomingProximity;
            scored.push({
              candidate,
              score,
              base_similarity: upcomingProximity,
              reason_codes: unique([...(toArray(candidate.reason_codes)), 'catalog:popular_fallback', 'catalog:upcoming_proximity']),
            });
          }
          scored.sort((left, right) => right.score - left.score || right.base_similarity - left.base_similarity || Number(candidateId(left.candidate) || 0) - Number(candidateId(right.candidate) || 0));
          return applyDiversity(scored, { maxSameCategory: 3, maxSameVenue: 2 }).map((item, index) => ({
            event_id: candidateId(item.candidate),
            candidate: item.candidate,
            rank: index,
            personal_score: Number(item.score.toFixed(4)),
            base_similarity: Number(item.base_similarity.toFixed(4)),
            reason_codes: item.reason_codes,
            diversity_postponed: Boolean(item.diversity_postponed),
          }));
        }

        function rankAdjacentContinuationCandidates(manifest, profile) {
          const active = isCompatibleProfile(profile) ? profile : null;
          return toArray(manifest?.related_adjacent)
            .filter((candidate) => isEligibleCandidate(candidate, manifest, active))
            .filter((candidate) => candidate?.verification_state !== 'llm_rejected' && candidate?.gemma_reject !== true)
            .filter((candidate) => candidate?.vector_similarity != null || candidate?.slot_type === 'adjacent_discovery' || toArray(candidate?.retrieval_sources).some((source) => /pgvector|event_embedding/iu.test(String(source))))
            .map((candidate, index) => ({
              event_id: candidateId(candidate),
              candidate,
              rank: index,
              personal_score: Number(staticCandidateScore(candidate).toFixed(4)),
              base_similarity: Number(staticCandidateScore(candidate).toFixed(4)),
              reason_codes: unique([...(toArray(candidate.reason_codes)), 'continuation:current_event_tail']),
            }));
        }

        function normalizeRecentContinuationRing(value) {
          const now = Date.now();
          const blocks = toArray(value?.blocks)
            .filter((block) => Number(block?.served_at || 0) > now - EVENT_CONTINUATION_RECENT_TTL_MS)
            .slice(-EVENT_CONTINUATION_RECENT_BLOCKS)
            .map((block) => ({
              served_at: Number(block.served_at),
              current_event_id: asId(block.current_event_id),
              event_ids: unique(toArray(block.event_ids).map(asId).filter(Boolean)).slice(0, EVENT_DETAIL_CONTINUATION_LIMIT),
            }));
          return { version: 1, blocks };
        }

        function readRecentContinuationIds() {
          const ring = normalizeRecentContinuationRing(readJson(EVENT_CONTINUATION_RECENT_KEY, null));
          writeJson(EVENT_CONTINUATION_RECENT_KEY, ring);
          return new Set(ring.blocks.flatMap((block) => block.event_ids));
        }

        function recordRecentContinuation(currentEventId, ranked) {
          const ring = normalizeRecentContinuationRing(readJson(EVENT_CONTINUATION_RECENT_KEY, null));
          const eventIds = unique(toArray(ranked).map((item) => asId(item?.event_id)).filter(Boolean)).slice(0, EVENT_DETAIL_CONTINUATION_LIMIT);
          if (!eventIds.length) return;
          ring.blocks.push({ served_at: Date.now(), current_event_id: asId(currentEventId), event_ids: eventIds });
          ring.blocks = ring.blocks.slice(-EVENT_CONTINUATION_RECENT_BLOCKS);
          writeJson(EVENT_CONTINUATION_RECENT_KEY, ring);
        }

        const PERSONAL_FEED_CHUNK_SIZE = 6;
        const PERSONAL_FEED_RENDER_LIMIT = 18;
        const EVENT_DETAIL_CONTINUATION_LIMIT = 6;
        const personalFeedStores = new WeakMap();
        const personalFeedReached = new WeakSet();
        const personalFeedHydrationInFlight = new WeakSet();
        const personalFeedDesktopMedia = typeof window.matchMedia === 'function' ? window.matchMedia('(min-width: 1024px)') : null;

        function personalFeedSectionCanHydrate(section) {
          if (section?.dataset.personalFeedDesktopOnly !== 'true') return true;
          return personalFeedDesktopMedia ? personalFeedDesktopMedia.matches : Number(window.innerWidth || 0) >= 1024;
        }

        function personalFeedUsesDesktopRows() {
          return personalFeedDesktopMedia ? personalFeedDesktopMedia.matches : Number(window.innerWidth || 0) >= 1024;
        }

        function visibleHideStickyMarker() {
          const markers = Array.from(document.querySelectorAll('[data-hide-sticky-after]'));
          return markers.find((marker) => marker.getClientRects().length > 0) || markers[0] || null;
        }

        function eventIdsAlreadyOffered(section) {
          const ids = new Set();
          document.querySelectorAll('[data-related-start] [data-event-card], [data-discovery-feed] [data-event-card]').forEach((card) => {
            const id = asId(card.dataset.eventId);
            if (id) ids.add(id);
          });
          const discoveryFeed = document.querySelector('[data-discovery-feed]');
          const currentId = asId(discoveryFeed?.dataset.currentEventId);
          if (currentId) ids.add(currentId);
          section?.querySelectorAll('[data-event-card]').forEach((card) => {
            const id = asId(card.dataset.eventId);
            if (id) ids.add(id);
          });
          return ids;
        }

        function appendPersonalFeedChunk(section) {
          const store = personalFeedStores.get(section);
          const slot = section.querySelector('[data-personal-feed-slot]');
          const loadMore = section.querySelector('[data-personal-feed-load-more]');
          if (!store || !slot || !personalFeedSectionCanHydrate(section)) return 0;
          const end = Math.min(store.items.length, store.rendered + PERSONAL_FEED_CHUNK_SIZE);
          const chunk = store.items.slice(store.rendered, end);
          let appended = 0;
          let nextRendered = end;
          if (chunk.length) {
            const desktopRows = personalFeedUsesDesktopRows();
            let packed = desktopRows && typeof window.KenigEventsPackRelatedCardRows === 'function'
              ? window.KenigEventsPackRelatedCardRows(store.items.slice(store.rendered, Math.min(store.items.length, end + 3)), {
                  limit: chunk.length,
                  rowSize: 3,
                  mediaTreatment: 'hybrid',
                  geometry: window.KenigEventsRelatedCardMediaGeometry,
                })
              : !desktopRows && typeof window.KenigEventsResolveMobileEventCardMedia === 'function'
                ? chunk.map((item) => ({ item, layout: window.KenigEventsResolveMobileEventCardMedia(item) }))
                : [];
            if (desktopRows) {
              const rowOffset = Math.ceil(slot.querySelectorAll(':scope > [data-event-card]').length / 3);
              const selected = new Set(packed.map(({ item }) => item));
              const pool = store.items.slice(store.rendered, Math.min(store.items.length, end + 3));
              const deferred = pool.filter((item) => !selected.has(item));
              store.items.splice(store.rendered, pool.length, ...packed.map(({ item }) => item), ...deferred);
              packed = packed.map(({ item, layout }) => ({
                item,
                layout: { ...layout, rowIndex: Number(layout.rowIndex) + rowOffset },
              }));
              nextRendered = store.rendered + packed.length;
              // If even the bounded alternate pool cannot form the requested
              // chunk, keep that optimizer remainder as the final row rather
              // than appending a later row beneath an incomplete middle row.
              if (packed.length < chunk.length && nextRendered < store.items.length) {
                store.desktopPackingComplete = true;
              }
            }
            for (const { item, layout } of packed) {
              if (appendEventCard(slot, item, slot.dataset.feedCardVariant || 'split-actions', layout)) appended += 1;
            }
          }
          store.rendered = nextRendered;
          if (loadMore) loadMore.hidden = Boolean(store.desktopPackingComplete) || store.rendered >= store.items.length;
          syncCardsFeedbackState(store.profile);
          syncPersonalFeedController(section);
          return appended;
        }

        function syncPersonalFeedController(section) {
          if (section?.dataset.listingContext !== 'event-detail') return;
          const slot = section?.querySelector('[data-personal-feed-slot]');
          const store = personalFeedStores.get(section);
          if (!slot || !store?.manifest) return;
          const algorithmId = `${store.manifest.algorithm_id || 'static_personal_feed_catalog_v1'}:bounded_continuation_v1`;
          slot.dataset.surface = SURFACE_EVENT_DETAIL_RELATED;
          slot.dataset.layoutMode = relatedLayoutMode();
          slot.dataset.presentationMode = relatedPresentationMode(window.innerWidth || 1024);
          slot.dataset.effectiveAlgorithmId = algorithmId;
          const visibleRanked = Array.from(slot.querySelectorAll(':scope > [data-event-card]'))
            .filter((card) => !card.hidden)
            .map((card) => cardRankedItem(card, store))
            .filter(Boolean);
          const context = contextForFeed(slot, store.manifest, store.profile, algorithmId);
          context.servedListHash = createServedListHash(visibleRanked, store.manifest, context, store.profile);
          context.servedListId = randomId('served');
          servedListByFeed.set(slot, createServedListSummary(visibleRanked, store.manifest, context));
        }

        function renderPersonalFeedSection(section, manifest) {
          if (!personalFeedSectionCanHydrate(section)) return;
          const slot = section.querySelector('[data-personal-feed-slot]');
          const status = section.querySelector('[data-personal-feed-status]');
          const refresh = section.querySelector('[data-personal-feed-refresh]');
          const loadMore = section.querySelector('[data-personal-feed-load-more]');
          const profile = readProfile();
          const title = section.querySelector('[data-personal-feed-title]');
          const explanation = section.querySelector('[data-personal-feed-explanation]');
          const isEventDetail = section.dataset.listingContext === 'event-detail';
          const isPersonal = personalFeedProfileIsReady(profile);
          if (!slot || !manifest) {
            if (isEventDetail) {
              section.hidden = false;
              section.dataset.personalFeedMode = 'unavailable';
              if (status) status.textContent = 'Подборка временно недоступна — можно перейти ко всем анонсам.';
            } else {
              section.hidden = true;
            }
            personalFeedStores.delete(section);
            return;
          }
          if (isEventDetail && (typeof window.KenigEventsSelectEventContinuation !== 'function' || typeof window.KenigEventsPackRelatedCardRows !== 'function')) {
            section.hidden = false;
            section.dataset.personalFeedMode = 'unavailable';
            if (status) status.textContent = 'Подборка временно недоступна — можно перейти ко всем анонсам.';
            personalFeedStores.delete(section);
            return;
          }
          const excluded = eventIdsAlreadyOffered(section);
          const profileRanked = isPersonal ? rankPersonalFeedCandidates(manifest, profile) : [];
          const genericRanked = rankPopularFallbackCandidates(manifest, profile);
          const adjacentRanked = isEventDetail ? rankAdjacentContinuationCandidates(manifest, profile) : [];
          const recentServed = isEventDetail ? readRecentContinuationIds() : new Set();
          const rankedBeforeOccurrenceCollapse = isEventDetail
            ? window.KenigEventsSelectEventContinuation({
                currentEventId: personalFeedCurrentEventId(section),
                profileCandidates: profileRanked,
                adjacentCandidates: adjacentRanked,
                genericCandidates: genericRanked,
                excludedIds: [...excluded],
                recentServedIds: [...recentServed],
                limit: EVENT_DETAIL_CONTINUATION_LIMIT,
                maxSameCategory: 3,
                maxSameVenue: 2,
              })
            : (isPersonal ? profileRanked : genericRanked)
                .filter((item) => !excluded.has(asId(item.event_id)));
          const ranked = collapseRankedOccurrenceFamilies(rankedBeforeOccurrenceCollapse)
            .slice(0, isEventDetail ? EVENT_DETAIL_CONTINUATION_LIMIT : PERSONAL_FEED_RENDER_LIMIT);
          if (!ranked.length) {
            if (isEventDetail) {
              section.hidden = false;
              section.dataset.personalFeedMode = 'unavailable';
              if (status) status.textContent = 'Других подходящих событий пока нет — откройте все анонсы.';
            } else {
              section.hidden = true;
            }
            personalFeedStores.delete(section);
            return;
          }
          slot.innerHTML = '';
          personalFeedStores.set(section, { items: ranked, ranked, rendered: 0, profile, manifest });
          section.hidden = false;
          section.dataset.personalFeedReady = 'true';
          section.dataset.personalFeedMode = isPersonal ? 'personal' : 'popular_fallback';
          if (isEventDetail && title) title.textContent = isPersonal ? 'По вашим интересам' : 'Ещё события';
          if (isEventDetail && explanation) {
            explanation.textContent = isPersonal
              ? 'Подборка учитывает ваши лайки и отметки «Не интересно» на этом устройстве.'
              : 'Шесть разных событий без бесконечной ленты.';
          }
          if (status) status.hidden = true;
          if (refresh) refresh.hidden = true;
          if (loadMore) loadMore.hidden = isEventDetail;
          const rendered = appendPersonalFeedChunk(section);
          if (isEventDetail && rendered > 0) recordRecentContinuation(personalFeedCurrentEventId(section), ranked);
        }

        async function hydratePersonalFeedSlots({ force = false, sections = null } = {}) {
          const candidates = (sections || Array.from(document.querySelectorAll('[data-personal-feed-section]')).filter((section) => personalFeedReached.has(section)))
            .filter(personalFeedSectionCanHydrate);
          for (const section of candidates) {
            const manifest = await getPersonalFeedManifest(section, { force });
            if (personalFeedSectionCanHydrate(section)) renderPersonalFeedSection(section, manifest);
          }
        }

        function startPersonalFeedHydration(section, { eager = false } = {}) {
          if (!section || personalFeedReached.has(section) || personalFeedHydrationInFlight.has(section) || !personalFeedSectionCanHydrate(section)) return;
          const hydrateOnce = () => {
            if (personalFeedReached.has(section) || personalFeedHydrationInFlight.has(section) || !personalFeedSectionCanHydrate(section)) return;
            personalFeedHydrationInFlight.add(section);
            void hydratePersonalFeedSlots({ sections: [section] }).then(() => {
              // A desktop-only section may cross the media-query boundary while
              // its manifest is in flight. Mark it consumed only if it is still
              // eligible; otherwise the next desktop transition must retry.
              if (personalFeedSectionCanHydrate(section)) personalFeedReached.add(section);
            }).finally(() => {
              personalFeedHydrationInFlight.delete(section);
            });
          };
          if (eager) {
            hydrateOnce();
            return;
          }
          const context = section.dataset.listingContext || '';
          const target = context === 'event-detail'
            ? visibleHideStickyMarker()
            : document.querySelector('main');
          if (!target || !('IntersectionObserver' in window)) {
            const idleLoad = window.requestIdleCallback || ((callback) => setTimeout(callback, 900));
            idleLoad(hydrateOnce);
            return;
          }
          const observer = new IntersectionObserver((entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            hydrateOnce();
          }, { rootMargin: '320px 0px 320px 0px', threshold: 0.01 });
          observer.observe(target);
        }

        function initializePersonalFeedObservers() {
          const sections = Array.from(document.querySelectorAll('[data-personal-feed-section]'));
          sections.forEach((section) => startPersonalFeedHydration(section));
          const desktopOnlySections = sections.filter((section) => section.dataset.personalFeedDesktopOnly === 'true');
          personalFeedDesktopMedia?.addEventListener?.('change', (event) => {
            if (!event.matches) return;
            desktopOnlySections.forEach((section) => startPersonalFeedHydration(section, { eager: true }));
          });
        }

        async function ensureDiscoveryStore(feed) {
          const existing = discoveryStores.get(feed);
          if (existing) return existing;
          const source = feed.dataset.discoverySrc;
          const store = { manifest: null, ranked: [], fetched: false, autoLoaded: false };
          discoveryStores.set(feed, store);
          if (!source) return store;
          try {
            const response = await fetch(source, { headers: { Accept: 'application/json' } });
            if (!response.ok) return store;
            const payload = await response.json();
            store.manifest = normalizeManifest(payload, feed);
            store.fetched = true;
          } catch (_) {
            store.fetched = false;
          }
          return store;
        }

        function candidateById(store, eventId) {
          const id = asId(eventId);
          const ranked = toArray(store?.ranked || store?.items).find((item) => asId(item?.event_id) === id);
          if (ranked?.candidate) return ranked.candidate;
          return [...toArray(store?.manifest?.related_static), ...toArray(store?.manifest?.related_adjacent)]
            .find((candidate) => asId(candidateId(candidate)) === id) || null;
        }

        function contextForFeed(feed, manifest, profile, algorithmId) {
          const width = Number(window.innerWidth || 1024);
          return {
            anonId: profile && profile.anon_id || null,
            sessionId: profile && profile.session_id || null,
            viewportClass: viewportClass(width),
            layoutMode: relatedLayoutMode(),
            presentationMode: relatedPresentationMode(width),
            surface: SURFACE_EVENT_DETAIL_RELATED,
            currentEventId: currentEventId(manifest) || Number(feed?.dataset.currentEventId || 0),
            algorithmId,
            servedListId: null,
            servedListHash: null,
          };
        }

        function createServedListHash(ranked, manifest, context, profile) {
          return stableHash({
            surface: SURFACE_EVENT_DETAIL_RELATED,
            current_event_id: currentEventId(manifest),
            algorithm_id: context.algorithmId,
            profile_version: profile && profile.profile_version,
            feature_schema_version: profile && profile.feature_schema_version,
            taxonomy_version: profile && profile.taxonomy_version,
            event_ids: ranked.map((item) => item.event_id),
          });
        }

        function createServedListSummary(ranked, manifest, context) {
          return {
            event_kind: 'served_list_summary',
            served_list_id: context.servedListId || randomId('served'),
            served_list_hash: context.servedListHash || null,
            anon_id: context.anonId || null,
            session_id: context.sessionId || null,
            surface: SURFACE_EVENT_DETAIL_RELATED,
            viewport_class: context.viewportClass,
            layout_mode: context.layoutMode,
            presentation_mode: context.presentationMode,
            current_event_id: currentEventId(manifest),
            algorithm_id: context.algorithmId,
            shown: ranked.map((item) => ({
              event_id: item.event_id,
              rank: item.rank,
              base_similarity: item.base_similarity,
              personal_score: item.personal_score,
              reason_codes: toArray(item.reason_codes).slice(0, 8),
            })),
          };
        }

        function createStrongAction(kind, item, context, extra = {}) {
          return {
            event_kind: kind,
            event_id: item && item.event_id != null ? item.event_id : null,
            rank: item && item.rank != null ? item.rank : null,
            served_list_id: context?.servedListId || null,
            served_list_hash: context?.servedListHash || null,
            surface: SURFACE_EVENT_DETAIL_RELATED,
            viewport_class: context?.viewportClass || viewportClass(window.innerWidth || 1024),
            layout_mode: context?.layoutMode || relatedLayoutMode(),
            presentation_mode: context?.presentationMode || relatedPresentationMode(window.innerWidth || 1024),
            algorithm_id: context?.algorithmId || LOCAL_FALLBACK_ALGORITHM_ID,
            ...extra,
          };
        }

        function appendLog(entry, profile, context) {
          if (!isCompatibleProfile(profile)) return;
          const log = readJson(LOG_KEY, []);
          log.push({
            profile_id: profile.anon_id,
            anon_id: profile.anon_id,
            session_id: profile.session_id,
            page: location.pathname,
            ts: new Date().toISOString(),
            ...entry,
            ...(context || {}),
          });
          writeJson(LOG_KEY, log.slice(-MAX_LOG));
        }

        function formatCount(value) {
          const number = Number(value || 0);
          return number > 0 ? String(number) : '';
        }

        const RU_MONTHS_CLIENT = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
        function formatDateForUi(value) {
          const raw = String(value || '').trim();
          const match = /^(\d{4})-(\d{2})-(\d{2})$/u.exec(raw);
          if (!match) return raw;
          const year = Number(match[1]);
          const month = Number(match[2]);
          const day = Number(match[3]);
          if (!month || month < 1 || month > 12) return raw;
          const currentYear = Number(document.body?.dataset.currentYear || new Date().getFullYear());
          return `${day} ${RU_MONTHS_CLIENT[month - 1]}${year !== currentYear ? ` ${year}` : ''}`;
        }

        function normalizeDisplayCandidate(item) {
          const candidate = item && item.candidate ? item.candidate : item;
          const display = displayOf(candidate);
          const reviewedAsset = window.KenigEventsRelatedCardPrimaryImageAsset?.(candidate);
          const id = candidateId(candidate);
          const title = candidate?.title || display.title || 'Событие';
          const reviewedImageUrl = reviewedAsset?.src?.startsWith('/assets/')
            ? `${CURRENT_BASE_PATH}${reviewedAsset.src}`
            : reviewedAsset?.src;
          return {
            id,
            title,
            href: rebaseInternalEventUrl(display.href || candidate?.href || '#'),
            absolute_url: rebaseInternalEventUrl(display.absolute_url || candidate?.absolute_url || display.href || candidate?.href || location.href, { absolute: true }),
            event_type: display.event_type || candidate?.category || 'событие',
            image_url: reviewedImageUrl || display.image_url || null,
            image_alt: display.image_alt || `Афиша события «${title}»`,
            image_text_mode: reviewedAsset?.image_text_mode || display.image_text_mode || candidate?.image_text_mode || 'unknown',
            image_media_role: reviewedAsset?.media_role || display.image_media_role || candidate?.image_media_role || 'unknown_document',
            image_width: Number(reviewedAsset?.width || display.image_width || candidate?.image_width || 0),
            image_height: Number(reviewedAsset?.height || display.image_height || candidate?.image_height || 0),
            image_review_evidence: reviewedAsset?.listing_crop_evidence || '',
            focal_y: Number.isFinite(Number(display.focal_y)) ? Math.max(0, Math.min(1, Number(display.focal_y))) : 0.5,
            display_date: display.display_date || formatDateForUi(candidate?.date || ''),
            display_time: display.display_time || null,
            display_date_time: display.display_date_time || [display.display_date || formatDateForUi(candidate?.date || ''), display.display_time].filter(Boolean).join(' · '),
            occurrence_aria_label: display.occurrence_aria_label || display.display_date_time || [display.display_date || formatDateForUi(candidate?.date || ''), display.display_time].filter(Boolean).join(' · '),
            occurrence_member_ids: toArray(display.occurrence_member_ids).map(Number).filter(Number.isFinite),
            city: display.city || candidate?.city || null,
            venue_name: display.venue_name || candidate?.location_name || null,
            place: display.place || [display.city || candidate?.city, display.venue_name || candidate?.location_name].filter(Boolean).join(' · '),
            status_label: display.status_label || candidate?.status || '',
            price_label: display.price_label || null,
            likes_count: Number(display.likes_count || 0),
            shares_count: Number(display.shares_count || 0),
            calendar_href: rebaseInternalEventUrl(display.calendar_href || candidate?.calendar_href || '#'),
            calendar_eligible: Boolean(display.calendar_eligible || candidate?.calendar_eligible),
            calendar_expiry_day: calendarExpiryDayFromIso(display.end_date || candidate?.end_date || candidate?.date || ''),
            rank: item && item.rank != null ? item.rank : '',
            personal_score: item && item.personal_score != null ? item.personal_score : '',
          };
        }

        function setRuntimeCardText(card, selector, value, { hideWhenEmpty = false } = {}) {
          const node = card.querySelector(selector);
          if (!node) return;
          const text = String(value == null ? '' : value);
          node.textContent = text;
          if (hideWhenEmpty) node.hidden = !text.trim();
        }

        function safeRuntimeCardUrl(value, fallback = '#') {
          const raw = typeof value === 'string' ? value.trim() : '';
          if (!raw || raw === '#') return fallback;
          try {
            const parsed = new URL(raw, location.href);
            return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? raw : fallback;
          } catch (_) {
            return fallback;
          }
        }

        function runtimeEventCardTemplate(variant) {
          const cardVariant = variant === 'overlay-controls' ? 'overlay-controls' : 'split-actions';
          return document.querySelector(`template[data-event-card-template="${cardVariant}"]`);
        }

        function setRuntimeCardDataset(node, key, value) {
          if (!node) return;
          node.dataset[key] = String(value == null ? '' : value);
        }

        function createEventCardElement(item, variant = 'split-actions', relatedLayout = null) {
          const data = normalizeDisplayCandidate(item);
          const relatedGridLayout = relatedLayout && relatedLayout.presentation !== 'flow';
          const cardVariant = variant === 'overlay-controls' ? 'overlay-controls' : 'split-actions';
          const template = runtimeEventCardTemplate(cardVariant);
          const sourceCard = template?.content?.querySelector('[data-event-card]');
          if (!sourceCard) return null;
          const card = sourceCard.cloneNode(true);
          const documentMedia = relatedLayout ? relatedLayout.mediaKind === 'document' : data.image_text_mode !== 'visual_only';
          const likes = Number(data.likes_count || 0);
          const shares = Number(data.shares_count || 0);
          const status = data.price_label || data.status_label || '';
          const typeTag = String(data.event_type || '').trim().replace(/\s+/gu, ' ').toLowerCase();
          const href = safeRuntimeCardUrl(data.href);
          const absoluteUrl = safeRuntimeCardUrl(data.absolute_url, location.href);
          const imageUrl = safeRuntimeCardUrl(data.image_url || '', '');
          const calendarHref = safeRuntimeCardUrl(data.calendar_href || '', '');
          const shareText = [data.title, [data.display_date_time, data.venue_name || data.city].filter(Boolean).join(' · '), status].filter(Boolean).join('\n');
          const shareImageType = imageUrl.toLowerCase().includes('.webp')
            ? 'image/webp'
            : /\.png(?:[?#]|$)/u.test(imageUrl.toLowerCase()) ? 'image/png' : 'image/jpeg';

          card.className = `event-card event-card--${cardVariant}`;
          setRuntimeCardDataset(card, 'feedCardVariant', cardVariant);
          setRuntimeCardDataset(card, 'calendarEligible', data.calendar_eligible ? 'true' : 'false');
          setRuntimeCardDataset(card, 'eventId', data.id);
          setRuntimeCardDataset(card, 'eventTitle', data.title);
          setRuntimeCardDataset(card, 'cardHref', href);
          setRuntimeCardDataset(card, 'occurrenceMemberIds', data.occurrence_member_ids.join(','));
          setRuntimeCardDataset(card, 'rank', data.rank);
          setRuntimeCardDataset(card, 'score', data.personal_score);
          card.setAttribute('aria-label', `${data.title}: ${data.display_date}`);

          const mediaLink = card.querySelector('[data-card-media-link]');
          if (mediaLink) {
            mediaLink.setAttribute('href', href);
            mediaLink.setAttribute('aria-label', `Открыть событие: ${data.title}`);
          }
          const mediaShell = card.querySelector('[data-card-media-shell]');
          const image = card.querySelector('[data-card-image]');
          const mediaRatio = data.image_width > 0 && data.image_height > 0
            ? `${Math.max(1, data.image_width)} / ${Math.max(1, data.image_height)}`
            : '4 / 5';
          const rowRatio = relatedLayout ? Number(relatedLayout.rowRatio).toFixed(5) : mediaRatio;
          const focalOffset = Math.max(-12, Math.min(12, (0.5 - data.focal_y) * 24));
          if (mediaShell) {
            mediaShell.className = [
              'event-card__media-shell',
              'event-card__media-shell--dynamic',
              documentMedia ? 'event-card__media-shell--document' : 'event-card__media-shell--cover',
              imageUrl ? 'is-image-loading' : 'event-card__fallback',
            ].join(' ');
            mediaShell.dataset.mediaRole = data.image_media_role;
            mediaShell.style.cssText = '';
            mediaShell.style.setProperty('--dynamic-media-ratio', rowRatio);
            mediaShell.style.setProperty('--card-focal-y', String(data.focal_y));
            mediaShell.style.setProperty('--card-focal-offset', `${focalOffset}%`);
            if (imageUrl) {
              mediaShell.setAttribute('aria-busy', 'true');
              mediaShell.removeAttribute('aria-hidden');
            } else {
              mediaShell.removeAttribute('aria-busy');
              mediaShell.setAttribute('aria-hidden', 'true');
            }
          }
          setRuntimeCardText(card, '[data-card-fallback-date]', data.display_date);
          setRuntimeCardText(card, '[data-card-fallback-type]', data.event_type || 'событие');
          setRuntimeCardText(card, '[data-card-fallback-city]', data.city || '', { hideWhenEmpty: true });
          if (image) {
            image.hidden = !imageUrl;
            const authoritativeFit = relatedLayout
              ? (relatedLayout.fit === 'cover' ? 'cover' : 'contain')
              : (documentMedia ? 'contain' : 'cover');
            image.style.objectFit = authoritativeFit;
            image.style.objectPosition = relatedLayout?.objectPosition || '50% 50%';
            setRuntimeCardDataset(image, 'cardAuthoritativeFit', authoritativeFit);
            setRuntimeCardDataset(image, 'protectedCropFit', authoritativeFit);
            setRuntimeCardDataset(image, 'protectedCropReason', relatedLayout?.cropReason || 'responsive_target_unknown');
            setRuntimeCardDataset(image, 'cardMediaReview', data.image_review_evidence);
            const reconcileNaturalAspect = relatedLayout?.useNaturalAspect
              ? "if(shell&&this.naturalWidth>0&&this.naturalHeight>0){shell.style.setProperty('--dynamic-media-ratio',this.naturalWidth+' / '+this.naturalHeight);shell.dataset.naturalAspectReconciled='true';}"
              : '';
            // Search serializes the canonical cloned card to HTML; retain the
            // load reconciliation in markup rather than a lost property listener.
            image.setAttribute('onload', `const shell=this.closest('[data-card-media-shell]');${reconcileNaturalAspect}shell?.classList.remove('is-image-loading');shell?.classList.add('is-image-loaded');shell?.removeAttribute('aria-busy');`);
            if (imageUrl) {
              image.setAttribute('src', imageUrl);
              image.setAttribute('alt', data.image_alt);
              if (data.image_width > 0) image.setAttribute('width', String(data.image_width));
              else image.removeAttribute('width');
              if (data.image_height > 0) image.setAttribute('height', String(data.image_height));
              else image.removeAttribute('height');
            } else {
              image.removeAttribute('src');
              image.removeAttribute('width');
              image.removeAttribute('height');
              image.setAttribute('alt', '');
            }
          }

          const title = card.querySelector('[data-card-title]');
          if (title) {
            title.textContent = data.title;
            title.setAttribute('href', href);
          }
          setRuntimeCardText(card, '[data-card-type]', typeTag, { hideWhenEmpty: true });
          setRuntimeCardText(card, '[data-card-meta]', data.display_date_time);
          const cardMeta = card.querySelector('[data-card-meta]');
          if (cardMeta && data.occurrence_aria_label) cardMeta.setAttribute('aria-label', data.occurrence_aria_label);
          setRuntimeCardText(card, '[data-card-status]', status, { hideWhenEmpty: true });
          setRuntimeCardText(card, '[data-card-place]', data.place, { hideWhenEmpty: true });

          card.querySelectorAll('[data-feedback-action="not_interested"]').forEach((button) => {
            setRuntimeCardDataset(button, 'eventId', data.id);
            setRuntimeCardDataset(button, 'eventTitle', data.title);
            button.setAttribute('aria-pressed', 'false');
            button.setAttribute('aria-label', `Не интересно: ${data.title}`);
          });
          card.querySelectorAll('[data-feedback-action="like"]').forEach((button) => {
            setRuntimeCardDataset(button, 'eventId', data.id);
            setRuntimeCardDataset(button, 'eventTitle', data.title);
            setRuntimeCardDataset(button, 'baseCount', likes);
            button.setAttribute('aria-pressed', 'false');
            button.setAttribute('aria-label', likes > 0 ? `Поставить лайк: ${data.title}. Сейчас ${likes}` : `Поставить лайк: ${data.title}`);
            setRuntimeCardText(button, '[data-feedback-count]', formatCount(likes));
          });
          card.querySelectorAll('[data-native-share]').forEach((button) => {
            setRuntimeCardDataset(button, 'shareEventId', data.id);
            setRuntimeCardDataset(button, 'shareEventTitle', data.title);
            setRuntimeCardDataset(button, 'shareBaseCount', shares);
            setRuntimeCardDataset(button, 'shareTitle', data.title);
            setRuntimeCardDataset(button, 'shareText', shareText);
            setRuntimeCardDataset(button, 'shareUrl', absoluteUrl);
            setRuntimeCardDataset(button, 'shareImage', imageUrl);
            setRuntimeCardDataset(button, 'shareImageType', shareImageType);
            setRuntimeCardDataset(button, 'shareImageTextMode', data.image_text_mode || 'unknown');
            setRuntimeCardDataset(button, 'shareBrandImage', `${CURRENT_BASE_PATH}/brand/announcements-wordmark-ui.svg`);
            setRuntimeCardDataset(button, 'shareFileName', `kenigevents-${data.id}`);
            setRuntimeCardDataset(button, 'shareDateTime', data.display_date_time);
            setRuntimeCardDataset(button, 'sharePlace', data.venue_name || data.city || '');
            setRuntimeCardDataset(button, 'shareAdmission', status);
            button.setAttribute('aria-label', `Поделиться событием: ${data.title}`);
            setRuntimeCardText(button, '[data-share-count]', formatCount(shares));
          });
          card.querySelectorAll('[data-calendar-action]').forEach((link) => {
            const calendarAvailable = Boolean(data.calendar_eligible && calendarHref);
            link.hidden = !calendarAvailable;
            link.setAttribute('href', calendarAvailable ? calendarHref : '#');
            setRuntimeCardDataset(link, 'calendarEventId', data.id);
            setRuntimeCardDataset(link, 'calendarExpiryDay', data.calendar_expiry_day);
            setRuntimeCardDataset(link, 'calendarEventTitle', data.title);
            link.setAttribute('aria-label', `Добавить в календарь: ${data.title}`);
          });
          card.querySelectorAll('.event-card__feedback').forEach((group) => group.setAttribute('aria-label', `Оценить событие: ${data.title}`));
          card.querySelectorAll('.event-card__utility-row').forEach((group) => group.setAttribute('aria-label', `Дополнительные действия: ${data.title}`));

          const relatedKeys = ['labRelatedCard', 'labMediaKind', 'labMediaRatio', 'labRowMedia', 'labRowIndex', 'labRowColumn', 'labMediaTreatment', 'labCoverCrop', 'labPotentialCoverCrop', 'labRowWorstCrop', 'labRowCost'];
          for (const key of relatedKeys) delete card.dataset[key];
          delete card.dataset.cardMediaPresentation;
          delete card.dataset.cardMediaTreatment;
          card.style.removeProperty('--lab-row-media-ratio');
          card.style.removeProperty('grid-row');
          card.style.removeProperty('grid-column');
          if (relatedGridLayout) {
            setRuntimeCardDataset(card, 'labRelatedCard', 'true');
            setRuntimeCardDataset(card, 'labMediaKind', relatedLayout.mediaKind);
            setRuntimeCardDataset(card, 'labMediaRatio', Number(relatedLayout.mediaRatio).toFixed(5));
            setRuntimeCardDataset(card, 'labRowMedia', relatedLayout.rowMode);
            setRuntimeCardDataset(card, 'labRowIndex', relatedLayout.rowIndex);
            setRuntimeCardDataset(card, 'labRowColumn', relatedLayout.rowColumn);
            setRuntimeCardDataset(card, 'labMediaTreatment', relatedLayout.mediaTreatment);
            setRuntimeCardDataset(card, 'labCoverCrop', Number(relatedLayout.coverCrop).toFixed(4));
            setRuntimeCardDataset(card, 'labPotentialCoverCrop', Number(relatedLayout.potentialCoverCrop).toFixed(4));
            setRuntimeCardDataset(card, 'labRowWorstCrop', Number(relatedLayout.rowWorstCrop).toFixed(4));
            setRuntimeCardDataset(card, 'labRowCost', Number(relatedLayout.rowCost).toFixed(5));
            card.style.setProperty('--lab-row-media-ratio', Number(relatedLayout.rowRatio).toFixed(5));
            card.style.setProperty('grid-row', String(Number(relatedLayout.rowIndex) + 1));
            card.style.setProperty('grid-column', String(Number(relatedLayout.rowColumn) + 1));
          } else if (relatedLayout) {
            // Search borrows only the donor media decision. Its ranked feed is
            // normal document flow, so never serialize recommendation-grid
            // placement or data-lab-related-card onto these cards.
            setRuntimeCardDataset(card, 'cardMediaPresentation', 'flow');
            setRuntimeCardDataset(card, 'cardMediaTreatment', relatedLayout.mediaTreatment);
          }
          return card;
        }

        function appendEventCard(target, item, variant = 'split-actions', relatedLayout = null) {
          const card = createEventCardElement(item, variant, relatedLayout);
          if (!card) return false;
          target.appendChild(card);
          return true;
        }

        window.KenigEventsCreateEventCard = createEventCardElement;
        // Compatibility for the authorized-search surface: its result container
        // still accepts a string, but the serialized tree is cloned from and
        // safely populated through the canonical EventCard component template.
        window.KenigEventsRenderEventCard = (...args) => createEventCardElement(...args)?.outerHTML || '';
        function visibleFeedCardCount(feed) {
          return Array.from(feed.querySelectorAll(':scope > [data-event-card]')).filter((card) => !card.hidden).length;
        }

        function eventState(profile, eventId) {
          const id = asId(eventId);
          if (!profile || !id) return { liked: false, not_interested: false, shares: 0 };
          return {
            liked: likedSet(profile).has(id),
            not_interested: hiddenSet(profile).has(id),
            shares: Number((profile.share_counts || {})[id] || 0),
          };
        }

        function setMembership(profile, field, eventId, enabled) {
          const id = asId(eventId);
          const set = new Set(toArray(profile[field]).map(asId).filter(Boolean));
          if (enabled) set.add(id);
          else set.delete(id);
          profile[field] = Array.from(set);
        }

        function bumpTagMap(map, tags, delta) {
          const next = { ...(map || {}) };
          for (const tag of unique(tags).slice(0, 8)) {
            const value = Math.max(0, Math.min(5, mapScore(next, tag) + delta));
            if (value > 0) next[tag] = Number(value.toFixed(3));
            else delete next[tag];
          }
          return next;
        }

        function updateProfileForAction(profile, eventId, action, candidate) {
          const next = { ...profile, share_counts: { ...(profile.share_counts || {}) } };
          const tags = candidatePositiveMatchingTags(candidate);
          if (action === 'like_event') {
            setMembership(next, 'liked_event_ids', eventId, true);
            setMembership(next, 'not_interested_event_ids', eventId, false);
            setMembership(next, 'hidden_event_ids', eventId, false);
            next.positive_tags = bumpTagMap(next.positive_tags, tags, 0.45);
          } else if (action === 'unlike_event') {
            setMembership(next, 'liked_event_ids', eventId, false);
          } else if (action === 'not_interested') {
            setMembership(next, 'not_interested_event_ids', eventId, true);
            setMembership(next, 'hidden_event_ids', eventId, true);
            setMembership(next, 'liked_event_ids', eventId, false);
            next.negative_interest_tags = bumpTagMap(next.negative_interest_tags, tags, 0.7);
          } else if (action === 'undo_not_interested') {
            setMembership(next, 'not_interested_event_ids', eventId, false);
            setMembership(next, 'hidden_event_ids', eventId, false);
            next.negative_interest_tags = bumpTagMap(next.negative_interest_tags, tags, -0.35);
          } else if (action === 'share_event') {
            const id = asId(eventId);
            next.share_counts[id] = Number(next.share_counts[id] || 0) + 1;
          }
          next.updated_at = new Date().toISOString();
          return next;
        }

        function hideLikeShareCallouts() {
          window.clearTimeout(shareCalloutTimer);
          shareCalloutTimer = 0;
          document.querySelectorAll('[data-event-card].is-share-prompt').forEach((card) => {
            card.classList.remove('is-share-prompt');
          });
        }

        function showLikeShareCallout(card) {
          if (!card) return;
          let count = 0;
          try { count = Number(sessionStorage.getItem(SHARE_PROMPT_KEY) || '0'); } catch (_) {}
          if (count >= MAX_SHARE_PROMPTS_PER_SESSION) return;
          const shareButton = card.querySelector('.feedback-button--share');
          if (!shareButton) return;
          hideLikeShareCallouts();
          card.classList.add('is-share-prompt');
          try { sessionStorage.setItem(SHARE_PROMPT_KEY, String(count + 1)); } catch (_) {}
          shareCalloutTimer = window.setTimeout(() => {
            card.classList.remove('is-share-prompt');
          }, 4000);
        }

        function animateLikeBurst(card) {
          if (!card) return;
          card.querySelectorAll('.like-burst').forEach((node) => node.remove());
          const burst = document.createElement('span');
          burst.className = 'like-burst';
          burst.setAttribute('aria-hidden', 'true');
          for (let index = 0; index < 4; index += 1) {
            const heart = document.createElement('span');
            heart.textContent = '♥';
            burst.appendChild(heart);
          }
          card.appendChild(burst);
          setTimeout(() => burst.remove(), 950);
        }

        function cardRankedItem(card, store) {
          const id = asId(card?.dataset.eventId);
          return toArray(store?.ranked || store?.items).find((item) => asId(item.event_id) === id) || null;
        }

        function contextForCard(card) {
          const feed = card?.closest('[data-discovery-feed], [data-personal-feed-slot]');
          const summary = feed ? servedListByFeed.get(feed) : null;
          return {
            servedListId: summary?.served_list_id || null,
            servedListHash: summary?.served_list_hash || null,
            viewportClass: summary?.viewport_class || viewportClass(window.innerWidth || 1024),
            layoutMode: summary?.layout_mode || relatedLayoutMode(),
            presentationMode: summary?.presentation_mode || relatedPresentationMode(window.innerWidth || 1024),
            algorithmId: summary?.algorithm_id || feed?.dataset.effectiveAlgorithmId || LOCAL_FALLBACK_ALGORITHM_ID,
          };
        }

        function syncNotInterestedPlate(card, current) {
          if (!card || !card.matches('[data-event-card]')) return;
          let plate = card.querySelector('[data-not-interested-plate]');
          if (current.not_interested && !card.hidden) {
            if (!plate) {
              plate = document.createElement('div');
              plate.className = 'event-card__not-interest-plate';
              plate.dataset.notInterestedPlate = 'true';
              plate.setAttribute('data-nosnippet', '');
              const text = document.createElement('span');
              text.textContent = 'Вы пометили: не интересует';
              const undo = document.createElement('button');
              undo.type = 'button';
              undo.dataset.feedbackAction = 'not_interested';
              undo.dataset.eventId = card.dataset.eventId || '';
              undo.dataset.eventTitle = card.dataset.eventTitle || '';
              undo.textContent = 'Отменить';
              plate.append(text, undo);
              card.appendChild(plate);
            }
            const undo = plate.querySelector('[data-feedback-action="not_interested"]');
            if (undo) {
              undo.dataset.eventId = card.dataset.eventId || '';
              undo.dataset.eventTitle = card.dataset.eventTitle || '';
              undo.setAttribute('aria-label', `Отменить отметку “не интересно”: ${card.dataset.eventTitle || 'событие'}`);
            }
          } else if (plate) {
            plate.remove();
          }
        }

        function syncCardsFeedbackState(profile) {
          document.querySelectorAll('[data-event-card], [data-feedback-scope]').forEach((card) => {
            const eventId = card.dataset.eventId;
            const current = eventState(profile, eventId);
            card.classList.toggle('is-liked', Boolean(current.liked));
            if (card.matches('[data-event-card]')) {
              card.classList.toggle('is-not-interested', Boolean(current.not_interested) && !card.hidden);
              syncNotInterestedPlate(card, current);
            }
            card.querySelectorAll('[data-feedback-action="like"]').forEach((button) => {
              const base = Number(button.dataset.baseCount || '0');
              const localLike = current.liked ? 1 : 0;
              button.setAttribute('aria-pressed', current.liked ? 'true' : 'false');
              const total = base + localLike;
              const title = card.dataset.eventTitle || 'событие';
              button.setAttribute('aria-label', total > 0 ? `${current.liked ? 'Убрать лайк' : 'Поставить лайк'}: ${title}. Сейчас ${total}` : `${current.liked ? 'Убрать лайк' : 'Поставить лайк'}: ${title}`);
              const count = button.querySelector('[data-feedback-count]');
              if (count) count.textContent = formatCount(total);
            });
            card.querySelectorAll('[data-share-count]').forEach((count) => {
              const shareButton = count.closest('[data-native-share]');
              const base = Number(shareButton?.dataset.shareBaseCount || '0');
              count.textContent = formatCount(base + Number(current.shares || 0));
            });
            card.querySelectorAll('[data-feedback-action="not_interested"]').forEach((button) => {
              button.setAttribute('aria-pressed', current.not_interested ? 'true' : 'false');
              const title = current.not_interested ? 'Вернуть в рекомендации' : 'Не интересно';
              button.setAttribute('aria-label', `${title}: ${card.dataset.eventTitle || 'событие'}`);
            });
          });
          syncCalendarControls();
        }

        function cardEligibleAfterProfile(card, store, profile, anchorEventId) {
          if (!profile) return true;
          const id = asId(card.dataset.eventId);
          const isCurrentPagePlate = sessionPinnedNotInterested.has(id) || asId(anchorEventId) === id;
          if (hiddenSet(profile).has(id)) return isCurrentPagePlate;
          const candidate = candidateById(store, id);
          if (candidate && negativeInterestPenalty(candidate, profile) >= NEGATIVE_HARD_FILTER_THRESHOLD) return false;
          return true;
        }

        function reorderExistingCards(feed, ranked, anchorEventId) {
          const cards = Array.from(feed.querySelectorAll(':scope > [data-event-card]'));
          const rankMap = new Map(ranked.map((item) => [asId(item.event_id), item.rank]));
          const sortCards = (items) => items.sort((a, b) => {
            const ar = rankMap.has(asId(a.dataset.eventId)) ? rankMap.get(asId(a.dataset.eventId)) : 9999;
            const br = rankMap.has(asId(b.dataset.eventId)) ? rankMap.get(asId(b.dataset.eventId)) : 9999;
            return ar - br;
          });
          if (anchorEventId != null) {
            const anchorIndex = cards.findIndex((card) => asId(card.dataset.eventId) === asId(anchorEventId));
            if (anchorIndex >= 0) {
              const frozen = cards.slice(0, anchorIndex + 1);
              const tail = sortCards(cards.slice(anchorIndex + 1));
              [...frozen, ...tail].forEach((card) => feed.appendChild(card));
              return;
            }
          }
          sortCards(cards).forEach((card) => feed.appendChild(card));
        }

        function appendDiscoveryEvents(feed, store, count) {
          const profile = activeProfile(store.manifest);
          const existingIds = new Set(Array.from(feed.querySelectorAll(':scope > [data-event-card]')).map((card) => asId(card.dataset.eventId)));
          let added = 0;
          for (const item of toArray(store.ranked)) {
            if (added >= count) break;
            const id = asId(item.event_id);
            if (!id || existingIds.has(id)) continue;
            if (!isEligibleCandidate(item.candidate, store.manifest, profile)) continue;
            if (!appendEventCard(feed, item, feed.dataset.feedCardVariant || 'split-actions')) continue;
            existingIds.add(id);
            added += 1;
          }
          syncCardsFeedbackState(profile);
          return added;
        }

        function hasMoreCandidates(feed, store) {
          const profile = activeProfile(store.manifest);
          const existingIds = new Set(Array.from(feed.querySelectorAll(':scope > [data-event-card]')).map((card) => asId(card.dataset.eventId)));
          return toArray(store.ranked).some((item) => {
            const id = asId(item.event_id);
            return id && !existingIds.has(id) && isEligibleCandidate(item.candidate, store.manifest, profile);
          });
        }

        async function syncFeedWithManifest(feed, options = {}) {
          const button = feed.parentElement?.querySelector('[data-discovery-load-more]');
          const store = await ensureDiscoveryStore(feed);
          if (!store.manifest) {
            syncCardsFeedbackState(activeProfile());
            if (button) button.hidden = true;
            return;
          }
          const profile = activeProfile(store.manifest);
          const hasLocalProfile = Boolean(profile);
          const algorithmId = hasLocalProfile ? LOCAL_FALLBACK_ALGORITHM_ID : STATIC_ALGORITHM_ID;
          store.ranked = rankEventDetailRelated(store.manifest, profile, { maxSameCategory: 3, maxSameVenue: 2 });
          feed.dataset.effectiveAlgorithmId = algorithmId;
          feed.dataset.surface = SURFACE_EVENT_DETAIL_RELATED;
          feed.dataset.layoutMode = relatedLayoutMode();
          feed.dataset.presentationMode = relatedPresentationMode(window.innerWidth || 1024);
          feed.dataset.algorithmId = algorithmId;
          reorderExistingCards(feed, store.ranked, options.anchorEventId);
          feed.querySelectorAll(':scope > [data-event-card]').forEach((card) => {
            card.hidden = !cardEligibleAfterProfile(card, store, profile, options.anchorEventId);
            const item = cardRankedItem(card, store);
            if (item) {
              card.dataset.rank = String(item.rank);
              card.dataset.score = String(item.personal_score);
            }
          });
          if (options.automatic && !store.autoLoaded) {
            store.autoLoaded = true;
            const target = Number(store.manifest.preload_target || DEFAULT_PRELOAD_TARGET);
            while (visibleFeedCardCount(feed) < target) {
              const added = appendDiscoveryEvents(feed, store, 1);
              if (!added) break;
            }
          } else if (!options.automatic) {
            appendDiscoveryEvents(feed, store, Number(store.manifest.page_size || DEFAULT_PRELOAD_TARGET));
          }
          syncCardsFeedbackState(profile);
          const visibleRanked = Array.from(feed.querySelectorAll(':scope > [data-event-card]'))
            .filter((card) => !card.hidden)
            .map((card) => cardRankedItem(card, store))
            .filter(Boolean);
          const context = contextForFeed(feed, store.manifest, profile, algorithmId);
          context.servedListHash = createServedListHash(visibleRanked, store.manifest, context, profile);
          context.servedListId = randomId('served');
          const summary = createServedListSummary(visibleRanked, store.manifest, context);
          servedListByFeed.set(feed, summary);
          if (button) button.hidden = !hasMoreCandidates(feed, store);
        }

        async function hydrateDiscoveryFeeds({ automatic = false, anchorEventId = null } = {}) {
          const feeds = Array.from(document.querySelectorAll('[data-discovery-feed]'));
          for (const feed of feeds) {
            await syncFeedWithManifest(feed, { automatic, anchorEventId });
          }
        }

        async function applyFeedbackState(options = {}) {
          const profile = readProfile();
          syncCardsFeedbackState(profile);
          if (!options.skipDiscoveryHydration) {
            await hydrateDiscoveryFeeds({ automatic: true, anchorEventId: options.anchorEventId || null });
          }
          syncListingPersonalFilter();
          renderFeedbackReport();
        }

        window.applyFeedbackState = applyFeedbackState;

        async function controllerForCard(card) {
          const feed = card?.closest('[data-discovery-feed], [data-personal-feed-slot]');
          if (!feed) return { feed: null, store: null };
          if (feed.matches('[data-personal-feed-slot]')) {
            const section = feed.closest('[data-personal-feed-section]');
            return { feed, store: section ? personalFeedStores.get(section) || null : null };
          }
          return { feed, store: await ensureDiscoveryStore(feed) };
        }

        async function handleFeedbackButton(button) {
          const scope = button.closest('[data-event-card], [data-feedback-scope]');
          const eventId = button.dataset.eventId || scope?.dataset.eventId;
          if (!eventId) return;
          const card = button.closest('[data-event-card]');
          const { store } = await controllerForCard(card);
          const profile = activeProfile(store?.manifest);
          if (!profile) {
            requestConsent(() => handleFeedbackButton(button));
            return;
          }
          const candidate = store ? candidateById(store, eventId) : null;
          const current = eventState(profile, eventId);
          const title = button.dataset.eventTitle || scope?.dataset.eventTitle || '';
          let action = null;
          let shouldShowSharePrompt = false;
          if (button.dataset.feedbackAction === 'like') {
            const liked = !current.liked;
            action = liked ? 'like_event' : 'unlike_event';
            shouldShowSharePrompt = liked;
          } else if (button.dataset.feedbackAction === 'not_interested') {
            const notInterested = !current.not_interested;
            action = notInterested ? 'not_interested' : 'undo_not_interested';
            if (notInterested) sessionPinnedNotInterested.add(asId(eventId));
            else sessionPinnedNotInterested.delete(asId(eventId));
            hideLikeShareCallouts();
          }
          if (!action) return;
          const next = updateProfileForAction(profile, eventId, action, candidate);
          saveProfile(next);
          const context = contextForCard(card);
          const item = card && store ? cardRankedItem(card, store) : { event_id: Number(eventId), rank: null };
          appendLog(createStrongAction(action, item, context, { event_title: title, action }), next);
          await applyFeedbackState({ anchorEventId: eventId });
          if (action === 'like_event') {
            animateLikeBurst(document.querySelector(`[data-event-card][data-event-id="${CSS.escape(String(eventId))}"]`) || scope);
          }
          if (shouldShowSharePrompt) {
            showLikeShareCallout(document.querySelector(`[data-event-card][data-event-id="${CSS.escape(String(eventId))}"]`) || card);
          } else if (action === 'unlike_event') {
            hideLikeShareCallouts();
          }
        }

        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-feedback-action]');
          if (!button) return;
          event.preventDefault();
          event.stopPropagation();
          await handleFeedbackButton(button);
        });

        async function recordShare(button) {
          const scope = button.closest('[data-event-card], [data-feedback-scope]');
          const eventId = button.dataset.shareEventId || scope?.dataset.eventId;
          if (!eventId) return;
          const card = button.closest('[data-event-card]');
          const { store } = await controllerForCard(card);
          const profile = activeProfile(store?.manifest);
          if (!profile) return;
          const title = button.dataset.shareEventTitle || button.dataset.shareTitle || scope?.dataset.eventTitle || '';
          const candidate = store ? candidateById(store, eventId) : null;
          const next = updateProfileForAction(profile, eventId, 'share_event', candidate);
          saveProfile(next);
          const context = contextForCard(card);
          const item = card && store ? cardRankedItem(card, store) : { event_id: Number(eventId), rank: null };
          appendLog(createStrongAction('share_event', item, context, { event_title: title, action: 'share_event' }), next);
          await applyFeedbackState({ anchorEventId: eventId });
        }

        const shareStatusTimers = new Map();
        const shareStatusEpochs = new WeakMap();
        function showMobileActionToast(message, type = 'success', dedupeKey = 'mobile-action', announce = true) {
          if (!window.matchMedia('(max-width: 759px)').matches || !message) return;
          window.KenigEventsToast?.show?.({ message, type, dedupeKey, announce });
        }

        function setNativeShareStatus(button, message = '', isBusy = false) {
          const previousTimer = shareStatusTimers.get(button);
          if (previousTimer) window.clearTimeout(previousTimer);
          shareStatusTimers.delete(button);
          const epoch = Number(shareStatusEpochs.get(button) || 0) + 1;
          shareStatusEpochs.set(button, epoch);
          const label = button.querySelector('[data-share-label]') || button.querySelector('span') || button;
          const original = button.dataset.shareOriginalLabel || label.textContent || 'Поделиться';
          button.dataset.shareOriginalLabel = original;
          if (isBusy) {
            label.textContent = message || 'Готовим картинку…';
          } else {
            label.textContent = message || original;
          }
          button.disabled = Boolean(isBusy);
          if (!isBusy && message) {
            if (/не удалось|ошиб/iu.test(message)) showMobileActionToast(message, 'error', `share-${button.dataset.shareEventId || 'event'}`);
            else if (/поделились|скопирована/iu.test(message)) showMobileActionToast(message, 'success', `share-${button.dataset.shareEventId || 'event'}`);
            const resetTimer = window.setTimeout(() => {
              if (shareStatusEpochs.get(button) !== epoch) return;
              label.textContent = button.dataset.shareOriginalLabel || 'Поделиться';
            }, 2200);
            shareStatusTimers.set(button, resetTimer);
          }
        }

        function sharePayload(button, files = null) {
          const payload = {
            title: button.dataset.shareTitle || document.title,
            text: button.dataset.shareText || '',
          };
          if (files) payload.files = files;
          const url = button.dataset.shareUrl || location.href;
          if (url) payload.url = url;
          return payload;
        }

        function shareFileName(button, blob) {
          const raw = String(button.dataset.shareFileName || 'kenigevents-event').replace(/[^a-z0-9_-]+/giu, '-').replace(/^-+|-+$/gu, '').slice(0, 80) || 'kenigevents-event';
          const type = blob && blob.type || button.dataset.shareImageType || '';
          if (/png/iu.test(type)) return `${raw}.png`;
          if (/jpe?g/iu.test(type)) return `${raw}.jpg`;
          if (/webp/iu.test(type)) return `${raw}.webp`;
          return `${raw}.jpg`;
        }

        function wrapCanvasText(ctx, text, maxWidth, maxLines) {
          const words = String(text || '').split(/\s+/u).filter(Boolean);
          const lines = [];
          let line = '';
          for (const word of words) {
            const test = line ? `${line} ${word}` : word;
            if (ctx.measureText(test).width <= maxWidth || !line) {
              line = test;
            } else {
              lines.push(line);
              line = word;
              if (lines.length >= maxLines) break;
            }
          }
          if (line && lines.length < maxLines) lines.push(line);
          if (lines.length === maxLines && words.length) {
            const last = lines[maxLines - 1];
            if (ctx.measureText(`${last}…`).width > maxWidth) {
              let trimmed = last;
              while (trimmed.length > 8 && ctx.measureText(`${trimmed}…`).width > maxWidth) trimmed = trimmed.slice(0, -1);
              lines[maxLines - 1] = `${trimmed.trim()}…`;
            }
          }
          return lines;
        }

        function canvasBlob(canvas, type = 'image/png', quality = 0.92) {
          return new Promise((resolve) => canvas.toBlob(resolve, type, quality));
        }

        async function createGeneratedShareImage(button) {
          if (!document.createElement('canvas').getContext) return null;
          const canvas = document.createElement('canvas');
          canvas.width = 1080;
          canvas.height = 1350;
          const ctx = canvas.getContext('2d');
          if (!ctx) return null;
          const title = button.dataset.shareTitle || document.title;
          const dateTime = button.dataset.shareDateTime || '';
          const place = button.dataset.sharePlace || '';
          const admission = button.dataset.shareAdmission || '';
          const url = button.dataset.shareUrl || location.href;
          ctx.fillStyle = '#fff7ea';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          const gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
          gradient.addColorStop(0, '#793014');
          gradient.addColorStop(0.58, '#a54821');
          gradient.addColorStop(1, '#2f2118');
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, canvas.width, 470);
          ctx.fillStyle = 'rgba(255,253,248,0.15)';
          ctx.beginPath();
          ctx.arc(880, 130, 260, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#fffdf8';
          ctx.font = '900 54px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          ctx.fillText('Полюбить Калининград', 72, 112);
          ctx.font = '950 104px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          ctx.fillText('Анонсы', 72, 220);
          ctx.fillStyle = '#fff7ea';
          ctx.font = '850 34px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          ctx.fillText('событие, которым можно поделиться', 76, 310);
          ctx.fillStyle = '#30241b';
          ctx.font = '950 76px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          const titleLines = wrapCanvasText(ctx, title, 936, 4);
          let y = 590;
          titleLines.forEach((line) => {
            ctx.fillText(line, 72, y);
            y += 88;
          });
          const facts = [dateTime, place, admission].filter(Boolean);
          ctx.font = '850 40px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          facts.forEach((fact) => {
            ctx.beginPath();
            if (ctx.roundRect) ctx.roundRect(72, y - 42, 936, 64, 32);
            else ctx.rect(72, y - 42, 936, 64);
            ctx.fillStyle = 'rgba(121,48,20,0.08)';
            ctx.fill();
            ctx.fillStyle = '#4a2e20';
            ctx.fillText(fact, 104, y);
            y += 86;
          });
          ctx.fillStyle = '#793014';
          ctx.font = '900 34px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          ctx.fillText('Открыть страницу события:', 72, 1194);
          ctx.fillStyle = '#2f2118';
          ctx.font = '760 28px system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';
          wrapCanvasText(ctx, url, 936, 2).forEach((line, index) => ctx.fillText(line, 72, 1242 + index * 38));
          return canvasBlob(canvas, 'image/png', 0.92);
        }

        async function shareBlobAsImage(button, blob) {
          if (!blob || !window.File || !navigator.canShare || !('share' in navigator)) return false;
          const type = blob.type || 'image/png';
          const file = new File([blob], shareFileName(button, blob), { type });
          const dataWithImage = sharePayload(button, [file]);
          if (!navigator.canShare(dataWithImage)) return false;
          await navigator.share(dataWithImage);
          await recordShare(button);
          setNativeShareStatus(button, 'Поделились');
          return true;
        }

        async function fallbackNativeShare(button, reason) {
          const payload = sharePayload(button);
          const url = button.dataset.shareUrl || location.href;
          if ('share' in navigator) {
            await navigator.share(payload);
            await recordShare(button);
            setNativeShareStatus(button, reason ? 'Поделились ссылкой' : 'Поделились');
            return;
          }
          const copyText = [payload.text, url].filter(Boolean).join('\n');
          await navigator.clipboard.writeText(copyText || url);
          await recordShare(button);
          setNativeShareStatus(button, 'Ссылка скопирована');
        }

        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-native-share]');
          if (!button) return;
          event.preventDefault();
          event.stopPropagation();
          hideLikeShareCallouts();
          const imageUrl = button.dataset.shareImage || '';
          setNativeShareStatus(button, 'Готовим картинку…', true);
          try {
            if (imageUrl && window.File && navigator.canShare) {
              const response = await fetch(imageUrl, { mode: 'cors', credentials: 'omit' });
              if (response.ok) {
                const blob = await response.blob();
                if (button.dataset.shareImageTextMode === 'visual_only' && window.KenigEventsComposeEventShareImage) {
                  const composedBlob = await window.KenigEventsComposeEventShareImage({
                    sourceBlob: blob,
                    imageTextMode: button.dataset.shareImageTextMode,
                    title: button.dataset.shareTitle || document.title,
                    dateTime: button.dataset.shareDateTime || '',
                    place: button.dataset.sharePlace || '',
                    admission: button.dataset.shareAdmission || '',
                    brandUrl: button.dataset.shareBrandImage || '',
                  });
                  if (composedBlob && await shareBlobAsImage(button, composedBlob)) return;
                } else if (await shareBlobAsImage(button, blob)) {
                  return;
                }
              }
            }
            const generatedBlob = await createGeneratedShareImage(button);
            if (generatedBlob && await shareBlobAsImage(button, generatedBlob)) return;
            await fallbackNativeShare(button, imageUrl ? 'image-unshareable' : 'no-image');
          } catch (error) {
            if (error && error.name === 'AbortError') {
              setNativeShareStatus(button, 'Поделиться');
              return;
            }
            try {
              const generatedBlob = await createGeneratedShareImage(button);
              if (generatedBlob && await shareBlobAsImage(button, generatedBlob)) return;
              await fallbackNativeShare(button, 'file-share-failed');
            } catch (_) {
              setNativeShareStatus(button, 'Не удалось');
            }
          }
        });

        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-copy-url]');
          if (!button) return;
          event.preventDefault();
          const url = button.dataset.copyUrl || location.href;
          try {
            await navigator.clipboard.writeText(url);
            const label = button.querySelector('span') || button;
            const original = label.textContent;
            label.textContent = 'Ссылка скопирована';
            showMobileActionToast('Ссылка скопирована', 'success', 'copy-url');
            const epoch = Number(button.dataset.copyUrlEpoch || 0) + 1;
            button.dataset.copyUrlEpoch = String(epoch);
            setTimeout(() => {
