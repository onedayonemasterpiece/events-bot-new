        function visibleFeedCardCount(feed) {
          return Array.from(feed.querySelectorAll(':scope > [data-event-card]')).filter((card) => !card.hidden).length;
        }

        function eventState(profile, eventId) {
          const id = asId(eventId);
          if (!profile || !id) return { liked: false, not_interested: false, shares: 0 };
          return {
            liked: likedSet(profile).has(id),
            not_interested: hiddenSet(profile).has(id),
            shares: Number((profile.share_counts || {})[id] || 0),
          };
        }

        function setMembership(profile, field, eventId, enabled) {
          const id = asId(eventId);
          const set = new Set(toArray(profile[field]).map(asId).filter(Boolean));
          if (enabled) set.add(id);
          else set.delete(id);
          profile[field] = Array.from(set);
        }

        function bumpTagMap(map, tags, delta) {
          const next = { ...(map || {}) };
          for (const tag of unique(tags).slice(0, 8)) {
            const value = Math.max(0, Math.min(5, mapScore(next, tag) + delta));
            if (value > 0) next[tag] = Number(value.toFixed(3));
            else delete next[tag];
          }
          return next;
        }

        function updateProfileForAction(profile, eventId, action, candidate) {
          const next = { ...profile, share_counts: { ...(profile.share_counts || {}) } };
          const tags = candidatePositiveMatchingTags(candidate);
          if (action === 'like_event') {
            setMembership(next, 'liked_event_ids', eventId, true);
            setMembership(next, 'not_interested_event_ids', eventId, false);
            setMembership(next, 'hidden_event_ids', eventId, false);
            next.positive_tags = bumpTagMap(next.positive_tags, tags, 0.45);
          } else if (action === 'unlike_event') {
            setMembership(next, 'liked_event_ids', eventId, false);
          } else if (action === 'not_interested') {
            setMembership(next, 'not_interested_event_ids', eventId, true);
            setMembership(next, 'hidden_event_ids', eventId, true);
            setMembership(next, 'liked_event_ids', eventId, false);
            next.negative_interest_tags = bumpTagMap(next.negative_interest_tags, tags, 0.7);
          } else if (action === 'undo_not_interested') {
            setMembership(next, 'not_interested_event_ids', eventId, false);
            setMembership(next, 'hidden_event_ids', eventId, false);
            next.negative_interest_tags = bumpTagMap(next.negative_interest_tags, tags, -0.35);
          } else if (action === 'share_event') {
            const id = asId(eventId);
            next.share_counts[id] = Number(next.share_counts[id] || 0) + 1;
          }
          next.updated_at = new Date().toISOString();
          return next;
        }

        function hideLikeShareCallouts() {
          window.clearTimeout(shareCalloutTimer);
