        function hydrateHeroParallax() {
          const heroes = Array.from(document.querySelectorAll('.event-hero--photo-cover:is(.event-hero--photo-cinematic-sheet, .event-hero--photo-parallax-sheet) .event-hero__visual, .event-hero--poster-stage:is(.event-hero--poster-billboard, .event-hero--poster-attached-card) .event-hero__visual'));
