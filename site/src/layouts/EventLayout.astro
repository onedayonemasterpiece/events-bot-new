          const negativeButton = `<button type="button" class="feedback-button feedback-button--negative" data-feedback-action="not_interested" data-event-id="${escapeHtml(data.id)}" data-event-title="${escapeHtml(data.title)}" aria-pressed="false" aria-label="${escapeHtml(`Не интересно: ${data.title}`)}">${dislikeIcon}<span>Не интересно</span></button>`;
