              const current = slideIndex === next;
              slide.setAttribute('aria-hidden', current ? 'false' : 'true');
              syncSlideTabbability(slide, current);
            });
            const counter = gallery.querySelector('[data-hero-gallery-counter]');
            if (counter) counter.textContent = `${next + 1} / ${slides.length}`;
            preloadAdjacentGalleryMedia(gallery);
            scheduleGalleryPan(gallery, options.direction || 'forward');
          };

          const closeGallery = () => {
            if (!activeGallery) return;
            const gallery = activeGallery;
            gallery.classList.remove('is-open');
            clearGalleryPanTimer();
            delete gallery.dataset.autoPan;
            delete gallery.dataset.panToken;
            document.body.classList.remove('has-hero-gallery-open');
            window.setTimeout(() => {
              if (!gallery.classList.contains('is-open')) gallery.hidden = true;
            }, 190);
            const opener = activeOpener;
            activeGallery = null;
            activeOpener = null;
            if (opener && document.contains(opener)) opener.focus({ preventScroll: true });
          };

          const openGallery = (gallery, opener) => {
            activeGallery = gallery;
            activeOpener = opener;
            if (gallery.parentElement !== document.body) document.body.appendChild(gallery);
            gallery.hidden = false;
            gallery.dataset.autoAdvance = reducedMotion.matches ? 'false' : 'true';
            const requestedIndex = Math.max(0, Number(opener?.dataset.heroGalleryIndex || 0));
            showSlide(gallery, requestedIndex, { direction: 'forward', behavior: 'auto' });
            document.body.classList.add('has-hero-gallery-open');
            window.requestAnimationFrame(() => {
              gallery.classList.add('is-open');
              gallery.focus({ preventScroll: true });
            });
          };

          openers.forEach((opener) => {
            const galleryId = opener.dataset.heroGalleryOpen;
            const gallery = galleryId ? document.getElementById(galleryId) : null;
            if (!gallery) return;
            opener.addEventListener('click', (event) => {
              event.preventDefault();
              openGallery(gallery, opener);
            });
          });

          document.querySelectorAll('[data-hero-gallery]').forEach((gallery) => {
            gallery.querySelector('[data-hero-gallery-close]')?.addEventListener('click', closeGallery);
            gallery.querySelector('[data-hero-gallery-prev]')?.addEventListener('click', () => {
              if (isEfficientGallery(gallery)) {
                moveEfficientGallery(gallery, 'backward');
                return;
              }
              gallery.dataset.autoAdvance = 'false';
              showSlide(gallery, Number(gallery.dataset.activeIndex || 0) - 1, { direction: 'backward' });
            });
            gallery.querySelector('[data-hero-gallery-next]')?.addEventListener('click', () => {
              if (isEfficientGallery(gallery)) {
                moveEfficientGallery(gallery, 'forward');
                return;
              }
              gallery.dataset.autoAdvance = 'true';
              showSlide(gallery, Number(gallery.dataset.activeIndex || 0) + 1, { direction: 'forward' });
            });
            gallery.addEventListener('animationend', (event) => {
              if (event.animationName !== 'gallery-pan-forward') return;
              if (!gallery.classList.contains('is-open') || gallery.hidden) return;
              if (gallery.dataset.autoAdvance === 'false') return;
              if (gallery.dataset.panToken) return;
              showSlide(gallery, nextImageIndex(gallery), { direction: 'forward' });
            });
            const swipeSurface = gallery.querySelector('.hero-gallery__viewport') || gallery;
            swipeSurface.addEventListener('scroll', () => {
              if (!isEfficientGallery(gallery)) return;
              window.requestAnimationFrame(() => updateEfficientGalleryState(gallery));
            }, { passive: true });
            const resetSwipe = () => {
              delete gallery.dataset.pointerTracking;
              delete gallery.dataset.pointerStartX;
              delete gallery.dataset.pointerStartY;
              delete gallery.dataset.pointerLastX;
              delete gallery.dataset.pointerLastY;
            };
            const isInteractiveGalleryTarget = (target) => target instanceof Element
              && Boolean(target.closest('a,button,input,select,textarea,[contenteditable="true"],.hero-gallery__slide--cta,[data-gallery-keep-open]'));
            const swipeStart = (clientX, clientY) => {
              gallery.dataset.pointerTracking = 'true';
              gallery.dataset.pointerStartX = String(clientX || 0);
              gallery.dataset.pointerStartY = String(clientY || 0);
              gallery.dataset.pointerLastX = String(clientX || 0);
              gallery.dataset.pointerLastY = String(clientY || 0);
            };
            const swipeMove = (clientX, clientY) => {
              if (gallery.dataset.pointerTracking !== 'true') return false;
              gallery.dataset.pointerLastX = String(clientX || 0);
              gallery.dataset.pointerLastY = String(clientY || 0);
              return true;
            };
            const swipeEnd = (clientX, clientY) => {
              if (gallery.dataset.pointerTracking !== 'true') return;
              const startX = Number(gallery.dataset.pointerStartX || 0);
              const startY = Number(gallery.dataset.pointerStartY || 0);
              const endX = clientX == null ? Number(gallery.dataset.pointerLastX || startX) : Number(clientX || 0);
              const endY = clientY == null ? Number(gallery.dataset.pointerLastY || startY) : Number(clientY || 0);
              resetSwipe();
              const deltaX = endX - startX;
              const deltaY = endY - startY;
              gallery.dataset.pointerMoved = Math.hypot(deltaX, deltaY) > 8 ? 'true' : 'false';
              if (Math.abs(deltaX) < 38 || Math.abs(deltaX) < Math.abs(deltaY) * 1.15) return;
              const direction = deltaX < 0 ? 'forward' : 'backward';
              if (isEfficientGallery(gallery)) {
                moveEfficientGallery(gallery, direction);
                return;
              }
              gallery.dataset.autoAdvance = direction === 'forward' ? 'true' : 'false';
              showSlide(gallery, Number(gallery.dataset.activeIndex || 0) + (deltaX < 0 ? 1 : -1), { direction });
            };
            swipeSurface.addEventListener('pointerdown', (event) => {
              if (isInteractiveGalleryTarget(event.target)) {
                resetSwipe();
                return;
              }
              swipeStart(event.clientX, event.clientY);
              if (swipeSurface.setPointerCapture && event.pointerId != null) {
                try { swipeSurface.setPointerCapture(event.pointerId); } catch (_) {}
              }
            }, { passive: true });
            swipeSurface.addEventListener('pointermove', (event) => {
              swipeMove(event.clientX, event.clientY);
            }, { passive: true });
            swipeSurface.addEventListener('pointerup', (event) => {
              swipeEnd(event.clientX, event.clientY);
            }, { passive: true });
            swipeSurface.addEventListener('pointercancel', () => {
              swipeEnd(null, null);
            }, { passive: true });
            swipeSurface.addEventListener('touchstart', (event) => {
              if (isInteractiveGalleryTarget(event.target)) {
                resetSwipe();
                return;
              }
              const touch = event.changedTouches && event.changedTouches[0];
              if (touch) swipeStart(touch.clientX, touch.clientY);
            }, { passive: true });
            swipeSurface.addEventListener('touchmove', (event) => {
              const touch = event.changedTouches && event.changedTouches[0];
              const tracking = touch ? swipeMove(touch.clientX, touch.clientY) : false;
              if (tracking && event.cancelable) event.preventDefault();
            }, { passive: false });
            swipeSurface.addEventListener('touchend', (event) => {
              const touch = event.changedTouches && event.changedTouches[0];
              if (touch) swipeEnd(touch.clientX, touch.clientY);
              else swipeEnd(null, null);
            }, { passive: true });
            swipeSurface.addEventListener('touchcancel', () => {
              swipeEnd(null, null);
            }, { passive: true });
            swipeSurface.addEventListener('click', (event) => {
              if (gallery.dataset.desktopGalleryDismiss !== 'true' || !window.matchMedia('(min-width: 1024px)').matches) return;
              if (gallery.dataset.pointerMoved === 'true') {
                delete gallery.dataset.pointerMoved;
                return;
              }
              delete gallery.dataset.pointerMoved;
              const target = event.target instanceof Element ? event.target : null;
              if (target?.closest('a,button,.hero-gallery__slide--cta,[data-gallery-keep-open]')) return;
              closeGallery();
            });
          });

          document.addEventListener('keydown', (event) => {
            if (!activeGallery) return;
            if (event.key === 'Tab') {
              const focusable = Array.from(activeGallery.querySelectorAll('a[href],button:not(:disabled),input:not(:disabled),select:not(:disabled),textarea:not(:disabled),[tabindex]'))
                .filter((control) => control.getAttribute('tabindex') !== '-1'
                  && !control.hasAttribute('hidden')
                  && !control.closest('[aria-hidden="true"]'));
              if (!focusable.length) {
                event.preventDefault();
                activeGallery.focus({ preventScroll: true });
                return;
              }
              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              const current = document.activeElement;
              if (!activeGallery.contains(current) || current === activeGallery) {
                event.preventDefault();
                (event.shiftKey ? last : first).focus({ preventScroll: true });
              } else if (event.shiftKey && current === first) {
                event.preventDefault();
                last.focus({ preventScroll: true });
              } else if (!event.shiftKey && current === last) {
                event.preventDefault();
                first.focus({ preventScroll: true });
              }
            } else if (event.key === 'Escape') {
              event.preventDefault();
              closeGallery();
            } else if (event.key === 'ArrowLeft') {
              event.preventDefault();
              if (isEfficientGallery(activeGallery)) {
                moveEfficientGallery(activeGallery, 'backward');
                return;
              }
              activeGallery.dataset.autoAdvance = 'false';
              showSlide(activeGallery, Number(activeGallery.dataset.activeIndex || 0) - 1, { direction: 'backward' });
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              if (isEfficientGallery(activeGallery)) {
                moveEfficientGallery(activeGallery, 'forward');
                return;
              }
              activeGallery.dataset.autoAdvance = 'true';
              showSlide(activeGallery, Number(activeGallery.dataset.activeIndex || 0) + 1, { direction: 'forward' });
            }
          });
        }

        hydrateImmersiveHeader();
        hydrateMobileDiscoveryMenu();
        hydrateListingFilterFooterGuard();
        updatePersonalizationResetStatus();
        hydrateCalendarActions();
        initializePersonalFeedObservers();
        hydrateHeroParallax();
        hydrateDesktopEventReading();
        hydrateHeroGallery();
        applyFeedbackState();
      })();
    </script>
  </body>
</html>
