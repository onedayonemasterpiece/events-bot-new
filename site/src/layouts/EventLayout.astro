          const update = () => {
            ticking = false;
            heroes.forEach((visual) => {
              const images = Array.from(visual.querySelectorAll('.event-hero__image'));
              if (!images.length) return;
              const isPosterStage = Boolean(visual.closest('.event-hero--poster-stage'));
              const usesGapSafePosterParallax = isPosterStage && Boolean(visual.closest('[data-mobile-review-revision="v4"], [data-mobile-event-production]'));
              const usesReverseGapSafePosterParallax = usesGapSafePosterParallax && Boolean(visual.closest('[data-mobile-review-variant="accepted-v5"], [data-mobile-review-variant="accepted-v6"], [data-mobile-review-variant="accepted-v7"], [data-mobile-review-variant="accepted-v8"], [data-mobile-event-production][data-mobile-parallax-profile]'));
              const usesPhotoVelocityMatchedPosterParallax = usesReverseGapSafePosterParallax && Boolean(visual.closest('[data-mobile-parallax-profile="photo-velocity-matched"]'));
              const usesPhotoContinuousPosterParallax = usesReverseGapSafePosterParallax && Boolean(visual.closest('[data-mobile-parallax-profile="photo-continuous-crop"]'));
