---
import { SITE_NAME, SITE_ORIGIN, withBase } from '../lib/events';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string | null;
  structuredData?: unknown[];
}

const { title, description, canonicalUrl, ogImage, structuredData = [] } = Astro.props;
const robots = 'noindex,nofollow,noarchive';
const safeDescription = description || 'Анонс события в Калининградской области.';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#f7efe3" />
    <meta name="format-detection" content="telephone=yes" />
    {structuredData.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <style is:global>
      :root {
        --bg: #fbf7ef;
        --bg-soft: #f2e7d7;
        --surface: #fffdf8;
        --surface-strong: #ffffff;
        --text: #221a14;
        --muted: #6d6259;
        --line: #e1d3c2;
        --primary: #a54821;
        --primary-strong: #793014;
        --primary-text: #ffffff;
        --accent: #0f766e;
        --accent-soft: #d7f0ec;
        --warning: #a16207;
        --shadow: 0 18px 45px rgba(72, 45, 25, 0.12);
        --radius-xl: 28px;
        --radius-lg: 20px;
        --radius-md: 14px;
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; scroll-behavior: smooth; }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(165, 72, 33, 0.12), transparent 32rem),
          linear-gradient(180deg, #fff8ed 0%, var(--bg) 42%, #f7efe3 100%);
        color: var(--text);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.1;
        background-image: linear-gradient(rgba(121, 48, 20, 0.035) 1px, transparent 1px);
        background-size: 28px 28px;
      }
      a { color: inherit; text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 3px solid rgba(15, 118, 110, 0.65); outline-offset: 3px; }
      img { display: block; max-width: 100%; height: auto; }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: 1rem;
        z-index: 20;
        transform: translateY(-180%);
        background: var(--text);
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 999px;
      }
      .skip-link:focus { transform: translateY(0); }
      .site-header {
        position: relative;
        z-index: 2;
        border-bottom: 1px solid rgba(121, 48, 20, 0.12);
        background: rgba(255, 253, 248, 0.86);
        backdrop-filter: blur(10px);
      }
      .site-header__inner {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .brand { display: inline-flex; flex-direction: column; text-decoration: none; line-height: 1.1; min-height: 44px; justify-content: center; }
      .brand__name { font-weight: 800; letter-spacing: -0.02em; }
      .brand__sub { color: var(--muted); font-size: 0.82rem; }
      .site-nav { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
      .site-nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.8rem;
        border: 1px solid transparent;
        border-radius: 999px;
        color: var(--muted);
        text-decoration: none;
      }
      .site-nav a:hover { color: var(--text); border-color: var(--line); background: #fff; }
      .page-shell { position: relative; z-index: 1; width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
      main { padding: 1.2rem 0 5.5rem; }
      .crumbs { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin: 0.5rem 0 1rem; color: var(--muted); font-size: 0.92rem; }
      .crumbs a { min-height: 32px; display: inline-flex; align-items: center; color: var(--primary-strong); }
      .event-grid { display: grid; gap: 1rem; }
      .main-col, .side-col { min-width: 0; }
      .section-card {
        background: rgba(255, 253, 248, 0.92);
        border: 1px solid rgba(121, 48, 20, 0.13);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
      }
      .section-card--quiet { box-shadow: none; background: rgba(255, 253, 248, 0.74); }
      .section-card__inner { padding: clamp(0.85rem, 2.8vw, 1.55rem); }
      .eyebrow { color: var(--primary-strong); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.5rem; }
      h1, h2, h3 { line-height: 1.08; letter-spacing: -0.035em; margin: 0; }
      h1 { font-size: clamp(1.8rem, 6vw, 3.7rem); max-width: 16ch; overflow-wrap: anywhere; }
      h2 { font-size: clamp(1.35rem, 3.4vw, 2rem); margin-bottom: 0.8rem; }
      h3 { font-size: 1.18rem; margin: 1.35rem 0 0.55rem; }
      .lead { font-size: clamp(1rem, 2.2vw, 1.18rem); color: #44362d; max-width: 58ch; margin: 0.85rem 0 0; }
      .badge-row { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.8rem 0 0; }
      .badge {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--line);
        background: #fffaf1;
        color: #4d3829;
        border-radius: 999px;
        padding: 0.28rem 0.7rem;
        font-size: 0.88rem;
        font-weight: 700;
      }
      .badge--status { background: var(--accent-soft); color: #0f544f; border-color: rgba(15, 118, 110, 0.2); }
      .hero-media { margin-top: 1rem; border-radius: 24px; overflow: hidden; border: 1px solid rgba(121, 48, 20, 0.14); background: radial-gradient(circle at 50% 20%, rgba(255,255,255,0.18), transparent 16rem), #15110f; aspect-ratio: 4 / 5; max-height: min(72dvh, 760px); }
      .hero-media img { width: 100%; height: 100%; object-fit: contain; }
      .hero-fallback { width: 100%; height: 100%; display: grid; place-items: center; padding: 1.5rem; color: #fff; text-align: center; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.32), transparent 20rem), linear-gradient(135deg, #8a3f23, #1d5f5a); }
      .hero-fallback strong { display:block; max-width: 18ch; font-size: clamp(1.5rem, 5vw, 3.2rem); line-height: 1; letter-spacing: -0.04em; }
      .facts-quick { display: grid; gap: 0.65rem; margin-top: 0.85rem; }
      .facts-quick--compact { grid-template-columns: 1fr; }
      .quick-fact { display: flex; gap: 0.65rem; padding: 0.7rem; border-radius: 16px; background: rgba(242, 231, 215, 0.64); min-width: 0; }
      .quick-fact__mark { width: 0.45rem; flex: 0 0 0.45rem; border-radius: 999px; background: var(--primary); }
      .quick-fact strong { display: block; font-size: 0.82rem; color: var(--muted); font-weight: 700; }
      .quick-fact span { display: block; overflow-wrap: anywhere; }
      .prose { margin-top: 1rem; color: #3b3029; max-width: 68ch; }
      .prose p { margin: 0 0 0.95rem; }
      .prose blockquote { margin: 0 0 1rem; padding: 1rem 1.1rem; border-left: 4px solid var(--primary); background: #fff4e6; border-radius: 0 18px 18px 0; color: #33251d; }
      .prose ul { margin: 0 0 1rem 1.2rem; padding: 0; }
      .details-list { display: grid; gap: 0.7rem; margin: 0; }
      .details-list div { display: grid; gap: 0.15rem; padding: 0 0 0.7rem; border-bottom: 1px solid rgba(121, 48, 20, 0.12); }
      .details-list div:last-child { border-bottom: 0; padding-bottom: 0; }
      .details-list dt { color: var(--muted); font-size: 0.86rem; font-weight: 700; }
      .details-list dd { margin: 0; overflow-wrap: anywhere; }
      .cta-panel { padding: 1rem; }
      .cta-panel__top { display: grid; gap: 0.8rem; }
      .cta-panel__date { font-size: 1.35rem; font-weight: 850; letter-spacing: -0.03em; line-height: 1.12; }
      .cta-button, .secondary-button {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0.8rem 1rem;
        font-weight: 850;
        text-decoration: none;
        border: 1px solid transparent;
        text-align: center;
      }
      .cta-button { background: var(--primary); color: var(--primary-text); box-shadow: 0 12px 24px rgba(121, 48, 20, 0.2); }
      .cta-button:hover { background: var(--primary-strong); }
      .secondary-button { background: #fff; color: var(--primary-strong); border-color: var(--line); }
      .secondary-button:hover { background: #fff6ea; }
      .action-grid { display: grid; grid-template-columns: 1fr; gap: 0.55rem; margin-top: 0.75rem; }
      .native-share-button { display: none; cursor: pointer; }
      .has-native-share .native-share-button { display: inline-flex; }
      .share-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.85rem 0 0; padding: 0; list-style: none; }
      .share-list a { min-height: 44px; display: inline-flex; align-items: center; border-radius: 999px; padding: 0.45rem 0.75rem; border: 1px solid var(--line); background: #fff; color: var(--primary-strong); text-decoration: none; font-weight: 750; }
      .muted-note { color: var(--muted); font-size: 0.88rem; margin: 0.65rem 0 0; }
      .cards-grid { display: grid; gap: 0.9rem; }
      .cards-grid--feed {
        grid-auto-flow: column;
        grid-auto-columns: clamp(172px, 48vw, 220px);
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: x mandatory;
        padding: 0.1rem 0.15rem 0.8rem;
        margin-inline: -0.15rem;
      }
      .event-card {
        display: grid;
        overflow: hidden;
        border: 1px solid rgba(121,48,20,0.13);
        border-radius: 24px;
        background: #15110f;
        color: #fff;
        min-height: 0;
        box-shadow: 0 14px 34px rgba(72,45,25,0.16);
        scroll-snap-align: start;
      }
      .event-card:hover { border-color: rgba(165,72,33,0.48); box-shadow: 0 18px 38px rgba(72,45,25,0.2); }
      .event-card__media-link { display: block; color: inherit; text-decoration: none; }
      .event-card__media { display: block; width: 100%; aspect-ratio: 3 / 4; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.22), transparent 15rem), linear-gradient(135deg, #8a3f23, #0f766e); object-fit: cover; }
      .event-card__fallback { min-height: 100%; display: grid; align-content: space-between; gap: 0.7rem; padding: 1rem; color: rgba(255,255,255,0.9); font-weight: 850; text-transform: uppercase; letter-spacing: 0.08em; }
      .event-card__fallback strong { font-size: clamp(1.15rem, 5vw, 1.55rem); line-height: 1; letter-spacing: -0.04em; }
      .event-card__body { display: grid; gap: 0.5rem; padding: 0.85rem; }
      .event-card__meta-row { display: grid; gap: 0.35rem; }
      .event-card__meta { color: rgba(255,255,255,0.74); font-weight: 750; font-size: 0.82rem; line-height: 1.25; }
      .event-card__status { width: max-content; max-width: 100%; min-height: 28px; display: inline-flex; align-items: center; border-radius: 999px; padding: 0.22rem 0.55rem; background: rgba(215,240,236,0.16); border: 1px solid rgba(215,240,236,0.28); color: #d7f0ec; font-size: 0.75rem; font-weight: 850; line-height: 1.15; }
      .event-card__title { color: #fff; text-decoration: none; font-weight: 900; line-height: 1.08; font-size: clamp(1.03rem, 4.2vw, 1.35rem); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .event-card__title:hover { text-decoration: underline; text-decoration-thickness: 0.08em; }
      .event-card__footer { color: rgba(255,255,255,0.84); font-weight: 760; font-size: 0.86rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
      .event-card__actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; margin-top: 0.25rem; }
      .event-card__actions a { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; padding: 0.35rem 0.45rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); color: #fff; text-decoration: none; font-size: 0.76rem; font-weight: 850; text-align: center; }
      .event-card__actions a:hover { background: rgba(255,255,255,0.18); }
      .listing-stack { display: grid; gap: 0.85rem; }
      .listing-item { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 0.85rem; align-items: stretch; padding: 0.75rem; border: 1px solid rgba(121,48,20,0.13); border-radius: 22px; background: #fffdf8; }
      .listing-item__media { display: block; min-height: 138px; border-radius: 18px; overflow: hidden; background: linear-gradient(135deg, #8a3f23, #0f766e); text-decoration: none; }
      .listing-item__media img { width: 100%; height: 100%; object-fit: cover; }
      .listing-item__fallback { width: 100%; height: 100%; min-height: 138px; display: grid; place-items: center; color: #fff; padding: 0.7rem; text-align: center; font-weight: 900; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.07em; }
      .listing-item__body { min-width: 0; display: grid; gap: 0.42rem; align-content: center; }
      .listing-item__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--muted); font-size: 0.84rem; font-weight: 800; }
      .listing-item__title { color: var(--text); text-decoration: none; font-size: clamp(1.08rem, 3.8vw, 1.35rem); line-height: 1.12; font-weight: 900; overflow-wrap: anywhere; }
      .listing-item__title:hover { text-decoration: underline; }
      .listing-item p { margin: 0; color: var(--muted); font-weight: 700; }
      .listing-item__actions { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.2rem; }
      .listing-item__actions .cta-button, .listing-item__actions .secondary-button { min-height: 44px; padding: 0.55rem 0.75rem; font-size: 0.9rem; }
      .sponsor-card { border-style: dashed; background: linear-gradient(135deg, #fff, #fff4e6); }
      .source-links { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.85rem; }
      .source-links a, .source-links button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 0.8rem; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; color: var(--primary-strong); background: #fff; font: inherit; font-weight: 850; }
      .source-links .cta-button { color: var(--primary-text); background: var(--primary); border-color: transparent; padding: 0.75rem 1rem; }
      .mobile-sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 0.7rem max(1rem, env(safe-area-inset-left)) calc(0.7rem + env(safe-area-inset-bottom)); background: rgba(255, 253, 248, 0.94); border-top: 1px solid var(--line); box-shadow: 0 -12px 30px rgba(72,45,25,0.12); }
      .mobile-sticky-cta__inner { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; align-items: center; }
      .mobile-sticky-cta__title { min-width: 0; }
      .mobile-sticky-cta__title strong { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mobile-sticky-cta__title span { display: block; color: var(--muted); font-size: 0.86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      footer { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 2rem 0 6rem; color: var(--muted); }
      .details-disclosure summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 900; font-size: 1.08rem; }
      .details-disclosure summary::marker { color: var(--primary); }
      .preview-warning { margin: 1rem 0; border: 1px solid rgba(161,98,7,0.24); background: #fff8db; color: #5a3b06; border-radius: 18px; padding: 0.8rem 1rem; }

      @media (min-width: 760px) {
        .facts-quick { grid-template-columns: repeat(2, 1fr); }
        .action-grid { grid-template-columns: 1fr 1fr; }
        .cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cards-grid--feed { grid-auto-flow: row; grid-auto-columns: initial; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; overscroll-behavior-inline: auto; scroll-snap-type: none; padding: 0; margin-inline: 0; }
        .hero-media { aspect-ratio: 16 / 10; }
      }
      @media (min-width: 1024px) {
        main { padding-top: 2rem; padding-bottom: 3rem; }
        .event-grid { grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr); gap: 1.25rem; align-items: start; }
        .side-col { position: sticky; top: 1rem; }
        .cards-grid--feed { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .mobile-sticky-cta { display: none; }
        footer { padding-bottom: 2rem; }
      }
      @media (max-width: 560px) {
        .site-header__inner { width: min(100% - 24px, 1180px); min-height: 64px; }
        .site-nav a:nth-child(n+3) { display: none; }
        .page-shell { width: min(100% - 24px, 1180px); }
        .section-card { border-radius: 22px; }
        .section-card__inner { padding: 1rem; }
        .cta-button, .secondary-button { width: 100%; }
        .mobile-sticky-cta__inner { grid-template-columns: minmax(0, 1fr); }
        .mobile-sticky-cta__title { display: none; }
        .listing-item { grid-template-columns: 88px minmax(0, 1fr); gap: 0.65rem; padding: 0.65rem; }
        .listing-item__media, .listing-item__fallback { min-height: 120px; }
        .listing-item__actions .cta-button, .listing-item__actions .secondary-button { width: auto; flex: 1 1 120px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к событию</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/__preview/')} aria-label={`${SITE_NAME}: preview index`}>
          <span class="brand__name">{SITE_NAME}</span>
          <span class="brand__sub">афиша событий</span>
        </a>
        <nav class="site-nav" aria-label="Основная навигация preview">
          <a href={withBase('/segodnya/')}>Сегодня</a>
          <a href={withBase('/vyhodnye/')}>Выходные</a>
          <a href={withBase('/sitemap.xml')}>Sitemap</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="page-shell">
        <strong>{SITE_NAME}</strong>
        <p>Preview-сборка статических страниц событий. Роботам закрыто через meta robots и robots.txt.</p>
        <p>Домен: {SITE_ORIGIN}. Все preview canonical URL содержат текущий prefix.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        if ('share' in navigator) {
          document.documentElement.classList.add('has-native-share');
          document.addEventListener('click', async (event) => {
            const button = event.target.closest('[data-native-share]');
            if (!button) return;
            event.preventDefault();
            try {
              await navigator.share({
                title: button.dataset.shareTitle || document.title,
                text: button.dataset.shareText || '',
                url: button.dataset.shareUrl || location.href,
              });
            } catch (_) {
              // User cancelled or browser refused; keep fallback share links visible.
            }
          });
        }
        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-copy-url]');
          if (!button) return;
          event.preventDefault();
          const url = button.dataset.copyUrl || location.href;
          try {
            await navigator.clipboard.writeText(url);
            const original = button.textContent;
            button.textContent = 'Ссылка скопирована';
            setTimeout(() => { button.textContent = original || 'Скопировать ссылку'; }, 1800);
          } catch (_) {
            location.href = url;
          }
        });
      })();
    </script>
  </body>
</html>
