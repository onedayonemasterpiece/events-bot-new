      .discovery-load-more { margin: 1rem auto 0; width: min(100%, 320px); }
      .personalization-consent { position: fixed; left: max(1rem, env(safe-area-inset-left)); right: max(1rem, env(safe-area-inset-right)); bottom: calc(1rem + env(safe-area-inset-bottom)); z-index: 30; display: none; gap: 0.8rem; align-items: center; justify-content: space-between; width: min(680px, calc(100% - 2rem)); margin: 0 auto; padding: 0.85rem 1rem; border: 1px solid rgba(121,48,20,0.18); border-radius: 22px; background: rgba(255,253,248,0.98); box-shadow: 0 18px 46px rgba(72,45,25,0.2); color: var(--text); }
      .personalization-consent.is-visible { display: flex; }
      .personalization-consent p { margin: 0; font-size: 0.9rem; color: var(--muted); }
      .personalization-consent strong { display: block; color: var(--text); }
      .personalization-consent__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: flex-end; }
      .personalization-consent .secondary-button, .personalization-consent .cta-button { min-height: 42px; padding: 0.45rem 0.85rem; white-space: nowrap; }
      .mobile-sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 0.7rem max(1rem, env(safe-area-inset-left)) calc(0.7rem + env(safe-area-inset-bottom)); background: rgba(255, 253, 248, 0.94); border-top: 1px solid var(--line); box-shadow: 0 -12px 30px rgba(72,45,25,0.12); transition: transform 180ms ease, opacity 180ms ease; }
      .mobile-sticky-cta.is-hidden { transform: translateY(120%); opacity: 0; pointer-events: none; }
      .mobile-sticky-cta__inner { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; align-items: center; }
      .mobile-sticky-cta__title { min-width: 0; }
      .mobile-sticky-cta__title strong { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mobile-sticky-cta__title span { display: block; color: var(--muted); font-size: 0.86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      footer { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 2rem 0 6rem; color: var(--muted); }
      .site-footer__inner { display: grid; gap: 0.7rem; }
      .site-footer__title { color: var(--text); font-size: 1rem; }
      .site-footer__social { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.2rem; }
      .site-footer__social-link {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: 0.48rem;
        padding: 0.48rem 0.74rem;
        border: 1px solid rgba(121, 48, 20, 0.14);
        border-radius: 999px;
        background: rgba(255, 253, 248, 0.86);
        color: var(--primary-strong);
        text-decoration: none;
        font-weight: 820;
        box-shadow: 0 8px 18px rgba(72,45,25,0.06);
      }
      .site-footer__social-link:hover { background: #fff; border-color: rgba(165,72,33,0.34); color: var(--text); }
      .site-footer__social-network { color: var(--muted); font-size: 0.82rem; }
      .site-footer__social-label { color: var(--text); }
      .social-icon { width: 1.28rem; height: 1.28rem; flex: 0 0 auto; display: block; }
      .social-icon--max { color: #111; }
      .details-disclosure summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 900; font-size: 1.08rem; }
      .details-disclosure summary::marker { color: var(--primary); }
      .preview-warning { margin: 1rem 0; border: 1px solid rgba(161,98,7,0.24); background: #fff8db; color: #5a3b06; border-radius: 18px; padding: 0.8rem 1rem; }
      .feedback-report { display: grid; gap: 0.75rem; }
      .feedback-report__summary { display: grid; gap: 0.35rem; color: var(--muted); font-weight: 750; }
      .feedback-report__list { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
      .feedback-report__list li { padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 14px; background: #fff; }

      @media (min-width: 760px) {
        .facts-quick { grid-template-columns: repeat(2, 1fr); }
        .preview-ab__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .action-grid { grid-template-columns: 1fr 1fr; }
        .cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cards-grid--immersive { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cards-grid--feed { grid-auto-flow: row; grid-auto-columns: initial; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; overscroll-behavior-inline: auto; scroll-snap-type: none; padding: 0; margin-inline: 0; }
      }
      @media (max-width: 1023px) {
        .side-col { display: none; }
      }
      @media (min-width: 1024px) {
        main { padding-top: 2rem; padding-bottom: 3rem; }
        .event-grid { grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr); gap: 1.25rem; align-items: start; }
        .side-col { position: sticky; top: 1rem; }
        .event-main-actions { display: none; }
        .cards-grid--immersive { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .cards-grid--feed { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .mobile-sticky-cta { display: none; }
        footer { padding-bottom: 2rem; }
      }
      @media (max-width: 560px) {
        .site-header__inner { width: min(100% - 24px, 1180px); min-height: 64px; }
        .site-nav a:nth-child(n+3) { display: none; }
        .page-shell { width: min(100% - 24px, 1180px); }
        .section-card { border-radius: 22px; }
        .section-card__inner { padding: 1rem; }
        .cta-button, .secondary-button { width: 100%; }
        .feedback-button--negative span { display: none; }
        .event-card__feedback { grid-template-columns: 48px minmax(118px, 1fr) 82px; gap: 0.28rem; left: 0.56rem; right: 0.56rem; }
        .event-card--split-actions .feedback-button--negative span { display: inline; }
        .event-card--split-actions .event-card__utility-row { padding-inline: 0.68rem; gap: 0.34rem; }
        .event-card--split-actions .event-card__utility-row .feedback-button--calendar { flex: 1 1 auto; }
        .event-card--split-actions .event-card__feedback { gap: 0.34rem; }
        .event-card--split-actions .event-card__feedback .feedback-button--share { min-width: 136px; }
        .event-card--split-actions .event-card__feedback .feedback-button--like { min-width: 88px; }
        .feedback-button--share { padding-inline: 0.46rem; font-size: 0.82rem; }
        .feedback-button--share .icon { width: 1.18rem; height: 1.18rem; }
        .feedback-button--like { min-width: 82px; padding-inline: 0.5rem; }
        .mobile-sticky-cta__inner { grid-template-columns: minmax(0, 1fr); }
        .mobile-sticky-cta__title { display: none; }
        .listing-item { grid-template-columns: 88px minmax(0, 1fr); gap: 0.65rem; padding: 0.65rem; }
        .listing-item__fallback { min-height: 110px; }
        .listing-item__actions .cta-button, .listing-item__actions .secondary-button { width: auto; flex: 1 1 120px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к событию</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/__preview/')} aria-label={`${SITE_NAME}: preview index`}>
          <span class="brand__name">{SITE_NAME}</span>
          <span class="brand__sub">афиша событий</span>
        </a>
        <nav class="site-nav" aria-label="Основная навигация preview">
          <a href={withBase('/segodnya/')}>Сегодня</a>
          <a href={withBase('/vyhodnye/')}>Выходные</a>
          <a href={withBase('/sitemap.xml')}>Sitemap</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="page-shell site-footer__inner">
        <strong class="site-footer__title">{SITE_NAME}</strong>
        <nav class="site-footer__social" aria-label="Соцсети Полюбить Калининград Анонсы">
          {FOOTER_SOCIAL_LINKS.map((link) => (
            <a
              class="site-footer__social-link"
              href={link.href}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={`${link.network}: ${link.label}`}
            >
              <SocialIcon name={link.icon} />
              <span class="site-footer__social-network">{link.network}</span>
              <span class="site-footer__social-label">{link.label}</span>
            </a>
          ))}
        </nav>
        <p>Preview-сборка статических страниц событий. Роботам закрыто через meta robots и robots.txt.</p>
        <p>Домен: {SITE_ORIGIN}. Все preview canonical URL содержат текущий prefix.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const PROFILE_KEY = 'ke_personalization_profile';
        const LOG_KEY = 'ke_event_feedback_log_v1';
        const SHARE_PROMPT_KEY = 'ke_like_share_prompt_count_v1';
        const PROFILE_VERSION = 'anon-profile-v1';
        const FEATURE_SCHEMA_VERSION = 'event-detail-related-v1';
        const TAXONOMY_VERSION = 'event-taxonomy-v1';
        const SURFACE_EVENT_DETAIL_RELATED = 'event_detail_related';
        const STATIC_ALGORITHM_ID = 'static_related_v1';
        const LOCAL_ALGORITHM_ID = 'local_related_rerank_v1';
        const LOCAL_FALLBACK_ALGORITHM_ID = 'local_related_rerank_v1_fallback';
        const MAX_LOG = 240;
        const MAX_SHARE_PROMPTS_PER_SESSION = 2;
        const DEFAULT_PRELOAD_TARGET = 10;
        const NEGATIVE_HARD_FILTER_THRESHOLD = 0.95;
        const DEFAULT_WEIGHTS = {
          staticContext: 0.80,
          profileAffinity: 0.10,
          priceMatch: 0.04,
          timeMatch: 0.03,
          explicitLike: 0.60,
          exploration: 0.02,
          negativeInterest: 0.55,
          fatigue: 0.18,
          soldOut: 0.20,
        };
        const sessionPinnedNotInterested = new Set();
        const discoveryStores = new WeakMap();
        const servedListByFeed = new WeakMap();
        let shareCalloutTimer = 0;
        let pendingConsentAction = null;

        function readJson(key, fallback) {
          try {
            const raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : fallback;
          } catch (_) {
            return fallback;
          }
        }

        function writeJson(key, value) {
          try {
            localStorage.setItem(key, JSON.stringify(value));
            return true;
          } catch (_) {
            return false;
          }
        }

        function toArray(value) {
          return Array.isArray(value) ? value : [];
        }

        function asId(value) {
          return value == null ? null : String(value);
        }

        function unique(values) {
          return Array.from(new Set(toArray(values).filter((value) => value != null).map((value) => String(value)).filter(Boolean)));
        }

        function viewportClass(width) {
          if (width < 768) return 'mobile';
          if (width < 1024) return 'tablet';
          return 'desktop';
        }

        function relatedPresentationMode(width) {
          return viewportClass(width) === 'mobile' ? 'vertical_related' : 'grid_related';
        }

        function relatedLayoutMode() {
          return 'module';
        }

        function isUuid(value) {
          return typeof value === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
        }

        function createUuid() {
          const cryptoObj = globalThis.crypto || {};
          if (cryptoObj.randomUUID) return cryptoObj.randomUUID();
          const bytes = new Uint8Array(16);
          if (cryptoObj.getRandomValues) {
            cryptoObj.getRandomValues(bytes);
          } else {
            for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(Math.random() * 256);
          }
          bytes[6] = (bytes[6] & 0x0f) | 0x40;
          bytes[8] = (bytes[8] & 0x3f) | 0x80;
          const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
          return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
        }

        function randomId(prefix) {
          return `${prefix}-${createUuid()}`;
        }

        function stableHash(value) {
          const text = typeof value === 'string' ? value : JSON.stringify(value);
          let hash = 2166136261;
          for (let index = 0; index < text.length; index += 1) {
            hash ^= text.charCodeAt(index);
            hash = Math.imul(hash, 16777619);
          }
          return (hash >>> 0).toString(16);
        }

        function createEmptyProfile(seed) {
          return {
            consent_ok: true,
            profile_version: PROFILE_VERSION,
            feature_schema_version: FEATURE_SCHEMA_VERSION,
            taxonomy_version: TAXONOMY_VERSION,
            anon_id: createUuid(),
            session_id: createUuid(),
            positive_tags: {},
            negative_interest_tags: {},
            liked_event_ids: [],
            not_interested_event_ids: [],
            hidden_event_ids: [],
            seen_event_ids: [],
            seen_venue_ids: [],
            price_preferences: { prefer_free: false },
            share_counts: {},
            updated_at: new Date().toISOString(),
            ...(seed || {}),
          };
        }

        function profileHasConsent(profile) {
          return Boolean(profile && profile.consent_ok === true);
        }

        function isCompatibleProfile(profile, featureSchemaVersion = FEATURE_SCHEMA_VERSION, taxonomyVersion = TAXONOMY_VERSION) {
          if (!profileHasConsent(profile)) return false;
          if (profile.profile_version !== PROFILE_VERSION) return false;
          if (profile.feature_schema_version !== (featureSchemaVersion || FEATURE_SCHEMA_VERSION)) return false;
          if (profile.taxonomy_version !== (taxonomyVersion || TAXONOMY_VERSION)) return false;
          if (!isUuid(profile.anon_id) || !isUuid(profile.session_id)) return false;
          if (Object.prototype.hasOwnProperty.call(profile, 'negative_tags')) return false;
          return true;
        }

        function readProfile() {
          return readJson(PROFILE_KEY, null);
        }

        function activeProfile(manifest) {
          const profile = readProfile();
          return isCompatibleProfile(profile, manifest?.feature_schema_version, manifest?.taxonomy_version) ? profile : null;
        }

        function saveProfile(profile) {
          return writeJson(PROFILE_KEY, profile);
        }

        function ensureProfileAfterConsent(seed) {
          const existing = readProfile();
          if (isCompatibleProfile(existing)) return existing;
          const profile = createEmptyProfile(seed);
          saveProfile(profile);
          return profile;
        }

        function consentBanner() {
          let banner = document.querySelector('[data-personalization-consent]');
          if (banner) return banner;
          banner = document.createElement('div');
          banner.className = 'personalization-consent';
          banner.dataset.personalizationConsent = 'true';
          banner.setAttribute('role', 'dialog');
          banner.setAttribute('aria-live', 'polite');
          banner.innerHTML = `<p><strong>Настроить рекомендации?</strong> Лайки и отметки «не интересно» сохранятся только в этом браузере и помогут убрать неподходящее.</p><div class="personalization-consent__actions"><button type="button" class="secondary-button" data-personalization-consent-dismiss>Пока нет</button><button type="button" class="cta-button" data-personalization-consent-accept>ОК</button></div>`;
          document.body.appendChild(banner);
          banner.querySelector('[data-personalization-consent-dismiss]')?.addEventListener('click', () => {
            pendingConsentAction = null;
            banner.classList.remove('is-visible');
          });
          banner.querySelector('[data-personalization-consent-accept]')?.addEventListener('click', async () => {
            ensureProfileAfterConsent();
            banner.classList.remove('is-visible');
            const action = pendingConsentAction;
            pendingConsentAction = null;
            await applyFeedbackState();
            if (typeof action === 'function') setTimeout(action, 0);
          });
          return banner;
        }

        function requestConsent(action) {
          pendingConsentAction = action || null;
          consentBanner().classList.add('is-visible');
        }

        function mapScore(map, key) {
          if (!map || key == null) return 0;
          const value = map[key];
          const num = Number(value || 0);
          return Number.isFinite(num) ? num : 0;
        }

        function collectWeightedProfileMap(profile, fieldName) {
          const result = { ...(profile && profile[fieldName] ? profile[fieldName] : {}) };
          const horizons = [
            ['session', 1.0],
            ['short', 0.65],
            ['mid', 0.35],
            ['long', 0.20],
          ];
          for (const [horizon, weight] of horizons) {
            const section = profile && profile[horizon];
            if (!section || !section[fieldName]) continue;
            for (const [key, value] of Object.entries(section[fieldName])) {
              result[key] = mapScore(result, key) + Number(value || 0) * weight;
            }
          }
          return result;
        }

        function candidateId(candidate) {
          return candidate && (candidate.event_id != null ? candidate.event_id : candidate.id);
        }

        function currentEventId(manifest) {
          if (!manifest) return null;
          if (manifest.current_event && manifest.current_event.event_id != null) return manifest.current_event.event_id;
          return manifest.event_id != null ? manifest.event_id : null;
        }

        function displayOf(candidate) {
          return candidate && candidate.display ? candidate.display : (candidate || {});
        }

        function candidatePositiveMatchingTags(candidate) {
          if (!candidate) return [];
          const display = displayOf(candidate);
          const values = [];
          for (const key of ['category', 'event_type']) {
            if (candidate[key]) values.push(String(candidate[key]));
            if (display[key]) values.push(String(display[key]));
          }
          for (const key of ['tags', 'audience_tags', 'format_tags', 'time_tags', 'price_tags']) {
            for (const item of toArray(candidate[key])) values.push(String(item));
          }
          for (const reason of toArray(candidate.reason_codes)) {
            const text = String(reason);
            if (text.startsWith('tag:')) values.push(text.slice(4));
            if (text.startsWith('same_category:')) values.push(text.slice('same_category:'.length));
          }
          return unique(values);
        }

        function hiddenSet(profile) {
          return new Set([
            ...toArray(profile && profile.hidden_event_ids).map(asId),
            ...toArray(profile && profile.not_interested_event_ids).map(asId),
          ]);
        }

        function likedSet(profile) {
          return new Set(toArray(profile && profile.liked_event_ids).map(asId));
        }

        function staticCandidateScore(candidate) {
          const raw = candidate && (candidate.static_score != null ? candidate.static_score : candidate.base_similarity);
          const score = Number(raw || 0);
          if (!Number.isFinite(score)) return 0;
          return Math.max(0, Math.min(1, score));
        }

        function isCancelledLike(candidate) {
          const lifecycle = String((candidate && candidate.lifecycle_status) || '').toLowerCase();
          const status = String((candidate && (candidate.status || candidate.ticket_status)) || '').toLowerCase();
          return ['cancelled', 'postponed', 'duplicate', 'merged'].includes(lifecycle) || ['cancelled', 'postponed'].includes(status);
        }

        function tagAffinity(candidate, profile) {
          const positive = collectWeightedProfileMap(profile || {}, 'positive_tags');
          const positiveCategories = collectWeightedProfileMap(profile || {}, 'positive_categories');
          let sum = 0;
          for (const tag of candidatePositiveMatchingTags(candidate)) sum += mapScore(positive, tag);
          if (candidate && candidate.category) sum += mapScore(positiveCategories, candidate.category);
          return Math.min(1.5, sum / 2);
        }

        function negativeInterestPenalty(candidate, profile) {
          const negative = collectWeightedProfileMap(profile || {}, 'negative_interest_tags');
          let penalty = 0;
          for (const tag of candidatePositiveMatchingTags(candidate)) penalty += Math.max(0, mapScore(negative, tag));
          return Math.min(1.5, penalty);
        }

        function priceMatch(candidate, profile) {
          if (!profile || !profile.price_preferences) return 0;
          if (profile.price_preferences.prefer_free && candidate && candidate.is_free) return 1;
          return 0;
        }

        function timeMatch(candidate, profile) {
          const prefs = collectWeightedProfileMap(profile || {}, 'positive_time_tags');
          let score = 0;
          for (const tag of toArray(candidate && candidate.time_tags)) score += mapScore(prefs, tag);
          for (const tag of candidatePositiveMatchingTags(candidate)) {
            if (tag === 'evening' || tag === 'daytime') score += mapScore(prefs, tag);
          }
          return Math.min(1, score);
        }

        function fatiguePenalty(candidate, profile) {
          if (!profile) return 0;
          const id = asId(candidateId(candidate));
          const venue = asId(candidate && (candidate.venue_id || candidate.location_name));
          let penalty = 0;
          if (new Set(toArray(profile.seen_event_ids).map(asId)).has(id)) penalty += 0.7;
          if (venue && new Set(toArray(profile.seen_venue_ids).map(asId)).has(venue)) penalty += 0.35;
          return Math.min(1, penalty);
        }

        function isEligibleCandidate(candidate, manifest, profile) {
          if (!candidate) return false;
          const id = candidateId(candidate);
          if (id == null) return false;
          if (asId(id) === asId(currentEventId(manifest))) return false;
          if (isCancelledLike(candidate)) return false;
          if (profileHasConsent(profile) && hiddenSet(profile).has(asId(id))) return false;
          if (profileHasConsent(profile) && negativeInterestPenalty(candidate, profile) >= NEGATIVE_HARD_FILTER_THRESHOLD) return false;
          return true;
        }

        function scoreRelatedCandidate(candidate, manifest, profile) {
          const weights = DEFAULT_WEIGHTS;
          const base = staticCandidateScore(candidate);
          if (!profileHasConsent(profile)) {
            return { score: base, base_similarity: base, reason_codes: toArray(candidate && candidate.reason_codes).slice() };
          }
          const affinity = tagAffinity(candidate, profile);
          const negative = negativeInterestPenalty(candidate, profile);
          const fatigue = fatiguePenalty(candidate, profile);
          const price = priceMatch(candidate, profile);
          const time = timeMatch(candidate, profile);
          const soldOut = String((candidate && (candidate.status || candidate.ticket_status)) || '').toLowerCase() === 'sold_out' ? 1 : 0;
          const exploration = candidate && candidate.exploration_candidate ? 1 : 0;
          const explicitLike = likedSet(profile).has(asId(candidateId(candidate))) ? 1 : 0;
          const score =
            weights.staticContext * base +
            weights.profileAffinity * affinity +
            weights.priceMatch * price +
            weights.timeMatch * time +
            weights.explicitLike * explicitLike +
            weights.exploration * exploration -
            weights.negativeInterest * negative -
            weights.fatigue * fatigue -
            weights.soldOut * soldOut;
          const reasonCodes = toArray(candidate && candidate.reason_codes).slice();
          if (affinity > 0) reasonCodes.push('profile:positive_affinity');
          if (explicitLike > 0) reasonCodes.push('profile:explicit_like');
          if (negative > 0) reasonCodes.push('profile:negative_interest_penalty');
          if (fatigue > 0) reasonCodes.push('profile:fatigue_penalty');
          if (price > 0) reasonCodes.push('profile:price_match');
          return { score, base_similarity: base, reason_codes: unique(reasonCodes) };
        }

        function applyDiversity(sorted, options = {}) {
          const maxSameCategory = options.maxSameCategory == null ? 3 : Number(options.maxSameCategory);
          const maxSameVenue = options.maxSameVenue == null ? 2 : Number(options.maxSameVenue);
          const result = [];
          const postponed = [];
          const categoryCounts = new Map();
          const venueCounts = new Map();
          for (const item of sorted) {
            const candidate = item.candidate;
            const category = candidate.category || candidate.event_type || 'unknown';
            const venue = candidate.venue_id || candidate.location_name || 'unknown';
            const catCount = categoryCounts.get(category) || 0;
            const venueCount = venueCounts.get(venue) || 0;
            if (catCount >= maxSameCategory || venueCount >= maxSameVenue) {
              postponed.push({ ...item, diversity_postponed: true });
              continue;
            }
            result.push(item);
            categoryCounts.set(category, catCount + 1);
            venueCounts.set(venue, venueCount + 1);
          }
          return result.concat(postponed);
        }

        function rankEventDetailRelated(manifest, profile, options = {}) {
          const candidates = toArray(manifest && (manifest.related_static || manifest.candidates || manifest.events));
          const active = isCompatibleProfile(profile, manifest && manifest.feature_schema_version, manifest && manifest.taxonomy_version) ? profile : null;
          const scored = [];
          for (const candidate of candidates) {
            if (!isEligibleCandidate(candidate, manifest, active)) continue;
            const scoreInfo = scoreRelatedCandidate(candidate, manifest, active);
            scored.push({ candidate, score: scoreInfo.score, base_similarity: scoreInfo.base_similarity, reason_codes: scoreInfo.reason_codes });
          }
          scored.sort((left, right) => {
            const byScore = right.score - left.score;
            if (byScore !== 0) return byScore;
            const byBase = right.base_similarity - left.base_similarity;
            if (byBase !== 0) return byBase;
            return Number(candidateId(left.candidate) || 0) - Number(candidateId(right.candidate) || 0);
          });
          return applyDiversity(scored, options).map((item, index) => ({
            event_id: candidateId(item.candidate),
            candidate: item.candidate,
            rank: index,
            personal_score: Number(item.score.toFixed(4)),
            base_similarity: Number(item.base_similarity.toFixed(4)),
            reason_codes: item.reason_codes,
            diversity_postponed: Boolean(item.diversity_postponed),
          }));
        }

        function normalizeManifest(payload, feed) {
          if (payload && Array.isArray(payload.related_static)) return payload;
          const events = toArray(payload && payload.events).map((item, index) => ({
            event_id: item.id ?? item.event_id,
            title: item.title || 'Событие',
            category: item.event_type || 'event',
            tags: unique([item.event_type]),
            audience_exclusion_tags: [],
            city: item.city || null,
            location_name: item.venue_name || null,
            date: item.date || item.display_date || '',
            status: item.status_label || 'available',
            lifecycle_status: 'active',
            is_free: item.price_label === 'Бесплатно',
            base_similarity: Math.max(0, 1 - index * 0.01),
            static_score: Math.max(0, 1 - index * 0.01),
            reason_codes: ['legacy_json_payload'],
            exploration_candidate: false,
            display: item,
          }));
          return {
            version: payload?.version || 1,
            schema_version: FEATURE_SCHEMA_VERSION,
            feature_schema_version: FEATURE_SCHEMA_VERSION,
            taxonomy_version: TAXONOMY_VERSION,
            surface: SURFACE_EVENT_DETAIL_RELATED,
            algorithm_id: STATIC_ALGORITHM_ID,
            event_id: Number(feed?.dataset.currentEventId || payload?.event_id || 0),
