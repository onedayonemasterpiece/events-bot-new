      .preview-ab__grid { display: grid; gap: 0.65rem; }
      .preview-ab__item { min-height: 96px; display: grid; gap: 0.35rem; align-content: start; padding: 0.85rem; border: 1px solid rgba(121,48,20,0.13); border-radius: 18px; background: #fffdf8; color: inherit; text-decoration: none; }
