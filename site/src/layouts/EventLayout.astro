---
import { SITE_NAME, SITE_ORIGIN, withBase } from '../lib/events';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string | null;
  structuredData?: unknown[];
}

const { title, description, canonicalUrl, ogImage, structuredData = [] } = Astro.props;
const robots = 'noindex,nofollow,noarchive';
const safeDescription = description || 'Анонс события в Калининградской области.';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f7efe3" />
    <meta name="format-detection" content="telephone=yes" />
    {structuredData.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <style is:global>
      :root {
        --bg: #fbf7ef;
        --bg-soft: #f2e7d7;
        --surface: #fffdf8;
        --surface-strong: #ffffff;
        --text: #221a14;
        --muted: #6d6259;
        --line: #e1d3c2;
        --primary: #a54821;
        --primary-strong: #793014;
        --primary-text: #ffffff;
        --accent: #0f766e;
        --accent-soft: #d7f0ec;
        --warning: #a16207;
        --shadow: 0 18px 45px rgba(72, 45, 25, 0.12);
        --radius-xl: 28px;
        --radius-lg: 20px;
        --radius-md: 14px;
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; scroll-behavior: smooth; }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(165, 72, 33, 0.12), transparent 32rem),
          linear-gradient(180deg, #fff8ed 0%, var(--bg) 42%, #f7efe3 100%);
        color: var(--text);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.1;
        background-image: linear-gradient(rgba(121, 48, 20, 0.035) 1px, transparent 1px);
        background-size: 28px 28px;
      }
      a { color: inherit; text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible { outline: 3px solid rgba(15, 118, 110, 0.65); outline-offset: 3px; }
      img { display: block; max-width: 100%; height: auto; }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: 1rem;
        z-index: 20;
        transform: translateY(-180%);
        background: var(--text);
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 999px;
      }
      .skip-link:focus { transform: translateY(0); }
      .site-header {
        position: relative;
        z-index: 2;
        border-bottom: 1px solid rgba(121, 48, 20, 0.12);
        background: rgba(255, 253, 248, 0.86);
      }
      .site-header__inner {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .brand { display: inline-flex; flex-direction: column; text-decoration: none; line-height: 1.1; min-height: 44px; justify-content: center; }
      .brand__name { font-weight: 800; letter-spacing: -0.02em; }
      .brand__sub { color: var(--muted); font-size: 0.82rem; }
      .site-nav { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
      .site-nav a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.8rem;
        border: 1px solid transparent;
        border-radius: 999px;
        color: var(--muted);
        text-decoration: none;
      }
      .site-nav a:hover { color: var(--text); border-color: var(--line); background: #fff; }
      .page-shell { position: relative; z-index: 1; width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
      main { padding: 1.2rem 0 5.5rem; }
      .crumbs { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin: 0.5rem 0 1rem; color: var(--muted); font-size: 0.92rem; }
      .crumbs a { min-height: 32px; display: inline-flex; align-items: center; color: var(--primary-strong); }
      .event-grid { display: grid; gap: 1rem; }
      .main-col, .side-col { min-width: 0; }
      .section-card {
        background: rgba(255, 253, 248, 0.92);
        border: 1px solid rgba(121, 48, 20, 0.13);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow);
      }
      .section-card--quiet { box-shadow: none; background: rgba(255, 253, 248, 0.74); }
      .section-card__inner { padding: clamp(0.85rem, 2.8vw, 1.55rem); }
      .eyebrow { color: var(--primary-strong); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.5rem; }
      h1, h2, h3 { line-height: 1.08; letter-spacing: -0.035em; margin: 0; }
      h1 { font-size: clamp(1.8rem, 6vw, 3.7rem); max-width: 16ch; overflow-wrap: anywhere; }
      h2 { font-size: clamp(1.35rem, 3.4vw, 2rem); margin-bottom: 0.8rem; }
      h3 { font-size: 1.18rem; margin: 1.35rem 0 0.55rem; }
      .lead { font-size: clamp(1rem, 2.2vw, 1.18rem); color: #44362d; max-width: 58ch; margin: 0.85rem 0 0; }
      .badge-row { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.8rem 0 0; }
      .badge {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--line);
        background: #fffaf1;
        color: #4d3829;
        border-radius: 999px;
        padding: 0.28rem 0.7rem;
        font-size: 0.88rem;
        font-weight: 700;
      }
      .badge--status { background: var(--accent-soft); color: #0f544f; border-color: rgba(15, 118, 110, 0.2); }
      .hero-media { margin: 1rem auto 0; border-radius: 24px; overflow: hidden; border: 1px solid rgba(121, 48, 20, 0.14); background: #15110f; }
      .hero-media--cover { position: relative; aspect-ratio: 3 / 4; max-height: min(78dvh, 820px); background: radial-gradient(circle at 50% 20%, rgba(255,255,255,0.18), transparent 16rem), #15110f; }
      .hero-media--cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
      .hero-media--preserve { background: #15110f; }
      .hero-media--preserve img { display: block; width: 100%; height: auto; }
      .hero-fallback { width: 100%; height: 100%; display: grid; place-items: center; padding: 1.5rem; color: #fff; text-align: center; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.32), transparent 20rem), linear-gradient(135deg, #8a3f23, #1d5f5a); }
      .hero-fallback strong { display:block; max-width: 18ch; font-size: clamp(1.5rem, 5vw, 3.2rem); line-height: 1; letter-spacing: -0.04em; }
      .facts-quick { display: grid; gap: 0.65rem; margin-top: 0.85rem; }
      .facts-quick--compact { grid-template-columns: 1fr; }
      .quick-fact { display: flex; gap: 0.65rem; padding: 0.7rem; border-radius: 16px; background: rgba(242, 231, 215, 0.64); min-width: 0; }
      .quick-fact__mark { width: 0.45rem; flex: 0 0 0.45rem; border-radius: 999px; background: var(--primary); }
      .quick-fact strong { display: block; font-size: 0.82rem; color: var(--muted); font-weight: 700; }
      .quick-fact span { display: block; overflow-wrap: anywhere; }
      .prose { margin-top: 1rem; color: #3b3029; max-width: 68ch; }
      .prose p { margin: 0 0 0.95rem; }
      .prose blockquote { margin: 0 0 1rem; padding: 1rem 1.1rem; border-left: 4px solid var(--primary); background: #fff4e6; border-radius: 0 18px 18px 0; color: #33251d; }
      .prose ul { margin: 0 0 1rem 1.2rem; padding: 0; }
      .details-list { display: grid; gap: 0.7rem; margin: 0; }
      .details-list div { display: grid; gap: 0.15rem; padding: 0 0 0.7rem; border-bottom: 1px solid rgba(121, 48, 20, 0.12); }
      .details-list div:last-child { border-bottom: 0; padding-bottom: 0; }
      .details-list dt { color: var(--muted); font-size: 0.86rem; font-weight: 700; }
      .details-list dd { margin: 0; overflow-wrap: anywhere; }
      .cta-panel { padding: 1rem; }
      .cta-panel__top { display: grid; gap: 0.8rem; }
      .cta-panel__date { font-size: 1.35rem; font-weight: 850; letter-spacing: -0.03em; line-height: 1.12; }
      .cta-button, .secondary-button {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0.8rem 1rem;
        font-weight: 850;
        text-decoration: none;
        border: 1px solid transparent;
        text-align: center;
      }
      .cta-button { background: var(--primary); color: var(--primary-text); box-shadow: 0 12px 24px rgba(121, 48, 20, 0.2); }
      .cta-button:hover { background: var(--primary-strong); }
      .secondary-button { background: #fff; color: var(--primary-strong); border-color: var(--line); }
      .secondary-button:hover { background: #fff6ea; }
      .icon { width: 1.15em; height: 1.15em; flex: 0 0 auto; fill: currentColor; }
      .icon--share { fill: currentColor; stroke: none; }
      .action-grid { display: grid; grid-template-columns: 1fr; gap: 0.55rem; margin-top: 0.75rem; }
      .native-share-button { cursor: pointer; }
      .share-list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.85rem 0 0; padding: 0; list-style: none; }
      .share-list a { min-height: 44px; display: inline-flex; align-items: center; border-radius: 999px; padding: 0.45rem 0.75rem; border: 1px solid var(--line); background: #fff; color: var(--primary-strong); text-decoration: none; font-weight: 750; }
      .muted-note { color: var(--muted); font-size: 0.88rem; margin: 0.65rem 0 0; }
      .cards-grid { display: grid; gap: 0.9rem; }
      .cards-grid--immersive { grid-template-columns: 1fr; gap: 1rem; }
      .cards-grid--immersive .event-card__media-shell--cover { aspect-ratio: 3 / 4; }
      .cards-grid--feed {
        grid-auto-flow: column;
        grid-auto-columns: clamp(172px, 48vw, 220px);
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: x mandatory;
        padding: 0.1rem 0.15rem 0.8rem;
        margin-inline: -0.15rem;
      }
      .event-card {
        position: relative;
        display: grid;
        overflow: hidden;
        border: 1px solid rgba(121,48,20,0.13);
        border-radius: 24px;
        background: #15110f;
        color: #fff;
        min-height: 0;
        box-shadow: 0 14px 34px rgba(72,45,25,0.16);
        scroll-snap-align: start;
      }
      .event-card:hover { border-color: rgba(165,72,33,0.48); box-shadow: 0 18px 38px rgba(72,45,25,0.2); }
      .event-card__media-link { display: block; color: inherit; text-decoration: none; background: #15110f; }
      .event-card__media-shell { display: block; width: 100%; overflow: hidden; background: #15110f; }
      .event-card__media-shell--cover { position: relative; aspect-ratio: 3 / 4; background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.22), transparent 15rem), linear-gradient(135deg, #8a3f23, #0f766e); }
      .event-card__media-shell--cover .event-card__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
      .event-card__media-shell--preserve { background: #15110f; }
      .event-card__media-shell--preserve .event-card__media { display: block; width: 100%; height: auto; }
      .event-card__fallback { min-height: 100%; display: grid; align-content: space-between; gap: 0.7rem; padding: 1rem; color: rgba(255,255,255,0.9); font-weight: 850; text-transform: uppercase; letter-spacing: 0.08em; }
      .event-card__fallback strong { font-size: clamp(1.15rem, 5vw, 1.55rem); line-height: 1; letter-spacing: -0.04em; }
      .event-card__body { display: grid; gap: 0.5rem; padding: 0.85rem 0.85rem 4.85rem; }
      .event-card__meta-row { display: grid; gap: 0.35rem; }
      .event-card__meta { color: rgba(255,255,255,0.74); font-weight: 750; font-size: 0.82rem; line-height: 1.25; }
      .event-card__status { width: max-content; max-width: 100%; min-height: 28px; display: inline-flex; align-items: center; border-radius: 999px; padding: 0.22rem 0.55rem; background: rgba(215,240,236,0.16); border: 1px solid rgba(215,240,236,0.28); color: #d7f0ec; font-size: 0.75rem; font-weight: 850; line-height: 1.15; }
      .event-card__title { color: #fff; text-decoration: none; font-weight: 900; line-height: 1.08; font-size: clamp(1.03rem, 4.2vw, 1.35rem); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .event-card__title:hover { text-decoration: underline; text-decoration-thickness: 0.08em; }
      .event-card__footer { color: rgba(255,255,255,0.84); font-weight: 760; font-size: 0.86rem; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
      .event-card__feedback { position: absolute; left: 0.65rem; right: 0.65rem; bottom: 0.65rem; z-index: 6; display: grid; grid-template-columns: 52px minmax(132px, 1fr) 88px; align-items: end; gap: 0.38rem; pointer-events: none; }
      .feedback-button { pointer-events: auto; min-height: 52px; border: 1px solid rgba(255,255,255,0.22); border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; gap: 0.42rem; color: #fff; background: rgba(15,17,15,0.7); font: inherit; font-weight: 900; box-shadow: 0 14px 26px rgba(0,0,0,0.28); cursor: pointer; touch-action: manipulation; }
      .feedback-button .icon { width: 1.25rem; height: 1.25rem; }
      .feedback-count:empty { display: none; }
      .feedback-button--like { min-width: 88px; padding: 0.44rem 0.58rem; font-size: 1.04rem; }
      .feedback-button--share { min-width: 0; padding: 0.5rem 0.55rem; color: rgba(229,235,244,0.96); font-size: 0.84rem; white-space: nowrap; }
      .feedback-button--share .icon { width: 1.28rem; height: 1.28rem; }
      .feedback-button--share .share-label { display: inline; }
      .event-card.is-share-prompt .feedback-button--share { color: #261a13; background: rgba(255, 253, 248, 0.97); border-color: rgba(255,255,255,0.48); transform: translateY(-2px); }
      .event-card.is-share-prompt .feedback-button--share .share-label { display: inline; }
      .feedback-button--negative { min-width: 52px; padding: 0.48rem 0.62rem; color: rgba(255,255,255,0.88); font-size: 0.72rem; }
      .feedback-button--negative .icon { width: 1rem; height: 1rem; }
      .feedback-button[aria-pressed="true"] { border-color: rgba(255,255,255,0.48); }
      .feedback-button--like[aria-pressed="true"] { color: #fff; background: #c93434; }
      .feedback-button--negative[aria-pressed="true"] { color: #1f1712; background: #f7efe3; }
      .event-card.is-not-interested { filter: grayscale(1) saturate(0.08); }
      .event-card.is-not-interested::before { content: ""; position: absolute; inset: 0; z-index: 4; background: rgba(43,43,43,0.78); pointer-events: none; }
      .event-card.is-not-interested::after { content: "Вы пометили: не интересует"; position: absolute; left: 1rem; right: 1rem; top: 50%; z-index: 5; transform: translateY(-50%); padding: 0.95rem 1rem; border: 1px solid rgba(255,255,255,0.25); border-radius: 18px; background: rgba(245,245,245,0.92); color: #2d2d2d; font-weight: 950; text-align: center; pointer-events: none; box-shadow: 0 12px 28px rgba(0,0,0,0.22); }
      .like-burst { position: absolute; left: 50%; top: 48%; z-index: 7; pointer-events: none; transform: translate(-50%, -50%); }
      .like-burst span { position: absolute; left: 0; top: 0; color: #fff; text-shadow: 0 8px 22px rgba(0,0,0,0.45); font-size: 2rem; animation: heart-fly 760ms ease-out forwards; }
      .like-burst span:nth-child(2) { color: #ffdfdf; animation-delay: 40ms; --x: -42px; --r: -16deg; }
      .like-burst span:nth-child(3) { color: #ffb7b7; animation-delay: 80ms; --x: 38px; --r: 14deg; }
      .like-burst span:nth-child(4) { color: #fff4f4; animation-delay: 120ms; --x: 4px; --r: 8deg; }
      @keyframes heart-fly { from { opacity: 0; transform: translate(-50%, -20%) scale(0.7) rotate(0deg); } 18% { opacity: 1; } to { opacity: 0; transform: translate(calc(-50% + var(--x, 0px)), -150px) scale(1.25) rotate(var(--r, 0deg)); } }
      .listing-stack { display: grid; gap: 0.85rem; }
      .listing-item { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 0.85rem; align-items: stretch; padding: 0.75rem; border: 1px solid rgba(121,48,20,0.13); border-radius: 22px; background: #fffdf8; }
      .listing-item__media { display: block; border-radius: 18px; overflow: hidden; background: #15110f; text-decoration: none; align-self: start; }
      .listing-item__media--cover { position: relative; min-height: 138px; aspect-ratio: 3 / 4; background: linear-gradient(135deg, #8a3f23, #0f766e); }
      .listing-item__media--cover .listing-item__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
      .listing-item__media--preserve { background: #15110f; }
      .listing-item__media--preserve .listing-item__image { display: block; width: 100%; height: auto; }
      .listing-item__fallback { width: 100%; height: 100%; min-height: 138px; display: grid; place-items: center; color: #fff; padding: 0.7rem; text-align: center; font-weight: 900; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.07em; }
      .listing-item__body { min-width: 0; display: grid; gap: 0.42rem; align-content: center; }
      .listing-item__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; color: var(--muted); font-size: 0.84rem; font-weight: 800; }
      .listing-item__title { color: var(--text); text-decoration: none; font-size: clamp(1.08rem, 3.8vw, 1.35rem); line-height: 1.12; font-weight: 900; overflow-wrap: anywhere; }
      .listing-item__title:hover { text-decoration: underline; }
      .listing-item p { margin: 0; color: var(--muted); font-weight: 700; }
      .listing-item__actions { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.2rem; }
      .listing-item__actions .cta-button, .listing-item__actions .secondary-button { min-height: 44px; padding: 0.55rem 0.75rem; font-size: 0.9rem; }
      .sponsor-card { border-style: dashed; background: linear-gradient(135deg, #fff, #fff4e6); }
      .source-links { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.85rem; }
      .source-links a, .source-links button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 0.8rem; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; color: var(--primary-strong); background: #fff; font: inherit; font-weight: 850; }
      .source-links .cta-button { color: var(--primary-text); background: var(--primary); border-color: transparent; padding: 0.75rem 1rem; }
      .mobile-sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 0.7rem max(1rem, env(safe-area-inset-left)) calc(0.7rem + env(safe-area-inset-bottom)); background: rgba(255, 253, 248, 0.94); border-top: 1px solid var(--line); box-shadow: 0 -12px 30px rgba(72,45,25,0.12); transition: transform 180ms ease, opacity 180ms ease; }
      .mobile-sticky-cta.is-hidden { transform: translateY(120%); opacity: 0; pointer-events: none; }
      .mobile-sticky-cta__inner { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 0.75rem; align-items: center; }
      .mobile-sticky-cta__title { min-width: 0; }
      .mobile-sticky-cta__title strong { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .mobile-sticky-cta__title span { display: block; color: var(--muted); font-size: 0.86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      footer { position: relative; z-index: 1; border-top: 1px solid var(--line); padding: 2rem 0 6rem; color: var(--muted); }
      .details-disclosure summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 900; font-size: 1.08rem; }
      .details-disclosure summary::marker { color: var(--primary); }
      .preview-warning { margin: 1rem 0; border: 1px solid rgba(161,98,7,0.24); background: #fff8db; color: #5a3b06; border-radius: 18px; padding: 0.8rem 1rem; }
      .feedback-report { display: grid; gap: 0.75rem; }
      .feedback-report__summary { display: grid; gap: 0.35rem; color: var(--muted); font-weight: 750; }
      .feedback-report__list { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
      .feedback-report__list li { padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 14px; background: #fff; }

      @media (min-width: 760px) {
        .facts-quick { grid-template-columns: repeat(2, 1fr); }
        .action-grid { grid-template-columns: 1fr 1fr; }
        .cards-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cards-grid--immersive { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .cards-grid--feed { grid-auto-flow: row; grid-auto-columns: initial; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; overscroll-behavior-inline: auto; scroll-snap-type: none; padding: 0; margin-inline: 0; }
      }
      @media (max-width: 1023px) {
        .side-col { display: none; }
      }
      @media (min-width: 1024px) {
        main { padding-top: 2rem; padding-bottom: 3rem; }
        .event-grid { grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr); gap: 1.25rem; align-items: start; }
        .side-col { position: sticky; top: 1rem; }
        .event-main-actions { display: none; }
        .cards-grid--immersive { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .cards-grid--feed { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .mobile-sticky-cta { display: none; }
        footer { padding-bottom: 2rem; }
      }
      @media (max-width: 560px) {
        .site-header__inner { width: min(100% - 24px, 1180px); min-height: 64px; }
        .site-nav a:nth-child(n+3) { display: none; }
        .page-shell { width: min(100% - 24px, 1180px); }
        .section-card { border-radius: 22px; }
        .section-card__inner { padding: 1rem; }
        .cta-button, .secondary-button { width: 100%; }
        .feedback-button--negative span { display: none; }
        .event-card__feedback { grid-template-columns: 48px minmax(118px, 1fr) 82px; gap: 0.28rem; left: 0.56rem; right: 0.56rem; }
        .feedback-button--share { padding-inline: 0.46rem; font-size: 0.82rem; }
        .feedback-button--share .icon { width: 1.18rem; height: 1.18rem; }
        .feedback-button--like { min-width: 82px; padding-inline: 0.5rem; }
        .mobile-sticky-cta__inner { grid-template-columns: minmax(0, 1fr); }
        .mobile-sticky-cta__title { display: none; }
        .listing-item { grid-template-columns: 88px minmax(0, 1fr); gap: 0.65rem; padding: 0.65rem; }
        .listing-item__media, .listing-item__fallback { min-height: 120px; }
        .listing-item__actions .cta-button, .listing-item__actions .secondary-button { width: auto; flex: 1 1 120px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к событию</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/__preview/')} aria-label={`${SITE_NAME}: preview index`}>
          <span class="brand__name">{SITE_NAME}</span>
          <span class="brand__sub">афиша событий</span>
        </a>
        <nav class="site-nav" aria-label="Основная навигация preview">
          <a href={withBase('/segodnya/')}>Сегодня</a>
          <a href={withBase('/vyhodnye/')}>Выходные</a>
          <a href={withBase('/sitemap.xml')}>Sitemap</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer>
      <div class="page-shell">
        <strong>{SITE_NAME}</strong>
        <p>Preview-сборка статических страниц событий. Роботам закрыто через meta robots и robots.txt.</p>
        <p>Домен: {SITE_ORIGIN}. Все preview canonical URL содержат текущий prefix.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const PROFILE_KEY = 'ke_profile_id_v1';
        const STATE_KEY = 'ke_event_feedback_state_v1';
        const LOG_KEY = 'ke_event_feedback_log_v1';
        const SHARE_PROMPT_KEY = 'ke_like_share_prompt_count_v1';
        const MAX_LOG = 240;
        const MAX_SHARE_PROMPTS_PER_SESSION = 2;
        let shareCalloutTimer = 0;

        function readJson(key, fallback) {
          try {
            const raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : fallback;
          } catch (_) {
            return fallback;
          }
        }

        function writeJson(key, value) {
          try {
            localStorage.setItem(key, JSON.stringify(value));
          } catch (_) {
            // localStorage can be disabled in private/webview modes; UI remains usable.
          }
        }

        function profileId() {
          try {
            const existing = localStorage.getItem(PROFILE_KEY);
            if (existing) return existing;
            const generated = crypto.randomUUID ? crypto.randomUUID() : `anon-${Date.now()}-${Math.random().toString(16).slice(2)}`;
            localStorage.setItem(PROFILE_KEY, generated);
            return generated;
          } catch (_) {
            return 'anon-local-unavailable';
          }
        }

        function state() {
          return readJson(STATE_KEY, {});
        }

        function saveState(next) {
          writeJson(STATE_KEY, next);
        }

        function appendLog(entry) {
          const log = readJson(LOG_KEY, []);
          log.push({ profile_id: profileId(), page: location.pathname, ts: new Date().toISOString(), ...entry });
          writeJson(LOG_KEY, log.slice(-MAX_LOG));
        }

        function eventState(map, eventId) {
          return map[String(eventId)] || { liked: false, not_interested: false, shares: 0 };
        }

        function hideLikeShareCallouts() {
          window.clearTimeout(shareCalloutTimer);
          shareCalloutTimer = 0;
          document.querySelectorAll('[data-event-card].is-share-prompt').forEach((card) => {
            card.classList.remove('is-share-prompt');
          });
        }

        function showLikeShareCallout(card) {
          if (!card) return;
          let count = 0;
          try { count = Number(sessionStorage.getItem(SHARE_PROMPT_KEY) || '0'); } catch (_) {}
          if (count >= MAX_SHARE_PROMPTS_PER_SESSION) return;
          const shareButton = card.querySelector('.feedback-button--share');
          if (!shareButton) return;
          hideLikeShareCallouts();
          card.classList.add('is-share-prompt');
          try { sessionStorage.setItem(SHARE_PROMPT_KEY, String(count + 1)); } catch (_) {}
          shareCalloutTimer = window.setTimeout(() => {
            card.classList.remove('is-share-prompt');
          }, 4000);
        }

        function animateLikeBurst(card) {
          if (!card) return;
          card.querySelectorAll('.like-burst').forEach((node) => node.remove());
          const burst = document.createElement('span');
          burst.className = 'like-burst';
          burst.setAttribute('aria-hidden', 'true');
          for (let index = 0; index < 4; index += 1) {
            const heart = document.createElement('span');
            heart.textContent = '♥';
            burst.appendChild(heart);
          }
          card.appendChild(burst);
          setTimeout(() => burst.remove(), 950);
        }

        function setCardLike(card, liked, action = 'like_event') {
          const eventId = card?.dataset.eventId;
          if (!eventId) return;
          const map = state();
          const current = eventState(map, eventId);
          if (Boolean(current.liked) === Boolean(liked)) {
            if (liked) {
              animateLikeBurst(card);
              showLikeShareCallout(card);
            }
            return;
          }
          const title = card.dataset.eventTitle || '';
          map[String(eventId)] = { ...current, liked: Boolean(liked), not_interested: liked ? false : current.not_interested };
          appendLog({ event_id: Number(eventId), event_title: title, action });
          saveState(map);
          applyFeedbackState({ anchorEventId: eventId });
          if (liked) {
            animateLikeBurst(card);
            showLikeShareCallout(document.querySelector(`[data-event-card][data-event-id="${CSS.escape(String(eventId))}"]`) || card);
          } else {
            hideLikeShareCallouts();
          }
        }

        function rerankFeed(feed, map, anchorEventId) {
          const cards = Array.from(feed.querySelectorAll(':scope > [data-event-card]'));
          const score = (value) => (value.liked ? 100 : 0) - (value.not_interested ? 100 : 0);
          if (anchorEventId) {
            const anchorIndex = cards.findIndex((card) => String(card.dataset.eventId) === String(anchorEventId));
            if (anchorIndex >= 0) {
              const frozen = cards.slice(0, anchorIndex + 1);
              const tail = cards.slice(anchorIndex + 1).sort((a, b) => {
                const av = eventState(map, a.dataset.eventId);
                const bv = eventState(map, b.dataset.eventId);
                return score(bv) - score(av);
              });
              [...frozen, ...tail].forEach((card) => feed.appendChild(card));
              return;
            }
          }
          cards.sort((a, b) => {
            const av = eventState(map, a.dataset.eventId);
            const bv = eventState(map, b.dataset.eventId);
            return score(bv) - score(av);
          }).forEach((card) => feed.appendChild(card));
        }

        function formatCount(value) {
          const number = Number(value || 0);
          return number > 0 ? String(number) : '';
        }

        function applyFeedbackState(options = {}) {
          const map = state();
          const cards = document.querySelectorAll('[data-event-card]');
          cards.forEach((card) => {
            const eventId = card.dataset.eventId;
            const current = eventState(map, eventId);
            card.classList.toggle('is-liked', Boolean(current.liked));
            card.classList.toggle('is-not-interested', Boolean(current.not_interested));
            card.querySelectorAll('[data-feedback-action="like"]').forEach((button) => {
              const base = Number(button.dataset.baseCount || '0');
              const localLike = current.liked ? 1 : 0;
              button.setAttribute('aria-pressed', current.liked ? 'true' : 'false');
              const total = base + localLike;
              const title = card.dataset.eventTitle || 'событие';
              button.setAttribute('aria-label', total > 0 ? `${current.liked ? 'Убрать лайк' : 'Поставить лайк'}: ${title}. Сейчас ${total}` : `${current.liked ? 'Убрать лайк' : 'Поставить лайк'}: ${title}`);
              const count = button.querySelector('[data-feedback-count]');
              if (count) count.textContent = formatCount(total);
            });
            card.querySelectorAll('[data-share-count]').forEach((count) => {
              const shareButton = count.closest('[data-native-share]');
              const base = Number(shareButton?.dataset.shareBaseCount || '0');
              count.textContent = formatCount(base + Number(current.shares || 0));
            });
            card.querySelectorAll('[data-feedback-action="not_interested"]').forEach((button) => {
              button.setAttribute('aria-pressed', current.not_interested ? 'true' : 'false');
              const title = current.not_interested ? 'Вернуть в рекомендации' : 'Не интересно';
              button.setAttribute('aria-label', `${title}: ${card.dataset.eventTitle || 'событие'}`);
            });
          });
          document.querySelectorAll('[data-personalized-feed]').forEach((feed) => {
            rerankFeed(feed, map, options.anchorEventId);
          });
          renderFeedbackReport();
        }

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-feedback-action]');
          if (!button) return;
          event.preventDefault();
          event.stopPropagation();
          const eventId = button.dataset.eventId;
          if (!eventId) return;
          const map = state();
          const current = eventState(map, eventId);
          const card = button.closest('[data-event-card]');
          const title = button.dataset.eventTitle || card?.dataset.eventTitle || '';
          let shouldShowSharePrompt = false;
          if (button.dataset.feedbackAction === 'like') {
            const liked = !current.liked;
            map[String(eventId)] = { ...current, liked, not_interested: liked ? false : current.not_interested };
            appendLog({ event_id: Number(eventId), event_title: title, action: liked ? 'like_event' : 'unlike_event' });
            shouldShowSharePrompt = liked;
            if (liked) animateLikeBurst(card);
            if (!liked) hideLikeShareCallouts();
          } else if (button.dataset.feedbackAction === 'not_interested') {
            const notInterested = !current.not_interested;
            map[String(eventId)] = { ...current, liked: notInterested ? false : current.liked, not_interested: notInterested };
            appendLog({ event_id: Number(eventId), event_title: title, action: notInterested ? 'not_interested' : 'undo_not_interested' });
            hideLikeShareCallouts();
          }
          saveState(map);
          applyFeedbackState({ anchorEventId: eventId });
          if (shouldShowSharePrompt) {
            showLikeShareCallout(document.querySelector(`[data-event-card][data-event-id="${CSS.escape(String(eventId))}"]`) || card);
          }
        });

        function recordShare(button) {
          const eventId = button.dataset.shareEventId || button.closest('[data-event-card]')?.dataset.eventId;
          if (!eventId) return;
          const map = state();
          const current = eventState(map, eventId);
          const title = button.dataset.shareEventTitle || button.dataset.shareTitle || button.closest('[data-event-card]')?.dataset.eventTitle || '';
          map[String(eventId)] = { ...current, shares: Number(current.shares || 0) + 1 };
          saveState(map);
          appendLog({ event_id: Number(eventId), event_title: title, action: 'share_event' });
          applyFeedbackState({ anchorEventId: eventId });
        }

        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-native-share]');
          if (!button) return;
          event.preventDefault();
          hideLikeShareCallouts();
          const url = button.dataset.shareUrl || location.href;
          if ('share' in navigator) {
            try {
              await navigator.share({
                title: button.dataset.shareTitle || document.title,
                text: button.dataset.shareText || '',
                url,
              });
              recordShare(button);
              return;
            } catch (_) {
              return;
            }
          }
          try {
            await navigator.clipboard.writeText(url);
            const label = button.querySelector('[data-share-label]') || button.querySelector('span') || button;
            const original = label.textContent;
            label.textContent = 'Ссылка скопирована';
            setTimeout(() => { label.textContent = original || 'Поделиться'; }, 1800);
            recordShare(button);
          } catch (_) {
            location.href = url;
          }
        });

        document.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-copy-url]');
          if (!button) return;
          event.preventDefault();
          const url = button.dataset.copyUrl || location.href;
          try {
            await navigator.clipboard.writeText(url);
            const label = button.querySelector('span') || button;
            const original = label.textContent;
            label.textContent = 'Ссылка скопирована';
            setTimeout(() => { label.textContent = original || 'Скопировать ссылку'; }, 1800);
          } catch (_) {
            location.href = url;
          }
        });

        function isCardInteractiveTarget(target) {
          return Boolean(target.closest('a, button, input, textarea, select, summary, [role="button"], [data-native-share], [data-feedback-action]'));
        }

        document.addEventListener('click', (event) => {
          const card = event.target.closest('[data-event-card]');
          if (!card || isCardInteractiveTarget(event.target)) return;
          const href = card.dataset.cardHref;
          if (!href) return;
          event.preventDefault();
          location.href = href;
        });

        document.addEventListener('keydown', (event) => {
          const card = event.target.closest('[data-event-card]');
          if (!card || event.target !== card) return;
          if (event.key === 'Enter') {
            const href = card.dataset.cardHref;
            if (href) location.href = href;
          }
        });

        function prefetch(href) {
          try {
            const url = new URL(href, location.href);
            if (url.origin !== location.origin) return;
            if (document.querySelector(`link[rel="prefetch"][href="${url.href}"]`)) return;
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = url.href;
            link.as = 'document';
            document.head.appendChild(link);
          } catch (_) {}
        }

        document.addEventListener('pointerover', (event) => {
          const anchor = event.target.closest('a[data-prefetch]');
          if (anchor) prefetch(anchor.href);
        }, { passive: true });
        document.addEventListener('touchstart', (event) => {
          const anchor = event.target.closest('a[data-prefetch]');
          if (anchor) prefetch(anchor.href);
        }, { passive: true });
        const idle = window.requestIdleCallback || ((callback) => setTimeout(callback, 900));
        idle(() => document.querySelectorAll('[data-personalized-feed] a[data-prefetch]').forEach((anchor) => prefetch(anchor.href)));

        const sticky = document.querySelector('[data-sticky-cta]');
        const marker = document.querySelector('[data-hide-sticky-after]');
        if (sticky && marker && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            sticky.classList.toggle('is-hidden', entries.some((entry) => entry.isIntersecting));
          }, { rootMargin: '0px 0px -18% 0px', threshold: 0.01 });
          observer.observe(marker);
        }

        function renderFeedbackReport() {
          const root = document.querySelector('[data-feedback-report]');
          if (!root) return;
          const map = state();
          const log = readJson(LOG_KEY, []);
          const activeLikes = Object.values(map).filter((item) => item?.liked).length;
          const activeNegative = Object.values(map).filter((item) => item?.not_interested).length;
          const localShares = Object.values(map).reduce((sum, item) => sum + Number(item?.shares || 0), 0);
          const profile = root.querySelector('[data-feedback-profile]');
          const summary = root.querySelector('[data-feedback-summary]');
          const list = root.querySelector('[data-feedback-log]');
          if (profile) profile.textContent = profileId();
          if (summary) summary.textContent = `Активных лайков: ${activeLikes}. “Не интересно”: ${activeNegative}. Локальных шеров: ${localShares}. Сырых событий в локальном журнале: ${log.length}.`;
          if (list) {
            list.innerHTML = '';
            log.slice().reverse().slice(0, 30).forEach((item) => {
              const li = document.createElement('li');
              li.textContent = `${item.ts} · ${item.action} · #${item.event_id} ${item.event_title || ''}`;
              list.appendChild(li);
            });
            if (!log.length) {
              const li = document.createElement('li');
              li.textContent = 'Пока нет локальных лайков, шеров или отметок “не интересно”.';
              list.appendChild(li);
            }
          }
        }

        document.addEventListener('scroll', hideLikeShareCallouts, { passive: true });
        document.addEventListener('pointerdown', (event) => {
          if (!event.target.closest('.feedback-button--share') && !event.target.closest('[data-feedback-action="like"]')) {
            hideLikeShareCallouts();
          }
        }, { passive: true });

        applyFeedbackState();
      })();
    </script>
  </body>
</html>
