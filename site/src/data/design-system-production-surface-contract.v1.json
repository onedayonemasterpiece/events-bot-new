{
  "schema_version": "lovekgd-design-system-production-surface-contract-v1",
  "contract_id": "announcements-production-surfaces-2026-08-07",
  "selection_policy": {
    "authority": "accepted-production-release",
    "required_release_files": [
      "static-release-manifest.json",
      "production-build.json"
    ],
    "require_matching_repo_sha": true,
    "require_matching_build_id": true,
    "require_matching_snapshot": true,
    "exclude_route_prefixes": [
      "/lab/",
      "/__preview/"
    ],
    "exclude_source_prefixes": [
      "site/src/pages/lab/"
    ],
    "rule": "A page or component enters the current design-system inventory only when it is reachable from an HTML route in the accepted production artifact at the exact release SHA. Source presence alone is not production use."
  },
  "interaction_budget": {
    "plugin_open_per_update": 1,
    "maximum_user_actions": 3,
    "primary_action": "update-everything",
    "allowed_actions": [
      "check-currentness",
      "update-everything",
      "build-review-prompt"
    ],
    "forbidden_workflow": "No per-page, per-component or per-file update actions."
  },
  "evidence_viewports": [
    { "id": "mobile-390x844", "width": 390, "height": 844, "class": "mobile" },
    { "id": "mobile-430x932", "width": 430, "height": 932, "class": "mobile" },
    { "id": "tablet-768x1024", "width": 768, "height": 1024, "class": "tablet" },
    { "id": "desktop-1280x800", "width": 1280, "height": 800, "class": "desktop" },
    { "id": "desktop-1728x900", "width": 1728, "height": 900, "class": "desktop" }
  ],
  "evidence_contract": {
    "origin": "automated-tests",
    "artifact_kinds": [
      "actual",
      "approved-baseline",
      "diff"
    ],
    "required_metadata": [
      "test_id",
      "route",
      "viewport_id",
      "repo_sha",
      "build_id",
      "snapshot_id",
      "run_id",
      "captured_at",
      "sha256"
    ],
    "penpot_pages": [
      "90 — Evidence / desktop",
      "91 — Evidence / tablet",
      "92 — Evidence / mobile",
      "93 — Evidence / interaction and accessibility"
    ],
    "archetype_link_rule": "Every current archetype stores references to its actual evidence boards and the originating automated test artifacts."
  },
