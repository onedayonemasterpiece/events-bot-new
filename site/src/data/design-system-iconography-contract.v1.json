    },
    {
      "id": "reference4-legacy",
      "root": "site/public/assets/icons/reference4",
      "penpot_path": "Icon/Legacy/Reference 4",
      "classification": "legacy-until-production-proof",
      "expected_svg_files": [
        "dazzling-star.svg",
        "euro-circle.svg",
        "handshake.svg",
        "heart.svg",
        "message-circle-heart.svg",
        "palette.svg",
