    {
      "id": "transport-icons",
      "root": "site/public/assets/transport",
      "penpot_path": "Icon/Transport",
      "classification": "production-specialized-or-candidate",
      "expected_svg_files": [
        "bus-svgrepo-337651.svg"
      ]
    },
    {
      "id": "social-brand-assets",
      "root": "site/public/assets/social",
      "penpot_path": "Icon/Social/Official assets",
      "classification": "official-brand-asset",
      "expected_svg_files": [
        "max-colored-official.svg"
      ]
    }
  ],
  "linked_brand_assets": {
    "page": "10 — Brand assets",
    "pwa_root": "site/public/assets/pwa",
    "rule": "PWA and favicon artwork is linked from iconography but remains a brand/channel asset rather than a generic UI icon."
  },
  "discovery": {
    "scan_roots": [
      "site/src",
      "site/public"
    ],
    "detect": [
      "inline-svg-in-astro",
      "svg-file",
      "svg-url-reference",
      "css-mask-reference",
      "data-uri-svg",
      "icon-component-name",
      "social-icon-name"
    ],
    "report": "artifacts/design-system/iconography-inventory.json",
    "unclassified_is_publication_blocker": true,
    "duplicate_geometry_requires_review": true
  },
  "specimen_matrix": {
    "display_sizes_px": [
      16,
      20,
      24,
      32
    ],
    "control_target_px": 44,
    "backgrounds": [
      "light",
      "brand",
      "dark",
      "status"
    ],
    "states": [
      "default",
      "hover",
      "focus",
      "pressed",
      "disabled",
      "selected-when-applicable"
    ],
    "checks": [
      "viewBox-normalization",
      "optical-centering",
      "stroke-and-fill-consistency",
      "currentColor-behavior",
      "small-size-legibility",
      "forced-colors",
      "high-contrast",
      "touch-target-separation"
    ]
  },
  "accessibility": {
    "decorative": "aria-hidden=true and no duplicate accessible name",
    "informative": "role=img with a contextual accessible label",
    "action": "The enclosing control owns the accessible name; the icon remains decorative unless it conveys additional state.",
    "state_change": "A changed icon never communicates success, failure, selection or status by shape or color alone."
  },
  "consumer_graph": {
    "required_links": [
      "icon-to-source",
      "icon-to-production-consumer",
      "icon-to-component-master",
      "icon-to-archetype-instance",
      "icon-to-evidence"
    ],
    "fragmentation_flags": [
      "duplicate-semantic-name",
      "duplicate-geometry",
      "mixed-viewBox-without-optical-rule",
      "raw-inline-svg-outside-canonical-component",
      "asset-without-attribution-or-provenance",
      "production-reference-to-legacy-icon",
      "unclassified-icon"
    ]
  },
  "publication_gate": {
    "resource_graph_004_requires": [
      "zero-unclassified-production-icons",
      "all-current-icons-have-consumers",
      "all-current-icons-have-native-penpot-component-masters",
      "all-current-icons-have-source-and-license-provenance",
      "all-archetype-icon-instances-link-to-current-masters",
      "iconography-page-and-resources-match-the-single-catalog"
    ]
  }
}
