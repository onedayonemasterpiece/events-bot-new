{
  "schema_version": "lovekgd-design-system-iconography-contract-v1",
  "contract_id": "announcements-iconography-2026-08-07",
  "scope": "Brand and product iconography used by the accepted production release and represented as native Penpot resources.",
  "selection_policy": {
    "authority": "accepted-production-release",
    "require_exact_release_identity": true,
    "source_presence_is_not_usage": true,
    "current_rule": "An icon enters the current resource library only when it is referenced by a production-reachable component or by the accepted production artifact at the exact release SHA.",
    "non_current_statuses": [
      "candidate",
      "legacy",
      "unclassified",
      "unused"
    ]
  },
  "penpot": {
    "page_id": "25-iconography",
    "page_name": "25 — Iconography",
    "resource_path_prefix": "Icon",
    "sections": [
      "System and actions",
      "Navigation",
      "Status and feedback",
      "Social and external services",
      "Transport",
      "Festival and editorial categories",
      "Product-specialized symbols",
      "Optical alignment and size tests",
      "Accessibility semantics",
      "Duplicates, legacy and unclassified"
    ],
    "comment_targets": [
      "icon-component-master",
      "icon-variant",
      "icon-specimen",
      "icon-consumer-instance",
      "icon-collection-section"
    ]
  },
  "canonical_components": [
    {
      "id": "icon.ui",
      "source": "site/src/components/Icon.astro",
      "kind": "inline-svg-component",
      "status": "current-when-production-reachable",
      "names": [
        "heart",
        "comment",
        "calendar",
        "dislike",
        "share",
        "pin",
        "ticket",
        "info",
        "spark",
        "lock",
        "image",
        "phone",
        "copy",
        "check",
        "bus",
        "car",
        "walk",
        "install"
      ],
      "penpot_path": "Icon/UI",
      "required_properties": [
        "name",
        "semantic-role",
        "decorative-or-informative",
        "source-viewBox",
        "optical-size",
        "production-consumers"
      ]
    },
    {
      "id": "icon.social",
      "source": "site/src/components/SocialIcon.astro",
      "kind": "mixed-inline-and-asset-component",
      "status": "current-when-production-reachable",
      "names": [
        "telegram",
        "vk",
        "max"
      ],
      "penpot_path": "Icon/Social",
      "required_properties": [
        "service",
        "official-brand-colors",
        "decorative-or-informative",
        "source-viewBox",
        "production-consumers"
      ]
    }
  ],
  "asset_collections": [
    {
      "id": "festival-categories",
      "root": "site/public/assets/icons/festival-categories",
      "penpot_path": "Icon/Editorial/Festival category",
      "classification": "production-specialized-or-candidate",
      "expected_svg_files": [
        "103262-theatre-masks.svg",
        "389003-anchor.svg",
        "389049-book-open.svg",
        "389059-camera.svg",
        "389063-carrot.svg",
        "389241-history.svg",
        "389291-map-pin.svg",
        "389302-mic.svg",
        "389324-music.svg",
        "389330-palette.svg",
        "389439-star.svg",
        "389461-ticket.svg",
        "389494-users.svg",
        "480248-saxophone-2.svg"
      ],
      "attribution": "site/public/assets/icons/festival-categories/ATTRIBUTION.md"
    },
    {
      "id": "reference4-v8",
      "root": "site/public/assets/icons/reference4-v8",
      "penpot_path": "Icon/Product/Reference 4 v8",
      "classification": "production-specialized-or-candidate",
      "expected_svg_files": [
        "baby-thin.svg",
        "buildings-thin.svg",
