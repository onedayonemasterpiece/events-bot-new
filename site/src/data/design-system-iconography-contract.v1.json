      "expected_svg_files": [
        "question-bubble-390478.svg",
        "vk-repost-348786.svg"
      ],
      "attribution": "site/public/assets/icons/question-cta/PROVENANCE.md"
    },
    {
      "id": "standalone-product-icons",
      "root": "site/public/assets/icons",
      "penpot_path": "Icon/Product/Standalone",
