        {
          "kind": "exact_replace",
          "from": "<span class=\"festival-guide__icon\" aria-hidden=\"true\">＋</span>",
          "to": "<span class=\"festival-guide__icon\" aria-hidden=\"true\"><Icon name=\"spark\" className=\"ke-icon-role ke-icon-role--action\" /></span>"
        }
