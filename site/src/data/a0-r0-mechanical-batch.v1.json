        {
          "kind": "augment_root",
          "selector_anchor": "<main id=\"main\" class=\"festival-page\" data-festival-timeline",
          "add_attributes": {
            "data-ds-family": "FestivalTimelineRouteComposition",
            "data-ds-version": "1",
            "data-ds-variant": "timeline-2026",
            "data-ds-state": "{resolvedItems.length ? 'populated' : 'empty'}",
            "data-ke-foundation-consumer": "festival-route"
