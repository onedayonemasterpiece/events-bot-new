        },
        {
          "kind": "exact_replace",
          "from": "<span class=\"festival-guide__icon\" aria-hidden=\"true\">↗</span>",
          "to": "<span class=\"festival-guide__icon\" aria-hidden=\"true\"><SemanticIcon name=\"link\" role=\"action\" /></span>"
