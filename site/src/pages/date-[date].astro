---
import EventLayout from '../layouts/EventLayout.astro';
import DateListingSurface from '../components/listings/DateListingSurface.astro';
import DateEditorialReview from '../components/listings/DateEditorialReview.astro';
import PersonalFeedSlot from '../components/PersonalFeedSlot.astro';
import { absoluteUrl, getDateEvents, SITE_NAME } from '../lib/events';
import { getStaticEventDateAvailability } from '../lib/staticEventDates';

export function getStaticPaths() {
  return [...getStaticEventDateAvailability().availableDates].sort().map((date) => ({
    params: { date },
    props: { date },
  }));
}

const { date } = Astro.props;
const events = getDateEvents(date);
const formattedDate = new Intl.DateTimeFormat('ru-RU', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Kaliningrad',
}).format(new Date(`${date}T12:00:00+02:00`));
const title = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Kaliningrad',
}).format(new Date(`${date}T12:00:00+02:00`));
---
<EventLayout
  title={`События ${formattedDate} в Калининградской области | ${SITE_NAME}`}
  description={`События на ${formattedDate}, сгруппированные по времени начала.`}
  canonicalUrl={absoluteUrl(`/date-${date}/`)}
  structuredData={[]}
  mobileSection="dates"
>
  <main id="main" class="ke-listing-page">
    <DateListingSurface kind="date" title={title} date={date} dateLabel={formattedDate} events={events} />
    <div class="ke-listing-shell"><PersonalFeedSlot context="date" /></div>
    <DateEditorialReview date={date} events={events} />
  </main>
</EventLayout>
