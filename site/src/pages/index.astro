---
import EventLayout from '../layouts/EventLayout.astro';
import PrelaunchLayout from '../layouts/PrelaunchLayout.astro';
import HomeColdStartFeed from '../components/HomeColdStartFeed.astro';
import HomeHeroTalk from '../components/HomeHeroTalk.astro';
import HeroTalkPageEnd from '../components/HeroTalkPageEnd.astro';
import HomeQuickNav from '../components/HomeQuickNav.astro';
import PrelaunchPage from '../components/PrelaunchPage.astro';
import { buildHomeHeroTalkDeck } from '../lib/homeHeroTalk.ts';
import type { PreviewEvent } from '../lib/types';
import {
  absoluteUrl,
  collapseLinkedSessionEvents,
  eventIntersectsDateRange,
  getCurrentDate,
  getEvents,
  getOccurrenceFamily,
  getPopularEvents,
  SITE_NAME,
} from '../lib/events';

const prelaunchMode = /^(?:1|true|yes|on)$/iu.test(String(import.meta.env.PUBLIC_PRELAUNCH_MODE || ''));
const currentDate = getCurrentDate();
const allEvents = getEvents();
const popular = getPopularEvents(30);
const fallback = collapseLinkedSessionEvents(
  allEvents
    .filter((event) => !event.lifecycle_status || event.lifecycle_status === 'active')
    .filter((event) => eventIntersectsDateRange(event, currentDate, '9999-12-31')),
);
const feed: PreviewEvent[] = [];
const offeredFamilyIds = new Set<number>();
for (const event of [...popular, ...fallback]) {
  const familyIds = getOccurrenceFamily(event).memberIds;
  if (familyIds.some((id) => offeredFamilyIds.has(id))) continue;
  feed.push(event);
  familyIds.forEach((id) => offeredFamilyIds.add(id));
  if (feed.length >= 30) break;
}

const heroScenes = buildHomeHeroTalkDeck(allEvents, currentDate, `home:${currentDate}`, 4);
const upperHeroIds = new Set(heroScenes.map((scene) => scene.event.id));
const endHeroScenes = buildHomeHeroTalkDeck(
  allEvents.filter((event) => !upperHeroIds.has(event.id)),
  currentDate,
  `home-end:${currentDate}`,
  4,
);
const searchReady = Boolean(import.meta.env.PUBLIC_STATIC_SITE_LIVE_SEARCH_URL);
const title = SITE_NAME;
const description = 'Афиша Калининграда без шума: актуальные события, быстрые маршруты и разговорный поиск.';
---

{prelaunchMode ? (
  <PrelaunchLayout>
    <PrelaunchPage />
  </PrelaunchLayout>
) : (
  <EventLayout
    title={title}
    description={description}
    canonicalUrl={absoluteUrl('/')}
    ogType="website"
    structuredData={[]}
    mobileSection="afisha"
    homeFloatingNav
  >
    <main id="main" class="home-page" data-home-page data-home-static-fallback-count={feed.length}>
      <HomeHeroTalk scenes={heroScenes} placement="home_intro" />

      <div class="page-shell home-page__shell">
        <HomeQuickNav />
        <HomeColdStartFeed events={feed} />
      </div>

      <HeroTalkPageEnd
        scenes={endHeroScenes.length ? endHeroScenes : undefined}
        context={{
          route: 'home',
          placement: 'page_end',
          readyCapabilities: searchReady ? ['search'] : [],
          upperSceneIds: heroScenes.map((scene) => scene.editorialId),
        }}
      />
    </main>
  </EventLayout>
)}

<style>
  .home-page { padding: 0 0 5rem; overflow-x: clip; }
  .home-page__shell { width: min(1240px, calc(100% - 2rem)); }
  :global(.home-page > [data-hero-talk-page-end]) { margin-top: clamp(3rem, 7vw, 6rem); }
  @media (max-width:620px) {
    .home-page { padding-bottom: calc(var(--mobile-bottom-stack-h, 84px) + 2rem); }
    .home-page__shell { width: min(100% - 1rem, 46rem); padding-inline: 0; }
  }
</style>