---
import { withBase } from '../lib/events';

const previewHref = import.meta.env.PUBLIC_ROOT_PREVIEW_HREF || withBase('/__preview/');
const logoHref = withBase('/favicon.svg');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Полюбить Калининград Анонсы</title>
    <meta name="description" content="Афиша Калининграда без шума: события, концерты, выставки, лекции и семейные планы в одном месте." />
    <link rel="icon" href={logoHref} type="image/svg+xml" />
    <meta name="theme-color" content="#fff6ea" />
    <style>
      :root {
        --ink:#2d3035;
        --muted:#625b55;
        --brand:#af481f;
        --cream:#fffaf1;
        --paper:#fff6ea;
      }
      * { box-sizing: border-box; }
      body {
        margin:0;
        min-height:100svh;
        display:grid;
        place-items:center;
        background:linear-gradient(180deg, #fffdfa 0%, var(--cream) 100%);
        color:var(--ink);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      main {
        width:min(92vw, 640px);
        padding:clamp(34px, 7vh, 72px) 24px;
        text-align:center;
        display:flex;
        flex-direction:column;
        align-items:center;
      }
      .mark {
        display:block;
        width:clamp(220px, 24vw, 300px);
        height:auto;
        margin:0 auto 34px;
      }
      .kicker {
        margin:0 0 12px;
        color:var(--brand);
        font-weight:850;
        text-transform:uppercase;
        letter-spacing:.105em;
        font-size:13px;
        line-height:1.2;
      }
      h1 {
        margin:0;
        color:var(--ink);
        font-size:clamp(44px, 7vw, 72px);
        line-height:.94;
        letter-spacing:-.06em;
        font-weight:900;
      }
      .lead {
        margin:24px auto 0;
        max-width:580px;
        color:var(--muted);
        font-size:clamp(18px, 2.1vw, 23px);
        line-height:1.42;
        text-wrap:balance;
      }
      .actions {
        margin-top:36px;
        display:flex;
        flex-wrap:wrap;
        gap:12px;
        justify-content:center;
        align-items:center;
      }
      a { color:inherit; }
      .button,
      .ghost {
        min-height:50px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border:0;
        border-radius:999px;
        padding:0 26px;
        text-decoration:none;
        font-weight:850;
        line-height:1;
        white-space:nowrap;
      }
      .button { background:var(--brand); color:white; }
      .ghost { background:rgba(255,255,255,.62); color:var(--ink); }
      .button:hover,
      .ghost:hover { transform:translateY(-1px); }
      .button:focus-visible,
      .ghost:focus-visible { outline:3px solid rgba(175,72,31,.28); outline-offset:4px; }
      footer { margin-top:36px; font-size:15px; color:#8b817a; }
      @media (max-width: 520px) {
        .mark { width:min(64vw, 260px); margin-bottom:30px; }
        .actions { width:100%; flex-direction:column; gap:12px; }
        .button,
        .ghost { width:min(100%, 288px); }
      }
    </style>
  </head>
  <body>
    <main>
      <img class="mark" src={logoHref} width="1254" height="1254" alt="Полюбить Калининград Анонсы" decoding="async" />
      <p class="kicker">Полюбить Калининград</p>
      <h1>Анонсы</h1>
      <p class="lead">Афиша Калининграда без шума: концерты, выставки, лекции, спектакли и семейные события — всё, что стоит не пропустить.</p>
      <div class="actions">
        <a class="button" href={previewHref}>Открыть тестовую версию</a>
        <a class="ghost" href="mailto:info@kenigevents.ru">info@kenigevents.ru</a>
      </div>
      <footer>kenigevents.ru</footer>
    </main>
  </body>
</html>
