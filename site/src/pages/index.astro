---
import PwaInstallAction from '../components/PwaInstallAction.astro';
import PwaTelemetry from '../components/PwaTelemetry.astro';
import { withBase } from '../lib/events';
import '../styles/design-system.css';

const previewHref = import.meta.env.PUBLIC_ROOT_PREVIEW_HREF || withBase('/__preview/');
const logoHref = withBase('/favicon.svg');
const manifestHref = `${withBase('/manifest.webmanifest')}?v=20260727-brand-icon-v2`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Полюбить Калининград Анонсы</title>
    <meta name="description" content="Афиша Калининграда без шума: события, концерты, выставки, лекции и семейные планы в одном месте." />
    <link rel="icon" href={logoHref} type="image/svg+xml" sizes="any" />
    <link rel="manifest" href={manifestHref} />
    <meta name="theme-color" content="#fff6ea" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin:0;
        min-height:100svh;
        display:grid;
        place-items:center;
        background:linear-gradient(180deg, var(--ke-color-surface-strong) 0%, var(--ke-color-canvas) 100%);
        color:var(--ke-color-ink);
        font-family:var(--ke-font-sans);
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      main {
        width:min(92vw, 640px);
        padding:clamp(34px, 7vh, 72px) 24px;
        text-align:center;
        display:flex;
        flex-direction:column;
        align-items:center;
      }
      .mark {
        display:block;
        width:clamp(220px, 24vw, 300px);
        height:auto;
        margin:0 auto 34px;
      }
      .kicker {
        margin:0 0 12px;
        color:var(--ke-color-brand-600);
        font-weight:850;
        text-transform:uppercase;
        letter-spacing:.105em;
        font-size:13px;
        line-height:1.2;
      }
      h1 {
        margin:0;
        color:var(--ke-color-ink);
        font-size:clamp(44px, 7vw, 72px);
        line-height:.94;
        letter-spacing:-.06em;
        font-weight:900;
      }
      .lead {
        margin:24px auto 0;
        max-width:580px;
        color:var(--ke-color-muted);
        font-size:clamp(18px, 2.1vw, 23px);
        line-height:1.42;
        text-wrap:balance;
      }
      .actions {
        margin-top:36px;
        display:flex;
        flex-wrap:wrap;
        gap:12px;
        justify-content:center;
        align-items:center;
      }
      a { color:inherit; }
      .actions :global(.ke-button) { min-width:min(100%, 288px); min-height:50px; padding-inline:26px; }
      footer { margin-top:36px; font-size:15px; color:var(--ke-color-muted); }
      @media (max-width: 520px) {
        .mark { width:min(64vw, 260px); margin-bottom:30px; }
        .actions { width:100%; flex-direction:column; gap:12px; }
        .actions :global(.ke-button) { width:min(100%, 288px); }
      }
    </style>
  </head>
  <body>
    <PwaTelemetry />
    <PwaInstallAction />
    <main>
      <img class="mark" src={logoHref} width="64" height="64" alt="Полюбить Калининград Анонсы" decoding="async" />
      <p class="kicker">Полюбить Калининград</p>
      <h1>Анонсы</h1>
      <p class="lead">Афиша Калининграда без шума: концерты, выставки, лекции, спектакли и семейные события — всё, что стоит не пропустить.</p>
      <div class="actions">
        <a class="ke-button ke-button--primary" href={previewHref}>Открыть тестовую версию</a>
        <a class="ke-button ke-button--secondary" href={withBase('/kluby-po-interesam/')}>Клубы по интересам</a>
        <a class="ke-button ke-button--secondary" href="mailto:info@kenigevents.ru">info@kenigevents.ru</a>
      </div>
      <footer>kenigevents.ru</footer>
    </main>
  </body>
</html>
