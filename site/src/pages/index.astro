---
import EventLayout from '../layouts/EventLayout.astro';
import HomeColdStartFeed from '../components/HomeColdStartFeed.astro';
import HomeHeroTalk from '../components/HomeHeroTalk.astro';
import HomeQuickNav from '../components/HomeQuickNav.astro';
import FocusPwaLaunchResume from '../components/FocusPwaLaunchResume.astro';
import type { PreviewEvent } from '../lib/types';
import {
  absoluteUrl,
  collapseLinkedSessionEvents,
  eventIntersectsDateRange,
  getCurrentDate,
  getEvents,
  getOccurrenceFamily,
  getPopularEvents,
  SITE_NAME,
} from '../lib/events';

const currentDate = getCurrentDate();
const popular = getPopularEvents(30);
const fallback = collapseLinkedSessionEvents(
  getEvents()
    .filter((event) => !event.lifecycle_status || event.lifecycle_status === 'active')
    .filter((event) => eventIntersectsDateRange(event, currentDate, '9999-12-31')),
);
const feed: PreviewEvent[] = [];
const offeredFamilyIds = new Set<number>();
for (const event of [...popular, ...fallback]) {
  const familyIds = getOccurrenceFamily(event).memberIds;
  if (familyIds.some((id) => offeredFamilyIds.has(id))) continue;
  feed.push(event);
  familyIds.forEach((id) => offeredFamilyIds.add(id));
  if (feed.length >= 30) break;
}
const heroEvent = feed[0] || null;
const title = SITE_NAME;
const description = 'Афиша Калининграда без шума: полезная статическая подборка событий, быстрые маршруты по датам и локальная персонализация.';
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={absoluteUrl('/')}
  ogType="website"
  structuredData={[]}
  mobileSection="afisha"
>
  <FocusPwaLaunchResume />
  <main id="main" class="home-page" data-home-page data-home-static-fallback-count={feed.length}>
    <div class="page-shell home-page__shell">
      <HomeHeroTalk event={heroEvent} />
      <HomeQuickNav />
      <HomeColdStartFeed events={feed} />
    </div>
  </main>
</EventLayout>

<style>
  .home-page { padding: clamp(.75rem, 2.4vw, 2rem) 0 5rem; }
  .home-page__shell { width: min(1240px, calc(100% - 2rem)); }
  @media (max-width: 620px) {
    .home-page { padding-top: .6rem; }
    .home-page__shell { width: min(100% - 1rem, 46rem); padding-inline: 0; }
  }
</style>
