---
import Icon from '../../../components/Icon.astro';
import { createFocusInviteQrSvg } from '../../../lib/focus-invite-qr';

const focusPreviewBase = 'https://kenigevents.ru/preview-20260729-focus-simple-r15-a5cc0256';
const homeUrl = `${focusPreviewBase}/`;
const weekendUrl = `${focusPreviewBase}/vyhodnye/`;
const focusInvitationUrl = `${focusPreviewBase}/fokus-gruppa/priglashenie/#invite=focus-group-2026-announcements`;
const focusSearchUrl = `${focusPreviewBase}/poisk/`;
const focusEventUrl = `${focusPreviewBase}/sobytiya/triatlon-pokoleniy-kaliningrad-6865/`;
const focusDesktopMedallionUrl = `${focusPreviewBase}/sobytiya/otkrytie-festivalya-bahosluzhenie-proekt-evgeniya-knyazeva-ya-gospodi-tvor-kaliningrad-6153/`;
const focusMobileMedallionUrl = focusEventUrl;
const focusNpsUrl = `${focusPreviewBase}/segodnya/`;
const peopleInterfaceUrl = `${focusPreviewBase}/lab/event-participants/`;
const focusInvitationQrSvg = createFocusInviteQrSvg(focusInvitationUrl);
const outroQrUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/qr-survey-nikiforov-916b6fee58256c4f2111887bf70c502070a55e45a667650dfccdb1495016ccd9.png';
const znanieLogoUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/znanie-logo-b97bf38f1b152a8eb3bbae79cb38df24cc2543ec2538d6f0d58863c9698072a9.svg';
const introMusicUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/echo-sax-end-6d7494c0d24c1815ac72a120e96b23782a2e92ef1ce26fb67769693d057fd08a.mp3';
const jokeAudioUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/joke-electronic-brain-c0efea54a93d4a6bcbb8e244bc35cfbe9a23556783d78df0fcffa457b5dead79.wav';
const errorAudioUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/computer-error-cc0-d7ec5eeba2b280017100e9deb3f063d580755469ce326332df7da9b4dcd63d1a.mp3';
const catKeyboardUrl = 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/cat-keyboard-unsplash-dbbe5f90f00dc4e4bb483d3374626a668aa1d395ea1e352ec1661b8b7ebc9e79.webp';
const announcementsWordmarkUrl = '/brand/announcements-wordmark-ui.svg';
const findIconUrl = '/assets/icons/reference4-v8/search-thin.svg';
const people = [
  {
    name: 'Татьяна Удовенко',
    role: 'эксперт по туризму, гид, филолог, руководитель туркомпании',
    avatar: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/person-udovenko-tatyana-bc3c802595b109f4c9a96c7f5bc214449401a6dca6cf3e94386e29a0e0c82461.webp',
    likes: 128,
  },
  {
    name: 'Андрей Бойко',
    role: 'краевед, исследователь киноистории',
    avatar: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/person-boyko-andrey-b1bc39b613306c364b7b2881d0cf1f4fef50ab019633a7729ac1ae399cab6228.webp',
    likes: 74,
  },
  {
    name: 'Светлана Соколова',
    role: 'директор Калининградского зоопарка',
    avatar: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/person-sokolova-svetlana-51ccbfc58f6c421b9c805eb72a3587b273bd61118511a6cd2deaf29a96843a16.webp',
    likes: 93,
  },
];
const medallions = [
  ['Музей Мирового океана', '/assets/organizers/world-ocean-museum.svg'],
  ['Историко-художественный музей', '/assets/organizers/history-art-museum.svg'],
  ['Калининградская филармония', '/assets/organizers/kaliningrad-philharmonic.svg'],
  ['Остров Канта', '/assets/organizers/kant-island.svg'],
  ['Третьяковская галерея', '/assets/organizers/tretyakovka-kaliningrad.svg'],
  ['Научная библиотека', '/assets/organizers/konb.webp'],
  ['Общество «Знание»', '/assets/organizers/znanie-russia.svg'],
  ['80 историй о главном', '/assets/organizers/kgd80.svg'],
  ['Кантата', '/assets/organizers/kantata-festival.webp'],
  ['Драматический театр', '/assets/organizers/dramteatr39.svg'],
  ['Янтарь холл', '/assets/organizers/yantar-hall.svg'],
  ['Музыкальный театр', '/assets/organizers/muzteatr39.webp'],
  ['Дом искусств', '/assets/organizers/dom-iskusstv.svg'],
  ['City Jazz Club', '/assets/organizers/city-jazz-club.webp'],
  ['Калининградский зоопарк', '/assets/organizers/kldzoo.webp'],
  ['Музей модерна', '/assets/organizers/mumod.svg'],
];
const lectureSlides = [
  {
    messageId: 821,
    chapter: '01 · UI ≠ UX',
    statement: 'Интерфейс видят. Опыт проживают.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-821-2f3c1b7d9a1c7094c77da009867c25a62cb233110185ab7a1a020b61356bdc26.webp',
    alt: 'Сравнение пользовательского интерфейса и опыта на примере игрушки над детской кроваткой',
    fit: 'contain',
    theme: 'dark',
    layout: 'split',
    caption: 'Красивый объект ещё не гарантирует хороший опыт.',
  },
  {
    messageId: 822,
    chapter: '02 · Проверка действием',
    statement: 'Удобство проверяется действием.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-822-d85cadfd1dd4aad0c0e8f5fb68482624a1a4d617585fae9737fd430fac9513d1.webp',
    alt: 'Сравнение двух бутылок кетчупа и опыта их использования',
    fit: 'contain',
    theme: 'light',
    layout: 'horizontal',
    caption: 'Проверять удобство нужно не взглядом, а действием.',
  },
  {
    messageId: 823,
    chapter: '03 · Эргономика телефона',
    statement: 'Интерфейс должен быть под рукой.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-823-61de6c5363792bc2fb5e50d6182c90f926fa7021c12d9bd80f96dff5b9d62bdc.webp',
    alt: 'Зоны доступности интерфейса смартфона для большого пальца',
    fit: 'contain',
    theme: 'dark',
    layout: 'poster',
    caption: 'Телефон держат одной рукой. Интерфейс должен это помнить.',
  },
  {
    messageId: 824,
    chapter: '04 · Цена сложности',
    statement: 'Когда всё важно — ничего не понятно.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-824-19c1f686d1b04f0b99463d24a16625827f0ff3e45bccbffb7c6e3b9d8f5d561b.webp',
    alt: 'Иллюстрация перегруженного пульта управления и растерянного оператора',
    fit: 'wide',
    theme: 'light',
    layout: 'horizontal',
    caption: 'Перегрузка интерфейса превращает простое решение в риск.',
  },
  {
    messageId: 825,
    chapter: '05 · Критические системы',
    statement: 'В сложных системах удобство — безопасность.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-825-1734e48aa4ef2b20c19c975c76d91b507fe98999d49655bf71749e0b8fd9f43b.webp',
    alt: 'Обложка книги Вопросы эргономики в ядерной энергетике',
    fit: 'portrait',
    theme: 'dark',
    layout: 'portrait',
    caption: 'Эргономика — часть безопасности критических систем.',
  },
  {
    messageId: 826,
    chapter: '06 · Видеть главное',
    statement: 'Хорошая система помогает видеть главное.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-826-252137528a929f8165c441b6fccdc853169fd4c4a249c0870f3b9b26a15ecadb.webp',
    alt: 'Организованный большой зал управления с операторами и обзорными экранами',
    fit: 'contain',
    theme: 'light',
    layout: 'cinema',
    caption: 'Хорошая система помогает быстро увидеть отклонение.',
  },
  {
    messageId: 830,
    chapter: '07 · Работа над удобством',
    statement: 'Понять → спроектировать → проверить.',
    image: 'https://static.kenigevents.ru/assets/autopresenter/scenario-20260730/lecture-830-cdcb0a381189715a8cebf90122000b7ddad74350390df87fd881fed658eff582.webp',
    alt: 'Цикл пользовательского проектирования от анализа к дизайну и тестированию',
    fit: 'contain',
    theme: 'dark',
    layout: 'split',
    caption: 'Удобство рождается из наблюдения, проектирования и проверки.',
  },
];
const serviceTextScenes = [
  { id: 'service-taste', eyebrow: '08 · Не только свой вкус', title: 'Удобство нельзя\nсделать для себя.', support: 'Сервисом будут пользоваться другие люди.', theme: 'light' },
  { id: 'service-feedback', eyebrow: '09 · Слушать аудиторию', title: 'Обратная связь —\nчасть интерфейса.', support: 'Не приложение для людей. Приложение вместе с людьми.', theme: 'dark' },
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" as="font" type="font/ttf" href="/assets/fonts/Cygre-Book.ttf" crossorigin />
    <link rel="preload" as="font" type="font/ttf" href="/assets/fonts/Cygre-SemiBold.ttf" crossorigin />
    <link rel="preload" as="font" type="font/ttf" href="/assets/fonts/Cygre-ExtraBold.ttf" crossorigin />
    <link rel="preload" as="image" href={outroQrUrl} fetchpriority="high" />
    <link rel="preload" as="image" href={znanieLogoUrl} fetchpriority="high" />
    <link rel="preload" as="audio" href={introMusicUrl} />
    <link rel="preload" as="audio" href={jokeAudioUrl} />
    <link rel="preload" as="audio" href={errorAudioUrl} />
    <link rel="preload" as="image" href={catKeyboardUrl} />
    {people.map((person) => <link rel="preload" as="image" href={person.avatar} />)}
    {lectureSlides.map((slide) => <link rel="preload" as="image" href={slide.image} />)}
    <title>Автопрезентатор · Сцена</title>
  </head>
  <body>
    <main
      class="stage"
      data-presenter-id="presenter-stage"
      data-presenter-stage-ready="true"
      data-presenter-scene="live-site"
      aria-label="Сцена автопрезентатора"
    >
      <div
        class="live-site-scene"
        data-presenter-id="live-site-scene"
        data-presenter-scene-id="live-site"
      >
        <p class="stage-caption" aria-hidden="true">Завтра — в одном движении.</p>
        <section class="device-area" aria-label="Мобильный сайт">
          <div class="ambient ambient-one" aria-hidden="true"></div>
          <div class="ambient ambient-two" aria-hidden="true"></div>
          <div class="phone-shell">
            <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
            <iframe
              id="presenter-mobile-frame"
              data-presenter-id="mobile-site-frame"
              data-presenter-frame-ready="false"
              src={homeUrl}
              title="Мобильная версия сайта Кёнигсберг · События"
              width="476"
              height="1024"
            ></iframe>
            <div class="phone-home" aria-hidden="true"></div>
          </div>
        </section>
      </div>

      <section
        class="intro-scene presentation-scene"
        data-presenter-id="intro-scene"
        data-presenter-scene-id="intro-loop"
        data-intro-state="idle"
        aria-label="Интро перед лекцией"
        hidden
      >
        <div class="presentation-orbit" aria-hidden="true"></div>
        <div class="brand-plate brand-plate--intro brand-logo--on-dark">
          <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
        </div>
        <p class="intro-kicker">80 историй о главном · Калининград</p>
        <h1 class="intro-thought" data-presenter-id="intro-thought" aria-live="off">
          <span data-intro-line="one"></span>
          <span data-intro-line="two"></span>
        </h1>
        <p class="intro-footnote">До начала можно знакомиться и общаться</p>
        <audio
          data-presenter-id="intro-music"
          src={introMusicUrl}
          preload="auto"
          loop
        ></audio>
      </section>

      {lectureSlides.map((slide, index) => (
        <section
          class={`lecture-slide presentation-scene lecture-slide--${slide.fit} lecture-layout--${slide.layout} theme--${slide.theme}`}
          data-presenter-id="lecture-scene"
          data-presenter-scene-id={`lecture-${String(index + 1).padStart(2, '0')}`}
          data-lecture-index={index}
          data-source-message-id={slide.messageId}
          data-lecture-state="idle"
          aria-label={`Лекционный экран ${index + 1}`}
          hidden
        >
            <div class="lecture-copy">
              <div class={`brand-plate brand-plate--lecture brand-logo--on-${slide.theme}`}>
                <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
              </div>
              <p class="lecture-chapter">{slide.chapter}</p>
              <h2 data-lecture-statement data-lecture-text={slide.statement}></h2>
              <p class="lecture-counter">{String(index + 1).padStart(2, '0')} / {String(lectureSlides.length).padStart(2, '0')}</p>
            </div>
            <figure class="lecture-visual">
              <img src={slide.image} alt={slide.alt} loading="eager" decoding="async" />
              <figcaption>{slide.caption}</figcaption>
            </figure>
        </section>
      ))}

      <section class="service-scene service-wordmark presentation-scene theme--light" data-presenter-scene-id="service-wordmark" hidden>
        <p class="service-eyebrow">01 · Полюбить Калининград</p>
        <div class="wordmark-motion" role="img" aria-label="Анонсы">
          <span class="wordmark-plain" aria-hidden="true">Анонсы</span>
          <img class="wordmark-vector" src={announcementsWordmarkUrl} alt="" aria-hidden="true" />
          <svg class="wordmark-o-layer" viewBox="0 0 7819 1514" aria-hidden="true">
            <path class="wordmark-o-glyph" fill="currentColor" fill-rule="evenodd" d="M3371 410C3971 410 4171 540 4171 962C4171 1384 3971 1514 3371 1514C2771 1514 2571 1384 2571 962C2571 540 2771 410 3371 410ZM3371 600C2981 600 2831 700 2831 962C2831 1224 2981 1324 3371 1324C3761 1324 3911 1224 3911 962C3911 700 3761 600 3371 600Z" />
          </svg>
        </div>
      </section>

      <section class="service-scene service-needs presentation-scene theme--dark" data-presenter-scene-id="service-needs" hidden>
        <p class="service-eyebrow">02 · Что нужно человеку</p>
        <h2>Найти. Поделиться.<br />Не забыть.</h2>
        <div class="need-row">
          <div><img class="need-icon need-icon--search" src={findIconUrl} alt="" /><span>Быстро найти<br />то, что нравится</span></div>
          <div><Icon name="share" className="need-icon need-icon--share" /><span>Позвать<br />друзей</span></div>
          <div><Icon name="calendar" className="need-icon need-icon--calendar" /><span>Добавить<br />в календарь</span></div>
        </div>
      </section>

      <section class="service-scene medallion-scene presentation-scene theme--light" data-presenter-scene-id="service-medallions" data-medallion-state="idle" hidden>
        <div class="medallion-copy">
          <p class="service-eyebrow">04 · Медальоны</p>
          <h2>Медальон —<br />смысл одним взглядом.</h2>
          <p class="service-support">Знакомый образ появляется крупно — и занимает своё место.</p>
        </div>
        <div class="medallion-stage">
          <div class="medallion-grid" aria-label="16 реальных медальонов площадок и проектов">
            {medallions.map(([label, image], index) => (
              <figure data-medallion-grid-item data-index={index} data-image={image} data-label={label}>
                <img src={image} alt={label} loading="eager" />
              </figure>
            ))}
          </div>
          <div class="medallion-feature" aria-live="off" aria-hidden="true">
            <img data-medallion-feature-image alt="" />
            <strong data-medallion-feature-label></strong>
          </div>
        </div>
      </section>

      <section class="focus-live-scene desktop-medallion-scene presentation-scene theme--light" data-presenter-scene-id="service-medallions-desktop" data-focus-phase="meaning" hidden>
        <aside class="live-meaning live-meaning--cover light"><p>Реальная страница</p><h2>Сначала —<br />главное.</h2><span>Медальоны находятся рядом с событием, а не прячутся в описании.</span></aside>
        <iframe data-presenter-id="medallion-desktop-frame" data-src={focusDesktopMedallionUrl} title="Реальная страница события с медальонами" width="1360" height="1080"></iframe>
      </section>

      <section class="focus-live-scene mobile-medallion-scene presentation-scene theme--dark" data-presenter-scene-id="service-medallions-mobile" hidden>
        <aside class="live-meaning"><p>Тот же смысл</p><h2>Теперь —<br />в ладони.</h2><span>Телефон сдвигается, чтобы оставить место мысли.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="medallion-mobile-frame" data-src={focusMobileMedallionUrl} title="Мобильная страница события с медальонами" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="service-scene service-joke presentation-scene theme--dark" data-presenter-scene-id="service-joke" data-joke-state="idle" hidden>
        <p class="service-eyebrow">03.7 · Время шутки</p>
        <h2 data-joke-line="one"></h2>
        <p data-joke-line="two"></p>
        <audio data-presenter-id="joke-audio" src={jokeAudioUrl} preload="auto"></audio>
      </section>

      <section class="service-scene search-concept-scene presentation-scene theme--light" data-presenter-scene-id="service-search-concept" hidden>
        <p class="service-eyebrow">06 · Поиск по смыслу</p>
        <h2>Умный поиск.</h2>
        <p class="search-principle">Не совпадение слов.<br /><strong>Совпадение смыслов.</strong></p>
        <div class="search-example"><span>«хочу тихий вечер с музыкой»</span><i>→</i><strong>камерный концерт</strong></div>
      </section>

      <section class="focus-live-scene search-live-scene presentation-scene theme--light" data-presenter-scene-id="service-search-live" hidden>
        <aside class="live-meaning light"><p>Живой поиск</p><h2 data-search-meaning>Скажите,<br />чего хочется.</h2><span>Запрос приходит с пульта и печатается на телефоне.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="focus-search-frame" data-src={focusSearchUrl} title="Умный поиск фокус-версии сайта" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      {serviceTextScenes.map((scene) => (
        <section
          class={`service-scene service-word-sequence presentation-scene theme--${scene.theme}`}
          data-presenter-scene-id={scene.id}
          data-service-copy-state="idle"
          hidden
        >
          <p class="service-eyebrow">{scene.eyebrow}</p>
          <h2>
            {scene.title.split('\n').map((line) => (
              <span class="service-word-line">
                {line.split(/\s+/u).map((word) => <i class="service-word">{word}</i>)}
              </span>
            ))}
          </h2>
          {scene.support && <p class="service-support">{scene.support}</p>}
        </section>
      ))}

      <section
        class="service-scene disruption-scene presentation-scene theme--dark"
        data-presenter-scene-id="service-disruption"
        data-error-phase="idle"
        hidden
      >
        <div class="disruption-copy">
          <p class="service-eyebrow">07 · Честный момент</p>
          <h2>И тут презентация<br />пошла не по плану…</h2>
        </div>
        <figure class="disruption-cat">
          <img data-presenter-id="error-cat-image" src={catKeyboardUrl} alt="Белый кот сидит у компьютерной клавиатуры" />
          <figcaption>Кажется, нашли ответственного.</figcaption>
        </figure>
        <audio data-presenter-id="error-audio" src={errorAudioUrl} preload="auto"></audio>
      </section>

      <section class="focus-qr-scene presentation-scene theme--dark" data-presenter-scene-id="service-focus-group" hidden>
        <div class="focus-qr-copy">
          <p class="service-eyebrow">10 · Фокус-группа</p>
          <h2>Присоединяйтесь<br />к фокус-группе.</h2>
          <p>Наведите камеру телефона на QR-код.</p>
          <small aria-label="Ссылка для ручного ввода">kenigevents.ru · фокус-группа</small>
        </div>
        <a class="focus-qr" href={focusInvitationUrl} aria-label="Открыть приглашение в фокус-группу" set:html={focusInvitationQrSvg}></a>
      </section>

      <section class="focus-live-scene nps-live-scene presentation-scene theme--light" data-presenter-scene-id="service-nps" hidden>
        <aside class="live-meaning light"><p>11 · Оценка страницы</p><h2>Спросить<br />на месте.</h2><span>Прокручиваем реальную страницу до оценки фокус-группы от 0 до 10.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="focus-nps-frame" data-src={focusNpsUrl} title="Оценка полезности реальной календарной страницы" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="people-scene presentation-scene theme--dark" data-presenter-scene-id="service-future-celebrity" data-people-phase="portraits" hidden>
        <div class="people-portraits">
          <p class="service-eyebrow">12 · Люди</p>
          <h2>Люди, за которыми<br />хочется следить.</h2>
          <div class="people-row">
            {people.map((person) => (
              <article>
                <img src={person.avatar} alt={person.name} />
                <strong>{person.name}</strong>
                <span>{person.role}</span>
                <b>♥ {person.likes}</b>
              </article>
            ))}
          </div>
        </div>
        <div class="people-interface">
          <p class="preview-ui-label">Preview UI · связь с реальным событием ещё не опубликована</p>
          <iframe data-presenter-id="people-interface-frame" data-src={peopleInterfaceUrl} title="Блок известных людей на странице события" width="1920" height="1080"></iframe>
        </div>
      </section>

      <section
        class="desktop-scene"
        data-presenter-id="desktop-scene"
        data-presenter-scene-id="weekend-desktop"
        aria-label="Десктопная страница событий на выходные"
        hidden
      >
        <div class="desktop-meaning" data-presenter-id="desktop-meaning">
          <p>Выходные · FHD</p>
          <h2>Весь город.<br />На одном экране.</h2>
          <span>Сначала мысль. Затем — живой сайт без подписи рядом.</span>
        </div>
        <iframe
          id="presenter-desktop-frame"
          data-presenter-id="desktop-site-frame"
          data-presenter-frame-ready="false"
          data-src={weekendUrl}
          title="Десктопная версия страницы событий на выходные"
          width="1920"
          height="1080"
        ></iframe>
      </section>

      <section
        class="outro-scene presentation-scene"
        data-presenter-id="outro-scene"
        data-presenter-scene-id="outro-qr"
        aria-labelledby="outro-heading"
        hidden
      >
        <div class="outro-copy">
          <p class="outro-kicker">Ваше впечатление важно</p>
          <h1 id="outro-heading">Как вам?</h1>
          <p class="outro-support">Оцените событие — это займёт минуту.</p>
        </div>
        <div class="outro-qr-wrap">
          <img
            class="outro-qr"
            data-presenter-id="outro-qr-image"
            src={outroQrUrl}
            alt="QR-код опроса по итогам мероприятия"
            width="1155"
            height="1155"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
      </section>

      <div class="presenter-signals" data-presenter-id="stage-status-card">
        <strong data-presenter-id="stage-status" data-status="idle" role="status" aria-live="polite">Готов к запуску</strong>
      </div>
    </main>

    <script is:inline>
      (() => {
        const stage = document.querySelector('[data-presenter-id="presenter-stage"]');
        const mobileFrame = document.querySelector('#presenter-mobile-frame');
        const desktopFrame = document.querySelector('#presenter-desktop-frame');
        const status = document.querySelector('[data-presenter-id="stage-status"]');
        const stateCard = document.querySelector('[data-presenter-id="stage-status-card"]');
        const introScene = document.querySelector('[data-presenter-scene-id="intro-loop"]');
        const outroScene = document.querySelector('[data-presenter-scene-id="outro-qr"]');
        const introLineOne = document.querySelector('[data-intro-line="one"]');
        const introLineTwo = document.querySelector('[data-intro-line="two"]');
        const introMusic = document.querySelector('[data-presenter-id="intro-music"]');
        const jokeAudio = document.querySelector('[data-presenter-id="joke-audio"]');
        const errorAudio = document.querySelector('[data-presenter-id="error-audio"]');
        const scenes = new Map(
          [...document.querySelectorAll('[data-presenter-scene-id]')]
            .filter((node) => node instanceof HTMLElement)
            .map((node) => [node.dataset.presenterSceneId, node]),
        );
        if (
          !(stage instanceof HTMLElement) ||
          !(mobileFrame instanceof HTMLIFrameElement) ||
          !(desktopFrame instanceof HTMLIFrameElement) ||
          !(status instanceof HTMLElement) ||
          !(introScene instanceof HTMLElement) ||
          !(outroScene instanceof HTMLElement) ||
          !(introLineOne instanceof HTMLElement) ||
          !(introLineTwo instanceof HTMLElement) ||
          !(introMusic instanceof HTMLAudioElement) ||
          !(jokeAudio instanceof HTMLAudioElement) ||
          !(errorAudio instanceof HTMLAudioElement)
        ) return;

        const labels = {
          disconnected: 'Нет связи с агентом',
          idle: 'Готов к запуску',
          running: 'Сценарий выполняется',
          stopping: 'Останавливаем показ',
          completed: 'Показ завершён',
          error: 'Нужна проверка',
        };
        const introPhrases = {
          welcome: ['Добро пожаловать!', 'Скоро начинаем.'],
          topic: ['Почему одни сервисы удобны,', 'а другие — нет?'],
          networking: ['Пока знакомьтесь друг с другом.', 'Сегодня здесь много уважаемых гостей.'],
          heat: ['Сегодня жаркий день.', 'Рады, что вы пришли на презентацию.'],
          format: ['Лекция — и презентация сервиса анонсов.', 'Сегодня вы — наша фокус-группа.'],
        };
        const introRoutes = [
          ['welcome', 'heat', 'networking', 'topic', 'format'],
          ['welcome', 'networking', 'heat', 'topic', 'format'],
          ['welcome', 'topic', 'format', 'heat', 'networking'],
          ['welcome', 'topic', 'format', 'networking', 'heat'],
        ];
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        let generation = 0;
        let activeTimer = 0;
        let activeWaitResolve = null;
        let musicFade = 0;
        let previousRoute = -1;

        const setStatus = (nextStatus, label) => {
          if (!Object.hasOwn(labels, nextStatus)) return;
          status.dataset.status = nextStatus;
          status.textContent = label || labels[nextStatus];
          if (stateCard instanceof HTMLElement) stateCard.dataset.status = nextStatus;
        };

        const cancelWait = () => {
          if (activeTimer) clearTimeout(activeTimer);
          activeTimer = 0;
          if (activeWaitResolve) activeWaitResolve(false);
          activeWaitResolve = null;
        };

        const pause = (ms, token) => new Promise((resolve) => {
          cancelWait();
          if (token !== generation) return resolve(false);
          activeWaitResolve = resolve;
          activeTimer = window.setTimeout(() => {
            activeTimer = 0;
            activeWaitResolve = null;
            resolve(token === generation);
          }, ms);
        });

        const stopPresentationMotion = ({ rewindAudio = true } = {}) => {
          generation += 1;
          cancelWait();
          if (musicFade) clearInterval(musicFade);
          musicFade = 0;
          introMusic.pause();
          introMusic.volume = 0;
          if (rewindAudio) {
            try { introMusic.currentTime = 0; } catch {}
          }
          for (const cue of [jokeAudio, errorAudio]) {
            cue.pause();
            if (rewindAudio) {
              try { cue.currentTime = 0; } catch {}
            }
          }
          introScene.dataset.introState = 'stopped';
          document.querySelector('[data-joke-state]')?.setAttribute('data-joke-state', 'stopped');
          document.querySelector('[data-medallion-state]')?.setAttribute('data-medallion-state', 'stopped');
          document.querySelector('[data-people-phase]')?.setAttribute('data-people-phase', 'portraits');
          document.querySelectorAll('[data-service-copy-state]')
            .forEach((scene) => scene.setAttribute('data-service-copy-state', 'stopped'));
          document.querySelector('[data-error-phase]')?.setAttribute('data-error-phase', 'stopped');
          document.querySelectorAll('[data-lecture-state]')
            .forEach((scene) => scene.setAttribute('data-lecture-state', 'stopped'));
        };

        const splitSemanticChunks = (value) => {
          const words = value.trim().split(/\s+/u);
          const midpoint = Math.ceil(words.length / 2);
          return [words.slice(0, midpoint).join(' '), words.slice(midpoint).join(' ')].filter(Boolean);
        };

        const revealHeroTalk = async (lineOne, lineTwo, token) => {
          introLineOne.replaceChildren();
          introLineTwo.replaceChildren();
          const chunks = [];
          for (const [node, line] of [[introLineOne, lineOne], [introLineTwo, lineTwo]]) {
            splitSemanticChunks(line).forEach((text, index) => {
              if (index > 0) node.append(document.createTextNode(' '));
              const fragment = document.createElement('span');
              fragment.className = 'hero-fragment';
              fragment.textContent = text;
              node.append(fragment);
              chunks.push({ fragment, text });
            });
          }
          if (reduceMotion.matches) {
            chunks.forEach(({ fragment }) => fragment.classList.add('is-complete'));
            return token === generation;
          }
          await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
          let previous = null;
          for (let index = 0; index < chunks.length; index += 1) {
            if (token !== generation) return false;
            const { fragment, text } = chunks[index];
            previous?.classList.remove('is-active');
            previous?.classList.add('is-complete');
            fragment.classList.add('is-active');
            const cadence = 190 + seededUnit(`${lineOne}|${lineTwo}`, index, text) * 120;
            const punctuationPause = /[.!?…]$/u.test(text)
              ? cadence + 100 + seededUnit(text, index + 11, text) * 80
              : /[,;:—]$/u.test(text)
                ? cadence + 60 + seededUnit(text, index + 7, text) * 70
                : cadence;
            if (!await pause(Math.round(punctuationPause), token)) return false;
            previous = fragment;
          }
          previous?.classList.remove('is-active');
          previous?.classList.add('is-complete');
          if (!await pause(260, token)) return false;
          return token === generation;
        };

        const pickRoute = () => {
          let index = Math.floor(Math.random() * introRoutes.length);
          if (introRoutes.length > 1 && index === previousRoute) index = (index + 1) % introRoutes.length;
          previousRoute = index;
          return introRoutes[index];
        };

        const startMusic = async (token) => {
          introMusic.volume = 0;
          try {
            await introMusic.play();
          } catch {
            introScene.dataset.introAudio = 'blocked';
            return;
          }
          if (token !== generation) return;
          introScene.dataset.introAudio = 'playing';
          const startedAt = performance.now();
          musicFade = window.setInterval(() => {
            if (token !== generation) return clearInterval(musicFade);
            const progress = Math.min(1, (performance.now() - startedAt) / 1500);
            introMusic.volume = .15 * progress;
            if (progress >= 1) {
              clearInterval(musicFade);
              musicFade = 0;
            }
          }, 50);
        };

        const countdownPhrase = (startAt) => {
          const timestamp = Date.parse(startAt || '');
          if (!Number.isFinite(timestamp)) return null;
          const minutes = Math.max(0, Math.ceil((timestamp - Date.now()) / 60000));
          if (minutes === 0) return ['Вот-вот', 'начинаем'];
          return ['Начнём через', `${minutes} ${minutes === 1 ? 'минуту' : minutes > 1 && minutes < 5 ? 'минуты' : 'минут'}.`];
        };

        const startIntro = async (options = {}) => {
          const token = generation;
          introScene.dataset.introState = 'running';
          introScene.dataset.introAudio = 'starting';
          void startMusic(token);
          while (token === generation) {
            const route = [...pickRoute()];
            if (countdownPhrase(options.startAt)) route.splice(1, 0, 'countdown');
            for (const phraseId of route) {
              if (token !== generation) return;
              const phrase = phraseId === 'countdown' ? countdownPhrase(options.startAt) : introPhrases[phraseId];
              if (!phrase) continue;
              introScene.dataset.introPhrase = phraseId;
              introScene.classList.remove('is-clearing');
              if (!await revealHeroTalk(phrase[0], phrase[1], token)) return;
              if (!await pause(5200, token)) return;
              introScene.classList.add('is-clearing');
              if (!await pause(650, token)) return;
              introLineOne.replaceChildren();
              introLineTwo.replaceChildren();
              introScene.classList.remove('is-clearing');
              if (!await pause(650, token)) return;
            }
            if (!await pause(900, token)) return;
          }
        };

        const seededUnit = (seed, index, grapheme = '') => {
          let hash = 2166136261;
          const source = `${seed}|${index}|${grapheme}`;
          for (let offset = 0; offset < source.length; offset += 1) {
            hash ^= source.charCodeAt(offset);
            hash = Math.imul(hash, 16777619);
          }
          hash ^= hash << 13;
          hash ^= hash >>> 17;
          hash ^= hash << 5;
          return (hash >>> 0) / 4294967295;
        };

        const humanDelay = (value, index, grapheme, { base = 38, seed = 'stage' } = {}) => {
          const unit = seededUnit(`${seed}|${value}`, index, grapheme);
          if (/[.!?…]/u.test(grapheme)) return Math.round(190 + unit * 100);
          if (/[,;:—→]/u.test(grapheme)) return Math.round(90 + unit * 65);
          if (/\s/u.test(grapheme)) {
            const previous = value[index - 1] || '';
            const wordBoundaryHesitation = index > 4 && seededUnit(seed, index, previous) > .92;
            return Math.round(14 + unit * 10 + (wordBoundaryHesitation ? 80 + unit * 70 : 0));
          }
          const triangular = (unit + seededUnit(seed, index + 97, grapheme)) / 2;
          return Math.max(18, Math.round(base - 8 + triangular * 24));
        };

        const typeLecture = async (scene, token) => {
          const statement = scene.querySelector('[data-lecture-statement]');
          if (!(statement instanceof HTMLElement)) return;
          const value = statement.dataset.lectureText || '';
          scene.dataset.lectureState = 'typing';
          statement.textContent = '';
          if (reduceMotion.matches) {
            statement.textContent = value;
            scene.dataset.lectureState = 'complete';
            return;
          }
          const graphemes = Array.from(value);
          for (let index = 0; index < graphemes.length; index += 1) {
            if (token !== generation) return;
            const grapheme = graphemes[index];
            statement.textContent += grapheme;
            if (!await pause(humanDelay(value, index, grapheme, { base: 38, seed: scene.dataset.presenterSceneId || 'lecture' }), token)) return;
          }
          if (!await pause(330, token)) return;
          scene.dataset.lectureState = 'media';
          if (!await pause(920, token)) return;
          scene.dataset.lectureState = 'complete';
        };

        const typeInto = async (node, value, token, { base = 42, seed = 'typed-copy' } = {}) => {
          node.textContent = '';
          const graphemes = Array.from(value);
          for (let index = 0; index < graphemes.length; index += 1) {
            if (token !== generation) return false;
            const grapheme = graphemes[index];
            node.textContent += grapheme;
            if (!await pause(humanDelay(value, index, grapheme, { base, seed }), token)) return false;
          }
          return true;
        };

        const startJoke = async () => {
          const token = generation;
          const scene = document.querySelector('[data-presenter-scene-id="service-joke"]');
          const first = scene?.querySelector('[data-joke-line="one"]');
          const second = scene?.querySelector('[data-joke-line="two"]');
          if (!(scene instanceof HTMLElement) || !(first instanceof HTMLElement) || !(second instanceof HTMLElement)) return;
          scene.dataset.jokeState = 'typing';
          first.textContent = '';
          second.textContent = '';
          if (!await typeInto(first, 'Максим, самое время для шутки', token, { base: 44, seed: 'joke-one' })) return;
          if (!await pause(7000, token)) return;
          jokeAudio.volume = .9;
          try {
            await jokeAudio.play();
            scene.dataset.jokeAudio = 'playing';
          } catch {
            scene.dataset.jokeAudio = 'blocked';
          }
          if (!await typeInto(second, 'нет, мой электронный мозг не создан для шуток…', token, { base: 38, seed: 'joke-two' })) return;
          if (!jokeAudio.paused && Number.isFinite(jokeAudio.duration)) {
            const remaining = Math.max(0, (jokeAudio.duration - jokeAudio.currentTime) * 1000);
            if (remaining && !await pause(remaining, token)) return;
          }
          scene.dataset.jokeState = 'complete';
        };

        const startMedallions = async (scene, token) => {
          const feature = scene.querySelector('.medallion-feature');
          const featureImage = scene.querySelector('[data-medallion-feature-image]');
          const featureLabel = scene.querySelector('[data-medallion-feature-label]');
          const items = [...scene.querySelectorAll('[data-medallion-grid-item]')];
          if (
            !(feature instanceof HTMLElement) ||
            !(featureImage instanceof HTMLImageElement) ||
            !(featureLabel instanceof HTMLElement)
          ) return;
          scene.dataset.medallionState = 'running';
          feature.classList.remove('is-visible');
          items.forEach((item) => item.classList.remove('is-placed'));
          if (reduceMotion.matches) {
            items.forEach((item) => item.classList.add('is-placed'));
            scene.dataset.medallionState = 'complete';
            return;
          }
          for (const item of items) {
            if (token !== generation || !(item instanceof HTMLElement)) return;
            featureImage.src = item.dataset.image || '';
            featureImage.alt = item.dataset.label || '';
            featureLabel.textContent = item.dataset.label || '';
            feature.classList.add('is-visible');
            if (!await pause(360, token)) return;
            const from = feature.getBoundingClientRect();
            const to = item.getBoundingClientRect();
            const deltaX = to.left + to.width / 2 - (from.left + from.width / 2);
            const deltaY = to.top + to.height / 2 - (from.top + from.height / 2);
            const scale = Math.min(to.width / from.width, to.height / from.height);
            featureLabel.classList.add('is-travelling');
            const travel = feature.animate([
              { opacity: 1, transform: 'translate(-50%, -50%) scale(1)' },
              { opacity: 1, transform: `translate(calc(-50% + ${deltaX}px), calc(-50% + ${deltaY}px)) scale(${scale})` },
            ], { duration: 680, easing: 'cubic-bezier(.83,0,.17,1)', fill: 'forwards' });
            await travel.finished.catch(() => undefined);
            if (token !== generation) return;
            item.classList.add('is-placed');
            feature.classList.remove('is-visible');
            featureLabel.classList.remove('is-travelling');
            travel.cancel();
            if (!await pause(70, token)) return;
          }
          featureImage.src = '';
          featureLabel.textContent = '';
          scene.dataset.medallionState = 'complete';
        };

        const startErrorCue = async (scene, token) => {
          errorAudio.volume = 1;
          scene.dataset.errorAudio = 'starting';
          scene.dataset.errorPhase = 'copy';
          const playCue = async () => {
            try { errorAudio.currentTime = 0; } catch {}
            try {
              await errorAudio.play();
              scene.dataset.errorAudio = 'playing';
            } catch {
              scene.dataset.errorAudio = 'blocked';
              return false;
            }
            return pause(520, token);
          };
          if (!await pause(900, token)) return;
          scene.dataset.errorPhase = 'first-cue';
          if (!await playCue()) return;
          if (!await pause(2_300, token)) return;
          scene.dataset.errorPhase = 'second-cue';
          if (!await playCue()) return;
          scene.dataset.errorPhase = 'cat';
          if (!await pause(1_450, token)) return;
          const image = scene.querySelector('[data-presenter-id="error-cat-image"]');
          if (!(image instanceof HTMLImageElement) || !image.complete || image.naturalWidth <= 0) {
            scene.dataset.errorAudio = 'asset-error';
            return;
          }
          scene.dataset.errorAudio = 'complete';
          scene.dataset.errorPhase = 'complete';
        };

        const startServiceWordSequence = async (scene, token) => {
          const words = [...scene.querySelectorAll('.service-word')];
          const support = scene.querySelector('.service-support');
          scene.dataset.serviceCopyState = 'running';
          words.forEach((word) => word.classList.remove('is-visible'));
          support?.classList.remove('is-visible');
          if (reduceMotion.matches) {
            words.forEach((word) => word.classList.add('is-visible'));
            support?.classList.add('is-visible');
            scene.dataset.serviceCopyState = 'complete';
            return;
          }
          for (let index = 0; index < words.length; index += 1) {
            if (token !== generation) return;
            words[index]?.classList.add('is-visible');
            const delay = 250 + Math.round(seededUnit(scene.dataset.presenterSceneId || 'service', index) * 190);
            if (!await pause(delay, token)) return;
          }
          if (!await pause(380, token)) return;
          support?.classList.add('is-visible');
          if (!await pause(620, token)) return;
          scene.dataset.serviceCopyState = 'complete';
        };

        const showScene = (sceneId, options = {}) => {
          if (!scenes.has(sceneId)) return;
          stopPresentationMotion();
          const token = generation;
          stage.dataset.presenterScene = sceneId;
          scenes.forEach((scene, id) => { scene.hidden = id !== sceneId; });
          const activeScene = scenes.get(sceneId);
          activeScene?.classList.remove('is-entering');
          requestAnimationFrame(() => requestAnimationFrame(() => activeScene?.classList.add('is-entering')));
          activeScene?.querySelectorAll('iframe[data-src]').forEach((frame) => {
            if (
              frame instanceof HTMLIFrameElement
              && (!frame.hasAttribute('src') || frame.getAttribute('src') === '')
            ) frame.src = frame.dataset.src || '';
          });
          outroScene.classList.remove('is-entering');
          if (sceneId === 'outro-qr') {
            requestAnimationFrame(() => requestAnimationFrame(() => outroScene.classList.add('is-entering')));
          }
          if (sceneId === 'intro-loop') void startIntro(options);
          if (sceneId.startsWith('lecture-') && activeScene instanceof HTMLElement) {
            void typeLecture(activeScene, token);
          }
          if (sceneId === 'service-joke') void startJoke();
          if (sceneId === 'service-medallions' && activeScene instanceof HTMLElement) {
            void startMedallions(activeScene, token);
          }
          if (sceneId === 'service-disruption' && activeScene instanceof HTMLElement) {
            void startErrorCue(activeScene, token);
          }
          if (
            (sceneId === 'service-taste' || sceneId === 'service-feedback')
            && activeScene instanceof HTMLElement
          ) {
            void startServiceWordSequence(activeScene, token);
          }
          if (sceneId === 'service-future-celebrity') {
            activeScene?.setAttribute('data-people-phase', 'portraits');
            window.setTimeout(() => {
              if (generation === token) activeScene?.setAttribute('data-people-phase', 'interface');
            }, 7_500);
          }
          if (sceneId === 'service-search-live') {
            const meaning = activeScene?.querySelector('[data-search-meaning]');
            if (meaning && options.query) meaning.textContent = `«${options.query}»`;
          }
          if (sceneId === 'service-medallions-desktop') {
            activeScene?.setAttribute('data-focus-phase', 'meaning');
            window.setTimeout(() => {
              if (generation === token) activeScene?.setAttribute('data-focus-phase', 'site');
            }, 4200);
          }
          if (
            sceneId === 'weekend-desktop'
            && (!desktopFrame.hasAttribute('src') || desktopFrame.getAttribute('src') === '')
          ) {
            desktopFrame.dataset.presenterFrameReady = 'false';
            desktopFrame.src = desktopFrame.dataset.src || '';
          }
          if (sceneId === 'weekend-desktop') {
            activeScene?.setAttribute('data-desktop-phase', 'meaning');
            window.setTimeout(() => {
              if (generation === token) activeScene?.setAttribute('data-desktop-phase', 'site');
            }, 4200);
          }
        };

        const requestedTarget = new URLSearchParams(window.location.search).get('target');
        if (requestedTarget) {
          try {
            const target = new URL(requestedTarget, window.location.origin);
            if (target.origin === window.location.origin) mobileFrame.src = target.href;
          } catch {
            setStatus('error', 'Некорректный адрес показа');
          }
        }

        mobileFrame.addEventListener('load', () => {
          mobileFrame.dataset.presenterFrameReady = 'true';
          document.documentElement.dataset.presenterFrameReady = 'true';
        });
        desktopFrame.addEventListener('load', () => {
          desktopFrame.dataset.presenterFrameReady = 'true';
          document.documentElement.dataset.presenterDesktopFrameReady = 'true';
        });

        window.addEventListener('presenter:status', (event) => {
          const detail = event instanceof CustomEvent ? event.detail : null;
          if (detail && typeof detail.status === 'string') setStatus(detail.status, detail.label);
        });
        window.addEventListener('presenter:scene', (event) => {
          const detail = event instanceof CustomEvent ? event.detail : null;
          if (detail && typeof detail.id === 'string') showScene(detail.id, detail);
        });
        window.addEventListener('presenter:stop', () => stopPresentationMotion({ rewindAudio: true }));

        document.addEventListener('keydown', async (event) => {
          if (event.key.toLowerCase() !== 'f' || event.repeat || event.altKey || event.ctrlKey || event.metaKey) return;
          const target = event.target;
          if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target?.isContentEditable) return;
          event.preventDefault();
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await document.documentElement.requestFullscreen();
          } catch {
            setStatus('error', 'Полный экран недоступен');
          }
        });
      })();
    </script>
  </body>
</html>

