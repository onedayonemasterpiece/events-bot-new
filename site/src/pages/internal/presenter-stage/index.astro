    <link rel="preload" as="image" href={outroQrUrl} fetchpriority="high" />
    <link rel="preload" as="image" href={znanieLogoUrl} fetchpriority="high" />
    <link rel="preload" as="audio" href={introMusicUrl} />
    <link rel="preload" as="audio" href={jokeAudioUrl} />
    <link rel="preload" as="audio" href={errorAudioUrl} />
    <link rel="preload" as="image" href={catKeyboardUrl} />
    <link rel="preload" as="video" href={friendsClubVideoUrl} type="video/mp4" />
    {people.map((person) => <link rel="preload" as="image" href={person.avatar} />)}
    {lectureSlides.map((slide) => <link rel="preload" as="image" href={slide.image} />)}
    <title>Автопрезентатор · Сцена</title>
  </head>
  <body>
    <main
      class="stage"
      data-presenter-id="presenter-stage"
      data-presenter-stage-ready="true"
      data-presenter-scene="live-site"
      aria-label="Сцена автопрезентатора"
    >
      <div
        class="live-site-scene"
        data-presenter-id="live-site-scene"
        data-presenter-scene-id="live-site"
      >
        <p class="stage-caption" aria-hidden="true">Завтра — в одном движении.</p>
        <section class="device-area" aria-label="Мобильный сайт">
          <div class="ambient ambient-one" aria-hidden="true"></div>
          <div class="ambient ambient-two" aria-hidden="true"></div>
          <div class="phone-shell">
            <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
            <iframe
              id="presenter-mobile-frame"
              data-presenter-id="mobile-site-frame"
              data-presenter-frame-ready="false"
              src={homeUrl}
              title="Мобильная версия сайта Кёнигсберг · События"
              width="476"
              height="1024"
            ></iframe>
            <div class="phone-home" aria-hidden="true"></div>
          </div>
        </section>
      </div>

      <section
        class="intro-scene presentation-scene"
        data-presenter-id="intro-scene"
        data-presenter-scene-id="intro-loop"
        data-intro-state="idle"
        aria-label="Интро перед лекцией"
        hidden
      >
        <div class="presentation-orbit" aria-hidden="true"></div>
        <div class="brand-plate brand-plate--intro brand-logo--on-dark">
          <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
        </div>
        <p class="intro-kicker">80 историй о главном · Калининград</p>
        <h1 class="intro-thought" data-presenter-id="intro-thought" aria-live="off">
          <span data-intro-line="one"></span>
          <span data-intro-line="two"></span>
        </h1>
        <p class="intro-footnote">До начала можно знакомиться и общаться</p>
        <audio
          data-presenter-id="intro-music"
          src={introMusicUrl}
          preload="auto"
          loop
        ></audio>
      </section>

      {lectureSlides.map((slide, index) => (
        <section
          class={`lecture-slide presentation-scene lecture-slide--${slide.fit} lecture-layout--${slide.layout} theme--${slide.theme}`}
          data-presenter-id="lecture-scene"
          data-presenter-scene-id={`lecture-${String(index + 1).padStart(2, '0')}`}
          data-lecture-index={index}
          data-source-message-id={slide.messageId}
          data-lecture-state="idle"
          aria-label={`Лекционный экран ${index + 1}`}
          hidden
        >
            <div class="lecture-copy">
              <div class={`brand-plate brand-plate--lecture brand-logo--on-${slide.theme}`}>
                <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
              </div>
              <p class="lecture-chapter">{slide.chapter}</p>
              <h2 data-lecture-statement data-lecture-text={slide.statement}></h2>
              <p class="lecture-counter">{String(slide.position || index + 1).padStart(2, '0')} / 09</p>
            </div>
            <figure class="lecture-visual">
              <img src={slide.image} alt={slide.alt} loading="eager" decoding="async" />
              <figcaption>{slide.caption}</figcaption>
            </figure>
        </section>
      ))}

      <section
        class="lecture-slide lecture-convenience presentation-scene theme--light"
        data-presenter-scene-id="lecture-convenience-emergence"
        data-lecture-state="idle"
        aria-label="Лекционный экран: можно ли сразу стать удобным"
        hidden
      >
        <div class="lecture-copy">
          <div class="brand-plate brand-plate--lecture brand-logo--on-light">
            <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
          </div>
          <p class="lecture-chapter">07 · Удобство появляется</p>
          <h2 data-lecture-statement data-lecture-text="Можно ли сразу стать удобным?"></h2>
          <p class="lecture-counter">07 / 09</p>
        </div>
        <figure class="lecture-visual desire-path-visual">
          <img
            src="/assets/autopresenter/lecture/desire-path-ludwell-cc-by-sa-2.jpg"
            alt="Протоптанные людьми короткие дорожки через траву"
            loading="eager"
            decoding="async"
          />
          <span class="desire-label desire-label--design">сначала спроектировали</span>
          <span class="desire-label desire-label--people">потом люди выбрали путь</span>
          <span class="desire-label desire-label--tradition">немецкая практика: сначала наблюдать — потом мостить</span>
          <small>David Smith · CC BY-SA 2.0</small>
        </figure>
      </section>

      <section
        class="lecture-slide lecture-measurement presentation-scene theme--dark"
        data-presenter-scene-id="lecture-usability-measurement"
        data-lecture-state="idle"
        aria-label="Лекционный экран: как измерить удобство"
        hidden
      >
        <div class="lecture-copy">
          <div class="brand-plate brand-plate--lecture brand-logo--on-dark">
            <img src={znanieLogoUrl} alt="Знание" width="540" height="125" loading="eager" decoding="sync" />
          </div>
          <p class="lecture-chapter">08 · Проверить числами</p>
          <h2 data-lecture-statement data-lecture-text="Можно ли удобство измерить?"></h2>
          <p class="lecture-counter">08 / 09</p>
        </div>
        <div class="lecture-visual measurement-visual" role="img" aria-label="Четыре показателя удобства: успех, время, ошибки и оценка">
          <div class="measurement-ring"><strong>Цель</strong><span>задача выполнена?</span></div>
          <div class="measurement-ring"><strong>Время</strong><span>сколько занял выбор?</span></div>
          <div class="measurement-ring"><strong>Ошибки</strong><span>где человек сбился?</span></div>
          <div class="measurement-ring"><strong>Ясность</strong><span>понятно без подсказки?</span></div>
        </div>
      </section>

      <section class="market-scene market-primary presentation-scene theme--light" data-presenter-scene-id="market-01-primary" data-market-state="idle" hidden>
        <header class="market-header">
          <p class="service-eyebrow">Рынок · 01</p>
          <h2><b>4</b> игрока.<br /><span>4 разные силы.</span></h2>
          <p>Нажмите строку: карточка раскроет сильную сторону и ограничение.</p>
        </header>
        <div class="market-matrix" role="group" aria-label="Сравнение основных сервисов">
          <div class="market-matrix-head" aria-hidden="true"><span>Сервис</span><span>Каталог</span><span>Область</span><span>Контекст</span><span>Покупка</span><span>Личный выбор</span></div>
          {marketPlayers.map((player, index) => (
            <button class="market-player" type="button" data-market-focus={index} aria-expanded={index === 0 ? 'true' : 'false'}>
              <span class="market-logo"><img src={player.logo} alt="" /><b>{player.name}</b></span>
              {player.metrics.map((metric) => <i data-evidence={metric} aria-label={metric === 'yes' ? 'явно есть' : metric === 'limited' ? 'ограниченно' : metric === 'no' ? 'явно отсутствует' : 'не указано'}></i>)}
              <span class="market-detail"><strong>{player.strength}</strong><small>{player.gap}</small></span>
            </button>
          ))}
          <p class="market-legend">● явно есть · ◐ ограниченно · × явно нет · — не указано</p>
        </div>
      </section>

      <section class="market-scene market-substitutes presentation-scene theme--dark" data-presenter-scene-id="market-02-substitutes" data-market-state="idle" hidden>
        <header class="market-header">
          <p class="service-eyebrow">Рынок · 02</p>
          <h2><b>3</b> замены.<br /><span>И три разрыва.</span></h2>
        </header>
        <div class="market-flow">
          {marketSubstitutes.map(([name, strength, gap, icon], index) => (
            <button type="button" data-market-focus={index} aria-expanded={index === 0 ? 'true' : 'false'}>
              <img src={`/assets/autopresenter/icons/${icon}.svg`} alt="" />
              <strong>{name}</strong>
              <span>{strength}</span>
              <i aria-hidden="true">→</i>
              <small>{gap}</small>
            </button>
          ))}
        </div>
      </section>

      <section class="market-scene market-dynamics presentation-scene theme--light" data-presenter-scene-id="market-03-dynamics" data-market-state="idle" hidden>
        <header class="market-header">
          <p class="service-eyebrow">Рынок · 03 · Качественный вывод исследования</p>
          <h2><b>2</b> перемены<br /><span>за три года.</span></h2>
        </header>
        <div class="market-timeline" role="img" aria-label="Два качественных направления изменения рынка с 2023 по 2026 год">
          <article>
            <img src="/assets/autopresenter/icons/389291-map-pin.svg" alt="" />
            <strong>География</strong>
            <div class="market-shift"><span><b>2023</b>Калининград</span><i>→</i><span><b>2026</b>курорты и малые города</span></div>
            <small>Светлогорск · Зеленоградск · Янтарный</small>
          </article>
          <article>
            <img src="/assets/autopresenter/icons/389461-ticket.svg" alt="" />
            <strong>Дистрибуция</strong>
            <div class="market-shift"><span><b>2023</b>билетные посредники</span><i>→</i><span><b>2026</b>прямые площадки · D2C</span></div>
            <small>Собор · Драмтеатр · Музей Мирового океана</small>
          </article>
          <input data-market-scrubber type="range" min="0" max="100" value="0" aria-label="Показать изменение рынка во времени" />
        </div>
      </section>

      <section class="market-scene market-position presentation-scene theme--dark" data-presenter-scene-id="market-04-position" data-market-state="idle" hidden>
        <header class="market-header">
          <p class="service-eyebrow">Рынок · 04 · Целевой контур</p>
          <h2><b>6</b> условий.<br /><span>Вместе — ни у кого.</span></h2>
        </header>
        <div class="market-capabilities">
          {marketCapabilities.map(([icon, label], index) => (
            <button type="button" data-market-focus={index} aria-expanded={index === 0 ? 'true' : 'false'}>
              <img src={`/assets/autopresenter/icons/${icon}.svg`} alt="" />
              <span>{label}</span>
              <i aria-label="целевая возможность">✓</i>
            </button>
          ))}
        </div>
        <blockquote><span>Другие сервисы показывают, что проводится.</span><strong>«Анонсы» помогают понять, куда стоит пойти именно вам.</strong></blockquote>
      </section>

      <section class="service-scene service-wordmark presentation-scene theme--light" data-presenter-scene-id="service-wordmark" hidden>
        <p class="service-eyebrow">01 · Полюбить Калининград</p>
        <div class="wordmark-motion" role="img" aria-label="Анонсы">
          <span class="wordmark-plain" aria-hidden="true">Анонсы</span>
          <img class="wordmark-vector" src={announcementsWordmarkUrl} alt="" aria-hidden="true" />
          <svg class="wordmark-o-layer" viewBox="0 0 7819 1514" aria-hidden="true">
            <path class="wordmark-o-glyph" fill="currentColor" fill-rule="evenodd" d="M3371 410C3971 410 4171 540 4171 962C4171 1384 3971 1514 3371 1514C2771 1514 2571 1384 2571 962C2571 540 2771 410 3371 410ZM3371 600C2981 600 2831 700 2831 962C2831 1224 2981 1324 3371 1324C3761 1324 3911 1224 3911 962C3911 700 3761 600 3371 600Z" />
          </svg>
        </div>
      </section>

      <section class="service-scene service-needs presentation-scene theme--dark" data-presenter-scene-id="service-needs" hidden>
        <p class="service-eyebrow">02 · Что нужно человеку</p>
        <h2>Найти. Поделиться.<br />Не забыть.</h2>
        <div class="need-row">
          <div><img class="need-icon need-icon--search" src={findIconUrl} alt="" /><span>Быстро найти<br />то, что нравится</span></div>
          <div><Icon name="share" className="need-icon need-icon--share" /><span>Позвать<br />друзей</span></div>
          <div><Icon name="calendar" className="need-icon need-icon--calendar" /><span>Добавить<br />в календарь</span></div>
        </div>
      </section>

      <section class="service-scene medallion-scene presentation-scene theme--light" data-presenter-scene-id="service-medallions" data-medallion-state="idle" hidden>
        <div class="medallion-copy">
          <p class="service-eyebrow">03.7 · Медальоны</p>
          <h2>Медальон —<br />смысл одним взглядом.</h2>
          <p class="service-support">Знакомый образ появляется крупно — и занимает своё место.</p>
        </div>
        <div class="medallion-stage">
          <div class="medallion-grid" aria-label="16 реальных медальонов площадок и проектов">
            {medallions.map(([label, image], index) => (
              <figure data-medallion-grid-item data-index={index} data-image={image} data-label={label}>
                <img src={image} alt={label} loading="eager" />
              </figure>
            ))}
          </div>
          <div class="medallion-feature" aria-live="off" aria-hidden="true">
            <img data-medallion-feature-image alt="" />
            <strong data-medallion-feature-label></strong>
          </div>
        </div>
      </section>

      <section class="focus-live-scene desktop-medallion-scene presentation-scene theme--light" data-presenter-scene-id="service-medallions-desktop" data-focus-phase="meaning" hidden>
        <aside class="live-meaning live-meaning--cover light"><p>Реальная страница</p><h2>Сначала —<br />главное.</h2><span>Медальоны находятся рядом с событием, а не прячутся в описании.</span></aside>
        <iframe data-presenter-id="medallion-desktop-frame" data-src={focusDesktopMedallionUrl} title="Реальная страница события с медальонами" width="1360" height="1080"></iframe>
      </section>

      <section class="focus-live-scene mobile-medallion-scene presentation-scene theme--dark" data-presenter-scene-id="service-medallions-mobile" hidden>
        <aside class="live-meaning"><p>Тот же смысл</p><h2>Теперь —<br />в ладони.</h2><span>Телефон сдвигается, чтобы оставить место мысли.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="medallion-mobile-frame" data-src={focusMobileMedallionUrl} title="Мобильная страница события с медальонами" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="service-scene service-joke presentation-scene theme--dark" data-presenter-scene-id="service-joke" data-joke-state="idle" hidden>
        <p class="service-eyebrow">03.9 · Время шутки</p>
        <h2 data-joke-line="one"></h2>
        <p data-joke-line="two"></p>
        <audio data-presenter-id="joke-audio" src={jokeAudioUrl} preload="auto"></audio>
      </section>

      <section class="service-scene search-concept-scene presentation-scene theme--light" data-presenter-scene-id="service-search-concept" hidden>
        <p class="service-eyebrow">03.10 · Поиск по смыслу</p>
        <h2>Умный поиск.</h2>
        <p class="search-principle">Не совпадение слов.<br /><strong>Совпадение смыслов.</strong></p>
        <div class="search-example"><span>«хочу тихий вечер с музыкой»</span><i>→</i><strong>камерный концерт</strong></div>
      </section>

      <section class="focus-live-scene search-live-scene presentation-scene theme--light" data-presenter-scene-id="service-search-live" hidden>
        <aside class="live-meaning light"><p>Живой поиск</p><h2 data-search-meaning>Скажите,<br />чего хочется.</h2><span>Запрос приходит с пульта и печатается на телефоне.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="focus-search-frame" data-src={focusSearchUrl} title="Умный поиск фокус-версии сайта" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="service-scene personalization-scene presentation-scene theme--dark" data-presenter-scene-id="service-personalization" data-visual-state="idle" hidden>
        <p class="service-eyebrow">03.11 · Как устроена персонализация</p>
        <h2>Не угадывать.<br />Учиться на выборе.</h2>
        <div class="personalization-flow" aria-label="Схема персонализации">
          <article><img src="/assets/autopresenter/icons/389494-users.svg" alt="" /><b>Сигналы</b><span>лайк · пропуск · календарь</span></article>
          <i aria-hidden="true">→</i>
          <article><img src="/assets/autopresenter/icons/389049-book-open.svg" alt="" /><b>Профиль</b><span>темы · места · формат</span></article>
          <i aria-hidden="true">→</i>
          <article><img src="/assets/autopresenter/icons/389439-star.svg" alt="" /><b>Ранжирование</b><span>сначала то, что ближе вам</span></article>
          <i aria-hidden="true">→</i>
          <article><img src="/assets/autopresenter/icons/417817-shield-check.svg" alt="" /><b>Контроль</b><span>без сигнала — общая выдача</span></article>
        </div>
        <p class="personalization-note">Это продуктовая схема, а не обещание «читать мысли».</p>
      </section>

      {expandedServiceScenes.map((scene) => (
        <section
          class={`service-scene expanded-feature-scene presentation-scene theme--${scene.theme}`}
          data-presenter-scene-id={scene.id}
          data-visual-state="idle"
          hidden
        >
          <div class="expanded-feature-copy">
            <p class="service-eyebrow">{scene.eyebrow}</p>
            <h2>
              {scene.title.split('\n').map((line) => <span>{line}</span>)}
            </h2>
            <p>{scene.support}</p>
          </div>
          <div class="expanded-feature-visual">
            <img src={`/assets/autopresenter/icons/${scene.icon}.svg`} alt="" />
            <div class="expanded-feature-cards" style={`--card-count:${scene.cards.length}`}>
              {scene.cards.map((card, index) => (
                <article style={`--card-index:${index}`}>
                  <b>{String(index + 1).padStart(2, '0')}</b>
                  <span>{card}</span>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}

      <section class="focus-live-scene real-ui-scene presentation-scene theme--dark" data-presenter-scene-id="service-navigation-map" hidden>
        <aside class="live-meaning"><p>03.4 · Навигация</p><h2>Меню видно.<br />Переходы настоящие.</h2><span>Главная → меню → подборка → Избранное → Для меня → Популярное.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="navigation-mobile-frame" data-src={homeUrl} title="Реальная мобильная навигация" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="focus-live-scene real-ui-scene presentation-scene theme--light" data-presenter-scene-id="service-social-proof" hidden>
        <aside class="live-meaning light"><p>03.6 · Social proof</p><h2>Жесты,<br />которые видны.</h2><span>Реальная подборка: три лайка, один «не интересует» и понятные паузы.</span></aside>
        <div class="phone-shell focus-phone">
          <div class="phone-top" aria-hidden="true"><span class="speaker"></span><span class="camera"></span></div>
          <iframe data-presenter-id="social-proof-frame" data-src={freeCollectionUrl} title="Реальная подборка бесплатных событий" width="476" height="1024"></iframe>
          <div class="phone-home" aria-hidden="true"></div>
        </div>
      </section>

      <section class="live-navigation-scene real-desktop-scene presentation-scene" data-presenter-scene-id="service-artifact-desktop" hidden>
        <iframe data-presenter-id="artifact-desktop-frame" data-src={artifactWeekendUrl} title="Реальный артефакт на десктопной странице" width="1920" height="1080"></iframe>
        <div class="live-key-hint" aria-hidden="true"><kbd>↓</kbd><span>найти артефакт</span><kbd>→</kbd><span>раскрыть</span><kbd>Enter</kbd></div>
      </section>

      <section class="live-navigation-scene real-desktop-scene presentation-scene" data-presenter-scene-id="service-keyboard-day" hidden>
        <iframe data-presenter-id="keyboard-day-frame" data-src={focusNpsUrl} title="Реальная страница дня с клавиатурным управлением" width="1920" height="1080"></iframe>
        <div class="live-key-hint" aria-hidden="true"><kbd>↑</kbd><kbd>←</kbd><kbd>↓</kbd><kbd>→</kbd><span>страница отвечает на клавиши</span></div>
      </section>

      <section class="live-navigation-scene real-desktop-scene presentation-scene" data-presenter-scene-id="service-keyboard-event" hidden>
