---
import EventLayout from '../../layouts/EventLayout.astro';
import { INFO_PARTNERS } from '../../data/info-partners';
import type { InfoPartner } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Информационные партнёры | ${SITE_NAME}`;
const description = 'Информационные партнёры Полюбить Калининград Анонсы: компактный список партнёров и организаций.';
const canonicalUrl = absoluteUrl('/partners/');
const webpSource = (partner: InfoPartner) => Boolean(partner.logoUrl?.endsWith('.webp') && partner.logoFallbackUrl);
const primaryLogoSrc = (partner: InfoPartner) => partner.logoUrl?.endsWith('.webp') ? (partner.logoFallbackUrl || partner.logoUrl) : partner.logoUrl;
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="partners-page">
    <div class="page-shell page-shell--compact">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Информационные партнёры</span>
      </nav>

      <header class="partners-heading">
        <p class="eyebrow">Информационные партнёры</p>
        <h1>Партнёры</h1>
        <p>Логотипы ведут на сайты партнёров.</p>
      </header>

      <section class="partners-grid" aria-label="Список информационных партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class={`partner-tile partner-tile--${partner.logoShape} partner-tile--${partner.logoSurface || 'light'} ${partner.priority === 'primary' ? 'partner-tile--primary' : ''}`}
            style={`--partner-accent: ${partner.accent}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <span class="partner-tile__logo" aria-hidden="true">
              {partner.logoUrl ? (
                <picture>
                  {webpSource(partner) && <source srcset={withBase(partner.logoUrl)} type="image/webp" />}
                  <img class="partner-tile__logo-img" src={withBase(primaryLogoSrc(partner) || partner.logoUrl)} alt="" loading="lazy" decoding="async" />
                </picture>
              ) : (
                <span class="partner-tile__text-logo">{partner.logoText}</span>
              )}
            </span>
            <span class="partner-tile__meta">
              <strong>{partner.shortName}</strong>
              <span>{partner.compactLabel}</span>
            </span>
          </a>
        ))}
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .page-shell--compact { max-width: 1040px; }
  .partners-heading {
    margin: 0.35rem 0 clamp(0.75rem, 2vw, 1.05rem);
    display: grid;
    gap: 0.2rem;
  }
  .partners-heading h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.45rem);
    letter-spacing: -0.075em;
    line-height: 0.94;
  }
  .partners-heading p { margin: 0; max-width: 38rem; color: var(--muted); }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
    grid-auto-flow: dense;
    gap: 0.48rem;
    align-items: stretch;
  }
  .partner-tile {
    min-height: 78px;
    display: grid;
    grid-template-rows: minmax(42px, 1fr) auto;
    gap: 0.18rem;
    padding: 0.5rem 0.58rem 0.46rem;
    border: 1px solid rgba(121, 48, 20, 0.105);
    border-radius: 16px;
    background:
      radial-gradient(circle at 16% 0%, color-mix(in srgb, var(--partner-accent) 6%, transparent), transparent 48%),
      rgba(255, 253, 248, 0.82);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 8px 18px rgba(56, 32, 18, 0.045);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }
  .partner-tile:hover,
  .partner-tile:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--partner-accent) 34%, rgba(121, 48, 20, 0.14));
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 13px 25px rgba(56, 32, 18, 0.085);
  }
  .partner-tile:focus-visible { outline: 3px solid color-mix(in srgb, var(--partner-accent) 26%, #fff); outline-offset: 3px; }
  .partner-tile__logo {
    min-height: 42px;
    display: grid;
    place-items: center;
    padding: 0.2rem 0.18rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.34);
  }
  .partner-tile--dark .partner-tile__logo {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--partner-accent) 96%, #111), color-mix(in srgb, var(--partner-accent) 76%, #3d0f0f));
  }
  .partner-tile--transparent .partner-tile__logo { background: transparent; }
  .partner-tile__logo picture { width: 100%; display: grid; place-items: center; }
  .partner-tile__logo-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 42px;
    object-fit: contain;
  }
  .partner-tile--wide .partner-tile__logo-img { max-width: min(100%, 210px); max-height: 39px; }
  .partner-tile--tall .partner-tile__logo-img { max-height: 88px; max-width: min(100%, 104px); }
  .partner-tile--compact .partner-tile__logo-img { max-height: 38px; max-width: min(100%, 146px); }
  .partner-tile__text-logo {
    color: var(--partner-accent);
    font-size: clamp(1rem, 2.4vw, 1.26rem);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .partner-tile__meta {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 0.02rem;
    line-height: 1.08;
    text-align: center;
  }
  .partner-tile__meta strong {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .partner-tile__meta span {
    max-width: 100%;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 680px) {
    .partners-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.56rem; }
    .partner-tile--wide { grid-column: span 2; }
    .partner-tile--tall { grid-row: span 2; min-height: 162px; }
    .partner-tile--tall .partner-tile__logo { min-height: 120px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 116px; max-width: min(100%, 128px); }
    .partner-tile--primary.partner-tile--wide { grid-column: span 2; }
  }
  @media (min-width: 980px) {
    .partners-grid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .partner-tile--wide { grid-column: span 2; }
    .partner-tile--primary.partner-tile--wide { grid-column: span 2; }
  }
  @media (max-width: 620px) {
    .partners-page { padding-bottom: 3rem; }
    .page-shell--compact { padding-inline: 0.8rem; }
    .crumbs { margin-bottom: 0.4rem; }
    .partners-heading { margin-bottom: 0.65rem; }
    .partners-heading p:not(.eyebrow) { font-size: 0.9rem; }
    .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.44rem; }
    .partner-tile,
    .partner-tile--wide,
    .partner-tile--tall {
      grid-column: auto;
      grid-row: auto;
      min-height: 82px;
      border-radius: 15px;
      padding: 0.46rem 0.5rem 0.42rem;
    }
    .partner-tile__logo { min-height: 42px; padding: 0.18rem; }
    .partner-tile__logo-img { max-height: 40px; }
    .partner-tile--wide .partner-tile__logo-img { max-height: 36px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 44px; }
    .partner-tile__meta span { font-size: 0.65rem; }
  }
  @media (max-width: 360px) {
    .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .partner-tile { min-height: 76px; padding: 0.42rem; }
    .partner-tile__meta span { font-size: 0.62rem; }
  }
</style>
