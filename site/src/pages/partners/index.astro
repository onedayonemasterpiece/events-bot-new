---
import EventLayout from '../../layouts/EventLayout.astro';
import { INFO_PARTNERS } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Информационные партнёры | ${SITE_NAME}`;
const description = 'Информационные партнёры Полюбить Калининград Анонсы: официальные логотипы партнёрских организаций и программ.';
const canonicalUrl = absoluteUrl('/partners/');
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="partners-page">
    <div class="page-shell partners-shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Инфопартнёры</span>
      </nav>

      <section class="partners-hero" aria-labelledby="partners-title">
        <p class="eyebrow">Информационные партнёры</p>
        <h1 id="partners-title">Логотипы партнёров</h1>
        <p class="lead">Организации и программы, которые помогают анонсам находить свою аудиторию.</p>
      </section>

      <section class="partners-logo-wall" aria-label="Логотипы информационных партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class:list={[
              'partner-logo-link',
              `partner-logo-link--${partner.logoTone || 'light'}`,
              `partner-logo-link--${partner.logoScale || 'wide'}`,
            ]}
            style={`--partner-accent: ${partner.accent}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <img src={withBase(partner.logoUrl)} alt={`${partner.shortName} — ${partner.name}`} loading="lazy" decoding="async" />
          </a>
        ))}
      </section>

      <p class="partners-note" data-nosnippet>
        Логотипы ведут на официальные сайты партнёров. По вопросам информационного партнёрства: <a href="mailto:info@kenigevents.ru">info@kenigevents.ru</a>.
      </p>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: 6rem; }
  .partners-shell { max-width: 980px; }
  .partners-hero {
    margin: clamp(1.4rem, 6vw, 4.2rem) auto clamp(1.4rem, 4vw, 2.4rem);
    text-align: center;
  }
  .partners-hero h1 {
    max-width: none;
    margin: 0 auto;
    font-size: clamp(2rem, 9vw, 5rem);
    letter-spacing: -0.07em;
  }
  .partners-hero .lead {
    max-width: 46rem;
    margin-inline: auto;
    color: var(--muted);
  }
  .partners-logo-wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1rem, 4vw, 2.4rem);
    margin: 0 auto;
  }
  .partner-logo-link {
    min-height: clamp(128px, 22vw, 184px);
    display: grid;
    place-items: center;
    padding: clamp(1.1rem, 4vw, 2rem);
    border: 1px solid rgba(121,48,20,0.08);
    border-radius: clamp(24px, 5vw, 38px);
    background: rgba(255,253,248,0.56);
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(72,45,25,0.06);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .partner-logo-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--partner-accent) 34%, rgba(121,48,20,0.12));
    background: rgba(255,253,248,0.92);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--partner-accent) 10%, rgba(72,45,25,0.08));
  }
  .partner-logo-link img {
    width: min(100%, 250px);
    max-height: 92px;
    object-fit: contain;
  }
  .partner-logo-link--wide img { width: min(100%, 300px); }
  .partner-logo-link--compact img { width: min(100%, 132px); max-height: 82px; }
  .partner-logo-link--tall img { max-height: 114px; }
  .partner-logo-link--brand {
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--partner-accent) 20%, transparent), transparent 65%),
      linear-gradient(135deg, color-mix(in srgb, var(--partner-accent) 84%, #42140f), color-mix(in srgb, var(--partner-accent) 58%, #15110f));
    border-color: color-mix(in srgb, var(--partner-accent) 44%, rgba(255,255,255,0.2));
  }
  .partner-logo-link--brand:hover {
    background:
      radial-gradient(circle at top left, rgba(255,255,255,0.22), transparent 64%),
      linear-gradient(135deg, color-mix(in srgb, var(--partner-accent) 88%, #42140f), color-mix(in srgb, var(--partner-accent) 62%, #15110f));
  }
  .partners-note {
    max-width: 38rem;
    margin: clamp(1.5rem, 5vw, 2.6rem) auto 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    text-align: center;
  }
  .partners-note a { color: var(--primary-strong); font-weight: 780; }
  @media (max-width: 640px) {
    .partners-shell { width: min(100% - 24px, 980px); }
    .partners-logo-wall { grid-template-columns: 1fr; }
    .partner-logo-link { min-height: 124px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-logo-link { transition: none; }
    .partner-logo-link:hover { transform: none; }
  }
</style>
