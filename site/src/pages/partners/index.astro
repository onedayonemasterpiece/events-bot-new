---
import EventLayout from '../../layouts/EventLayout.astro';
import '../../components/design-system/product-contour-foundations.css';
import { INFO_PARTNERS } from '../../data/info-partners';
import type { InfoPartner } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Партнёры | ${SITE_NAME}`;
const description = 'Партнёры Полюбить Калининград Анонсы: компактная сетка партнёрских логотипов.';
const canonicalUrl = absoluteUrl('/partners/');
const webpSource = (partner: InfoPartner) => Boolean(partner.logoUrl?.endsWith('.webp') && partner.logoFallbackUrl);
const primaryLogoSrc = (partner: InfoPartner) => partner.logoUrl?.endsWith('.webp') ? (partner.logoFallbackUrl || partner.logoUrl) : partner.logoUrl;
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main
    id="main"
    class="partners-page"
    data-ds-family="PartnersRouteComposition"
    data-ds-version="1"
    data-ds-variant="official-logo-board"
    data-ds-state={INFO_PARTNERS.length ? 'populated' : 'empty'}
    data-partners-route
  >
    <div class="page-shell page-shell--compact">
      <header class="partners-heading">
        <p class="eyebrow">Партнёры</p>
        <h1>Партнёры Полюбить Калининград Анонсы</h1>
        <p>Логотипы ведут на сайты партнёров.</p>
      </header>

      <section class="partners-grid" aria-label="Список партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class={`partner-tile partner-tile--${partner.logoShape} partner-tile--${partner.logoSurface || 'light'} ${partner.compactLabel ? 'partner-tile--with-meta' : 'partner-tile--logo-only'} ${partner.priority === 'primary' ? 'partner-tile--primary' : ''}`}
            style={`--partner-accent: ${partner.accent}; --partner-col-start: ${partner.gridColumnStart || 'auto'}; --partner-col-span: ${partner.gridColumnSpan || 1}; --partner-row-start: ${partner.gridRowStart || 'auto'}; --partner-row-span: ${partner.gridRowSpan || 1}; --partner-mobile-col-start: ${partner.mobileColumnStart || 'auto'}; --partner-mobile-col-span: ${partner.mobileColumnSpan || partner.gridColumnSpan || 1}; --partner-mobile-row-start: ${partner.mobileRowStart || 'auto'}; --partner-mobile-row-span: ${partner.mobileRowSpan || partner.gridRowSpan || 1}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <span class="partner-tile__logo" aria-hidden="true">
              {partner.logoUrl ? (
                <picture>
                  {webpSource(partner) && <source srcset={withBase(partner.logoUrl)} type="image/webp" />}
                  <img class="partner-tile__logo-img" src={withBase(primaryLogoSrc(partner) || partner.logoUrl)} alt="" loading="eager" decoding="async" />
                </picture>
              ) : (
                <span class="partner-tile__text-logo">{partner.logoText}</span>
              )}
            </span>
            {partner.compactLabel && (
              <span class="partner-tile__meta">
                <strong>{partner.shortName}</strong>
                <span>{partner.compactLabel}</span>
              </span>
            )}
          </a>
        ))}
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: clamp(2.25rem, 6vw, 4.25rem); }
  .page-shell--compact { max-width: 1100px; }
  .partners-heading {
    margin: 0.35rem 0 clamp(0.95rem, 2.6vw, 1.45rem);
    display: grid;
    gap: 0.16rem;
  }
  .partners-heading h1 {
    margin: 0;
    max-width: 58rem;
    font-size: clamp(1.8rem, 4.6vw, 2.9rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
  }
  .partners-heading p { margin: 0; max-width: 36rem; color: var(--ke-color-text-muted); }

  .partners-grid {
    --cell-h: 76px;
    --cell-gap-x: clamp(0.8rem, 2.2vw, 1.55rem);
    --cell-gap-y: clamp(0.74rem, 1.9vw, 1.08rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: var(--cell-h);
    grid-auto-flow: row dense;
    column-gap: var(--cell-gap-x);
    row-gap: var(--cell-gap-y);
    align-items: stretch;
  }
  .partner-tile {
    min-width: 0;
    min-height: 0;
    height: 100%;
    grid-column: var(--partner-mobile-col-start, auto) / span var(--partner-mobile-col-span, var(--partner-col-span, 1));
    grid-row: var(--partner-mobile-row-start, auto) / span var(--partner-mobile-row-span, var(--partner-row-span, 1));
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    align-content: center;
    align-items: center;
    justify-items: center;
    gap: 0;
    padding: 0;
    color: var(--ke-color-text-primary);
    text-decoration: none;
  }
  .partner-tile:hover .partner-tile__meta span,
  .partner-tile:focus-visible .partner-tile__meta span { color: var(--ke-color-text-primary); }
  .partner-tile:hover .partner-tile__logo-img,
  .partner-tile:focus-visible .partner-tile__logo-img,
  .partner-tile:hover .partner-tile__text-logo,
  .partner-tile:focus-visible .partner-tile__text-logo { transform: translateY(-1px); }
  .partner-tile:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--partner-accent) 34%, transparent);
    outline-offset: 5px;
    border-radius: 10px;
  }
  .partner-tile__logo {
    min-width: 0;
    width: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
  }
  .partner-tile__logo picture { width: 100%; display: grid; place-items: center; }
  .partner-tile--with-meta {
    --logo-frame: 48px;
    --caption-frame: 26px;
    grid-template-rows: minmax(0, var(--logo-frame)) minmax(0, var(--caption-frame));
    align-content: center;
    row-gap: 0.14rem;
  }
  .partner-tile--logo-only { grid-template-rows: minmax(0, 1fr); }
  .partner-tile__logo-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 48px;
    object-fit: contain;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .partner-tile--wide .partner-tile__logo-img { max-width: min(100%, 240px); max-height: 50px; }
  .partner-tile--tall.partner-tile--with-meta { --logo-frame: 106px; --caption-frame: 40px; }
  .partner-tile--tall .partner-tile__logo-img { max-height: 106px; max-width: min(100%, 150px); }
  .partner-tile--wide.partner-tile--with-meta { --logo-frame: 48px; --caption-frame: 30px; }
  .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: 48px; }
  .partner-tile--compact.partner-tile--with-meta { --logo-frame: 46px; --caption-frame: 26px; }
  .partner-tile--compact .partner-tile__logo-img { width: min(100%, 86px); max-height: 46px; }
  .partner-tile__text-logo {
    color: var(--partner-accent);
    font-size: clamp(1.35rem, 2.9vw, 2.05rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.92;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .partner-tile__meta {
    min-width: 0;
    width: 100%;
    display: grid;
    justify-items: center;
    align-items: start;
    gap: 0.05rem;
    line-height: 1.05;
    text-align: center;
  }
  .partner-tile__meta strong {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .partner-tile__meta span {
    max-width: min(100%, 18rem);
    overflow-wrap: anywhere;
    color: var(--ke-color-text-muted);
    font-size: clamp(0.66rem, 1.08vw, 0.76rem);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  @media (min-width: 680px) {
    .partners-grid {
      --cell-h: 88px;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: var(--cell-h);
    }
    .partner-tile {
      grid-column: var(--partner-col-start, auto) / span var(--partner-col-span, 1);
      grid-row: var(--partner-row-start, auto) / span var(--partner-row-span, 1);
    }
  }
  @media (min-width: 980px) {
    .partners-grid {
      --cell-h: 88px;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: var(--cell-h);
    }
    .partner-tile--tall.partner-tile--with-meta { --logo-frame: 112px; --caption-frame: 44px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 112px; max-width: min(100%, 154px); }
    .partner-tile--wide .partner-tile__logo-img { max-height: 56px; }
    .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: 50px; }
    .partner-tile--compact .partner-tile__logo-img { width: min(100%, 92px); max-height: 50px; }
  }
  @media (max-width: 620px) {
    .partners-page { padding-bottom: 3rem; }
    .page-shell--compact { padding-inline: 0.8rem; }
    .crumbs { margin-bottom: 0.4rem; }
    .partners-heading { margin-bottom: 0.9rem; }
    .partners-heading h1 { font-size: clamp(1.55rem, 8.2vw, 2.25rem); }
    .partners-heading p:not(.eyebrow) { font-size: 0.9rem; }
    .partners-grid {
      --cell-h: 76px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: var(--cell-h);
      column-gap: 0.62rem;
      row-gap: 0.78rem;
    }
    .partner-tile {
      grid-column: var(--partner-mobile-col-start, auto) / span var(--partner-mobile-col-span, var(--partner-col-span, 1));
      grid-row: var(--partner-mobile-row-start, auto) / span var(--partner-mobile-row-span, var(--partner-row-span, 1));
    }
    .partner-tile__logo-img { max-height: 42px; }
    .partner-tile--wide .partner-tile__logo-img { max-height: 44px; }
    .partner-tile--wide.partner-tile--with-meta { --logo-frame: 46px; --caption-frame: 30px; }
    .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: 44px; }
    .partner-tile--compact.partner-tile--with-meta { --logo-frame: 44px; --caption-frame: 28px; }
    .partner-tile--compact .partner-tile__logo-img { width: min(100%, 70px); max-height: 44px; }
    .partner-tile--tall.partner-tile--with-meta { --logo-frame: 104px; --caption-frame: 42px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 104px; max-width: min(100%, 148px); }
    .partner-tile--tall .partner-tile__meta span {
      width: max-content;
      max-width: min(9.6rem, 44vw);
      overflow-wrap: normal;
    }
    .partner-tile__text-logo { font-size: 1.55rem; }
    .partner-tile__meta span { font-size: 0.65rem; }
  }
  @media (max-width: 360px) {
    .partners-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); --cell-h: 70px; column-gap: 0.46rem; row-gap: 0.66rem; }
    .partner-tile--tall.partner-tile--with-meta { --logo-frame: 94px; --caption-frame: 38px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 94px; }
    .partner-tile__meta span { font-size: 0.58rem; }
  }
</style>
