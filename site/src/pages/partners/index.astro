---
import EventLayout from '../../layouts/EventLayout.astro';
import { INFO_PARTNERS } from '../../data/info-partners';
import type { InfoPartner } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Информационные партнёры | ${SITE_NAME}`;
const description = 'Информационные партнёры Полюбить Калининград Анонсы: компактный список партнёров и организаций.';
const canonicalUrl = absoluteUrl('/partners/');
const webpSource = (partner: InfoPartner) => Boolean(partner.logoUrl?.endsWith('.webp') && partner.logoFallbackUrl);
const primaryLogoSrc = (partner: InfoPartner) => partner.logoUrl?.endsWith('.webp') ? (partner.logoFallbackUrl || partner.logoUrl) : partner.logoUrl;
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="partners-page">
    <div class="page-shell page-shell--compact">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Информационные партнёры</span>
      </nav>

      <header class="partners-heading">
        <p class="eyebrow">Информационные партнёры</p>
        <h1>Партнёры</h1>
        <p>Логотипы ведут на сайты партнёров.</p>
      </header>

      <section class="partners-grid" aria-label="Список информационных партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class={`partner-tile partner-tile--${partner.logoShape} partner-tile--${partner.logoSurface || 'light'} ${partner.priority === 'primary' ? 'partner-tile--primary' : ''}`}
            style={`--partner-accent: ${partner.accent}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <span class="partner-tile__logo" aria-hidden="true">
              {partner.logoUrl ? (
                <picture>
                  {webpSource(partner) && <source srcset={withBase(partner.logoUrl)} type="image/webp" />}
                  <img class="partner-tile__logo-img" src={withBase(primaryLogoSrc(partner) || partner.logoUrl)} alt="" loading="lazy" decoding="async" />
                </picture>
              ) : (
                <span class="partner-tile__text-logo">{partner.logoText}</span>
              )}
            </span>
            <span class="partner-tile__meta">
              <strong>{partner.shortName}</strong>
              <span>{partner.compactLabel}</span>
            </span>
          </a>
        ))}
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: 4rem; }
  .page-shell--compact { max-width: 820px; }
  .partners-heading {
    margin: 0.35rem 0 0.8rem;
    display: grid;
    gap: 0.18rem;
  }
  .partners-heading h1 {
    margin: 0;
    font-size: clamp(2rem, 8vw, 4rem);
    letter-spacing: -0.08em;
    line-height: 0.92;
  }
  .partners-heading p { margin: 0; max-width: 34rem; color: var(--muted); }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(136px, 1fr));
    grid-auto-flow: dense;
    gap: 0.55rem;
    align-items: stretch;
  }
  .partner-tile {
    min-height: 132px;
    display: grid;
    grid-template-rows: minmax(58px, 1fr) auto;
    gap: 0.45rem;
    padding: 0.58rem;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 20px;
    background:
      radial-gradient(circle at 10% 0%, color-mix(in srgb, var(--partner-accent) 9%, transparent), transparent 54%),
      rgba(255, 253, 248, 0.94);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(56, 32, 18, 0.06);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .partner-tile:hover,
  .partner-tile:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--partner-accent) 38%, rgba(121, 48, 20, 0.14));
    box-shadow: 0 16px 30px rgba(56, 32, 18, 0.1);
  }
  .partner-tile:focus-visible { outline: 3px solid color-mix(in srgb, var(--partner-accent) 30%, #fff); outline-offset: 3px; }
  .partner-tile__logo {
    min-height: 58px;
    display: grid;
    place-items: center;
    padding: 0.35rem;
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.72);
  }
  .partner-tile--dark .partner-tile__logo {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--partner-accent) 96%, #111), color-mix(in srgb, var(--partner-accent) 74%, #3d0f0f));
  }
  .partner-tile__logo picture { width: 100%; display: grid; place-items: center; }
  .partner-tile__logo-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 54px;
    object-fit: contain;
  }
  .partner-tile--wide .partner-tile__logo-img { max-width: min(100%, 180px); }
  .partner-tile--tall .partner-tile__logo-img { max-height: 70px; max-width: min(100%, 94px); }
  .partner-tile--compact .partner-tile__logo-img { max-height: 48px; max-width: min(100%, 150px); }
  .partner-tile__text-logo {
    color: var(--partner-accent);
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.06em;
  }
  .partner-tile__meta {
    min-width: 0;
    display: grid;
    gap: 0.08rem;
    line-height: 1.1;
  }
  .partner-tile__meta strong {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.98rem;
    letter-spacing: -0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .partner-tile__meta span {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 680px) {
    .partners-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7rem; }
    .partner-tile--wide { grid-column: span 2; }
    .partner-tile--tall { grid-row: span 2; min-height: 272px; }
    .partner-tile--tall .partner-tile__logo { min-height: 180px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 164px; max-width: min(100%, 142px); }
    .partner-tile--primary.partner-tile--wide { grid-column: span 2; }
  }
  @media (max-width: 620px) {
    .partners-page { padding-bottom: 3rem; }
    .page-shell--compact { padding-inline: 0.8rem; }
    .crumbs { margin-bottom: 0.4rem; }
    .partners-heading { margin-bottom: 0.65rem; }
    .partners-heading p:not(.eyebrow) { font-size: 0.9rem; }
    .partners-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.48rem; }
    .partner-tile,
    .partner-tile--wide,
    .partner-tile--tall {
      grid-column: auto;
      grid-row: auto;
      min-height: 120px;
      border-radius: 17px;
    }
    .partner-tile__logo { min-height: 52px; padding: 0.28rem; }
    .partner-tile__logo-img { max-height: 48px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 54px; }
  }
  @media (max-width: 360px) {
    .partners-grid { grid-template-columns: 1fr 1fr; }
    .partner-tile { min-height: 112px; padding: 0.48rem; }
    .partner-tile__meta strong { font-size: 0.9rem; }
    .partner-tile__meta span { font-size: 0.68rem; }
  }
</style>
