---
import EventLayout from '../../layouts/EventLayout.astro';
import { INFO_PARTNERS } from '../../data/info-partners';
import type { InfoPartner } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Информационные партнёры | ${SITE_NAME}`;
const description = 'Информационные партнёры Полюбить Калининград Анонсы: компактный список партнёров и организаций.';
const canonicalUrl = absoluteUrl('/partners/');
const webpSource = (partner: InfoPartner) => Boolean(partner.logoUrl?.endsWith('.webp') && partner.logoFallbackUrl);
const primaryLogoSrc = (partner: InfoPartner) => partner.logoUrl?.endsWith('.webp') ? (partner.logoFallbackUrl || partner.logoUrl) : partner.logoUrl;
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="partners-page">
    <div class="page-shell page-shell--compact">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Информационные партнёры</span>
      </nav>

      <header class="partners-heading">
        <p class="eyebrow">Информационные партнёры</p>
        <h1>Партнёры</h1>
        <p>Логотипы ведут на сайты партнёров.</p>
      </header>

      <section class="partners-grid" aria-label="Список информационных партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class={`partner-tile partner-tile--${partner.logoShape} partner-tile--${partner.logoSurface || 'light'} ${partner.priority === 'primary' ? 'partner-tile--primary' : ''}`}
            style={`--partner-accent: ${partner.accent}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <span class="partner-tile__logo" aria-hidden="true">
              {partner.logoUrl ? (
                <picture>
                  {webpSource(partner) && <source srcset={withBase(partner.logoUrl)} type="image/webp" />}
                  <img class="partner-tile__logo-img" src={withBase(primaryLogoSrc(partner) || partner.logoUrl)} alt="" loading="eager" decoding="async" />
                </picture>
              ) : (
                <span class="partner-tile__text-logo">{partner.logoText}</span>
              )}
            </span>
            <span class="partner-tile__meta">
              <strong>{partner.shortName}</strong>
              <span>{partner.compactLabel}</span>
            </span>
          </a>
        ))}
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: clamp(2.25rem, 6vw, 4.25rem); }
  .page-shell--compact { max-width: 1080px; }
  .partners-heading {
    margin: 0.35rem 0 clamp(0.8rem, 2.2vw, 1.15rem);
    display: grid;
    gap: 0.16rem;
  }
  .partners-heading h1 {
    margin: 0;
    font-size: clamp(1.95rem, 6.2vw, 3.25rem);
    letter-spacing: -0.07em;
    line-height: 0.96;
  }
  .partners-heading p { margin: 0; max-width: 36rem; color: var(--muted); }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(124px, 1fr));
    grid-auto-flow: dense;
    column-gap: clamp(0.9rem, 2.6vw, 1.9rem);
    row-gap: clamp(0.72rem, 2vw, 1.2rem);
    align-items: end;
  }
  .partner-tile {
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(34px, auto) auto;
    align-content: end;
    justify-items: center;
    gap: 0.32rem;
    padding: 0.12rem 0.04rem;
    color: var(--text);
    text-decoration: none;
  }
  .partner-tile:hover .partner-tile__meta span,
  .partner-tile:focus-visible .partner-tile__meta span { color: var(--ink); }
  .partner-tile:hover .partner-tile__logo-img,
  .partner-tile:focus-visible .partner-tile__logo-img,
  .partner-tile:hover .partner-tile__text-logo,
  .partner-tile:focus-visible .partner-tile__text-logo { transform: translateY(-1px); }
  .partner-tile:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--partner-accent) 34%, transparent);
    outline-offset: 5px;
    border-radius: 10px;
  }
  .partner-tile__logo {
    min-width: 0;
    width: 100%;
    display: grid;
    place-items: end center;
  }
  .partner-tile__logo picture { width: 100%; display: grid; place-items: end center; }
  .partner-tile__logo-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 46px;
    object-fit: contain;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .partner-tile--wide .partner-tile__logo-img { max-width: min(100%, 220px); max-height: 43px; }
  .partner-tile--tall .partner-tile__logo-img { max-height: 72px; max-width: min(100%, 118px); }
  .partner-tile--compact .partner-tile__logo-img { max-height: 40px; max-width: min(100%, 154px); }
  .partner-tile__text-logo {
    color: var(--partner-accent);
    font-size: clamp(1.35rem, 2.9vw, 2.05rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.92;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .partner-tile__meta {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    line-height: 1.08;
    text-align: center;
  }
  .partner-tile__meta strong {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .partner-tile__meta span {
    max-width: min(100%, 18rem);
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: clamp(0.66rem, 1.08vw, 0.76rem);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  @media (min-width: 680px) {
    .partners-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .partner-tile--wide { grid-column: span 2; }
    .partner-tile--primary.partner-tile--wide { grid-column: span 2; }
  }
  @media (min-width: 980px) {
    .partners-grid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .partner-tile--wide { grid-column: span 2; }
    .partner-tile--tall { grid-row: span 2; }
  }
  @media (max-width: 620px) {
    .partners-page { padding-bottom: 3rem; }
    .page-shell--compact { padding-inline: 0.8rem; }
    .crumbs { margin-bottom: 0.4rem; }
    .partners-heading { margin-bottom: 0.75rem; }
    .partners-heading p:not(.eyebrow) { font-size: 0.9rem; }
    .partners-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.72rem;
      row-gap: 0.88rem;
    }
    .partner-tile,
    .partner-tile--wide,
    .partner-tile--tall {
      grid-column: auto;
      grid-row: auto;
      min-height: 0;
      padding: 0.06rem 0;
    }
    .partner-tile__logo-img { max-height: 42px; }
    .partner-tile--wide .partner-tile__logo-img { max-height: 38px; }
    .partner-tile--tall .partner-tile__logo-img { max-height: 52px; }
    .partner-tile__text-logo { font-size: 1.55rem; }
    .partner-tile__meta span { font-size: 0.65rem; }
  }
  @media (max-width: 360px) {
    .partners-grid { column-gap: 0.58rem; row-gap: 0.78rem; }
    .partner-tile__meta span { font-size: 0.62rem; }
  }
</style>
