---
import EventLayout from '../../layouts/EventLayout.astro';
import { INFO_PARTNERS } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Информационные партнёры | ${SITE_NAME}`;
const description = 'Список информационных партнёров Полюбить Калининград Анонсы: организации, институции и фестивальные программы.';
const canonicalUrl = absoluteUrl('/partners/');
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="partners-page">
    <div class="page-shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Информационные партнёры</span>
      </nav>

      <section class="section-card partners-hero">
        <div class="section-card__inner partners-hero__inner">
          <p class="eyebrow">Информационные партнёры</p>
          <h1>Организации и фестивали, с которыми мы делаем анонсы заметнее</h1>
          <p class="lead">Эта страница собирает статус информационного партнёра в одном месте: логотипы ведут на сайты организаций, а ссылки помечены как внешние nofollow.</p>
          <div class="source-links">
            <a href={withBase('/segodnya/')}>Сегодня</a>
            <a href={withBase('/poisk/')}>Поиск по афише</a>
          </div>
        </div>
      </section>

      <section class="partners-grid" aria-label="Список информационных партнёров">
        {INFO_PARTNERS.map((partner) => (
          <article class="partner-card" style={`--partner-accent: ${partner.accent}`}>
            <a
              class="partner-card__logo-link"
              href={partner.href}
              target="_blank"
              rel="nofollow noopener noreferrer"
              aria-label={`${partner.name}: открыть сайт партнёра`}
            >
              <span class="partner-card__logo" aria-hidden="true">
                <span>{partner.logoText}</span>
              </span>
            </a>
            <div class="partner-card__body">
              <p class="eyebrow">Инфопартнёр</p>
              <h2>{partner.shortName}</h2>
              <p>{partner.name}</p>
              <p class="partner-card__description">{partner.description}</p>
              <a
                class="partner-card__site"
                href={partner.href}
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                Сайт партнёра ↗
              </a>
            </div>
          </article>
        ))}
      </section>

      <section class="section-card section-card--quiet partners-note" data-nosnippet>
        <div class="section-card__inner">
          <h2>Статус страницы</h2>
          <p>Стартовый список партнёров задан вручную. Перед production-публикацией официальные SVG/PNG-логотипы нужно заменить на согласованные файлы в репозитории или CDN-манифесте; текущий preview использует текстовые logo-lockup-заглушки без OpenAI image generation.</p>
        </div>
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: 6rem; }
  .partners-hero { overflow: hidden; }
  .partners-hero__inner {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }
  .partners-hero h1 { max-width: 18ch; }
  .partners-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem;
  }
  .partner-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 100%;
    border: 1px solid rgba(121, 48, 20, 0.13);
    border-radius: var(--radius-xl);
    background: rgba(255, 253, 248, 0.94);
    box-shadow: var(--shadow);
  }
  .partner-card__logo-link {
    display: grid;
    min-height: 150px;
    place-items: center;
    padding: 1.2rem;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--partner-accent) 18%, transparent), transparent 62%),
      linear-gradient(135deg, rgba(255,255,255,0.96), rgba(247,239,227,0.88));
    text-decoration: none;
  }
  .partner-card__logo {
    width: min(100%, 220px);
    min-height: 88px;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 2px solid color-mix(in srgb, var(--partner-accent) 72%, #ffffff);
    border-radius: 24px;
    background: rgba(255,255,255,0.82);
    color: var(--partner-accent);
    box-shadow: 0 18px 38px color-mix(in srgb, var(--partner-accent) 14%, transparent);
    font-weight: 900;
    letter-spacing: -0.04em;
    font-size: clamp(1.75rem, 7vw, 3.2rem);
    line-height: 1;
    text-align: center;
  }
  .partner-card__body {
    display: grid;
    align-content: start;
    gap: 0.48rem;
    padding: clamp(1rem, 3vw, 1.25rem);
  }
  .partner-card__body h2 { margin: 0; font-size: clamp(1.35rem, 4vw, 1.9rem); }
  .partner-card__body p { margin: 0; }
  .partner-card__description { color: var(--muted); }
  .partner-card__site {
    min-height: 40px;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    margin-top: 0.35rem;
    color: var(--primary-strong);
    font-weight: 800;
  }
  .partners-note { margin-top: 1rem; }
  .partners-note h2 { margin-top: 0; }
  .partners-note p { margin-bottom: 0; color: var(--muted); }
</style>
