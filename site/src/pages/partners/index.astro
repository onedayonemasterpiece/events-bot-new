---
import EventLayout from '../../layouts/EventLayout.astro';
import '../../components/design-system/product-contour-foundations.css';
import { INFO_PARTNERS } from '../../data/info-partners';
import type { InfoPartner } from '../../data/info-partners';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

const title = `Партнёры | ${SITE_NAME}`;
const description = 'Партнёры Полюбить Калининград Анонсы: компактная сетка партнёрских логотипов.';
const canonicalUrl = absoluteUrl('/partners/');
const webpSource = (partner: InfoPartner) => Boolean(partner.logoUrl?.endsWith('.webp') && partner.logoFallbackUrl);
const primaryLogoSrc = (partner: InfoPartner) => partner.logoUrl?.endsWith('.webp') ? (partner.logoFallbackUrl || partner.logoUrl) : partner.logoUrl;
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main
    id="main"
    class="partners-page"
    data-ds-family="PartnersRouteComposition"
    data-ds-version="1"
    data-ds-variant="official-logo-board"
    data-ds-state={INFO_PARTNERS.length ? 'populated' : 'empty'}
    data-ke-foundation-consumer="partners-route"
    data-partners-route
  >
    <div class="page-shell page-shell--compact">
      <header class="partners-heading">
        <p class="eyebrow">Партнёры</p>
        <h1>Партнёры Полюбить Калининград Анонсы</h1>
        <p>Логотипы ведут на сайты партнёров.</p>
      </header>

      <section class="partners-grid" aria-label="Список партнёров">
        {INFO_PARTNERS.map((partner) => (
          <a
            class={`partner-tile partner-tile--${partner.logoShape} partner-tile--${partner.logoSurface || 'light'} ${partner.compactLabel ? 'partner-tile--with-meta' : 'partner-tile--logo-only'} ${partner.priority === 'primary' ? 'partner-tile--primary' : ''}`}
            style={`--partner-accent: ${partner.accent}; --partner-col-start: ${partner.gridColumnStart || 'auto'}; --partner-col-span: ${partner.gridColumnSpan || 1}; --partner-row-start: ${partner.gridRowStart || 'auto'}; --partner-row-span: ${partner.gridRowSpan || 1}; --partner-mobile-col-start: ${partner.mobileColumnStart || 'auto'}; --partner-mobile-col-span: ${partner.mobileColumnSpan || partner.gridColumnSpan || 1}; --partner-mobile-row-start: ${partner.mobileRowStart || 'auto'}; --partner-mobile-row-span: ${partner.mobileRowSpan || partner.gridRowSpan || 1}`}
            href={partner.href}
            target="_blank"
            rel="nofollow noopener noreferrer"
            aria-label={`${partner.name}: открыть сайт партнёра`}
          >
            <span class="partner-tile__logo" aria-hidden="true">
              {partner.logoUrl ? (
                <picture>
                  {webpSource(partner) && <source srcset={withBase(partner.logoUrl)} type="image/webp" />}
                  <img class="partner-tile__logo-img" src={withBase(primaryLogoSrc(partner) || partner.logoUrl)} alt="" loading="eager" decoding="async" />
                </picture>
              ) : (
                <span class="partner-tile__text-logo">{partner.logoText}</span>
              )}
            </span>
            {partner.compactLabel && (
              <span class="partner-tile__meta">
                <strong>{partner.shortName}</strong>
                <span>{partner.compactLabel}</span>
              </span>
            )}
          </a>
        ))}
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partners-page { padding-bottom: var(--ke-partners-page-padding-bottom); }
  .page-shell--compact { max-width: var(--ke-partners-container); }
  .partners-heading {
    margin: var(--ke-partners-heading-margin-top) 0 var(--ke-partners-heading-margin-bottom);
    display: grid;
    gap: var(--ke-partners-heading-gap);
  }
  .partners-heading h1 {
    margin: 0;
    max-width: var(--ke-partners-heading-max);
    font: var(--ke-type-h1);
    letter-spacing: var(--ke-type-h1-letter);
  }
  .partners-heading p {
    margin: 0;
    max-width: var(--ke-partners-copy-max);
    color: var(--ke-color-text-muted);
  }

  .partners-grid {
    --cell-h: var(--ke-partners-grid-row-height);
    display: grid;
    grid-template-columns: repeat(var(--ke-partners-grid-columns-mobile), minmax(0, 1fr));
    grid-auto-rows: var(--cell-h);
    grid-auto-flow: row dense;
    column-gap: var(--ke-partners-grid-column-gap);
    row-gap: var(--ke-partners-grid-row-gap);
    align-items: stretch;
  }
  .partner-tile {
    min-width: 0;
    min-height: 0;
    height: 100%;
    grid-column: var(--partner-mobile-col-start, auto) / span var(--partner-mobile-col-span, var(--partner-col-span, 1));
    grid-row: var(--partner-mobile-row-start, auto) / span var(--partner-mobile-row-span, var(--partner-row-span, 1));
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    align-content: center;
    align-items: center;
    justify-items: center;
    gap: 0;
    padding: 0;
    color: var(--ke-color-text-primary);
    text-decoration: none;
  }
  .partner-tile:hover .partner-tile__meta span,
  .partner-tile:focus-visible .partner-tile__meta span { color: var(--ke-color-text-primary); }
  .partner-tile:hover .partner-tile__logo-img,
  .partner-tile:focus-visible .partner-tile__logo-img,
  .partner-tile:hover .partner-tile__text-logo,
  .partner-tile:focus-visible .partner-tile__text-logo { transform: translateY(var(--ke-partner-hover-offset)); }
  .partner-tile:focus-visible {
    outline: var(--ke-partner-focus-width) solid color-mix(in srgb, var(--partner-accent) var(--ke-partner-focus-alpha), transparent);
    outline-offset: var(--ke-partner-focus-offset);
    border-radius: var(--ke-partner-focus-radius);
  }
  .partner-tile__logo {
    min-width: 0;
    width: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
  }
  .partner-tile__logo picture { width: 100%; display: grid; place-items: center; }
  .partner-tile--with-meta {
    --logo-frame: var(--ke-partner-logo-height);
    --caption-frame: var(--ke-partner-caption-height);
    grid-template-rows: minmax(0, var(--logo-frame)) minmax(0, var(--caption-frame));
    align-content: center;
    row-gap: var(--ke-partner-caption-gap);
  }
  .partner-tile--logo-only { grid-template-rows: minmax(0, 1fr); }
  .partner-tile__logo-img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: var(--ke-partner-logo-height);
    object-fit: contain;
    transition: transform var(--ke-partner-motion), opacity var(--ke-partner-motion);
  }
  .partner-tile--wide .partner-tile__logo-img {
    max-width: min(100%, var(--ke-partner-logo-width-wide));
    max-height: var(--ke-partner-logo-height-wide);
  }
  .partner-tile--tall.partner-tile--with-meta {
    --logo-frame: var(--ke-partner-logo-height-tall);
    --caption-frame: var(--ke-partner-caption-height-tall);
  }
  .partner-tile--tall .partner-tile__logo-img {
    max-height: var(--ke-partner-logo-height-tall);
    max-width: min(100%, var(--ke-partner-logo-width-tall));
  }
  .partner-tile--wide.partner-tile--with-meta {
    --logo-frame: var(--ke-partner-logo-height);
    --caption-frame: var(--ke-partner-caption-height-wide);
  }
  .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: var(--ke-partner-logo-height); }
  .partner-tile--compact.partner-tile--with-meta {
    --logo-frame: var(--ke-partner-logo-height-compact);
    --caption-frame: var(--ke-partner-caption-height);
  }
  .partner-tile--compact .partner-tile__logo-img {
    width: min(100%, var(--ke-partner-logo-width-compact));
    max-height: var(--ke-partner-logo-height-compact);
  }
  .partner-tile__text-logo {
    color: var(--partner-accent);
    font-size: var(--ke-partner-text-logo-size);
    font-weight: var(--ke-partner-text-logo-weight);
    letter-spacing: var(--ke-partner-text-logo-letter);
    line-height: var(--ke-partner-text-logo-line);
    transition: transform var(--ke-partner-motion), opacity var(--ke-partner-motion);
  }
  .partner-tile__meta {
    min-width: 0;
    width: 100%;
    display: grid;
    justify-items: center;
    align-items: start;
    gap: var(--ke-partner-meta-gap);
    line-height: var(--ke-partner-meta-line);
    text-align: center;
  }
  .partner-tile__meta strong {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .partner-tile__meta span {
    max-width: min(100%, var(--ke-partner-meta-max));
    overflow-wrap: anywhere;
    color: var(--ke-color-text-muted);
    font-size: var(--ke-partner-meta-size);
    font-weight: var(--ke-partner-meta-weight);
    letter-spacing: var(--ke-partner-meta-letter);
  }
  @media (min-width: 680px) {
    .partners-grid {
      --cell-h: var(--ke-partners-grid-row-height-wide);
      grid-template-columns: repeat(var(--ke-partners-grid-columns-wide), minmax(0, 1fr));
    }
    .partner-tile {
      grid-column: var(--partner-col-start, auto) / span var(--partner-col-span, 1);
      grid-row: var(--partner-row-start, auto) / span var(--partner-row-span, 1);
    }
  }
  @media (min-width: 980px) {
    .partner-tile--tall.partner-tile--with-meta {
      --logo-frame: var(--ke-partner-logo-height-tall-desktop);
      --caption-frame: var(--ke-partner-caption-height-tall-desktop);
    }
    .partner-tile--tall .partner-tile__logo-img {
      max-height: var(--ke-partner-logo-height-tall-desktop);
      max-width: min(100%, var(--ke-partner-logo-width-tall-desktop));
    }
    .partner-tile--wide .partner-tile__logo-img { max-height: var(--ke-partner-logo-height-wide-desktop); }
    .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: var(--ke-partner-logo-height-wide); }
    .partner-tile--compact .partner-tile__logo-img {
      width: min(100%, var(--ke-partner-logo-width-compact));
      max-height: var(--ke-partner-logo-height-wide);
    }
  }
  @media (max-width: 620px) {
    .partners-page { padding-bottom: var(--ke-partners-mobile-padding-bottom); }
    .page-shell--compact { padding-inline: var(--ke-partners-mobile-container-padding); }
    .crumbs { margin-bottom: var(--ke-partners-mobile-crumbs-margin-bottom); }
    .partners-heading { margin-bottom: var(--ke-partners-mobile-heading-margin-bottom); }
    .partners-heading p:not(.eyebrow) { font-size: var(--ke-partners-mobile-copy-size); }
    .partners-grid {
      --cell-h: var(--ke-partners-grid-row-height);
      grid-template-columns: repeat(var(--ke-partners-grid-columns-mobile), minmax(0, 1fr));
      column-gap: var(--ke-partners-mobile-column-gap);
      row-gap: var(--ke-partners-mobile-row-gap);
    }
    .partner-tile {
      grid-column: var(--partner-mobile-col-start, auto) / span var(--partner-mobile-col-span, var(--partner-col-span, 1));
      grid-row: var(--partner-mobile-row-start, auto) / span var(--partner-mobile-row-span, var(--partner-row-span, 1));
    }
    .partner-tile__logo-img { max-height: var(--ke-partner-mobile-logo-height); }
    .partner-tile--wide .partner-tile__logo-img { max-height: var(--ke-partner-mobile-logo-height-wide); }
    .partner-tile--wide.partner-tile--with-meta {
      --logo-frame: var(--ke-partner-mobile-logo-height-wide);
      --caption-frame: var(--ke-partner-mobile-caption-height-wide);
    }
    .partner-tile--wide.partner-tile--with-meta .partner-tile__logo-img { max-height: var(--ke-partner-mobile-logo-height-wide); }
    .partner-tile--compact.partner-tile--with-meta {
      --logo-frame: var(--ke-partner-mobile-logo-height-compact);
      --caption-frame: var(--ke-partner-mobile-caption-height-compact);
    }
    .partner-tile--compact .partner-tile__logo-img {
      width: min(100%, var(--ke-partner-mobile-logo-width-compact));
      max-height: var(--ke-partner-mobile-logo-height-compact);
    }
    .partner-tile--tall.partner-tile--with-meta {
      --logo-frame: var(--ke-partner-mobile-logo-height-tall);
      --caption-frame: var(--ke-partner-mobile-caption-height-tall);
    }
    .partner-tile--tall .partner-tile__logo-img {
      max-height: var(--ke-partner-mobile-logo-height-tall);
      max-width: min(100%, var(--ke-partner-mobile-logo-width-tall));
    }
    .partner-tile--tall .partner-tile__meta span {
      width: max-content;
      max-width: min(var(--ke-partner-mobile-meta-max), var(--ke-partner-mobile-meta-viewport-max));
      overflow-wrap: normal;
    }
    .partner-tile__text-logo { font-size: var(--ke-partner-mobile-text-logo-size); }
    .partner-tile__meta span { font-size: var(--ke-partner-mobile-meta-size); }
  }
  @media (max-width: 360px) {
    .partners-grid {
      --cell-h: var(--ke-partners-narrow-row-height);
      column-gap: var(--ke-partners-narrow-column-gap);
      row-gap: var(--ke-partners-narrow-row-gap);
    }
    .partner-tile--tall.partner-tile--with-meta {
      --logo-frame: var(--ke-partner-narrow-logo-height-tall);
      --caption-frame: var(--ke-partner-narrow-caption-height-tall);
    }
    .partner-tile--tall .partner-tile__logo-img { max-height: var(--ke-partner-narrow-logo-height-tall); }
    .partner-tile__meta span { font-size: var(--ke-partner-narrow-meta-size); }
  }
</style>