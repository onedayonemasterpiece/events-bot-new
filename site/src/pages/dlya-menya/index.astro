---
import EventLayout from '../../layouts/EventLayout.astro';
import PersonalFeedSlot from '../../components/PersonalFeedSlot.astro';
import { absoluteUrl, SITE_NAME } from '../../lib/events';
---
<EventLayout title={`Для меня | ${SITE_NAME}`} description="События с учётом ваших интересов." canonicalUrl={absoluteUrl('/dlya-menya/')} structuredData={[]} mobileSection="personal" noindex>
  <main id="main" class="page-shell personal-page" data-ds-family="ForMeRouteComposition" data-ds-version="2" data-ds-variant="automatic-local-feed" data-ds-state="anonymous cold-start" data-personal-page>
    <header><h1>Для меня</h1><p>Начните с этих событий. Ваши лайки и отметки «Не интересно» помогут настроить ленту на этом устройстве.</p></header>
    <PersonalFeedSlot context="for-me" />
    <button class="personalization-reset-button" type="button" data-reset-personalization>Сбросить рекомендации</button>
    <p data-personalization-reset-status role="status"></p>
  </main>
</EventLayout>
<style>
.personal-page {padding-block:var(--ke-space-6) calc(120px + env(safe-area-inset-bottom));}
.personal-page h1 {margin-top:0;font:var(--ke-type-h1);letter-spacing:var(--ke-type-h1-letter);}
.personal-page header p {max-width:56ch;font:var(--ke-type-body);}
@media(max-width:759px){.personal-page{padding-top:var(--ke-space-16);}}
</style>
