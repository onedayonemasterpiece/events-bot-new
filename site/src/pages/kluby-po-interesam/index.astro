---
import EventLayout from '../../layouts/EventLayout.astro';
import InterestClubCard from '../../components/InterestClubCard.astro';
import ClubCatalogKeyboard from '../../components/ClubCatalogKeyboard.astro';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';
import { getInterestClubs, interestClubAbsoluteUrl } from '../../lib/clubs';

const clubs = getInterestClubs();
const canonicalUrl = absoluteUrl('/kluby-po-interesam/');
const title = `Клубы по интересам Калининграда | ${SITE_NAME}`;
const description = 'Публичные клубы и сообщества Калининградской области, подтверждённые повторяющимися встречами в каталоге событий.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Клубы по интересам',
    description,
    url: canonicalUrl,
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Подтверждённые клубы по интересам',
    numberOfItems: clubs.length,
    itemListElement: clubs.map((club, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: club.name,
      url: interestClubAbsoluteUrl(club),
    })),
  },
];
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={structuredData} headerCurrent="clubs">
  <main
    id="main"
    data-ds-family="InterestClubsIndexRouteComposition"
    data-ds-version="1"
    data-ds-variant="verified-directory"
    data-ds-state={clubs.length ? 'populated' : 'empty'}
  >
    <div class="page-shell club-page" data-club-catalog>
      <div class="club-mobile-shelf" data-club-mobile-shelf aria-label="Текущий раздел">
        <strong>Клубы по интересам</strong>
        <span>{clubs.length ? `${clubs.length} в каталоге` : 'Каталог готовится'}</span>
      </div>
      <header class="club-intro section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Встречаться вокруг общего дела</p>
          <h1>Клубы по интересам</h1>
          <p class="lead">Публичные сообщества Калининградской области, у которых подтверждено несколько встреч в разные даты. Площадка или похожее название сами по себе клубом не считаются.</p>
          <p class="club-intro__count" aria-live="polite">
            <span aria-hidden="true">▥</span>{clubs.length ? `В каталоге: ${clubs.length}` : 'Подтверждённых клубов пока нет'}
          </p>
        </div>
      </header>

      {clubs.length ? (
        <section
          class="club-list"
          aria-labelledby="club-list-title"
          data-club-list
          data-club-columns={Math.min(clubs.length, 3)}
          style={`--club-columns:${Math.min(clubs.length, 3)}`}
        >
          <h2 id="club-list-title" class="visually-hidden">Список клубов</h2>
          {clubs.map((club) => <InterestClubCard club={club} />)}
        </section>
      ) : (
        <section class="section-card club-empty" aria-labelledby="club-empty-title">
          <div class="section-card__inner">
            <h2 id="club-empty-title">Каталог готовится</h2>
            <p>Мы публикуем клуб только после подтверждения его идентичности и нескольких встреч. Пока можно выбрать события в общей афише.</p>
            <a class="secondary-button" href={withBase('/segodnya/')}>События сегодня</a>
          </div>
        </section>
      )}
      <ClubCatalogKeyboard />
    </div>
  </main>
</EventLayout>

<style>
  .club-page { display:grid; gap:clamp(1rem,2.6vw,2rem); }
  .club-mobile-shelf { display:none; }
  .club-intro {
    overflow:hidden;
    border-color:rgba(255,255,255,.78);
    background:
      radial-gradient(circle at 78% 18%,rgba(151,212,255,.42),transparent 31%),
      radial-gradient(circle at 18% 82%,rgba(240,198,132,.23),transparent 30%),
      linear-gradient(135deg,rgba(255,253,248,.98),rgba(221,239,242,.9));
    box-shadow:0 24px 52px rgba(64,57,49,.14);
  }
  .club-intro .section-card__inner { display:grid; justify-items:center; padding:clamp(2.25rem,6vw,4.6rem) clamp(1rem,5vw,4rem); text-align:center; }
  .club-intro h1 { max-width:22ch; margin:.1rem 0 .8rem; font-size:clamp(2rem,4.4vw,3.65rem); line-height:1.05; letter-spacing:-.035em; text-wrap:balance; }
  .club-intro .lead { max-width:66ch; margin:0; color:#3d3935; font-size:clamp(1rem,1.6vw,1.18rem); line-height:1.55; }
  .club-intro__count { width:max-content; max-width:100%; display:inline-flex; align-items:center; gap:.45rem; margin:1.35rem 0 0; padding:.48rem .85rem; border:1px solid rgba(255,255,255,.88); border-radius:999px; background:rgba(255,255,255,.62); color:#263f43; box-shadow:0 10px 26px rgba(51,67,68,.13); font-weight:850; }
  .club-intro__count span { color:#6b7e80; }
  .club-list { display:grid; grid-template-columns:repeat(var(--club-columns),minmax(0,1fr)); gap:clamp(1rem,2.2vw,1.65rem); min-width:0; }
  .club-empty { text-align:center; }
  .club-empty .secondary-button { margin-top:.7rem; }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  @media (max-width: 760px) {
    .club-page { gap:1rem; }
    .club-mobile-shelf {
      position:sticky;
      z-index:48;
      top:var(--ke-site-header-bar-height);
      min-height:52px;
      margin:-1.2rem -12px 0;
      padding:.55rem 12px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.75rem;
      border-block:1px solid rgba(121,48,20,.14);
      background:rgba(255,250,242,.97);
      color:#221a14;
      box-shadow:0 7px 16px rgba(72,45,25,.07);
      backdrop-filter:blur(12px);
    }
    .club-mobile-shelf strong {
      min-width:0;
      overflow:hidden;
      font-size:1rem;
      font-weight:900;
      letter-spacing:-.025em;
      line-height:1.1;
      text-overflow:ellipsis;
      white-space:nowrap;
    }
    .club-mobile-shelf span {
      flex:none;
      color:#793014;
      font-size:.72rem;
      font-weight:850;
      white-space:nowrap;
    }
    .club-intro .section-card__inner { justify-items:start; padding:1.3rem 1rem; text-align:left; }
    .club-intro h1 { max-width:15ch; font-size:clamp(1.85rem,9vw,2.55rem); }
    .club-intro .lead { font-size:1rem; }
    .club-list { grid-template-columns:1fr; }
  }
</style>
