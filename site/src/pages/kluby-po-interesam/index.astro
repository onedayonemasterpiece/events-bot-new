---
import EventLayout from '../../layouts/EventLayout.astro';
import InterestClubCard from '../../components/InterestClubCard.astro';
import ClubCatalogKeyboard from '../../components/ClubCatalogKeyboard.astro';
import SemanticIcon from '../../components/design-system/SemanticIcon.astro';
import '../../components/design-system/product-contour-foundations.css';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';
import { getInterestClubs, interestClubAbsoluteUrl } from '../../lib/clubs';

const clubs = getInterestClubs();
const canonicalUrl = absoluteUrl('/kluby-po-interesam/');
const title = `Клубы по интересам Калининграда | ${SITE_NAME}`;
const description = 'Публичные клубы и сообщества Калининградской области, подтверждённые повторяющимися встречами в каталоге событий.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Клубы по интересам',
    description,
    url: canonicalUrl,
    isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Подтверждённые клубы по интересам',
    numberOfItems: clubs.length,
    itemListElement: clubs.map((club, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: club.name,
      url: interestClubAbsoluteUrl(club),
    })),
  },
];
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={structuredData} headerCurrent="clubs">
  <main
    id="main"
    data-ds-family="InterestClubsIndexRouteComposition"
    data-ds-version="1"
    data-ds-variant="verified-directory"
    data-ds-state={clubs.length ? 'populated' : 'empty'}
    data-ke-foundation-consumer="interest-clubs-index-route"
  >
    <div class="page-shell club-page" data-club-catalog>
      <div class="club-mobile-shelf" data-club-mobile-shelf aria-label="Текущий раздел">
        <strong>Клубы по интересам</strong>
        <span>{clubs.length ? `${clubs.length} в каталоге` : 'Каталог готовится'}</span>
      </div>
      <header class="club-intro section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Встречаться вокруг общего дела</p>
          <h1>Клубы по интересам</h1>
          <p class="lead">Публичные сообщества Калининградской области, у которых подтверждено несколько встреч в разные даты. Площадка или похожее название сами по себе клубом не считаются.</p>
          <p class="club-intro__count" aria-live="polite">
            <span class="club-intro__count-icon" aria-hidden="true"><SemanticIcon name="catalog-grid" role="inline" /></span>
            {clubs.length ? `В каталоге: ${clubs.length}` : 'Подтверждённых клубов пока нет'}
          </p>
        </div>
      </header>

      {clubs.length ? (
        <section
          class="club-list"
          aria-labelledby="club-list-title"
          data-club-list
          data-club-columns={Math.min(clubs.length, 3)}
          style={`--club-columns:${Math.min(clubs.length, 3)}`}
        >
          <h2 id="club-list-title" class="visually-hidden">Список клубов</h2>
          {clubs.map((club) => <InterestClubCard club={club} />)}
        </section>
      ) : (
        <section class="section-card club-empty" aria-labelledby="club-empty-title">
          <div class="section-card__inner">
            <h2 id="club-empty-title">Каталог готовится</h2>
            <p>Мы публикуем клуб только после подтверждения его идентичности и нескольких встреч. Пока можно выбрать события в общей афише.</p>
            <a class="secondary-button" href={withBase('/segodnya/')}>События сегодня</a>
          </div>
        </section>
      )}
      <ClubCatalogKeyboard />
    </div>
  </main>
</EventLayout>

<style>
  .club-page { display:grid; gap:var(--ke-clubs-page-gap); }
  .club-mobile-shelf { display:none; }
  .club-intro {
    overflow:hidden;
    border-color:var(--ke-color-clubs-intro-border);
    background:
      radial-gradient(circle at 78% 18%,var(--ke-color-clubs-intro-sky-glow),transparent var(--ke-clubs-intro-sky-stop)),
      radial-gradient(circle at 18% 82%,var(--ke-color-clubs-intro-gold-glow),transparent var(--ke-clubs-intro-gold-stop)),
      linear-gradient(135deg,var(--ke-color-clubs-intro-surface-start),var(--ke-color-clubs-intro-surface-end));
    box-shadow:var(--ke-elevation-clubs-intro);
  }
  .club-intro .section-card__inner {
    display:grid;
    justify-items:center;
    padding:var(--ke-clubs-intro-padding-block) var(--ke-clubs-intro-padding-inline);
    text-align:center;
  }
  .club-intro h1 {
    max-width:var(--ke-clubs-intro-heading-max);
    margin:var(--ke-clubs-intro-heading-margin);
    font-size:var(--ke-clubs-intro-heading-size);
    font-weight:var(--ke-type-h1-weight);
    line-height:var(--ke-clubs-intro-heading-line);
    letter-spacing:var(--ke-clubs-intro-heading-letter);
    text-wrap:balance;
  }
  .club-intro .lead {
    max-width:var(--ke-clubs-intro-lead-max);
    margin:0;
    color:var(--ke-color-clubs-intro-lead);
    font-size:var(--ke-clubs-intro-lead-size);
    line-height:var(--ke-clubs-intro-lead-line);
  }
  .club-intro__count {
    width:max-content;
    max-width:100%;
    display:inline-flex;
    align-items:center;
    gap:var(--ke-clubs-count-gap);
    margin:var(--ke-clubs-count-margin);
    padding:var(--ke-clubs-count-padding-block) var(--ke-clubs-count-padding-inline);
    border:var(--ke-clubs-count-border) solid var(--ke-color-clubs-count-border);
    border-radius:var(--ke-clubs-count-radius);
    background:var(--ke-color-clubs-count-surface);
    color:var(--ke-color-clubs-count-text);
    box-shadow:var(--ke-elevation-clubs-count);
    font-weight:var(--ke-clubs-count-weight);
  }
  .club-intro__count-icon { display:inline-flex; color:var(--ke-color-clubs-count-icon); }
  .club-list {
    display:grid;
    grid-template-columns:repeat(var(--club-columns),minmax(0,1fr));
    gap:var(--ke-clubs-list-gap);
    min-width:0;
  }
  .club-empty { text-align:center; }
  .club-empty .secondary-button { margin-top:var(--ke-clubs-empty-action-margin-top); }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  @media (max-width: 760px) {
    .club-page { gap:var(--ke-clubs-page-gap-compact); }
    .club-mobile-shelf {
      position:sticky;
      z-index:var(--ke-clubs-mobile-shelf-layer);
      top:var(--ke-clubs-mobile-shelf-top);
      min-height:var(--ke-clubs-mobile-shelf-min-height);
      margin:var(--ke-clubs-mobile-shelf-margin);
      padding:var(--ke-clubs-mobile-shelf-padding-block) var(--ke-clubs-mobile-shelf-padding-inline);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:var(--ke-clubs-mobile-shelf-gap);
      border-block:var(--ke-clubs-mobile-shelf-border) solid var(--ke-color-clubs-mobile-shelf-border);
      background:var(--ke-color-clubs-mobile-shelf-surface);
      color:var(--ke-color-clubs-mobile-shelf-text);
      box-shadow:var(--ke-elevation-clubs-mobile-shelf);
      backdrop-filter:blur(var(--ke-clubs-mobile-shelf-blur));
    }
    .club-mobile-shelf strong {
      min-width:0;
      overflow:hidden;
      font-size:var(--ke-clubs-mobile-title-size);
      font-weight:var(--ke-clubs-mobile-title-weight);
      letter-spacing:var(--ke-clubs-mobile-title-letter);
      line-height:var(--ke-clubs-mobile-title-line);
      text-overflow:ellipsis;
      white-space:nowrap;
    }
    .club-mobile-shelf span {
      flex:none;
      color:var(--ke-color-clubs-mobile-shelf-meta);
      font-size:var(--ke-clubs-mobile-meta-size);
      font-weight:var(--ke-clubs-mobile-meta-weight);
      white-space:nowrap;
    }
    .club-intro .section-card__inner {
      justify-items:start;
      padding:var(--ke-clubs-mobile-intro-padding-block) var(--ke-clubs-mobile-intro-padding-inline);
      text-align:left;
    }
    .club-intro h1 {
      max-width:var(--ke-clubs-mobile-heading-max);
      font-size:var(--ke-clubs-mobile-heading-size);
    }
    .club-intro .lead { font-size:var(--ke-clubs-mobile-lead-size); }
    .club-list { grid-template-columns:1fr; }
  }
</style>
