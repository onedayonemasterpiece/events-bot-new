    .ex-page * { scroll-behavior:auto!important; transition:none!important; animation:none!important; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-exhibitions-prototype]');
    if (!(root instanceof HTMLElement)) return;
    const STATE_KEY = 'ke_exhibitions_prototype_v1';
    const rows = () => Array.from(root.querySelectorAll('[data-exhibition-row]'));
    const focusLinks = () => rows().filter((row) => !row.classList.contains('is-filtered') && !row.classList.contains('is-rejected') && !row.closest('[hidden]')).map((row) => row.querySelector('[data-row-focus]')).filter((node) => node instanceof HTMLElement);
    const live = root.querySelector('[data-live]');
    const badge = root.querySelector('[data-exhibition-badge]');
    const badgeCount = root.querySelector('[data-badge-count]');
    const personalNote = root.querySelector('[data-personal-note]');
    const visibleCount = root.querySelector('[data-visible-count]');
    const empty = root.querySelector('[data-empty]');
    let liveTimer;
    let mode = 'personal';
    let category = 'Все темы';

    const emptyState = () => ({ likes: [], negative: [], likedTags: [], seenNew: [], siteVisits: 0, hasVisitedExhibitions: false });
    const readState = () => {
      try {
        const value = JSON.parse(localStorage.getItem(STATE_KEY) || 'null');
        return { ...emptyState(), ...(value && typeof value === 'object' ? value : {}) };
      } catch { return emptyState(); }
    };
    let state = readState();
    const writeState = () => { try { localStorage.setItem(STATE_KEY, JSON.stringify(state)); } catch {} };
    writeState();

    const announce = (message) => {
      if (!(live instanceof HTMLElement)) return;
      window.clearTimeout(liveTimer);
      live.textContent = '';
      window.setTimeout(() => { live.textContent = message; }, 20);
      liveTimer = window.setTimeout(() => { live.textContent = ''; }, 3200);
    };
    const tagsFor = (row) => String(row.dataset.tags || '').split(',').filter(Boolean);
    const hasProfile = () => Array.isArray(state.likedTags) && state.likedTags.length > 0;
    const matchesProfile = (row) => tagsFor(row).some((tag) => state.likedTags.includes(tag)) || state.likes.includes(row.dataset.eventId);
    const unseenRelevantNewRows = () => rows().filter((row) => row.dataset.new === 'true' && !state.seenNew.includes(row.dataset.eventId) && !state.negative.includes(row.dataset.eventId) && (!hasProfile() || matchesProfile(row)));

    const updateBadge = () => {
      if (!(badge instanceof HTMLElement) || !(badgeCount instanceof HTMLElement)) return;
      const count = unseenRelevantNewRows().length;
      badge.classList.remove('is-soft');
      if (count > 0) {
        badge.hidden = false;
        badgeCount.textContent = `${count} ${count === 1 ? 'новая' : 'новых'}`;
      } else if (!state.hasVisitedExhibitions && Number(state.siteVisits || 0) >= 5) {
        badge.hidden = false;
        badge.classList.add('is-soft');
        badgeCount.textContent = 'загляните';
      } else badge.hidden = true;
    };
    const markSeen = (row) => {
      if (!(row instanceof HTMLElement) || row.dataset.new !== 'true') return;
      const id = row.dataset.eventId;
      if (!state.seenNew.includes(id)) state.seenNew.push(id);
      state.hasVisitedExhibitions = true;
      writeState();
      updateBadge();
    };
    const syncActionState = () => {
      rows().forEach((row) => {
        const id = row.dataset.eventId;
        const liked = state.likes.includes(id);
        const rejected = state.negative.includes(id);
        const like = row.querySelector('[data-like]');
        const reject = row.querySelector('[data-reject]');
        const stub = row.querySelector('[data-hidden-stub]');
        if (like instanceof HTMLElement) like.setAttribute('aria-pressed', String(liked));
        if (reject instanceof HTMLElement) reject.setAttribute('aria-pressed', String(rejected));
        row.classList.toggle('is-rejected', rejected);
        if (stub instanceof HTMLElement) stub.hidden = !rejected;
      });
    };
    const syncFilters = () => {
      let count = 0;
      rows().forEach((row) => {
        const rejected = state.negative.includes(row.dataset.eventId);
        const categoryMatches = category === 'Все темы' || row.dataset.category === category;
        const personalMatches = mode === 'all' || !hasProfile() || matchesProfile(row);
        const visible = categoryMatches && personalMatches && !(mode === 'personal' && rejected);
        row.classList.toggle('is-filtered', !visible);
        if (visible) count += 1;
      });
      if (visibleCount instanceof HTMLElement) visibleCount.textContent = String(count);
      if (empty instanceof HTMLElement) empty.hidden = count > 0;
      if (personalNote instanceof HTMLElement) {
        personalNote.innerHTML = hasProfile()
          ? `<strong>Подборка уточнена.</strong> Учитываем темы ваших ${state.likes.length} отметок; отклонённые выставки не показываем.`
          : '<strong>Начните с 2–3 оценок.</strong> Пока профиль пуст, «Для меня» показывает новое и общее главное.';
      }
      const links = focusLinks();
      links.forEach((link, index) => { link.tabIndex = index === 0 ? 0 : -1; });
      updateBadge();
    };
    const switchMode = (nextMode, focus = false) => {
      mode = nextMode === 'all' ? 'all' : 'personal';
      root.querySelectorAll('[data-mode]').forEach((button) => {
        const active = button.dataset.mode === mode;
        button.setAttribute('aria-checked', String(active));
        button.tabIndex = active ? 0 : -1;
        if (active && focus) button.focus();
      });
      syncFilters();
      announce(mode === 'personal' ? 'Показана подборка «Для меня».' : 'Показаны все выставки.');
    };

    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const modeButton = target.closest('[data-mode]');
      if (modeButton instanceof HTMLElement) { switchMode(modeButton.dataset.mode); return; }
      const categoryButton = target.closest('[data-category-filter]');
      if (categoryButton instanceof HTMLElement) {
        category = categoryButton.dataset.categoryFilter || 'Все темы';
        root.querySelectorAll('[data-category-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button === categoryButton)));
        syncFilters();
        announce(`Фильтр: ${category}.`);
        return;
      }
      const help = target.closest('[data-help-toggle]');
      if (help instanceof HTMLElement) {
        const panel = root.querySelector('[data-keyboard-help]');
        if (panel instanceof HTMLElement) {
          panel.hidden = !panel.hidden;
          help.setAttribute('aria-expanded', String(!panel.hidden));
        }
        return;
      }
      const tailToggle = target.closest('[data-tail-toggle]');
      if (tailToggle instanceof HTMLElement) {
        const panel = root.querySelector('[data-list-section="tail"]');
        if (panel instanceof HTMLElement) {
          panel.hidden = !panel.hidden;
          tailToggle.setAttribute('aria-expanded', String(!panel.hidden));
          tailToggle.textContent = panel.hidden ? `Показать ещё ${panel.querySelectorAll('[data-exhibition-row]').length}` : 'Свернуть долгие выставки';
          if (!panel.hidden) syncFilters();
        }
        return;
      }
      if (target.closest('[data-empty-all]')) { switchMode('all'); return; }
      if (target.closest('[data-mark-new-seen]')) {
        rows().filter((row) => row.dataset.new === 'true').forEach(markSeen);
        announce('Новинки отмечены просмотренными. Красный счётчик очищен.');
        return;
      }
      const row = target.closest('[data-exhibition-row]');
      if (!(row instanceof HTMLElement)) return;
      if (target.closest('[data-like]')) { toggleLike(row); return; }
      if (target.closest('[data-reject]')) { rejectRow(row); return; }
      if (target.closest('[data-undo]')) { undoReject(row); return; }
      if (target.closest('[data-gallery-open]')) { openGallery(target.closest('[data-gallery-open]'), row); return; }
      if (target.closest('[data-row-focus]')) markSeen(row);
    });

    const toggleLike = (row) => {
      const id = row.dataset.eventId;
      const liked = state.likes.includes(id);
      state.likes = liked ? state.likes.filter((value) => value !== id) : [...state.likes, id];
      if (!liked) {
        state.negative = state.negative.filter((value) => value !== id);
        state.likedTags = [...new Set([...state.likedTags, ...tagsFor(row)])];
      } else {
        state.likedTags = [...new Set(rows().filter((candidate) => state.likes.includes(candidate.dataset.eventId)).flatMap(tagsFor))];
      }
      markSeen(row); writeState(); syncActionState(); syncFilters();
      announce(liked ? 'Лайк убран. Подборка обновлена.' : 'Нравится. Темы выставки добавлены в ваши интересы.');
    };
    const rejectRow = (row) => {
      const id = row.dataset.eventId;
      if (!state.negative.includes(id)) state.negative.push(id);
      state.likes = state.likes.filter((value) => value !== id);
      markSeen(row); writeState(); syncActionState();
      const undo = row.querySelector('[data-undo]');
      if (undo instanceof HTMLElement) undo.focus();
      announce('Выставка скрыта из «Для меня». Можно отменить.');
    };
    const undoReject = (row) => {
      const id = row.dataset.eventId;
      state.negative = state.negative.filter((value) => value !== id);
      writeState(); syncActionState(); syncFilters();
      const link = row.querySelector('[data-row-focus]');
      if (link instanceof HTMLElement) link.focus();
      announce('Отметка «не интересно» отменена.');
    };

    const modeSwitch = root.querySelector('[data-mode-switch]');
    modeSwitch?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'ArrowLeft' || event.key === 'Home' ? 'personal' : 'all';
      switchMode(next, true);
    });
    root.querySelector('[data-results]')?.addEventListener('keydown', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target || target.closest('button,input,textarea,select,[contenteditable="true"]')) return;
      const row = target.closest('[data-exhibition-row]');
      if (!(row instanceof HTMLElement)) return;
      const links = focusLinks();
      const current = row.querySelector('[data-row-focus]');
      const index = links.indexOf(current);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const next = links[Math.max(0,Math.min(links.length-1,index+(event.key === 'ArrowDown' ? 1 : -1)))];
        links.forEach((link) => { link.tabIndex = -1; });
        if (next instanceof HTMLElement) next.tabIndex = 0;
        next?.focus({ preventScroll:true }); next?.scrollIntoView({ block:'center', behavior:'smooth' });
      } else if (event.key.toLowerCase() === 'l') { event.preventDefault(); toggleLike(row); }
      else if (event.key.toLowerCase() === 'x') { event.preventDefault(); rejectRow(row); }
      else if (event.key.toLowerCase() === 'g') {
        event.preventDefault(); const opener = row.querySelector('[data-gallery-open]'); if (opener instanceof HTMLElement) openGallery(opener,row);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest('input,textarea,select,button,[contenteditable="true"]')) return;
      if (event.key.toLowerCase() === 'f') { event.preventDefault(); switchMode('personal',true); }
      if (event.key.toLowerCase() === 'a') { event.preventDefault(); switchMode('all',true); }
    });

    const dialog = root.querySelector('[data-gallery]');
    const galleryImage = root.querySelector('[data-gallery-image]');
    const galleryTitle = root.querySelector('[data-gallery-title]');
    const galleryCount = root.querySelector('[data-gallery-count]');
    let galleryImages = []; let galleryIndex = 0; let galleryOpener = null;
    const renderGallery = () => {
      if (!(galleryImage instanceof HTMLImageElement)) return;
      galleryImage.src = galleryImages[galleryIndex] || '';
      galleryImage.alt = galleryTitle instanceof HTMLElement ? `${galleryTitle.textContent}, фото ${galleryIndex+1}` : `Фото ${galleryIndex+1}`;
      if (galleryCount instanceof HTMLElement) galleryCount.textContent = `${galleryIndex+1} из ${galleryImages.length}`;
    };
    const openGallery = (opener,row) => {
      if (!(dialog instanceof HTMLDialogElement) || !(opener instanceof HTMLElement)) return;
      try { galleryImages = JSON.parse(opener.dataset.galleryImages || '[]'); } catch { galleryImages = []; }
      if (!galleryImages.length) return;
      galleryIndex = 0; galleryOpener = opener;
      if (galleryTitle instanceof HTMLElement) galleryTitle.textContent = opener.dataset.galleryTitle || '';
      renderGallery(); dialog.showModal(); markSeen(row);
      root.querySelector('[data-gallery-close]')?.focus();
    };
    const closeGallery = () => { if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close(); };
    root.querySelector('[data-gallery-close]')?.addEventListener('click',closeGallery);
    root.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>{ galleryIndex=(galleryIndex-1+galleryImages.length)%galleryImages.length; renderGallery(); });
    root.querySelector('[data-gallery-next]')?.addEventListener('click',()=>{ galleryIndex=(galleryIndex+1)%galleryImages.length; renderGallery(); });
    dialog?.addEventListener('close',()=>{ if (galleryOpener instanceof HTMLElement) galleryOpener.focus(); });
    dialog?.addEventListener('keydown',(event)=>{
      if (event.key === 'ArrowLeft') { event.preventDefault(); galleryIndex=(galleryIndex-1+galleryImages.length)%galleryImages.length; renderGallery(); }
      if (event.key === 'ArrowRight') { event.preventDefault(); galleryIndex=(galleryIndex+1)%galleryImages.length; renderGallery(); }
      if (event.key === 'Escape') { event.preventDefault(); closeGallery(); }
    });
    dialog?.addEventListener('click',(event)=>{ if (event.target === dialog) closeGallery(); });

    syncActionState(); syncFilters();
  })();
</script>
