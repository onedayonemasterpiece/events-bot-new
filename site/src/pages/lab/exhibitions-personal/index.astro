  .ex-gallery__bar button { min-height:44px; padding:.5rem .75rem; border:1px solid #52585d; border-radius:4px; background:#17191b; color:var(--ex-text); font:inherit; cursor:pointer; }
  .ex-gallery__stage { min-height:min(72dvh,760px); display:grid; grid-template-columns:60px 1fr 60px; align-items:stretch; background:#070809; }
