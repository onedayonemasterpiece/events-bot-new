  .ex-gallery__count { margin:0; padding:.7rem; color:var(--ex-muted); text-align:center; }
  .ex-live { position:fixed; left:50%; bottom:1rem; z-index:80; transform:translateX(-50%); min-width:min(420px,calc(100% - 2rem)); margin:0; padding:.7rem 1rem; border:1px solid #4d5358; border-radius:6px; background:#191c1e; color:var(--ex-text); text-align:center; box-shadow:0 12px 34px rgba(0,0,0,.45); opacity:0; pointer-events:none; transition:opacity 160ms ease; }
