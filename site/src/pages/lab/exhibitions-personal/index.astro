---
import EventLayout from '../../../layouts/EventLayout.astro';
import ExhibitionPrototypeRow from '../../../components/ExhibitionPrototypeRow.astro';
import { absoluteUrl, getEvents, SITE_NAME } from '../../../lib/events';

const canonicalUrl = absoluteUrl('/lab/exhibitions-personal/');
const title = `Прототип персональной страницы выставок | ${SITE_NAME}`;
const description = 'Отдельный noindex-прототип: новые, персональные, популярные и завершающиеся выставки в компактном timeline-интерфейсе.';

const specs = [
  { id: 6902, bucket: 'new', lifecycle: 'recent', dateLabel: '18 июля', status: 'Открылась вчера', category: 'Искусство', tags: ['живопись', 'современное искусство'], reasons: ['Недавно открылась', 'Рядом со Светлогорском'], discussions: 12, mentions: 4 },
  { id: 6894, bucket: 'new', lifecycle: 'recent', dateLabel: '15 июля', status: 'Открылась недавно', category: 'Искусство', tags: ['живопись', 'локальные авторы'], reasons: ['Открылась 4 дня назад', 'Новая в каталоге'], discussions: 18, mentions: 7 },
  { id: 6871, bucket: 'new', lifecycle: 'upcoming', dateLabel: '8 августа', status: 'Откроется скоро', category: 'Фотография', tags: ['фотография', 'город', 'под открытым небом'], reasons: ['Недавно анонсирована', 'Только два дня'], discussions: 26, mentions: 11 },
  { id: 5370, bucket: 'priority', lifecycle: 'popular', dateLabel: 'до 28 марта', status: 'Идёт сейчас', category: 'Искусство', tags: ['современное искусство', 'графика', 'Третьяковка'], reasons: ['373 отметки', 'Часто обсуждают'], discussions: 84, mentions: 31 },
  { id: 6222, bucket: 'priority', lifecycle: 'ending', dateLabel: 'до 19 июля', status: 'Последний день', category: 'История', tags: ['история', 'путешествия', 'музей'], reasons: ['Заканчивается сегодня', 'Успеть посмотреть'], discussions: 9, mentions: 5 },
  { id: 5459, bucket: 'priority', lifecycle: 'popular', dateLabel: 'до 30 августа', status: 'Идёт сейчас', category: 'Искусство', tags: ['живопись', 'натюрморт', 'XX век'], reasons: ['157 отметок', 'Популярно в источниках'], discussions: 47, mentions: 22 },
  { id: 6560, bucket: 'priority', lifecycle: 'recent', dateLabel: '5—31 июля', status: 'Открылась недавно', category: 'Искусство', tags: ['локальные авторы', 'иллюстрация', 'истории'], reasons: ['Открылась две недели назад', '79 отметок'], discussions: 32, mentions: 14 },
  { id: 4913, bucket: 'priority', lifecycle: 'ending', dateLabel: 'до 31 июля', status: 'Скоро закроется', category: 'История', tags: ['археология', 'история', 'Пруссия'], reasons: ['Осталось 12 дней', '58 отметок'], discussions: 21, mentions: 9 },
  { id: 3216, bucket: 'priority', lifecycle: 'popular', dateLabel: 'до 27 сентября', status: 'Идёт сейчас', category: 'Искусство', tags: ['живопись', 'классика', 'Третьяковка'], reasons: ['244 отметки', 'Высокий интерес'], discussions: 63, mentions: 28 },
  { id: 698, bucket: 'tail', lifecycle: 'long', dateLabel: 'до 30 сентября', status: 'Идёт давно', category: 'История', tags: ['археология', 'краеведение', 'музей'], reasons: ['Долгий формат'], discussions: 15, mentions: 8 },
  { id: 2601, bucket: 'tail', lifecycle: 'long', dateLabel: 'до 31 декабря', status: 'Идёт давно', category: 'История', tags: ['история', 'военная история'], reasons: ['Долгий формат'], discussions: 4, mentions: 2 },
  { id: 2182, bucket: 'tail', lifecycle: 'long', dateLabel: 'до 31 декабря', status: 'Идёт давно', category: 'Искусство', tags: ['живопись', 'природа', 'краеведение'], reasons: ['Долгий формат'], discussions: 3, mentions: 2 },
] as const;

const ids = specs.map((spec) => spec.id);
if (new Set(ids).size !== ids.length) throw new Error('Exhibitions prototype contains duplicate event ids');
const eventsById = new Map(getEvents().map((event) => [event.id, event]));
const items = specs.map((spec) => {
  const event = eventsById.get(spec.id);
  if (!event) throw new Error(`Exhibitions prototype fixture is missing event ${spec.id}`);
  if (String(event.event_type || '').toLocaleLowerCase('ru') !== 'выставка') {
    throw new Error(`Exhibitions prototype fixture ${spec.id} is not an exhibition`);
  }
  return { ...spec, event };
});
const newItems = items.filter((item) => item.bucket === 'new');
const priorityItems = items.filter((item) => item.bucket === 'priority');
const tailItems = items.filter((item) => item.bucket === 'tail');
---

<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="ex-page" data-exhibitions-prototype>
    <a class="ex-skip" href="#exhibition-results">К списку выставок</a>

    <header class="ex-header">
      <a class="ex-brand" href="#top" aria-label="KenigEvents — начало прототипа">
        <span>Полюбить Калининград</span>
        <strong>Анонсы</strong>
      </a>
      <nav class="ex-header__nav" aria-label="Разделы афиши">
        <a href="#">Сегодня</a>
        <a href="#">Завтра</a>
        <a href="#">Выходные</a>
        <a class="is-current" href="#exhibition-results" aria-current="page">
          Выставки
          <span class="ex-nav-badge" data-exhibition-badge aria-live="polite"><span data-badge-count>3 новых</span></span>
        </a>
        <a href="#">Популярное</a>
      </nav>
      <button type="button" class="ex-help-open" data-help-toggle aria-expanded="false" aria-controls="keyboard-help">
        <span>Клавиши</span><kbd>?</kbd>
      </button>
    </header>

    <div class="ex-shell" id="top">
      <section class="ex-intro" aria-labelledby="exhibition-heading">
        <div>
          <p class="ex-kicker">Калининградская область · прототип</p>
          <h1 id="exhibition-heading">Выставки</h1>
          <p class="ex-lead">Сначала — новое, недавно открывшееся и важное. Старые долгие выставки не мешают быстрому выбору.</p>
        </div>
        <div class="ex-intro__summary" aria-label="Сводка раздела">
          <span><strong data-visible-count>{items.length}</strong> выставок</span>
          <span><strong>{newItems.length}</strong> новых</span>
          <span><strong>2</strong> скоро закроются</span>
        </div>
      </section>

      <section class="ex-controls" aria-label="Настройка списка">
        <div class="ex-mode" role="radiogroup" aria-label="Режим подборки" data-mode-switch>
          <button type="button" role="radio" aria-checked="true" data-mode="personal" tabindex="0">Для меня <kbd aria-hidden="true">F</kbd></button>
          <button type="button" role="radio" aria-checked="false" data-mode="all" tabindex="-1">Все <kbd aria-hidden="true">A</kbd></button>
        </div>
        <p class="ex-personal-note" data-personal-note><strong>Начните с 2–3 оценок.</strong> Пока профиль пуст, «Для меня» показывает новое и общее главное.</p>
        <div class="ex-categories" aria-label="Фильтры по теме">
          {['Все темы', 'Искусство', 'История', 'Фотография'].map((category, index) => (
            <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-category-filter={category}>{category}</button>
          ))}
        </div>
      </section>

      <aside class="ex-keyboard-help" id="keyboard-help" data-keyboard-help hidden aria-labelledby="keyboard-help-title">
        <div>
          <p class="ex-kicker">Навигация без мышки</p>
          <h2 id="keyboard-help-title">Быстро просмотрите список</h2>
        </div>
        <ul>
          <li><kbd>↑</kbd><kbd>↓</kbd><span>между выставками</span></li>
          <li><kbd>Enter</kbd><span>открыть выставку</span></li>
          <li><kbd>G</kbd><span>открыть фото</span></li>
          <li><kbd>L</kbd><span>нравится</span></li>
          <li><kbd>X</kbd><span>не интересно</span></li>
          <li><kbd>F</kbd><kbd>A</kbd><span>«Для меня» / «Все»</span></li>
        </ul>
      </aside>

      <section id="exhibition-results" class="ex-results" aria-label="Выставки" data-results tabindex="-1">
        <section class="ex-group ex-group--new" aria-labelledby="new-heading" data-new-group>
          <div class="ex-group__heading">
            <div>
              <p class="ex-group__eyebrow">Быстрый разбор</p>
              <h2 id="new-heading">Новое для вас</h2>
              <p>Поставьте лайк, отметьте «не интересно» или откройте — и новинка уйдёт из красного счётчика.</p>
            </div>
            <button type="button" class="ex-mark-seen" data-mark-new-seen>Отметить просмотренными</button>
          </div>
          <div class="ex-list" data-list-section="new">
            {newItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={index} />)}
          </div>
        </section>

        <section class="ex-group" aria-labelledby="priority-heading">
          <div class="ex-group__heading">
            <div>
              <p class="ex-group__eyebrow">После нового</p>
              <h2 id="priority-heading">Стоит увидеть</h2>
              <p>Смешиваем общий интерес, обсуждения, недавнее открытие и честную срочность закрытия.</p>
            </div>
            <div class="ex-legend" aria-label="Обозначения статусов">
              <span class="is-recent"><i aria-hidden="true"></i> недавно открылась</span>
              <span class="is-ending"><i aria-hidden="true"></i> скоро закроется</span>
              <span class="is-popular"><i aria-hidden="true"></i> популярное</span>
            </div>
          </div>
          <div class="ex-list" data-list-section="priority">
            {priorityItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={newItems.length + index} />)}
          </div>
        </section>

        <section class="ex-group ex-group--tail" aria-labelledby="tail-heading">
          <div class="ex-tail-callout">
            <div>
              <p class="ex-group__eyebrow">Длинный хвост</p>
              <h2 id="tail-heading">Давно идут</h2>
              <p>Эти выставки всё ещё актуальны, но не поднимаются выше только из-за долгой даты.</p>
            </div>
            <button type="button" class="ex-tail-toggle" data-tail-toggle aria-expanded="false" aria-controls="old-exhibitions">Показать ещё {tailItems.length}</button>
          </div>
          <div id="old-exhibitions" class="ex-list" data-list-section="tail" hidden>
            {tailItems.map((item, index) => <ExhibitionPrototypeRow item={item as any} rowIndex={newItems.length + priorityItems.length + index} />)}
          </div>
        </section>

        <div class="ex-empty" data-empty hidden>
          <h2>Здесь пока пусто</h2>
          <p>Выберите «Все» или верните одну из скрытых выставок. Новые оценки сразу уточняют подборку в этом браузере.</p>
          <button type="button" data-empty-all>Показать все</button>
        </div>
      </section>
    </div>

    <dialog class="ex-gallery" data-gallery aria-labelledby="gallery-title">
      <div class="ex-gallery__bar">
        <div><p>Фотографии выставки</p><h2 id="gallery-title" data-gallery-title></h2></div>
        <button type="button" data-gallery-close aria-label="Закрыть галерею">Закрыть <kbd aria-hidden="true">Esc</kbd></button>
      </div>
      <div class="ex-gallery__stage">
        <button type="button" data-gallery-prev aria-label="Предыдущее фото"><span aria-hidden="true">←</span></button>
        <img data-gallery-image src="" alt="" width="1280" height="900" />
        <button type="button" data-gallery-next aria-label="Следующее фото"><span aria-hidden="true">→</span></button>
      </div>
      <p class="ex-gallery__count" data-gallery-count aria-live="polite"></p>
    </dialog>
    <p class="ex-live" data-live role="status" aria-live="polite" aria-atomic="true"></p>
  </main>
</EventLayout>

<style is:global>
  :root {
    --ex-bg:#0d0f10; --ex-surface:#101214; --ex-raised:#17191c; --ex-border:#2d3134;
    --ex-text:#f4f4f2; --ex-muted:#a8adb2; --ex-blue:#54acf7; --ex-orange:#f18224;
    --ex-red:#ef4b58; --ex-gray:#9da2a6; --ex-yellow:#efc12b; --ex-purple:#a97bf4; --ex-green:#92cb70;
  }
  body:has(.ex-page) { background:var(--ex-bg); color:var(--ex-text); }
  body:has(.ex-page)::before, body:has(.ex-page)>.site-header, body:has(.ex-page)>.site-footer { display:none; }
  body:has(.ex-page) a:focus-visible, body:has(.ex-page) button:focus-visible { outline:3px solid var(--ex-blue); outline-offset:3px; }
  .ex-page { min-height:100dvh; background:radial-gradient(circle at 52% -16%,rgba(84,172,247,.1),transparent 34rem),var(--ex-bg); color:var(--ex-text); font-size:16px; line-height:1.45; }
  .ex-page button,.ex-page a { touch-action:manipulation; }
  .ex-skip { position:fixed; z-index:100; top:.8rem; left:.8rem; transform:translateY(-160%); padding:.75rem 1rem; border-radius:6px; background:var(--ex-text); color:var(--ex-bg); font-weight:800; }
  .ex-skip:focus { transform:translateY(0); }
  .ex-header { position:sticky; z-index:40; top:0; display:grid; grid-template-columns:220px 1fr auto; align-items:center; min-height:64px; padding:0 clamp(1rem,3vw,3.5rem); border-bottom:1px solid var(--ex-border); background:rgba(13,15,16,.94); backdrop-filter:blur(18px); }
  .ex-brand { display:grid; align-content:center; min-height:64px; padding:0 1rem; background:#98401f; color:#fff; text-decoration:none; line-height:1.05; }
  .ex-brand span { font-size:.72rem; font-weight:700; opacity:.84; }
  .ex-brand strong { font-size:1.18rem; }
  .ex-header__nav { display:flex; align-items:stretch; justify-content:center; min-width:0; height:64px; }
  .ex-header__nav>a { position:relative; display:flex; align-items:center; min-height:44px; padding:0 clamp(.55rem,1.4vw,1rem); color:var(--ex-muted); text-decoration:none; font-size:.91rem; font-weight:720; }
  .ex-header__nav>a:hover,.ex-header__nav>a.is-current { color:var(--ex-text); }
  .ex-header__nav>a.is-current::after { content:""; position:absolute; left:.7rem; right:.7rem; bottom:0; height:2px; background:var(--ex-blue); }
  .ex-nav-badge { display:inline-flex; align-items:center; min-height:22px; margin-left:.45rem; padding:.08rem .45rem; border-radius:999px; background:var(--ex-red); color:white; font-size:.69rem; font-weight:900; white-space:nowrap; }
  .ex-nav-badge.is-soft { background:#4c5155; color:#f4f4f2; }
  .ex-help-open { min-height:44px; display:flex; align-items:center; gap:.55rem; border:1px solid var(--ex-border); border-radius:6px; padding:.45rem .75rem; background:var(--ex-surface); color:var(--ex-text); font:inherit; font-weight:750; cursor:pointer; }
  .ex-page kbd { min-width:1.6rem; min-height:1.5rem; display:inline-flex; align-items:center; justify-content:center; padding:.08rem .32rem; border:1px solid #50555a; border-bottom-color:#777d82; border-radius:4px; background:#202326; color:#e9ecee; font:700 .72rem/1 ui-monospace,SFMono-Regular,Consolas,monospace; box-shadow:0 1px 0 #050607; }
  .ex-shell { width:min(1320px,calc(100% - clamp(2rem,5vw,6rem))); margin:0 auto; padding:clamp(2rem,5vw,4.8rem) 0 6rem; }
  .ex-intro { display:flex; align-items:end; justify-content:space-between; gap:2rem; padding-bottom:2rem; border-bottom:1px solid var(--ex-border); }
  .ex-kicker,.ex-group__eyebrow { margin:0 0 .45rem; color:var(--ex-blue); font-size:.72rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; }
  .ex-intro h1 { margin:0; font-size:clamp(3rem,7vw,6.8rem); line-height:.83; letter-spacing:-.07em; }
  .ex-lead { max-width:58ch; margin:1rem 0 0; color:var(--ex-muted); font-size:clamp(1rem,1.5vw,1.2rem); }
  .ex-intro__summary { flex:0 0 auto; display:grid; grid-template-columns:repeat(3,auto); gap:1px; border:1px solid var(--ex-border); border-radius:6px; overflow:hidden; background:var(--ex-border); }
  .ex-intro__summary span { min-width:118px; display:grid; gap:.12rem; padding:.78rem 1rem; background:var(--ex-surface); color:var(--ex-muted); font-size:.75rem; }
  .ex-intro__summary strong { color:var(--ex-text); font-size:1.24rem; }
  .ex-controls { position:sticky; z-index:30; top:64px; display:grid; grid-template-columns:auto 1fr auto; gap:1rem; align-items:center; min-height:76px; margin-bottom:1rem; padding:.75rem 0; border-bottom:1px solid var(--ex-border); background:rgba(13,15,16,.96); }
  .ex-mode { display:flex; padding:3px; border:1px solid var(--ex-border); border-radius:7px; background:#08090a; }
  .ex-mode button { min-height:44px; display:flex; align-items:center; gap:.5rem; padding:.55rem .9rem; border:0; border-radius:4px; background:transparent; color:var(--ex-muted); font:inherit; font-weight:850; cursor:pointer; }
  .ex-mode button[aria-checked="true"] { background:var(--ex-raised); color:var(--ex-text); box-shadow:inset 0 0 0 1px #3a3f43; }
  .ex-personal-note { margin:0; color:var(--ex-muted); font-size:.82rem; }
  .ex-personal-note strong { color:var(--ex-text); }
  .ex-categories { display:flex; gap:.42rem; overflow-x:auto; scrollbar-width:none; }
  .ex-categories button { min-height:44px; padding:.45rem .75rem; border:1px solid var(--ex-border); border-radius:999px; background:transparent; color:var(--ex-muted); font:inherit; font-size:.82rem; font-weight:750; white-space:nowrap; cursor:pointer; }
  .ex-categories button[aria-pressed="true"] { border-color:#697078; background:#24272a; color:var(--ex-text); }
  .ex-keyboard-help { display:grid; grid-template-columns:minmax(210px,.7fr) 1fr; gap:1rem; margin:1rem 0 2rem; padding:1rem 1.15rem; border:1px solid #3c4247; border-radius:7px; background:linear-gradient(135deg,#15181a,#111315); }
  .ex-keyboard-help h2 { margin:0; font-size:1.1rem; }
  .ex-keyboard-help ul { display:flex; flex-wrap:wrap; gap:.55rem 1rem; align-items:center; margin:0; padding:0; list-style:none; }
  .ex-keyboard-help li { display:flex; align-items:center; gap:.3rem; color:var(--ex-muted); font-size:.78rem; }
  .ex-results { scroll-margin-top:150px; }
  .ex-group { padding:2.25rem 0; border-bottom:1px solid var(--ex-border); }
  .ex-group__heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:1rem; }
  .ex-group__heading h2,.ex-tail-callout h2 { margin:0; font-size:clamp(1.75rem,3vw,2.7rem); line-height:1; }
  .ex-group__heading p:not(.ex-group__eyebrow),.ex-tail-callout p:not(.ex-group__eyebrow) { max-width:68ch; margin:.55rem 0 0; color:var(--ex-muted); font-size:.9rem; }
  .ex-mark-seen,.ex-tail-toggle,.ex-empty button { min-height:44px; padding:.55rem .85rem; border:1px solid #52585d; border-radius:5px; background:var(--ex-raised); color:var(--ex-text); font:inherit; font-weight:800; cursor:pointer; }
  .ex-legend { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:.55rem 1rem; color:var(--ex-muted); font-size:.72rem; }
  .ex-legend span { display:inline-flex; align-items:center; gap:.38rem; }
  .ex-legend i { width:9px; height:9px; border-radius:50%; background:var(--ex-blue); box-shadow:0 0 10px currentColor; }
  .ex-legend .is-recent i { background:var(--ex-orange); color:var(--ex-orange); }
  .ex-legend .is-ending i { background:var(--ex-red); color:var(--ex-red); }
  .ex-legend .is-popular i { background:var(--ex-yellow); color:var(--ex-yellow); }
  .ex-list { position:relative; display:grid; gap:7px; padding-left:22px; }
  .ex-list::before { content:""; position:absolute; top:0; bottom:0; left:7px; width:1px; background:linear-gradient(var(--ex-border),#454a4e,var(--ex-border)); }
  .ex-row { position:relative; min-height:112px; display:grid; grid-template-columns:112px minmax(350px,42%) minmax(250px,1fr) auto; gap:clamp(.75rem,1.5vw,1.25rem); align-items:stretch; padding:.5rem .6rem .5rem 0; border:1px solid #25292c; border-radius:6px; background:linear-gradient(90deg,#111315,#0f1112); transition:border-color 180ms ease,background-color 180ms ease; }
  .ex-row:hover,.ex-row:focus-within { z-index:2; border-color:#4b5156; background:linear-gradient(90deg,#171a1c,#121415); }
  .ex-row::before { content:""; position:absolute; left:-20px; top:50%; width:11px; height:11px; transform:translateY(-50%); border:2px solid #0d0f10; border-radius:50%; background:var(--ex-blue); box-shadow:0 0 0 1px var(--ex-blue),0 0 12px color-mix(in srgb,var(--ex-blue),transparent 20%); }
  .ex-row--recent::before { background:var(--ex-orange); box-shadow:0 0 0 1px var(--ex-orange),0 0 12px rgba(241,130,36,.8); }
  .ex-row--ending::before { background:var(--ex-red); box-shadow:0 0 0 1px var(--ex-red),0 0 12px rgba(239,75,88,.75); }
  .ex-row--upcoming::before,.ex-row--long::before { background:var(--ex-gray); box-shadow:0 0 0 1px var(--ex-gray); }
  .ex-row--popular::before { background:var(--ex-yellow); box-shadow:0 0 0 1px var(--ex-yellow),0 0 12px rgba(239,193,43,.7); }
  .ex-row__rail { display:grid; align-content:center; gap:.18rem; padding-left:.65rem; color:var(--ex-muted); font-size:.7rem; font-variant-numeric:tabular-nums; }
  .ex-row__rail strong { color:var(--ex-text); font-size:.78rem; }
  .ex-row__dot { display:none; }
  .ex-deck { position:relative; min-height:94px; overflow:hidden; padding:0 3.2rem 0 0; border:0; border-radius:4px; background:#090a0b; cursor:pointer; }
  .ex-deck__images { position:absolute; inset:0 2.6rem 0 0; display:block; }
