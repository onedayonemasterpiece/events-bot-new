    .ex-header__nav { position:fixed; z-index:45; left:0; right:0; bottom:0; height:auto; min-height:58px; justify-content:center; padding:0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); border-top:1px solid var(--ex-border); background:rgba(13,15,16,.97); }
    .ex-header__nav>a:not(.is-current) { display:flex; }
    .ex-header__nav>a { flex:1 1 20%; justify-content:center; min-width:0; padding:.45rem .12rem; font-size:.64rem; text-align:center; }
