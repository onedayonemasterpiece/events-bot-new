    .ex-help-open span { position:absolute; width:1px; height:1px; overflow:hidden; }
    .ex-shell { width:min(100% - 1.25rem,680px); padding-top:2.3rem; padding-bottom:8rem; }
    .ex-intro h1 { font-size:clamp(3.4rem,19vw,5.2rem); }
    .ex-intro__summary { width:100%; grid-template-columns:repeat(3,1fr); }
