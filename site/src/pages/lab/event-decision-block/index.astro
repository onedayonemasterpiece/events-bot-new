---
import EventLayout from '../../../layouts/EventLayout.astro';
import Icon from '../../../components/Icon.astro';
import MedallionStrip from '../../../components/lab/DecisionMedallionStrip.astro';
import { absoluteUrl, SITE_NAME, withBase } from '../../../lib/events';

const canonicalUrl = absoluteUrl('/lab/event-decision-block/');
const title = `A/B лаборатория decision-блока события | ${SITE_NAME}`;
const description = 'Mobile-first варианты пространства под утверждённой hero-картинкой события: сильная дата, обязательные CTA, крупные медальоны и overlap-sheet без потери baseline.';
const baselineCommit = 'f8aa6bd44e6e2bc475b868f1187bde707cb6fd2d';
const currentBranch = 'feature/event-issue-report-artkodex-20260703';
const previewLinks = [
  { label: 'Сохранённый блок даты', href: withBase('/lab/date-block/') },
  { label: 'Медальоны', href: withBase('/lab/medallions/') },
  { label: 'Hero review', href: withBase('/lab/hero/review/') },
];
const sample = {
  title: 'Органный вечер при свечах',
  type: 'концерт',
  summary: 'Музыка Баха и барочная программа в соборе. Первый экран должен мгновенно ответить: когда, где, что нажать и почему событию можно доверять.',
  day: '05',
  month: 'июля',
  weekday: 'суббота',
  weekdayShort: 'сб',
  time: '19:00',
  duration: '2 часа',
  venue: 'Кафедральный собор',
  city: 'Калининград',
  admission: 'по билетам',
  primaryCta: 'Купить билет',
  datetime: '2026-07-05T19:00:00+02:00',
};
const medallions = [
  { label: 'Бахослужение', short: 'BACH', image: '/assets/festivals/bahosluzhenie.png', tone: 'gold' },
  { label: 'Пушкинская карта', short: 'ПК', image: '/assets/badges/pushkin-card-medallion.webp', tone: 'green' },
  { label: 'Остров Канта', short: 'OK', image: '/assets/organizers/kant-island.webp', tone: 'blue' },
  { label: 'Источник проверен', short: 'SRC', image: '', tone: 'neutral' },
];
const criteria = [
  ['Hero contract', 'Сначала parallax/hero image, затем единый overlapping decision-sheet; H1 только внутри sheet, не поверх изображения.'],
  ['Date strength', 'Дата, время и день недели должны считываться первым сканированием на 390px и оставаться крупными на 320px.'],
  ['Mandatory actions', 'Купить/основной CTA, календарь, поделиться и лайк остаются на первом экране с утверждёнными иконками.'],
  ['Medallion size', 'Медальоны не превращаем в chips: крупный визуальный ряд, быстро читаемый; 4+ — горизонтальный shelf с peek.'],
  ['Zero-medallion state', 'Если медальонов нет, поверхность просто схлопывается или заменяется fact-strip без ощущения недогруза.'],
];
const supersededMarkers = [
  'decision-variant-p03',
  'decision-variant-p01',
  'decision-variant-p04',
  'decision-variant-baseline',
  'decision-variant-p03-zero-medallions',
  'decision-variant-utility-stack',
];
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="decision-lab decision-lab-v2" data-event-decision-lab data-decision-v2-overlap-lab>
    <div class="page-shell decision-lab__shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/lab/date-block/')}>Блок даты</a>
        <span aria-hidden="true">/</span>
        <span>Decision-блок</span>
      </nav>

      <section class="section-card decision-lab__intro">
        <div class="section-card__inner decision-lab__intro-inner">
          <p class="eyebrow">A/B review · mobile first · baseline preserved · corrected constraints</p>
          <h1>Decision-блок нужно проектировать внутри утверждённого hero-overlap</h1>
          <p class="lead">Новая итерация не выносит заголовок на картинку и не ломает hero: карточка решения наезжает на parallax image, H1 остаётся внутри sheet, все обязательные действия возвращены, а медальоны остаются крупными самостоятельными визуальными токенами.</p>
          <div class="decision-lab__meta-grid" aria-label="Контекст исследования">
            <div>
              <span>baseline commit</span>
              <code>{baselineCommit}</code>
            </div>
            <div>
              <span>ветка</span>
              <strong>{currentBranch}</strong>
            </div>
            <div>
              <span>главный риск</span>
              <strong>шум даты, CTA и медальонов</strong>
            </div>
          </div>
          <div class="decision-lab__links" aria-label="Связанные лаборатории">
            {previewLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </div>
      </section>

      <section class="section-card decision-lab__principles">
        <div class="section-card__inner">
          <div class="decision-lab__section-head">
            <p class="eyebrow">Как отсматривать</p>
            <h2>Новые hard constraints после ревью</h2>
          </div>
          <div class="decision-lab__criteria-grid">
            {criteria.map(([criterionTitle, text]) => (
              <article>
                <h3>{criterionTitle}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="decision-lab__variants decision-lab__variants--v2" aria-label="Корректные варианты decision-блока события">
        <article class="section-card decision-lab__variant decision-variant-v2-date-card" data-variant="decision-variant-v2-date-card">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">Variant V1 · Gemini/a-opus consensus</p>
              <h2>Date Card Above CTA</h2>
              <p>Самый безопасный production-кандидат: утверждённый overlapping sheet, крупная структурная дата между H1 и CTA, затем обязательные действия и отдельный крупный medallion shelf сразу под sheet.</p>
            </div>

            <div class="decision-v2-phone" data-phone-width="390">
              <div class="decision-v2-hero-visual" aria-label="Hero image mockup">
                <span>parallax hero image</span>
              </div>
              <section class="decision-v2-sheet" aria-label="Decision block with strong date card">
                <p class="decision-v2-eyebrow"><span>{sample.type}</span><strong>{sample.admission}</strong></p>
                <h3>{sample.title}</h3>
                <time class="decision-v2-date-card" datetime={sample.datetime} aria-label={`${sample.weekday}, ${sample.day} ${sample.month}, ${sample.time}`}>
                  <span class="decision-v2-date-card__day">{sample.day}</span>
                  <span class="decision-v2-date-card__month">{sample.month}</span>
                  <span class="decision-v2-date-card__meta"><strong>{sample.weekday}</strong><b>{sample.time}</b></span>
                </time>
                <p class="decision-v2-place"><Icon name="pin" /> {sample.venue} · {sample.city}</p>
                <div class="mandatory-action-row" aria-label="Обязательные действия события">
                  <a class="decision-v2-primary" href="#ab-review"><Icon name="ticket" /> <span>{sample.primaryCta}</span></a>
                  <a class="decision-v2-action" href="#ab-review"><Icon name="calendar" /> <span>Календарь</span></a>
                  <button class="decision-v2-action" type="button"><Icon name="share" /> <span>Поделиться</span></button>
                  <button class="decision-v2-action" type="button"><Icon name="heart" /> <span>Нравится</span></button>
                </div>
              </section>
              <div class="decision-v2-medallion-flow large-medallion-strip" aria-label="Крупные медальоны события">
                <MedallionStrip items={medallions} mode="large" />
              </div>
            </div>

            <div class="decision-lab__variant-notes">
              <p><strong>Лучше для:</strong> production-first сценарий, где нельзя рисковать title/CTA/hero контрактом.</p>
              <p><strong>Риск:</strong> medallion shelf может уйти ниже первого экрана на коротких устройствах, но остаётся визуально крупным и не спорит с CTA.</p>
            </div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v2-medallion-shelf" data-variant="decision-variant-v2-medallion-shelf">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">Variant V2 · identity-first shelf</p>
              <h2>Strong Date + Medallions inside sheet</h2>
              <p>Более брендовый вариант: дата остаётся сильной, медальоны попадают внутрь decision-sheet после локации, но не уменьшаются до pills. CTA остаётся полным mandatory cluster.</p>
            </div>

            <div class="decision-v2-phone decision-v2-phone--shelf" data-phone-width="390">
              <div class="decision-v2-hero-visual decision-v2-hero-visual--warm" aria-label="Hero image mockup">
                <span>parallax hero image</span>
              </div>
              <section class="decision-v2-sheet" aria-label="Decision block with medallions shelf">
                <p class="decision-v2-eyebrow"><span>{sample.type}</span><strong>{sample.admission}</strong></p>
                <time class="decision-v2-date-line" datetime={sample.datetime}>
                  <strong>{sample.day} {sample.month}</strong>
                  <span>{sample.weekday} · {sample.time}</span>
                </time>
                <h3>{sample.title}</h3>
                <p class="decision-v2-place"><Icon name="pin" /> {sample.venue} · {sample.city}</p>
                <div class="decision-v2-medallion-inset large-medallion-strip" aria-label="Крупные медальоны внутри блока">
                  <MedallionStrip items={medallions.slice(0, 3)} mode="large" />
                </div>
                <div class="mandatory-action-row mandatory-action-row--compact" aria-label="Обязательные действия события">
                  <a class="decision-v2-primary" href="#ab-review"><Icon name="ticket" /> <span>{sample.primaryCta}</span></a>
                  <a class="decision-v2-action" href="#ab-review"><Icon name="calendar" /> <span>Календарь</span></a>
                  <button class="decision-v2-action" type="button"><Icon name="share" /> <span>Поделиться</span></button>
                  <button class="decision-v2-action" type="button"><Icon name="heart" /> <span>Нравится</span></button>
                </div>
              </section>
            </div>

            <div class="decision-lab__variant-notes">
              <p><strong>Лучше для:</strong> событий с 1–3 сильными медальонами, где доверительный токен нужно видеть до CTA.</p>
              <p><strong>Риск:</strong> sheet становится выше; для 4+ медальонов нужен horizontal scroll и аккуратный peek.</p>
            </div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v2-attached-medallions" data-variant="decision-variant-v2-attached-medallions">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">Variant V3 · experimental attached shelf</p>
              <h2>Attached Medallions + compact date stripe</h2>
              <p>Эксперимент для событий с медальонной идентичностью: медальоны визуально пристёгнуты к нижней кромке sheet, а дата превращается в широкую, но высококонтрастную stripe над заголовком.</p>
            </div>

            <div class="decision-v2-phone decision-v2-phone--attached" data-phone-width="390">
              <div class="decision-v2-hero-visual decision-v2-hero-visual--dark" aria-label="Hero image mockup">
                <span>parallax hero image</span>
              </div>
              <section class="decision-v2-sheet" aria-label="Decision block with attached medallions">
                <p class="decision-v2-eyebrow"><span>{sample.type}</span><strong>{sample.admission}</strong></p>
                <time class="decision-v2-date-stripe" datetime={sample.datetime}>
                  <strong>{sample.day} {sample.month}</strong>
                  <span>{sample.weekday}</span>
                  <b>{sample.time}</b>
                </time>
                <h3>{sample.title}</h3>
                <p class="decision-v2-place"><Icon name="pin" /> {sample.venue} · {sample.city}</p>
                <div class="mandatory-action-row" aria-label="Обязательные действия события">
                  <a class="decision-v2-primary" href="#ab-review"><Icon name="ticket" /> <span>{sample.primaryCta}</span></a>
                  <a class="decision-v2-action" href="#ab-review"><Icon name="calendar" /> <span>Календарь</span></a>
                  <button class="decision-v2-action" type="button"><Icon name="share" /> <span>Поделиться</span></button>
                  <button class="decision-v2-action" type="button"><Icon name="heart" /> <span>Нравится</span></button>
                </div>
              </section>
              <div class="decision-v2-medallion-attached large-medallion-strip" aria-label="Пристёгнутые крупные медальоны">
                <MedallionStrip items={medallions} mode="large" />
              </div>
            </div>

            <div class="decision-lab__variant-notes">
              <p><strong>Лучше для:</strong> visual QA и отсмотра границы между «медальоны помогают» и «медальоны шумят».</p>
              <p><strong>Риск:</strong> декоративная пристёжка может конкурировать с primary CTA; требует внимательного мобильного просмотра.</p>
            </div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v2-zero-medallions" data-variant="decision-variant-v2-zero-medallions">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">Variant V4 · zero-medallion safety</p>
              <h2>Дата и CTA без медальонов</h2>
              <p>Проверка пустого состояния: нет заглушки «медальонов нет», нет dashed-зоны. Блок просто схлопывается, а место доверительных токенов занимает короткий fact-strip.</p>
            </div>

            <div class="decision-v2-phone decision-v2-phone--zero" data-phone-width="320">
              <div class="decision-v2-hero-visual" aria-label="Hero image mockup">
                <span>parallax hero image</span>
              </div>
              <section class="decision-v2-sheet" aria-label="Decision block without medallions">
                <p class="decision-v2-eyebrow"><span>{sample.type}</span><strong>{sample.admission}</strong></p>
                <h3>{sample.title}</h3>
                <time class="decision-v2-date-card" datetime={sample.datetime} aria-label={`${sample.weekday}, ${sample.day} ${sample.month}, ${sample.time}`}>
                  <span class="decision-v2-date-card__day">{sample.day}</span>
                  <span class="decision-v2-date-card__month">{sample.month}</span>
                  <span class="decision-v2-date-card__meta"><strong>{sample.weekday}</strong><b>{sample.time}</b></span>
                </time>
                <p class="decision-v2-place"><Icon name="pin" /> {sample.venue} · {sample.city}</p>
                <div class="mandatory-action-row" aria-label="Обязательные действия события">
                  <a class="decision-v2-primary" href="#ab-review"><Icon name="ticket" /> <span>{sample.primaryCta}</span></a>
                  <a class="decision-v2-action" href="#ab-review"><Icon name="calendar" /> <span>Календарь</span></a>
                  <button class="decision-v2-action" type="button"><Icon name="share" /> <span>Поделиться</span></button>
                  <button class="decision-v2-action" type="button"><Icon name="heart" /> <span>Нравится</span></button>
                </div>
                <div class="decision-v2-fact-strip" aria-label="Короткие факты события">
                  <span>{sample.duration}</span><span>официальная продажа</span><span>центр города</span>
                </div>
              </section>
            </div>

            <div class="decision-lab__variant-notes">
              <p><strong>Лучше для:</strong> событий без curated медальонов и маленьких источников.</p>
              <p><strong>Риск:</strong> без медальонов sheet становится спокойнее; дата должна не потерять вес относительно CTA.</p>
            </div>
          </div>
        </article>
      </section>

      <section class="section-card decision-lab__consultants">
        <div class="section-card__inner">
          <div class="decision-lab__section-head">
            <p class="eyebrow">Gemini Pro + a-opus critical review</p>
            <h2>Модели теперь голосовали в рамках реальных ограничений hero</h2>
            <p>Оба консультанта запретили ломать overlap-contract: H1 внутри decision-sheet, четыре действия остаются видимыми, медальоны не уменьшаются до chips. Расхождение только в том, насколько близко медальоны поднимать к H1/дате.</p>
          </div>
          <div class="decision-lab__consultant-grid">
            <article>
              <h3>Gemini Pro</h3>
              <p><strong>Кандидаты:</strong> badge/date split → editorial stack → medallion inject.</p>
              <p><strong>Суть:</strong> отдельный крупный medallion shelf после sheet безопаснее для 4+ токенов; primary CTA широкий, вторичные действия — icon row, но не скрыты.</p>
            </article>
            <article>
              <h3>a-opus</h3>
              <p><strong>Кандидаты:</strong> Date Card Above CTA → inline date + medallion shelf → attached shelf.</p>
              <p><strong>Суть:</strong> production-first вариант — V1: дата между H1 и CTA, medallions сразу после sheet; V2/V3 нужны для визуального сравнения.</p>
            </article>
            <article class="decision-lab__hybrid-card">
              <h3>Recommended gate</h3>
              <p><strong>Сначала проверять V1:</strong> если дата считывается быстрее, CTA не теряется, а shelf остаётся достаточно заметным — переносить в EventHero. V2/V3 оставить как A/B debt для медальонных событий.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section-card decision-lab__superseded" aria-label="Старые варианты, сохранённые как регрессионные маркеры">
        <div class="section-card__inner">
          <div class="decision-lab__section-head">
            <p class="eyebrow">Superseded baseline markers</p>
            <h2>Предыдущие A–F варианты не подходят под текущие ограничения</h2>
            <p>Их не используем как production-кандидатов: они выносили заголовок в poster/hero mock, уменьшали медальоны или теряли обязательные действия. Маркеры сохранены только для регрессионной истории и чеков.</p>
          </div>
          <div class="decision-lab__marker-list" aria-label="Старые маркеры">
            {supersededMarkers.map((marker) => <code>{marker}</code>)}
          </div>
        </div>
      </section>

      <section id="ab-review" class="section-card decision-lab__review">
        <div class="section-card__inner">
          <div class="decision-lab__section-head">
            <p class="eyebrow">Consultants + product gate</p>
            <h2>Что теперь проверяем руками и моделями</h2>
          </div>
          <ol>
            <li>На 390px и 320px: можно ли за одно сканирование прочитать дату, день недели и время?</li>
            <li>Все ли обязательные действия видны, кликабельны и не спорят с главным CTA?</li>
            <li>Медальоны остаются крупными и быстро воспринимаемыми или начинают давить на title/CTA?</li>
            <li>Работает ли V1 как production-кандидат без специальных условий и не ломает ли zero-medallion state?</li>
          </ol>
          <p class="decision-lab__source-note">Это не новая страница события, а лаборатория компоновки. Реальный перенос в EventHero должен сохранить существующие иконки, авторизацию/лайк, календарь, share-логику и medallion data pipeline.</p>
        </div>
      </section>
    </div>
  </main>
</EventLayout>

<style is:global>
  .decision-lab { --dl-ink: #262321; --dl-muted: #6f6259; --dl-surface: #fffaf4; --dl-paper: #fffdf8; --dl-line: rgba(95, 68, 50, .16); --dl-accent: #af481f; --dl-deep: #2f2b28; --dl-gold: #d6ad58; --dl-green: #2f7a4f; color: var(--dl-ink); }
  .decision-lab__shell { max-width: 1180px; }
  .decision-lab .section-card { overflow: hidden; }
  .decision-lab__intro { background: radial-gradient(circle at 14% 12%, rgba(214, 173, 88, .28), transparent 28%), linear-gradient(145deg, #fff7eb, #fffdf8 58%, #f5e7d5); }
  .decision-lab__intro-inner { display: grid; gap: 18px; }
  .decision-lab h1 { max-width: 920px; font-size: clamp(2.1rem, 6.6vw, 4.8rem); line-height: .94; letter-spacing: -.06em; }
  .decision-lab h2 { font-size: clamp(1.45rem, 4vw, 2.25rem); letter-spacing: -.035em; }
  .decision-lab .lead { max-width: 800px; color: var(--dl-muted); font-size: clamp(1.02rem, 2.2vw, 1.26rem); line-height: 1.55; }
  .decision-lab__meta-grid { display: grid; gap: 10px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .decision-lab__meta-grid > div { border: 1px solid var(--dl-line); border-radius: 22px; background: rgba(255,255,255,.64); padding: 14px; min-width: 0; }
  .decision-lab__meta-grid span { display: block; color: var(--dl-muted); font-size: .73rem; text-transform: uppercase; letter-spacing: .14em; }
  .decision-lab__meta-grid code, .decision-lab__meta-grid strong { display: block; margin-top: 7px; font-size: .86rem; overflow-wrap: anywhere; }
  .decision-lab__links { display: flex; flex-wrap: wrap; gap: 10px; }
  .decision-lab__links a { min-height: 44px; display: inline-flex; align-items: center; border: 1px solid rgba(175,72,31,.24); color: var(--dl-accent); border-radius: 999px; padding: 10px 14px; text-decoration: none; font-weight: 760; background: rgba(255,255,255,.66); }
  .decision-lab__section-head { max-width: 760px; margin-bottom: 18px; }
  .decision-lab__section-head p { color: var(--dl-muted); line-height: 1.5; }
  .decision-lab__criteria-grid { display: grid; gap: 12px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .decision-lab__criteria-grid article { border: 1px solid var(--dl-line); border-radius: 22px; padding: 16px; background: var(--dl-paper); }
  .decision-lab__criteria-grid h3 { margin: 0 0 8px; font-size: .98rem; }
