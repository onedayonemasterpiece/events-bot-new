---
import EventLayout from '../../../layouts/EventLayout.astro';
import Icon from '../../../components/Icon.astro';
import MedallionStrip from '../../../components/lab/DecisionMedallionStrip.astro';
import { absoluteUrl, SITE_NAME, withBase } from '../../../lib/events';

const canonicalUrl = absoluteUrl('/lab/event-decision-block/');
const title = `Лаборатория страницы события V3 | ${SITE_NAME}`;
const description = 'Mobile-first варианты decision-sheet страницы события: компактная сильная дата, точный адрес, цена или бесплатно, icon+count действия и крупные прокручиваемые медальоны.';
const baselineCommit = '63e88020';
const currentBranch = 'feature/event-page-ux-lab-v3-20260710';
const previewLinks = [
  { label: 'Сохранённый блок даты', href: withBase('/lab/date-block/') },
  { label: 'Полный список медальонов', href: withBase('/lab/medallions/') },
  { label: 'Hero review', href: withBase('/lab/hero/review/') },
];

const sample = {
  title: 'Органный вечер при свечах',
  type: 'концерт',
  day: '05',
  month: 'июля',
  weekday: 'суббота',
  weekdayShort: 'сб',
  time: '19:00',
  venue: 'Кафедральный собор',
  address: 'ул. Канта, 1 · Калининград',
  price: '600–1 500 ₽',
  primaryCta: 'Купить билет',
  datetime: '2026-07-05T19:00:00+02:00',
};

const metrics = [
  { icon: 'calendar' as const, value: '+24', label: 'Добавить в календарь, добавлено 24 раза' },
  { icon: 'share' as const, value: '118', label: 'Поделиться событием, поделились 118 раз' },
  { icon: 'heart' as const, value: '347', label: 'Добавить в избранное, нравится 347 людям' },
];

const medallions = [
  { label: 'Бахослужение', short: 'BACH', image: '/assets/festivals/bahosluzhenie.png', tone: 'gold' },
  { label: 'Пушкинская карта', short: 'ПК', image: '/assets/badges/pushkin-card-medallion.webp', tone: 'green' },
  { label: 'Остров Канта', short: 'OK', image: '/assets/organizers/kant-island.webp', tone: 'blue' },
  { label: 'Источник проверен', short: 'SRC', image: '', tone: 'neutral' },
];

const principles = [
  ['Один главный CTA', 'Покупка или регистрация — единственная залитая кнопка. Остальные действия компактны, но не спрятаны.'],
  ['Сильная, не обязательно широкая дата', 'Проверяем компактный tile, calm bar и split-band против сохранённой full-width даты.'],
  ['Только полезный admission', 'Цена или диапазон заменяют «по билетам». Бесплатно всегда явно. При неизвестной цене слот исчезает.'],
  ['Точный адрес', 'Площадка и улица читаются вместе; допускаются 1–3 строки без жёсткого однострочного обрезания.'],
  ['Крупные медальоны', '90–108px, отдельная горизонтальная shelf с peek; при нуле блок полностью схлопывается.'],
];

const supersededMarkers = [
  'decision-variant-v2-medallion-shelf',
  'decision-variant-v2-attached-medallions',
  'decision-variant-v2-zero-medallions',
  'decision-variant-p03',
  'decision-variant-p01',
  'decision-variant-p04',
  'decision-variant-baseline',
  'decision-variant-p03-zero-medallions',
  'decision-variant-utility-stack',
];
---

<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main" class="decision-lab decision-lab-v3" data-event-decision-lab data-decision-v3-overlap-lab>
    <div class="page-shell decision-lab__shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a><span aria-hidden="true">/</span><span>Decision-блок V3</span>
      </nav>

      <section class="section-card decision-lab__intro">
        <div class="section-card__inner decision-lab__intro-inner">
          <p class="eyebrow">A/B/C/D review · mobile first · baseline preserved</p>
          <h1>Сильная дата без перегруженного первого экрана</h1>
          <p class="lead">Hero-overlap, H1 внутри sheet и крупные медальоны не меняются. В этой итерации убраны три длинные подписи вторичных действий, «по билетам» заменено реальной ценностью, добавлен точный адрес и проверены более компактные способы держать дату сильной.</p>
          <div class="decision-lab__meta-grid" aria-label="Контекст исследования">
            <div><span>сохранённый контроль</span><code>{baselineCommit}</code></div>
            <div><span>ветка лаборатории</span><strong>{currentBranch}</strong></div>
            <div><span>исследование</span><strong>120 референсов · Gemini 3.1 Pro · a-opus</strong></div>
          </div>
          <div class="decision-lab__links" aria-label="Связанные лаборатории">
            {previewLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </div>
      </section>

      <section class="section-card">
        <div class="section-card__inner">
          <div class="decision-lab__section-head">
            <p class="eyebrow">Общий контракт всех новых вариантов</p>
            <h2>Сравниваем компоновку, а не ломаем уже принятые элементы</h2>
          </div>
          <div class="decision-lab__criteria-grid">
            {principles.map(([heading, text]) => <article><h3>{heading}</h3><p>{text}</p></article>)}
          </div>
        </div>
      </section>

      <section class="decision-lab__variants decision-lab__variants--v3" aria-label="Новые варианты decision-блока">
        <article class="section-card decision-lab__variant decision-variant-v3-compact-tile" data-variant="compact-tile">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">V3-A · compact date · Codex/Pinterest synthesis</p>
              <h2>Compact Date Tile</h2>
              <p>Самый компактный сильный якорь: квадрат даты занимает левую часть строки, справа остаются H1 и цена. На 320px tile становится чуть уже, но не прыгает на отдельную строку.</p>
            </div>
            <div class="decision-phone">
              <div class="decision-hero decision-hero--amber"><span>parallax hero image</span></div>
              <section class="decision-sheet">
                <p class="decision-eyebrow"><span>{sample.type}</span><strong class="admission admission--price">от 600 ₽</strong></p>
                <div class="compact-date-title">
                  <time class="compact-date-tile" datetime={sample.datetime} aria-label={`${sample.day} ${sample.month}, ${sample.weekday}, ${sample.time}`}>
                    <b>{sample.day}</b><span>{sample.month}</span><small>{sample.weekdayShort} · {sample.time}</small>
                  </time>
                  <h3>{sample.title}</h3>
                </div>
                <p class="decision-place"><Icon name="pin" /><span><strong>{sample.venue}</strong><small>{sample.address}</small></span></p>
                <a class="decision-primary" href="#review"><Icon name="ticket" /><span>{sample.primaryCta}</span></a>
                <div class="decision-metrics action-metric-row" aria-label="Действия и показатели события">
                  {metrics.map((metric) => <button type="button" aria-label={metric.label} title={metric.label}><Icon name={metric.icon} /><strong>{metric.value}</strong></button>)}
                </div>
              </section>
              <div class="decision-medallions large-medallion-strip"><MedallionStrip items={medallions} mode="large" /></div>
            </div>
            <div class="decision-lab__variant-notes"><p><strong>Плюс:</strong> дата остаётся визуальным знаком, но экономит около 45–55px высоты.</p><p><strong>Риск:</strong> длинный H1 справа от tile может стать на строку выше, чем в остальных вариантах.</p></div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v3-calm-bar" data-variant="calm-bar">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">V3-B · consultant consensus · production-first</p>
              <h2>Calm Date Bar</h2>
              <p>Самый безопасный вариант по итогам a-opus и Gemini: title-first, затем однострочная дата с крупным числом, полный адрес, CTA и спокойная строка icon+count.</p>
            </div>
            <div class="decision-phone">
              <div class="decision-hero decision-hero--forest"><span>parallax hero image</span></div>
              <section class="decision-sheet">
                <p class="decision-eyebrow"><span>{sample.type}</span><strong class="admission admission--price">{sample.price}</strong></p>
                <h3>{sample.title}</h3>
                <time class="calm-date-bar" datetime={sample.datetime} aria-label={`${sample.day} ${sample.month}, ${sample.weekday}, ${sample.time}`}>
                  <b>{sample.day}</b><span>{sample.month}</span><em>· {sample.weekdayShort}</em><strong>· {sample.time}</strong>
                </time>
                <p class="decision-place"><Icon name="pin" /><span><strong>{sample.venue}</strong><small>{sample.address}</small></span></p>
                <a class="decision-primary" href="#review"><Icon name="ticket" /><span>{sample.primaryCta}</span></a>
                <div class="decision-metrics action-metric-row" aria-label="Действия и показатели события">
                  {metrics.map((metric) => <button type="button" aria-label={metric.label} title={metric.label}><Icon name={metric.icon} /><strong>{metric.value}</strong></button>)}
                </div>
              </section>
              <div class="decision-medallions large-medallion-strip"><MedallionStrip items={medallions} mode="large" /></div>
            </div>
            <div class="decision-lab__variant-notes"><p><strong>Плюс:</strong> лучший баланс предсказуемости, доступности и экономии места.</p><p><strong>Риск:</strong> менее характерный, чем tile; потребуется точная работа типографики, чтобы bar не выглядел обычной служебной строкой.</p></div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v3-split-band" data-variant="split-band-free">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">V3-C · date + admission split · free state</p>
              <h2>Split Date / Free Band</h2>
              <p>Проверяет исходную идею «рядом с компактной датой разместить что-то полезное»: справа не декоративный текст, а обязательный статус «Бесплатно».</p>
            </div>
            <div class="decision-phone">
              <div class="decision-hero decision-hero--night"><span>parallax hero image</span></div>
              <section class="decision-sheet">
                <p class="decision-eyebrow"><span>{sample.type}</span></p>
                <div class="split-decision-band">
                  <time datetime={sample.datetime}><b>{sample.day}</b><span>{sample.month}<small>{sample.weekdayShort} · {sample.time}</small></span></time>
                  <strong class="free-panel"><span>вход</span>Бесплатно</strong>
                </div>
                <h3>{sample.title}</h3>
                <p class="decision-place"><Icon name="pin" /><span><strong>{sample.venue}</strong><small>{sample.address}</small></span></p>
                <a class="decision-primary decision-primary--free" href="#review"><Icon name="ticket" /><span>Зарегистрироваться</span></a>
                <div class="decision-metrics action-metric-row" aria-label="Действия и показатели события">
                  {metrics.map((metric) => <button type="button" aria-label={metric.label} title={metric.label}><Icon name={metric.icon} /><strong>{metric.value}</strong></button>)}
                </div>
              </section>
              <div class="decision-medallions large-medallion-strip"><MedallionStrip items={medallions} mode="large" /></div>
            </div>
            <div class="decision-lab__variant-notes"><p><strong>Плюс:</strong> одна полоса отвечает сразу на два главных вопроса — когда и сколько стоит.</p><p><strong>Риск:</strong> для длинного диапазона цен правая половина тесна; paid-вариант должен показывать короткое «от 600 ₽», а полный диапазон — у CTA.</p></div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v3-ticket-cluster" data-variant="ticket-cluster">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">V3-D · transaction cluster · price-first</p>
              <h2>Ticket Cluster</h2>
              <p>Самый спокойный коммерческий вариант: компактная дата остаётся отдельной строкой, а цена и покупка объединены в один транзакционный блок.</p>
            </div>
            <div class="decision-phone">
              <div class="decision-hero decision-hero--paper"><span>parallax hero image</span></div>
              <section class="decision-sheet">
                <p class="decision-eyebrow"><span>{sample.type}</span><time datetime={sample.datetime}><b>{sample.day}</b> {sample.month} · {sample.weekdayShort} · {sample.time}</time></p>
                <h3>{sample.title}</h3>
                <p class="decision-place"><Icon name="pin" /><span><strong>{sample.venue}</strong><small>{sample.address}</small></span></p>
                <div class="ticket-cluster">
                  <p><span>стоимость</span><strong>{sample.price}</strong></p>
                  <a href="#review"><Icon name="ticket" /><span>{sample.primaryCta}</span></a>
                </div>
                <div class="decision-metrics decision-metrics--bare action-metric-row" aria-label="Действия и показатели события">
                  {metrics.map((metric) => <button type="button" aria-label={metric.label} title={metric.label}><Icon name={metric.icon} /><strong>{metric.value}</strong></button>)}
                </div>
              </section>
              <div class="decision-medallions large-medallion-strip"><MedallionStrip items={medallions} mode="large" /></div>
            </div>
            <div class="decision-lab__variant-notes"><p><strong>Плюс:</strong> цена и действие воспринимаются как одна задача, визуальных тяжёлых блоков только два — H1 и ticket cluster.</p><p><strong>Риск:</strong> дата заметно слабее A/B/C; этот вариант допустим только если в тесте пользователи всё равно мгновенно находят «когда».</p></div>
          </div>
        </article>

        <article class="section-card decision-lab__variant decision-variant-v2-date-card decision-variant-v3-control" data-variant="v2-control">
          <div class="section-card__inner">
            <div class="decision-lab__variant-head">
              <p class="eyebrow">Control · preserved from 63e88020</p>
              <h2>V2 Full-width Date Card</h2>
              <p>Сохранённый неплохой вариант из предыдущей итерации. Он нужен как честный контроль: сильнее всех подчёркивает дату, но расходует больше высоты и оставляет длинные подписи действий.</p>
            </div>
            <div class="decision-phone">
              <div class="decision-hero decision-hero--amber"><span>parallax hero image</span></div>
              <section class="decision-sheet">
                <p class="decision-eyebrow"><span>{sample.type}</span><strong class="legacy-admission">по билетам</strong></p>
                <h3>{sample.title}</h3>
                <time class="legacy-date-card" datetime={sample.datetime}>
                  <b>{sample.day}</b><span>{sample.month}</span><strong><em>{sample.weekday}</em>{sample.time}</strong>
                </time>
                <p class="decision-place decision-place--legacy"><Icon name="pin" /><span><strong>{sample.venue}</strong><small>Калининград</small></span></p>
                <a class="decision-primary" href="#review"><Icon name="ticket" /><span>{sample.primaryCta}</span></a>
                <div class="legacy-actions mandatory-action-row">
                  <button type="button"><Icon name="calendar" /><span>Календарь</span></button>
                  <button type="button"><Icon name="share" /><span>Поделиться</span></button>
                  <button type="button"><Icon name="heart" /><span>Нравится</span></button>
                </div>
              </section>
              <div class="decision-medallions large-medallion-strip"><MedallionStrip items={medallions} mode="large" /></div>
            </div>
          </div>
        </article>
      </section>

      <section class="section-card decision-lab__research">
        <div class="section-card__inner">
          <div class="decision-lab__section-head"><p class="eyebrow">Research funnel</p><h2>Что пришло из референсов и двух независимых консультаций</h2></div>
          <div class="decision-lab__research-grid">
            <article><h3>Pinterest</h3><p>Собрано и просмотрено 120 кандидатов по 12 направлениям, от event-ticket apps до музейных страниц и icon+count action bars. В shortlist осталось 19. Самые полезные механики: P065 compact date, P061 editorial date, P032/P039 icon metrics.</p></article>
            <article><h3>Gemini 3.1 Pro</h3><p>Предложил sticky CTA, blocked strong date, two-column metadata и metrics header. После критики самым безопасным признал сильную дату с чистым action footer; two-column вариант отклонил для русского текста на 320px.</p></article>
            <article><h3>a-opus</h3><p>Предложил Compact Left Date, Stacked Calm Facts, Date Sidebar и Price-Anchored CTA. Рейтинг: Calm Bar → Compact Tile → Sidebar → Price-first. Отдельно отверг sticky bar и медальоны-аватары.</p></article>
            <article class="decision-lab__recommendation"><h3>Текущая рекомендация</h3><p><strong>Сначала сравнивать V3-B и V3-A.</strong> B — production-first, A — более характерный и компактный. C важен как обязательная проверка бесплатного события. D показывает нижнюю границу допустимой силы даты.</p></article>
          </div>
        </div>
      </section>

      <section class="section-card decision-lab__states">
        <div class="section-card__inner">
          <div class="decision-lab__section-head"><p class="eyebrow">Data contract</p><h2>Admission не должен придумывать цену</h2></div>
          <div class="state-grid">
            <article><span>известна цена</span><strong>от 600 ₽ / 600–1 500 ₽</strong><p>Показываем у верхней мета-строки или внутри ticket cluster.</p></article>
            <article><span>бесплатно</span><strong class="state-free">Бесплатно</strong><p>Всегда явно; CTA меняется на регистрацию или получение билета.</p></article>
            <article><span>платно, цена неизвестна</span><strong>без admission-pill</strong><p>Не заменяем на «по билетам». CTA честно говорит «Узнать цену».</p></article>
            <article><span>нет медальонов</span><strong>секция отсутствует</strong><p>Никакой пустой заглушки; следующий блок поднимается к sheet.</p></article>
          </div>
        </div>
      </section>

      <section id="review" class="section-card decision-lab__review">
        <div class="section-card__inner">
          <div class="decision-lab__section-head"><p class="eyebrow">Ручной выбор</p><h2>На что смотреть при сравнении A / B / C / D</h2></div>
          <ol>
            <li>Находятся ли дата, день недели и время за один короткий скан — без чтения всей карточки?</li>
            <li>Понятно ли без подписей, что icon+number — кликабельные календарь, share и like?</li>
            <li>Считываются ли цена/«Бесплатно» раньше primary CTA и не выглядит ли admission рекламным бейджем?</li>
            <li>Достаточно ли заметны крупные медальоны, не конкурируя с H1 и покупкой?</li>
            <li>Какой вариант спокойнее выглядит на 320px с длинным заголовком и адресом?</li>
          </ol>
          <p class="decision-lab__source-note">Это лаборатория, а не rollout в <code>EventHero.astro</code>. После выбора production-реализация должна сохранить реальную share/calendar/like-логику, аналитику, авторизацию и данные счётчиков.</p>
        </div>
      </section>

      <div hidden aria-hidden="true">{supersededMarkers.join(' · ')} · A/B review · decision-v2-overlap-lab</div>
    </div>
  </main>
</EventLayout>

<style is:global>
  .decision-lab { --ink:#292522; --muted:#70645b; --paper:#fffaf2; --cream:#f2e4d3; --line:rgba(93,65,47,.16); --accent:#b6481d; --deep:#2e2a27; --gold:#e0bd67; --green:#277349; color:var(--ink); }
  .decision-lab__shell { max-width:1180px; }
  .decision-lab .section-card { overflow:hidden; }
  .decision-lab__intro { background:radial-gradient(circle at 14% 8%,rgba(224,189,103,.32),transparent 29%),linear-gradient(145deg,#fff6e8,#fffdf8 58%,#f0dfcb); }
  .decision-lab__intro-inner { display:grid; gap:18px; }
  .decision-lab h1 { max-width:900px; font-size:clamp(2.1rem,6.5vw,4.7rem); line-height:.95; letter-spacing:-.058em; }
  .decision-lab h2 { font-size:clamp(1.45rem,4vw,2.2rem); letter-spacing:-.035em; }
  .decision-lab .lead { max-width:850px; color:var(--muted); font-size:clamp(1.02rem,2.2vw,1.25rem); line-height:1.55; }
  .decision-lab__meta-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .decision-lab__meta-grid>div,.decision-lab__criteria-grid article,.state-grid article { min-width:0; border:1px solid var(--line); border-radius:22px; background:rgba(255,255,255,.68); padding:14px; }
  .decision-lab__meta-grid span,.state-grid span { display:block; color:var(--muted); font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; }
  .decision-lab__meta-grid code,.decision-lab__meta-grid strong { display:block; margin-top:7px; overflow-wrap:anywhere; font-size:.86rem; }
  .decision-lab__links { display:flex; flex-wrap:wrap; gap:9px; }
  .decision-lab__links a { min-height:44px; display:inline-flex; align-items:center; border:1px solid rgba(182,72,29,.24); border-radius:999px; padding:9px 14px; background:rgba(255,255,255,.68); color:var(--accent); text-decoration:none; font-weight:780; }
  .decision-lab__section-head { max-width:780px; margin-bottom:18px; }
  .decision-lab__section-head p { color:var(--muted); line-height:1.5; }
  .decision-lab__criteria-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }
  .decision-lab__criteria-grid h3,.decision-lab__research-grid h3 { margin:0 0 8px; font-size:1rem; }
  .decision-lab__criteria-grid p,.decision-lab__research-grid p { margin:0; color:var(--muted); line-height:1.5; }
  .decision-lab__variants { display:grid; gap:22px; margin:22px 0; }
