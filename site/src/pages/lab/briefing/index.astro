---
import EventListItem from '../../../components/EventListItem.astro';
import EventLayout from '../../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, SITE_NAME } from '../../../lib/events';
import {
  briefingLabCategories,
  briefingLabExcludedFixtureId,
  briefingLabFallback,
  briefingLabFixtureIds,
  briefingLabScenarios,
  defaultBriefingLabScenario,
} from '../../../data/briefingLab';

const byId = new Map(getEvents().map((event) => [event.id, event]));
const missing = briefingLabFixtureIds.filter((id) => !byId.has(id));
if (missing.length) throw new Error(`Briefing lab fixture(s) missing from getEvents(): ${missing.join(', ')}`);
const events = briefingLabFixtureIds.map((id) => byId.get(id)!);
if (events.some((event) => event.id === briefingLabExcludedFixtureId)) throw new Error('Forbidden fixture 6045 leaked into briefing lab');
const scenarios = [...briefingLabScenarios, briefingLabFallback];
const scenario = defaultBriefingLabScenario;
const title = `Editorial briefing lab | ${SITE_NAME}`;
const description = 'Изолированный research-only прототип A/B/C на продуктовой оболочке листинга.';
const canonicalUrl = absoluteUrl('/lab/briefing/');
---
<EventLayout {title} {description} {canonicalUrl} structuredData={[]}>
  <main id="main" data-briefing-lab data-briefing-variant="static" data-briefing-scenario-id={scenario.id} data-fixture-ids={briefingLabFixtureIds.join(',')}>
    <div class="page-shell" data-lab-page-shell>
      <section class="briefing-lab-slot" aria-label="Городской обзор" data-briefing-slot>
        <div class="briefing-lab-card" data-briefing data-motion="complete">
          <div class="briefing-lab-copy">
            <h1 data-scenario-headline>{scenario.headline}</h1>
            <p data-scenario-support>{scenario.supportingText}</p>
            <a href="#events" data-scenario-cta>{scenario.ctaLabel} →</a>
          </div>
          <span class="briefing-lab-marker" aria-hidden="true">Городской обзор</span>
        </div>
      </section>

      <nav class="source-links briefing-lab-categories" aria-label="Категории событий" data-briefing-categories>
        {briefingLabCategories.map((category) => <a href={category.href} data-category-route={category.href}>{category.label}</a>)}
      </nav>

      <section id="events" class="briefing-lab-events" aria-labelledby="briefing-events-title">
        <h2 id="briefing-events-title">События</h2>
        <div class="listing-stack" data-briefing-feed>
          {events.map((event, index) => (
            <div data-briefing-event-id={event.id} data-first-event-wrapper={index === 0 ? '' : undefined}>
              <EventListItem event={event} />
            </div>
          ))}
        </div>
      </section>

      <section class="briefing-lab-tools" aria-labelledby="briefing-lab-tools-title" data-lab-tools>
        <p class="eyebrow">Research only · no production effect</p>
        <h2 id="briefing-lab-tools-title">Параметры lab</h2>
        <div class="source-links" role="group" aria-label="Вариант briefing">
          <a href="?variant=a" data-variant-switch="control">A · Без briefing</a>
          <a href="?variant=b" data-variant-switch="static">B · Статичный</a>
          <a href="?variant=c" data-variant-switch="reveal">C · Reveal ≤ 1200 мс</a>
        </div>
        <label class="briefing-lab-scenario">
          <span>Сценарий</span>
          <select data-scenario-select>
            {scenarios.map((item) => <option value={item.id}>{item.id} · {item.label}</option>)}
          </select>
        </label>
        <details data-briefing-debug>
          <summary>Локальный журнал (до 24 событий)</summary>
          <button type="button" class="secondary-button" data-export-telemetry>Скачать JSON</button>
          <pre data-briefing-debug-output>Событий пока нет.</pre>
        </details>
      </section>
    </div>
  </main>

  <script type="application/json" id="briefing-lab-scenarios" set:html={JSON.stringify(scenarios)} />
  <noscript><style>.briefing-lab-tools { display: none; }</style></noscript>
  <script is:inline>
    (() => {
      const lab = document.querySelector('[data-briefing-lab]');
      const briefing = lab?.querySelector('[data-briefing]');
      const slot = lab?.querySelector('[data-briefing-slot]');
      if (!lab || !briefing || !slot) return;
      const scenarios = JSON.parse(document.querySelector('#briefing-lab-scenarios')?.textContent || '[]');
      const scenarioById = new Map(scenarios.map((item) => [item.id, item]));
      const params = new URLSearchParams(location.search);
      const variantAliases = { a: 'control', b: 'static', c: 'reveal', control: 'control', static: 'static', reveal: 'reveal' };
      const requestedVariant = String(params.get('variant') || 'static').toLowerCase();
      const variant = variantAliases[requestedVariant] || 'static';
      const requestedScenario = params.get('scenario');
      const scenario = requestedScenario ? (scenarioById.get(requestedScenario) || scenarioById.get('neutral_fallback')) : scenarioById.get('today_count');
      lab.dataset.briefingVariant = variant;
      lab.dataset.briefingScenarioId = scenario.id;
      lab.querySelector('[data-scenario-headline]').textContent = scenario.headline;
      lab.querySelector('[data-scenario-support]').textContent = scenario.supportingText;
      lab.querySelector('[data-scenario-cta]').textContent = `${scenario.ctaLabel} →`;
      const select = lab.querySelector('[data-scenario-select]');
      if (select) select.value = scenario.id;

      // Keep production cards visually exact while disabling shared personalization and navigation in the lab.
      const fixtureIds = String(lab.dataset.fixtureIds || '').split(',');
      const cards = [...lab.querySelectorAll('.listing-item')];
      cards.forEach((card, index) => {
        card.removeAttribute('data-listing-item');
        card.removeAttribute('data-card-href');
        card.dataset.labFixtureId = fixtureIds[index] || '';
        card.querySelectorAll('a').forEach((link) => link.removeAttribute('data-prefetch'));
      });

      const telemetry = [];
      window.__briefingTelemetry = telemetry;
      const emitted = new Set();
      const day = new Date().toISOString().slice(0, 10);
      const updateDebug = () => {
        const output = lab.querySelector('[data-briefing-debug-output]');
        if (output) output.textContent = telemetry.length ? JSON.stringify(telemetry, null, 2) : 'Событий пока нет.';
      };
      const emit = (eventKind, payload = {}) => {
        telemetry.push({ event_kind: eventKind, variant: lab.dataset.briefingVariant, scenario_id: lab.dataset.briefingScenarioId, elapsed_ms: Math.round(performance.now()), ...payload });
        if (telemetry.length > 24) telemetry.splice(0, telemetry.length - 24);
        updateDebug();
      };
      const emitOnce = (eventKind, payload = {}, scope = eventKind) => {
        const key = `ke-briefing-lab:${day}:${lab.dataset.briefingVariant}:${lab.dataset.briefingScenarioId}:${scope}`;
        try { if (emitted.has(key) || sessionStorage.getItem(key) === '1') return false; } catch (_) { if (emitted.has(key)) return false; }
        emitted.add(key);
        try { sessionStorage.setItem(key, '1'); } catch (_) {}
        emit(eventKind, payload);
        return true;
      };
      emitOnce('eligible_session', { assignment_source: params.has('variant') ? 'qa_query' : 'lab_default' });

      let timer = 0;
      let active = false;
      let impressionEmitted = false;
      let completionPendingReason = '';
      const revealKey = `ke-briefing-lab-reveal:${new Date().toISOString().slice(0, 10)}`;
      const complete = (reason) => {
        clearTimeout(timer); active = false; briefing.dataset.motion = 'complete';
        if (variant === 'reveal') { try { sessionStorage.setItem(revealKey, 'complete'); } catch (_) {} }
        if (impressionEmitted) emitOnce('briefing_complete', { completion_reason: reason });
        else completionPendingReason = reason;
      };
      const start = () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return complete('reduced_motion');
        try { if (sessionStorage.getItem(revealKey) === 'complete') return complete('bfcache_or_session'); } catch (_) {}
        active = true; briefing.dataset.motion = 'ready';
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (!active) return; briefing.dataset.motion = 'running'; timer = setTimeout(() => complete('natural'), 1000);
        }));
      };
      if (variant === 'control') slot.hidden = true;
      else if (variant === 'reveal') start();
      const interrupt = (reason) => { if (!active) return; emit('briefing_interrupt', { interrupt_reason: reason }); complete('interrupt'); };
      document.addEventListener('pointerdown', () => interrupt('pointerdown'), { capture: true });
      document.addEventListener('focusin', () => interrupt('focusin'), { capture: true });
      window.addEventListener('scroll', () => interrupt('scroll'), { passive: true });
      window.addEventListener('pageshow', (event) => { if (event.persisted && variant === 'reveal') { active = false; briefing.dataset.motion = 'complete'; } });
      matchMedia('(prefers-reduced-motion: reduce)').addEventListener?.('change', (event) => { if (event.matches) complete('reduced_motion'); });

      const qualified = {
        briefing: { ratio: 0, threshold: .5, timer: 0 },
        firstEvent: { ratio: 0, threshold: .9, timer: 0 },
      };
      const scheduleQualified = (kind) => {
        const state = qualified[kind];
        clearTimeout(state.timer); state.timer = 0;
        if (document.visibilityState !== 'visible' || state.ratio < state.threshold) return;
        state.timer = setTimeout(() => {
          state.timer = 0;
          if (document.visibilityState !== 'visible' || state.ratio < state.threshold) return;
          if (kind === 'briefing' && variant !== 'control') {
            impressionEmitted = emitOnce('briefing_impression', { visible_ratio: state.ratio, visible_ms: 250 }) || impressionEmitted;
            if (variant === 'static') complete('static');
            else if (completionPendingReason) { const reason = completionPendingReason; completionPendingReason = ''; emitOnce('briefing_complete', { completion_reason: reason }); }
          } else if (kind === 'firstEvent') {
            emitOnce('first_event_visible', { event_id: fixtureIds[0], visible_ratio: state.ratio, visible_ms: 250 });
          }
        }, 250);
      };
      const observe = (element, kind) => {
        if (!element || !('IntersectionObserver' in window)) return;
        new IntersectionObserver((entries) => {
          qualified[kind].ratio = entries.at(-1)?.intersectionRatio || 0;
          scheduleQualified(kind);
        }, { threshold: [0, .5, .9, 1] }).observe(element);
      };
      observe(briefing, 'briefing');
      observe(cards[0], 'firstEvent');
      document.addEventListener('visibilitychange', () => {
        Object.values(qualified).forEach((state) => { clearTimeout(state.timer); state.timer = 0; });
        if (document.visibilityState === 'visible') { scheduleQualified('briefing'); scheduleQualified('firstEvent'); }
      });

      lab.querySelector('[data-scenario-select]')?.addEventListener('change', (event) => {
        const url = new URL(location.href); url.searchParams.set('scenario', event.target.value); location.href = url.href;
      });
      cards.forEach((card) => card.addEventListener('click', (event) => {
        const link = event.target.closest('a');
        if (!link && event.target !== card) return;
        event.preventDefault(); emit('event_detail_activate', { event_id: card.dataset.labFixtureId, href: link?.getAttribute('href') || '' });
      }));
      lab.querySelector('[data-export-telemetry]')?.addEventListener('click', () => {
        const blob = new Blob([`${JSON.stringify(telemetry, null, 2)}\n`], { type: 'application/json' });
        const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `briefing-lab-${lab.dataset.briefingVariant}-${lab.dataset.briefingScenarioId}.json`; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0);
      });
    })();
  </script>
</EventLayout>

<style>
  .briefing-lab-slot { height: 150px; margin: 0 0 0.65rem; }
  .briefing-lab-card { height: 100%; overflow: hidden; display: grid; align-content: center; padding: 0.72rem 0.82rem; border: 1px solid rgba(121,48,20,.16); border-radius: 22px; background: linear-gradient(115deg, rgba(165,72,33,.1), transparent 60%), var(--surface); box-shadow: var(--shadow); }
  .briefing-lab-copy { min-width: 0; display: grid; gap: .27rem; }
  .briefing-lab-copy h1 { max-width: none; margin: 0; font-size: clamp(1.2rem, 6vw, 1.48rem); line-height: 1.02; }
  .briefing-lab-copy p { margin: 0; color: var(--muted); font-size: .77rem; font-weight: 650; line-height: 1.22; }
  .briefing-lab-copy a { width: fit-content; color: var(--primary-strong); font-size: .78rem; font-weight: 900; }
  .briefing-lab-marker { display: none; }
  [data-briefing-variant="reveal"] [data-motion="ready"] .briefing-lab-copy,
  [data-briefing-variant="reveal"] [data-motion="running"] .briefing-lab-copy { opacity: 0; transform: translateY(6px); clip-path: inset(0 100% 0 0); }
  [data-briefing-variant="reveal"] [data-motion="running"] .briefing-lab-copy { opacity: 1; transform: none; clip-path: inset(0); transition: opacity 260ms ease-out, transform 420ms cubic-bezier(.2,.75,.2,1), clip-path 960ms cubic-bezier(.2,.75,.2,1); }
  .briefing-lab-categories { flex-wrap: nowrap; margin: 0 0 .7rem; overflow-x: auto; scrollbar-width: none; }
  .briefing-lab-categories::-webkit-scrollbar { display: none; }
  .briefing-lab-categories a { flex: 0 0 auto; }
  .briefing-lab-events h2 { margin: 0 0 .55rem; font-size: 1.15rem; }
  .briefing-lab-tools { margin-top: 1.25rem; padding: 1rem; border: 1px dashed rgba(121,48,20,.26); border-radius: 20px; background: rgba(255,253,248,.72); }
  .briefing-lab-tools h2 { font-size: 1.25rem; }
  .briefing-lab-scenario { display: grid; gap: .35rem; margin-top: 1rem; font-weight: 850; }
  .briefing-lab-scenario select { width: 100%; min-height: 46px; padding: .55rem .7rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; font: inherit; }
  [data-briefing-debug] { margin-top: 1rem; }
  [data-briefing-debug] summary { min-height: 44px; cursor: pointer; font-weight: 850; }
  [data-briefing-debug] pre { max-height: 260px; overflow: auto; padding: .7rem; background: #221a14; color: #fffdf8; font: .72rem/1.4 ui-monospace, monospace; white-space: pre-wrap; }
  @media (min-width: 760px) {
    .briefing-lab-slot { height: 190px; margin-bottom: 1rem; }
    .briefing-lab-card { grid-template-columns: minmax(0,1fr) auto; gap: 1rem; padding: 1.35rem 1.55rem; border-radius: 28px; }
    .briefing-lab-copy h1 { font-size: clamp(2rem, 4vw, 2.65rem); }
    .briefing-lab-copy p, .briefing-lab-copy a { font-size: .95rem; }
    .briefing-lab-marker { display: block; color: var(--primary-strong); font-size: .72rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
  }
  @media (prefers-reduced-motion: reduce) { .briefing-lab-copy { opacity: 1 !important; transform: none !important; clip-path: none !important; transition: none !important; } }
</style>
