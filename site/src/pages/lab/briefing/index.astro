---
import EventListItem from '../../../components/EventListItem.astro';
import EventLayout from '../../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, SITE_NAME } from '../../../lib/events';
import {
  briefingLabCategories,
  briefingLabExcludedFixtureId,
  briefingLabFallback,
  briefingLabFixtureIds,
  briefingLabScenarios,
  defaultBriefingLabScenario,
} from '../../../data/briefingLab';

const byId = new Map(getEvents().map((event) => [event.id, event]));
const missing = briefingLabFixtureIds.filter((id) => !byId.has(id));
if (missing.length) throw new Error(`Briefing lab fixture(s) missing from getEvents(): ${missing.join(', ')}`);
const events = briefingLabFixtureIds.map((id) => byId.get(id)!);
if (events.some((event) => event.id === briefingLabExcludedFixtureId)) throw new Error('Forbidden fixture 6045 leaked into briefing lab');
const scenarios = [...briefingLabScenarios, briefingLabFallback];
const scenario = defaultBriefingLabScenario;
const title = `Живой городской обзор — lab | ${SITE_NAME}`;
const description = 'Изолированный прототип короткой типографической коммуникации: сценарии, ссылки, пауза и повтор.';
const canonicalUrl = absoluteUrl('/lab/briefing/');
---
<EventLayout {title} {description} {canonicalUrl} structuredData={[]}>
  <main id="main" data-briefing-lab data-briefing-variant="static" data-briefing-scenario-id={scenario.id} data-fixture-ids={briefingLabFixtureIds.join(',')}>
    <div class="page-shell" data-lab-page-shell>
      <section class="lab-review-bar" aria-label="Управление прототипом" data-lab-review-bar>
        <div class="lab-review-bar__primary">
          <span class="lab-review-bar__label">LAB · что смотреть</span>
          <div class="lab-variants" role="group" aria-label="Вариант прототипа">
            <a href="?variant=a" data-variant-switch="control">A</a>
            <a href="?variant=b" data-variant-switch="static">B</a>
            <a href="?variant=c&replay=1" data-variant-switch="reveal">C · анимация</a>
          </div>
          <label class="lab-scenario-select">
            <span>Сценарий</span>
            <select data-scenario-select>
              {briefingLabScenarios.map((item, index) => <option value={item.id}>{index + 1}. {item.label}</option>)}
              <option value={briefingLabFallback.id}>Fallback</option>
            </select>
          </label>
        </div>
        <div class="lab-review-bar__actions">
          <button type="button" data-replay>↻ <span>Повторить</span></button>
          <button type="button" data-play-all>▶ <span>Показать все 8</span></button>
          <button type="button" data-reset-briefing-memory title="Сбросить память показов и сохранённый темп">Сбросить память</button>
          <details data-review-guide>
            <summary>Что оценивать</summary>
            <div class="review-guide__content">
              <strong>Смотрите только на коммуникацию:</strong>
              <ol>
                <li>заметны ли сильная типографика и смысл сообщения;</li>
                <li>видна ли поэтапная «печать», но не приходится ли её ждать;</li>
                <li>понятны ли пауза, повтор и смена сценария;</li>
                <li>стабильны ли ссылки и доступны ли категории сразу под обзором.</li>
              </ol>
              <p>Лента ниже — только масштабный контекст. Дизайн карточек сейчас не оцениваем.</p>
              <button type="button" data-export-telemetry>Скачать локальный журнал</button>
            </div>
          </details>
        </div>
      </section>

      <section class="briefing-stage" aria-label="Городской обзор" data-briefing-slot>
        <svg class="briefing-stage__brand-o" viewBox="2571 410 1600 1104" aria-hidden="true" focusable="false">
          <use href="/brand/announcements-wordmark-ui.svg#announcements-wordmark-ui"></use>
        </svg>
        <div class="briefing-stage__meta">
          <span>КАЛИНИНГРАД · ГОРОДСКОЙ ОБЗОР</span>
          <span class="briefing-stage__demo" data-demo-label>DEMO-ДАННЫЕ</span>
          <span data-progress>1 из 8</span>
        </div>
        <div class="briefing-stage__message" data-briefing data-motion="complete" aria-live="off">
          <h1 data-message>
            {scenario.fragments.map((fragment, index) => (
              <>
                {fragment.href ? (
                  <a href={fragment.href} class:list={['briefing-fragment', { 'briefing-fragment--accent': fragment.accent }]} data-reveal-fragment data-fragment-index={index}>{fragment.text}</a>
                ) : (
                  <span class:list={['briefing-fragment', { 'briefing-fragment--accent': fragment.accent }]} data-reveal-fragment data-fragment-index={index}>{fragment.text}</span>
                )}
                {fragment.breakAfter ? <br /> : ' '}
              </>
            ))}
          </h1>
          <a href={scenario.ctaHref} class="briefing-stage__cta" data-scenario-cta>{scenario.ctaLabel} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="briefing-stage__controls" aria-label="Управление рассказом">
          <button type="button" aria-label="Предыдущий сценарий" data-previous>←</button>
          <button type="button" data-pause><span data-pause-label>Пауза</span></button>
          <button type="button" aria-label="Следующий сценарий" data-next>→</button>
          <span class="briefing-stage__status" data-playback-status>Готово</span>
          <div class="pace-control" role="group" aria-label="Темп показа">
            <button type="button" data-pace="slow">Медленнее</button>
            <button type="button" data-pace="normal" aria-pressed="true">Обычно</button>
            <button type="button" data-pace="fast">Быстрее</button>
          </div>
        </div>
      </section>

      <nav class="briefing-categories" aria-label="Быстрый переход к категориям" data-briefing-categories>
        {briefingLabCategories.map((category) => <a href={category.href} data-category-route={category.href}>{category.label}</a>)}
      </nav>

      <section id="events" class="briefing-context-feed" aria-labelledby="briefing-events-title">
        <div class="briefing-context-feed__heading">
          <h2 id="briefing-events-title">Дальше начинается лента</h2>
          <span>Черновой контекст · карточки не оцениваем</span>
        </div>
        <div class="listing-stack" data-briefing-feed>
          {events.map((event) => (
            <div data-briefing-event-id={event.id}><EventListItem event={event} /></div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script type="application/json" id="briefing-lab-scenarios" set:html={JSON.stringify(scenarios)} />
  <noscript><style>.lab-review-bar, .briefing-stage__controls { display: none !important; }</style></noscript>
  <script is:inline>
    (() => {
      const lab = document.querySelector('[data-briefing-lab]');
      const stage = lab?.querySelector('[data-briefing-slot]');
      const briefing = lab?.querySelector('[data-briefing]');
      const message = lab?.querySelector('[data-message]');
      if (!lab || !stage || !briefing || !message) return;

      const allScenarios = JSON.parse(document.querySelector('#briefing-lab-scenarios')?.textContent || '[]');
      const deck = allScenarios.filter((item) => item.id !== 'neutral_fallback');
      const byId = new Map(allScenarios.map((item) => [item.id, item]));
      const params = new URLSearchParams(location.search);
      const aliases = { a: 'control', b: 'static', c: 'reveal', control: 'control', static: 'static', reveal: 'reveal' };
      const variant = aliases[String(params.get('variant') || 'c').toLowerCase()] || 'reveal';
      const MEMORY_KEY = 'ke-briefing-memory-v1';
      const PREFS_KEY = 'ke-briefing-lab-prefs-v1';
      const ACTIONS = new Set(['share_event', 'like_event', 'not_interested']);
      const DAY_MS = 86400000;
      const safeRead = (key, fallback) => { try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; } catch (_) { return fallback; } };
      const safeWrite = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch (_) { return false; } };
      const asTime = (value) => { const time = new Date(value).getTime(); return Number.isFinite(time) ? time : 0; };
      const cleanMemory = (value) => {
        const exposures = {};
        const source = value && typeof value.exposures === 'object' ? value.exposures : {};
        deck.forEach((item) => {
          const times = Array.isArray(source[item.id]) ? source[item.id].map(asTime).filter(Boolean).sort((a, b) => a - b).slice(-6) : [];
          if (times.length) exposures[item.id] = times;
        });
        const actionSuccess = {};
        const sourceActions = value && typeof value.actionSuccess === 'object' ? value.actionSuccess : {};
        ACTIONS.forEach((action) => { const time = asTime(sourceActions[action]); if (time) actionSuccess[action] = time; });
        return { version: 1, exposures, actionSuccess };
      };
      let memory = cleanMemory(safeRead(MEMORY_KEY, {}));
      let prefs = safeRead(PREFS_KEY, {});
      if (!prefs || prefs.version !== 1 || !['slow', 'normal', 'fast'].includes(prefs.pace)) prefs = { version: 1 };
      const rememberActionSuccess = (action, timestamp = Date.now()) => {
        if (!ACTIONS.has(action)) return;
        const time = asTime(timestamp) || Date.now();
        if (time <= Number(memory.actionSuccess[action] || 0)) return;
        memory.actionSuccess[action] = time; safeWrite(MEMORY_KEY, memory);
      };
      const feedbackLog = safeRead('ke_event_feedback_log_v1', []);
      if (Array.isArray(feedbackLog)) feedbackLog.slice(-240).forEach((entry) => {
        if (!entry || typeof entry !== 'object') return;
        const action = ACTIONS.has(entry.event_kind) ? entry.event_kind : (ACTIONS.has(entry.action) ? entry.action : '');
        if (action) rememberActionSuccess(action, entry.ts || entry.timestamp);
      });
      const eligible = (item, now = Date.now()) => {
        if (item.demoSignal && asTime(item.demoValidUntil) <= now) return false;
        const seen = memory.exposures[item.id] || [];
        if (seen.at(-1) && now - seen.at(-1) < Number(item.cooldownDays || 0) * DAY_MS) return false;
        if (item.maxExposuresPerYear && seen.filter((time) => time >= now - 365 * DAY_MS).length >= item.maxExposuresPerYear) return false;
        const success = item.actionKind ? Number(memory.actionSuccess[item.actionKind] || 0) : 0;
        if (success && item.actionSuccessSuppressDays && now - success < item.actionSuccessSuppressDays * DAY_MS) return false;
        return true;
      };
      const chooseAutomatic = () => {
        const choices = deck.filter((item) => eligible(item));
        if (!choices.length) return byId.get('neutral_fallback');
        return choices.sort((a, b) => {
          const aSeen = memory.exposures[a.id] || [], bSeen = memory.exposures[b.id] || [];
          if (!aSeen.length && bSeen.length) return -1;
          if (aSeen.length && !bSeen.length) return 1;
          return (aSeen.at(-1) || 0) - (bSeen.at(-1) || 0);
        })[0];
      };
      const explicitScenario = params.has('scenario');
      const requested = explicitScenario ? (byId.get(params.get('scenario')) || byId.get('neutral_fallback')) : chooseAutomatic();
      let current = Math.max(0, deck.findIndex((item) => item.id === requested.id));
      let currentScenario = requested;
      let automaticExposureCandidate = !explicitScenario && requested.id !== 'neutral_fallback';
      let exposureTimer = 0;
      let fragmentTimers = [];
      let advanceTimer = 0;
      let running = false;
      let deckPlaying = params.get('autoplay') === '1';
      let explicitPaused = false;
      let hoverPaused = false;
      let focusPaused = false;
      let completedDeckIndexes = new Set();
      let pace = ['slow', 'normal', 'fast'].includes(params.get('pace')) ? params.get('pace') : (['slow', 'normal', 'fast'].includes(prefs.pace) ? prefs.pace : 'normal');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const day = new Date().toISOString().slice(0, 10);
      const revealKey = `ke-briefing-showcase-v2:${day}`;
      const telemetry = [];
      window.__briefingTelemetry = telemetry;

      // Preserve the production card geometry as context without enabling shared
      // listing prefetch/personalization behavior inside this isolated lab.
      [...lab.querySelectorAll('.listing-item')].forEach((card) => {
        card.removeAttribute('data-listing-item');
        card.removeAttribute('data-card-href');
        card.querySelectorAll('a').forEach((link) => link.removeAttribute('data-prefetch'));
      });

      const emit = (eventKind, payload = {}) => {
        telemetry.push({ event_kind: eventKind, variant, scenario_id: currentScenario.id, elapsed_ms: Math.round(performance.now()), ...payload });
        if (telemetry.length > 24) telemetry.splice(0, telemetry.length - 24);
      };
      const clearMotionTimers = () => {
        fragmentTimers.forEach(clearTimeout); fragmentTimers = [];
        clearTimeout(advanceTimer); advanceTimer = 0;
      };
      const fragments = () => [...message.querySelectorAll('[data-reveal-fragment]')];
      const updateStatus = (text) => { const node = lab.querySelector('[data-playback-status]'); if (node) node.textContent = text; };
      const updatePause = () => {
        const paused = explicitPaused || hoverPaused || focusPaused;
        const label = lab.querySelector('[data-pause-label]');
        if (label) label.textContent = paused ? 'Продолжить' : 'Пауза';
        lab.querySelector('[data-pause]')?.setAttribute('aria-pressed', String(paused));
      };
      const updateProgress = () => {
        const pos = deck.findIndex((item) => item.id === currentScenario.id);
        lab.querySelector('[data-progress]').textContent = pos >= 0 ? `${pos + 1} из ${deck.length}` : 'Fallback';
        const select = lab.querySelector('[data-scenario-select]'); if (select) select.value = currentScenario.id;
        lab.dataset.briefingScenarioId = currentScenario.id;
      };
      const setUrl = () => {
        const url = new URL(location.href);
        url.searchParams.set('variant', variant === 'control' ? 'a' : variant === 'static' ? 'b' : 'c');
        url.searchParams.set('scenario', currentScenario.id);
        url.searchParams.set('pace', pace);
        url.searchParams.delete('replay');
        history.replaceState({}, '', url);
      };
      const makeFragment = (fragment, index) => {
        const node = document.createElement(fragment.href ? 'a' : 'span');
        node.textContent = fragment.text;
        node.className = `briefing-fragment${fragment.accent ? ' briefing-fragment--accent' : ''}`;
        node.dataset.revealFragment = '';
        node.dataset.fragmentIndex = String(index);
        if (fragment.href) node.href = fragment.href;
        return node;
      };
      const renderMessage = () => {
        clearTimeout(exposureTimer); exposureTimer = 0;
        message.replaceChildren();
        currentScenario.fragments.forEach((fragment, index) => {
          message.append(makeFragment(fragment, index));
          if (fragment.breakAfter) message.append(document.createElement('br'));
          else message.append(document.createTextNode(' '));
        });
        const cta = lab.querySelector('[data-scenario-cta]');
        cta.textContent = `${currentScenario.ctaLabel} ↗`;
        cta.href = currentScenario.ctaHref;
        briefing.dataset.cursor = ['bar', 'underscore'].includes(params.get('cursor')) ? params.get('cursor') : currentScenario.cursor;
        briefing.dataset.cursorLinger = 'false';
        const demo = lab.querySelector('[data-demo-label]');
        if (demo) demo.textContent = currentScenario.demoSignal ? 'DEMO-SIGNAL · НЕ ПРОД-ДАННЫЕ' : 'DEMO-ДАННЫЕ';
        updateProgress(); setUrl();
      };
      const showAllFragments = () => {
        fragments().forEach((node) => { node.classList.add('is-visible'); node.classList.remove('is-active'); });
      };
      const rememberReveal = () => { try { sessionStorage.setItem(revealKey, 'complete'); } catch (_) {} };
      const scheduleAdvance = () => {
        clearTimeout(advanceTimer);
        if (!deckPlaying || explicitPaused || hoverPaused || focusPaused || reduced.matches) return;
        const hold = { slow: 5200, normal: 3600, fast: 2400 }[pace];
        advanceTimer = setTimeout(() => {
          completedDeckIndexes.add(current);
          if (completedDeckIndexes.size >= deck.length) {
            deckPlaying = false; updateStatus('Все 8 показаны'); emit('deck_complete'); return;
          }
          current = (current + 1) % deck.length;
          while (completedDeckIndexes.has(current)) current = (current + 1) % deck.length;
          currentScenario = deck[current]; renderMessage(); startReveal({ force: true, reason: 'deck_next' });
        }, hold);
      };
      const complete = (reason = 'manual_complete', { remember = true } = {}) => {
        fragmentTimers.forEach(clearTimeout); fragmentTimers = [];
        running = false; showAllFragments(); briefing.dataset.motion = 'complete';
        const linger = variant === 'reveal' && !reduced.matches && Boolean(currentScenario.cursorLinger);
        briefing.dataset.cursorLinger = String(linger);
        if (linger) fragments().at(-1)?.classList.add('is-active');
        if (remember && variant === 'reveal') rememberReveal();
        updateStatus(reason === 'session_complete' ? 'Уже показано · можно повторить' : (explicitPaused || hoverPaused || focusPaused ? 'На паузе' : 'Готово'));
        emit('briefing_complete', { completion_reason: reason });
        scheduleAdvance();
      };
      const startReveal = ({ force = false, reason = 'replay' } = {}) => {
        clearMotionTimers(); renderMessage();
        if (variant !== 'reveal' || reduced.matches) { briefing.dataset.motion = 'complete'; showAllFragments(); updateStatus(reduced.matches ? 'Без анимации' : 'Статичный вариант'); return; }
        if (!force) {
          try { if (sessionStorage.getItem(revealKey) === 'complete' && params.get('replay') !== '1') return complete('session_complete', { remember: false }); } catch (_) {}
        }
        explicitPaused = false; hoverPaused = false; focusPaused = false; updatePause();
        const items = fragments();
        items.forEach((node) => node.classList.remove('is-visible', 'is-active'));
        briefing.dataset.motion = 'running'; running = true; updateStatus('Печатаем обзор…'); emit('briefing_start', { reason, pace });
        const stagger = { slow: 280, normal: 210, fast: 145 }[pace];
        items.forEach((node, index) => {
          const timer = setTimeout(() => {
            items.forEach((item) => item.classList.remove('is-active'));
            node.classList.add('is-visible', 'is-active');
            emit('briefing_fragment', { fragment_index: index });
          }, index === 0 ? 0 : index * stagger);
          fragmentTimers.push(timer);
        });
        fragmentTimers.push(setTimeout(() => complete('natural'), Math.max(1, items.length - 1) * stagger + 360));
      };
      const pause = (reason, explicit = true) => {
        if (running) complete(reason, { remember: true });
        clearTimeout(advanceTimer);
        if (reason === 'hover') hoverPaused = true;
        else if (reason === 'focus') focusPaused = true;
        else if (explicit) explicitPaused = true;
        updatePause(); updateStatus('На паузе'); emit('briefing_pause', { reason });
      };
      const resume = (reason = 'manual') => {
        explicitPaused = false; hoverPaused = false; focusPaused = false; updatePause(); updateStatus('Продолжаем'); emit('briefing_resume', { reason }); scheduleAdvance();
      };
      const move = (step) => {
        clearMotionTimers(); deckPlaying = false; completedDeckIndexes.clear();
        current = (current + step + deck.length) % deck.length;
        currentScenario = deck[current]; automaticExposureCandidate = false; startReveal({ force: true, reason: step > 0 ? 'next' : 'previous' });
      };

      lab.dataset.briefingVariant = variant;
      lab.querySelectorAll('[data-variant-switch]').forEach((node) => node.setAttribute('aria-current', node.dataset.variantSwitch === variant ? 'page' : 'false'));
      if (variant === 'control') { stage.hidden = true; automaticExposureCandidate = false; }
      lab.querySelectorAll('[data-pace]').forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.pace === pace)));
      renderMessage();
      if (variant === 'reveal') startReveal({ force: params.get('replay') === '1', reason: 'initial' });
      else complete(variant === 'control' ? 'control' : 'static', { remember: false });

      lab.querySelector('[data-scenario-select]')?.addEventListener('change', (event) => {
        const next = byId.get(event.target.value) || byId.get('neutral_fallback');
        currentScenario = next; current = Math.max(0, deck.findIndex((item) => item.id === next.id));
        automaticExposureCandidate = false; deckPlaying = false; completedDeckIndexes.clear(); startReveal({ force: true, reason: 'scenario_select' });
      });
      lab.querySelector('[data-replay]')?.addEventListener('click', () => { automaticExposureCandidate = false; startReveal({ force: true, reason: 'manual_replay' }); });
      lab.querySelector('[data-play-all]')?.addEventListener('click', () => {
        automaticExposureCandidate = false; deckPlaying = true; completedDeckIndexes.clear(); current = 0; currentScenario = deck[0]; startReveal({ force: true, reason: 'play_all' });
      });
      lab.querySelector('[data-previous]')?.addEventListener('click', () => move(-1));
      lab.querySelector('[data-next]')?.addEventListener('click', () => move(1));
      lab.querySelector('[data-pause]')?.addEventListener('click', () => {
        if (explicitPaused) return resume();
        hoverPaused = false; focusPaused = false; pause('manual', true);
      });
      lab.querySelectorAll('[data-pace]').forEach((button) => button.addEventListener('click', () => {
        pace = button.dataset.pace; prefs = { version: 1, pace }; safeWrite(PREFS_KEY, prefs); lab.querySelectorAll('[data-pace]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        setUrl(); startReveal({ force: true, reason: 'pace_change' });
      }));
      lab.querySelector('[data-reset-briefing-memory]')?.addEventListener('click', () => {
        try { localStorage.removeItem(MEMORY_KEY); localStorage.removeItem(PREFS_KEY); } catch (_) {}
        memory = cleanMemory({}); prefs = { version: 1 }; updateStatus('Память показов сброшена');
      });

      stage.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button, select, summary')) return;
        if (event.target.closest('a')) { if (running) pause('link_pointer', true); return; }
        (explicitPaused || hoverPaused || focusPaused) ? resume('blank_tap') : pause('blank_tap');
      });
      stage.addEventListener('mouseenter', () => { if (running || deckPlaying) pause('hover', false); });
      stage.addEventListener('mouseleave', () => { if (!hoverPaused || explicitPaused || focusPaused) return; setTimeout(() => { if (hoverPaused && !explicitPaused && !focusPaused) resume('hover_leave'); }, 750); });
      stage.addEventListener('focusin', () => pause('focus', false));
      lab.addEventListener('click', (event) => {
        const link = event.target.closest('.briefing-fragment[href], [data-scenario-cta]');
        if (link) emit('briefing_link_activate', { href: link.getAttribute('href') });
      }, { capture: true });
      document.addEventListener('visibilitychange', () => { if (document.hidden) pause('visibility_hidden'); });
      window.addEventListener('pageshow', (event) => { if (event.persisted) pause('bfcache'); });
      window.addEventListener('ke:event-action-success', (event) => { const detail = event.detail || {}; rememberActionSuccess(detail.action || detail.event_kind, detail.ts || detail.timestamp || Date.now()); });
      new IntersectionObserver((entries) => {
        const ratio = entries.at(-1)?.intersectionRatio || 0; clearTimeout(exposureTimer); exposureTimer = 0;
        if (ratio >= .5 && automaticExposureCandidate && variant !== 'control') { const id = currentScenario.id; exposureTimer = setTimeout(() => { if (!automaticExposureCandidate || currentScenario.id !== id) return; const seen = memory.exposures[id] || []; memory.exposures[id] = [...seen, Date.now()].slice(-6); safeWrite(MEMORY_KEY, memory); automaticExposureCandidate = false; }, 250); }
        if (ratio < .5 && (running || deckPlaying)) pause('out_of_view');
      }, { threshold: [0, .5, 1] }).observe(stage);
      reduced.addEventListener?.('change', () => reduced.matches ? complete('reduced_motion') : undefined);
      lab.querySelector('[data-export-telemetry]')?.addEventListener('click', () => {
        const blob = new Blob([`${JSON.stringify(telemetry, null, 2)}\n`], { type: 'application/json' });
        const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `briefing-lab-${variant}-${currentScenario.id}.json`; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0);
      });
