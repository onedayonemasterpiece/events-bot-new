---
import EventListItem from '../../../components/EventListItem.astro';
import EventLayout from '../../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, SITE_NAME, withBase } from '../../../lib/events';
import {
  briefingLabCategories,
  briefingLabExcludedFixtureId,
  briefingLabFallback,
  briefingLabFixtureIds,
  briefingLabMediaReviewScenarios,
  briefingLabScenarios,
  defaultBriefingLabScenario,
} from '../../../data/briefingLab';
import type { BriefingLabScenario } from '../../../data/briefingLab';

const byId = new Map(getEvents().map((event) => [event.id, event]));
const missing = briefingLabFixtureIds.filter((id) => !byId.has(id));
if (missing.length) throw new Error(`Briefing lab fixture(s) missing from getEvents(): ${missing.join(', ')}`);
const events = briefingLabFixtureIds.map((id) => byId.get(id)!);
if (events.some((event) => event.id === briefingLabExcludedFixtureId)) throw new Error('Forbidden fixture 6045 leaked into briefing lab');
const eventHref = (eventId: number) => {
  const event = byId.get(eventId);
  if (!event) throw new Error(`Briefing lab event target missing: ${eventId}`);
  return withBase(`/sobytiya/${event.slug}/`);
};
const resolveScenario = (item: BriefingLabScenario) => {
  const mediaEvent = item.media ? byId.get(item.media.eventId) : undefined;
  const minimumWidth = item.media?.minSourceWidth ?? 1000;
  const eligibleMediaAsset = (asset: NonNullable<typeof mediaEvent>['image_assets'][number]) => item.media?.ocrSafe === true
    && asset.image_text_mode === 'visual_only'
    && asset.image_kind === 'photo'
    && asset.safe_crop === true
    && asset.recommended_hero_fit === 'cover'
    && asset.width >= minimumWidth
    && asset.width * asset.height >= 1_000_000;
  // Media is a hand-curated object, not a request to find "something close".
  // If any exact source-order asset is gone or fails admission, abstain from
  // the whole atomic media plan rather than silently replacing one panel.
  const requestedOrders = item.media
    ? [...(item.media.assetSourceOrders ?? (item.media.assetSourceOrder === undefined ? [] : [item.media.assetSourceOrder]))]
    : [];
  const mediaAssets = requestedOrders.map((order) => mediaEvent?.image_assets?.find((asset) => asset.source_order === order && eligibleMediaAsset(asset)));
  const mediaPlanReady = requestedOrders.length > 0 && mediaAssets.every(Boolean);
  const resolvedAssets = mediaPlanReady ? mediaAssets as NonNullable<typeof mediaEvent>['image_assets'] : [];
  const mediaAsset = resolvedAssets[0];
  return {
    ...item,
    fragments: item.fragments.map((fragment) => ({
      ...fragment,
      href: fragment.eventId ? eventHref(fragment.eventId) : fragment.href,
    })),
    ctaHref: item.ctaEventId ? eventHref(item.ctaEventId) : item.ctaHref,
    media: item.media && mediaEvent && mediaAsset ? {
      ...item.media,
      src: mediaAsset.src,
      alt: mediaAsset.alt || `Афиша события «${mediaEvent.title}»`,
      href: eventHref(item.media.eventId),
      sourceWidth: mediaAsset.width,
      sourceHeight: mediaAsset.height,
      imageTextMode: mediaAsset.image_text_mode,
      imageKind: mediaAsset.image_kind,
      maxUpscale: item.media.maxUpscale ?? 1.1,
      fit: item.media.fit ?? 'cover',
      layout: item.media.layout ?? 'panorama',
      sources: resolvedAssets.map((asset) => ({
        src: asset.src,
        sourceOrder: asset.source_order,
        width: asset.width,
        height: asset.height,
        imageTextMode: asset.image_text_mode,
        imageKind: asset.image_kind,
        assetKey: asset.asset_key ?? null,
        faceBoxes: Array.isArray(asset.face_boxes)
          ? asset.face_boxes
          : item.media?.labFaceBoxesBySourceOrder?.[asset.source_order] ?? null,
        faceBoxStatus: Array.isArray(asset.face_boxes)
          ? 'complete'
          : item.media?.labFaceBoxesBySourceOrder?.[asset.source_order] ? 'lab-fixture' : 'missing',
      })),
      cropStrategy: item.media.layout === 'portrait-collage'
        ? 'curated-contiguous-portrait-collage'
        : item.media.layout === 'portrait-single'
          ? 'curated-portrait-preserve'
          : item.media.fit === 'contain' ? 'face-safe-contain' : 'curated-focal-cover',
    } : undefined,
  };
};
const rawScenarios: readonly BriefingLabScenario[] = [...briefingLabScenarios, ...briefingLabMediaReviewScenarios, briefingLabFallback];
const scenarios = rawScenarios.map(resolveScenario);
const scenario = scenarios.find((item) => item.id === defaultBriefingLabScenario.id)!;
const scenarioCount = briefingLabScenarios.length;
const title = `Живой городской обзор — lab | ${SITE_NAME}`;
const description = 'Изолированный прототип короткой типографической коммуникации: сценарии, ссылки, пауза и повтор.';
const canonicalUrl = absoluteUrl('/lab/briefing/');
const mosaicColumns = 20;
const mosaicRows = 5;
const mosaicTiles = Array.from({ length: mosaicColumns * mosaicRows }, (_, index) => ({ index }));
---
<EventLayout {title} {description} {canonicalUrl} structuredData={[]}>
  <main id="main" data-briefing-lab data-briefing-variant="static" data-briefing-scenario-id={scenario.id} data-fixture-ids={briefingLabFixtureIds.join(',')}>
    <div class="page-shell" data-lab-page-shell>
      <section class="briefing-stage" aria-label="Городской обзор" data-briefing-slot>
        <img class="briefing-stage__brand-o" src={withBase('/brand/announcements-wide-o-ui.svg')} alt="" aria-hidden="true" />
        <div class="briefing-stage__media" data-narrative-media aria-hidden="true">
          <a data-media-link tabindex="-1">
            <img data-media-image alt="" />
            <span class="briefing-stage__mosaic" data-media-mosaic aria-hidden="true">
              {mosaicTiles.map((tile) => (
                <span
                  class="briefing-stage__mosaic-tile"
                  data-mosaic-tile
                  data-tile-index={tile.index}
                />
              ))}
            </span>
          </a>
        </div>
        <div class="briefing-stage__message" data-briefing data-motion="complete" aria-live="off">
          <h1 data-message>
            {scenario.fragments.map((fragment, index) => (
              <>
                {fragment.href ? (
                  <a href={fragment.href} class:list={['briefing-fragment', { 'briefing-fragment--accent': fragment.accent }]} data-reveal-fragment data-fragment-index={index}>{fragment.text}</a>
                ) : (
                  <span class:list={['briefing-fragment', { 'briefing-fragment--accent': fragment.accent }]} data-reveal-fragment data-fragment-index={index}>{fragment.text}</span>
                )}
                {fragment.breakAfter ? <br /> : ' '}
              </>
            ))}
          </h1>
          <div class="briefing-stage__actions">
            <a href={scenario.ctaHref} class="briefing-stage__cta" data-scenario-cta>{scenario.ctaLabel} <span aria-hidden="true">↗</span></a>
            <button type="button" class="briefing-stage__next" data-public-next hidden>Показать следующее</button>
          </div>
        </div>
      </section>

      <nav class="media-review-controls" aria-label="Сравнение изображений" data-media-review-controls hidden>
        <div class="media-review-controls__heading">
          <strong>Сравнение изображений</strong>
          <span data-media-review-progress>1 из {briefingLabMediaReviewScenarios.length}</span>
        </div>
        <div class="media-review-controls__rail">
          {briefingLabMediaReviewScenarios.map((item, index) => (
            <button type="button" data-media-review-scenario={item.id} aria-label={item.label}>{index + 1}</button>
          ))}
        </div>
        <div class="media-review-controls__actions">
          <button type="button" data-media-review-previous>← Назад</button>
          <button type="button" data-media-review-replay>↻ Повтор</button>
          <button type="button" data-media-review-autoplay>▶ По очереди</button>
          <button type="button" data-media-review-next>Далее →</button>
        </div>
      </nav>

      <nav class="briefing-categories" aria-label="Быстрый переход к категориям" data-briefing-categories>
        {briefingLabCategories.map((category) => <a href={category.href} data-category-route={category.href}>{category.label}</a>)}
      </nav>

      <section id="events" class="briefing-context-feed" aria-labelledby="briefing-events-title">
        <div class="briefing-context-feed__heading">
          <h2 id="briefing-events-title">Дальше начинается лента</h2>
          <span>Черновой контекст · карточки не оцениваем</span>
        </div>
        <div class="listing-stack" data-briefing-feed>
          {events.map((event) => (
            <div data-briefing-event-id={event.id}><EventListItem event={event} /></div>
          ))}
        </div>
      </section>

      <aside class="lab-dock" aria-label="Лабораторные настройки" data-lab-dock>
        <details>
          <summary>LAB · управление</summary>
          <div class="lab-dock__panel">
            <div class="lab-state" aria-label="Состояние сценария">
              <span data-demo-label>DEMO-ДАННЫЕ</span>
              <span data-progress={`1 из ${scenarioCount}`}>1 из {scenarioCount}</span>
              <span data-chain-progress>цепочка 1/3</span>
              <span data-playback-status>Готово</span>
            </div>
            <div class="lab-variants" role="group" aria-label="Вариант прототипа">
              <a href="?variant=a" data-variant-switch="control">A</a>
              <a href="?variant=b" data-variant-switch="static">B</a>
              <a href="?variant=c&replay=1" data-variant-switch="reveal">C · анимация</a>
            </div>
            <label class="lab-scenario-select">
              <span>Сценарий</span>
              <select data-scenario-select>
                {briefingLabScenarios.map((item, index) => <option value={item.id}>{index + 1}. {item.label}</option>)}
                <option value={briefingLabFallback.id}>Fallback</option>
              </select>
            </label>
            <div class="lab-dock__actions">
              <button type="button" data-previous>← Предыдущий</button>
              <button type="button" data-replay>↻ Повторить</button>
              <button type="button" data-play-all>▶ Показать все {scenarioCount}</button>
              <button type="button" data-pause aria-pressed="false"><span data-pause-label>Пауза</span></button>
            </div>
            <div class="pace-control" role="group" aria-label="Темп показа">
              <button type="button" data-pace="slow">Медленнее</button>
              <button type="button" data-pace="normal" aria-pressed="true">Обычно</button>
              <button type="button" data-pace="fast">Быстрее</button>
              <select data-pace-select aria-label="Темп показа">
                <option value="slow">Медленнее</option>
                <option value="normal">Обычно</option>
                <option value="fast">Быстрее</option>
              </select>
            </div>
            <details data-review-guide>
              <summary>Что оценивать</summary>
              <div class="review-guide__content">
                <strong>Смотрите на коммуникацию, ритм и переходы.</strong>
                <p>Лента выше — только масштабный контекст. Дизайн карточек сейчас не оцениваем.</p>
                <button type="button" data-reset-briefing-memory>Сбросить локальную память и темп</button>
                <button type="button" data-export-telemetry>Скачать локальный журнал</button>
              </div>
            </details>
          </div>
        </details>
      </aside>
    </div>
  </main>

  <script type="application/json" id="briefing-lab-scenarios" set:html={JSON.stringify(scenarios)} />
  <noscript><style>.lab-dock, [data-public-next] { display: none !important; }</style></noscript>
  <script is:inline>
    (() => {
      const lab = document.querySelector('[data-briefing-lab]');
      const stage = lab?.querySelector('[data-briefing-slot]');
      const briefing = lab?.querySelector('[data-briefing]');
      const message = lab?.querySelector('[data-message]');
      if (!lab || !stage || !briefing || !message) return;

      const params = new URLSearchParams(location.search);
      const allScenarios = JSON.parse(document.querySelector('#briefing-lab-scenarios')?.textContent || '[]');
      const byId = new Map(allScenarios.map((item) => [item.id, item]));
      const requestedById = params.has('scenario') ? byId.get(params.get('scenario')) : undefined;
      const reviewMode = params.get('review') === 'media' || requestedById?.reviewOnly === true;
      const ordinaryDeck = allScenarios.filter((item) => item.id !== 'neutral_fallback' && item.reviewOnly !== true);
      const mediaReviewDeck = allScenarios.filter((item) => item.reviewOnly === true);
      const deck = reviewMode ? mediaReviewDeck : ordinaryDeck;
      const aliases = { a: 'control', b: 'static', c: 'reveal', control: 'control', static: 'static', reveal: 'reveal' };
      const variant = aliases[String(params.get('variant') || 'c').toLowerCase()] || 'reveal';
      const MEMORY_KEY = 'ke-briefing-memory-v1';
      const PREFS_KEY = 'ke-briefing-lab-prefs-v1';
      const ACTIONS = new Set(['share_event', 'like_event', 'not_interested']);
      const ACTION_ALIASES = { share: 'share_event', like: 'like_event', dislike: 'not_interested', not_interested: 'not_interested' };
      const DAY_MS = 86400000;
      const safeRead = (key, fallback) => { try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; } catch (_) { return fallback; } };
      const safeWrite = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch (_) { return false; } };
      const asTime = (value) => { const time = new Date(value).getTime(); return Number.isFinite(time) ? time : 0; };
      const cleanMemory = (value) => {
        const exposures = {};
        const source = value && typeof value.exposures === 'object' ? value.exposures : {};
        deck.forEach((item) => {
          const times = Array.isArray(source[item.id]) ? source[item.id].map(asTime).filter(Boolean).sort((a, b) => a - b).slice(-6) : [];
          if (times.length) exposures[item.id] = times;
        });
        const actionSuccess = {};
        const sourceActions = value && typeof value.actionSuccess === 'object' ? value.actionSuccess : {};
        ACTIONS.forEach((action) => { const time = asTime(sourceActions[action]); if (time) actionSuccess[action] = time; });
        return { version: 1, exposures, actionSuccess };
      };
      let memory = cleanMemory(safeRead(MEMORY_KEY, {}));
      let prefs = safeRead(PREFS_KEY, {});
      if (!prefs || prefs.version !== 1 || !['slow', 'normal', 'fast'].includes(prefs.pace)) prefs = { version: 1 };
      const normalizeAction = (action) => ACTIONS.has(action) ? action : ACTION_ALIASES[action] || '';
      const rememberActionSuccess = (rawAction, timestamp = Date.now()) => {
        const action = normalizeAction(rawAction);
        if (!ACTIONS.has(action)) return;
        const time = asTime(timestamp) || Date.now();
        if (time <= Number(memory.actionSuccess[action] || 0)) return;
        memory.actionSuccess[action] = time; safeWrite(MEMORY_KEY, memory);
      };
      const syncFeedbackLog = () => {
        const feedbackLog = safeRead('ke_event_feedback_log_v1', []);
        if (!Array.isArray(feedbackLog)) return;
        feedbackLog.slice(-240).forEach((entry) => {
          if (!entry || typeof entry !== 'object') return;
          const action = normalizeAction(entry.event_kind) || normalizeAction(entry.action);
          if (action) rememberActionSuccess(action, entry.ts || entry.timestamp);
        });
      };
      syncFeedbackLog();
      const eligible = (item, now = Date.now()) => {
        if (item.demoSignal && asTime(item.demoValidUntil) <= now) return false;
        const seen = memory.exposures[item.id] || [];
        if (seen.at(-1) && now - seen.at(-1) < Number(item.cooldownDays || 0) * DAY_MS) return false;
        if (item.maxExposuresPerYear && seen.filter((time) => time >= now - 365 * DAY_MS).length >= item.maxExposuresPerYear) return false;
        const success = item.actionKind ? Number(memory.actionSuccess[item.actionKind] || 0) : 0;
        const lastExposure = Number(seen.at(-1) || 0);
        if (success > lastExposure && lastExposure && item.actionSuccessSuppressDays && now - success < item.actionSuccessSuppressDays * DAY_MS) return false;
        return true;
      };
      const chooseAutomatic = () => {
        const choices = deck.filter((item) => eligible(item));
        if (!choices.length) return byId.get('neutral_fallback');
        return choices.sort((a, b) => {
          const aSeen = memory.exposures[a.id] || [], bSeen = memory.exposures[b.id] || [];
          if (!aSeen.length && bSeen.length) return -1;
          if (aSeen.length && !bSeen.length) return 1;
          return (aSeen.at(-1) || 0) - (bSeen.at(-1) || 0);
        })[0];
      };
      const explicitScenario = params.has('scenario');
      const requested = explicitScenario && deck.some((item) => item.id === requestedById?.id)
        ? requestedById
        : reviewMode ? deck[0] : chooseAutomatic();
      let preserveAutomaticUrl = !explicitScenario;
      let current = Math.max(0, deck.findIndex((item) => item.id === requested.id));
      let currentScenario = requested;
      let automaticExposureCandidate = !explicitScenario && requested.id !== 'neutral_fallback';
      let exposureTimer = 0;
      let fragmentTimers = [];
      let advanceTimer = 0;
      let cursorLingerTimer = 0;
      let mediaEntryTimer = 0;
      let mediaLoadToken = 0;
      let mosaicResizeFrame = 0;
      let ignoreOutOfViewUntil = 0;
      let running = false;
      let deckPlaying = params.get('autoplay') === '1';
      const AUTO_CHAIN_LIMIT = 3;
      const MOSAIC_ENTRY_MS = 1560;
      const MOSAIC_EXIT_MS = 720;
      let autoChainStep = 1;
      let explicitPaused = false;
      let hoverPaused = false;
      let focusPaused = false;
      let completedDeckIndexes = new Set();
      let pace = ['slow', 'normal', 'fast'].includes(params.get('pace')) ? params.get('pace') : (['slow', 'normal', 'fast'].includes(prefs.pace) ? prefs.pace : 'normal');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const desktopMedia = matchMedia('(min-width: 1024px)');
      const day = new Date().toISOString().slice(0, 10);
      const revealKey = `ke-briefing-showcase-v2:${day}`;
      const telemetry = [];
      window.__briefingTelemetry = telemetry;

      // Preserve the production card geometry as context without enabling shared
      // listing prefetch/personalization behavior inside this isolated lab.
      [...lab.querySelectorAll('.listing-item')].forEach((card) => {
        card.removeAttribute('data-listing-item');
        card.removeAttribute('data-card-href');
        card.querySelectorAll('a').forEach((link) => link.removeAttribute('data-prefetch'));
      });

      const emit = (eventKind, payload = {}) => {
        telemetry.push({ event_kind: eventKind, variant, scenario_id: currentScenario.id, elapsed_ms: Math.round(performance.now()), ...payload });
        if (telemetry.length > 24) telemetry.splice(0, telemetry.length - 24);
      };
      const clearMotionTimers = () => {
        fragmentTimers.forEach(clearTimeout); fragmentTimers = [];
        clearTimeout(advanceTimer); advanceTimer = 0;
        clearTimeout(cursorLingerTimer); cursorLingerTimer = 0;
        clearTimeout(mediaEntryTimer); mediaEntryTimer = 0;
      };
      const fragments = () => [...message.querySelectorAll('[data-reveal-fragment]')];
      const setPendingCursor = (visible, { terminal = false } = {}) => {
        clearTimeout(cursorLingerTimer); cursorLingerTimer = 0;
        fragments().forEach((node) => node.classList.remove('is-awaiting-next'));
        briefing.dataset.cursorLinger = String(Boolean(visible));
        if (!visible || variant !== 'reveal' || reduced.matches) return;
        fragments().at(-1)?.classList.add('is-awaiting-next');
        if (terminal) cursorLingerTimer = setTimeout(() => setPendingCursor(false), 2340);
      };
      const updateStatus = (text) => { const node = lab.querySelector('[data-playback-status]'); if (node) node.textContent = text; };
      const updatePause = () => {
        const paused = explicitPaused || hoverPaused || focusPaused;
        const label = lab.querySelector('[data-pause-label]');
        if (label) label.textContent = paused ? 'Продолжить' : 'Пауза';
        lab.querySelector('[data-pause]')?.setAttribute('aria-pressed', String(paused));
      };
      const updateProgress = () => {
        const pos = deck.findIndex((item) => item.id === currentScenario.id);
        lab.querySelector('[data-progress]').textContent = pos >= 0 ? `${pos + 1} из ${deck.length}` : 'Fallback';
        const chain = lab.querySelector('[data-chain-progress]');
        if (chain) chain.textContent = deckPlaying ? 'LAB · весь банк' : `цепочка ${autoChainStep}/${AUTO_CHAIN_LIMIT}`;
        const select = lab.querySelector('[data-scenario-select]'); if (select) select.value = currentScenario.id;
        const reviewProgress = lab.querySelector('[data-media-review-progress]');
        if (reviewProgress && reviewMode) reviewProgress.textContent = `${pos + 1} из ${deck.length}`;
        lab.querySelectorAll('[data-media-review-scenario]').forEach((button) => button.setAttribute('aria-current', String(button.dataset.mediaReviewScenario === currentScenario.id)));
        lab.dataset.briefingScenarioId = currentScenario.id;
      };
      const setPublicNext = (visible) => {
        const button = lab.querySelector('[data-public-next]');
        if (!button) return;
        button.hidden = !visible;
        button.setAttribute('aria-hidden', String(!visible));
        stage.dataset.chainState = visible ? 'stopped' : 'active';
      };
      const syncPaceControls = () => {
        lab.querySelectorAll('[data-pace]').forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.pace === pace)));
        const select = lab.querySelector('[data-pace-select]'); if (select) select.value = pace;
      };
      const setUrl = () => {
        const url = new URL(location.href);
        url.searchParams.set('variant', variant === 'control' ? 'a' : variant === 'static' ? 'b' : 'c');
        if (preserveAutomaticUrl) url.searchParams.delete('scenario');
        else url.searchParams.set('scenario', currentScenario.id);
        if (reviewMode) url.searchParams.set('review', 'media');
        else url.searchParams.delete('review');
        url.searchParams.set('pace', pace);
        url.searchParams.delete('replay');
        history.replaceState({}, '', url);
      };
      const makeFragment = (fragment, index) => {
        const node = document.createElement(fragment.href ? 'a' : 'span');
        node.textContent = fragment.text;
        node.className = `briefing-fragment${fragment.accent ? ' briefing-fragment--accent' : ''}`;
        node.dataset.revealFragment = '';
        node.dataset.fragmentIndex = String(index);
        if (fragment.href) node.href = fragment.href;
        return node;
      };
      const mediaShell = lab.querySelector('[data-narrative-media]');
      const mediaLink = lab.querySelector('[data-media-link]');
      const mediaImage = lab.querySelector('[data-media-image]');
      const mosaicRoot = lab.querySelector('[data-media-mosaic]');
      const mosaicTiles = [...lab.querySelectorAll('[data-mosaic-tile]')];
      const mediaPreloadCache = new Map();
      let scenarioTransitionToken = 0;
      const mosaicMedia = matchMedia('(min-width: 1024px) and (min-height: 650px)');
      const mediaAllowed = (media) => media?.mode === 'mosaic' ? mosaicMedia.matches : desktopMedia.matches;
      const MOSAIC_ROWS = 5;
      const MOSAIC_LEVELS = [.03, .1, .24, .5, .78, .96];
      const mosaicColumnsForViewport = (media = currentScenario.media) => Number(media?.mosaicColumns) || (media?.layout === 'portrait-single'
        ? (innerWidth >= 1792 ? 10 : 9)
        : innerWidth >= 1792 ? 20 : innerWidth >= 1536 ? 18 : 16);
      const hashUnit = (...parts) => {
        const input = parts.join('|');
        let hash = 2166136261;
        for (let index = 0; index < input.length; index += 1) hash = Math.imul(hash ^ input.charCodeAt(index), 16777619);
        hash ^= hash >>> 16;
        hash = Math.imul(hash, 2246822507);
        hash ^= hash >>> 13;
        hash = Math.imul(hash, 3266489909);
        hash ^= hash >>> 16;
        return (hash >>> 0) / 4294967295;
      };
      const nearestMosaicLevel = (value) => MOSAIC_LEVELS.reduce((best, level) => Math.abs(level - value) < Math.abs(best - value) ? level : best, MOSAIC_LEVELS[0]);
      const clamp = (value, minimum, maximum) => Math.max(minimum, Math.min(maximum, value));
      const smoothstep = (value) => {
        const progress = clamp(value, 0, 1);
        return progress * progress * (3 - 2 * progress);
      };
      let mosaicGeometryRevision = 0;
      const measuredCopyLines = () => {
        const rects = fragments()
