---
import DesktopHeaderConcept, { type DesktopHeaderVariant } from '../../../../components/lab/DesktopHeaderConcept.astro';
import previewData from '../../../../data/preview-events.json';
import type { PreviewEvent } from '../../../../lib/types';
import { eventImageUrl } from '../../../../lib/assets';
import { displayDate, displayWeekdayLong, withBase } from '../../../../lib/events';

const variants: DesktopHeaderVariant[] = ['text-tag', 'logo-eyelet', 'signature-tab'];
export function getStaticPaths() {
  return ['text-tag', 'logo-eyelet', 'signature-tab'].map((variant) => ({ params:{ variant } }));
}

const variant = Astro.params.variant as DesktopHeaderVariant;
if (!variants.includes(variant)) throw new Error(`Unknown desktop header variant: ${variant}`);
const event = (previewData.events as PreviewEvent[]).find((item) => item.id === 5761);
if (!event) throw new Error('Desktop header control event 5761 is missing');
const heroAsset = event.image_assets?.[5] || event.image_assets?.[0];
const heroUrl = eventImageUrl(heroAsset?.src || event.image_url) || heroAsset?.src || event.image_url || '';
const dateLabel = displayDate(event);
const weekdayLabel = displayWeekdayLong(event);
const titleByVariant:Record<DesktopHeaderVariant,string> = {
  'text-tag':'Текстовая бирка',
  'logo-eyelet':'Знак-люверс',
  'signature-tab':'Подпись-бирка',
};
const descriptionByVariant:Record<DesktopHeaderVariant,string> = {
  'text-tag':'Спокойный solid-tab 240×88: полный lockup не переносится между 1024–1920, а event detail не назначает ложный активный раздел.',
  'logo-eyelet':'Белый одноцветный знак лежит прямо на бирке; меню закреплено справа, active-state на event detail отсутствует.',
  'signature-tab':'Белый знак и название собраны в одну неглубокую фирменную подпись; event detail без active-state.',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{titleByVariant[variant]} — desktop header lab</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <style>
      :root { font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#251c17; background:#fbf7ef; }
      * { box-sizing:border-box; }
      html { min-width:760px; }
      body { margin:0; background:#fbf7ef; }
      img { display:block; max-width:100%; }
      .header-lab-jump { position:fixed; z-index:60; right:14px; bottom:14px; min-height:44px; display:inline-flex; align-items:center; padding:.5rem .8rem; border:1px solid #dac8b7; border-radius:999px; background:rgba(255,250,242,.94); color:#793014; font-size:.84rem; font-weight:800; text-decoration:none; box-shadow:0 12px 28px rgba(62,42,28,.14); }
      .header-lab-jump:focus-visible { outline:3px solid rgba(15,118,110,.65); outline-offset:3px; }
      .header-lab-hero { min-height:calc(100svh - 56px); display:grid; grid-template-columns:minmax(0,1fr) minmax(560px,1fr); background:#fffaf2; }
      .header-lab-hero__media { min-width:0; min-height:calc(100svh - 56px); overflow:hidden; background:#efe5d8; }
      .header-lab-hero__media img { width:100%; height:100%; object-fit:cover; object-position:50% 50%; }
      .header-lab-hero__content { min-width:0; align-self:start; display:grid; gap:1rem; padding:clamp(3.5rem,6vw,6.5rem) clamp(2rem,5vw,5rem) 4rem; }
      .header-lab-hero__topline { display:flex; align-items:baseline; justify-content:space-between; gap:1.2rem; color:#96401f; font-weight:900; text-transform:uppercase; letter-spacing:.08em; }
      .header-lab-hero__topline span:first-child { font-size:.78rem; }
      .header-lab-hero__date { display:flex; align-items:baseline; gap:.8rem; font-size:1.05rem; letter-spacing:.02em; white-space:nowrap; }
      .header-lab-hero__date strong { font-size:1.28rem; }
      .header-lab-hero h1 { max-width:14ch; margin:.2rem 0 0; font-size:clamp(3rem,4.6vw,5.2rem); line-height:.92; letter-spacing:-.06em; }
      .header-lab-hero__place { margin:0; display:flex; gap:.62rem; align-items:center; font-size:1.18rem; font-weight:820; }
      .header-lab-hero__place::before { content:""; width:.62rem; height:.82rem; border-radius:999px 999px 999px 0; background:#a54821; transform:rotate(-45deg); }
      .header-lab-hero__badges { display:flex; flex-wrap:wrap; gap:.55rem; padding-top:.35rem; }
      .header-lab-hero__badges span { min-height:42px; display:inline-flex; align-items:center; padding:.45rem .82rem; border:1px solid #d9cbbb; border-radius:999px; background:#fffdf8; color:#69301b; font-size:.86rem; font-weight:800; }
      .header-lab-hero__actions { margin-top:.45rem; min-height:94px; display:grid; grid-template-columns:minmax(130px,.45fr) minmax(220px,1fr) 56px 56px; align-items:center; gap:.62rem; padding:1rem; border-radius:22px; background:#292521; color:#fffaf2; }
      .header-lab-hero__admission small { display:block; color:#c7b9ac; font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
      .header-lab-hero__admission strong { font-size:1.26rem; }
      .header-lab-hero__source,.header-lab-hero__icon { min-height:54px; border:0; border-radius:16px; font:inherit; font-weight:850; }
      .header-lab-hero__source { background:#b94d21; color:#fff; }
      .header-lab-hero__icon { background:#3b3733; color:#fff; font-size:1.25rem; }
      .header-lab-note { position:absolute; z-index:2; left:clamp(1.2rem,3vw,3rem); bottom:clamp(1.2rem,3vw,2.2rem); max-width:360px; padding:.78rem .92rem; border-radius:14px; background:rgba(39,32,27,.92); color:#fffaf2; }
      .header-lab-note strong { display:block; font-size:.98rem; }
      .header-lab-note span { display:block; margin-top:.18rem; color:#e0d5ca; font-size:.8rem; line-height:1.35; }
      .header-lab-stage { position:relative; }
      @media (max-width:1120px) {
        .header-lab-hero { grid-template-columns:minmax(0,48fr) minmax(510px,52fr); }
        .header-lab-hero__content { padding-inline:2rem; }
        .header-lab-hero h1 { font-size:clamp(2.7rem,4.8vw,4.2rem); }
        .header-lab-hero__actions { grid-template-columns:minmax(120px,.4fr) minmax(190px,1fr) 52px 52px; }
      }
      @media (max-width:880px) {
        .header-lab-hero { grid-template-columns:43fr 57fr; }
        .header-lab-hero__content { padding-inline:1.35rem; }
        .header-lab-hero__topline { align-items:flex-start; flex-direction:column; gap:.35rem; }
        .header-lab-hero__actions { grid-template-columns:1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <DesktopHeaderConcept variant={variant} />
    <main id="main" class="header-lab-stage" data-header-desktop-example={variant}>
      <section class="header-lab-hero" aria-labelledby="header-lab-event-title">
        <div class="header-lab-hero__media"><img src={heroUrl} alt={event.image_alt || ''} width={heroAsset?.width || 800} height={heroAsset?.height || 602} /></div>
        <div class="header-lab-hero__content">
          <div class="header-lab-hero__topline"><span>{event.event_type || 'Выставка'}</span><span class="header-lab-hero__date"><strong>{dateLabel}</strong><span>{weekdayLabel}</span><strong>{event.display_time}</strong></span></div>
          <h1 id="header-lab-event-title">{event.title}</h1>
          <p class="header-lab-hero__place">{event.venue_name || event.city}</p>
          <div class="header-lab-hero__badges" aria-label="Свойства события"><span>Бесплатно · вход свободный</span><span>Детям / семье</span><span>Фэнтези-своп</span></div>
          <div class="header-lab-hero__actions"><div class="header-lab-hero__admission"><small>Вход</small><strong>Бесплатно</strong></div><button class="header-lab-hero__source" type="button">Источник события</button><button class="header-lab-hero__icon" type="button" aria-label="Поделиться">↗</button><button class="header-lab-hero__icon" type="button" aria-label="Нравится">♡</button></div>
        </div>
      </section>
      <aside class="header-lab-note" aria-label="Описание варианта"><strong>{titleByVariant[variant]}</strong><span>{descriptionByVariant[variant]}</span></aside>
    </main>
    <a class="header-lab-jump" href={withBase('/lab/header-desktop/')}>Все 3 варианта</a>
  </body>
</html>
