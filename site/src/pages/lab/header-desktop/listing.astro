---
import DesktopHeaderConcept from '../../../components/lab/DesktopHeaderConcept.astro';
import previewData from '../../../data/preview-events.json';
import { eventImageUrl } from '../../../lib/assets';
import { displayDate, withBase } from '../../../lib/events';
import type { PreviewEvent } from '../../../lib/types';

const events = (previewData.events as PreviewEvent[])
  .filter((event) => String(event.event_type || '').toLocaleLowerCase('ru-RU').includes('выстав'))
  .slice(0, 6);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Выставки — active-state desktop header lab</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <style>
      :root { font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#251c17; background:#fbf7ef; }
      * { box-sizing:border-box; }
      html { min-width:760px; }
      body { margin:0; background:radial-gradient(circle at 12% 0,rgba(165,72,33,.10),transparent 32rem),#fbf7ef; }
      img { display:block; max-width:100%; }
      a:focus-visible { outline:3px solid rgba(15,118,110,.68); outline-offset:4px; }
      .listing-lab { width:min(1440px,calc(100% - clamp(3rem,5vw,6rem))); margin:0 auto; padding:clamp(4rem,7vw,7rem) 0 5rem; }
      .listing-lab__eyebrow { margin:0 0 .65rem; color:#9a4020; font-size:.74rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
      h1 { margin:0; font-size:clamp(3.1rem,6vw,6.2rem); line-height:.88; letter-spacing:-.065em; }
      .listing-lab__lead { max-width:62ch; margin:1.1rem 0 0; color:#685b51; font-size:1.02rem; line-height:1.55; }
      .listing-lab__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-top:clamp(2.4rem,5vw,4.5rem); }
      .listing-card { min-width:0; overflow:hidden; border:1px solid rgba(121,48,20,.13); border-radius:22px; background:#fffaf2; box-shadow:0 15px 34px rgba(68,43,27,.08); }
      .listing-card__media { aspect-ratio:16/10; overflow:hidden; background:#eadfd3; }
      .listing-card__media img { width:100%; height:100%; object-fit:cover; }
      .listing-card__body { min-height:168px; display:grid; align-content:start; gap:.55rem; padding:1rem 1.05rem 1.2rem; }
      .listing-card__meta { color:#9a4020; font-size:.72rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
      .listing-card h2 { margin:0; font-size:clamp(1.2rem,1.8vw,1.65rem); line-height:1.03; letter-spacing:-.035em; }
      .listing-card p { margin:0; color:#6c5f55; font-size:.86rem; line-height:1.35; }
      .listing-lab__back { min-height:44px; display:inline-flex; align-items:center; margin-top:2rem; color:#793014; font-weight:850; text-underline-offset:.24em; }
      @media (max-width:1080px) { .listing-lab__grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    </style>
  </head>
  <body>
    <DesktopHeaderConcept variant="logo-eyelet" current="exhibitions" />
    <main class="listing-lab" data-header-desktop-listing>
      <p class="listing-lab__eyebrow">точное совпадение раздела · aria-current="page"</p>
      <h1>Выставки</h1>
      <p class="listing-lab__lead">На списочной странице активный пункт помогает подтвердить местоположение. На отдельной карточке события и в поиске это состояние намеренно отсутствует.</p>
      <section class="listing-lab__grid" aria-label="Список выставок">
        {events.map((event) => {
          const asset = event.image_assets?.[0];
          const imageUrl = eventImageUrl(asset?.src || event.image_url) || asset?.src || event.image_url || '';
          return (
            <article class="listing-card">
              <div class="listing-card__media">{imageUrl && <img src={imageUrl} alt="" width={asset?.width || 800} height={asset?.height || 500} />}</div>
              <div class="listing-card__body">
                <span class="listing-card__meta">{displayDate(event)}{event.display_time ? ` · ${event.display_time}` : ''}</span>
                <h2>{event.title}</h2>
                <p>{event.venue_name || event.city}</p>
              </div>
            </article>
          );
        })}
      </section>
      <a class="listing-lab__back" href={withBase('/lab/header-desktop/')}>← Вернуться к сравнению</a>
    </main>
  </body>
</html>
