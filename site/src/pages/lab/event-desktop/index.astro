const candidates = [
  {
    key: 'editorial' as const, name: 'Editorial Slab',
    photoVerdict: 'Сохраняем: фото становится настоящим широким hero и может быть смело кропнуто; информационная плита поднимается на нижний край.',
    ocrVerdict: 'Сохраняем условно: афиша и плита стоят рядом; без source-grounded safe-флага остаётся contain даже при геометрической потере меньше 20%.',
  },
  {
    key: 'split' as const, name: 'Split Canvas',
    photoVerdict: 'Сохраняем: простой 55/45 split хорошо использует горизонтальную фотографию и переживает короткую высоту.',
    ocrVerdict: 'Сохраняем: ширина media-колонки вычисляется из реальной высоты viewport и ratio постера, а не назначается произвольно.',
    recommendation: 'наиболее предсказуемый',
  },
  {
    key: 'gallery' as const, name: 'Gallery Exhibition',
    photoVerdict: 'Сохраняем: вертикальная фотография допустимо кропается по высоте и не превращается в маленький постер посреди поля.',
    ocrVerdict: 'Сильный кандидат: рама повторяет ratio источника, поэтому афиша занимает высоту почти без пустых полей и без потери текста.',
    recommendation: 'фаворит для portrait OCR',
  },
  {
    key: 'typographic' as const, name: 'Typographic Lead',
    photoVerdict: 'Эксперимент: работает, когда HTML-заголовок короткий/средний, а вертикальное фото достаточно сильное само по себе.',
    ocrVerdict: 'Оставляем как gated-вариант: только короткие заголовки (≤35 знаков и ≤5 слов); иначе автоматический fallback в Gallery/Split.',
    recommendation: 'только по title gate',
  },
