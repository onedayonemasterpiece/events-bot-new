---
import EventLayout from '../../../../layouts/EventLayout.astro';
import DesktopEventCleanPage from '../../../../components/DesktopEventPage.astro';
import previewData from '../../../../data/preview-events.json';
import examplesData from '../../../../data/desktop-event-examples.json';
import thumbnailOverridesData from '../../../../data/desktop-event-thumbnail-overrides.json';
import type { PreviewEvent } from '../../../../lib/types';
import type { EventImageDerivative, EventImageMediaRole } from '../../../../lib/types';
import { absoluteUrl, SITE_NAME } from '../../../../lib/events';

type Scenario = {
  slug: string;
  eventId: number;
  candidate: 'editorial' | 'split';
  mediaPolicy: 'non-ocr' | 'ocr';
  transport?: boolean;
  heroImageIndex?: number;
  heroWidth?: number;
  heroHeight?: number;
  heroObjectPosition?: string;
  editorialRail?: boolean;
  editorialMotion?: 'pinned' | 'continuous';
  editorialCropPolicy?: 'exact' | 'bottom-safe';
  ocrCompanionImageIndex?: number;
  ocrCompanionLayout?: 'separate' | 'arrival';
  autoRotate?: boolean;
  ocrSafeCover?: boolean;
  ocrSourceIndexes?: number[];
  duplicateSourceIndexes?: number[];
  splitMediaFit?: 'natural' | 'viewport-cover';
  splitPortraitViewer?: boolean;
  splitPortraitSourceIndexes?: number[];
  splitViewerHiddenSourceIndexes?: number[];
  relatedMediaTreatment?: 'cover' | 'ambient' | 'hybrid';
  mediaRoleOverrides?: Record<number, EventImageMediaRole>;
  mediaDimensionOverrides?: Record<number, { width: number; height: number }>;
};

const kupalaRoles:Record<number, EventImageMediaRole> = {
  0:'attendee_information', 1:'attendee_information',
  2:'event_photo', 3:'event_photo', 4:'event_photo', 5:'event_photo', 6:'event_photo',
  7:'event_photo', 8:'event_photo', 9:'event_photo', 10:'event_photo', 11:'event_photo',
};
const kupalaDimensions = {
  0:{ width:1179, height:1523 }, 1:{ width:1179, height:1039 },
  2:{ width:2560, height:1703 }, 3:{ width:2560, height:1709 }, 4:{ width:2560, height:1704 }, 5:{ width:2560, height:1703 },
  6:{ width:1709, height:2560 }, 7:{ width:1709, height:2560 }, 8:{ width:2560, height:1703 }, 9:{ width:2560, height:1709 },
  10:{ width:600, height:440 }, 11:{ width:2560, height:1709 },
};
const epidemicRoles:Record<number, EventImageMediaRole> = {
  0:'event_identity_poster', 1:'event_photo', 2:'event_photo', 3:'event_photo', 4:'event_photo', 5:'event_identity_poster',
  6:'event_photo', 7:'event_photo', 8:'event_photo', 9:'event_photo', 10:'event_photo', 11:'event_photo',
};
const epidemicDimensions = {
  0:{ width:2500, height:2500 }, 1:{ width:1200, height:899 }, 2:{ width:1280, height:851 }, 3:{ width:2560, height:1709 },
  4:{ width:638, height:316 }, 5:{ width:2500, height:2500 }, 6:{ width:2560, height:1703 }, 7:{ width:1200, height:801 },
  8:{ width:2560, height:1709 }, 9:{ width:1280, height:851 }, 10:{ width:1280, height:854 }, 11:{ width:1280, height:851 },
};

const scenarios: Scenario[] = [
  { slug: 'editorial-photo', eventId: 5658, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'pinned', heroObjectPosition: '50% 80%', editorialRail: true, autoRotate: false, ocrSourceIndexes: [4] },
  { slug: 'editorial-photo-continuous', eventId: 5658, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'continuous', editorialCropPolicy: 'exact', heroObjectPosition: '50% 80%', editorialRail: true, autoRotate: true, ocrSourceIndexes: [4] },
  { slug: 'editorial-photo-continuous-wide', eventId: 5201, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'continuous', editorialCropPolicy: 'exact', heroObjectPosition: '50% 50%', editorialRail: true, autoRotate: false },
  { slug: 'editorial-photo-continuous-near-square', eventId: 6583, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'continuous', editorialCropPolicy: 'bottom-safe', heroObjectPosition: '50% 100%', editorialRail: true, autoRotate: false },
  { slug: 'editorial-ocr-companion', eventId: 6323, candidate: 'editorial', mediaPolicy: 'ocr', editorialMotion: 'pinned', heroImageIndex: 2, heroWidth: 2560, heroHeight: 1703, heroObjectPosition: '50% 52%', ocrCompanionImageIndex: 0, ocrCompanionLayout: 'separate', editorialRail: true, autoRotate: false, ocrSourceIndexes: [0, 1], mediaRoleOverrides:kupalaRoles, mediaDimensionOverrides:kupalaDimensions },
  { slug: 'editorial-ocr-companion-arrival', eventId: 4671, candidate: 'editorial', mediaPolicy: 'ocr', editorialMotion: 'continuous', heroImageIndex: 3, heroWidth: 2560, heroHeight: 1709, heroObjectPosition: '50% 50%', ocrCompanionImageIndex: 0, ocrCompanionLayout: 'arrival', editorialRail: false, autoRotate: false, ocrSourceIndexes: [0, 5], duplicateSourceIndexes: [5], mediaRoleOverrides:epidemicRoles, mediaDimensionOverrides:epidemicDimensions },
  { slug: 'split-ocr', eventId: 5077, candidate: 'split', mediaPolicy: 'ocr', heroImageIndex: 0, duplicateSourceIndexes: [1] },
  { slug: 'split-portrait', eventId: 6550, candidate: 'split', mediaPolicy: 'non-ocr', heroImageIndex: 0, duplicateSourceIndexes: [1, 2] },
  { slug: 'split-low-resolution', eventId: 5761, candidate: 'split', mediaPolicy: 'non-ocr', heroImageIndex: 5, heroWidth: 800, heroHeight: 602, splitMediaFit: 'viewport-cover', splitPortraitViewer: true },
  { slug: 'split-multi-portrait', eventId: 5894, candidate: 'split', mediaPolicy: 'non-ocr', heroImageIndex: 3, heroWidth: 960, heroHeight: 1280, splitPortraitViewer: true, splitPortraitSourceIndexes: [3, 5, 6, 8, 10, 11] },
  { slug: 'split-ocr-with-photos', eventId: 6323, candidate: 'split', mediaPolicy: 'ocr', heroImageIndex: 0, heroWidth: 1179, heroHeight: 1523, ocrSourceIndexes: [0, 1], mediaRoleOverrides:kupalaRoles, mediaDimensionOverrides:kupalaDimensions },
  { slug: 'related-cover', eventId: 5658, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'pinned', heroObjectPosition: '50% 80%', editorialRail: true, autoRotate: false, ocrSourceIndexes: [4], relatedMediaTreatment: 'cover' },
  { slug: 'related-ambient', eventId: 5658, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'pinned', heroObjectPosition: '50% 80%', editorialRail: true, autoRotate: false, ocrSourceIndexes: [4], relatedMediaTreatment: 'ambient' },
  { slug: 'related-hybrid', eventId: 5658, candidate: 'editorial', mediaPolicy: 'non-ocr', editorialMotion: 'pinned', heroObjectPosition: '50% 80%', editorialRail: true, autoRotate: false, ocrSourceIndexes: [4], relatedMediaTreatment: 'hybrid' },
];

export function getStaticPaths() {
  return [
    'editorial-photo',
    'editorial-photo-continuous',
    'editorial-photo-continuous-wide',
    'editorial-photo-continuous-near-square',
    'editorial-ocr-companion',
    'editorial-ocr-companion-arrival',
    'split-ocr',
    'split-portrait',
    'split-low-resolution',
    'split-multi-portrait',
    'split-ocr-with-photos',
    'related-cover',
    'related-ambient',
    'related-hybrid',
  ].map((scenario) => ({ params: { scenario } }));
}

const merged = new Map<number, PreviewEvent>();
for (const event of previewData.events as PreviewEvent[]) merged.set(event.id, event);
for (const event of examplesData.events as PreviewEvent[]) merged.set(event.id, event);
const events = [...merged.values()];
const scenario = scenarios.find((item) => item.slug === Astro.params.scenario);
if (!scenario) throw new Error(`Unknown clean desktop event scenario: ${Astro.params.scenario}`);
const sourceEvent = merged.get(scenario.eventId);
if (!sourceEvent) throw new Error(`Clean desktop event ${scenario.eventId} is missing`);
const thumbnailOverrides = (thumbnailOverridesData.events as Record<string, Record<string, EventImageDerivative[]>>)[String(sourceEvent.id)] || {};
const event:PreviewEvent = {
  ...sourceEvent,
  image_assets:(sourceEvent.image_assets || []).map((asset, sourceIndex) => ({
    ...asset,
    thumbnail_sources:thumbnailOverrides[String(sourceIndex)] || asset.thumbnail_sources,
  })),
};
const preferredRelatedIds = [5658, 6472, 4671, 5259, 5783, 5761, 5382, 5703, 6510, 5370];
const related = preferredRelatedIds.map((id) => merged.get(id)).filter((item): item is PreviewEvent => Boolean(item && item.id !== event.id)).slice(0, 6);
const canonicalUrl = absoluteUrl(`/lab/event-desktop/examples/${scenario.slug}/`);
const title = `${event.title} | ${SITE_NAME}`;
const description = event.meta_description || event.summary || event.title;
---

<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <DesktopEventCleanPage
    event={event}
    related={related}
    candidate={scenario.candidate}
    mediaPolicy={scenario.mediaPolicy}
    transport={scenario.transport}
    heroImageIndex={scenario.heroImageIndex}
    heroWidth={scenario.heroWidth}
    heroHeight={scenario.heroHeight}
    heroObjectPosition={scenario.heroObjectPosition}
    editorialRail={scenario.editorialRail}
    editorialMotion={scenario.editorialMotion}
    editorialCropPolicy={scenario.editorialCropPolicy}
    ocrCompanionImageIndex={scenario.ocrCompanionImageIndex}
    ocrCompanionLayout={scenario.ocrCompanionLayout}
    autoRotate={scenario.autoRotate}
    ocrSafeCover={scenario.ocrSafeCover}
    ocrSourceIndexes={scenario.ocrSourceIndexes}
    duplicateSourceIndexes={scenario.duplicateSourceIndexes}
    splitMediaFit={scenario.splitMediaFit}
    splitPortraitViewer={scenario.splitPortraitViewer}
    splitPortraitSourceIndexes={scenario.splitPortraitSourceIndexes}
    splitViewerHiddenSourceIndexes={scenario.splitViewerHiddenSourceIndexes}
    relatedMediaTreatment={scenario.relatedMediaTreatment}
    mediaRoleOverrides={scenario.mediaRoleOverrides}
    mediaDimensionOverrides={scenario.mediaDimensionOverrides}
  />
</EventLayout>
