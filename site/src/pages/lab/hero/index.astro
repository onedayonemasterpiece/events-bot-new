---
import EventLayout from '../../../layouts/EventLayout.astro';
import EventHero, { type HeroComposition } from '../../../components/EventHero.astro';
import { absoluteUrl, getEvents, SITE_NAME, withBase } from '../../../lib/events';

const events = getEvents();
const compositions: Array<{ composition: HeroComposition; label: string; note: string }> = [
  {
    composition: 'poster-billboard',
    label: 'A · Poster Billboard',
    note: 'Default-кандидат для OCR/unknown: первое — full-bleed hero slab на 100vw, полный постер без crop, decision card слегка приклеен снизу.',
  },
  {
    composition: 'poster-attached-card',
    label: 'B · Poster Attached Card',
    note: 'Более смелый overlap: карточка решения сильнее наезжает на нижнюю safe-зону slab, но не на текст афиши.',
  },
  {
    composition: 'photo-cinematic-sheet',
    label: 'C · Photo Cinematic Sheet',
    note: 'Для visual_only: крупный 100vw cover-визуал и sheet с H1/CTA, без H1 поверх картинки.',
  },
  {
    composition: 'photo-parallax-sheet',
    label: 'D · Photo Parallax Sheet',
    note: 'Эксперимент для visual_only: тот же sheet, но с мягким parallax после активации JS и выключением по prefers-reduced-motion.',
  },
  {
    composition: 'compact-ticketing',
    label: 'E · Compact Ticketing fallback',
    note: 'Устойчивый fallback для плохих/отсутствующих картинок, очень длинных H1 и маленьких экранов.',
  },
];
const title = `Hero lab | ${SITE_NAME}`;
const description = 'Preview hero composition lab for static event pages: billboard, attached-card, cinematic, parallax and compact variants.';
const canonicalUrl = absoluteUrl('/lab/hero/');
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main">
    <div class="page-shell">
      <section class="section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Hero lab</p>
          <h1>Hero страницы события</h1>
          <p class="lead">Лаборатория noindex preview: сравниваем именно <strong>композиции первого экрана</strong>, а не только image policy. Image policy остаётся deterministic: OCR/unknown не режем, visual_only можно cover-кропить, H1 и CTA остаются HTML.</p>
          <div class="source-links">
            <a href={withBase('/__preview/')}>Preview index</a>
            <a href={withBase('/sobytiya/pesni-sssr-svetlogorsk-5878/')}>Control event</a>
            <a href={withBase('/sobytiya/den-valyaniya-v-sene-romanovo-6322/')}>Photo sheet event</a>
            <a href={withBase('/lab/hero/review/')}>Viewport review</a>
          </div>
        </div>
      </section>

      {compositions.map(({ composition, label, note }) => (
        <section class="section-card" style="margin-top: 1rem;">
          <div class="section-card__inner">
            <h2>{label}</h2>
            <p class="muted-note">{note} В lab заголовки внутри hero рендерятся как h3, чтобы на странице был один H1. На каждом событии media-mode всё равно берётся из `image_text_mode`, а не подгоняется под композицию.</p>
            <div class="hero-lab-grid">
              {events.map((event) => (
                <article class="hero-lab-item" data-hero-lab-item data-event-id={event.id}>
                  <EventHero event={event} composition={composition} headingTag="h3" />
                  <div class="hero-lab-item__meta">
                    <strong>#{event.id}</strong>
                    <span>{event.image_text_mode} · {event.event_type || 'событие'}</span>
                    <a href={withBase(`/sobytiya/${event.slug}/`)}>Открыть страницу события</a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>
</EventLayout>
