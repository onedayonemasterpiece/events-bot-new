---
import EventLayout from '../../../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, SITE_NAME, withBase } from '../../../../lib/events';

const events = getEvents();
const reviewItems = [
  { eventId: 5878, variant: 'A · Poster Billboard', note: 'OCR/poster default: 100vw slab, no crop, title/CTA sheet attached below.' },
  { eventId: 4913, variant: 'B · Poster Attached Card', note: 'Smarter overlap over safe slab area; still no overlay H1 on poster text.' },
  { eventId: 6322, variant: 'C · Photo Cinematic Sheet', note: 'visual_only: full-bleed cover, title/CTA sheet overlaps lower edge.' },
  { eventId: 5370, variant: 'D · Photo Parallax Sheet', note: 'visual_only experiment with progressive parallax and reduced-motion guard.' },
];
const cards = reviewItems
  .map((item) => ({ ...item, event: events.find((event) => event.id === item.eventId) }))
  .filter((item) => item.event);
const title = `Hero viewport review | ${SITE_NAME}`;
const description = 'Public noindex viewport review page for strong mobile event hero variants.';
const canonicalUrl = absoluteUrl('/lab/hero/review/');
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main">
    <div class="page-shell">
      <section class="section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Hero viewport review</p>
          <h1>Mobile hero variants</h1>
          <p class="lead">Публичная noindex-страница для внешнего ревью: внутри iframe показаны реальные event pages в мобильном viewport 390×844. Это не PNG-скриншоты, а живой HTML, чтобы можно было открыть событие, проверить H1/CTA/share/calendar и скролл.</p>
          <div class="source-links">
            <a href={withBase('/lab/hero/')}>Composition lab</a>
            <a href={withBase('/__preview/')}>Preview index</a>
          </div>
        </div>
      </section>

      <section class="hero-review-grid" aria-label="Сравнение mobile hero вариантов">
        {cards.map(({ event, variant, note }) => event && (
          <article class="section-card hero-review-card">
            <div class="section-card__inner">
              <p class="eyebrow">{variant}</p>
              <h2>{event.title}</h2>
              <p class="muted-note">#{event.id} · {event.image_text_mode} · {note}</p>
              <p class="source-links"><a href={withBase(`/sobytiya/${event.slug}/`)}>Открыть full page</a></p>
              <div class="hero-phone-frame" aria-label={`Viewport 390 на 844: ${event.title}`}>
                <iframe src={withBase(`/sobytiya/${event.slug}/`)} title={`${variant}: ${event.title}`}></iframe>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>
</EventLayout>
