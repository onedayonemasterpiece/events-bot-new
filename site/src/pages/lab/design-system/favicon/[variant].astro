---
import { withBase } from '../../../../lib/events';

type Props = {
  asset: string;
  label: string;
  shortLabel: string;
  description: string;
  verdict: string;
};

export function getStaticPaths() {
  return [
    {
      params: { variant: 'tag-o' },
      props: {
        asset: '/brand/favicon-tag-wide-o.svg',
        label: 'Финал: бирка + нижняя широкая «о»',
        shortLabel: 'Финальный favicon',
        description: 'Буква стоит в утверждённом оптическом центре y=36: ниже геометрической середины, но выше прежней слишком низкой позиции.',
        verdict: 'Утверждено: знак связывает favicon с леттерингом «Анонсы», остаётся резким и узнаваемым в 16 px.',
      },
    },
    {
      params: { variant: 'tag-only' },
      props: {
        asset: '/brand/favicon-tag-only.svg',
        label: 'Отклонённый контроль: бирка без буквы',
        shortLabel: 'Отклонённый favicon',
        description: 'Остаётся только фирменный терракотовый силуэт: квадратный верх, прозрачные боковые поля и скруглённый низ.',
        verdict: 'Отклонено: в 16 px знак слишком похож на универсальную закладку или простой цветной блок.',
      },
    },
  ];
}

const { asset, label, shortLabel, description, verdict } = Astro.props as Props;
const sizes = [16, 32, 64, 128] as const;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{shortLabel} — дизайн-система</title>
    <link rel="icon" href={withBase(asset)} type="image/svg+xml" sizes="any" />
    <style>
      :root { font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#251d18; background:#f4ece1; }
      * { box-sizing:border-box; }
      body { margin:0; background:radial-gradient(circle at 5% 0,rgba(152,64,31,.13),transparent 32rem),#f4ece1; }
      main { width:min(1040px,calc(100% - 32px)); margin:0 auto; padding:clamp(3rem,8vw,6rem) 0; }
      .eyebrow { margin:0 0 .7rem; color:#98401f; font-size:.74rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
      h1 { max-width:13ch; margin:0; font-size:clamp(3rem,8vw,6.8rem); line-height:.88; letter-spacing:-.065em; }
      .lead { max-width:65ch; margin:1.2rem 0 0; color:#695d54; font-size:1.1rem; line-height:1.55; }
      .browser { margin-top:2.5rem; overflow:hidden; border:1px solid #cfcbc4; border-radius:16px; background:#f1f0ed; box-shadow:0 18px 38px rgba(58,43,32,.1); }
      .tab { width:min(360px,82%); min-height:48px; display:flex; align-items:center; gap:10px; padding:8px 14px; border-radius:14px 14px 0 0; background:#fff; font-size:.84rem; }
      .tab img { width:20px; height:20px; }
      .browser-body { min-height:150px; display:grid; place-items:center; border-top:1px solid #ddd9d2; background:#fffaf2; color:#786d65; text-align:center; padding:1rem; }
      .sizes { display:flex; flex-wrap:wrap; align-items:flex-end; gap:clamp(1.5rem,6vw,4.5rem); margin-top:1rem; padding:2rem; border-radius:20px; background-color:#e7ded3; background-image:linear-gradient(45deg,#f8f2e9 25%,transparent 25%),linear-gradient(-45deg,#f8f2e9 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#f8f2e9 75%),linear-gradient(-45deg,transparent 75%,#f8f2e9 75%); background-size:20px 20px; background-position:0 0,0 10px,10px -10px,-10px 0; }
      .size { display:grid; justify-items:center; gap:.6rem; color:#5f534b; font-size:.72rem; font-weight:850; }
      .size img { width:var(--icon-size); height:var(--icon-size); display:block; }
      .verdict { max-width:65ch; margin:1rem 0 0; padding:1rem 1.15rem; border-left:4px solid #98401f; background:#fffaf2; line-height:1.5; }
      .back { min-height:44px; display:inline-flex; align-items:center; margin-top:2.5rem; color:#793014; font-weight:850; text-underline-offset:.25em; }
    </style>
  </head>
  <body>
    <main data-favicon-choice-page={asset}>
      <p class="eyebrow">favicon review · установлен на этой странице</p>
      <h1>{label}</h1>
      <p class="lead">{description}</p>
      <div class="browser" data-favicon-browser-preview><div class="tab"><img src={withBase(asset)} alt="" />Полюбить Калининград Анонсы</div><div class="browser-body">Посмотрите также на настоящий favicon этой вкладки браузера</div></div>
      <div class="sizes" aria-label="Проверка favicon на прозрачном фоне">
        {sizes.map((size) => <div class="size"><img src={withBase(asset)} alt="" style={`--icon-size:${size}px`} /><span>{size}px</span></div>)}
      </div>
      <p class="verdict">{verdict}</p>
      <a class="back" href={withBase('/lab/design-system/')}>← Сравнить оба варианта</a>
    </main>
  </body>
</html>
