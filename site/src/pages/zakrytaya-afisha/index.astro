---
import FocusLabBadge from '../../components/FocusLabBadge.astro';
import FocusGroupFeedback from '../../components/FocusGroupFeedback.astro';
import FocusGroupInviteShare from '../../components/FocusGroupInviteShare.astro';
import FocusGroupThankYou from '../../components/FocusGroupThankYou.astro';
import StaticSiteAuthRuntime from '../../components/auth/StaticSiteAuthRuntime.astro';
import PersonalizationRuntime from '../../components/personalization/PersonalizationRuntime.astro';
import { absoluteUrl, IS_SECRET_CANDIDATE, withBase } from '../../lib/events';
import '../../styles/design-system.css';

const sections = [
  ['/segodnya/', 'Сегодня', 'Быстро выбрать событие на сегодня'],
  ['/vyhodnye/', 'Выходные', 'Спланировать ближайшие выходные'],
  ['/populyarnoe/', 'Популярное', 'Посмотреть события с заметным интересом'],
  ['/poisk/', 'Поиск', 'Проверить поиск и готовые сценарии'],
  ['/dlya-menya/', 'Для меня', 'Настроить честный локальный прототип'],
  ['/festivali/', 'Фестивали', 'Открыть календарь больших программ'],
  ['/fokus-gruppa/kollektsiya/', 'Коллекция', 'Проверить пасхалки и условие третьего события'],
] as const;
const robots = IS_SECRET_CANDIDATE
  ? 'noindex,nofollow,noarchive,nosnippet'
  : 'noindex,nofollow,noarchive';

---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={absoluteUrl('/zakrytaya-afisha/')} />
    <title>Закрытая афиша · продуктовый прототип</title>
    <meta name="description" content="Предварительная оболочка текущего сайта для проверки механик фокус-группы." />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <meta name="theme-color" content="#fff7e7" />
  </head>
  <body>
    <PersonalizationRuntime />
    <a class="focus-secret__skip" href="#main">К основному содержанию</a>
    <main
      id="main"
      class="focus-secret"
      data-ds-family="ClosedFocusHubRouteComposition"
      data-ds-version="1"
      data-ds-variant="participant-hub"
      data-ds-state="checking"
      data-focus-secret
      data-root-href={withBase('/')}
    >
      <section class="focus-secret__gate" data-secret-checking aria-live="polite">
        <span class="focus-secret__spinner" aria-hidden="true"></span>
        <h1>Проверяем участие на устройстве</h1>
        <p>Это локальная UX-проверка, а не проверка авторизации.</p>
      </section>

      <section class="focus-secret__gate focus-secret__gate--locked" data-secret-locked hidden>
        <FocusLabBadge label="Лаборатория сайта" detail="Закрытый hub · прототип" />
        <p class="focus-secret__eyebrow">Нужен маршрут приглашения</p>
        <h1>В этом браузере нет метки текущего периода</h1>
        <p>
          После вступления локальная метка даёт 30 дней возврата в PWA и не
          зависит от персонализации. Если её нет, снова откройте исходное
          приглашение. Метка не заменяет identity, сессию или server membership;
          после очистки данных браузера восстановление потребует будущего
          подтверждённого аккаунта.
        </p>
        <div class="focus-secret__gate-actions">
          <a class="ke-button ke-button--primary" href={withBase('/fokus-gruppa/')}>О программе</a>
          <a class="ke-button ke-button--secondary" href={withBase('/')}>На стартовый экран</a>
        </div>
      </section>

      <div class="focus-secret__hub" data-secret-hub hidden>
        <header class="focus-secret__header">
          <a class="focus-secret__brand" href={withBase('/zakrytaya-afisha/')}>
            <img src={withBase('/favicon.svg')} width="48" height="48" alt="" />
            <span><strong>Полюбить Калининград</strong><small>Закрытая афиша · hub</small></span>
          </a>
          <div class="focus-secret__header-actions">
            <FocusLabBadge label="Участник лаборатории" detail="Локальный прототип" />
            <button class="focus-secret__leave" type="button" data-secret-clear>Выйти из фокус-группы</button>
          </div>
        </header>

        <section class="focus-secret__account" aria-labelledby="focus-account-title">
          <div>
            <p class="focus-secret__eyebrow">Независимые состояния</p>
            <h2 id="focus-account-title">Аккаунт и участие — не одно и то же</h2>
            <p>
              Выход из аккаунта завершает Supabase-сессию, но сохраняет
              30-дневное участие. Только кнопка «Выйти из фокус-группы»
              удаляет локальную метку участия; настройки «Для меня» она не стирает.
            </p>
          </div>
          <div class="focus-secret__account-actions">
            <div data-static-auth-signed-out>
              <span>Аккаунт не подключён.</span>
              <button class="ke-button ke-button--primary" type="button" data-static-auth-login>
                Войти через Яндекс
              </button>
            </div>
            <div data-static-auth-signed-in hidden>
              <span>Аккаунт: <strong data-static-auth-name>Аккаунт</strong></span>
              <button class="ke-button ke-button--secondary" type="button" data-static-auth-logout hidden>
                Выйти из аккаунта
              </button>
            </div>
            <p data-static-auth-status role="status" aria-live="polite" aria-atomic="true"></p>
          </div>
        </section>

        <section class="focus-secret__hero">
          <div>
            <p class="focus-secret__eyebrow">Текущий сайт · секретный вход для приёмки</p>
            <h1>Куда пойдём проверять афишу?</h1>
          </div>
          <div class="focus-secret__hero-copy">
            <p>
              Выбирайте настоящий сценарий: план на сегодня, выходные, поиск,
              фестиваль или локальный прототип «Для меня».
            </p>
            <div class="focus-secret__truth">
              <strong>Hub не защищает и не переносит весь сайт под префикс.</strong>
              <span>
                В этой single-build демонстрации карточки ведут на существующие
                страницы. Для реального закрытого candidate нужен отдельный
                noindex build и server-side privilege checks.
              </span>
            </div>
          </div>
        </section>

        <nav class="focus-secret__directory" aria-label="Разделы текущей афиши">
          {sections.map(([href, label, note], index) => (
            <a href={withBase(href)}>
              <span class="focus-secret__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span><strong>{label}</strong><small>{note}</small></span>
              <span class="focus-secret__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>

        <section class="focus-secret__research-note">
          <div>
            <p class="focus-secret__eyebrow">Перед первой оценкой</p>
            <h2>Сначала сделайте что-нибудь полезное</h2>
          </div>
          <p>
            Автоматический prompt не должен появляться на первом paint. В
            production usefulness спрашивается после meaningful use, не чаще
            одного раза на page family за 7 дней и максимум два auto-prompt в сутки.
          </p>
        </section>

        <FocusGroupFeedback
          pageFamily="home"
          pageLabel="главная оболочка"
          overallNpsDue
          showEventIssue
          eventLabel="Specimen: карточка события без подключения production данных"
        />

        <FocusGroupInviteShare />
        <FocusGroupThankYou compact />

        <footer class="focus-secret__footer">
          <span>Предварительный продуктовый макет · noindex / no-referrer</span>
          <span>
            <a href={withBase('/fokus-gruppa/zavershenie/')}>Макет завершения</a>
            · <a href="mailto:info@kenigevents.ru">info@kenigevents.ru</a>
          </span>
        </footer>
      </div>

      <noscript>
        <section class="focus-secret__no-script">
          Для этой демонстрации локальной метки нужен JavaScript. Обычные
          статические страницы сайта от этой механики не зависят.
        </section>
      </noscript>
    </main>
    <StaticSiteAuthRuntime />
  </body>
</html>

<script>
  import {
    clearFocusParticipationMarker,
    readFocusParticipationMarker,
  } from '../../lib/focus-group-prototype';

  document.querySelectorAll<HTMLElement>('[data-focus-secret]').forEach((root) => {
    const checking = root.querySelector<HTMLElement>('[data-secret-checking]');
    const locked = root.querySelector<HTMLElement>('[data-secret-locked]');
    const hub = root.querySelector<HTMLElement>('[data-secret-hub]');
    let focusStorage: Storage | null = null;
    try {
      focusStorage = window.localStorage;
    } catch {
      focusStorage = null;
    }
    const marker = focusStorage ? readFocusParticipationMarker(focusStorage) : null;

    if (checking) checking.hidden = true;
    root.dataset.dsState = marker?.status === 'active' ? 'available' : 'locked';
    if (marker?.status === 'active') {
      if (hub) hub.hidden = false;
      root.dataset.dsState = 'available';
    } else if (locked) {
      locked.hidden = false;
      root.dataset.dsState = 'locked';
    }

    root.querySelector<HTMLButtonElement>('[data-secret-clear]')?.addEventListener('click', () => {
      if (focusStorage) clearFocusParticipationMarker(focusStorage);
      window.location.assign(root.dataset.rootHref || '/');
    });
  });
</script>

<style>
  * { box-sizing: border-box; }
  html { background: var(--ke-color-canvas); color: var(--ke-color-ink); font-family: var(--ke-font-sans); }
  body { min-width: 320px; min-height: 100dvh; margin: 0; background: radial-gradient(circle at 92% 0, rgb(255 193 13 / 14%), transparent 30rem), var(--ke-color-canvas); }
  .focus-secret { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 1rem 0 2rem; }
  .focus-secret__skip { position: fixed; z-index: 50; top: .5rem; left: .5rem; transform: translateY(-150%); border-radius: .5rem; padding: .7rem 1rem; background: #221a14; color: #fff; font-weight: 800; }
  .focus-secret__skip:focus { transform: none; }
  .focus-secret__gate { min-height: calc(100dvh - 2rem); display: grid; place-items: center; align-content: center; gap: .8rem; border: 1px solid var(--ke-color-line); border-radius: 2rem; padding: clamp(1.5rem, 5vw, 4rem); background: var(--ke-color-surface-strong); text-align: center; box-shadow: var(--ke-shadow-2); }
  .focus-secret__gate[hidden],
  .focus-secret__hub[hidden] { display: none; }
  .focus-secret__gate h1 { max-width: 15ch; margin: 0; font-size: clamp(2.3rem, 7vw, 5.5rem); line-height: .95; letter-spacing: -.055em; }
  .focus-secret__gate > p:not(.focus-secret__eyebrow) { max-width: 58ch; margin: 0; color: var(--ke-color-muted); line-height: 1.55; }
  .focus-secret__gate-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; margin-top: .5rem; }
  .focus-secret__spinner { width: 36px; height: 36px; border: 3px solid var(--ke-color-line); border-right-color: var(--ke-color-brand-600); border-radius: 50%; animation: focus-secret-spin 700ms linear infinite; }
  .focus-secret__hub { display: grid; gap: 1rem; }
  .focus-secret__header { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .focus-secret__brand { min-height: 52px; display: inline-flex; align-items: center; gap: .7rem; color: inherit; text-decoration: none; }
  .focus-secret__brand img { width: 46px; height: 46px; }
  .focus-secret__brand span { display: grid; line-height: 1.05; }
  .focus-secret__brand strong { font-size: .86rem; }
  .focus-secret__brand small { color: var(--ke-color-brand-700); font-size: .72rem; font-weight: 800; }
  .focus-secret__header-actions { display: flex; align-items: center; gap: .65rem; }
  .focus-secret__leave { min-height: 44px; border: 0; padding: .5rem; background: transparent; color: var(--ke-color-muted); font: 800 .75rem/1.2 var(--ke-font-sans); text-decoration: underline; text-underline-offset: .2rem; cursor: pointer; }
  .focus-secret__account {
    display: grid;
    grid-template-columns: minmax(240px, .8fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: center;
    border: 1px solid var(--ke-color-line);
    border-radius: 1.25rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--ke-color-surface-strong);
  }
  .focus-secret__account h2 { margin: 0 0 .45rem; font-size: clamp(1.4rem, 3vw, 2rem); }
  .focus-secret__account > div > p:last-child { margin: 0; color: var(--ke-color-muted); font-size: .86rem; line-height: 1.5; }
  .focus-secret__account-actions { display: grid; gap: .5rem; }
  .focus-secret__account-actions > div { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .focus-secret__account-actions > div[hidden] { display: none; }
  .focus-secret__account-actions span { min-width: 0; overflow-wrap: anywhere; font-size: .86rem; line-height: 1.4; }
  .focus-secret__account-actions > p { min-height: 1.4em; margin: 0; color: var(--ke-color-muted); font-size: .76rem; line-height: 1.4; }
  .focus-secret__hero { min-height: 560px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(300px, .8fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; border: 1px solid var(--ke-color-line); border-radius: 2rem; padding: clamp(1.4rem, 5vw, 4rem); background: linear-gradient(145deg, #fff, #fff5df); box-shadow: var(--ke-shadow-2); }
  .focus-secret__eyebrow { margin: 0 0 .55rem; color: var(--ke-color-brand-700); font-size: .72rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  .focus-secret__hero h1 { max-width: 11ch; margin: 0; font-size: clamp(3.4rem, 9vw, 8rem); line-height: .84; letter-spacing: -.07em; text-wrap: balance; }
  .focus-secret__hero-copy > p { margin: 0; color: var(--ke-color-muted); font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.55; }
  .focus-secret__truth { display: grid; gap: .25rem; margin-top: 1rem; border-radius: 1rem; padding: .9rem 1rem; background: var(--ke-color-info-50); color: var(--ke-color-info-700); line-height: 1.4; }
  .focus-secret__truth span { font-size: .8rem; }
  .focus-secret__directory { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
  .focus-secret__directory a { min-height: 145px; display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: start; border: 1px solid var(--ke-color-line); border-radius: 1.25rem; padding: 1rem; background: var(--ke-color-surface-strong); color: inherit; text-decoration: none; box-shadow: var(--ke-shadow-1); transition: transform var(--ke-duration-fast), border-color var(--ke-duration-fast); }
  .focus-secret__directory a:hover { transform: translateY(-2px); border-color: var(--ke-color-brand-600); }
  .focus-secret__directory a:focus-visible,
  .focus-secret__account button:focus-visible,
  .focus-secret__leave:focus-visible { outline: 3px solid color-mix(in srgb, var(--ke-color-focus) 60%, transparent); outline-offset: 3px; }
  .focus-secret__directory a > span:nth-child(2) { display: grid; gap: .35rem; }
  .focus-secret__directory strong { font-size: 1.1rem; }
  .focus-secret__directory small { color: var(--ke-color-muted); line-height: 1.4; }
  .focus-secret__index { color: var(--ke-color-brand-600); font-size: .68rem; font-weight: 900; letter-spacing: .08em; }
  .focus-secret__arrow { color: var(--ke-color-brand-600); font-size: 1.2rem; }
  .focus-secret__research-note { display: grid; grid-template-columns: minmax(220px, .6fr) minmax(0, 1.4fr); gap: 2rem; border: 1px solid var(--ke-color-line); border-radius: 1.5rem; padding: clamp(1.15rem, 3vw, 2rem); background: var(--ke-color-surface-strong); }
  .focus-secret__research-note h2 { margin: 0; font-size: clamp(1.5rem, 4vw, 2.6rem); line-height: 1; letter-spacing: -.04em; }
  .focus-secret__research-note > p { margin: 0; color: var(--ke-color-muted); line-height: 1.55; }
  .focus-secret__footer { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem .25rem 0; color: var(--ke-color-muted); font-size: .78rem; }
  .focus-secret__footer a { color: var(--ke-color-brand-700); font-weight: 850; }
  .focus-secret__no-script { margin: 1rem; border-radius: 1rem; padding: 1rem; background: var(--ke-color-warning-50); color: var(--ke-color-warning-800); line-height: 1.5; }
  @keyframes focus-secret-spin { to { transform: rotate(360deg); } }

  @media (max-width: 820px) {
    .focus-secret { width: min(100% - 1rem, 1180px); padding-top: .5rem; }
    .focus-secret__header { align-items: flex-start; }
    .focus-secret__brand span { display: none; }
    .focus-secret__header-actions { align-items: flex-end; flex-direction: column; }
    .focus-secret__account { grid-template-columns: 1fr; }
    .focus-secret__hero { grid-template-columns: 1fr; min-height: calc(100dvh - 6rem); align-content: end; }
    .focus-secret__directory { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .focus-secret__research-note { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .focus-secret__account-actions > div { align-items: stretch; flex-direction: column; }
    .focus-secret__account-actions .ke-button { width: 100%; }
    .focus-secret__directory { grid-template-columns: 1fr; }
    .focus-secret__directory a { min-height: 116px; }
    .focus-secret__leave { max-width: 150px; }
    .focus-secret__footer { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .focus-secret__spinner { animation: none; }
    .focus-secret__directory a { transition: none; }
  }
</style>
