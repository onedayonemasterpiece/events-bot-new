---
import FavoritesSurface from '../../components/FavoritesSurface.astro';
import EventLayout from '../../layouts/EventLayout.astro';
import { absoluteUrl, SITE_NAME } from '../../lib/events';

const title = `Избранное | ${SITE_NAME}`;
const description = 'Личная noindex-страница будущих событий: добавленные в календарь и понравившиеся, без повторов.';
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={absoluteUrl('/izbrannoe/')}
  structuredData={[]}
  mobileSection="personal"
  noindex
>
  <main
    id="main"
    data-ds-family="FavoritesRouteComposition"
    data-ds-version="1"
    data-ds-variant="saved-future-events"
    data-ds-state="runtime-pending"
    data-favorites-page
  >
    <FavoritesSurface />
  </main>
  <script>
    const page = document.querySelector('[data-favorites-page]');
    const surface = page?.querySelector('[data-favorites-surface]');
    if (page instanceof HTMLElement && surface instanceof HTMLElement) {
      const sync = () => {
        const localState = surface.dataset.favoritesState || 'loading';
        const cloudState = surface.dataset.favoritesCloudState || 'idle';
        page.dataset.dsState = `${localState.replaceAll('_', '-')} cloud-${cloudState.replaceAll('_', '-')}`;
      };
      new MutationObserver(sync).observe(surface, {
        attributes:true,
        attributeFilter:['data-favorites-state', 'data-favorites-cloud-state'],
      });
      sync();
    }
  </script>
</EventLayout>
