---
import EventLayout from '../../layouts/EventLayout.astro';
import DateListingSurface from '../../components/listings/DateListingSurface.astro';
import PersonalFeedSlot from '../../components/PersonalFeedSlot.astro';
import { absoluteUrl, getCurrentDate, getPreviewBuild, getTodayPrimaryEvents, SITE_NAME } from '../../lib/events';

const currentDate = getCurrentDate();
const events = getTodayPrimaryEvents();
const dateLabel = new Intl.DateTimeFormat('ru-RU', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Kaliningrad' })
  .format(new Date(`${currentDate}T12:00:00+02:00`));
---
<EventLayout title={`События сегодня в Калининграде | ${SITE_NAME}`} description={`События сегодня, ${dateLabel}, сгруппированные по времени начала.`} canonicalUrl={absoluteUrl('/segodnya/')} structuredData={[]} headerCurrent="today">
  <main id="main" class="ke-listing-page">
    <DateListingSurface kind="today" title="Сегодня" date={currentDate} dateLabel={dateLabel} events={events} generatedAt={getPreviewBuild().generated_at} />
    <div class="ke-listing-shell"><PersonalFeedSlot context="today" /></div>
  </main>
</EventLayout>
