---
import EventLayout from '../../layouts/EventLayout.astro';
import UnusualListingSurface from '../../components/UnusualListingSurface.astro';
import { absoluteUrl, SITE_NAME } from '../../lib/events';
import { getUnusualFeed } from '../../lib/unusualEvents';

const feed = getUnusualFeed();
const title = `Необычные события Калининградской области | ${SITE_NAME}`;
const description = 'Проверенная статическая подборка событий с необычным форматом, местом или сочетанием впечатлений.';
---
<EventLayout
  title={title}
  description={description}
  canonicalUrl={absoluteUrl('/neobychnoe/')}
  structuredData={[]}
  headerCurrent="unusual"
  mobileSection="afisha"
  noindex
>
  <UnusualListingSurface feed={feed} />
</EventLayout>
