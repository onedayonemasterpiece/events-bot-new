---
import EventLayout from '../../layouts/EventLayout.astro';
import infoPartnerGroups from '../../data/infoPartners.json';
import { absoluteUrl, SITE_NAME, withBase } from '../../lib/events';

interface InfoPartner {
  id: string;
  name: string;
  mark?: string;
  shortLabel?: string;
  logoUrl?: string;
  href?: string;
  shape?: 'square' | 'normal' | 'wide';
  span?: number;
  tone?: string;
  description?: string;
}

interface InfoPartnerGroup {
  id: string;
  title: string;
  note?: string;
  partners: InfoPartner[];
}

const groups = infoPartnerGroups as InfoPartnerGroup[];
const canonicalUrl = absoluteUrl('/partnerstvo/');
const title = `Информационное партнёрство | ${SITE_NAME}`;
const description = 'MVP-блок информационных партнёров для статического сайта KenigEvents: компактная сетка логотипов, бейджи и короткие подписи для разных форматов медиа-партнёров.';
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main">
    <div class="page-shell partnership-page">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        <span>Партнёрство</span>
      </nav>

      <section class="section-card partnership-hero">
        <div class="section-card__inner partnership-hero__inner">
          <div>
            <p class="eyebrow">Для организаторов и медиа</p>
            <h1>Информационное партнёрство</h1>
            <p class="lead">Короткий MVP для страницы партнёров: логотипы остаются узнаваемыми, но собираются в аккуратные компактные бейджи, а не в рыхлый пресс-волл.</p>
          </div>
          <div class="partnership-hero__cta">
            <a class="cta-button" href="mailto:info@kenigevents.ru?subject=Информационное%20партнёрство">Написать на info@kenigevents.ru</a>
            <a href={withBase('/__preview/')}>Смотреть афишу</a>
          </div>
        </div>
      </section>

      <section class="section-card info-partners-section" aria-labelledby="info-partners-title">
        <div class="section-card__inner">
          <div class="info-partners-section__head">
            <p class="eyebrow">MVP блока</p>
            <h2 id="info-partners-title">Информационные партнёры</h2>
            <p class="muted-note">Демо-набор ниже не заявляет реальных партнёров: он проверяет сетку для будущих официальных логотипов — квадратных, обычных и очень широких. После согласования партнёров текстовые демо-знаки заменяются на официальные SVG/PNG/WebP.</p>
          </div>

          <div class="info-partner-groups">
            {groups.map((group) => (
              <section class="info-partner-group" aria-labelledby={`info-partner-group-${group.id}`}>
                <div class="info-partner-group__head">
                  <h3 id={`info-partner-group-${group.id}`}>{group.title}</h3>
                  {group.note && <p>{group.note}</p>}
                </div>
                <div class="info-partner-grid">
                  {group.partners.map((partner) => {
                    const span = partner.span === 2 ? ' info-partner-card--span-2' : '';
                    const shape = partner.shape ? ` info-partner-card--${partner.shape}` : '';
                    const tone = partner.tone ? ` info-partner-card--tone-${partner.tone}` : '';
                    const className = `info-partner-card${span}${shape}${tone}`;
                    const content = (
                      <>
                        <span class="info-partner-card__logo" aria-hidden={partner.logoUrl ? undefined : 'true'}>
                          {partner.logoUrl ? (
                            <img src={withBase(partner.logoUrl)} alt={partner.name} loading="lazy" decoding="async" />
                          ) : (
                            <span class="info-partner-card__mockmark">{partner.mark || partner.name}</span>
                          )}
                        </span>
                        {partner.shortLabel && <span class="info-partner-card__label">{partner.shortLabel}</span>}
                      </>
                    );
                    return partner.href ? (
                      <a class={className} href={partner.href} target="_blank" rel="noopener noreferrer" aria-label={`${partner.name}${partner.shortLabel ? `, ${partner.shortLabel}` : ''}`} title={partner.description || partner.name}>
                        {content}
                      </a>
                    ) : (
                      <div class={className} role="img" aria-label={`${partner.name}${partner.shortLabel ? `, ${partner.shortLabel}` : ''}`} title={partner.description || partner.name}>
                        {content}
                      </div>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .partnership-page { padding-bottom: clamp(2rem, 5vw, 4rem); }
  .partnership-hero { margin-bottom: 1rem; }
  .partnership-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1rem, 3vw, 2rem); align-items: end; }
  .partnership-hero h1, .info-partners-section h2 { margin: 0; line-height: 1.04; letter-spacing: -0.04em; }
  .partnership-hero .lead { max-width: 48rem; }
  .partnership-hero__cta { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; justify-content: flex-end; }
  .partnership-hero__cta a:not(.cta-button) { min-height: 44px; display: inline-flex; align-items: center; color: var(--primary-strong); font-weight: 780; }

  .info-partners-section__head { max-width: 56rem; margin-bottom: clamp(1rem, 2.6vw, 1.5rem); }
  .info-partner-groups { display: grid; gap: clamp(1rem, 3vw, 1.6rem); }
  .info-partner-group { display: grid; gap: 0.75rem; }
  .info-partner-group__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.45rem 0.8rem; }
  .info-partner-group__head h3 { margin: 0; font-size: clamp(1rem, 2.2vw, 1.16rem); letter-spacing: -0.02em; }
  .info-partner-group__head p { margin: 0; color: var(--muted); font-size: 0.94rem; }

  .info-partner-grid {
    --partner-cell-min: 8.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--partner-cell-min)), 1fr));
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 1.6vw, 0.72rem);
  }
  .info-partner-card {
    min-height: 4.7rem;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.22rem;
    padding: 0.68rem 0.78rem;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 253, 248, 0.78)),
      radial-gradient(circle at 20% 0%, rgba(165, 72, 33, 0.09), transparent 50%);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 10px 28px rgba(72, 45, 25, 0.07);
    overflow: hidden;
  }
  .info-partner-card--span-2 { grid-column: span 2; }
  .info-partner-card__logo {
    width: 100%;
    min-height: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .info-partner-card__logo img { width: 100%; max-height: 2.65rem; object-fit: contain; }
  .info-partner-card__mockmark {
    max-width: 100%;
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 910;
    font-size: clamp(1.05rem, 2.5vw, 1.46rem);
    line-height: 1;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .info-partner-card--wide .info-partner-card__mockmark { font-size: clamp(1rem, 2.2vw, 1.34rem); letter-spacing: -0.045em; }
  .info-partner-card--square { aspect-ratio: 1.28 / 1; }
  .info-partner-card--square .info-partner-card__mockmark { font-size: clamp(1.35rem, 3vw, 1.72rem); }
  .info-partner-card__label { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 0.72rem; font-weight: 760; line-height: 1.1; letter-spacing: 0.02em; text-transform: lowercase; }

  .info-partner-card--tone-blue { color: #0f4a72; }
  .info-partner-card--tone-violet { color: #4d2a86; }
  .info-partner-card--tone-ink { color: #171717; }
  .info-partner-card--tone-teal { color: #0f766e; }
  .info-partner-card--tone-sand { color: #835b1f; }
  .info-partner-card--tone-red { color: #b42318; }
  .info-partner-card--tone-green { color: #3f7d20; }
  .info-partner-card:is(a):hover { border-color: rgba(165, 72, 33, 0.28); background: #fff; transform: translateY(-1px); }

  @media (max-width: 640px) {
    .partnership-hero__inner { grid-template-columns: 1fr; }
    .partnership-hero__cta { justify-content: flex-start; }
    .info-partner-grid { --partner-cell-min: 7.2rem; gap: 0.48rem; }
    .info-partner-card { min-height: 4.25rem; border-radius: 15px; padding: 0.58rem 0.62rem; }
    .info-partner-card--span-2 { grid-column: span 2; }
    .info-partner-card__label { font-size: 0.68rem; }
  }

  @media (max-width: 420px) {
    .info-partner-card--span-2 { grid-column: 1 / -1; }
  }
</style>
