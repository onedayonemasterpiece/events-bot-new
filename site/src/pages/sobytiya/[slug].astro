---
import EventLayout from '../../layouts/EventLayout.astro';
import EventHero, { type HeroComposition } from '../../components/EventHero.astro';
import EventFacts from '../../components/EventFacts.astro';
import EventTokenMedallions from '../../components/EventTokenMedallions.astro';
import EventCtaPanel from '../../components/EventCtaPanel.astro';
import EventIssueReport from '../../components/EventIssueReport.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import PersonalFeedSlot from '../../components/PersonalFeedSlot.astro';
import { buildBreadcrumbJsonLd, buildEventJsonLd, eventTitle } from '../../lib/seo';
import { eventImageUrl } from '../../lib/assets';
import { displayDateTime, displayUpdatedAtKaliningrad, eventAbsoluteUrl, eventActionHref, eventCalendarHref, eventHref, eventTicketActionLabel, getEventBySlug, getEvents, getOtherDates, eventDetailRelatedAlgorithmId, getPreloadedDiscoveryEvents, isCalendarEligible, isTelephoneUrl, withBase } from '../../lib/events';

type FeedCardVariant = 'split-actions';
const HERO_COMPOSITION_BY_EVENT_ID: Record<number, HeroComposition> = {
  5878: 'poster-billboard',
  6322: 'photo-cinematic-sheet',
  4913: 'poster-attached-card',
  5370: 'photo-parallax-sheet',
  4512: 'photo-parallax-sheet',
};
const feedCardVariant: FeedCardVariant = 'split-actions';

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { slug: event.slug } }));
}

const event = getEventBySlug(Astro.params.slug ?? '');
if (!event) {
  return Astro.redirect(withBase('/__preview/'));
}
const discoveryFeed = getPreloadedDiscoveryEvents(event, 10);
const discoveryAlgorithmId = eventDetailRelatedAlgorithmId();
const otherDates = getOtherDates(event);
const canonicalUrl = eventAbsoluteUrl(event);
const title = eventTitle(event);
const structuredData = [buildEventJsonLd(event), buildBreadcrumbJsonLd(event)];
const ogImage = eventImageUrl(event.image_url);
const ogImageAsset = event.image_assets?.find((asset) => asset.src === event.image_url) || event.image_assets?.[0];
const ogImageType = ogImage?.toLowerCase().includes('.webp') ? 'image/webp' : ogImage?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : ogImage ? 'image/jpeg' : null;
const ctaHref = eventActionHref(event);
const ctaLabel = eventTicketActionLabel(event);
const stickyDateLabel = displayDateTime(event);
const stickyCalendarPrimary = isCalendarEligible(event) && (!ctaHref || event.ticket.kind === 'free');
const stickyHref = stickyCalendarPrimary ? eventCalendarHref(event) : ctaHref;
const stickyLabel = stickyCalendarPrimary ? 'В календарь' : ctaLabel;
const stickyIsExternal = Boolean(stickyHref && stickyHref.startsWith('http'));
const stickyIsTelephone = isTelephoneUrl(stickyHref);
const updatedAtLabel = displayUpdatedAtKaliningrad(event.updated_at);
const sourceCount = Number(event.source_engagement_sources_count || 0);
const sourceCountLabel = sourceCount > 0
  ? `${sourceCount} ${sourceCount % 10 === 1 && sourceCount % 100 !== 11 ? 'источник' : [2, 3, 4].includes(sourceCount % 10) && ![12, 13, 14].includes(sourceCount % 100) ? 'источника' : 'источников'}`
  : null;
const descriptionMeta = [sourceCountLabel, updatedAtLabel ? `обновлено: ${updatedAtLabel} (Калининград)` : null].filter(Boolean);
const fallbackHeroComposition: HeroComposition = event.image_url
  ? (event.image_text_mode === 'visual_only' ? 'photo-cinematic-sheet' : 'poster-billboard')
  : 'compact-ticketing';
const heroComposition = HERO_COMPOSITION_BY_EVENT_ID[event.id] || fallbackHeroComposition;
const galleryCtaEvent = discoveryFeed[0];
const galleryCta = galleryCtaEvent ? {
  title: galleryCtaEvent.title,
  href: eventHref(galleryCtaEvent),
  label: 'Смотреть похожее',
  image_url: eventImageUrl(galleryCtaEvent.image_url),
  meta: [displayDateTime(galleryCtaEvent), galleryCtaEvent.venue_name || galleryCtaEvent.city].filter(Boolean).join(' · '),
} : undefined;
---
<EventLayout title={title} description={event.meta_description} canonicalUrl={canonicalUrl} ogImage={ogImage} ogImageType={ogImageType} ogImageWidth={ogImageAsset?.width || null} ogImageHeight={ogImageAsset?.height || null} structuredData={structuredData} heroChrome="immersive">
  <main id="main">
    <div class="page-shell page-shell--event-impact">
      <div class="event-grid">
        <article class="main-col section-card section-card--hero section-card--impact-hero">
          <div class="section-card__inner section-card__inner--hero">
            <EventHero event={event} composition={heroComposition} galleryCta={galleryCta} />
          </div>
        </article>
        <div class="side-col">
          <EventCtaPanel event={event} />
          <EventIssueReport event={event} />
        </div>
      </div>

      <nav class="crumbs crumbs--after-hero" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        {event.city && <a href={withBase(`/__preview/?city=${encodeURIComponent(event.city)}`)}>{event.city}</a>}
        {event.city && <span aria-hidden="true">/</span>}
        {event.event_type && <span>{event.event_type}</span>}
      </nav>

      <EventTokenMedallions event={event} />

      <section class="section-card section-card--quiet section-card--event-details" style="margin-top: 1rem;">
        <div class="section-card__inner">
          <h2>Описание</h2>
          <div class="prose" set:html={event.description_html} />
          <h2 style="margin-top: 1.2rem;">Коротко</h2>
          <EventFacts event={event} />
          {descriptionMeta.length > 0 && <p class="event-description-meta" data-nosnippet>{descriptionMeta.join(' · ')}</p>}
        </div>
        <p class="event-source-gate event-source-gate--section"><Icon name="lock" /> <span>Все источники, упоминания и расширенная статистика события будут доступны зарегистрированным пользователям.</span></p>
      </section>

      {otherDates.length > 0 && (
        <section class="section-card" style="margin-top: 1rem;">
          <div class="section-card__inner">
            <h2>Другие даты</h2>
            <div class="cards-grid cards-grid--immersive">
              {otherDates.map((candidate) => <EventCard event={candidate} label="Другая дата" />)}
            </div>
          </div>
        </section>
      )}

      <section id="discovery-feed" class="section-card" style="margin-top: 1rem;" data-hide-sticky-after>
        <div class="section-card__inner">
          <h2>Смотрите дальше</h2>
          <div
            class="cards-grid cards-grid--immersive"
            data-discovery-feed
            data-surface="event_detail_related"
            data-layout-mode="module"
            data-algorithm-id={discoveryAlgorithmId}
            data-current-event-id={event.id}
            data-discovery-src={withBase(`/data/discovery/${event.id}.json`)}
            data-feed-card-variant={feedCardVariant}
          >
            {discoveryFeed.map((candidate) => <EventCard event={candidate} variant={feedCardVariant} />)}
          </div>
          <button type="button" class="secondary-button discovery-load-more" data-discovery-load-more hidden>Показать ещё</button>
        </div>
      </section>

      <PersonalFeedSlot context="event-detail" />
    </div>
  </main>
  {stickyHref && (
    <div class="mobile-sticky-cta" data-sticky-cta aria-label="Быстрое действие события">
      <div class="mobile-sticky-cta__inner">
        <div class="mobile-sticky-cta__title"><strong>{event.title}</strong><span>{stickyDateLabel}</span></div>
        <a class="cta-button" href={stickyHref} target={stickyIsExternal ? '_blank' : undefined} rel={stickyIsExternal ? 'noopener noreferrer nofollow' : undefined}>{stickyIsTelephone && <Icon name="phone" />}<span>{stickyLabel}</span></a>
      </div>
    </div>
  )}
</EventLayout>
