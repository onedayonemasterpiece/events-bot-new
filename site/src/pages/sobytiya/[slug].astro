---
import EventLayout from '../../layouts/EventLayout.astro';
import DesktopEventPage from '../../components/DesktopEventPage.astro';
import EventHero, { type HeroComposition } from '../../components/EventHero.astro';
import EventFacts from '../../components/EventFacts.astro';
import EventTransportSchedule from '../../components/EventTransportSchedule.astro';
import EventBusTransportSchedule from '../../components/EventBusTransportSchedule.astro';
import KaupTransportSchedule from '../../components/KaupTransportSchedule.astro';
import EventTokenMedallions from '../../components/EventTokenMedallions.astro';
import EventParticipants from '../../components/EventParticipants.astro';
import EventCard from '../../components/EventCard.astro';
import Icon from '../../components/Icon.astro';
import PersonalFeedSlot from '../../components/PersonalFeedSlot.astro';
import MobileEventProductionStyles from '../../components/MobileEventProductionStyles.astro';
import KeyboardEventNavigation from '../../components/KeyboardEventNavigation.astro';
import { buildBreadcrumbJsonLd, buildEventJsonLd, eventTitle } from '../../lib/seo';
import { eventImageUrl } from '../../lib/assets';
import desktopThumbnailOverridesData from '../../data/desktop-event-thumbnail-overrides.json';
import type { EventImageDerivative, PreviewEvent } from '../../lib/types';
import { buildDesktopEventPresentation } from '../../lib/desktopEventPresentation';
import { desktopEventWithExplicitEnd } from '../../lib/desktopEventTransport';
import { IS_PRODUCTION_FAMILY, PREVIEW_BUILD_ID, siteHomeHref, displayDateTime, displayUpdatedAtKaliningrad, eventAbsoluteUrl, eventActionHref, eventCalendarHref, eventCalendarStateExpiryDay, eventHref, eventTicketActionLabel, getEventBySlug, getEvents, getOccurrencePresentation, eventDetailRelatedAlgorithmId, getPreloadedDiscoveryEvents, isEventDetailCalendarEligible, isTelephoneUrl, withBase } from '../../lib/events';

type FeedCardVariant = 'split-actions';
const HERO_COMPOSITION_BY_EVENT_ID: Record<number, HeroComposition> = {
  5878: 'poster-billboard',
  6322: 'photo-cinematic-sheet',
  4913: 'poster-attached-card',
  5370: 'photo-parallax-sheet',
  4512: 'photo-parallax-sheet',
};
const feedCardVariant: FeedCardVariant = 'split-actions';

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { slug: event.slug } }));
}

const event = getEventBySlug(Astro.params.slug ?? '');
if (!event) {
  return Astro.redirect(siteHomeHref());
}
const discoveryFeed = getPreloadedDiscoveryEvents(event, 10);
const desktopDiscoveryFeed = getPreloadedDiscoveryEvents(event, 30);
const discoveryAlgorithmId = eventDetailRelatedAlgorithmId();
const occurrencePresentation = getOccurrencePresentation(event);
const canonicalUrl = eventAbsoluteUrl(event);
const title = eventTitle(event);
const structuredData = [buildEventJsonLd(event), buildBreadcrumbJsonLd(event)];
const ogImage = eventImageUrl(event.image_url);
const ogImageAsset = event.image_assets?.find((asset) => asset.src === event.image_url) || event.image_assets?.[0];
const ogImageType = ogImage?.toLowerCase().includes('.webp') ? 'image/webp' : ogImage?.toLowerCase().match(/\.png(?:[?#]|$)/) ? 'image/png' : ogImage ? 'image/jpeg' : null;
const ctaHref = eventActionHref(event);
const ctaLabel = eventTicketActionLabel(event);
const stickyDateLabel = occurrencePresentation.compactLabel;
const stickyCalendarPrimary = isEventDetailCalendarEligible(event) && (!ctaHref || event.ticket.kind === 'free');
const stickyHref = stickyCalendarPrimary ? eventCalendarHref(event) : ctaHref;
const stickyLabel = stickyCalendarPrimary ? 'Добавить в календарь' : ctaLabel;
const calendarExpiryDay = eventCalendarStateExpiryDay(event);
const stickyIsExternal = Boolean(stickyHref && stickyHref.startsWith('http'));
const stickyIsTelephone = isTelephoneUrl(stickyHref);
const updatedAtLabel = displayUpdatedAtKaliningrad(event.updated_at);
const sourceCount = Number(event.source_engagement_sources_count || 0);
const sourceCountLabel = sourceCount > 0
  ? `${sourceCount} ${sourceCount % 10 === 1 && sourceCount % 100 !== 11 ? 'источник' : [2, 3, 4].includes(sourceCount % 10) && ![12, 13, 14].includes(sourceCount % 100) ? 'источника' : 'источников'}`
  : null;
const descriptionMeta = [sourceCountLabel, updatedAtLabel ? `обновлено: ${updatedAtLabel} (Калининград)` : null].filter(Boolean);
const fallbackHeroComposition: HeroComposition = event.image_url
  ? (event.image_text_mode === 'visual_only' ? 'photo-cinematic-sheet' : 'poster-billboard')
  : 'compact-ticketing';
const heroComposition = HERO_COMPOSITION_BY_EVENT_ID[event.id] || fallbackHeroComposition;
const galleryCtaEvent = discoveryFeed[0];
const galleryCta = galleryCtaEvent ? {
  title: galleryCtaEvent.title,
  href: eventHref(galleryCtaEvent),
  label: 'Смотреть похожее',
  image_url: eventImageUrl(galleryCtaEvent.image_url),
  meta: [getOccurrencePresentation(galleryCtaEvent).compactLabel || displayDateTime(galleryCtaEvent), galleryCtaEvent.venue_name || galleryCtaEvent.city].filter(Boolean).join(' · '),
} : undefined;
// A handful of the accepted desktop specimens were enriched before their
// derivative rows reached the current production snapshot. Reuse only those
// immutable CDN thumbnails when the canonical asset still has no derivatives;
// the mobile-v4 event object remains untouched below.
const desktopThumbnailOverrides = (desktopThumbnailOverridesData.events as Record<string, Record<string, EventImageDerivative[]>>)[String(event.id)] || {};
const desktopEvent: PreviewEvent = Object.keys(desktopThumbnailOverrides).length > 0
  ? {
      ...event,
      image_assets:(event.image_assets || []).map((asset, index) => asset.thumbnail_sources?.length
        ? asset
        : ({ ...asset, thumbnail_sources:desktopThumbnailOverrides[String(index)] || asset.thumbnail_sources })),
    }
  : event;
// Both responsive presentations must consume the same persisted Smart Update
// duration projection. Otherwise the desktop schedule can offer realistic
// same-day returns while the mobile schedule silently falls back to closing
// time and suggests an implausibly late train.
const transportEvent = desktopEventWithExplicitEnd(event);
const desktopPresentation = buildDesktopEventPresentation(desktopEvent);
// Immutable noindex review builds are real interactive acceptance artifacts,
// not inert screenshots. Keep the production rollout flag, but mount the
// reviewed router in every named preview so keyboard acceptance cannot silently
// disappear merely because the artifact is outside the production family.
const keyboardEventNavigationEnabled = (IS_PRODUCTION_FAMILY
  || PREVIEW_BUILD_ID !== 'local'
  || String(import.meta.env.PUBLIC_KEYBOARD_EVENT_NAVIGATION_FORCE || '') === '1')
  && String(import.meta.env.PUBLIC_KEYBOARD_EVENT_NAVIGATION_ENABLED || '1') !== '0';
---
<EventLayout title={title} description={event.meta_description} canonicalUrl={canonicalUrl} ogImage={ogImage} ogImageType={ogImageType} ogImageWidth={ogImageAsset?.width || null} ogImageHeight={ogImageAsset?.height || null} structuredData={structuredData} heroChrome="immersive">
  <MobileEventProductionStyles />
  <div id="main">
  <DesktopEventPage
    event={desktopEvent}
    related={desktopDiscoveryFeed}
    candidate={desktopPresentation.candidate}
    mediaPolicy={desktopPresentation.mediaPolicy}
    heroImageIndex={desktopPresentation.heroImageIndex}
    heroWidth={desktopPresentation.heroWidth}
    heroHeight={desktopPresentation.heroHeight}
    heroObjectPosition={desktopPresentation.heroObjectPosition}
    editorialRail={desktopPresentation.editorialRail}
    editorialMotion={desktopPresentation.editorialMotion}
    editorialCropPolicy={desktopPresentation.editorialCropPolicy}
    ocrCompanionImageIndex={desktopPresentation.ocrCompanionImageIndex}
    ocrCompanionLayout={desktopPresentation.ocrCompanionLayout}
    autoRotate={desktopPresentation.autoRotate}
    ocrSourceIndexes={desktopPresentation.ocrSourceIndexes}
    duplicateSourceIndexes={desktopPresentation.duplicateSourceIndexes}
    splitMediaFit={desktopPresentation.splitMediaFit}
    splitPortraitViewer={desktopPresentation.splitPortraitViewer}
    splitPortraitSourceIndexes={desktopPresentation.splitPortraitSourceIndexes}
    splitViewerHiddenSourceIndexes={desktopPresentation.splitViewerHiddenSourceIndexes}
    relatedMediaTreatment={desktopPresentation.relatedMediaTreatment}
    surface="production"
    presentationReason={desktopPresentation.reason}
    showTransport
    occurrencePresentation={occurrencePresentation}
  />
  <main
    class="mobile-event-production"
    data-production-mobile-event
    data-mobile-event-production
    data-mobile-review-variant="accepted-v8"
    data-prose-treatment="open"
    data-actions-treatment="dock"
    data-mobile-review-revision="v4"
    data-mobile-parallax-profile="photo-continuous-crop"
  >
    <div class="page-shell page-shell--event-impact mobile-event-production__shell">
      <article class="main-col section-card section-card--hero section-card--impact-hero">
        <div class="section-card__inner section-card__inner--hero">
          <EventHero event={event} composition={heroComposition} galleryCta={galleryCta} metaTreatment="weekday-panel" occurrencePresentation={occurrencePresentation} />
        </div>
      </article>

      <div class="mobile-event-production__continuation">
        <div class="mobile-event-production__medallions"><EventTokenMedallions event={event} /></div>
        <EventParticipants event={event} surface="mobile" />

        <section class="section-card section-card--quiet section-card--event-details mobile-event-production__details" style="margin-top: 1rem;">
          <div class="section-card__inner mobile-event-production__prose">
            <h2>Описание</h2>
            <div class="prose" set:html={event.description_html} />
            <h2 style="margin-top: 1.2rem;">Коротко</h2>
            <EventFacts event={event} />
            <EventTransportSchedule event={transportEvent} />
            <EventBusTransportSchedule event={transportEvent} />
            <KaupTransportSchedule event={transportEvent} compact />
            {descriptionMeta.length > 0 && <p class="event-description-meta" data-nosnippet>{descriptionMeta.join(' · ')}</p>}
          </div>
          <p class="event-source-gate event-source-gate--section"><Icon name="lock" /> <span>Все источники, упоминания и расширенная статистика события будут доступны зарегистрированным пользователям.</span></p>
        </section>

      </div>

      <section id="discovery-feed" class="section-card mobile-event-production__discovery" style="margin-top: 1rem;" data-hide-sticky-after>
        <div class="section-card__inner">
          <h2>Смотрите дальше</h2>
          <div
            class="cards-grid cards-grid--immersive"
            data-discovery-feed
            data-surface="event_detail_related"
            data-layout-mode="module"
            data-algorithm-id={discoveryAlgorithmId}
            data-current-event-id={event.id}
            data-discovery-src={withBase(`/data/discovery/${event.id}.json`)}
            data-feed-card-variant={feedCardVariant}
          >
            {discoveryFeed.map((candidate) => <EventCard event={candidate} variant={feedCardVariant} />)}
          </div>
          <button type="button" class="secondary-button discovery-load-more" data-discovery-load-more hidden>Показать ещё</button>
        </div>
      </section>
    </div>
  </main>
  <PersonalFeedSlot context="event-detail" currentEventId={event.id} relatedSrc={`/data/discovery/${event.id}.json`} />
  {keyboardEventNavigationEnabled && <KeyboardEventNavigation />}
  {stickyHref && (
    <div class="mobile-sticky-cta" data-sticky-cta aria-label="Быстрое действие события">
      <div class="mobile-sticky-cta__inner">
        <div class="mobile-sticky-cta__title"><strong>{event.title}</strong><span>{stickyDateLabel}</span></div>
        <a class="cta-button" href={stickyHref} type={stickyCalendarPrimary ? 'text/calendar' : undefined} target={stickyIsExternal && !stickyCalendarPrimary ? '_blank' : undefined} rel={stickyIsExternal && !stickyCalendarPrimary ? 'noopener noreferrer nofollow' : undefined} data-calendar-action={stickyCalendarPrimary ? true : undefined} data-calendar-event-id={stickyCalendarPrimary ? event.id : undefined} data-calendar-expiry-day={stickyCalendarPrimary ? calendarExpiryDay : undefined} data-calendar-event-title={stickyCalendarPrimary ? event.title : undefined} aria-label={stickyCalendarPrimary ? `Добавить в календарь: ${event.title}` : undefined}>{stickyIsTelephone && <Icon name="phone" />}<span data-calendar-label={stickyCalendarPrimary ? true : undefined}>{stickyLabel}</span></a>
      </div>
    </div>
  )}
  </div>
  <style is:global>
    @media (min-width: 1024px) {
      [data-production-mobile-event] { display: none !important; }
    }
  </style>
</EventLayout>
