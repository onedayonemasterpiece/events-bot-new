---
import EventLayout from '../../layouts/EventLayout.astro';
import EventHero from '../../components/EventHero.astro';
import EventFacts from '../../components/EventFacts.astro';
import EventCtaPanel from '../../components/EventCtaPanel.astro';
import EventCard from '../../components/EventCard.astro';
import { buildBreadcrumbJsonLd, buildEventJsonLd, eventTitle } from '../../lib/seo';
import { displayDateTime, eventAbsoluteUrl, eventTicketActionLabel, getEventBySlug, getEvents, getOtherDates, getPreloadedDiscoveryEvents, withBase } from '../../lib/events';

type FeedCardVariant = 'overlay-controls' | 'split-actions';
const FEED_VARIANT_BY_EVENT_ID: Record<number, FeedCardVariant> = {
  5878: 'overlay-controls',
  6322: 'split-actions',
  4913: 'split-actions',
};
const FEED_VARIANT_LABELS: Record<FeedCardVariant, string> = {
  'overlay-controls': 'A: одна строка действий поверх карточки',
  'split-actions': 'B: служебная строка внутри + лайк/поделиться под карточкой справа',
};

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { slug: event.slug } }));
}

const event = getEventBySlug(Astro.params.slug ?? '');
if (!event) {
  return Astro.redirect(withBase('/__preview/'));
}
const discoveryFeed = getPreloadedDiscoveryEvents(event, 10);
const otherDates = getOtherDates(event);
const canonicalUrl = eventAbsoluteUrl(event);
const title = eventTitle(event);
const structuredData = [buildEventJsonLd(event), buildBreadcrumbJsonLd(event)];
const ctaHref = event.ticket.href;
const ctaLabel = eventTicketActionLabel(event);
const feedCardVariant = FEED_VARIANT_BY_EVENT_ID[event.id] || 'overlay-controls';
const feedVariantLabel = FEED_VARIANT_LABELS[feedCardVariant];
const stickyDateLabel = displayDateTime(event);
---
<EventLayout title={title} description={event.meta_description} canonicalUrl={canonicalUrl} ogImage={event.image_url} structuredData={structuredData}>
  <main id="main">
    <div class="page-shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href={withBase('/__preview/')}>Афиша</a>
        <span aria-hidden="true">/</span>
        {event.city && <a href={withBase(`/__preview/?city=${encodeURIComponent(event.city)}`)}>{event.city}</a>}
        {event.city && <span aria-hidden="true">/</span>}
        {event.event_type && <span>{event.event_type}</span>}
      </nav>
      <div class="event-grid">
        <article class="main-col section-card section-card--hero">
          <div class="section-card__inner section-card__inner--hero">
            <EventHero event={event} />
          </div>
        </article>
        <div class="side-col">
          <EventCtaPanel event={event} />
        </div>
      </div>

      <section class="section-card section-card--quiet" style="margin-top: 1rem;">
        <div class="section-card__inner">
          <h2>Описание</h2>
          <div class="prose" set:html={event.description_html} />
          <h2 style="margin-top: 1.2rem;">Факты и источники</h2>
          <EventFacts event={event} />
          <div class="source-links" aria-label="Источники данных">
            {event.source_url && <a href={event.source_url} target="_blank" rel="noopener noreferrer nofollow">Источник</a>}
            {event.telegraph_url && <a href={event.telegraph_url} target="_blank" rel="noopener noreferrer nofollow">Telegraph</a>}
          </div>
        </div>
      </section>

      {otherDates.length > 0 && (
        <section class="section-card" style="margin-top: 1rem;">
          <div class="section-card__inner">
            <h2>Другие даты</h2>
            <div class="cards-grid cards-grid--immersive">
              {otherDates.map((candidate) => <EventCard event={candidate} label="Другая дата" />)}
            </div>
          </div>
        </section>
      )}

      <section id="discovery-feed" class="section-card" style="margin-top: 1rem;" data-hide-sticky-after>
        <div class="section-card__inner">
          <h2>Смотрите дальше</h2>
          <p class="muted-note" style="margin-top: -0.35rem; margin-bottom: 0.9rem;">В HTML сразу предзагружены до 10 событий. После согласия и запуска скрипта блок применяет локальный профиль интересов, убирает неподходящее, один раз догружает релевантные варианты из JSON; дальше — только по кнопке. Preview A/B: <strong>{feedVariantLabel}</strong>.</p>
          <div
            class="cards-grid cards-grid--immersive"
            data-discovery-feed
            data-surface="event_detail_related"
            data-layout-mode="module"
            data-algorithm-id="static_related_v1"
            data-current-event-id={event.id}
            data-discovery-src={withBase(`/data/discovery/${event.id}.json`)}
            data-feed-card-variant={feedCardVariant}
          >
            {discoveryFeed.map((candidate) => <EventCard event={candidate} variant={feedCardVariant} />)}
          </div>
          <button type="button" class="secondary-button discovery-load-more" data-discovery-load-more hidden>Показать ещё</button>
        </div>
      </section>
    </div>
  </main>
  {ctaHref && (
    <div class="mobile-sticky-cta" data-sticky-cta aria-label="Быстрое действие события">
      <div class="mobile-sticky-cta__inner">
        <div class="mobile-sticky-cta__title"><strong>{event.title}</strong><span>{stickyDateLabel}</span></div>
        <a class="cta-button" href={ctaHref} target={ctaHref.startsWith('http') ? '_blank' : undefined} rel={ctaHref.startsWith('http') ? 'noopener noreferrer nofollow' : undefined}>{ctaLabel}</a>
      </div>
    </div>
  )}
</EventLayout>
