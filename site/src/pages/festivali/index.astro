---
import EventLayout from '../../layouts/EventLayout.astro';
import { festivalTimeline, festivalTimelineMonths } from '../../data/festivalTimeline';
import { packFestivalTimeline } from '../../lib/festivalTimelineLayout';
import {
  absoluteUrl,
  eventAbsoluteUrl,
  eventHref,
  getEventById,
  SITE_NAME,
  withBase,
} from '../../lib/events';

const canonicalUrl = absoluteUrl('/festivali/');
const title = `Фестивали Калининградской области 2026 | ${SITE_NAME}`;
const description = 'Календарь фестивалей Калининграда и области с июля по декабрь 2026 года: даты, города, направления и честный статус программ.';
const resolvedItems = festivalTimeline.map((item) => {
  const internalEvent = item.internalEventId ? getEventById(item.internalEventId) : undefined;
  return {
    ...item,
    href: internalEvent ? eventHref(internalEvent) : item.sourceHref,
    absoluteHref: internalEvent ? eventAbsoluteUrl(internalEvent) : item.sourceHref,
    isExternal: !internalEvent,
    linkLabel: internalEvent ? 'О событии' : item.sourceLabel,
    displayAspect: item.mediaMode === 'visual' && item.imageWidth / item.imageHeight < 1.25
      ? 1.25
      : Math.min(item.imageWidth / item.imageHeight, 1.9),
  };
});
const monthSections = festivalTimelineMonths
  .map((month) => {
    const items = resolvedItems.filter((item) => item.monthKey === month.key);
    return {
      ...month,
      items,
      rows: packFestivalTimeline(items),
    };
  })
  .filter((month) => month.items.length > 0);
const publishedDateCount = resolvedItems.filter((item) => item.status !== 'date-pending').length;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Фестивали Калининградской области 2026',
    description,
    url: canonicalUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: absoluteUrl('/'),
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: resolvedItems.length,
      itemListElement: resolvedItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.title,
        url: item.absoluteHref,
      })),
    },
  },
];
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={absoluteUrl('/assets/festivals/timeline/city-jazz.webp')}
  ogImageType="image/webp"
  ogImageWidth={652}
  ogImageHeight={357}
  structuredData={structuredData}
  noindex
>
  <main id="main" class="festival-page" data-festival-timeline data-festival-count={resolvedItems.length}>
    <section class="festival-hero" aria-labelledby="festival-title">
      <div class="festival-hero__copy">
        <p class="festival-eyebrow">Календарь региона · 2026</p>
        <h1 id="festival-title">Фестивальное <em>полугодие</em></h1>
        <p class="festival-hero__lead">
          От джаза у моря до зимней классики. Собрали большие и камерные фестивали
          области в одну хронологию — без выдуманных дат и лишней высоты карточек.
        </p>
      </div>
      <dl class="festival-hero__facts" aria-label="Коротко о календаре">
        <div>
          <dt>В календаре</dt>
          <dd>{resolvedItems.length}</dd>
          <span>фестиваль</span>
        </div>
        <div>
          <dt>Период</dt>
          <dd>6</dd>
          <span>месяцев</span>
        </div>
        <div>
          <dt>С датами</dt>
          <dd>{publishedDateCount}</dd>
          <span>опубликовано</span>
        </div>
      </dl>
      <aside class="festival-hero__note" aria-label="Как читать статусы">
        <span class="festival-status-dot" aria-hidden="true"></span>
        <p><strong>Анонсировано</strong> — даты уже опубликованы. Мягкая метка означает, что ждём программу, площадку или точный день.</p>
      </aside>
    </section>

    <nav class="festival-month-nav" aria-label="Месяцы фестивального календаря">
      {monthSections.map((month) => (
        <a href={`#month-${month.key}`}>
          <span aria-hidden="true">{month.shortLabel}</span>
          <span>{month.label}</span>
        </a>
      ))}
    </nav>

    <div class="festival-timeline">
      {monthSections.map((month) => (
        <section
          id={`month-${month.key}`}
          class="festival-month"
          aria-labelledby={`month-title-${month.key}`}
          data-festival-month={month.key}
        >
          <header class="festival-month__rail">
            <div class="festival-month__marker" aria-hidden="true"></div>
            <div class="festival-month__heading">
              <p>2026</p>
              <h2 id={`month-title-${month.key}`}>{month.label}</h2>
              <span>{month.items.length}</span>
            </div>
          </header>

          <div class="festival-month__cards">
            {month.rows.map((row, rowIndex) => (
              <div
                class:list={['festival-row', `festival-row--${row.items.length}`]}
                style={`grid-template-columns:${row.columnWeights.map((weight) => `${weight.toFixed(3)}fr`).join(' ')};`}
                data-festival-row
                data-row-size={row.items.length}
                data-row-index={rowIndex}
              >
                {row.items.map((baseItem) => {
                  const item = resolvedItems.find((candidate) => candidate.slug === baseItem.slug)!;
                  return (
                    <article
                      class:list={[
                        'festival-card',
                        `festival-card--${item.mediaMode}`,
                        `festival-card--${item.status}`,
                      ]}
                      data-festival-card={item.slug}
                    >
                      <a
                        class="festival-card__link"
                        href={item.href}
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noreferrer' : undefined}
                        aria-label={`${item.title}. ${item.dateLabel}. ${item.place}`}
                      >
                        <figure
                          class="festival-card__media"
                          style={`aspect-ratio:${item.displayAspect.toFixed(4)};`}
                        >
                          <img
                            src={withBase(item.image)}
                            width={item.imageWidth}
                            height={item.imageHeight}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                          <figcaption>
                            <span>{item.dateLabel}</span>
                          </figcaption>
                        </figure>
                        <div class="festival-card__body">
                          <div class="festival-card__kicker">
                            <span>{item.category}</span>
                            <span aria-hidden="true">·</span>
                            <span>{item.place}</span>
                          </div>
                          <h3>{item.title}</h3>
                          <p>{item.description}</p>
                          <footer>
                            <span class="festival-card__status">
                              <i aria-hidden="true"></i>
                              {item.statusLabel}
                            </span>
                            <span class="festival-card__source">
                              {item.linkLabel}
                              <span aria-hidden="true">↗</span>
                            </span>
                          </footer>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="festival-footer-note">
      <p class="festival-eyebrow">Календарь живой</p>
      <h2>Программы появляются постепенно</h2>
      <p>Мы сохранили только опубликованные даты. Там, где организаторы ещё не назвали точный день или расписание, это прямо отмечено на карточке.</p>
      <a href={withBase('/__preview/')}>Вернуться ко всем страницам прототипа <span aria-hidden="true">→</span></a>
    </aside>
  </main>
</EventLayout>

<style>
  .festival-page {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1.4rem, 4vw, 3.8rem) 0 clamp(5.5rem, 9vw, 8rem);
  }

  .festival-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5.6rem);
    border: 1px solid rgba(121, 48, 20, 0.14);
    border-radius: clamp(28px, 5vw, 54px);
    background:
      radial-gradient(circle at 84% 18%, rgba(15, 118, 110, 0.14), transparent 23rem),
      linear-gradient(135deg, rgba(255, 253, 248, 0.98), rgba(242, 231, 215, 0.92));
    box-shadow: 0 28px 80px rgba(72, 45, 25, 0.1);
  }

  .festival-hero::after {
    content: "";
    position: absolute;
    right: -4rem;
    bottom: -8rem;
    width: 22rem;
    height: 22rem;
    border: 4.2rem solid rgba(165, 72, 33, 0.06);
    border-radius: 50%;
    pointer-events: none;
  }

  .festival-hero__copy,
  .festival-hero__facts,
  .festival-hero__note {
    position: relative;
    z-index: 1;
  }

  .festival-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--primary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .festival-hero h1 {
    max-width: 760px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 7.2vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .festival-hero h1 em {
    display: block;
    color: var(--primary);
    font-weight: 400;
  }

  .festival-hero__lead {
    max-width: 700px;
    margin: clamp(1.3rem, 3vw, 2.3rem) 0 0;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.8vw, 1.26rem);
    line-height: 1.55;
  }

  .festival-hero__facts {
    display: grid;
    align-self: end;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid rgba(121, 48, 20, 0.18);
    border-bottom: 1px solid rgba(121, 48, 20, 0.18);
  }

  .festival-hero__facts div {
    min-width: 0;
    padding: 1rem 0.65rem 1rem 0;
  }

  .festival-hero__facts dt {
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .festival-hero__facts dd {
    margin: 0.18rem 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.95;
  }

  .festival-hero__facts span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .festival-hero__note {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    gap: 0.72rem;
    max-width: 780px;
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 16px;
    background: rgba(255, 253, 248, 0.72);
    color: var(--muted);
    font-size: 0.86rem;
  }

  .festival-hero__note p { margin: 0; }
  .festival-hero__note strong { color: var(--text); }
  .festival-status-dot {
    flex: 0 0 auto;
    width: 0.62rem;
    height: 0.62rem;
    margin-top: 0.34rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(15, 118, 110, 0.12);
  }

  .festival-month-nav {
    position: sticky;
    top: calc(var(--ke-site-header-bar-height) + 0.65rem);
    z-index: 20;
    display: flex;
    width: max-content;
    max-width: 100%;
    margin: 1.25rem auto clamp(3rem, 7vw, 6rem);
    padding: 0.38rem;
    overflow-x: auto;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    box-shadow: 0 12px 36px rgba(72, 45, 25, 0.1);
    backdrop-filter: blur(16px);
    scrollbar-width: none;
  }

  .festival-month-nav::-webkit-scrollbar { display: none; }
  .festival-month-nav a {
    flex: 0 0 auto;
    padding: 0.58rem 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }
  .festival-month-nav a:hover { background: var(--bg-soft); color: var(--primary-strong); }
  .festival-month-nav a span:first-child { display: none; }

  .festival-timeline {
    position: relative;
  }

  .festival-month {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    scroll-margin-top: 9rem;
  }

  .festival-month__rail {
    position: relative;
    padding-right: 2rem;
  }

  .festival-month__rail::after {
    content: "";
    position: absolute;
    top: 1.15rem;
    right: 0.46rem;
    bottom: -1px;
    width: 1px;
    background: linear-gradient(var(--primary), rgba(165, 72, 33, 0.18));
  }

  .festival-month:last-child .festival-month__rail::after {
    bottom: 50%;
  }

  .festival-month__marker {
    position: absolute;
    top: 0.8rem;
    right: 0.05rem;
    z-index: 1;
    width: 0.86rem;
    height: 0.86rem;
    border: 3px solid var(--surface);
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 1px var(--primary);
  }

  .festival-month__heading {
    position: sticky;
    top: calc(var(--ke-site-header-bar-height) + 5.5rem);
    padding-top: 0.2rem;
    text-align: right;
  }

  .festival-month__heading p {
    margin: 0;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .festival-month__heading h2 {
    margin: 0.06rem 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .festival-month__heading span {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .festival-month__cards {
    min-width: 0;
    padding: 0 0 clamp(4rem, 8vw, 7rem) clamp(1rem, 2.5vw, 2.5rem);
  }

  .festival-row {
    display: grid;
    align-items: stretch;
    gap: clamp(0.75rem, 1.5vw, 1.15rem);
  }

  .festival-row + .festival-row {
    margin-top: clamp(0.75rem, 1.5vw, 1.15rem);
  }

  .festival-row--1 {
    max-width: 980px;
  }

  .festival-row--1 .festival-card--visual .festival-card__media {
    aspect-ratio: 16 / 9 !important;
  }

  .festival-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(121, 48, 20, 0.13);
    border-radius: clamp(19px, 2.2vw, 27px);
    background: var(--surface);
    box-shadow: 0 14px 32px rgba(72, 45, 25, 0.085);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .festival-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 42px rgba(72, 45, 25, 0.14);
  }

  .festival-card__link {
    display: flex;
    height: 100%;
    color: inherit;
    text-decoration: none;
    flex-direction: column;
  }

  .festival-card__media {
    position: relative;
    flex: 0 0 auto;
    width: 100%;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    background: #e8dfd4;
  }

  .festival-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .festival-card:hover .festival-card__media img {
    transform: scale(1.018);
  }

  .festival-card--document .festival-card__media {
    background: #f3efe9;
  }

  .festival-card--document .festival-card__media img {
    object-fit: contain;
    transform: none;
  }

  .festival-card__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    background: linear-gradient(transparent, rgba(25, 16, 10, 0.38));
    pointer-events: none;
  }

  .festival-card__media figcaption {
    position: absolute;
    left: 0.72rem;
    bottom: 0.72rem;
    z-index: 1;
    display: flex;
  }

  .festival-card__media figcaption span {
    padding: 0.38rem 0.62rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(34, 26, 20, 0.74);
    color: #fff;
    font-size: clamp(0.68rem, 1vw, 0.78rem);
    font-weight: 760;
    line-height: 1.2;
    backdrop-filter: blur(8px);
  }

  .festival-card__body {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    padding: clamp(0.85rem, 1.7vw, 1.25rem);
    flex-direction: column;
  }

  .festival-card__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    color: var(--primary);
    font-size: clamp(0.64rem, 0.9vw, 0.72rem);
    font-weight: 800;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .festival-card h3 {
    margin: 0.46rem 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.22rem, 2.1vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.03;
  }

  .festival-row--4 .festival-card h3 {
    font-size: clamp(1.08rem, 1.6vw, 1.48rem);
  }

  .festival-card__body > p {
    display: -webkit-box;
    margin: 0.62rem 0 1rem;
    overflow: hidden;
    color: var(--muted);
    font-size: clamp(0.78rem, 1vw, 0.88rem);
    line-height: 1.48;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .festival-row--4 .festival-card__body > p {
    -webkit-line-clamp: 2;
  }

  .festival-card footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 0.72rem;
    border-top: 1px solid rgba(121, 48, 20, 0.1);
    color: var(--muted);
    font-size: 0.66rem;
    line-height: 1.25;
  }

  .festival-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    font-weight: 720;
  }

  .festival-card__status i {
    flex: 0 0 auto;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .festival-card--program-pending .festival-card__status i,
  .festival-card--date-pending .festival-card__status i {
    background: #c0841a;
  }

  .festival-card__source {
    flex: 0 0 auto;
    text-align: right;
  }

  .festival-footer-note {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(15, 118, 110, 0.16);
    border-radius: clamp(24px, 4vw, 38px);
    background: linear-gradient(145deg, rgba(215, 240, 236, 0.7), rgba(255, 253, 248, 0.9));
    text-align: center;
  }

  .festival-footer-note h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .festival-footer-note > p:not(.festival-eyebrow) {
    max-width: 650px;
    margin: 1rem auto 0;
    color: var(--muted);
  }

  .festival-footer-note a {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--primary-strong);
    font-weight: 760;
  }

  @media (max-width: 1040px) {
    .festival-hero {
      grid-template-columns: 1fr;
    }
    .festival-hero__facts {
      max-width: 620px;
    }
    .festival-row--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .festival-row--4 .festival-card__media {
      aspect-ratio: 16 / 10 !important;
    }
  }

  @media (max-width: 760px) {
    .festival-page {
      width: min(100% - 1rem, 620px);
      padding-top: 0.55rem;
    }
    .festival-hero {
      gap: 1.35rem;
      padding: 1.55rem 1.25rem;
      border-radius: 27px;
    }
    .festival-hero h1 {
      font-size: clamp(2.9rem, 15vw, 4.9rem);
    }
    .festival-hero__lead {
      font-size: 0.98rem;
    }
    .festival-hero__facts div {
      padding: 0.8rem 0.35rem 0.8rem 0;
    }
    .festival-hero__facts dd {
      font-size: 2rem;
    }
    .festival-hero__note {
      padding: 0.75rem;
      font-size: 0.78rem;
    }
    .festival-month-nav {
      top: calc(var(--mobile-top-chrome-bottom) + 0.4rem);
      justify-content: flex-start;
      margin: 0.65rem auto 2.5rem;
    }
    .festival-month-nav a span:first-child { display: inline; }
    .festival-month-nav a span:last-child { display: none; }
    .festival-month {
      display: block;
      scroll-margin-top: 9rem;
    }
    .festival-month__rail {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0 0 0.8rem 0.25rem;
    }
    .festival-month__rail::after { display: none; }
    .festival-month__marker {
      position: static;
      width: 0.74rem;
      height: 0.74rem;
    }
    .festival-month__heading {
      position: static;
      display: flex;
      align-items: baseline;
      gap: 0.45rem;
      padding: 0;
