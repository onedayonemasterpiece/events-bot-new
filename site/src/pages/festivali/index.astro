---
import EventLayout from '../../layouts/EventLayout.astro';
import { festivalTimeline, festivalTimelineMonths } from '../../data/festivalTimeline';
import { festivalTimelineMedia } from '../../data/festivalTimelineMedia';
import { packFestivalTimeline } from '../../lib/festivalTimelineLayout';
import {
  absoluteUrl,
  eventAbsoluteUrl,
  eventHref,
  getEventById,
  SITE_NAME,
  withBase,
} from '../../lib/events';

const canonicalUrl = absoluteUrl('/festivali/');
const title = `Фестивали Калининградской области 2026 | ${SITE_NAME}`;
const description = 'Календарь фестивалей Калининграда и области с июля по декабрь 2026 года: даты, города, направления и честный статус программ.';
const compactDate = (value: string) => value
  .replace('января', 'янв')
  .replace('февраля', 'фев')
  .replace('марта', 'мар')
  .replace('апреля', 'апр')
  .replace('мая', 'мая')
  .replace('июня', 'июн')
  .replace('июля', 'июл')
  .replace('августа', 'авг')
  .replace('сентября', 'сен')
  .replace('октября', 'окт')
  .replace('ноября', 'ноя')
  .replace('декабря', 'дек')
  .replace(/^С /, 'с ');
const compactStatus = {
  announced: 'официально',
  'program-pending': 'программа позже',
  'date-pending': 'дата уточняется',
} as const;
const categoryIcon = (category: string) => {
  if (/музык|песн|джаз/iu.test(category)) return '/assets/icons/festival-categories/389324-music.svg';
  if (/гастроном|вино/iu.test(category)) return '/assets/icons/festival-categories/389063-carrot.svg';
  if (/кино/iu.test(category)) return '/assets/icons/festival-categories/389059-camera.svg';
  if (/театр/iu.test(category)) return '/assets/icons/festival-categories/389461-ticket.svg';
  if (/истор|реконструк/iu.test(category)) return '/assets/icons/festival-categories/389241-history.svg';
  if (/море|путешеств/iu.test(category)) return '/assets/icons/festival-categories/389291-map-pin.svg';
  if (/литератур/iu.test(category)) return '/assets/icons/festival-categories/389049-book-open.svg';
  if (/современн|искусств|косплей|культур/iu.test(category)) return '/assets/icons/festival-categories/389330-palette.svg';
  return '/assets/icons/festival-categories/389439-star.svg';
};
const resolvedItems = festivalTimeline.map((item) => {
  const mediaRecord = festivalTimelineMedia[item.slug as keyof typeof festivalTimelineMedia];
  if (!mediaRecord || mediaRecord.semanticClass !== item.mediaMode) {
    throw new Error(`Festival media review is missing or stale for ${item.slug}`);
  }
  const internalEvent = item.internalEventId ? getEventById(item.internalEventId) : undefined;
  const naturalAspect = item.imageWidth / item.imageHeight;
  const mobileAspect = item.mediaMode === 'document'
    ? (naturalAspect < 4 / 5 ? Math.min(4 / 5, naturalAspect / 0.8) : naturalAspect)
    : 16 / 10;
  return {
    ...item,
    href: internalEvent ? eventHref(internalEvent) : item.sourceHref,
    absoluteHref: internalEvent ? eventAbsoluteUrl(internalEvent) : item.sourceHref,
    isExternal: !internalEvent,
    linkLabel: internalEvent ? 'О событии' : item.sourceLabel,
    mobileAspect,
    compactDateLabel: compactDate(item.dateLabel),
    compactStatusLabel: compactStatus[item.status],
    categoryIcon: categoryIcon(item.category),
    mediaRecord,
  };
});
const monthSections = festivalTimelineMonths
  .map((month) => {
    const items = resolvedItems.filter((item) => item.monthKey === month.key);
    return { ...month, items, rows: packFestivalTimeline(items) };
  })
  .filter((month) => month.items.length > 0);
for (const month of monthSections) {
  if (month.rows.reduce((sum, row) => sum + row.items.length, 0) !== month.items.length) {
    throw new Error(`Festival timeline could not safely pack every ${month.label} item`);
  }
}
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Фестивали Калининградской области 2026',
  description,
  url: canonicalUrl,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: resolvedItems.length,
    itemListElement: resolvedItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: item.absoluteHref,
    })),
  },
}];
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={absoluteUrl('/assets/festivals/timeline/city-jazz.webp')}
  ogImageType="image/webp"
  ogImageWidth={1600}
  ogImageHeight={1067}
  structuredData={structuredData}
  noindex
>
  <main id="main" class="festival-page" data-festival-timeline data-festival-count={resolvedItems.length}>
    <section class="festival-hero" aria-labelledby="festival-title">
      <div class="festival-hero__copy">
        <p class="festival-eyebrow">Календарь региона · июль—декабрь 2026</p>
        <h1 id="festival-title">Время <em>фестивалей</em></h1>
        <p>Музыка, кино, гастрономия, театр и море — фестивали Калининграда и области по месяцам.</p>
      </div>
      <dl class="festival-hero__facts" aria-label="Коротко о календаре">
        <div><dt>Фестивалей</dt><dd>{resolvedItems.length}</dd></div>
        <div><dt>Сезон</dt><dd>Июль—декабрь</dd></div>
      </dl>
    </section>

    <nav class="festival-month-nav" aria-label="Месяцы фестивального календаря">
      {monthSections.map((month) => (
        <a href={`#month-${month.key}`}>
          <span aria-hidden="true">{month.shortLabel}</span>
          <span>{month.label}</span>
        </a>
      ))}
    </nav>

    <div class="festival-timeline">
      {monthSections.map((month) => (
        <section
          id={`month-${month.key}`}
          class="festival-month"
          aria-labelledby={`month-title-${month.key}`}
          data-festival-month={month.key}
        >
          <header class="festival-month__rail">
            <div class="festival-month__shelf">
              <div class="festival-month__marker" aria-hidden="true"></div>
              <div class="festival-month__heading">
                <h2 id={`month-title-${month.key}`}>{month.label}</h2>
                <span class="festival-month__symbol" aria-hidden="true">{month.symbol}</span>
                <p>{month.mood}</p>
              </div>
            </div>
          </header>

          <div class="festival-month__cards">
            {month.rows.map((row, rowIndex) => (
              <div
                class:list={['festival-row', `festival-row--${row.items.length}`]}
                style={`grid-template-columns:${row.columnWeights.map((weight) => `${weight.toFixed(4)}fr`).join(' ')};--festival-row-width:${(row.widthFraction * 100).toFixed(2)}%;`}
                data-festival-row
                data-row-size={row.items.length}
                data-row-index={rowIndex}
                data-row-normalized-height={row.normalizedMediaHeight.toFixed(4)}
                data-row-width-fraction={row.widthFraction.toFixed(4)}
                data-row-remainder={row.isRemainder ? 'true' : 'false'}
                data-row-only={month.rows.length === 1 ? 'true' : 'false'}
              >
                {row.items.map((baseItem, itemIndex) => {
                  const item = resolvedItems.find((candidate) => candidate.slug === baseItem.slug)!;
                  const frameAspect = row.columnWeights[itemIndex];
                  const cropFraction = row.cropFractions[itemIndex];
                  return (
                    <article
                      class:list={[
                        'festival-card',
                        `festival-card--${item.mediaMode}`,
                        `festival-card--${item.status}`,
                      ]}
                      style={`--festival-card-aspect:${frameAspect.toFixed(5)};--festival-mobile-aspect:${item.mobileAspect.toFixed(5)};`}
                      data-festival-card={item.slug}
                      data-media-mode={item.mediaMode}
                      data-crop-fraction={cropFraction.toFixed(4)}
                      data-protected-crop-fit="cover"
                      data-media-source-kind={item.mediaRecord.sourceKind}
                      data-media-confidence={item.mediaRecord.classificationConfidence}
                    >
                      <a
                        class="festival-card__link"
                        href={item.href}
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noreferrer' : undefined}
                        aria-label={`${item.title}. ${item.dateLabel}. ${item.place}. ${item.statusLabel}. Источник: ${item.linkLabel}`}
                      >
                        <figure class="festival-card__media">
                          <img
                            src={withBase(item.image)}
                            width={item.imageWidth}
                            height={item.imageHeight}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            style={item.objectPosition ? `object-position:${item.objectPosition};` : undefined}
                          />
                        </figure>
                        <div class="festival-card__veil" aria-hidden="true"></div>
                        <div class="festival-card__topline">
                          <span class="festival-card__date" title={item.dateLabel}>{item.compactDateLabel}</span>
                          <span class="festival-card__status" title={item.statusLabel}><i aria-hidden="true"></i><span>{item.compactStatusLabel}</span></span>
                        </div>
                        <div class="festival-card__caption">
                          <h3>{item.title}</h3>
                          <p class="festival-card__place">{item.place}</p>
                          <span class="festival-card__theme" title={item.category}>
                            <i
                              aria-hidden="true"
                              style={`--festival-category-icon:url("${withBase(item.categoryIcon)}");`}
                            ></i>
                            <span>{item.category}</span>
                          </span>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</EventLayout>

<style>
  .festival-page {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.4rem) 0 clamp(5.5rem, 8vw, 7rem);
    font-family: var(--ke-font-sans);
  }

  .festival-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 5vw, 5rem);
    min-height: 270px;
    padding: clamp(1.8rem, 4vw, 3.35rem);
    overflow: hidden;
    border: 1px solid rgba(121, 48, 20, 0.13);
    border-radius: clamp(28px, 4vw, 48px);
    background:
      radial-gradient(circle at 82% 22%, rgba(15, 118, 110, 0.16), transparent 19rem),
      linear-gradient(135deg, #fffdf8, #f0e3d2);
    box-shadow: 0 24px 64px rgba(72, 45, 25, 0.1);
  }

  .festival-hero::after {
    content: "";
    position: absolute;
    right: -7rem;
    bottom: -13rem;
    width: 27rem;
    height: 27rem;
    border: 4.5rem solid rgba(165, 72, 33, 0.06);
    border-radius: 50%;
  }

  .festival-hero__copy,
  .festival-hero__facts { position: relative; z-index: 1; }

  .festival-eyebrow {
    margin: 0 0 0.65rem;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .festival-hero h1 {
    margin: 0;
    font-family: var(--ke-font-sans);
    font-size: clamp(3rem, 6.6vw, 5.8rem);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .festival-hero h1 em { color: var(--primary); font-style: normal; font-weight: inherit; }
  .festival-hero__copy > p:last-child {
    max-width: 690px;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.6vw, 1.12rem);
    line-height: 1.55;
  }

  .festival-hero__facts {
    display: grid;
    grid-template-columns: auto minmax(160px, 1fr);
    min-width: min(100%, 360px);
    margin: 0;
    padding: 0.85rem 0;
    border-block: 1px solid rgba(121, 48, 20, 0.18);
  }
  .festival-hero__facts div { padding-inline: 0.8rem; border-left: 1px solid rgba(121, 48, 20, 0.12); }
  .festival-hero__facts div:first-child { border-left: 0; }
  .festival-hero__facts dt {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .festival-hero__facts dd {
    margin: 0.15rem 0 0;
    font-family: var(--ke-font-sans);
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .festival-month-nav {
    position: sticky;
    top: calc(var(--ke-site-header-bar-height) + 0.55rem);
    z-index: 20;
    display: flex;
    width: max-content;
    max-width: 100%;
    margin: 0.8rem auto clamp(1.8rem, 4vw, 3rem);
    padding: 0.32rem;
    overflow-x: auto;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    box-shadow: 0 10px 28px rgba(72, 45, 25, 0.1);
    backdrop-filter: blur(16px);
    scrollbar-width: none;
  }
  .festival-month-nav::-webkit-scrollbar { display: none; }
  .festival-month-nav a {
    flex: 0 0 auto;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.79rem;
    font-weight: 780;
    text-decoration: none;
  }
  .festival-month-nav a:hover { background: var(--bg-soft); color: var(--primary-strong); }
  .festival-month-nav a span:first-child { display: none; }

  .festival-month {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    scroll-margin-top: 9rem;
  }

  .festival-month__rail {
    position: relative;
    align-self: stretch;
    min-height: 100%;
  }
  .festival-month__rail::after {
    content: "";
    position: absolute;
    top: 0.76rem;
    left: 0.6rem;
    bottom: -1px;
    width: 1px;
    background: linear-gradient(var(--primary), rgba(165, 72, 33, 0.18));
  }
  .festival-month:last-child .festival-month__rail::after { bottom: 55%; }
  .festival-month__shelf {
    position: sticky;
    top: calc(var(--ke-site-header-bar-height) + 4.35rem);
    z-index: 3;
    min-height: 6.8rem;
  }
  .festival-month__marker {
    position: absolute;
    top: 0.42rem;
    left: 0.22rem;
    z-index: 1;
    width: 0.82rem;
    height: 0.82rem;
    border: 3px solid var(--surface);
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 1px var(--primary);
  }
  .festival-month__heading {
    padding: 0.05rem 0.4rem 0 1.75rem;
    text-align: left;
  }
  .festival-month__heading h2 {
    margin: 0;
    font-family: var(--ke-font-sans);
    font-size: clamp(1.22rem, 1.8vw, 1.55rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .festival-month__symbol {
    display: block;
    margin-top: 0.42rem;
    color: var(--accent);
    font-size: 0.92rem;
    line-height: 1;
  }
  .festival-month__heading p {
    max-width: 96px;
    margin: 0.32rem 0 0;
    color: var(--muted);
    font-size: 0.67rem;
    line-height: 1.35;
  }
  .festival-month__cards {
    min-width: 0;
    padding: 0 0 clamp(1rem, 1.4vw, 1.35rem) 1.4rem;
  }

  .festival-row {
    display: grid;
    align-items: stretch;
    gap: clamp(0.62rem, 1vw, 0.88rem);
    width: var(--festival-row-width);
  }
  .festival-row + .festival-row { margin-top: clamp(0.62rem, 1vw, 0.88rem); }

  .festival-card {
    position: relative;
    min-width: 0;
    aspect-ratio: var(--festival-card-aspect);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: clamp(10px, 1.15vw, 16px);
    background: #31261f;
    box-shadow: 0 9px 24px rgba(52, 32, 18, 0.14);
    isolation: isolate;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .festival-card:hover {
    border-color: rgba(255, 255, 255, 0.72);
    box-shadow: 0 12px 28px rgba(52, 32, 18, 0.18);
  }
  .festival-card__link { display: block; width: 100%; height: 100%; color: #fff; text-decoration: none; }
  .festival-card__link:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.94);
    outline-offset: -5px;
    border-radius: inherit;
  }
  .festival-card__media { position: absolute; inset: 0; margin: 0; }
  .festival-card__media img { width: 100%; height: 100%; object-fit: cover; }

  .festival-card__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(20, 13, 9, 0.42) 0%, transparent 30%),
      linear-gradient(0deg, rgba(20, 13, 9, 0.52) 0%, rgba(20, 13, 9, 0.16) 46%, transparent 70%);
    pointer-events: none;
  }
  .festival-card--document .festival-card__veil {
    background:
      linear-gradient(180deg, rgba(20, 13, 9, 0.36) 0%, transparent 20%),
      linear-gradient(0deg, rgba(20, 13, 9, 0.56) 0%, rgba(20, 13, 9, 0.18) 34%, transparent 58%);
  }

  .festival-card__topline {
    position: absolute;
    top: clamp(0.62rem, 1.2vw, 0.9rem);
    right: clamp(0.62rem, 1.2vw, 0.9rem);
    left: clamp(0.62rem, 1.2vw, 0.9rem);
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4rem;
  }
  .festival-card__date,
  .festival-card__status {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.22rem 0.42rem;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 999px;
    background: rgba(28, 19, 14, 0.7);
    font-size: clamp(0.56rem, 0.68vw, 0.65rem);
    font-weight: 800;
    line-height: 1.15;
    white-space: nowrap;
    backdrop-filter: blur(8px);
  }
  .festival-card__date {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .festival-card__status {
    flex: 0 0 auto;
    max-width: 100%;
    gap: 0.3rem;
    background: rgba(255, 253, 248, 0.9);
    color: #38281f;
  }
  .festival-card__status i {
    flex: 0 0 auto;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .festival-card--program-pending .festival-card__status i,
  .festival-card--date-pending .festival-card__status i { background: #bd7b13; }

  .festival-card__caption {
    position: absolute;
    right: clamp(0.48rem, 0.85vw, 0.72rem);
    bottom: clamp(0.48rem, 0.85vw, 0.72rem);
    left: clamp(0.48rem, 0.85vw, 0.72rem);
    z-index: 2;
    min-width: 0;
    padding: clamp(0.58rem, 0.92vw, 0.78rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: clamp(9px, 1vw, 13px);
    background:
      linear-gradient(135deg, rgba(28, 21, 17, 0.78), rgba(16, 13, 11, 0.56));
    box-shadow:
      0 10px 24px rgba(12, 8, 6, 0.22),
      inset 0 1px rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(14px) saturate(125%);
    backdrop-filter: blur(14px) saturate(125%);
  }
  .festival-card__caption p {
    margin: 0.3rem 0 0;
    color: rgba(255, 255, 255, 0.86);
    overflow: hidden;
    font-size: clamp(0.6rem, 0.74vw, 0.68rem);
    font-weight: 680;
    line-height: 1.35;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.36);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .festival-card__caption h3 {
    display: -webkit-box;
    max-width: 24ch;
    margin: 0;
    text-wrap: balance;
    font-family: var(--ke-font-sans);
    overflow: hidden;
    font-size: clamp(1rem, 1.42vw, 1.42rem);
    font-weight: 820;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .festival-card__theme {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    margin-top: 0.42rem;
    padding: 0.25rem 0.48rem;
    overflow: hidden;
    border: 1px solid rgba(176, 240, 230, 0.25);
    border-radius: 999px;
    background: rgba(48, 101, 93, 0.32);
    color: rgba(232, 255, 251, 0.96);
    font-size: clamp(0.56rem, 0.66vw, 0.63rem);
    font-weight: 740;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .festival-card__theme i {
    flex: 0 0 auto;
    display: block;
    width: 0.78rem;
    height: 0.78rem;
    margin-right: 0.3rem;
    background: currentColor;
    -webkit-mask: var(--festival-category-icon) center / contain no-repeat;
    mask: var(--festival-category-icon) center / contain no-repeat;
  }
  .festival-card__theme span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .festival-row--4 .festival-card__topline { gap: 0.28rem; }
  .festival-row--4 .festival-card__date,
  .festival-row--4 .festival-card__status {
    min-height: 1.22rem;
    padding: 0.18rem 0.32rem;
    font-size: clamp(0.52rem, 0.61vw, 0.59rem);
  }
  .festival-row--4 .festival-card__status { gap: 0.22rem; }
  .festival-row--4 .festival-card__status i {
    width: 0.36rem;
    height: 0.36rem;
