---
import EventLayout from '../../layouts/EventLayout.astro';
import Icon from '../../components/Icon.astro';
import { festivalTimeline, festivalTimelineMonths } from '../../data/festivalTimeline';
import { festivalTimelineMedia } from '../../data/festivalTimelineMedia';
import { packFestivalTimeline } from '../../lib/festivalTimelineLayout';
import {
  absoluteUrl,
  SITE_NAME,
  withBase,
} from '../../lib/events';

const canonicalUrl = absoluteUrl('/festivali/');
const title = `Фестивали Калининградской области 2026 | ${SITE_NAME}`;
const description = 'Календарь фестивалей Калининграда и области с июля по декабрь 2026 года: даты, города, направления и честный статус программ.';
const compactDate = (value: string) => value
  .replace('января', 'янв')
  .replace('февраля', 'фев')
  .replace('марта', 'мар')
  .replace('апреля', 'апр')
  .replace('мая', 'мая')
  .replace('июня', 'июн')
  .replace('июля', 'июл')
  .replace('августа', 'авг')
  .replace('сентября', 'сен')
  .replace('октября', 'окт')
  .replace('ноября', 'ноя')
  .replace('декабря', 'дек')
  .replace(/^С /, 'с ');
const compactStatus = {
  announced: 'официально',
  'program-pending': 'программа позже',
  'date-pending': 'дата уточняется',
} as const;
const denseCompactStatus = {
  announced: 'официально',
  'program-pending': 'прогр. позже',
  'date-pending': 'дата позже',
} as const;
const denseDateLabel = (slug: string, fallback: string) => ({
  shedevry: '1.10–29.11',
  ostrova: '24.10–3.11',
  'klub-puteshestvennikov': 'окт–дек',
  'jazz-v-filarmonii': '13–18.11',
}[slug] || fallback);
const festivalIconPath = (filename: string) => `/assets/icons/festival-categories/${filename}`;
const festivalCategoryIcons: Record<string, string[]> = {
  'city-jazz': ['120598-saxophone.svg', '389324-music.svg'],
  sosedi: ['389063-carrot.svg', '389494-users.svg'],
  grozd: ['389063-carrot.svg'],
  'more-vnutri': ['389330-palette.svg'],
  'bolshoy-kaup': ['389241-history.svg', '389291-map-pin.svg'],
  koroche: ['389059-camera.svg', '389461-ticket.svg'],
  mimikriya: ['389330-palette.svg', '389439-star.svg'],
  'territoriya-mira': ['389324-music.svg', '389291-map-pin.svg'],
  'street-food': ['389063-carrot.svg', '389494-users.svg'],
  'zhili-byli': ['103262-theatre-masks.svg'],
  'narodov-mnogo': ['389494-users.svg', '389330-palette.svg'],
  vitaliki: ['389302-mic.svg', '389324-music.svg'],
  'vodnaya-assambleya': ['389003-anchor.svg', '389241-history.svg'],
  shedevry: ['389324-music.svg'],
  'dni-literatury': ['389049-book-open.svg'],
  'tykvennyi-pir': ['389439-star.svg', '389063-carrot.svg'],
  ostrova: ['103262-theatre-masks.svg'],
  'klub-puteshestvennikov': ['389291-map-pin.svg', '389241-history.svg'],
  'v-edinstve': ['389494-users.svg', '389330-palette.svg'],
  'jazz-v-filarmonii': ['120598-saxophone.svg', '389324-music.svg'],
  'dekabristskie-vechera': ['389324-music.svg', '389049-book-open.svg'],
};
const resolvedItems = festivalTimeline.map((item) => {
  const mediaRecord = festivalTimelineMedia[item.slug as keyof typeof festivalTimelineMedia];
  if (!mediaRecord || mediaRecord.semanticClass !== item.mediaMode) {
    throw new Error(`Festival media review is missing or stale for ${item.slug}`);
  }
  const naturalAspect = item.imageWidth / item.imageHeight;
  const mobileAspect = item.mediaMode === 'document'
    ? (naturalAspect < 4 / 5 ? Math.min(4 / 5, naturalAspect / 0.8) : naturalAspect)
    : 16 / 10;
  return {
    ...item,
    festivalEditionKey: `festival-edition:2026:${item.slug}`,
    href: item.sourceHref,
    absoluteHref: item.sourceHref,
    isExternal: true,
    linkLabel: item.sourceLabel,
    mobileAspect,
    compactDateLabel: compactDate(item.dateLabel),
    compactStatusLabel: compactStatus[item.status],
    compactPlaceLabel: item.slug === 'jazz-v-filarmonii' ? 'Областная филармония' : item.place,
    categoryIcons: (festivalCategoryIcons[item.slug] || ['389439-star.svg']).map(festivalIconPath),
    mediaRecord,
  };
});
const monthSections = festivalTimelineMonths
  .map((month) => {
    const items = resolvedItems.filter((item) => item.monthKey === month.key);
    const seenCategories = new Set<string>();
    const categoryInventory = items.flatMap((item) => {
      if (seenCategories.has(item.category)) return [];
      seenCategories.add(item.category);
      return [{ icon: item.categoryIcons[0], label: item.category }];
    });
    const visibleCategoryIcons = categoryInventory.length >= 5
      ? categoryInventory.slice(0, 3)
      : categoryInventory.slice(0, 4);
    return {
      ...month,
      items,
      categoryInventory,
      visibleCategoryIcons,
      hiddenCategoryCount: categoryInventory.length - visibleCategoryIcons.length,
      rows: packFestivalTimeline(items),
    };
  })
  .filter((month) => month.items.length > 0);
for (const month of monthSections) {
  if (month.rows.reduce((sum, row) => sum + row.items.length, 0) !== month.items.length) {
    throw new Error(`Festival timeline could not safely pack every ${month.label} item`);
  }
}
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Фестивали Калининградской области 2026',
  description,
  url: canonicalUrl,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/') },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: resolvedItems.length,
    itemListElement: resolvedItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: item.absoluteHref,
    })),
  },
}];
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={absoluteUrl('/assets/festivals/timeline/city-jazz.webp')}
  ogImageType="image/webp"
  ogImageWidth={1600}
  ogImageHeight={1067}
  structuredData={structuredData}
  noindex
>
  <main id="main" class="festival-page" data-festival-timeline data-festival-count={resolvedItems.length}>
    <section class="festival-hero" aria-labelledby="festival-title">
      <div class="festival-hero__copy">
        <p class="festival-eyebrow">Календарь региона · июль—декабрь 2026</p>
        <h1 id="festival-title">Время <em>фестивалей</em></h1>
        <p>Музыка, кино, гастрономия, театр и море — фестивали Калининграда и области по месяцам.</p>
      </div>
      <dl class="festival-hero__facts" aria-label="Коротко о календаре">
        <div><dt>Фестивалей</dt><dd>{resolvedItems.length}</dd></div>
        <div><dt>Сезон</dt><dd>Июль—декабрь</dd></div>
      </dl>
    </section>

    <nav class="festival-month-nav" aria-label="Месяцы фестивального календаря">
      {monthSections.map((month) => (
        <a href={`#month-${month.key}`}>
          <span aria-hidden="true">{month.shortLabel}</span>
          <span>{month.label}</span>
        </a>
      ))}
    </nav>

    <section class="festival-guide" aria-label="Как пользоваться календарём">
      <div class="festival-guide__item">
        <span class="festival-guide__icon festival-guide__icon--heart" aria-hidden="true"><Icon name="heart" /></span>
        <p><strong>Сохраняйте любимые</strong><span>Сердце запомнит выбор на этом устройстве.</span></p>
      </div>
      <div class="festival-guide__item">
        <span class="festival-guide__icon" aria-hidden="true">↗</span>
        <p><strong>Проверяйте у организаторов</strong><span>Карточка ведёт на официальный источник или страницу фестиваля.</span></p>
      </div>
      <div class="festival-guide__item">
        <span class="festival-guide__icon" aria-hidden="true">＋</span>
        <p><strong>Подробности и уведомления — позже</strong><span>Сейчас подписка не оформляется и уведомления не отправляются.</span></p>
      </div>
      <span class="festival-guide__live" data-festival-like-live aria-live="polite"></span>
    </section>

    <div class="festival-timeline">
      {monthSections.map((month) => (
        <section
          id={`month-${month.key}`}
          class="festival-month"
          aria-labelledby={`month-title-${month.key}`}
          data-festival-month={month.key}
        >
          <header class="festival-month__rail">
            <div class="festival-month__shelf">
              <div class="festival-month__marker" aria-hidden="true"></div>
              <div class="festival-month__heading">
                <h2 id={`month-title-${month.key}`}>{month.label}</h2>
                <ul class="festival-month__categories" aria-label={`Категории фестивалей в ${month.label.toLowerCase()}`}>
                  {month.visibleCategoryIcons.map((category) => (
                    <li aria-label={category.label}>
                      <i
                        aria-hidden="true"
                        style={`--festival-category-icon:url("${withBase(category.icon)}");`}
                      ></i>
                    </li>
                  ))}
                  {month.hiddenCategoryCount > 0 && (
                    <li
                      class="festival-month__categories-more"
                      aria-label={`Ещё категорий: ${month.hiddenCategoryCount}`}
                    >+{month.hiddenCategoryCount}</li>
                  )}
                </ul>
                <span class="festival-month__categories-all">
                  {month.categoryInventory.map((category) => category.label).join(', ')}
                </span>
                <span class="festival-month__symbol" aria-hidden="true">{month.symbol}</span>
                <p>{month.mood}</p>
              </div>
            </div>
          </header>

          <div class="festival-month__cards">
            {month.rows.map((row, rowIndex) => (
              <div
                class:list={['festival-row', `festival-row--${row.items.length}`]}
                style={`grid-template-columns:${row.columnWeights.map((weight) => `${weight.toFixed(4)}fr`).join(' ')};--festival-row-width:${(row.widthFraction * 100).toFixed(2)}%;`}
                data-festival-row
                data-row-size={row.items.length}
                data-row-index={rowIndex}
                data-row-normalized-height={row.normalizedMediaHeight.toFixed(4)}
                data-row-width-fraction={row.widthFraction.toFixed(4)}
                data-row-remainder={row.isRemainder ? 'true' : 'false'}
                data-row-only={month.rows.length === 1 ? 'true' : 'false'}
              >
                {row.items.map((baseItem, itemIndex) => {
                  const item = resolvedItems.find((candidate) => candidate.slug === baseItem.slug)!;
                  const frameAspect = row.columnWeights[itemIndex];
                  const cropFraction = row.cropFractions[itemIndex];
                  const denseRow = row.items.length === 4;
                  const compactStatusRow = denseRow || row.items.length === 2;
                  const visibleDateLabel = denseDateLabel(item.slug, item.compactDateLabel);
                  const visibleStatusLabel = compactStatusRow
                    ? denseCompactStatus[item.status]
                    : item.compactStatusLabel;
                  return (
                    <article
                      class:list={[
                        'festival-card',
                        `festival-card--${item.mediaMode}`,
                        `festival-card--${item.status}`,
                      ]}
                      style={`--festival-card-aspect:${frameAspect.toFixed(5)};--festival-mobile-aspect:${item.mobileAspect.toFixed(5)};`}
                      data-festival-card={item.slug}
                      data-media-mode={item.mediaMode}
                      data-crop-fraction={cropFraction.toFixed(4)}
                      data-protected-crop-fit="cover"
                      data-media-source-kind={item.mediaRecord.sourceKind}
                      data-media-confidence={item.mediaRecord.classificationConfidence}
                    >
                      <a
                        class="festival-card__link"
                        href={item.href}
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noreferrer' : undefined}
                        aria-label={`${item.title}. ${item.dateLabel}. ${item.place}. ${item.statusLabel}. Источник: ${item.linkLabel}`}
                      >
                        <figure class="festival-card__media">
                          <img
                            src={withBase(item.image)}
                            width={item.imageWidth}
                            height={item.imageHeight}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            style={item.objectPosition ? `object-position:${item.objectPosition};` : undefined}
                          />
                        </figure>
                        <div class="festival-card__veil" aria-hidden="true"></div>
                        <div class="festival-card__topline">
                          <span class="festival-card__date" title={item.dateLabel}>{visibleDateLabel}</span>
                          <span class="festival-card__status" title={item.statusLabel}>{visibleStatusLabel}</span>
                        </div>
                        <div class="festival-card__caption">
                          <h3>{item.title}</h3>
                          <p class="festival-card__place" title={item.place}>{item.compactPlaceLabel}</p>
                          <span class="festival-card__theme" title={item.category}>
                            <span class="festival-card__theme-icons" aria-hidden="true">
                              {item.categoryIcons.map((icon, iconIndex) => (
                                <i
                                  class:list={[iconIndex > 0 && 'festival-card__theme-icon--secondary']}
                                  style={`--festival-category-icon:url("${withBase(icon)}");`}
                                ></i>
                              ))}
                            </span>
                            <span>{item.category}</span>
                          </span>
                        </div>
                      </a>
                      <button
                        type="button"
                        class="festival-card__like"
                        data-festival-like
                        data-festival-key={item.festivalEditionKey}
                        data-festival-title={item.title}
                        aria-pressed="false"
                        aria-label={`Отметить как понравившийся фестиваль: ${item.title}`}
                        title="Отметить как понравившийся"
                      >
                        <Icon name="heart" />
                      </button>
                    </article>
                  );
                })}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</EventLayout>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'ke_festival_likes_v1';
    const buttons = [...document.querySelectorAll('[data-festival-like]')];
    if (!buttons.length) return;

    let favorites = new Set();
    try {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      if (Array.isArray(stored)) favorites = new Set(stored.filter((value) => typeof value === 'string'));
    } catch {}

    const live = document.querySelector('[data-festival-like-live]');
    let liveTimer = 0;
    const announce = (message) => {
      if (!live) return;
      window.clearTimeout(liveTimer);
      live.textContent = message;
      live.classList.add('is-visible');
      liveTimer = window.setTimeout(() => live.classList.remove('is-visible'), 2600);
    };

    const updateButton = (button) => {
      const key = button.dataset.festivalKey || '';
      const title = button.dataset.festivalTitle || 'Фестиваль';
      const liked = favorites.has(key);
      button.setAttribute('aria-pressed', liked ? 'true' : 'false');
      button.setAttribute(
        'aria-label',
        liked
          ? `Убрать из понравившихся фестивалей: ${title}`
          : `Отметить как понравившийся фестиваль: ${title}`,
      );
      button.title = liked ? 'Убрать из понравившихся' : 'Отметить как понравившийся';
    };

    buttons.forEach((button) => {
      updateButton(button);
      button.addEventListener('click', () => {
        const key = button.dataset.festivalKey || '';
        const title = button.dataset.festivalTitle || 'Фестиваль';
        if (!key) return;
        const liked = !favorites.has(key);
        if (liked) favorites.add(key);
        else favorites.delete(key);
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
        } catch {
          if (liked) favorites.delete(key);
          else favorites.add(key);
          updateButton(button);
          announce(`${title}: не удалось сохранить отметку — браузер блокирует локальное хранилище.`);
          return;
        }
        updateButton(button);
        announce(
          liked
            ? `${title}: отметили как понравившееся. Сохранено только в этом браузере.`
            : `${title} — убрано из любимых.`,
        );
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-reset-personalization]')) return;
      try { localStorage.removeItem(STORAGE_KEY); } catch {}
      favorites.clear();
      buttons.forEach(updateButton);
    });
  })();
</script>

<style>
  .festival-page {
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.4rem) 0 clamp(5.5rem, 8vw, 7rem);
    font-family: var(--ke-font-sans);
  }

  .festival-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 5vw, 5rem);
    min-height: 270px;
    padding: clamp(1.8rem, 4vw, 3.35rem);
    overflow: hidden;
    border: 1px solid rgba(121, 48, 20, 0.13);
    border-radius: clamp(28px, 4vw, 48px);
    background:
      radial-gradient(circle at 82% 22%, rgba(15, 118, 110, 0.16), transparent 19rem),
      linear-gradient(135deg, #fffdf8, #f0e3d2);
    box-shadow: 0 24px 64px rgba(72, 45, 25, 0.1);
  }

  .festival-hero::after {
    content: "";
    position: absolute;
    right: -7rem;
    bottom: -13rem;
    width: 27rem;
    height: 27rem;
    border: 4.5rem solid rgba(165, 72, 33, 0.06);
    border-radius: 50%;
  }

  .festival-hero__copy,
  .festival-hero__facts { position: relative; z-index: 1; }

  .festival-eyebrow {
    margin: 0 0 0.65rem;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .festival-hero h1 {
    margin: 0;
    font-family: var(--ke-font-sans);
    font-size: clamp(3rem, 6.6vw, 5.8rem);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .festival-hero h1 em { color: var(--primary); font-style: normal; font-weight: inherit; }
  .festival-hero__copy > p:last-child {
    max-width: 690px;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.6vw, 1.12rem);
    line-height: 1.55;
  }

  .festival-hero__facts {
    display: grid;
    grid-template-columns: auto minmax(160px, 1fr);
    min-width: min(100%, 360px);
    margin: 0;
    padding: 0.85rem 0;
    border-block: 1px solid rgba(121, 48, 20, 0.18);
  }
  .festival-hero__facts div { padding-inline: 0.8rem; border-left: 1px solid rgba(121, 48, 20, 0.12); }
  .festival-hero__facts div:first-child { border-left: 0; }
  .festival-hero__facts dt {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .festival-hero__facts dd {
    margin: 0.15rem 0 0;
    font-family: var(--ke-font-sans);
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .festival-month-nav {
    position: sticky;
    top: calc(var(--ke-site-header-bar-height) + 0.55rem);
    z-index: 20;
    display: flex;
    width: max-content;
    max-width: 100%;
    margin: 0.8rem auto clamp(1.8rem, 4vw, 3rem);
    padding: 0.32rem;
    overflow-x: auto;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    box-shadow: 0 10px 28px rgba(72, 45, 25, 0.1);
    backdrop-filter: blur(16px);
    scrollbar-width: none;
  }
  .festival-month-nav::-webkit-scrollbar { display: none; }
  .festival-month-nav a {
    flex: 0 0 auto;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.79rem;
    font-weight: 780;
    text-decoration: none;
  }
  .festival-month-nav a:hover { background: var(--bg-soft); color: var(--primary-strong); }
  .festival-month-nav a span:first-child { display: none; }

  .festival-guide {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0 0 clamp(1.8rem, 4vw, 3rem);
    overflow: visible;
    border: 1px solid rgba(121, 48, 20, 0.12);
    border-radius: 18px;
    background: rgba(255, 253, 248, 0.76);
    box-shadow: 0 12px 34px rgba(72, 45, 25, 0.07);
  }
  .festival-guide__item {
    display: grid;
    grid-template-columns: 2.35rem minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.92rem 1rem;
    border-left: 1px solid rgba(121, 48, 20, 0.1);
  }
  .festival-guide__item:first-child { border-left: 0; }
  .festival-guide__icon {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(15, 118, 110, 0.09);
    color: #0f766e;
    font-size: 1.15rem;
    font-weight: 760;
  }
  .festival-guide__icon--heart {
    background: rgba(165, 72, 33, 0.1);
    color: var(--primary);
  }
  .festival-guide__icon :global(svg) { width: 1.15rem; height: 1.15rem; fill: currentColor; }
  .festival-guide__item p { min-width: 0; margin: 0; line-height: 1.25; }
  .festival-guide__item strong {
    display: block;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 790;
  }
  .festival-guide__item p span {
    display: block;
    margin-top: 0.18rem;
    color: var(--muted);
    font-size: 0.74rem;
  }
  .festival-guide__live {
    position: fixed;
    right: 1.2rem;
    bottom: 1.2rem;
    z-index: 60;
    max-width: min(25rem, calc(100vw - 2rem));
    padding: 0.72rem 0.9rem;
    border: 1px solid rgba(121, 48, 20, 0.14);
    border-radius: 12px;
    background: rgba(255, 253, 248, 0.97);
    box-shadow: 0 14px 40px rgba(36, 24, 16, 0.2);
    color: var(--text);
