---
import EventLayout from '../../layouts/EventLayout.astro';
import DateListingSurface from '../../components/listings/DateListingSurface.astro';
import PersonalFeedSlot from '../../components/PersonalFeedSlot.astro';
import { absoluteUrl, getTomorrowDate, getTomorrowEvents, SITE_NAME } from '../../lib/events';

const events = getTomorrowEvents();
const tomorrowDate = getTomorrowDate();
const dateLabel = new Intl.DateTimeFormat('ru-RU', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Kaliningrad' })
  .format(new Date(`${tomorrowDate}T12:00:00+02:00`));
---
<EventLayout title={`События завтра в Калининграде | ${SITE_NAME}`} description={`События на завтра, ${dateLabel}, сгруппированные по времени начала.`} canonicalUrl={absoluteUrl('/zavtra/')} structuredData={[]} headerCurrent="tomorrow">
  <main id="main" class="ke-listing-page" data-presenter-id="tomorrow-page-ready">
    <DateListingSurface kind="tomorrow" title="Завтра" date={tomorrowDate} dateLabel={dateLabel} events={events} />
    <div class="ke-listing-shell"><PersonalFeedSlot context="tomorrow" /></div>
  </main>
</EventLayout>
