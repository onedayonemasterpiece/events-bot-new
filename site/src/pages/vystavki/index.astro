---
import EventLayout from '../../layouts/EventLayout.astro';
import ExhibitionsPersonalSurface from '../../components/ExhibitionsPersonalSurface.astro';
import { absoluteUrl, getCurrentDate, getOngoingExhibitionEvents, SITE_NAME } from '../../lib/events';
import { projectExhibitionsPersonal } from '../../lib/exhibitionsPersonal';

const currentDate = getCurrentDate();
// Keep the established public read path: its date filtering, occurrence-card
// collapse and exporter suppression run before the presentation projection.
const projection = projectExhibitionsPersonal(getOngoingExhibitionEvents(), currentDate);
const newLabel = projection.newItems.length === 1 ? 'новая' : 'новых';
const canonicalUrl = absoluteUrl('/vystavki/');
const title = `Выставки в Калининграде и области | ${SITE_NAME}`;
const description = `Текущие и ближайшие выставки: новые открытия, важные события и длинные форматы по состоянию на ${currentDate}.`;
const headerBadge = projection.newItems.length
  ? { key: 'exhibitions' as const, text: `${projection.newItems.length} ${newLabel}` }
  : undefined;
---

<EventLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  structuredData={[]}
  headerCurrent="exhibitions"
  headerBadge={headerBadge}
  heroChrome="immersive"
>
  <div
    data-ds-family="ExhibitionsRouteComposition"
    data-ds-version="1"
    data-ds-variant="personal-immersive"
    data-ds-state={projection.items.length ? 'populated' : 'empty'}
  >
    <ExhibitionsPersonalSurface projection={projection} />
  </div>
</EventLayout>
