---
import GastronomyCollectionSurface from '../../../components/GastronomyCollectionSurface.astro';
import EventLayout from '../../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, SITE_NAME } from '../../../lib/events';
import { resolveGastronomyCollection, staticCollectionRegistry } from '../../../lib/staticCollections';

const resolved = resolveGastronomyCollection(getEvents());
const registryStatus = staticCollectionRegistry.find((entry) => entry.key === 'gastronomy')?.status || 'blocked';
const collection = {
  ...resolved,
  publicationStatus: resolved.publicationStatus === 'blocked'
    ? 'blocked' as const
    : registryStatus === 'public' ? resolved.publicationStatus : 'shadow' as const,
};
const title = `Гастрономические события Калининграда и области | ${SITE_NAME}`;
const description = 'Дегустации, гастроужины, фестивали еды и другие подтверждённые гастрономические события.';
const noindex = registryStatus !== 'public' || collection.publicationStatus !== 'public' || ['blocked', 'dormant'].includes(collection.lifecycle);
---
<EventLayout title={title} description={description} canonicalUrl={absoluteUrl('/podborki/gastronomiya/')} structuredData={[]} mobileSection="search" noindex={noindex}>
  <GastronomyCollectionSurface collection={collection} />
</EventLayout>
