---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CollectionCatalog from '../../components/CollectionCatalog.astro';
import EventLayout from '../../layouts/EventLayout.astro';
import { absoluteUrl, getEvents, siteHomeHref, SITE_NAME } from '../../lib/events';
import { getCollectionCatalogEntries, resolveGastronomyCollection } from '../../lib/staticCollections';

const title = `Подборки событий | ${SITE_NAME}`;
const description = 'Тематические подборки событий Калининграда и области с проверенным статусом публикации.';
const collectionCatalogEntries = getCollectionCatalogEntries(resolveGastronomyCollection(getEvents()).lifecycle);
const availableCount = collectionCatalogEntries.filter((entry) => Boolean(entry.path)).length;
---
<EventLayout title={title} description={description} canonicalUrl={absoluteUrl('/podborki/')} structuredData={[]} mobileSection="search">
  <main
    id="main"
    data-ds-family="CollectionCatalogRouteComposition"
    data-ds-version="1"
    data-ds-variant="publication-status-catalog"
    data-ds-state={`${availableCount ? 'available' : 'empty'} ${collectionCatalogEntries.length - availableCount ? 'deferred-items' : 'all-public'}`}
    data-static-collection-catalog
  >
    <div class="page-shell page-shell--collection-catalog">
      <Breadcrumbs parents={[{ label:'Афиша', href:siteHomeHref() }]} current="Подборки" />
      <section class="section-card"><div class="section-card__inner">
        <p class="eyebrow">По интересам</p>
        <h1>Подборки событий</h1>
        <p class="lead">В каталоге видны только опубликованные, восстанавливаемые или запланированные подборки. Заблокированные проверки сюда не попадают.</p>
      </div></section>
      <CollectionCatalog entries={collectionCatalogEntries} />
    </div>
  </main>
</EventLayout>

<style>
  .page-shell--collection-catalog {
    display: grid;
    gap: var(--ke-space-lg);
  }
</style>