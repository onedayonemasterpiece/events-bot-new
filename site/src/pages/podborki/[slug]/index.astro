---
import AdaptiveEventCardGrid from '../../../components/AdaptiveEventCardGrid.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FreeCollectionSurface from '../../../components/FreeCollectionSurface.astro';
import EventLayout from '../../../layouts/EventLayout.astro';
import {
  getMaterializedSearchCollection,
  getMaterializedSearchCollectionDateRange,
  getMaterializedSearchCollectionEvents,
  getMaterializedSearchCollectionFallbackEvents,
  getMaterializedSearchCollectionReferenceDate,
  materializedSearchCollections,
} from '../../../data/searchCollections';
import { absoluteUrl, displayDateValue, getPreviewBuild, siteHomeHref, SITE_NAME, withBase } from '../../../lib/events';

export function getStaticPaths() {
  return materializedSearchCollections.map((collection) => ({ params: { slug: collection.slug } }));
}

const { slug } = Astro.params;
const collection = getMaterializedSearchCollection(String(slug));
if (!collection) throw new Error(`Unknown materialized Search collection: ${slug}`);
const events = getMaterializedSearchCollectionEvents(collection.slug);
const collectionDateRange = getMaterializedSearchCollectionDateRange(collection.slug);
const fallbackEvents = events.length ? [] : getMaterializedSearchCollectionFallbackEvents(collection.slug);
const canonicalUrl = absoluteUrl(`/podborki/${collection.slug}/`);
const title = `${collection.title} | ${SITE_NAME}`;
const updatedDate = getPreviewBuild().current_date;
const referenceDate = getMaterializedSearchCollectionReferenceDate();
---
<EventLayout
  title={title}
  description={collection.description}
  canonicalUrl={canonicalUrl}
  structuredData={[]}
  mobileSection={collection.slug === 'besplatnye-sobytiya' ? 'home' : 'search'}
  noindex
>
  {collection.slug === 'besplatnye-sobytiya' ? (
    <FreeCollectionSurface
      title={collection.title}
      description={collection.description}
      criteria={collection.criteria}
      updatedDate={updatedDate}
      referenceDate={referenceDate}
      events={events}
    />
  ) : (
  <main id="main">
    <div class="page-shell page-shell--search-collection">
      <Breadcrumbs
        parents={[
          { label:'Афиша', href:siteHomeHref() },
          { label:'Поиск', href:withBase('/poisk/') },
        ]}
        current={collection.title}
      />

      <section class="section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Готовая подборка</p>
          <h1>{collection.title}</h1>
          <p class="lead">{collection.description}</p>
          <p class="collection-criteria"><strong>Как собрана:</strong> {collection.criteria}</p>
          <p class="muted-note">Данные афиши обновлены {updatedDate}; подборка рассчитана на {referenceDate}. Это не личный сохранённый поиск.</p>
        </div>
      </section>

      <section class="section-card collection-results" aria-labelledby="collection-results-title">
        <div class="section-card__inner">
          <h2 id="collection-results-title">{events.length ? `${events.length} событий` : 'Подходящих событий пока нет'}</h2>
          {events.length ? (
            <AdaptiveEventCardGrid
              events={events}
              mode="flow"
              rowSize={3}
              responsive="progressive"
              mobileFlowMedia
              rootAttributes={{ 'data-search-collection-results':'' }}
            />
          ) : (
            <>
              {collectionDateRange && (
                <p class="muted-note" data-search-collection-empty-window>
                  На ближайшие выходные, {displayDateValue(collectionDateRange.start)} — {displayDateValue(collectionDateRange.end)}, событий с джазом в названии в актуальной выгрузке нет.
                </p>
              )}
              <p class="muted-note">Критерии оставлены без расширения: мы не добавляем похожие события только ради заполнения страницы.</p>
            </>
          )}
        </div>
      </section>

      {fallbackEvents.length > 0 && (
        <section class="section-card collection-results" aria-labelledby="collection-fallback-title" data-search-collection-fallback>
          <div class="section-card__inner">
            <p class="eyebrow">После этих выходных</p>
            <h2 id="collection-fallback-title">Ближайшие события с джазом в названии</h2>
            <p class="muted-note">Это не совпадения подборки выше, а следующие подтверждённые события из той же актуальной выгрузки.</p>
            <AdaptiveEventCardGrid
              events={fallbackEvents}
              mode="flow"
              rowSize={3}
              responsive="progressive"
              mobileFlowMedia
              rootAttributes={{ 'data-search-collection-fallback-results':'' }}
            />
          </div>
        </section>
      )}
    </div>
  </main>
  )}
</EventLayout>

<style>
  .collection-results { margin-top: 1rem; }
  .collection-criteria { max-width: 64ch; }
</style>
