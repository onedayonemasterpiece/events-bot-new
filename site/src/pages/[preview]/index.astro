---
import EventLayout from '../../layouts/EventLayout.astro';
import AdaptiveEventCardGrid from '../../components/AdaptiveEventCardGrid.astro';
import { materializedSearchCollections } from '../../data/searchCollections';
import { collapseOccurrenceCards } from '../../lib/eventOccurrences';
import {
  absoluteUrl,
  getEvents,
  getPreviewBuild,
  PREVIEW_BUILD_ID,
  SITE_NAME,
  withBase,
} from '../../lib/events';
import type { PreviewEvent } from '../../lib/types';

export function getStaticPaths() {
  return [{ params: { preview: '__preview' } }];
}

const events = getEvents();
const build = getPreviewBuild();
const canonicalUrl = absoluteUrl('/__preview/');
const title = `Единый прототип статических страниц | ${SITE_NAME}`;
const description = 'Закрытая от индексации адаптивная сборка всех основных типов статических страниц KenigEvents на свежих реальных данных.';

const preferredSpecimenIds = [5658, 6710, 5370, 6686, 4913, 7001];
const collapsedEvents = collapseOccurrenceCards(events, 'per-family');
const specimens: PreviewEvent[] = [];
const seen = new Set<number>();
for (const event of collapsedEvents) {
  if (!preferredSpecimenIds.includes(event.id)) continue;
  specimens.push(event);
  seen.add(event.id);
}
for (const event of collapsedEvents) {
  if (specimens.length >= 6) break;
  if (seen.has(event.id)) continue;
  specimens.push(event);
  seen.add(event.id);
}
specimens.sort((a, b) => {
  const ai = preferredSpecimenIds.indexOf(a.id);
  const bi = preferredSpecimenIds.indexOf(b.id);
  return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);
});

const eventDetailRepresentative = specimens[0];
if (!eventDetailRepresentative) throw new Error('Preview hub requires one real event-detail representative');

const ownerFacingArchetypes = [
  { id: 'home', href: '/', label: 'Главная', note: 'Главная страница и полезный cold-start' },
  { id: 'today', href: '/segodnya/', label: 'Сегодня', note: 'События текущей даты' },
  { id: 'tomorrow', href: '/zavtra/', label: 'Завтра', note: 'Следующий день' },
  { id: 'weekend', href: '/vyhodnye/', label: 'Выходные', note: 'Ближайшие выходные' },
  { id: 'popular', href: '/populyarnoe/', label: 'Популярное', note: 'Desktop V28 и отдельная mobile-композиция' },
  { id: 'collections', href: '/podborki/besplatnye-sobytiya/', label: 'Подборки', note: 'Материализованная подборка на реальных данных' },
  { id: 'festivals', href: '/festivali/', label: 'Фестивали', note: 'Календарный таймлайн июля — декабря' },
  { id: 'exhibitions', href: '/vystavki/', label: 'Выставки', note: 'Каталог выставок' },
  { id: 'favorites', href: '/izbrannoe/', label: 'Избранное', note: 'Сохранённые будущие события' },
  { id: 'search', href: '/poisk/', label: 'Поиск', note: 'Экран авторизованного поиска' },
  { id: 'for-me', href: '/dlya-menya/', label: 'Для меня', note: 'Cold-start и персональная навигация без ложного обещания' },
  { id: 'focus-group', href: '/fokus-gruppa/', label: 'Фокус-группа', note: 'Программа и путь участника' },
  { id: 'artifacts', href: '/artefakty/', label: 'Артефакты', note: 'Исследовательская коллекция или честный unavailable state' },
  { id: 'event-detail', href: `/sobytiya/${eventDetailRepresentative.slug}/`, label: 'Страница события', note: 'Один реальный representative event detail' },
  { id: 'information', href: '/partners/', label: 'Информационная страница', note: 'Партнёры и служебная информация' },
] as const;

type OwnerFacingArchetype = (typeof ownerFacingArchetypes)[number];
type DirectoryLink = {
  href: string;
  label: string;
  note: string;
  archetypeId?: OwnerFacingArchetype['id'];
};

const representativeLink = (id: OwnerFacingArchetype['id']): DirectoryLink => {
  const archetype = ownerFacingArchetypes.find((entry) => entry.id === id);
  if (!archetype) throw new Error(`Unknown owner-facing archetype: ${id}`);
  return {
    href: archetype.href,
    label: archetype.label,
    note: archetype.note,
    archetypeId: archetype.id,
  };
};
const extraLink = (href: string, label: string, note: string): DirectoryLink => ({ href, label, note });

const pageGroups = [
  {
    title: 'Афиша и календарь',
    note: 'Дата-списки показывают каждую дату отдельно; Popular объединяет только взаимно связанные даты.',
    links: [
      representativeLink('home'),
      representativeLink('today'),
      representativeLink('tomorrow'),
      representativeLink('weekend'),
      representativeLink('popular'),
      representativeLink('exhibitions'),
      representativeLink('festivals'),
      representativeLink('event-detail'),
    ],
  },
  {
    title: 'Поиск и подборки',
    note: 'Визуальный Search интегрирован. Реальный авторизованный поиск пока не принят и не заявляется как работающий.',
    links: [
      representativeLink('search'),
      representativeLink('collections'),
      ...materializedSearchCollections
        .filter((collection) => collection.slug !== 'besplatnye-sobytiya')
        .map((collection) => extraLink(
          `/podborki/${collection.slug}/`,
          collection.title,
          collection.description,
        )),
    ],
  },
  {
    title: 'Сервисные разделы',
    note: 'Все разделы доступны из общей адаптивной навигации и возвращают пользователя к афише.',
    links: [
      representativeLink('favorites'),
      representativeLink('for-me'),
      representativeLink('focus-group'),
      representativeLink('artifacts'),
      representativeLink('information'),
      extraLink('/kluby-po-interesam/', 'Клубы по интересам', 'Свежая policy-current проекция подтверждённых клубов'),
      extraLink('/partnerstvo/', 'Стать партнёром', 'Условия сотрудничества'),
    ],
  },
  {
    title: 'Отдельные прототипы и QA',
    note: 'Не входят в основную продуктовую навигацию; нужны для приёмки отдельных механик.',
    links: [
      extraLink('/lab/exhibitions-personal/', 'Выставки · персональный discovery', 'Концепт выставок и персональной выдачи'),
      extraLink('/lab/design-system/', 'Дизайн-система', 'Компоненты и состояния'),
      extraLink('/lab/occurrences/', 'Связанные даты', 'Resolver, formatter и selector'),
      extraLink('/lab/medallions/', 'Медальоны', 'Карточки сущностей'),
    ],
  },
];
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main
    id="main"
    class="prototype-hub"
    data-unified-prototype-hub
    data-owner-archetype-family-count={ownerFacingArchetypes.length}
  >
    <div class="page-shell">
      <section class="prototype-hero">
        <p class="eyebrow">Единый preprod · noindex</p>
        <h1>Все типы страниц в одной адаптивной сборке</h1>
        <p class="lead">Одна и та же ссылка работает на компьютере и телефоне. Внутри — реальные актуальные данные, общая навигация и взаимные ссылки между типами страниц.</p>
        <dl class="prototype-facts">
          <div><dt>Сборка</dt><dd><code>{PREVIEW_BUILD_ID}</code></dd></div>
          <div><dt>Данные на</dt><dd>{build.current_date}</dd></div>
          <div><dt>Событий</dt><dd>{events.length}</dd></div>
          <div><dt>Источник</dt><dd>{build.source}</dd></div>
        </dl>
        <aside class="prototype-warning" aria-label="Статус поиска">
          <strong>Важно про Search</strong>
          <span>В этой сборке принят только визуальный экран. Работоспособность реального авторизованного поиска ещё не подтверждена.</span>
        </aside>
      </section>

      <nav class="prototype-directory" aria-label="Типы страниц прототипа">
        {pageGroups.map((group) => (
          <section class="prototype-group">
            <header><h2>{group.title}</h2><p>{group.note}</p></header>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={withBase(link.href)}
                    data-owner-archetype-family={link.archetypeId}
                  >
                    <span><strong>{link.label}</strong><small>{link.note}</small></span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>

      <section class="prototype-specimens" aria-labelledby="prototype-specimens-title">
        <header>
          <p class="eyebrow">Реальные данные</p>
          <h2 id="prototype-specimens-title">События для сквозной проверки</h2>
          <p>Карточка ведёт на полноценную страницу события; с неё можно вернуться в листинги общей навигацией.</p>
        </header>
        <AdaptiveEventCardGrid
          events={specimens}
          mode="flow"
          rowSize={3}
          responsive="progressive"
          mobileFlowMedia
          rootAttributes={{ 'data-prototype-specimen-grid':'' }}
        />
      </section>
    </div>
  </main>
</EventLayout>

<style>
  .prototype-hub { padding: clamp(1rem, 2.5vw, 2.5rem) 0 4rem; }
  .prototype-hero,
  .prototype-group,
  .prototype-specimens { border: 1px solid color-mix(in srgb, var(--ink, #201712) 14%, transparent); border-radius: 1.5rem; background: var(--paper, #fffaf3); }
  .prototype-hero { padding: clamp(1.25rem, 4vw, 3.5rem); }
  .prototype-hero h1 { max-width: 15ch; margin: .2rem 0 .8rem; font-size: clamp(2.15rem, 6vw, 5.5rem); line-height: .94; letter-spacing: -.055em; }
  .prototype-hero .lead { max-width: 65ch; font-size: clamp(1rem, 1.7vw, 1.3rem); }
  .prototype-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin: 1.5rem 0 0; }
  .prototype-facts div { min-width: 0; padding: .85rem; border-radius: 1rem; background: color-mix(in srgb, var(--brand, #a33f1d) 8%, white); }
  .prototype-facts dt { color: var(--muted, #74685f); font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .prototype-facts dd { margin: .25rem 0 0; overflow-wrap: anywhere; font-weight: 800; }
  .prototype-warning { display: grid; grid-template-columns: auto 1fr; gap: .45rem 1rem; margin-top: 1rem; padding: 1rem; border-radius: 1rem; background: #fff1c9; color: #4f3600; }
  .prototype-directory { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .prototype-group { padding: clamp(1rem, 2vw, 1.5rem); }
  .prototype-group header { min-height: 5.75rem; }
  .prototype-group h2,
  .prototype-specimens h2 { margin: 0 0 .4rem; font-size: clamp(1.4rem, 2.5vw, 2.2rem); }
  .prototype-group p,
  .prototype-specimens p { margin: 0; color: var(--muted, #74685f); }
  .prototype-group ul { display: grid; gap: .5rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .prototype-group a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.25rem; padding: .75rem .9rem; border-radius: 1rem; background: color-mix(in srgb, var(--ink, #201712) 5%, transparent); color: inherit; text-decoration: none; }
  .prototype-group a:hover,
  .prototype-group a:focus-visible { outline: 2px solid var(--brand, #a33f1d); outline-offset: 2px; background: color-mix(in srgb, var(--brand, #a33f1d) 10%, white); }
  .prototype-group a span:first-child { display: grid; gap: .18rem; }
  .prototype-group small { color: var(--muted, #74685f); line-height: 1.25; }
  .prototype-specimens { margin-top: 1rem; padding: clamp(1rem, 2.5vw, 2rem); }
  .prototype-specimens > header { max-width: 60ch; margin-bottom: 1rem; }
  @media (max-width: 760px) {
    .prototype-hub { padding-top: .5rem; }
    .prototype-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prototype-warning { grid-template-columns: 1fr; }
    .prototype-directory { grid-template-columns: 1fr; }
    .prototype-group header { min-height: 0; }
  }
</style>
