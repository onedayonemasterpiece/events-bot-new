---
import EventLayout from '../../layouts/EventLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { absoluteUrl, getEvents, getPreviewBuild, PREVIEW_BUILD_ID, SITE_NAME, withBase } from '../../lib/events';

export function getStaticPaths() {
  return [{ params: { preview: '__preview' } }];
}

const events = getEvents();
const variantA = events.find((event) => event.id === 5878);
const variantB = events.find((event) => event.id === 6322) || events.find((event) => event.id === 4913);
const heroPoster = events.find((event) => event.id === 5878);
const heroAttached = events.find((event) => event.id === 4913);
const heroPhoto = events.find((event) => event.id === 6322);
const heroParallax = events.find((event) => event.id === 5370) || events.find((event) => event.id === 4512);
const build = getPreviewBuild();
const canonicalUrl = absoluteUrl('/__preview/');
const title = `Preview статических страниц событий | ${SITE_NAME}`;
const description = 'Открываемый preview Astro SSG страниц событий для kenigevents.ru.';
---
<EventLayout title={title} description={description} canonicalUrl={canonicalUrl} structuredData={[]}>
  <main id="main">
    <div class="page-shell">
      <section class="section-card">
        <div class="section-card__inner">
          <p class="eyebrow">Astro SSG preview</p>
          <h1 style="max-width: 13ch;">Страницы событий</h1>
          <p class="lead">Публично открываемая preview-сборка под prefix <code>{PREVIEW_BUILD_ID}</code>. Все страницы закрыты от индексации и используют preview canonical.</p>
          <div class="facts-quick" id="today">
            <div class="quick-fact"><span class="quick-fact__mark" aria-hidden="true"></span><div><strong>Источник</strong><span>{build.source}</span></div></div>
            <div class="quick-fact"><span class="quick-fact__mark" aria-hidden="true"></span><div><strong>Сгенерировано</strong><span>{build.generated_at}</span></div></div>
            <div class="quick-fact"><span class="quick-fact__mark" aria-hidden="true"></span><div><strong>Текущая дата данных</strong><span>{build.current_date}</span></div></div>
          </div>
          <div class="source-links">
            <a href={withBase('/segodnya/')}>Сегодня</a>
            <a href={withBase('/vyhodnye/')}>Выходные</a>
            <a href={withBase('/sitemap.xml')}>sitemap.xml</a>
            <a href={withBase('/robots.txt')}>robots.txt</a>
            <a href={withBase('/lab/hero/')}>Hero lab</a>
            <a href={withBase('/lab/hero/review/')}>Hero viewport review</a>
          </div>

          <div class="preview-ab" aria-label="A/B/C/D сравнение hero события">
            <h2>UI-варианты hero события</h2>
            <div class="preview-ab__grid">
              {heroPoster && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${heroPoster.slug}/`)}>
                  <strong>A · Poster Billboard</strong>
                  <span>Полная OCR-афиша без crop, 100vw hero slab и H1/CTA sheet снизу.</span>
                </a>
              )}
              {heroAttached && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${heroAttached.slug}/`)}>
                  <strong>B · Poster Attached Card</strong>
                  <span>Более смелый attach/overlap с сохранением no-crop политики для афиш.</span>
                </a>
              )}
              {heroPhoto && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${heroPhoto.slug}/`)}>
                  <strong>C · Photo Cinematic Sheet</strong>
                  <span>visual_only: крупное cover-изображение и decision sheet, без H1 поверх картинки.</span>
                </a>
              )}
              {heroParallax && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${heroParallax.slug}/`)}>
                  <strong>D · Photo Parallax Sheet</strong>
                  <span>Эксперимент с мягким parallax для visual_only и reduced-motion guard.</span>
                </a>
              )}
            </div>
            <p class="muted-note">Сравнение привязано к разным event pages: можно открыть каждое событие и почувствовать первый экран, а не смотреть технический image-mode.</p>
          </div>

          <div class="preview-ab" aria-label="A/B сравнение карточек ленты">
            <h2>UI A/B для ленты события</h2>
            <div class="preview-ab__grid">
              {variantA && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${variantA.slug}/`)}>
                  <strong>A · одна строка поверх карточки</strong>
                  <span>Контроль: лайк справа снизу, поделиться по центру, «не интересно» слева внутри карточки.</span>
                </a>
              )}
              {variantB && (
                <a class="preview-ab__item" href={withBase(`/sobytiya/${variantB.slug}/`)}>
                  <strong>B · две строки действий</strong>
                  <span>Тест: внутри карточки — календарь/«не интересно», под карточкой справа — «Поделиться» и крупный лайк.</span>
                </a>
              )}
            </div>
            <p class="muted-note">Сравнение намеренно привязано к разным страницам событий: в каждой ленте все карточки используют один вариант, чтобы почувствовать поведение, а не смотреть смешанный макет.</p>
          </div>
        </div>
      </section>

      <section class="section-card" style="margin-top: 1rem;" id="weekend">
        <div class="section-card__inner">
          <h2>Тестовые страницы</h2>
          <div class="cards-grid">
            {events.map((event) => <EventCard event={event} />)}
          </div>
        </div>
      </section>

      <section class="section-card" style="margin-top: 1rem;">
        <div class="section-card__inner">
          <h2>Покрытые состояния</h2>
          <ul class="prose">
            <li>платное событие с ticket-link: event 5878 «Песни СССР»;</li>
            <li>бесплатное / регистрационное событие;</li>
            <li>phone-only CTA;</li>
            <li>source-only CTA без прямого ticket-link;</li>
            <li>длинный H1;</li>
            <li>нет локального изображения — hero fallback;</li>
            <li>слабый адрес — карта скрывается, вместо неё выводится “уточняйте у организатора”;</li>
            <li>«Другие даты» для пары 6437/6438;</li>
            <li>единая статическая лента «Смотрите дальше» без API и без отдельного пользовательского блока для диверсификации.</li>
            <li>явные реакции: лайк с локальным увеличением счётчика, отмена лайка, “не интересно” и компактный локальный журнал явных действий для будущего Supabase ingest.</li>
            <li>A/B UI: страница 5878 использует вариант A с одной строкой действий поверх карточки; страница 6322 использует вариант B с двумя строками и лайком справа под карточкой.</li>
            <li>минимальные листинги /segodnya/ и /vyhodnye/.</li>
          </ul>
        </div>
      </section>

      <section class="section-card" style="margin-top: 1rem;">
        <div class="section-card__inner feedback-report" data-feedback-report>
          <h2>Локальный отчёт по реакциям</h2>
          <p class="muted-note">Preview хранит компактный журнал явных действий только в этом браузере. В production такие события должны уходить в personalization Supabase через same-origin ingest/RPC и агрегироваться в отчёт по anonymous profile id.</p>
          <div class="feedback-report__summary">
            <span>Anonymous profile: <code data-feedback-profile>—</code></span>
            <span data-feedback-summary>Загрузка локального журнала…</span>
          </div>
          <ul class="feedback-report__list" data-feedback-log></ul>
        </div>
      </section>
    </div>
  </main>
</EventLayout>
