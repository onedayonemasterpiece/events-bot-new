---
import FocusConnectivityDiagnostic from '../../../components/FocusConnectivityDiagnostic.astro';
import { absoluteUrl, IS_SECRET_CANDIDATE } from '../../../lib/events';

const supabaseUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_URL || '').replace(/\/+$/u, '');
const relayUrl = (import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL || '').replace(/\/+$/u, '');
const publishableKey = import.meta.env.PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY || '';
const robots = IS_SECRET_CANDIDATE
  ? 'noindex,nofollow,noarchive,nosnippet'
  : 'noindex,nofollow,noarchive';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={absoluteUrl('/fokus-gruppa/diagnostika-ustoychivost/')} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23a74523'/%3E%3C/svg%3E" />
    <title>Проверка устойчивого соединения · Анонсы</title>
    <meta name="description" content="Сравнение прямого и устойчивого соединения с устройства участника фокус-группы." />
  </head>
  <body>
    <FocusConnectivityDiagnostic supabaseUrl={supabaseUrl} relayUrl={relayUrl} publishableKey={publishableKey} />
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { background: #fff7e7; }
  body { min-width: 320px; min-height: 100dvh; margin: 0; background: radial-gradient(circle at 80% 0, rgb(255 193 13 / 14%), transparent 30rem), #fff7e7; }
</style>
