---
import PersonalizationRuntime from '../../components/personalization/PersonalizationRuntime.astro';
import Button from '../../components/design-system/Button.astro';
import FocusLabBadge from '../../components/FocusLabBadge.astro';
import FocusGroupThankYou from '../../components/FocusGroupThankYou.astro';
import FocusGroupInviteShare from '../../components/FocusGroupInviteShare.astro';
import { absoluteUrl, IS_SECRET_CANDIDATE, withBase } from '../../lib/events';
import '../../styles/design-system.css';

const robots = IS_SECRET_CANDIDATE
  ? 'noindex,nofollow,noarchive,nosnippet'
  : 'noindex,nofollow,noarchive';

---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={absoluteUrl('/fokus-gruppa/')} />
    <title>Как проходит фокус-группа · Полюбить Калининград Анонсы</title>
    <meta name="description" content="Программа продуктового прототипа закрытой фокус-группы KenigEvents." />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <meta name="theme-color" content="#fff7e7" />
  </head>
  <body>
    <PersonalizationRuntime />
    <a class="focus-programme__skip" href="#main">К основному содержанию</a>
    <main
      id="main"
      class="focus-programme"
      data-ds-family="FocusGroupProgrammeSurface"
      data-ds-version="1"
      data-ds-variant="research-programme"
      data-ds-state="available"
    >
      <nav class="focus-programme__nav" aria-label="Навигация фокус-группы">
        <a href={withBase('/')} class="focus-programme__back">← Стартовый экран</a>
        <FocusLabBadge label="Фокус-группа" detail="Программа · прототип" />
      </nav>

      <header class="focus-programme__hero">
        <div>
          <p class="focus-programme__eyebrow">30 дней · волнами до 200 человек</p>
          <h1>Проверяем не красоту макета, а пользу в реальном выборе</h1>
        </div>
        <p>
          Открывайте страницы, когда действительно ищете событие. Раз в неделю
          отвечайте на общий NPS, отдельно отмечайте полезность конкретных страниц
          и в любой момент предлагайте улучшение.
        </p>
      </header>

      <section class="focus-programme__journey" aria-labelledby="journey-title">
        <div class="focus-programme__section-head">
          <p class="focus-programme__eyebrow">Путь участника</p>
          <h2 id="journey-title">Четыре понятных шага</h2>
        </div>
        <ol>
          <li><span>01</span><div><strong>Открыть личное приглашение</strong><p>Код живёт во fragment и удаляется из адресной строки на специальной странице.</p></div></li>
          <li><span>02</span><div><strong>Подтвердить свою identity</strong><p>Email-код / magic link или Яндекс. Ссылка, QR и localStorage не являются входом.</p></div></li>
          <li><span>03</span><div><strong>Пользоваться афишей</strong><p>Статические страницы остаются полезными, даже если feedback-сервис недоступен.</p></div></li>
          <li><span>04</span><div><strong>Говорить честно</strong><p>Тон, длина и количество ответов не дают преимуществ и не меняют возможные шансы.</p></div></li>
        </ol>
      </section>

      <section class="focus-programme__signals" aria-labelledby="signals-title">
        <div class="focus-programme__section-head">
          <p class="focus-programme__eyebrow">Не называем всё NPS</p>
          <h2 id="signals-title">У каждого ответа своя задача</h2>
        </div>
        <div class="focus-programme__signal-grid">
          <article><span>Раз в неделю / exit</span><h3>Общий NPS 0–10</h3><p>Вероятность рекомендовать весь сервис знакомым.</p></article>
          <article><span>После полезного действия</span><h3>Полезность 0–10</h3><p>Насколько конкретная страница помогла выбрать или понять событие.</p></article>
          <article><span>Всегда доступно</span><h3>Предложение</h3><p>Свободный текст до 2 000 символов без обязательной оценки.</p></article>
          <article><span>Отдельная проверка</span><h3>Ошибка события</h3><p>Дата, время, место и другие факты не меняются без проверки оператора.</p></article>
        </div>
      </section>

      <FocusGroupThankYou />

      <FocusGroupInviteShare />

      <section class="focus-programme__cta" aria-labelledby="prototype-title">
        <div>
          <p class="focus-programme__eyebrow">Попробовать механику</p>
          <h2 id="prototype-title">Проверить повторный вход и завершение</h2>
          <p>Ссылка и QR выше ведут в сценарий вступления. После него можно выйти из аккаунта, не удаляя участие, и повторить вход.</p>
        </div>
        <div class="focus-programme__cta-actions">
          <Button variant="primary" size="large" href="#focus-invite-share">Ссылка и QR для приглашения</Button>
          <Button variant="secondary" href={withBase('/fokus-gruppa/zavershenie/')}>Посмотреть завершение программы</Button>
        </div>
      </section>

      <aside class="focus-programme__boundary">
        <strong>Текущий candidate запускает browser-local участие.</strong>
        <span>Capacity, отзыв согласия и active membership ещё обязаны стать серверными до публичного набора; email/Yandex используют реальный Auth только при наличии public-конфигурации сборки.</span>
      </aside>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { background: var(--ke-color-canvas); color: var(--ke-color-ink); font-family: var(--ke-font-sans); }
  body { min-width: 320px; min-height: 100dvh; margin: 0; background: radial-gradient(circle at 100% 0, rgb(255 193 13 / 14%), transparent 28rem), var(--ke-color-canvas); }
  .focus-programme { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 1rem 0 4rem; }
  .focus-programme__skip { position: fixed; z-index: 50; top: .5rem; left: .5rem; transform: translateY(-150%); border-radius: .5rem; padding: .7rem 1rem; background: #221a14; color: #fff; font-weight: 800; }
  .focus-programme__skip:focus { transform: none; }
  .focus-programme__nav { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .focus-programme__back { min-height: 44px; display: inline-flex; align-items: center; color: var(--ke-color-brand-700); font-size: .86rem; font-weight: 850; text-decoration: none; }
  .focus-programme__hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); gap: clamp(2rem, 6vw, 5rem); align-items: end; min-height: 580px; border: 1px solid var(--ke-color-line); border-radius: 2rem; padding: clamp(1.4rem, 5vw, 4rem); background: linear-gradient(145deg, #fff, #fff6e5); box-shadow: var(--ke-shadow-2); }
  .focus-programme__eyebrow { margin: 0 0 .55rem; color: var(--ke-color-brand-700); font-size: .72rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .focus-programme__hero h1 { max-width: 13ch; margin: 0; font-size: clamp(3rem, 8vw, 7rem); line-height: .88; letter-spacing: -.065em; text-wrap: balance; }
  .focus-programme__hero > p { margin: 0; color: var(--ke-color-muted); font-size: clamp(1.05rem, 2vw, 1.28rem); line-height: 1.6; }
  .focus-programme__journey,
  .focus-programme__signals,
  .focus-programme__cta { display: grid; grid-template-columns: minmax(220px, .6fr) minmax(0, 1.4fr); gap: 2rem; margin-top: 1rem; border: 1px solid var(--ke-color-line); border-radius: 1.5rem; padding: clamp(1.2rem, 3vw, 2rem); background: var(--ke-color-surface-strong); }
  .focus-programme__section-head h2,
  .focus-programme__cta h2 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.7rem); line-height: 1; letter-spacing: -.04em; }
  .focus-programme__journey ol { display: grid; gap: .55rem; margin: 0; padding: 0; list-style: none; }
  .focus-programme__journey li { display: grid; grid-template-columns: 2.6rem 1fr; gap: .7rem; border-radius: 1rem; padding: .85rem; background: var(--ke-color-canvas); }
  .focus-programme__journey li > span { color: var(--ke-color-brand-600); font-size: .72rem; font-weight: 900; letter-spacing: .08em; }
  .focus-programme__journey li div { display: grid; gap: .22rem; }
  .focus-programme__journey li p { margin: 0; color: var(--ke-color-muted); font-size: .82rem; line-height: 1.45; }
  .focus-programme__signal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .focus-programme__signal-grid article { border-radius: 1rem; padding: 1rem; background: var(--ke-color-canvas); }
  .focus-programme__signal-grid span { color: var(--ke-color-accent-700); font-size: .7rem; font-weight: 850; text-transform: uppercase; letter-spacing: .06em; }
  .focus-programme__signal-grid h3 { margin: .4rem 0 .35rem; font-size: 1.05rem; }
  .focus-programme__signal-grid p { margin: 0; color: var(--ke-color-muted); font-size: .82rem; line-height: 1.45; }
  :global(.focus-thanks) { margin-top: 1rem; }
  .focus-programme__cta { align-items: center; }
  .focus-programme__cta > div > p:last-child { margin: .75rem 0 0; color: var(--ke-color-muted); line-height: 1.5; }
  .focus-programme__cta-actions { display: grid; justify-items: end; gap: .55rem; }
  .focus-programme__boundary { display: grid; gap: .3rem; margin-top: 1rem; border-radius: 1rem; padding: 1rem; background: var(--ke-color-info-50); color: var(--ke-color-info-700); line-height: 1.45; }
  .focus-programme__boundary span { font-size: .84rem; }
  a:focus-visible { outline: 3px solid color-mix(in srgb, var(--ke-color-focus) 60%, transparent); outline-offset: 3px; }

  @media (max-width: 760px) {
    .focus-programme { width: min(100% - 1rem, 1120px); padding-top: .5rem; }
    .focus-programme__hero { grid-template-columns: 1fr; min-height: calc(100dvh - 5rem); align-content: end; }
    .focus-programme__journey,
    .focus-programme__signals,
    .focus-programme__cta { grid-template-columns: 1fr; }
    .focus-programme__signal-grid { grid-template-columns: 1fr; }
    .focus-programme__cta-actions { justify-items: stretch; }
    .focus-programme__cta-actions .ke-button { width: 100%; }
  }
</style>
