---
import PersonalizationRuntime from '../../../components/personalization/PersonalizationRuntime.astro';
import FocusGroupInviteIntake from '../../../components/FocusGroupInviteIntake.astro';
import StaticSiteAuthRuntime from '../../../components/auth/StaticSiteAuthRuntime.astro';
import { absoluteUrl, IS_SECRET_CANDIDATE, withBase } from '../../../lib/events';
import '../../../styles/design-system.css';
const robots = IS_SECRET_CANDIDATE
  ? 'noindex,nofollow,noarchive,nosnippet'
  : 'noindex,nofollow,noarchive';
const pwaServiceWorkerUrl = withBase('/pwa-sw.js');
const pwaServiceWorkerScope = withBase('/');

---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={absoluteUrl('/fokus-gruppa/priglashenie/')} />
    <title>Приглашение в фокус-группу · Полюбить Калининград Анонсы</title>
    <meta name="description" content="Специальный экран продуктового прототипа приглашения в фокус-группу." />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="manifest" href={`${withBase('/fokus-gruppa/manifest.webmanifest')}?v=20260731-product-v2`} />
    <link rel="apple-touch-icon" href={withBase('/assets/pwa/announcements-brand-v2-192.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Анонсы" />
    <meta name="theme-color" content="#fff7e7" />
    <script is:inline define:vars={{ pwaServiceWorkerUrl, pwaServiceWorkerScope }}>
      // Capture Chromium's one-shot prompt before hydrated UI modules run.
      // Without this early listener a fast browser can offer only a shortcut.
      window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        window.__kenigEventsPwaInstallPrompt = event;
      });
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register(pwaServiceWorkerUrl, {
          scope: pwaServiceWorkerScope,
          updateViaCache: 'none',
        }).catch(() => {
          // The install UI stays fail-closed until Chromium confirms that the
          // page is installable through beforeinstallprompt.
        });
      }
    </script>
  </head>
  <body
    data-ds-family="FocusGroupInviteRouteComposition"
    data-ds-version="1"
    data-ds-variant="pwa-membership"
    data-ds-state="pending"
  >
    <PersonalizationRuntime />
    <FocusGroupInviteIntake />
    <StaticSiteAuthRuntime />
    <script>
      const routeRoot = document.body;
      const intakeRoot = document.querySelector('[data-focus-intake]');
      if (intakeRoot instanceof HTMLElement) {
        const syncRouteState = () => {
          const error = intakeRoot.querySelector('[data-intake-error]:not([hidden])');
          const stage = intakeRoot.querySelector('[data-intake-stage]:not([hidden])');
          const pending = intakeRoot.querySelector('[data-intake-pending]:not([hidden])');
          routeRoot.dataset.dsState = error
            ? 'error'
            : stage instanceof HTMLElement
              ? String(stage.dataset.intakeStage || 'active')
              : pending ? 'pending' : 'resolving';
        };
        new MutationObserver(syncRouteState).observe(intakeRoot, {
          subtree:true,
          attributes:true,
          attributeFilter:['hidden'],
        });
        syncRouteState();
      }
    </script>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html { background: var(--ke-color-canvas); color: var(--ke-color-ink); font-family: var(--ke-font-sans); }
  body { min-width: 320px; min-height: 100dvh; margin: 0; background: radial-gradient(circle at 5% 0, rgb(255 193 13 / 15%), transparent 28rem), var(--ke-color-canvas); }
</style>
