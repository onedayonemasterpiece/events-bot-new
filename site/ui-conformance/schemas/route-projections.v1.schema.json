{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KenigEvents route projections v1",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "state_packet",
    "projections"
  ],
  "properties": {
    "schema_version": {
      "const": "kenigevents.ui-conformance.route-projections.v1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "state_packet": {
      "type": "string",
      "minLength": 1
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype_id",
          "route",
          "entity_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "archetype_id": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "pattern": "^/"
          },
          "entity_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^event\\.real\\.[0-9]+$"
            }
          },
          "ordering": {
            "type": "string"
          },
          "evidence_mode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
