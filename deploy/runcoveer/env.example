# Production env files live outside the repository, mode 0600.
# /opt/runcoveer/events/.env.production and /opt/runcoveer/kotopogoda/.env.production
DEPLOY_PREFLIGHT=1
# Set to 0 only after data, direct health, TLS and product preflight pass.


# Optional service-specific authenticated Codex home for the VK excursion writer.
# Mount a persistent owner-provisioned directory writable by the Events service.
# GUIDE_DIGEST_CODEX_HOME=/var/lib/events-guide-codex
# GUIDE_DIGEST_SOL_TIMEOUT_SEC=150
