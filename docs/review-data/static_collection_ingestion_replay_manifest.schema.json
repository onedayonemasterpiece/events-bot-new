{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static_collection_ingestion_replay_manifest.schema.json",
  "title": "Static collection ordinary-ingestion replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "cases"],
  "properties": {
    "schema_version": {
      "const": "static-collection-ingestion-replay-manifest-v1"
    },
    "run_id": {"type": "string", "minLength": 1},
    "db_logical_sha256_before": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "notes": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "adapter",
        "fixture_path",
        "adapter_options",
        "expected"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "adapter": {"enum": ["telegram", "vk", "parser"]},
        "fixture_path": {"type": "string", "minLength": 1},
        "allowed_warm_event_source_fields": {
          "description": "Parser-only acknowledgement of the operational re-import timestamp update.",
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"const": "imported_at"}
        },
        "boundary_class": {
          "enum": [
            "child_directed",
            "family_suitable",
            "joint_family_activity",
            "parents_only",
            "age_rating_only",
            "vague_family",
            "ordinary_adult"
          ]
        },
        "adapter_options": {"type": "object"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "source_url",
            "source_type",
            "first_collection_calls",
            "warm_collection_calls",
            "first_collection_write",
            "warm_collection_write"
          ],
          "properties": {
            "event_id": {"type": "integer", "minimum": 1},
            "source_id": {"type": "integer", "minimum": 1},
            "source_url": {"type": "string", "minLength": 1},
            "source_type": {"type": "string", "minLength": 1},
            "first_collection_calls": {"type": "integer", "minimum": 0, "maximum": 1},
            "warm_collection_calls": {"const": 0},
            "first_collection_write": {"type": "boolean"},
            "warm_collection_write": {"const": false}
          }
        }
      }
    }
  }
}
