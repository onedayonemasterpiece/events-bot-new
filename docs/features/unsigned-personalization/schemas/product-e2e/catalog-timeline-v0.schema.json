{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenigevents.ru/schemas/product-e2e/catalog-timeline-v0.schema.json",
  "title": "Catalog timeline contract v0.2 (real-data draft)",
  "$comment": "Design-only immutable 14+ day replay contract over frozen real production event records. It forbids invented events, dates, facts, cancellations and lifecycle transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_id",
    "timeline_version",
    "timeline_mode",
    "real_data_snapshot",
    "source_authority",
    "source_snapshot_ref",
    "snapshot_taken_at",
    "source_db_fingerprint",
    "as_of_policy",
    "seed",
    "timezone",
    "start_as_of_date",
    "days"
  ],
  "properties": {
    "schema_version": {
      "const": "catalog-timeline/v0.2-draft"
    },
    "timeline_id": {
      "$ref": "#/$defs/stableId"
    },
    "timeline_version": {
      "type": "integer",
      "minimum": 1
    },
    "timeline_mode": {
      "enum": [
        "captured_daily_snapshots",
        "forward_schedule_projection"
      ]
    },
    "real_data_snapshot": {
      "const": true
    },
    "source_authority": {
      "const": "fly_sqlite_production_snapshot"
    },
    "source_snapshot_ref": {
      "$ref": "#/$defs/nonEmpty"
    },
    "snapshot_taken_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_db_fingerprint": {
      "$ref": "#/$defs/hash"
    },
    "as_of_policy": {
      "const": "advance_over_observed_records_only"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "timezone": {
      "const": "Europe/Kaliningrad"
    },
    "start_as_of_date": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/catalogDay"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requiredHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "hashMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/requiredHash"
      }
    },
    "eventUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_event_id",
        "changed_fields",
        "previous_content_hash",
        "content_hash",
        "evidence_ref"
      ],
      "properties": {
        "real_event_id": {
          "$ref": "#/$defs/stableId"
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "previous_content_hash": {
          "$ref": "#/$defs/hash"
        },
        "content_hash": {
          "$ref": "#/$defs/requiredHash"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "holdoutRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_event_id",
        "persona_ids",
        "label_revision",
        "source_snapshot_ref"
      ],
      "properties": {
        "real_event_id": {
          "$ref": "#/$defs/stableId"
        },
        "persona_ids": {
          "$ref": "#/$defs/idList"
        },
        "label_revision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "source_snapshot_ref": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "supply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_active_count",
        "relevant_count",
        "adjacent_count",
        "unknown_constraint_count",
        "no_relevant_supply"
      ],
      "properties": {
        "eligible_active_count": {
          "type": "integer",
          "minimum": 0
        },
        "relevant_count": {
          "type": "integer",
          "minimum": 0
        },
        "adjacent_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_constraint_count": {
          "type": "integer",
          "minimum": 0
        },
        "no_relevant_supply": {
          "type": "boolean"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_event_id",
        "from",
        "to",
        "reason",
        "evidence_ref"
      ],
      "properties": {
        "real_event_id": {
          "$ref": "#/$defs/stableId"
        },
        "from": {
          "enum": [
            "scheduled",
            "active",
            "cancelled",
            "ended"
          ]
        },
        "to": {
          "enum": [
            "scheduled",
            "active",
            "cancelled",
            "ended"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "catalogDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day_index",
        "as_of_date",
        "evidence_snapshot_ref",
        "build_id",
        "catalog_id",
        "catalog_hash",
        "previous_catalog_hash",
        "active_event_ids",
        "new_event_ids",
        "updated_events",
        "cancelled_event_ids",
        "ended_event_ids",
        "sealed_holdout_releases",
        "expected_candidate_supply",
        "lifecycle_transitions",
        "source_hashes",
        "content_hashes",
        "replay_fingerprint"
      ],
      "properties": {
        "day_index": {
          "type": "integer",
          "minimum": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "evidence_snapshot_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "build_id": {
          "$ref": "#/$defs/stableId"
        },
        "catalog_id": {
          "$ref": "#/$defs/stableId"
        },
        "catalog_hash": {
          "$ref": "#/$defs/requiredHash"
        },
        "previous_catalog_hash": {
          "$ref": "#/$defs/hash"
        },
        "active_event_ids": {
          "$ref": "#/$defs/idList"
        },
        "new_event_ids": {
          "$ref": "#/$defs/idList"
        },
        "updated_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventUpdate"
          }
        },
        "cancelled_event_ids": {
          "$ref": "#/$defs/idList"
        },
        "ended_event_ids": {
          "$ref": "#/$defs/idList"
        },
        "sealed_holdout_releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holdoutRelease"
          }
        },
        "expected_candidate_supply": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/stableId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/supply"
          }
        },
        "lifecycle_transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "source_hashes": {
          "$ref": "#/$defs/hashMap"
        },
        "content_hashes": {
          "$ref": "#/$defs/hashMap"
        },
        "replay_fingerprint": {
          "$ref": "#/$defs/requiredHash"
        }
      }
    }
  }
}
