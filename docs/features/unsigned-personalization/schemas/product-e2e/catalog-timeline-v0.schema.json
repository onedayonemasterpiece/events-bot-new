{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenigevents.ru/schemas/product-e2e/catalog-timeline-v0.schema.json",
  "title": "Catalog timeline contract v0 (Phase A draft)",
  "$comment": "Design-only immutable 14+ day replay contract. It defines no production migration and must use wholly synthetic event fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_id",
    "timeline_version",
    "synthetic_fixture",
    "seed",
    "timezone",
    "start_virtual_date",
    "days"
  ],
  "properties": {
    "schema_version": { "const": "catalog-timeline/v0.1-draft" },
    "timeline_id": { "$ref": "#/$defs/stableId" },
    "timeline_version": { "type": "integer", "minimum": 1 },
    "synthetic_fixture": { "const": true },
    "seed": { "type": "integer", "minimum": 0 },
    "timezone": { "const": "Europe/Kaliningrad" },
    "start_virtual_date": { "type": "string", "format": "date" },
    "days": {
      "type": "array",
      "minItems": 14,
      "items": { "$ref": "#/$defs/catalogDay" }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$" },
    "hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "idList": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
    "hashMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/stableId" },
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "eventUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_event_id", "changed_fields", "previous_content_hash", "content_hash"],
      "properties": {
        "fixture_event_id": { "$ref": "#/$defs/stableId" },
        "changed_fields": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "minItems": 1, "uniqueItems": true },
        "previous_content_hash": { "$ref": "#/$defs/hash" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "holdoutActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_event_id", "persona_ids", "label_revision"],
      "properties": {
        "fixture_event_id": { "$ref": "#/$defs/stableId" },
        "persona_ids": { "$ref": "#/$defs/idList" },
        "label_revision": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "supply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_active_count", "relevant_count", "adjacent_count", "no_relevant_supply"],
      "properties": {
        "eligible_active_count": { "type": "integer", "minimum": 0 },
        "relevant_count": { "type": "integer", "minimum": 0 },
        "adjacent_count": { "type": "integer", "minimum": 0 },
        "no_relevant_supply": { "type": "boolean" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_event_id", "from", "to", "reason"],
      "properties": {
        "fixture_event_id": { "$ref": "#/$defs/stableId" },
        "from": { "enum": ["scheduled", "active", "cancelled", "ended"] },
        "to": { "enum": ["scheduled", "active", "cancelled", "ended"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "catalogDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day_index",
        "virtual_date",
        "build_id",
        "catalog_id",
        "catalog_hash",
        "previous_catalog_hash",
        "active_event_ids",
        "new_event_ids",
        "updated_events",
        "cancelled_event_ids",
        "ended_event_ids",
        "holdout_activations",
        "expected_candidate_supply",
        "lifecycle_transitions",
        "source_hashes",
        "content_hashes",
        "replay_fingerprint"
      ],
      "properties": {
        "day_index": { "type": "integer", "minimum": 1 },
        "virtual_date": { "type": "string", "format": "date" },
        "build_id": { "$ref": "#/$defs/stableId" },
        "catalog_id": { "$ref": "#/$defs/stableId" },
        "catalog_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "previous_catalog_hash": { "$ref": "#/$defs/hash" },
        "active_event_ids": { "$ref": "#/$defs/idList" },
        "new_event_ids": { "$ref": "#/$defs/idList" },
        "updated_events": { "type": "array", "items": { "$ref": "#/$defs/eventUpdate" } },
        "cancelled_event_ids": { "$ref": "#/$defs/idList" },
        "ended_event_ids": { "$ref": "#/$defs/idList" },
        "holdout_activations": { "type": "array", "items": { "$ref": "#/$defs/holdoutActivation" } },
        "expected_candidate_supply": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/stableId" },
          "additionalProperties": { "$ref": "#/$defs/supply" }
        },
        "lifecycle_transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "source_hashes": { "$ref": "#/$defs/hashMap" },
        "content_hashes": { "$ref": "#/$defs/hashMap" },
        "replay_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
