+async def _detach_base_links(session: object, base: Event) -> LinkedEventsRecomputeResult:
+    """Clear the rejected base's known edges, preserving its neighbours' others.
+
+    This is bounded to stored outgoing IDs. It is not a global legacy-graph
+    repair and intentionally does not scan the database for unknown backlinks.
+    """
+    eid = int(base.id)
+    linked = _link_ids(getattr(base, "linked_event_ids", None), self_id=eid)
+    changed: list[int] = []
+    if linked:
+        result = await session.execute(select(Event).where(Event.id.in_(linked)))
+        for neighbour in result.scalars().all():
+            current = _link_ids(neighbour.linked_event_ids, self_id=int(neighbour.id))
+            desired = [item for item in current if item != eid]
+            if desired != current:
+                neighbour.linked_event_ids = desired
+                session.add(neighbour)
+                changed.append(int(neighbour.id))
+    if base.linked_event_ids:
+        base.linked_event_ids = []
+        session.add(base)
+        changed.append(eid)
+    if changed:
+        await session.commit()
+    return LinkedEventsRecomputeResult(group_event_ids=[], changed_event_ids=sorted(changed))
+
