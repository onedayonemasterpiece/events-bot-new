+def _link_ids(raw: object, *, self_id: int) -> list[int]:
+    """Normalize only stored IDs; this does not infer event identity."""
+    result: list[int] = []
+    if isinstance(raw, list):
+        for value in raw:
+            # bool and fractional numbers are not canonical IDs.
+            if isinstance(value, bool) or not re.fullmatch(r"[0-9]+", str(value)):
+                continue
+            item = int(value)
+            if item > 0 and item != self_id and item not in result:
+                result.append(item)
+    return result
+
+
+def _is_linkable_occurrence(event: object) -> bool:
+    """Negative rails over canonical fields, not a new eventness classifier.
+
+    A continuous range is never a member of a single-slot occurrence group.
+    Unknown event type cannot prove compatibility with a named activity.
+    """
+    raw_date = str(getattr(event, "date", "") or "").strip()
+    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", raw_date):
+        return False
+    if _parse_iso_date(raw_date) is None or getattr(event, "end_date", None):
+        return False
+    if not str(getattr(event, "event_type", "") or "").strip():
+        return False
+    if str(getattr(event, "lifecycle_status", None) or "active").casefold() != "active":
+        return False
+    if str(getattr(event, "identity_status", None) or "canonical").casefold() != "canonical":
+        return False
+    return not getattr(event, "silent", False) and not getattr(event, "merged_into_event_id", None)
+
+
+def _canonical_text(event: object, field: str) -> str:
+    return str(getattr(event, field, "") or "").strip().casefold()
+
+
+def _occurrences_compatible(left: object, right: object) -> bool:
+    """Require symmetric typed rails before the existing title matcher runs."""
+    if not _is_linkable_occurrence(left) or not _is_linkable_occurrence(right):
+        return False
+    if _canonical_text(left, "event_type") != _canonical_text(right, "event_type"):
+        return False
+    left_city, right_city = _canonical_text(left, "city"), _canonical_text(right, "city")
+    if left_city and right_city and left_city != right_city:
+        return False
+    # On the same day, only two different known times can prove distinct slots.
+    # A default/unknown time proves neither a duplicate nor another visit.
+    if getattr(left, "date", None) == getattr(right, "date", None):
+        left_time = _time_sort_key(getattr(left, "time", None))
+        right_time = _time_sort_key(getattr(right, "time", None))
+        if (left_time[0] != 0 or right_time[0] != 0
+                or getattr(left, "time_is_default", False)
+                or getattr(right, "time_is_default", False)
+                or left_time == right_time):
+            return False
+    return True
+
