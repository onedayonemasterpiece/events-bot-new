+    {"identity_status": "merged"}, {"merged_into_event_id": 99}, {"silent": True},
+    {"city": "Светлогорск"}, {"date": "2026-09-07..2026-09-08"},
+    {"date": "2026-09-31"},
+])
+def test_ineligible_or_contradictory_candidate_cannot_join(subject, db, bad):
+    put(db, row(1), row(2, **(dict(date="2026-09-07") | bad)))
+    recompute(subject, db, 1)
+    assert links(db) == {1: [], 2: []}
