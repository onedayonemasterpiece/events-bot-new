+def row(event_id, **changes):
+    fields = dict(id=event_id, title="Точка и линия", date="2026-09-06",
+                  time="16:00", event_type="экскурсия", city="Калининград",
+                  location_name="Музей", linked_event_ids=[])
+    fields.update(changes)
+    return Event(**fields)
+
+
+def put(db, *events):
+    with Session(db.engine) as session:
+        session.add_all(events)
+        session.commit()
+
+
+def links(db):
+    with Session(db.engine) as session:
+        return {item.id: item.linked_event_ids for item in session.scalars(select(Event))}
+
+
+def recompute(subject, db, event_id, **options):
+    return asyncio.run(subject.recompute_linked_event_ids(db, event_id, **options))
+
+
+@pytest.mark.parametrize("first", [1, 2])
+def test_exhibition_and_tour_do_not_link_in_either_order(subject, db, first):
+    put(db, row(1, event_type="выставка", date="2026-06-12", end_date="2027-03-28"), row(2))
+    recompute(subject, db, first)
+    recompute(subject, db, 3-first)
+    assert links(db) == {1: [], 2: []}
+
+
+@pytest.mark.parametrize("first", [1, 2])
+def test_existing_exhibition_tour_edges_are_removed_symmetrically(subject, db, first):
+    put(db, row(1, event_type="выставка", date="2026-06-12", end_date="2027-03-28", linked_event_ids=[2]),
+        row(2, linked_event_ids=[1]))
+    result = recompute(subject, db, first)
+    assert result.changed_event_ids == [1, 2]
+    assert links(db) == {1: [], 2: []}
+    assert recompute(subject, db, first).changed_event_ids == []
+
+
+@pytest.mark.parametrize("bad", [
+    {"event_type": "выставка"}, {"event_type": None}, {"event_type": ""},
