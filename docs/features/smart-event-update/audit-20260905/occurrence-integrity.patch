+"""Offline contract regressions for the actual linked_events implementation.
+
+Run focused without the repository's bot-wide conftest:
+  python -m pytest --noconftest -q tests/test_linked_occurrence_integrity.py
+
+Only import dependencies are injected. Function bodies and SELECT statements
+come from the production file; SQL runs against real temporary SQLite using
+SQLAlchemy. This does not exercise production Database/SQLModel initialization,
+async driver concurrency, Smart Update orchestration, providers, or deployment.
+"""
+from __future__ import annotations
+
+import ast
+import asyncio
+from contextlib import asynccontextmanager
+from pathlib import Path
+import sys
+import types
+
+import pytest
+from sqlalchemy import JSON, Boolean, Integer, String, create_engine, select
+from sqlalchemy.orm import DeclarativeBase, Mapped, Session, mapped_column
+
+
+class Base(DeclarativeBase):
+    pass
+
+
+class Event(Base):
+    __tablename__ = "event"
+    id: Mapped[int] = mapped_column(Integer, primary_key=True)
+    title: Mapped[str] = mapped_column(String)
+    date: Mapped[str] = mapped_column(String)
+    time: Mapped[str] = mapped_column(String, default="16:00")
+    end_date: Mapped[str | None] = mapped_column(String, nullable=True)
+    event_type: Mapped[str | None] = mapped_column(String, nullable=True)
+    location_name: Mapped[str] = mapped_column(String, default="Музей")
+    city: Mapped[str | None] = mapped_column(String, nullable=True)
+    lifecycle_status: Mapped[str | None] = mapped_column(String, nullable=True, default="active")
+    identity_status: Mapped[str | None] = mapped_column(String, nullable=True, default="canonical")
+    merged_into_event_id: Mapped[int | None] = mapped_column(Integer, nullable=True)
+    silent: Mapped[bool] = mapped_column(Boolean, default=False)
+    time_is_default: Mapped[bool] = mapped_column(Boolean, default=False)
+    linked_event_ids: Mapped[list] = mapped_column(JSON, default=list)
+
+
+class Database:
+    def __init__(self, engine):
+        self.engine = engine
+        self.fail_commit = False
+        self.commit_count = 0
+
+    @asynccontextmanager
+    async def get_session(self):
+        owner = self
+        with Session(self.engine) as real:
+            class AsyncFacade:
+                async def get(self, model, key):
+                    return real.get(model, key)
+
+                async def execute(self, statement):
+                    return real.execute(statement)
+
+                def add(self, row):
+                    real.add(row)
+
+                async def commit(self):
+                    if owner.fail_commit:
+                        raise RuntimeError("injected commit failure")
+                    real.commit()
+                    owner.commit_count += 1
+            try:
+                yield AsyncFacade()
+            finally:
+                real.rollback()
+
+
+@pytest.fixture
+def subject(monkeypatch):
+    source = Path(__file__).resolve().parents[1] / "linked_events.py"
+    tree = ast.parse(source.read_text(encoding="utf-8"), filename=str(source))
+    injected = {"sqlmodel", "db", "models"}
+    tree.body = [node for node in tree.body if not (
+        isinstance(node, ast.ImportFrom) and node.module in injected
+    )]
+    module = types.ModuleType("_linked_events_contract_under_test")
+    module.__dict__.update(Event=Event, Database=Database, select=select)
+    monkeypatch.setitem(sys.modules, module.__name__, module)
+    exec(compile(tree, str(source), "exec"), module.__dict__)
+    return module
+
+
+@pytest.fixture
+def db(tmp_path):
+    engine = create_engine(f"sqlite:///{tmp_path / 'events.sqlite'}")
+    Base.metadata.create_all(engine)
+    result = Database(engine)
+    yield result
+    engine.dispose()
+
