{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static.kenigevents.ru/region-talk/external-publications/research-registry.schema.json",
  "title": "Region Talk live external-publication research registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "public_registry_url",
    "result_contract",
    "search_policy",
    "duplicate_guard",
    "blocked_domains"
  ],
  "properties": {
    "schema_version": {
      "const": "region_talk_external_research_registry.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_registry_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_url", "sha256"],
      "properties": {
        "schema_version": {
          "const": "region_talk_external_research.v1"
        },
        "schema_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "search_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_region",
        "output_language",
        "earliest_publication_date",
        "research_languages",
        "product_language_policy",
        "maximum_candidates",
        "maximum_candidates_per_contour"
      ],
      "properties": {
        "target_region": {
          "const": "Калининградская область, Россия"
        },
        "output_language": {
          "const": "ru"
        },
        "earliest_publication_date": {
          "type": "string",
          "format": "date"
        },
        "research_languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "product_language_policy": {
          "enum": ["ru_only", "ru_or_mostly_ru", "multilingual_manual_review"]
        },
        "maximum_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maximum_candidates_per_contour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "duplicate_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "snapshot_id", "seen_publication_count", "seen_publications"],
      "properties": {
        "policy_version": {
          "const": "region_talk_external_seen_guard_v1"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^rtseen_[a-f0-9]{24}$"
        },
        "seen_publication_count": {
          "type": "integer",
          "minimum": 0
        },
        "seen_publications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical_url", "doi", "title", "source_name", "disposition"],
            "properties": {
              "canonical_url": {
                "type": ["string", "null"],
                "format": "uri"
              },
              "doi": {
                "type": ["string", "null"]
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "authors": {
                "type": "array",
                "items": {"type": "string", "maxLength": 240}
              },
              "normalized_title": {
                "type": "string",
                "maxLength": 500
              },
              "normalized_authors": {
                "type": "array",
                "items": {"type": "string", "maxLength": 240}
              },
              "external_publication_id": {
                "type": "string",
                "pattern": "^extpub_[a-f0-9]{24}$"
              },
              "source_name": {
                "type": "string",
                "maxLength": 300
              },
              "disposition": {
                "enum": ["candidate", "manual_review", "excluded", "unresolved"]
              }
            },
            "anyOf": [
              {"properties": {"canonical_url": {"type": "string", "format": "uri"}}},
              {"properties": {"doi": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      }
    },
    "blocked_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+$"
      }
    }
  }
}
