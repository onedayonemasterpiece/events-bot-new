{
  "schema_version": "collection-surfaces-v1",
  "status": "contract-example-not-production-config",
  "default_policy": "unknown-static",
  "compatibility": {
    "feature_schema_version": "event-features-v1",
    "taxonomy_version": "event-taxonomy-v1",
    "model_version": "local-ranker-v1"
  },
  "policies": {
    "unknown-static": {
      "ranking_mode": "identity",
      "profile_strength_bp": 0,
      "reorder_scope": "none",
      "exact_hide": "compatible-local-only",
      "network_on_page_view": false,
      "signal_collection": "none",
      "fallback": "static"
    },
    "calendar-exact-only": {
      "ranking_mode": "chronological",
      "profile_strength_bp": 0,
      "reorder_scope": "none",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "fallback": "static-chronological",
      "hard_invariants": [
        "date_group_order_preserved",
        "time_order_preserved",
        "weekend_day_boundary_preserved"
      ]
    },
    "calendar-personal-tail": {
      "ranking_mode": "profile",
      "profile_strength_bp": 6500,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "candidate_limit": 30,
      "render_limit": 6,
      "diversity": {
        "max_same_category": 3,
        "max_same_venue": 2,
        "exploration_slots": 1
      },
      "fallback": "hidden-or-static-popular-tail"
    },
    "thematic-weak": {
      "ranking_mode": "baseline-plus-profile-tiebreak",
      "profile_strength_bp": 1800,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "candidate_limit": 120,
      "diversity": {
        "max_same_category": 4,
        "max_same_venue": 3,
        "exploration_share_bp": 1000
      },
      "fallback": "static-editorial"
    },
    "popular-tiebreak": {
      "ranking_mode": "popularity-first-profile-tiebreak",
      "profile_strength_bp": 1000,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "fallback": "static-popularity"
    },
    "search-query-first": {
      "ranking_mode": "query-first-profile-tiebreak",
      "profile_strength_bp": 800,
      "reorder_scope": "unseen-results-only",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "fallback": "query-order"
    },
    "related-anchor-first": {
      "ranking_mode": "anchor-first-profile-tiebreak",
      "profile_strength_bp": 1200,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "candidate_limit": 60,
      "diversity": {
        "max_same_category": 3,
        "max_same_venue": 2
      },
      "fallback": "static-related"
    },
    "for-me-strong": {
      "ranking_mode": "profile",
      "profile_strength_bp": 7000,
      "reorder_scope": "whole-unseen-list",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "candidate_limit": 500,
      "diversity": {
        "max_same_category": 3,
        "max_same_venue": 2,
        "exploration_share_bp": 1000
      },
      "fallback": "onboarding-or-general"
    },
    "free-weak": {
      "ranking_mode": "eligibility-first-profile-tiebreak",
      "profile_strength_bp": 1600,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "hard_invariants": [
        "is_free_true"
      ],
      "fallback": "static-free"
    },
    "children-weak": {
      "ranking_mode": "eligibility-first-profile-tiebreak",
      "profile_strength_bp": 1400,
      "reorder_scope": "invisible-tail",
      "exact_hide": "global",
      "network_on_page_view": false,
      "signal_collection": "explicit-actions-only",
      "hard_invariants": [
        "child_eligibility_preserved",
        "age_safety_preserved"
      ],
      "fallback": "static-children"
    }
  },
  "route_families": [
    {
      "id": "today-primary",
      "match": ["/segodnya/"],
      "surface_id": "today_primary",
      "policy": "calendar-exact-only"
    },
    {
      "id": "tomorrow-primary",
      "match": ["/zavtra/"],
      "surface_id": "tomorrow_primary",
      "policy": "calendar-exact-only"
    },
    {
      "id": "weekend-primary",
      "match": ["/vyhodnye/"],
      "surface_id": "weekend_primary",
      "policy": "calendar-exact-only"
    },
    {
      "id": "calendar-primary",
      "match": ["/kalendar/", "/data/*calendar*"],
      "surface_id": "calendar_primary",
      "policy": "calendar-exact-only",
      "html_only": true
    },
    {
      "id": "date-page-personal-tail",
      "component_selector": "[data-p13n-surface='calendar_personal_tail']",
      "surface_id": "calendar_personal_tail",
      "policy": "calendar-personal-tail"
    },
    {
      "id": "thematic-collections",
      "match": [
        "/podborki/**",
        "/vystavki/",
        "/festivali/",
        "/neobychnoe/",
        "/kluby-po-interesam/"
      ],
      "surface_id": "thematic_collection",
      "policy": "thematic-weak"
    },
    {
      "id": "popular",
      "match": ["/populyarnoe/"],
      "surface_id": "popular_primary",
      "policy": "popular-tiebreak"
    },
    {
      "id": "search",
      "match": ["/poisk/"],
      "surface_id": "search_results",
      "policy": "search-query-first"
    },
    {
      "id": "event-related",
      "match": ["/sobytiya/**"],
      "component_selector": "[data-p13n-surface='event_detail_related']",
      "surface_id": "event_detail_related",
      "policy": "related-anchor-first"
    },
    {
      "id": "for-me",
      "match": ["/dlya-menya/"],
      "surface_id": "for_me",
      "policy": "for-me-strong"
    },
    {
      "id": "free",
      "match": ["/besplatno/**"],
      "surface_id": "free_primary",
      "policy": "free-weak"
    },
    {
      "id": "children",
      "match": ["/detyam/**", "/s-detmi/**"],
      "surface_id": "children_primary",
      "policy": "children-weak"
    }
  ]
}
