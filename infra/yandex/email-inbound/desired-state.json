{
  "schema": "kenigevents.email_inbound.yc_desired_state.v1",
  "cloud_id": "${EMAIL_INBOUND_YC_CLOUD_ID}",
  "folder": {
    "name": "kenigevents-email-prod",
    "description": "Isolated KenigEvents inbound email infrastructure"
  },
  "service_accounts": [
    "email-mail-trigger",
    "email-intake-runtime",
    "email-queue-trigger",
    "email-delivery-runtime"
  ],
  "kms_keys": [
    "email-inbound-storage"
  ],
  "buckets": [
    "${EMAIL_INBOUND_BUCKET_NAME}"
  ],
  "functions": [
    "kenigevents-email-intake",
    "kenigevents-email-delivery"
  ],
  "lockbox_secrets": [
