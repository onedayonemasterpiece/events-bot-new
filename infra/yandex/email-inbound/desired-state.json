    "email-inbound-idempotency",
    "email-inbound-adapter-signing"
  ],
  "queues": [
    "kenigevents-email-processing",
    "kenigevents-email-intake-dlq",
    "kenigevents-email-processing-dlq"
  ],
  "triggers": [
    "kenigevents-email-mail-trigger",
    "kenigevents-email-processing-trigger"
