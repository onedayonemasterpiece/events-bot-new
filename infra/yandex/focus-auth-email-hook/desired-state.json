{
  "schema": "kenigevents.focus_auth_email_hook.yc_desired_state.v1",
  "folder_id": "b1g0v4ur96gis5kot6ku",
  "labels": {
    "environment": "prod",
    "project": "kenigevents",
    "purpose": "focus-auth-email-hook"
  },
  "function": {
    "name": "kenigevents-focus-auth-email-hook",
    "runtime": "python312",
    "entrypoint": "index.handler",
    "memory_mb": 256,
    "timeout_seconds": 5,
    "concurrency": 2,
    "service_account_name": "kenigevents-focus-auth-mailer",
    "required_roles": [
      "postbox.sender"
    ],
    "stage_budget_ms": {
      "attempt_and_capacity_rpc": 1100,
      "provider_dispatch": 2000,
      "completion_rpc": 1100,
      "total_network_ceiling": 4200
    }
  },
  "api_gateway": {
    "name": "kenigevents-focus-auth-email-hook",
    "public_path": "/v1/send-email",
    "method": "POST",
    "max_body_bytes": 65536
  },
  "lockbox": {
    "required_environment_variables": [
      "SEND_EMAIL_HOOK_SECRET",
      "PERSONALIZATION_SUPABASE_SECRET_KEY",
      "NOTISEND_API_TOKEN",
      "FOCUS_AUTH_NOTISEND_EMAILS"
    ],
    "non_secret_environment_variables": [
      "PERSONALIZATION_SUPABASE_URL",
      "POSTBOX_CONFIGURATION_SET",
      "AUTH_POSTBOX_FROM_EMAIL",
      "AUTH_NOTISEND_FROM_EMAIL",
      "AUTH_FROM_NAME",
      "AUTH_REPLY_TO",
      "FOCUS_AUTH_NOTISEND_USER_IDS"
    ]
  },
  "provider_policy": {
    "new_first_send": "postbox",
    "returning_or_repeat_send": "notisend",
    "notisend_payment": "subscriber",
    "cross_provider_retry_after_ambiguous": false,
    "unique_recipient_capacity": 200
  }
