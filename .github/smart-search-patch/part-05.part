+export function validateSearchE2eTarget(value, focusTarget = null) {
+  let raw = String(value || '').trim();
+  if (!raw && focusTarget) {
+    const source = focusTarget instanceof URL ? focusTarget : validateFocusE2eTarget(focusTarget);
+    const first = source.pathname.split('/').filter(Boolean)[0] || '';
+    raw = new URL(first.startsWith('preview-') ? `/${first}/poisk/` : '/poisk/', source.origin).href;
+  }
+  if (!raw || CONTROL_CHARS.test(raw) || /%(?:0[0-9a-f]|1[0-9a-f]|7f)/iu.test(raw)) {
+    throw new Error('search_target_url_invalid_characters');
+  }
+  let url;
+  try { url = new URL(raw); } catch { throw new Error('search_target_url_invalid'); }
+  if (url.protocol !== 'https:' || url.hostname !== 'kenigevents.ru' || url.port || url.username || url.password) {
+    throw new Error('search_target_url_origin_not_allowed');
+  }
+  let pathname;
+  try { pathname = decodeURIComponent(url.pathname); } catch { throw new Error('search_target_url_path_invalid'); }
+  if (CONTROL_CHARS.test(pathname) || (!SEARCH_PREVIEW_PATH.test(pathname) && !SEARCH_PRODUCTION_PATH.test(pathname))) {
+    throw new Error('search_target_url_path_not_allowed');
+  }
+  if (url.search || url.hash) throw new Error('search_target_url_suffix_not_allowed');
+  return url;
+}
