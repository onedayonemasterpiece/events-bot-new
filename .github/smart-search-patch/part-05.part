+  return {
+    operation: SEARCH_OPERATION,
+    path: SEARCH_PATH,
+    expected_route: expectedRoute,
+    dispatch_count: expectedAttempts,
+    outcome_count: searchOutcomes.length,
+    routes: searchOutcomes.map((item) => item.finalRoute),
