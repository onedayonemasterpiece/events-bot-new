+test('authenticated Search journey uses one mobile dispatch and browser cold/cache pair', async () => {
+  const { runAuthenticatedSearchRouteMatrix } = await import('../../e2e/focus-email/journey.mjs');
+  const calls = [];
+  const outcomes = [1, 2].map((index) => ({ operationId: `op-${index}`, operation: 'functions.event-search',
+    policy: 'selected-once', kind: 'definitive', status: 200, initialRoute: 'relay', finalRoute: 'relay' }));
+  const ui = {
+    openSearch: async () => calls.push('open'), verifySearchSurface: async () => ({ enabled: true, authorized: true, transport: 'json', enter_key_hint: 'search', input_tag: 'textarea' }),
+    focusSearchInput: async () => null, enterSearchQuery: async () => calls.push('enter'),
+    submitSearchWithKeyboard: async () => calls.push('submit'),
+    waitForSearchCompletion: async () => ({ completed: true, rendered_card_count: 2 }),
+    captureMaskedEvidence: async () => {}, clearSearchInput: async () => {},
+    searchEvidence: async () => ({ physical_request_count: 2, transport_outcomes: outcomes,
+      responses: [
+        { schema_version: 'event-search-results-v1', result_cache_status: 'stored', served_from_cache: false, item_count: 2, fallback_count: 0 },
+        { schema_version: 'event-search-results-v1', result_cache_status: 'hit', served_from_cache: true, item_count: 2, fallback_count: 0 },
+      ] }),
+  };
+  const result = await runAuthenticatedSearchRouteMatrix({ ui, searchTarget: new URL('https://kenigevents.ru/preview-safe/poisk/'),
+    query: 'synthetic', queryId: 'q1', platform: 'browser', profile: 'client_supabase_direct_unreachable', step: () => {} });
+  assert.equal(result.attempts, 2);
+  assert.equal(calls.filter((item) => item === 'submit').length, 2);
+  assert.equal(result.route.cache.second, 'hit');
+});
