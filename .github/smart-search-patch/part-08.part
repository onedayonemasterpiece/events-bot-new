+  const target = validateFocusE2eTarget(values.target_url);
+  const searchTarget = scenario.startsWith('search.')
+    ? validateSearchE2eTarget(values.search_target_url || '', target)
+    : null;
+  if (!scenario.startsWith('search.') && values.search_target_url) throw new Error('search_target_url_not_applicable');
+  return {
+    scenario,
+    platform,
+    fault_profile: faultProfile,
+    target_url: target.href,
+    search_target_url: searchTarget?.href || '',
+    expected_repo_sha: values.expected_repo_sha,
+    mode: values.mode,
+    target_origin: target.origin,
+    target_path: target.pathname,
+    search_target_path: searchTarget?.pathname || '',
+  };
 }
 
