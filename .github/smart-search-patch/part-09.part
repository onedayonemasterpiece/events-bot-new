--- a/site/tests/external-focus-email-otp/search-acceptance.test.mjs
+++ b/site/tests/external-focus-email-otp/search-acceptance.test.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { assertSearchRouteMatrix, expectedSearchRoute, summarizeSearchPayload, syntheticSearchQuery }
+  from '../../e2e/focus-email/helpers/search-acceptance.mjs';
+
+test('synthetic query is stable per workflow run but evidence needs only its id', () => {
+  const one = syntheticSearchQuery('gh-12345-1');
+  const two = syntheticSearchQuery('gh-12345-1');
+  assert.deepEqual(one, two);
+  assert.equal(one.query_id, 'evening_music_transport_v1');
+  assert.match(one.value, /^музыка вечером в Калининграде контроль [a-z0-9]+$/u);
+});
+
+test('search payload summary removes query and event-card bodies', () => {
+  const summary = summarizeSearchPayload({
+    schema_version: 'event-search-results-v1', algorithm_id: 'vector', request_id: 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
+    served_list_id: 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb', result_cache_status: 'stored', served_from_cache: false,
+    embedding_cache_status: 'miss', items: [{ title: 'secret title' }], fallback_items: [], query_hash: 'secret',
+    llm_verifier: { requested: true, used: false, status: 'degraded:timeout', model: null, policy: 'lite_first' },
+    timings_ms: { total_ms: 123, unsafe: 'drop' },
+  });
+  assert.equal(summary.item_count, 1);
+  assert.equal(summary.timings_ms.total_ms, 123);
+  assert.doesNotMatch(JSON.stringify(summary), /secret title|query_hash|secret/u);
+});
+
+test('browser route matrix requires one cold response, one cache hit and selected-once routes', () => {
+  const outcomes = [1, 2].map((index) => ({ operationId: `op-${index}`, operation: 'functions.event-search',
+    policy: 'selected-once', kind: 'definitive', status: 200, initialRoute: 'relay', finalRoute: 'relay' }));
+  const result = assertSearchRouteMatrix({
+    profile: 'client_supabase_direct_unreachable', platform: 'browser', attempts: 2, outcomes,
+    uiStates: [{ completed: true, rendered_card_count: 2 }, { completed: true, rendered_card_count: 2 }],
+    responses: [
+      { schema_version: 'event-search-results-v1', result_cache_status: 'stored', served_from_cache: false, item_count: 2, fallback_count: 0 },
+      { schema_version: 'event-search-results-v1', result_cache_status: 'hit', served_from_cache: true, item_count: 2, fallback_count: 0 },
+    ],
+  });
+  assert.deepEqual(result.routes, ['relay', 'relay']);
+  assert.equal(expectedSearchRoute('client_yandex_relay_unreachable'), 'direct');
+});
+
+test('mobile route matrix requires exactly one successful selected-once operation', () => {
+  assert.throws(() => assertSearchRouteMatrix({ profile: 'client_yandex_relay_unreachable', platform: 'ios', attempts: 1,
+    outcomes: [{ operation: 'functions.event-search', policy: 'selected-once', kind: 'definitive', status: 200,
+      initialRoute: 'relay', finalRoute: 'relay' }], uiStates: [{ completed: true, rendered_card_count: 1 }] }), /search_transport_route/u);
+});
