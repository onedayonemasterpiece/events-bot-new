+  await ui.openSearch(searchTarget);
+  const surface = await ui.verifySearchSurface();
+  if (surface.transport !== 'json') throw new Error(`search_transport_contract:${surface.transport}`);
+  if (surface.enter_key_hint !== 'search') throw new Error(`search_keyboard_hint:${surface.enter_key_hint}`);
+  if (!['textarea', 'input'].includes(surface.input_tag)) throw new Error(`search_input_tag:${surface.input_tag}`);
+  step('search_surface_authorized');
+
+  const attemptCount = platform === 'browser' ? 2 : 1;
+  const uiStates = [];
+  let searchKeyboard = null;
+  for (let attempt = 1; attempt <= attemptCount; attempt += 1) {
+    searchKeyboard = await ui.focusSearchInput();
+    if (attempt === 1) await ui.captureEmptyKeyboardEvidence?.('06-search-empty-keyboard');
+    await ui.enterSearchQuery(query);
+    step(`search_query_entered_${attempt}`);
+    await ui.submitSearchWithKeyboard();
+    const state = await ui.waitForSearchCompletion();
+    uiStates.push(state);
+    step(`search_result_rendered_${attempt}`);
+    await ui.captureMaskedEvidence(attempt === 1 ? '07-search-results' : '08-search-cache-hit');
+    if (attempt < attemptCount) await ui.clearSearchInput();
+  }
+
+  const evidence = await ui.searchEvidence();
+  const acceptance = assertSearchRouteMatrix({
+    profile, platform, attempts: evidence.physical_request_count,
+    responses: evidence.responses, outcomes: evidence.transport_outcomes, uiStates,
+  });
+  step('search_route_cache_contract_passed');
+  return {
+    query_id: queryId,
+    target_origin: searchTarget.origin,
+    target_path: searchTarget.pathname,
+    surface,
+    attempts: attemptCount,
+    ui_states: uiStates,
+    responses: evidence.responses,
+    route: acceptance,
+    keyboard: searchKeyboard,
+  };
+}
