       E2E_EVIDENCE_DIR: artifacts/external-focus-email-otp-evidence-android-${{ github.run_id }}-${{ github.run_attempt }}
@@ -176,14 +183,14 @@
         if: ${{ always() && hashFiles('site/artifacts/external-focus-email-otp-evidence-android-*/.redaction-ok') != '' }}
         uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
