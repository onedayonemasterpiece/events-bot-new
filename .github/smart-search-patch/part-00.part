           path: site/artifacts/external-focus-email-otp-evidence-browser-*
           if-no-files-found: error
           retention-days: 7
 
   android:
     needs: [validate, browser]
-    if: ${{ always() && needs.validate.result == 'success' && inputs.scenario == 'focus.otp.browser_tab' && ((inputs.platform == 'android' && needs.browser.result == 'skipped') || (inputs.platform == 'all' && needs.browser.result == 'success')) }}
+    if: ${{ always() && needs.validate.result == 'success' && inputs.scenario != 'focus.otp.ios_keyboard_preflight' && ((inputs.platform == 'android' && needs.browser.result == 'skipped') || (inputs.platform == 'all' && needs.browser.result == 'success')) }}
     runs-on: ubuntu-24.04
     timeout-minutes: 35
     environment: { name: external-e2e }
@@ -126,6 +132,7 @@
       E2E_DEVICE_NAME: Pixel 7
       E2E_PLATFORM_VERSION: '15'
       E2E_TARGET_URL: ${{ inputs.target_url }}
+      E2E_SEARCH_TARGET_URL: ${{ inputs.search_target_url }}
