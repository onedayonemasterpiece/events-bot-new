UTC = dt.timezone.utc
LOG_RE = re.compile(
    r"^(?P<ts>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})(?:,(?P<ms>\d{3}))?\s+"
    r"(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\s+(?P<logger>[^:]+):\s*(?P<msg>.*)$"
)
EVENT_ID_RE = re.compile(r"\bevent_id=(\d+)")
START_RE = re.compile(r"\bsmart_update\.start\b")
TERMINALS = [
    ("created", re.compile(r"\bsmart_update\.created\b")),
    ("merged", re.compile(r"\bsmart_update\.merge\b.*\bstatus=merged\b")),
    ("skipped_nochange", re.compile(r"\bsmart_update\.merge\b.*\bstatus=skipped_nochange\b")),
    ("invalid", re.compile(r"\bsmart_update\.invalid\b\s+reason=")),
    ("skipped", re.compile(r"\bsmart_update\.skip\b\s+reason=")),
    ("rejected", re.compile(r"\bsmart_update\.(?:reject|rejected)\b\s+reason=")),
]
KV_RE = re.compile(r"(?P<key>[A-Za-z_][A-Za-z0-9_.-]*)=(?P<value>\[[^\]]*\]|\([^\)]*\)|\"[^\"]*\"|'[^']*'|\S+)")
URL_SECRET_RE = re.compile(r"(?i)(access_token|token|apikey|api_key|key|secret|signature|sig|auth|code)=([^&\s]+)")
JWT_RE = re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b")
EMAIL_RE = re.compile(r"(?i)\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b")
PHONE_RE = re.compile(r"(?<!\d)(?:\+?7|8)[\s()\-]*\d(?:[\s()\-]*\d){9}(?!\d)")
LONG_SECRET_RE = re.compile(r"(?<![A-Za-z0-9])[A-Za-z0-9_-]{40,}(?![A-Za-z0-9])")

PROVIDER_PATTERNS = {
    "wall_clock_timeout": re.compile(r"wall_clock_timeout", re.I),
    "gemma_attempt_failed": re.compile(r"smart_update:\s+gemma\s+.+failed\s+attempt=", re.I),
    "native_schema_failure": re.compile(r"native schema.+(?:failed|invalid json)", re.I),
    "fallback_4o": re.compile(r"(?:fallback_4o|fallback to 4o|gemma_fallback_4o)", re.I),
    "fallback_4o_failed": re.compile(r"4o fallback failed", re.I),
    "fallback_budget_exhausted": re.compile(r"fallback budget exhausted", re.I),
    "rate_limit_or_429": re.compile(r"(?:rate.?limit|\b429\b|quota exhausted|resource_exhausted)", re.I),
    "limiter_or_reserve_unavailable": re.compile(r"(?:shared_limiter_unavailable|limiter.+unavailable|reserve.+(?:failed|error))", re.I),
    "provider_5xx": re.compile(r"(?:provider|google).*(?:\b5\d\d\b|server error|service unavailable)", re.I),
}
DOWNSTREAM_PATTERNS = {
    "schedule_update_failed": re.compile(r"smart_update:\s+schedule/update failed", re.I),
    "linked_refresh_enqueue_failed": re.compile(r"failed to enqueue linked telegraph refresh", re.I),
    "interest_club_enqueue_failed": re.compile(r"failed to enqueue interest-club evaluation", re.I),
    "media_reconcile_enqueue_failed": re.compile(r"failed to enqueue source media reconcile", re.I),
    "holiday_mapping_failed": re.compile(r"holiday mapping failed", re.I),
    "static_builder_failure": re.compile(r"static_site.*(?:failed|error|permanent|retryable)", re.I),
}
QUALITY_PATTERNS = {
    "identity_gate_observation": re.compile(r"smart_update\.identity_gate\b", re.I),
    "merge_identity_gate_observation": re.compile(r"smart_update\.merge_identity_gate\b", re.I),
    "identity_or_merge_gate_skip": re.compile(r"(?:identity_gate.*action=(?:skip|reject|review)|merge_identity_gate.*enforce_skip=(?:1|true))", re.I),
    "match_overruled": re.compile(r"smart_update\.match_overruled", re.I),
    "dedup_prevented": re.compile(r"smart_update\.match type=(?:post_decision_dup_probe|dedup_adjudicator|rescue_bundle_title)", re.I),
    "title_rejected": re.compile(r"smart_update\.(?:create_title_rejected|title_rejected)", re.I),
    "ungrounded_fact_rejected": re.compile(r"smart_update\.fact_rejected", re.I),
    "description_verbatim_guard": re.compile(r"description too verbatim", re.I),
}
RUNTIME_PATTERNS = {
    "process_start": re.compile(r"(?:runtime_logging: enabled|Starting gunicorn|Application startup complete|create_app|set_db called)", re.I),
    "oom": re.compile(r"(?:out of memory|oom.?kill|memory limit exceeded|killed process)", re.I),
    "database_locked": re.compile(r"database is locked", re.I),
    "disk_pressure": re.compile(r"(?:free-space floor|disk.+critical|no space left|ENOSPC|runtime_logging: paused)", re.I),
    "scheduler_missed": re.compile(r"(?:JOB_MISSED|misfire|missed by)", re.I),
    "worker_stall": re.compile(r"(?:queue stalled|worker crashed|worker restarted)", re.I),
}


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser()
    p.add_argument("--output", required=True)
    p.add_argument("--markdown", required=True)
    p.add_argument("--excerpts", required=True)
    p.add_argument("--window-hours", type=int, default=24)
    p.add_argument("--app", default="events-bot-new-wngqia")
    p.add_argument("--repo-sha", default="")
    p.add_argument("--db", default=os.getenv("DB_PATH", "/data/db.sqlite"))
    return p.parse_args()


def iso(value: dt.datetime | None) -> str | None:
    return value.astimezone(UTC).isoformat().replace("+00:00", "Z") if value else None


def parse_time(value: Any) -> dt.datetime | None:
    if value in (None, ""):
        return None
    raw = str(value).strip().replace("Z", "+00:00")
