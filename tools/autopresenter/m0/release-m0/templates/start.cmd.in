@echo off
setlocal DisableDelayedExpansion

set "AP_ROOT=%~dp0"
set "AP_CANDIDATE_ID=@@CANDIDATE_ID@@"
set "AP_NODE=%AP_ROOT%runtime\node.exe"
set "AP_BROWSER_REL=@@BROWSER_EXECUTABLE_WINDOWS@@"
set "AP_BROWSER=%AP_ROOT%%AP_BROWSER_REL%"
set "PLAYWRIGHT_BROWSERS_PATH=%AP_ROOT%browsers"
set "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1"
set "PLAYWRIGHT_SKIP_BROWSER_GC=1"

if not exist "%AP_NODE%" (
  >&2 echo ERROR: packaged portable Node is absent: "%AP_NODE%"
  exit /b 2
)
if not exist "%AP_BROWSER%" (
  >&2 echo ERROR: packaged Playwright-managed browser is absent: "%AP_BROWSER%"
  >&2 echo Runtime download and system browser fallback are forbidden.
  exit /b 3
)
if not exist "%AP_ROOT%app\src\run-suite.js" (
  >&2 echo ERROR: packaged M0 runner is absent: "%AP_ROOT%app\src\run-suite.js"
  exit /b 4
)
if "%~3"=="" (
  >&2 echo Usage: start.cmd LIVE_ZAVTRA_URL EXACT_CLICK_SELECTOR EXACT_SUCCESS_SELECTOR [EXACT_MARKER_SELECTOR]
  exit /b 64
)
if not exist "%AP_ROOT%data" mkdir "%AP_ROOT%data"
if errorlevel 1 exit /b %ERRORLEVEL%
if not exist "%AP_ROOT%logs" mkdir "%AP_ROOT%logs"
if errorlevel 1 exit /b %ERRORLEVEL%

if "%~4"=="" goto run_without_marker
"%AP_NODE%" "%AP_ROOT%app\src\run-suite.js" --portable-root "%AP_ROOT%" --candidate-id "%AP_CANDIDATE_ID%" --browser-executable "%AP_BROWSER_REL%" --portable-browsers-root "browsers" --output-dir "logs\m0" --profile-root "data\m0-profiles" --live-url "%~1" --live-click-selector "%~2" --live-success-selector "%~3" --live-marker-selector "%~4" --headed
exit /b %ERRORLEVEL%

:run_without_marker
"%AP_NODE%" "%AP_ROOT%app\src\run-suite.js" --portable-root "%AP_ROOT%" --candidate-id "%AP_CANDIDATE_ID%" --browser-executable "%AP_BROWSER_REL%" --portable-browsers-root "browsers" --output-dir "logs\m0" --profile-root "data\m0-profiles" --live-url "%~1" --live-click-selector "%~2" --live-success-selector "%~3" --headed
exit /b %ERRORLEVEL%
