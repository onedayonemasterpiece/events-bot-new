{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenigevents.ru/schemas/autopresenter/m0/system-info.schema.json",
  "title": "Autopresenter M0 target system evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectedAt", "os", "user", "baseline", "pathVariants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "version", "build", "architecture"],
      "properties": {
        "productName": { "const": "Windows 10" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "build": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        "architecture": { "const": "x64" }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardUser", "administrator"],
      "properties": {
        "standardUser": { "type": "boolean" },
        "administrator": { "type": "boolean" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedNode", "installedChrome", "installedPlaywright"],
      "properties": {
        "installedNode": { "type": "boolean" },
        "installedChrome": { "type": "boolean" },
        "installedPlaywright": { "type": "boolean" }
      }
    },
    "pathVariants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "passed"],
        "properties": {
          "kind": { "enum": ["plain", "spaces", "unicode"] },
          "path": { "type": "string", "minLength": 3, "maxLength": 500 },
          "passed": { "type": "boolean" }
        }
      }
    }
  }
}
