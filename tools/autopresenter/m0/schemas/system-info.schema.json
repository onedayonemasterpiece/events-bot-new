{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenigevents.ru/schemas/autopresenter/m0/system-info.schema.json",
  "title": "Autopresenter M0 target system evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectedAt", "provenance", "os", "hardware", "display", "locale", "user", "launch", "baseline", "security", "pathVariants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collectedAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineAccountFingerprint", "sourceCandidateId"],
      "properties": {
        "machineAccountFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceCandidateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "version", "build", "winver", "architecture"],
      "properties": {
        "productName": { "const": "Windows 10" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "build": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        "winver": { "type": "string", "minLength": 1, "maxLength": 100 },
        "architecture": { "const": "x64" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "ramBytes", "gpu"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ramBytes": { "type": "integer", "minimum": 1073741824 },
        "gpu": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driverVersion"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 300 },
              "driverVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "scalingPercent", "devicePixelRatio"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "scalingPercent": { "type": "number", "minimum": 50, "maximum": 500 },
        "devicePixelRatio": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            { "type": "null" }
          ]
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "locale", "timezone"],
      "properties": {
        "language": { "type": "string", "minLength": 2, "maxLength": 100 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 100 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardUser", "administrator", "accountType"],
      "properties": {
        "standardUser": { "type": "boolean" },
        "administrator": { "type": "boolean" },
        "accountType": { "enum": ["standard", "administrator"] }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portablePath"],
      "properties": {
        "portablePath": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedNode", "installedChrome", "installedPlaywright"],
      "properties": {
        "installedNode": { "type": "boolean" },
        "installedChrome": { "type": "boolean" },
        "installedPlaywright": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defender", "appLocker", "wdac", "collectedWithoutElevation"],
      "properties": {
        "defender": { "enum": ["enabled", "disabled", "unknown"] },
        "appLocker": { "enum": ["enabled", "disabled", "unknown"] },
        "wdac": { "enum": ["enabled", "disabled", "unknown"] },
        "collectedWithoutElevation": { "type": "boolean" }
      }
    },
    "pathVariants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "passed", "selfTest", "selfTestSha256"],
        "properties": {
          "kind": { "enum": ["plain", "spaces", "unicode"] },
          "path": { "type": "string", "minLength": 3, "maxLength": 500 },
          "passed": { "type": "boolean" },
          "selfTest": { "type": "string", "minLength": 3, "maxLength": 500 },
          "selfTestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
