FROM node:22.12.0-bookworm-slim AS site-build

ENV ASTRO_TELEMETRY_DISABLED=1
WORKDIR /build/site
COPY site/package.json site/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY site/ ./
RUN npm run build

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    AUTOPRESENTER_STATIC_SITE_DIR=/app/site

WORKDIR /app
COPY tools/autopresenter/prototype/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --requirement /app/requirements.txt

COPY tools/autopresenter/relay /app/tools/autopresenter/relay
COPY tools/autopresenter/agent /app/tools/autopresenter/agent
COPY tools/autopresenter/prototype/first-test /app/tools/autopresenter/prototype/first-test
COPY --from=site-build /build/site/dist /app/site

EXPOSE 8080
CMD ["sh", "-c", "python /app/tools/autopresenter/relay/server.py --host 0.0.0.0 --port ${PORT}"]
