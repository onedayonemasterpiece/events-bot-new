# Development Mode
# Установите DEV_MODE=1 для локальной разработки с polling
# Оставьте пустым или установите 0 для продакшен режима с webhook
DEV_MODE=1

# Telegram Bot Token
# Получите токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin chat (для алертов/отчётов scheduled jobs)
# Узнайте ID чата через /getid или логи бота
ADMIN_CHAT_ID=

# Telegram event publishing after Smart Update
# Publishes one short event announcement plus follow-up media groups.
ENABLE_TG_EVENT_PUBLISHING=1
# Optional override; default target is @kldevents.
# TG_EVENT_CHANNEL=@another_channel
# TG_EVENT_REWRITE_MODEL=gemini-3.1-flash-lite

# Batch social metrics for the static /populyarnoe feed. One interval job loads
# all due posts and requests them in platform batches; it never schedules one job
# per publication. VK is ready immediately. Telegram remains off until a new,
# dedicated role-scoped user session is provided (no E2E/S22 fallback).
# Production scheduler launches one remote Kaggle CPU batch; the legacy direct
# Fly reader remains disabled/test-only.
ENABLE_SOCIAL_METRICS_KAGGLE=0
SOCIAL_METRICS_BATCH_INTERVAL_MINUTES=30
SOCIAL_METRICS_KAGGLE_TIMEOUT_SECONDS=1800
SOCIAL_METRICS_VK_ENABLED=1
SOCIAL_METRICS_VK_OFFICIAL_GROUP_ID=231828790
SOCIAL_METRICS_VK_BATCH_SIZE=100
SOCIAL_METRICS_VK_BATCH_PAUSE_MS=350
SOCIAL_METRICS_VK_RESOLVE_COOLDOWN_HOURS=6
SOCIAL_METRICS_VK_RESOLVE_MAX_CANDIDATES=500
SOCIAL_METRICS_VK_WALL_SCAN_LIMIT=1000
SOCIAL_METRICS_TG_ENABLED=0
# Dedicated role-scoped reader only. Never point this at E2E/S22/editor sessions.
# TELEGRAM_AUTH_BUNDLE_CHECK_POPULAR=
# SOCIAL_METRICS_TG_API_ID=
# SOCIAL_METRICS_TG_API_HASH=
# When the two values above are absent, shared Telegram app credentials
# TG_API_ID/TG_API_HASH are allowed; only the user session must stay dedicated.
# SOCIAL_METRICS_TG_EVENT_CHANNEL=kldevents
# SOCIAL_METRICS_TG_AFISHA_CHANNEL=kenigevents
# SOCIAL_METRICS_TG_INCLUDE_EXTERNAL=0
# SOCIAL_METRICS_TG_BATCH_SIZE=50
# SOCIAL_METRICS_TG_FLOOD_SLEEP_SECONDS=60
# SOCIAL_METRICS_TG_STARTUP_DELAY_SECONDS=4,12
# SOCIAL_METRICS_TG_BETWEEN_REQUESTS_SECONDS=2,5
# SOCIAL_METRICS_TG_BETWEEN_CHANNELS_SECONDS=5,15

# Telegram premium/custom emoji editor for daily announcements.
# Uses Telethon after Bot API publication; prefer a dedicated auth bundle.
ENABLE_TG_PREMIUM_EMOJI_EDITOR=0
# TG_PREMIUM_EMOJI_EDIT_DELAY_SECONDS=150
# TG_PREMIUM_EMOJI_EDIT_JITTER_SECONDS=45
# TG_PREMIUM_EMOJI_BETWEEN_EDITS_SECONDS=3,12
# Durable outbox catch-up throttle for delayed event-post Premium/custom-emoji edits.
# TG_PREMIUM_EMOJI_JOB_INTERVAL_SECONDS=90
# TG_PREMIUM_EMOJI_AUTH_BUNDLE=
# TG_PREMIUM_EMOJI_SESSION=
# TG_PREMIUM_EMOJI_API_ID=
# TG_PREMIUM_EMOJI_API_HASH=
# TG_PREMIUM_EMOJI_FREE_DOCUMENT_IDS=5406749623865857008,5407072545276973461,5406815783542085177,5406927577245833438
# TG_PREMIUM_EMOJI_DAILY_SINGLE_DOCUMENT_IDS_JSON={"👉":5204036388789445008,"🎭":5390961951150988955,"🤘":5393556708398225048,"🎟":5267071016747690521,"💰":5305700407874449437,"📗":5339143926638996892,"🏰":5305794630866989617}
# TG_PREMIUM_EMOJI_TRETYAKOV_DOCUMENT_IDS=5188683852096234620,5188445640325099838
# Local/manual only: allow TELEGRAM_AUTH_BUNDLE_E2E / TELEGRAM_SESSION fallback.
# TG_PREMIUM_EMOJI_ALLOW_E2E_FALLBACK=0

# VK dynamic community cover
# Generates 1920x768 VK community cover proposals and 1080x1920 mobile
# cover-slide assets from active festival/promo context. Manual UI: /cover.
# Current MVP is proposal-only: /cover request and /cover apply send previews
# to Telegram without changing the VK cover. /cover restore can still upload
# a previously saved default cover for recovery.
ENABLE_VK_DYNAMIC_COVER_SCHEDULER=1
# Captcha recovery probes a harmless postponed wall read after the cooldown and
# resumes only the persisted pause cohort at a paced rate.
# VK_CAPTCHA_AUTO_RECOVERY_SEC=600
# VK_CAPTCHA_RESUME_SPACING_SEC=30
# Defaults to VK_EVENTS_GROUP_ID, then VK_AFISHA_GROUP_ID.
# VK_DYNAMIC_COVER_GROUP_ID=231920894
# Persistent server storage for the saved default cover.
# VK_DYNAMIC_COVER_STORAGE_DIR=/data/vk_dynamic_cover

# Festival queue / light festival monitoring safety
# The queue is disabled by default unless ENABLE_FESTIVAL_QUEUE=1. Even manual
# /fest_queue runs are capped so an old backlog cannot be processed all at once.
# FESTIVAL_QUEUE_MAX_ITEMS_PER_RUN=10
# Aggregated VK festival posts are disabled by default until the festival
# monitoring debt is closed. Ordinary event-level VK/TG publishing is separate.
# ENABLE_FESTIVAL_VK_POSTS=0
# UniversalFestivalParser guardrails for URL-based festival parsing on Kaggle.
# FESTIVAL_PARSER_TIMEOUT_MINUTES=30
# FESTIVAL_PARSER_TIMEOUT_MS=30000
# FESTIVAL_PARSER_MAX_LLM_CALLS=2
# FESTIVAL_PARSER_MAX_ESTIMATED_TOKENS_PER_CALL=8000
# FESTIVAL_PARSER_NO_LLM=0
# FESTIVAL_PARSER_DRY_RUN=0
# FESTIVAL_PARSER_LLM_MODEL=gemma-3-27b

# Telegraph / Telegram web preview (optional)
# Operator reports (Smart Update details) use `disable_web_page_preview=True` to stay compact,
# so Telegram won't prefetch Telegraph pages from those messages.
#
# If you want pages to be "ready in Telegram cache" right after publish:
# - validate image URLs before publishing (drops/replaces broken ones)
# - (optionally) warm up Telegram web preview right after page publish
# Note: `telegra.ph/upload` is deprecated/unavailable — images are hosted in Supabase Storage (WebP).
# TELEGRAPH_VALIDATE_IMAGE_URLS=1
# TELEGRAPH_PREVIEW_WARMUP=1
# TELEGRAPH_PREVIEW_WARMUP_CHAT_ID=   # default: ADMIN_CHAT_ID
# TELEGRAPH_PREVIEW_WARMUP_DELETE_SEC=30

# Scheduler heavy-ops guard (recommended)
# Prevents parallel long-running jobs (manual vs scheduled). When a scheduled heavy job is skipped,
# the bot notifies `ADMIN_CHAT_ID`.
# SCHED_HEAVY_GUARD_MODE=skip   # skip | wait | off
# SCHED_HEAVY_TRY_TIMEOUT_SEC=0.2
# Legacy: extra in-scheduler serialization (implies guard_mode=wait)
# SCHED_SERIALIZE_HEAVY_JOBS=0

# Persistent runtime logs on the mounted volume (production default: enabled).
# Size rotation and a hard total budget prevent the logger from filling /data;
# the free-space floor pauses file writes while stdout/Fly logs continue.
ENABLE_RUNTIME_FILE_LOGGING=1
RUNTIME_LOG_DIR=/data/runtime_logs
RUNTIME_LOG_BASENAME=events-bot.log
RUNTIME_LOG_RETENTION_HOURS=48
RUNTIME_LOG_MAX_FILE_MB=8
RUNTIME_LOG_MAX_TOTAL_MB=64
RUNTIME_LOG_MIN_FREE_MB=256
RUNTIME_LOG_LEVEL=INFO
RUNTIME_DISK_PATH=/data
RUNTIME_DISK_WARN_FREE_MB=350
RUNTIME_DISK_CRITICAL_FREE_MB=256
RUNTIME_SCRATCH_PATH=/tmp
RUNTIME_SCRATCH_WARN_FREE_MB=1024
RUNTIME_SCRATCH_CRITICAL_FREE_MB=512

# OpenAI API Token (для LLM операций)
# FOUR_O_TOKEN=sk-...
# Hard daily guard for direct gpt-4o spend. When the persisted UTC-day usage
# plus the next estimated request would exceed this cap, calls fall back to mini.
# FOUR_O_GPT4O_DAILY_TOKEN_LIMIT=950000
# FOUR_O_GPT4O_FALLBACK_MODEL=gpt-4o-mini

# Event parsing backend (VK/TG text -> structured drafts)
# По умолчанию используется Gemma. Чтобы временно форсировать старый OpenAI-парсер:
# EVENT_PARSE_LLM=4o
# EVENT_PARSE_GEMMA_MODEL=gemma-4-31b-it
# EVENT_PARSE_GEMMA_MAX_TOKENS=6000
# EVENT_PARSE_GEMMA_PROVIDER_TIMEOUT_SEC=210
# EVENT_PARSE_GEMMA_TPM_RESERVATION_TARGET=14500
# EVENT_PARSE_GEMMA_MIN_OUTPUT_TOKENS=2400
# JSON parse fallback to 4o is disabled by default so Gemma migration runs stay model-clean.
# EVENT_PARSE_ENABLE_4O_FALLBACK=0

# Smart Update (sources → facts → text)
# Fact-first narrative generation (default: enabled). Rollback: set to 0.
# SMART_UPDATE_FACT_FIRST=1
# Optional: allow light emoji usage in full public descriptions (Telegraph/body).
# SMART_UPDATE_DESCRIPTION_EMOJI_MODE=light   # light | off
# SMART_UPDATE_DESCRIPTION_MAX_EMOJIS=3
# Far-future poster date guard (months ahead of today). Set to 0 to disable.
# SMART_UPDATE_FAR_FUTURE_REVIEW_MONTHS=6
# Per-stage primary model overrides for Smart Update. Default routes
# fact extraction and the main writer to gemini-3.1-flash-lite (500 RPD per
# key Free Tier; defensive 450 cap configured in google_ai_model_limits) and
# falls back to gemma-4-31b-it via GOOGLE_AI_FALLBACK_MODELS. Other Smart
# Update stages (revise/rewrite/short_description/search_digest/coverage)
# remain on SMART_UPDATE_MODEL. Set both to gemma-4-31b-it to roll back.
# SMART_UPDATE_FACTS_MODEL=gemini-3.1-flash-lite
# SMART_UPDATE_WRITER_MODEL=gemini-3.1-flash-lite
# Route every bounded Smart Update semantic contract to the staged Gemini
# facts/writer models. Hosted Gemma 4 rejects thinking_budget and may otherwise
# spend a small response cap on thought-only output.
# Emergency-only diagnostic override. Do not enable in steady-state production:
# it routes every Smart Update semantic contract to the lower-RPD Gemini lane.
# SMART_UPDATE_FORCE_STAGED_GEMINI=0
# SMART_UPDATE_G4_SPLIT_CREATE=1
# SMART_UPDATE_G4_SPLIT_CREATE_PROMPT_FALLBACK=0
# Keep 4o as an emergency Smart Update fallback, but cap mass fallback storms.
# Empty/unset SMART_UPDATE_4O_FALLBACK_MAX_PER_HOUR means unlimited; prod can set
# a small positive value during quota incidents. SMART_UPDATE_4O_FALLBACK=0 is an
# incident containment kill-switch, not the normal steady-state.
# SMART_UPDATE_4O_FALLBACK=1
# SMART_UPDATE_4O_FALLBACK_MAX_PER_HOUR=4
# Smart Update is a mass pipeline, so provider 500 retries are capped separately
# from other GoogleAIClient consumers to avoid multiplying Gemma RPM/RPD burn.
# SMART_UPDATE_GOOGLE_AI_MAX_RETRIES=1
# Event-age semantics never open a separate provider request. `piggyback_only`
# adds the strict age_decision object to an already-required Smart Update call;
# `off` preserves source-native structured values only.
# SMART_UPDATE_EVENT_AGE_LLM_MODE=piggyback_only
# Static export is fail-closed by default. The labeled mode must be approved
# separately by product/legal before enabling.
# STATIC_EVENT_AGE_POLICY=declared_only

# CPU-only Kaggle BGE retrieval + calibrated lexical safety cascade. The model
# revision, prepared prototype vectors, raw-matrix classifier and evaluation
# self-tests must describe one exact approved artifact set; mismatch abstains.
# EVENT_AGE_BGE_MODEL_REVISION=<hugging-face-commit-sha>
# ENABLE_EVENT_AGE_BGE_ASSESSMENT=0
# EVENT_AGE_BGE_DEBOUNCE_SECONDS=1500
# EVENT_AGE_BGE_REMAINDER_DELAY_SECONDS=120
# EVENT_AGE_BGE_OCR_RECHECK_SECONDS=1800
# EVENT_AGE_BGE_BATCH_LIMIT=64
# EVENT_AGE_BGE_BATCH_SIZE=4
# EVENT_AGE_BGE_MAX_LENGTH=768
# EVENT_AGE_BGE_MAX_RUNTIME_SECONDS=2400
# EVENT_AGE_BGE_RUNTIME_GUARD_SECONDS=120
# EVENT_AGE_BGE_KAGGLE_TIMEOUT_MINUTES=55
# EVENT_AGE_BGE_KAGGLE_POLL_SECONDS=30
# EVENT_AGE_BGE_ARTIFACT_DATASET=<kaggle-user/prepared-private-artifacts>
# EVENT_AGE_BGE_CLASSIFIER_SHA256=<required-to-activate-a-calibrated-head>
# EVENT_AGE_BGE_POLICY_VERSION=event-age-bge-policy-v2

# Automatic Smart Update event-media gate (no manual review queue).
# EVENT_SOURCE_MEDIA_REHYDRATE_ENABLED=1
# EVENT_MEDIA_REVIEW_PRIMARY_MODEL=gemini-3.1-flash-lite
# EVENT_MEDIA_REVIEW_ESCALATION_MODEL=models/gemma-4-31b-it
# EVENT_MEDIA_REVIEW_GOOGLE_KEY_ENV=GOOGLE_API_KEY4
# EVENT_MEDIA_REVIEW_DAILY_PRIMARY_CALLS=100
# EVENT_MEDIA_REVIEW_DAILY_ESCALATION_CALLS=25
# EVENT_MEDIA_REVIEW_PRIMARY_CONFIDENCE=0.92
# EVENT_MEDIA_REVIEW_MAX_UNCERTAIN_ATTEMPTS=3
# EVENT_MEDIA_REVIEW_PROVIDER_TIMEOUT_SEC=45
# EVENT_MEDIA_REVIEW_DOWNLOAD_TIMEOUT_SEC=25
# EVENT_MEDIA_REVIEW_MAX_IMAGE_BYTES=8000000
# Versioned face/value geometry is an independent Gemma 4 stage. The normal
# KEY4+KEY5 pool participates before the first call; it is not emergency overflow.
# EVENT_IMAGE_GEOMETRY_MODEL=gemma-4-31b-it
# EVENT_IMAGE_GEOMETRY_GOOGLE_KEY_ENVS=GOOGLE_API_KEY4,GOOGLE_API_KEY5
# EVENT_IMAGE_GEOMETRY_DAILY_CALLS=100
# EVENT_IMAGE_GEOMETRY_FOLLOWUP_SECONDS=7
# EVENT_IMAGE_GEOMETRY_PROVIDER_TIMEOUT_SEC=90
# EVENT_IMAGE_GEOMETRY_MAX_OUTPUT_TOKENS=768
# Semantic crop-role calls rotate through this ordinary pool; this is not an
# emergency overflow/fallback list. Provider rate limits and temporary failures
# stay pending and are retried after the bounded delay.
# EVENT_MEDIA_ROLE_GOOGLE_KEY_ENVS=GOOGLE_API_KEY4,GOOGLE_API_KEY5
# EVENT_MEDIA_ROLE_RATE_RETRY_SECONDS=600
# EVENT_MEDIA_ROLE_TRANSIENT_RETRY_SECONDS=900
# Smart Update Vector Identity Gate (create-path duplicate prevention).
# off = disabled, shadow = log/verdict only, enforce = may veto duplicate creates.
# SMART_UPDATE_IDENTITY_GATE=off
# Smart Update Merge Identity Gate (merge-path side-effect prevention).
# off = disabled, shadow = log/verdict only, enforce = may skip unsafe merge side effects.
# SMART_UPDATE_MERGE_IDENTITY_GATE=off
# SMART_UPDATE_IDENTITY_VECTOR_RECALL=1
# SMART_UPDATE_IDENTITY_VECTOR_TOP_K=8
# SMART_UPDATE_IDENTITY_VECTOR_MIN_SIMILARITY=0.75
# SMART_UPDATE_IDENTITY_VECTOR_TIMEOUT_SECONDS=2.5
# SMART_UPDATE_IDENTITY_EMBEDDING_MODEL=gemini-embedding-2
# SMART_UPDATE_IDENTITY_EMBEDDING_DIM=768
# SMART_UPDATE_IDENTITY_GOOGLE_KEY_ENV=GOOGLE_API_KEY4
# Vector recall uses the static-site Supabase vector tables/RPC. Prefer dedicated personalization vars;
# when unset, runtime falls back to existing SUPABASE_URL plus SUPABASE_SERVICE_KEY/SUPABASE_KEY.
# PERSONALIZATION_SUPABASE_URL=
# PERSONALIZATION_SUPABASE_SERVICE_ROLE_KEY=


# Google AI Studio (Gemma/Gemini)
GOOGLE_API_KEY=
# Dedicated cross-process quota ledger. This pair is atomic and is deliberately
# separate from general/storage Supabase variables. Remote provider consumers
# fail closed when it is incomplete or unavailable.
# GOOGLE_AI_LIMITER_SUPABASE_URL=https://<project-ref>.supabase.co
# GOOGLE_AI_LIMITER_SUPABASE_SERVICE_KEY=<service-role-or-secret-key>
# Optional additional Google AI key lanes used by the shared limiter and
# authorized event-search Edge Function rotation when configured.
# GOOGLE_API_KEY2=
# GOOGLE_API_KEY3=
# GOOGLE_API_KEY4=
# GOOGLE_API_KEY5=
# GOOGLE_API_KEY6=
# Shared normal key allocation owned by GoogleAIClient (not by Smart Update or
# another feature). Every member must exist in `google_ai_api_keys`; partial
# registry drift fails closed. Provider 429 rotates inside this pool without a
# quota-window sleep. Explicit constructor pools override it for scoped lanes.
# GOOGLE_AI_NORMAL_KEY_ENVS=GOOGLE_API_KEY6,GOOGLE_API_KEY,GOOGLE_API_KEY2,GOOGLE_API_KEY3,GOOGLE_API_KEY4,GOOGLE_API_KEY5
# Comma-separated fallback chain for GoogleAIClient. When the primary model
# returns 5xx/empty/retryable errors the client transparently falls through
# to the next id. On prod we set both directions so any Smart Update or
# event_parse consumer has a complementary alternative when Google flaps.
# GOOGLE_AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-31b-it
# Region Talk pins its own text/VLM order independently from the global chain.
# A limiter block on 3.5 (RPM/TPM/RPD) advances to 3.1 before any provider send;
# provider-side failures stay within the product's one-send budget.
# REGION_TALK_LLM_MODEL=gemini-3.5-flash-lite
# REGION_TALK_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
# Emergency daily-budget overflow keys for scoped consumers. Each listed env
# name must also have active metadata in Supabase `google_ai_api_keys`; an
# env-only secret is invisible to the shared reserve RPC.
# GOOGLE_AI_RESERVE_OVERFLOW_KEY_ENVS=GOOGLE_API_KEY4,GOOGLE_API_KEY3,GOOGLE_API_KEY2
# Process-local fallback limiter used when Supabase reserve is missing/flaky or
# a caller accidentally constructs GoogleAIClient without Supabase. Default RPM
# is 15 to match Gemma 4 free-tier per-key limits and fail fast before provider 429.
# GOOGLE_AI_LOCAL_RPM=15
# GOOGLE_AI_LOCAL_TPM=12000
# GOOGLE_AI_LOCAL_RPD=5000
# Per-call provider timeout (seconds). Each generate_content_async attempt
# is wrapped in asyncio.wait_for so that a hung Gemma 4 request (e.g. the
# thought-loop failure mode that returns no output but consumes ~32k thought
# tokens) is bounded and bubbles up as a retryable TimeoutError, letting the
# fallback chain take over instead of a 240s wall-clock raise. Default 0
# disables the timeout. Prod runs 120s — covers ~98% of healthy Gemma 4
# event_parse calls based on prod log p98.
# GOOGLE_AI_PROVIDER_TIMEOUT_SEC=120
# Antigravity festival web research is collect-only and disabled by default.
# Enabling it requires an injected strict-limiter service and migration 007;
# URL rows otherwise fail closed instead of reaching the legacy direct writer.
# ENABLE_FESTIVAL_WEB_RESEARCH=0
# FESTIVAL_WEB_RESEARCH_ARTIFACT_ROOT=artifacts/festival-web-research
# FESTIVAL_WEB_RESEARCH_MAX_TOTAL_TOKENS=60000
# FESTIVAL_WEB_RESEARCH_DEADLINE_SECONDS=900
# Canary/debug only while migration 007 is unavailable; never enable in production.
# GOOGLE_AI_EXTERNAL_ACCOUNTING_COMPAT=0
# Pre-route oversized posts directly to a different event_parse model
# instead of trying Gemma 4 first (and waiting on its timeout/fallback).
# Threshold is the total length of post text + poster_summary + poster_texts
# in characters; default 2500 catches multi-event "afisha" / digest posts
# where Gemma 4 reliably enters thought-loop. Set threshold to 0 to disable.
# Setting LARGE_POST_MODEL empty also disables the routing.
# EVENT_PARSE_LARGE_POST_THRESHOLD_CHARS=2500
# EVENT_PARSE_LARGE_POST_MODEL=gemini-3.1-flash-lite

# Telegram Monitoring / local Telethon runtime
TG_SESSION=
TG_API_ID=
TG_API_HASH=

# Kaggle API (для запуска kernels через API)
KAGGLE_USERNAME=
KAGGLE_KEY=
# KAGGLE_CONFIG_DIR=/path/to/kaggle/config

# Telegraph cache sanitizer schedule (опционально)
# Прогрев/проверка Telegram web preview (Instant View cached_page + preview photo) для Telegraph страниц
# через Kaggle/Telethon и постановка “битых” страниц на пересборку.
ENABLE_TELEGRAPH_CACHE_SANITIZER=0
TELEGRAPH_CACHE_TIME_LOCAL=01:10
TELEGRAPH_CACHE_TZ=Europe/Kaliningrad
# Tuning (optional):
# TELEGRAPH_CACHE_DAYS_BACK=7
# TELEGRAPH_CACHE_DAYS_FORWARD=120
# TELEGRAPH_CACHE_LIMIT_EVENTS=180
# TELEGRAPH_CACHE_LIMIT_FESTIVALS=80
# TELEGRAPH_CACHE_REPEATS=2
# TELEGRAPH_CACHE_ATTACH_WAIT_SEC=20
# TELEGRAPH_CACHE_PER_URL_TIMEOUT_SEC=35
# TELEGRAPH_CACHE_DELETE_MESSAGES=1
# TELEGRAPH_CACHE_REGEN_AFTER_RUNS=2
# TELEGRAPH_CACHE_ENQUEUE_REGEN=1
# If you keep multiple auth bundles (prod/dev/e2e), select which env key to use:
# TELEGRAPH_CACHE_AUTH_BUNDLE_ENV=TELEGRAM_AUTH_BUNDLE_S22

# Exhibition duplicate acceptance audit (опционально; рекомендуется после SMART_UPDATE_IDENTITY_GATE=enforce)
# Read-only ежедневная проверка публичных /vystavki/-кандидатов. При high-confidence дублях
# пишет failed ops_run, уведомляет superadmin/admin chat и по умолчанию падает job error.
ENABLE_EXHIBITION_DUPLICATE_AUDIT=0
EXHIBITION_DUPLICATE_AUDIT_TIME_LOCAL=07:45
EXHIBITION_DUPLICATE_AUDIT_TZ=Europe/Kaliningrad
# EXHIBITION_DUPLICATE_AUDIT_SINCE_DAYS=14
# EXHIBITION_DUPLICATE_AUDIT_RAISE_ON_DUPLICATES=1
# EXHIBITION_DUPLICATE_AUDIT_NOTIFY_ON_SUCCESS=0
# EXHIBITION_DUPLICATE_AUDIT_MAX_ALERT_PAIRS=8
# EXHIBITION_DUPLICATE_AUDIT_MAX_DETAILS_PAIRS=20

# Telegram Monitoring schedule (опционально)
ENABLE_TG_MONITORING=0
TG_MONITORING_TIME_LOCAL=23:40
TG_MONITORING_TZ=Europe/Kaliningrad
# TG_MONITORING_MISFIRE_GRACE_SECONDS=1800
# TG_MONITORING_CATCHUP_LOOKBACK_SECONDS=86400
# TG_MONITORING_DAYS_BACK=3
# If you want mature /popular_posts 7-day Telegram snapshots (age_day=6), raise this to at least 7.
# TG_MONITORING_TIMEOUT_MODE=dynamic
# TG_MONITORING_TIMEOUT_MINUTES=90
# TG_MONITORING_TIMEOUT_BASE_MINUTES=15
# TG_MONITORING_TIMEOUT_PER_SOURCE_MINUTES=3.64
# TG_MONITORING_TIMEOUT_SAFETY_MULTIPLIER=1.3
# TG_MONITORING_TIMEOUT_MAX_MINUTES=360
# /tg inline drain (best-effort): max seconds to wait for JobOutbox to build Telegraph/ICS per-post.
# TG_MONITORING_INLINE_DRAIN_TIMEOUT_SEC=10
# Cross-process lock file (опционально). Полезно, если на хосте может запуститься 2 polling-инстанса.
# По умолчанию: /tmp/eventsbot-<BOT_CODE>-tg-monitoring.lock
# TG_MONITORING_GLOBAL_LOCK_PATH=/tmp/eventsbot-announcements_test-tg-monitoring.lock
# TG monitoring on demand fast-path from Bot API channel_post updates.
# Requires ENABLE_TG_MONITORING=1 for scheduler dispatch; default source is @kraftmarket39.
# ENABLE_TG_MONITORING_ON_DEMAND=1
# TG_MONITORING_ON_DEMAND_SOURCES=kraftmarket39
# TG_MONITORING_ON_DEMAND_DEBOUNCE_SECONDS=600
# TG_MONITORING_ON_DEMAND_RETRY_SECONDS=600
# TG_MONITORING_ON_DEMAND_POLL_SECONDS=60
# TG_MONITORING_ON_DEMAND_SEND_PROGRESS=0

# Source parsing schedule (опционально)
ENABLE_SOURCE_PARSING=0
SOURCE_PARSING_TIME_LOCAL=04:30
SOURCE_PARSING_TZ=Europe/Kaliningrad
ENABLE_SOURCE_PARSING_DAY=0
SOURCE_PARSING_DAY_TIME_LOCAL=14:15
SOURCE_PARSING_DAY_TZ=Europe/Kaliningrad
SOURCE_PARSING_DEBUG_RETENTION_DAYS=7
SOURCE_PARSING_DEBUG_MAX_TOTAL_MB=16

# 3D previews schedule (опционально)
ENABLE_3DI_SCHEDULED=0
THREEDI_TIMES_LOCAL=07:15,15:15,17:15
THREEDI_TZ=Europe/Kaliningrad

# Guide excursions schedule (опционально)
ENABLE_GUIDE_EXCURSIONS_SCHEDULED=0
GUIDE_EXCURSIONS_LIGHT_TIMES_LOCAL=09:05,13:20
GUIDE_EXCURSIONS_FULL_TIME_LOCAL=20:10
GUIDE_EXCURSIONS_TZ=Europe/Kaliningrad
# Default narrow Gemini-lite split for guide monitoring:
# GUIDE_MONITORING_SCREEN_MODEL=models/gemma-4-26b-a4b-it
# GUIDE_MONITORING_EXTRACT_MODEL=models/gemini-3.1-flash-lite
# GUIDE_MONITORING_LLM_TIMEOUT_RETRIES=1
