# Post popularity analytics (TG/VK) (опционально)
# Baseline uses per-source median over the last N days for each age_day (days since publish).
# POST_POPULARITY_HORIZON_DAYS=90
# POST_POPULARITY_MIN_SAMPLE=20
# POST_POPULARITY_MAX_AGE_DAY=2
# Raise to 6 if you want mature /popular_posts 7-day snapshots instead of fallback to the latest available age_day<=6.
# POST_POPULARITY_VIEWS_MULT=1.5
# POST_POPULARITY_LIKES_MULT=1.5
# Multi-level markers ("super popular") — extra icons for stronger outliers:
# POST_POPULARITY_MAX_LEVEL=4
# POST_POPULARITY_VIEWS_STEP=0.5
# POST_POPULARITY_LIKES_STEP=0.5
# Retention for stored snapshots (defaults to POST_POPULARITY_HORIZON_DAYS if unset):
# POST_METRICS_RETENTION_DAYS=90

# Kaggle recovery (опционально, но полезно на проде)
# ENABLE_KAGGLE_RECOVERY=1
# KAGGLE_RECOVERY_INTERVAL_MINUTES=5

# Supabase (опционально; без него часть логов/фич отключится)
SUPABASE_URL=
SUPABASE_KEY=
# Для RPC (rate-limit gateway) обычно нужен service role:
# SUPABASE_SERVICE_KEY=
# Если RPC лежит не в `public`, выставьте схему (PostgREST Content-Profile):
# SUPABASE_SCHEMA=public
# SUPABASE_DISABLED=1
#
# Supabase Storage buckets
# Legacy single-bucket setup (current behavior):
# SUPABASE_BUCKET=events-ics
# Planned split buckets (requires code support; see docs/operations/supabase-storage.md):
# SUPABASE_ICS_BUCKET=events-ics
# SUPABASE_MEDIA_BUCKET=events-media
#
# Bucket usage guard (optional, best-effort):
# SUPABASE_BUCKET_USAGE_GUARD_MAX_USED_MB=490
# SUPABASE_BUCKET_USAGE_GUARD_CACHE_SEC=600
# SUPABASE_BUCKET_USAGE_GUARD_ON_ERROR=deny
#
# Server-side poster uploads (upload_images -> Supabase Storage):
# SUPABASE_POSTERS_PREFIX=p
# SUPABASE_POSTERS_WEBP_QUALITY=82
# When sharing one media bucket between PROD/TEST (different SQLite DBs), disable media deletes on TEST:
# SUPABASE_MEDIA_DELETE_ENABLED=1
#
# Telegram Monitoring event videos (Kaggle producer -> Yandex CDN).
# Legacy mode name is retained for compatibility; `always` enables the gated
# pipeline. Only accepted content-addressed bytes are uploaded (never Supabase).
# TG_MONITORING_VIDEOS_SUPABASE_MODE=always
# Hard product limit is strict <10 MiB even if a larger value is configured.
# TG_MONITORING_VIDEO_MAX_MB=10
# TG_MONITORING_VIDEOS_PREFIX=v
# TG_MONITORING_VIDEO_MODEL=gemini-3.1-flash-lite
# Required scoped secrets; every declared key is shipped to Kaggle. Calls still
# reserve/finalize through the shared Supabase Google AI limiter.
# TG_MONITORING_VIDEO_GOOGLE_KEY_ENVS=GOOGLE_API_KEY3,GOOGLE_API_KEY5
# TG_MONITORING_VIDEO_MAX_MODEL_CALLS_PER_RUN=6  # hard provider-send maximum; no app/SDK retry or 429 rotation
# Explicit operator authorization; sources outside this list are not downloaded,
# analyzed, or copied to CDN. Never use a wildcard.
# TG_MONITORING_VIDEO_REPUBLICATION_ALLOWED_SOURCES=meowafisha
# Stable Fernet key for encrypted SHA analysis sidecars. Generate once with
# `python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'`
# and never rotate/delete it while analysis sidecars are retained.
# TG_MONITORING_VIDEO_ANALYSIS_CACHE_KEY=
# Grace before deletion after the final event relation disappears.
# VIDEO_ASSET_ORPHAN_GRACE_HOURS=24  # production minimum is 24h
# High-precision portrait rollout envelope.
# TG_MONITORING_VIDEO_MIN_WIDTH_HEIGHT_RATIO=0.50
# TG_MONITORING_VIDEO_MAX_WIDTH_HEIGHT_RATIO=0.80
# TG_MONITORING_VIDEO_MIN_WIDTH=540
# TG_MONITORING_VIDEO_MIN_HEIGHT=960
# TG_MONITORING_VIDEO_MIN_DURATION_SEC=2
# TG_MONITORING_VIDEO_MAX_DURATION_SEC=60
# TG_MONITORING_VIDEO_ANALYSIS_VERSION=video-showcase-v2
#
# Telegram Monitoring posters in Supabase (Kaggle producer):
# TG_MONITORING_POSTERS_SUPABASE_MODE=always
# TG_MONITORING_POSTERS_PREFIX=p
# TG_MONITORING_POSTERS_WEBP_QUALITY=82
#
# /3di (3D Preview) images in Supabase (Kaggle Preview3D):
# SUPABASE_PREVIEW3D_PREFIX=p3d
# Telegraph cover JPEG mirrors (server-side, best-effort):
# Used to keep the *first* Telegraph image preview-friendly for Telegram Instant View caching.
# SUPABASE_TELEGRAPH_COVER_PREFIX=tgcover
# TELEGRAPH_COVER_MIRROR_MAX_BYTES=8388608

# LLM gateway fail-closed defaults: без общего Supabase RPC provider-вызов
# запрещён. Process-local limiter допустим только как явный opt-in для одного
# изолированного dev-процесса; его нельзя включать на Fly/Kaggle/в agent runs.
# GOOGLE_AI_ALLOW_RESERVE_FALLBACK=0
# GOOGLE_AI_LOCAL_LIMITER_FALLBACK=0
# GOOGLE_AI_LOCAL_LIMITER_ON_RESERVE_ERROR=0

# Production Webhook (только для продакшена)
# WEBHOOK_URL=https://your-domain.com

# Optional settings
# DB_PATH=/data/db.sqlite

# Для тестирования с продакшн-данными локально:
# 1. Скачайте снимок БД: ./scripts/sync_prod_db.sh
# 2. Используйте снимок: DB_PATH=./db_prod_snapshot.sqlite
# 3. Запустите в режиме разработки: DEV_MODE=1

# PORT=8080

# KenigEvents static site Kaggle builder after Smart Update
# Interest clubs release gates (default OFF; production static generation
# explicitly enables the last two after approved identities/relations exist)
# ENABLE_INTEREST_CLUB_PIPELINE=0
# ENABLE_INTEREST_CLUB_STATIC_PROJECTION=0
# PUBLIC_INTEREST_CLUBS_ENABLED=0
# INTEREST_CLUB_PROVIDER_TIMEOUT_SECONDS=30
# INTEREST_CLUB_STATIC_DEBOUNCE_SECONDS=90
# ENABLE_STATIC_SITE_KAGGLE_BUILDER=0
# Existing coalesced JobTask.static_site_build calendar rollover; guarantees a
# daily service-share refresh even when Smart Update has no event changes.
# STATIC_SITE_LOCAL_MIDNIGHT=00:00
# ENABLE_STATIC_SITE_SECRET_PUBLISH=0
# Exact pushed commit; required when the builder is enabled.
# STATIC_SITE_REPO_SHA=<40-character-git-sha>
# Build-time rollback for the desktop keyboard navigator. It is mounted only
# in immutable secret candidates; `0` removes it from the generated pages.
# PUBLIC_KEYBOARD_EVENT_NAVIGATION_ENABLED=1
# STATIC_SITE_BUILD_ID=production-secret
# STATIC_SITE_BUILDER_LIMIT=5000
# STATIC_SITE_MAX_ATTEMPTS=4
# STATIC_SITE_MAX_STALENESS_SECONDS=3600
# STATIC_SITE_SNAPSHOT_DIR=/data/static_site_snapshots
# Full downloaded output/work trees belong on persistent storage and are
# removed after their bounded receipt is durable. Unknown paths are untouched.
# STATIC_SITE_ARTIFACT_ROOT=/data/static_site_builder
# STATIC_SITE_SCRATCH_DIR=/data/static_site_builder/tmp
# STATIC_SITE_STORAGE_WARN_FREE_MB=1536
# STATIC_SITE_STORAGE_CRITICAL_FREE_MB=1024
# Maximum trailing Smart Update debounce from the first coalesced change.
# STATIC_SITE_MAX_DEBOUNCE_SECONDS=1800
# STATIC_SITE_OUTPUT_KEEP_LATEST_TERMINAL=0
# Crash-retention guard; active durable handoffs are always preserved separately.
# STATIC_SITE_SNAPSHOT_KEEP_LATEST_TERMINAL=1
# STATIC_SITE_SNAPSHOT_STALE_INCOMPLETE_SECONDS=900
# Shared CPU BGE mode performs one pinned related_v1 encode inside the existing
# coalesced builder and reuses it for related, unusual, and concept clustering.
# It has no provider calls and does not replace the independent Gemini
# search_v3 sync used by authorized Search.
# STATIC_SITE_RELATED_MODE=bge
# STATIC_SITE_REQUIRE_VECTOR_BARRIER=0
# STATIC_SITE_PRE_HANDOFF_STALE_SECONDS=600
# STATIC_SITE_CLAIM_RETRY_SECONDS=30
# STATIC_SITE_SYNC_PGVECTOR_VECTORS=0
# STATIC_SITE_BGE_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# STATIC_SITE_BGE_BATCH_SIZE=8
# STATIC_SITE_BGE_VECTOR_CACHE=/data/static_site_builder/static_event_bge_vectors.npz
# STATIC_SITE_BGE_VECTOR_RECEIPT=/data/static_site_builder/static_event_bge_vectors.receipt.json
# STATIC_SITE_UNUSUAL_ENABLED=1
# First adoption/migration never emits notification eligibility.
# STATIC_SITE_UNUSUAL_MIGRATION=1
# STATIC_SITE_UNUSUAL_CACHE=/data/static_site_builder/unusual_events_cache.json
# STATIC_SITE_UNUSUAL_LAST_GOOD=/data/static_site_builder/unusual_events_last_good.json
# Legacy pgvector mode only:
# STATIC_SITE_PGVECTOR_EMBEDDING_MODEL=gemini-embedding-2
# STATIC_SITE_PGVECTOR_EMBEDDING_KEY_ENV=GOOGLE_API_KEY4
# STATIC_SITE_PGVECTOR_MAX_PROVIDER_CALLS=1000
# STATIC_SITE_GEMMA_RELATED_VERIFY=1
# STATIC_SITE_GEMMA_RELATED_MODEL=models/gemma-4-26b-a4b-it
# STATIC_SITE_GEMMA_RELATED_KEY_ENV=GOOGLE_API_KEY4
# STATIC_SITE_GEMMA_RELATED_MAX_ANCHORS=50
# STATIC_SITE_ASSET_BASE_URL=https://static.kenigevents.ru
# STATIC_SITE_ASTRO_ASSET_BASE_URL=https://static.kenigevents.ru/{buildId}
# STATIC_SITE_ICS_BASE_URL=https://static.kenigevents.ru/ics
# STATIC_SITE_PUBLIC_PERSONALIZATION_SUPABASE_URL=https://<project-ref>.supabase.co
# STATIC_SITE_PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# STATIC_SITE_PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL=https://<gateway>.apigw.yandexcloud.net
# STATIC_SITE_PUBLIC_YANDEX_AUTH_PROVIDER=custom:yandex
# STATIC_SITE_SECRET_CANDIDATE_ARTIFACT_RESEARCH=0
# STATIC_SITE_SECRET_CANDIDATE_REQUIRE_AUTHORIZED_SEARCH=0
# STATIC_SITE_RELATED_CACHE=/data/static_site_event_related_chain_cache.json
# Trusted publisher only; never pass these values into Kaggle datasets.
# KENIGEVENTS_SITE_YC_BUCKET=kenigevents.ru
# KENIGEVENTS_SITE_YC_ENDPOINT=https://storage.yandexcloud.net
# KENIGEVENTS_SITE_YC_REGION=ru-central1
# KENIGEVENTS_SITE_YC_ACCESS_KEY_ID=...
# KENIGEVENTS_SITE_YC_SECRET_ACCESS_KEY=...
# KENIGEVENTS_SITE_PUBLIC_BASE_URL=https://kenigevents.ru

# Production canonical-root promotion. Default OFF: live root buckets/ALB/DNS
# do not exist yet. `plan` is inventory-only; only explicit `apply` mutates the
# inactive page-only bucket and ALB weights. See
# docs/operations/static-site-atomic-root.md before setting any value.
# ENABLE_STATIC_SITE_ROOT_PROMOTION=0
# STATIC_SITE_ROOT_PROMOTION_MODE=plan
# STATIC_SITE_ROOT_BLUE_BUCKET=kenigevents-root-blue
# STATIC_SITE_ROOT_GREEN_BUCKET=kenigevents-root-green
# STATIC_SITE_ROOT_BLUE_BACKEND=root-blue
# STATIC_SITE_ROOT_GREEN_BACKEND=root-green
# Must stay a third, separate bucket for shared media `/p/*`, stable `/ics/*`
# and immutable review candidates.
# STATIC_SITE_ROOT_SHARED_ASSET_BUCKET=kenigevents.ru
# STATIC_SITE_ROOT_ALB_BACKEND_GROUP_ID=<id>
# STATIC_SITE_ROOT_YC_FOLDER_ID=b1g5tck18cgqtjb7rn3s
# STATIC_SITE_ROOT_ACTIVE_WEIGHT=100
# STATIC_SITE_ROOT_PUBLIC_BASE_URL=https://kenigevents.ru
# STATIC_SITE_ROOT_RECEIPT_PATH=/data/static_site_builder/atomic-root-receipt.json
# STATIC_SITE_ROOT_SCRATCH_DIR=/data/static_site_builder/atomic-root-tmp
# STATIC_SITE_ROOT_YC_CLI=/home/dev/yandex-cloud/bin/yc
# STATIC_SITE_ROOT_YC_ENDPOINT=https://storage.yandexcloud.net
# STATIC_SITE_ROOT_YC_REGION=ru-central1
# Least-privileged credentials for the two root buckets only; Fly secrets,
# never Kaggle input/build config or PUBLIC_* variables.
# STATIC_SITE_ROOT_YC_ACCESS_KEY_ID=...
# STATIC_SITE_ROOT_YC_SECRET_ACCESS_KEY=...

# KenigEvents personalization Supabase / authorized event search
# Backend-only secret/direct connection are used by migrations, vector sync and Edge Function deploys.
# PUBLIC_* values are safe for static-site frontend and Supabase Auth.
# PERSONALIZATION_SUPABASE_URL=https://<project-ref>.supabase.co
# PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PERSONALIZATION_SUPABASE_SECRET_KEY=sb_secret_...
# PERSONALIZATION_DIRECT_CONNECTION_STRING=postgresql://...
# Yandex Cloud inbound-email deploy inputs (operator shell only; not Fly env).
# Function secret values belong in Lockbox and must never be placed in this file.
# EMAIL_INBOUND_YC_CLOUD_ID=
# EMAIL_INBOUND_BUCKET_NAME=kenigevents-email-inbound-<unique-suffix>
# EMAIL_INBOUND_ADAPTER_URL=https://functions.yandexcloud.net/<adapter-function-id>
# EMAIL_INBOUND_ADAPTER_KEY_ID=current-2026-07
# SpaceWeb cannot retain a mailbox and use its mutually-exclusive forwarding
# purpose at the same time. The production copy path is a read-only IMAP poller;
# all credentials below are Lockbox-backed function secrets, never Fly env.
# EMAIL_INBOUND_IMAP_HOST=imap.spaceweb.ru
# EMAIL_INBOUND_IMAP_PORT=993
# EMAIL_INBOUND_IMAP_STATE_KEY=state/spaceweb-info-cursor.json
# PUBLIC_PERSONALIZATION_SUPABASE_URL=https://<project-ref>.supabase.co
# PUBLIC_PERSONALIZATION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PUBLIC_PERSONALIZATION_SUPABASE_RELAY_URL=https://<gateway>.apigw.yandexcloud.net
# PUBLIC_YANDEX_AUTH_PROVIDER=custom:yandex
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# EVENT_SEARCH_EMBEDDING_MODEL=gemini-embedding-2
# Durable full-catalog vector sidecar projection after Smart Update and on an
# independent reconciliation interval. Semantic fields remain LLM-owned; this
# lane only projects canonical facts and hashes.
# ENABLE_EVENT_VECTOR_SYNC=1
# EVENT_VECTOR_SYNC_DEBOUNCE_SECONDS=90
# EVENT_VECTOR_SYNC_INTERVAL_MINUTES=180
# Keep the current Search projection stable while an immutable static build is
# active and for the bounded exact-target acceptance window after publication.
# EVENT_VECTOR_SYNC_POST_STATIC_GRACE_SECONDS=900
# EVENT_VECTOR_SYNC_CATALOG_LIMIT=5000
# EVENT_VECTOR_SYNC_MAX_PROVIDER_CALLS=500
# EVENT_VECTOR_SYNC_GOOGLE_KEY_ENV=GOOGLE_API_KEY4
# EVENT_VECTOR_SYNC_SLEEP_SECONDS=0.2
# EVENT_SEARCH_GOOGLE_KEY_ENVS=GOOGLE_API_KEY5,GOOGLE_API_KEY4,GOOGLE_API_KEY3,GOOGLE_API_KEY
# EVENT_SEARCH_EMBEDDING_KEY_ENVS=GOOGLE_API_KEY5,GOOGLE_API_KEY4,GOOGLE_API_KEY3,GOOGLE_API_KEY2,GOOGLE_API_KEY
# EVENT_SEARCH_LLM_ENABLED=0
# EVENT_SEARCH_LLM_KEY_ENVS=GOOGLE_API_KEY5,GOOGLE_API_KEY4,GOOGLE_API_KEY3,GOOGLE_API_KEY
# EVENT_SEARCH_LLM_RESERVE_KEY_ENVS=GOOGLE_API_KEY2
# EVENT_SEARCH_VERIFICATION_WINDOW=20
# EVENT_SEARCH_LLM_MAX_CANDIDATES=20
# EVENT_SEARCH_LLM_LITE_MODEL=gemini-3.1-flash-lite
# EVENT_SEARCH_LLM_GEMMA_OVERFLOW_MODEL=gemma-4-26b-a4b-it
# EVENT_SEARCH_LLM_GEMMA_OVERFLOW_ENABLED=1
# EVENT_SEARCH_LLM_LITE_TIMEOUT_MS=3500
# EVENT_SEARCH_LLM_GEMMA_OVERFLOW_TIMEOUT_MS=9000
# EVENT_SEARCH_EMBEDDING_TIMEOUT_MS=8000

# Telegram custom-emoji medallions for tg_event_publish posts.
# Mapping shape: {"rows":4,"cols":4,"items":{"slug":{"emoji_ids":[["..."]],"aliases":["..."],"priority":30}}}
TG_MEDALLIONS_ENABLED=1
TG_MEDALLION_CUSTOM_EMOJI_JSON=
TG_MEDALLION_CUSTOM_EMOJI_PATH=

# KenigEvents email control-plane (production-disabled defaults)
# Supabase migration/runtime switches are a second independent gate. Both DB and
# process gates must be enabled deliberately after migration-history reconciliation,
# provider/DNS verification, seed canaries and operator review.
EMAIL_CONTROL_WORKER_ENABLED=0
EMAIL_CONTROL_DRY_RUN=1
EMAIL_REPLY_TO=info@kenigevents.ru
# Keyed HMAC secret is backend-only and must come from the runtime secret store.
# EMAIL_ADDRESS_HMAC_KEY=
# EMAIL_ADDRESS_HMAC_KEY_VERSION=1

# IAM-authenticated Postbox Data Streams event consumer (Yandex Function only).
# Keep disabled outside the dedicated production function version. Identity and
# configuration values are provider IDs from a real notification, not display names.
POSTBOX_EVENT_CONSUMER_ENABLED=0
# POSTBOX_EXPECTED_IDENTITY_ID=
# POSTBOX_EXPECTED_CONFIGURATION_TAG=
POSTBOX_EXPECTED_FROM_DOMAIN=kenigevents.ru

# Transactional stream: Yandex Cloud Postbox only (no NotiSend fallback).
POSTBOX_EMAIL_ENABLED=0
POSTBOX_EMAIL_DRY_RUN=1
POSTBOX_EMAIL_ENDPOINT=https://postbox.cloud.yandex.net/v2/email/outbound-emails
POSTBOX_EMAIL_FROM=notify@kenigevents.ru
POSTBOX_EMAIL_FROM_NAME=Kenig Events
# POSTBOX_EMAIL_CONFIGURATION_SET=kenigevents-transactional
# POSTBOX_EMAIL_IAM_TOKEN=
# POSTBOX_SA_KEY_JSON={"id":"...","service_account_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# Fly transactional Postbox outbox worker. Process flags can be on while the
# Supabase global/transactional runtime switches remain the final send gate.
ENABLE_EMAIL_OUTBOX_WORKER=0
EMAIL_OUTBOX_WORKER_INTERVAL_SECONDS=60
EMAIL_OUTBOX_CLAIM_LIMIT=5
EMAIL_OUTBOX_LEASE_SECONDS=180
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=300
EMAIL_OUTBOX_RETRY_MAX_SECONDS=3600

# PII-free Supabase health + private YMQ DLQ monitoring with Telegram admin alerts.
ENABLE_EMAIL_OUTBOX_MONITOR=0
EMAIL_OUTBOX_MONITOR_INTERVAL_SECONDS=300
EMAIL_OUTBOX_ALERT_COOLDOWN_SECONDS=900
EMAIL_OUTBOX_SUBMITTED_WARNING_SECONDS=900
EMAIL_OUTBOX_SUBMITTED_ALARM_SECONDS=3600
EMAIL_OUTBOX_RETRYABLE_DUE_WARNING=5
POSTBOX_DLQ_ENDPOINT=https://message-queue.api.cloud.yandex.net
# POSTBOX_DLQ_QUEUE_URL=https://message-queue.api.cloud.yandex.net/b1.../kenigevents-postbox-events-dlq
# POSTBOX_DLQ_AWS_ACCESS_KEY_ID=
# POSTBOX_DLQ_AWS_SECRET_ACCESS_KEY=

# Recommendation stream: NotiSend individual-message API only, launch cap 200.
NOTISEND_EMAIL_ENABLED=0
NOTISEND_EMAIL_DRY_RUN=1
NOTISEND_EMAIL_ENDPOINT=https://api.notisend.ru/v1
NOTISEND_EMAIL_FROM=events@news.kenigevents.ru
NOTISEND_EMAIL_FROM_NAME=Kenig Events
# NOTISEND_EMAIL_API_TOKEN=

# Region Talk autonomous discovery (public publishing remains disabled).
# Enable only after all credentials below pass the scheduled-runner preflight.
ENABLE_REGION_TALK_SCHEDULED=0
REGION_TALK_TIMES_LOCAL=06:20,09:50,13:50,17:50,21:50
REGION_TALK_AUTH_BUNDLE_ENV=TELEGRAM_AUTH_BUNDLE_DISCOVERY1
REGION_TALK_SOURCE_PROFILE_CAPTURE_ENABLED=1
REGION_TALK_SOURCE_PROFILE_CAPTURE_ONLY=0
REGION_TALK_SOURCE_PROFILE_SCAN_POSTS=50
REGION_TALK_SOURCE_PROFILE_MIN_AUTHORED_POSTS=20
REGION_TALK_SOURCE_PROFILE_CAPTURE_MAX_SOURCES_PER_RUN=2
REGION_TALK_SOURCE_PROFILE_CAPTURE_ALL_SELECTED_SOURCES=0
REGION_TALK_SOURCE_PROFILE_MAX_LLM=10
REGION_TALK_SOURCE_ONBOARDING_WRITER_MAX_LLM=10
REGION_TALK_HISTORY_REVISIT_RESERVE_PERCENT=20
REGION_TALK_REACTION_SYNC_ENABLED=1
REGION_TALK_REACTION_SYNC_LIMIT=200
REGION_TALK_OPERATOR_REVIEWER_IDS=
# Admit only exact-current ❤️/👍 + clean-copy revisions to the daily plan.
REGION_TALK_REACTION_GATE_ENABLED=0
REGION_TALK_TZ=Europe/Kaliningrad
REGION_TALK_MISFIRE_GRACE_SECONDS=1800
REGION_TALK_SCHEDULED_MAX_RUNTIME_MINUTES=90
REGION_TALK_SCHEDULED_MAX_ACTIONS_PER_CYCLE=4
REGION_TALK_SCHEDULED_NO_PROGRESS_CYCLES=4
REGION_TALK_SCHEDULED_POLL_SECONDS=180
REGION_TALK_SCHEDULED_DOWNSTREAM_POLL_SECONDS=60
REGION_TALK_SCHEDULED_SCAN_LIMIT=20000
REGION_TALK_SCHEDULED_LOCK_FILE=/data/region_talk_orchestrator.lock
REGION_TALK_SCHEDULED_LOG_DIR=/data/runtime_logs/region_talk
REGION_TALK_SCHEDULED_LOG_RETENTION_DAYS=14
REGION_TALK_PUBLICATION_PLAN_ENABLED=0
REGION_TALK_PUBLICATION_PLAN_DAYS=14
REGION_TALK_PUBLICATION_TIMEZONE=Europe/Kaliningrad
REGION_TALK_ARTICLE_TIME_LOCAL=12:00
REGION_TALK_SOCIAL_TIME_LOCAL=18:00
REGION_TALK_PUBLICATION_DIVERSITY_WEIGHT=0.35
REGION_TALK_PUBLICATION_PAIR_SIMILARITY_THRESHOLD=0.82
# Legacy confirmed social rows are restored in small LLM-first batches. D1 is
# valid when CandidateReport is idle; D2 is the production default because D1
# normally owns the main discovery notebook. Both fail closed on remote/local
# concurrent use. VK text uses the existing read-token chain, not Telethon.
REGION_TALK_DRAFT_BACKFILL_TRANSPORT=telethon_discovery2
REGION_TALK_DRAFT_BACKFILL_BATCH_SIZE=2
REGION_TALK_DRAFT_BACKFILL_VK_BATCH_SIZE=2
# Independent durable draft-stage send ceiling; shared RPM/TPM/RPD reservations
# remain authoritative. Values are clamped to the YDB ledger maximum of 100.
REGION_TALK_DRAFT_BACKFILL_LLM_BUDGET_MAX=100
# Local/server Chromium bridge for JS-only external article pages. It is a
# bounded YDB worker (no Telegram session): at most three pages per invocation,
# then existing ImageDiagnostic downloads and VLM-ranks the discovered refs.
REGION_TALK_BROWSER_MAX_PAGES_PER_RUN=3
REGION_TALK_BROWSER_SCAN_LIMIT=5000
REGION_TALK_BROWSER_PAGE_TIMEOUT_SECONDS=35
REGION_TALK_BROWSER_MAX_ASSETS_PER_PAGE=20
# Optional UTF-8 ceiling paired with the 1800-character verifier excerpt.
# REGION_TALK_LLM_PROMPT_TEXT_MAX_BYTES=2880
# REGION_TALK_YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
# REGION_TALK_YDB_DATABASE=/ru-central1/<cloud>/<database>
# REGION_TALK_YDB_SERVICE_ACCOUNT_KEY_JSON={...}
# REGION_TALK_YDB_NAMESPACE=region_talk_compact
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# TELEGRAM_AUTH_BUNDLE_DISCOVERY1=
# TELEGRAM_AUTH_BUNDLE_DISCOVERY2=
# TELEGRAM_AUTH_BUNDLE_E2E=  # Codex/manual live E2E only; never a Region Talk pipeline input
# REGION_TALK_LLM_DEFAULT_ENV_VAR_NAME=GOOGLE_API_KEY3

# Private Events MCP. Keep disabled until the production OAuth/social gate
# in docs/operations/private-events-mcp.md is complete. Secret values belong in
# the runtime secret store, never in this file or Git.
PRIVATE_EVENTS_MCP_ENABLED=0
# PRIVATE_EVENTS_MCP_PUBLIC_BASE_URL=https://events-bot-new-wngqia.fly.dev
# PRIVATE_EVENTS_MCP_PATH_SECRET=
# PRIVATE_EVENTS_MCP_OAUTH_CLIENT_ID=
# PRIVATE_EVENTS_MCP_OAUTH_CLIENT_SECRET=
# Static non-secret public client ID; distinct from the ChatGPT client above.
# PRIVATE_EVENTS_MCP_CODEX_OAUTH_CLIENT_ID=
# PRIVATE_EVENTS_MCP_OPERATOR_TOKEN=
# Separate human-only secret for browser approval of social mutations. Never
# paste it into ChatGPT or Codex.
# PRIVATE_EVENTS_MCP_SOCIAL_APPROVAL_TOKEN=
# PRIVATE_EVENTS_MCP_SIGNING_KEY=
PRIVATE_EVENTS_MCP_AUTH_DB_PATH=/data/private-events-mcp-auth.sqlite
PRIVATE_EVENTS_MCP_REPOSITORY_ROOT=/app
PRIVATE_EVENTS_MCP_REPOSITORY_SLUG=onedayonemasterpiece/events-bot-new
PRIVATE_EVENTS_MCP_REPOSITORY_SHA_FILE=/app/.static-site-repo-sha
# Legacy alias-only compatibility policy used only while the universal social
# workspace below is disabled. Blank/omitted is deny-all; it does not configure
# universal Saved/user/dialog resolution.
# PRIVATE_EVENTS_MCP_SOCIAL_TARGETS_JSON={"telegram":{"alias":{"provider_target":"-1000000000000","allow_read":true,"allow_publish":false}},"vk":{"alias":{"provider_target":"100000000","allow_read":true,"allow_publish":false}}}
# Dedicated base64url JSON Telethon role bundle: {"session":"...", optional
# device_model/system_version/app_version/lang_code/system_lang_code}. There is
# intentionally no E2E, TELEGRAM_SESSION or S22 fallback. API credentials use
# TELEGRAM_API_ID/TELEGRAM_API_HASH, then the existing TG_API_ID/TG_API_HASH aliases.
# TELEGRAM_AUTH_BUNDLE_EVENTS_BOT_MCP=
# Universal Social Workspace is a separate typed surface. All flags are strict
# opt-ins; provider flags require the master flag. Codex never receives these tools.
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_TELEGRAM_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_VK_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_PRIVATE_READ_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_DM_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_POST_ENABLED=0
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_EDIT_DELETE_ENABLED=0
# Image media/story surface. Keep disabled until the exact-main media store,
# provider roles and live approval canaries in the runbook have passed.
# Video remains unsupported by the initial production gate.
PRIVATE_EVENTS_MCP_UNIVERSAL_SOCIAL_MEDIA_STORY_ENABLED=0
# ChatGPT fileParams ingress. The allowlist is mandatory when the media/story
# switch is enabled: configure the exact hosts observed for the current
# ChatGPT deployment (comma-separated exact hosts or explicit `*.suffix`).
# OpenAI does not promise one permanent file-download hostname, so there is no
# implicit global default and this value must be verified during activation.
PRIVATE_EVENTS_MCP_MEDIA_ROOT=/data/private-events-mcp-media
PRIVATE_EVENTS_MCP_MEDIA_ALLOWED_HOSTS=
PRIVATE_EVENTS_MCP_MEDIA_MAX_ASSET_BYTES=31457280
PRIVATE_EVENTS_MCP_MEDIA_MAX_STORE_BYTES=134217728
PRIVATE_EVENTS_MCP_MEDIA_ASSET_TTL_SECONDS=3600
PRIVATE_EVENTS_MCP_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
PRIVATE_EVENTS_MCP_MEDIA_MAX_WIDTH=8192
PRIVATE_EVENTS_MCP_MEDIA_MAX_HEIGHT=8192
PRIVATE_EVENTS_MCP_MEDIA_MAX_PIXELS=40000000
# VK workspace credentials are actor-scoped with no fallback to main VK_TOKEN*.
# Duplicate a token into multiple actor slots only after checking its exact rights.
# PRIVATE_EVENTS_MCP_VK_PUBLIC_READER_TOKEN=
# PRIVATE_EVENTS_MCP_VK_NOTIFICATION_READER_TOKEN=
# PRIVATE_EVENTS_MCP_VK_DIALOG_READER_TOKEN=
# PRIVATE_EVENTS_MCP_VK_USER_MESSENGER_TOKEN=
# PRIVATE_EVENTS_MCP_VK_COMMUNITY_EDITOR_TOKEN=
# PRIVATE_EVENTS_MCP_VK_ANALYTICS_READER_TOKEN=
# Story roles stay separate and have no repository value/default.
# PRIVATE_EVENTS_MCP_VK_STORY_READER_TOKEN=
# PRIVATE_EVENTS_MCP_VK_STORY_EDITOR_TOKEN=
PRIVATE_EVENTS_MCP_SOCIAL_TICKET_TTL_SECONDS=300
PRIVATE_EVENTS_MCP_SOCIAL_PROVIDER_TIMEOUT_SECONDS=12
PRIVATE_EVENTS_MCP_SOCIAL_PUBLISH_ATTEMPTS_PER_DAY=10
